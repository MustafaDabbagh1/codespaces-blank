---
// "Not a cookie-cutter ISO": identical kits roll off a belt on the left,
// while on the right one agent's kit is built up layer by layer.
import Icon from '../Icon.astro';

const layers = [
  { label: 'Same kit as everyone', icon: 'box' },
  { label: 'Your brand', icon: 'palette' },
  { label: 'Software for your niche', icon: 'layers' },
  { label: 'Website and CRM', icon: 'globe' },
  { label: 'Software fees + processing', icon: 'bars' },
];
const kits = [4127, 4128, 4129, 4130, 4131, 4132];
---

<div class="cc" data-stepper data-durations="2000,1900,2100,2100,3400" data-rest="4">
  <div class="cc__stage" role="img" aria-label="Animation: on the left, identical agent kits with the same terminal and the same rate sheet roll off a conveyor. On the right, a PPD partner's kit gains its own brand, niche software, website, CRM, and a second revenue line from software fees.">
    <!-- left: the belt -->
    <div class="cc__lane cc__lane--same" aria-hidden="true">
      <p class="cc__tag">Every other ISO</p>
      <div class="cc__cutter"><span></span></div>
      <div class="cc__belt">
        <div class="cc__track">
          {
            [...kits, ...kits].map((n) => (
              <div class="cc__kit">
                <Icon name="card" size={22} stroke={1.6} />
                <i></i>
                <i></i>
                <i></i>
                <small>Agent #{n}</small>
              </div>
            ))
          }
        </div>
      </div>
      <p class="cc__note">Same terminals. Same rate sheet. Same pitch.</p>
    </div>

    <div class="cc__arrow" aria-hidden="true"><Icon name="arrow-right" size={22} /></div>

    <!-- right: the build -->
    <div class="cc__lane cc__lane--yours" aria-hidden="true">
      <p class="cc__tag cc__tag--on">With PPD</p>
      <div class="cc__build">
        <div class="cc__halo"></div>

        <div class="cc__core">
          <div class="cc__badge">
            <span class="fx-swap on" data-from="0" data-to="0"><Icon name="card" size={22} stroke={1.6} /></span>
            <span class="fx-swap cc__logo" data-from="1">YB</span>
          </div>
          <b>
            <span class="fx-swap on" data-from="0" data-to="0">Agent #4133</span>
            <span class="fx-swap" data-from="1">Your Brand</span>
          </b>
          <small>
            <span class="fx-swap on" data-from="0" data-to="0">Terminal + rate sheet</span>
            <span class="fx-swap" data-from="1" data-to="1">Payments partner</span>
            <span class="fx-swap" data-from="2">Payments + software</span>
          </small>
        </div>

        <div class="cc__card cc__card--soft fx fx-pop" data-from="2">
          <header><i></i><i></i><i></i><span>Your niche software</span></header>
          <div class="cc__rows"><u></u><u></u><u></u></div>
          <em>Branded by you</em>
        </div>

        <div class="cc__card cc__card--web fx fx-pop" data-from="3">
          <header><span>yourbrand.com</span></header>
          <strong>Built for your vertical</strong>
          <u></u>
        </div>

        <div class="cc__card cc__card--crm fx fx-pop" data-from="3" style="--d:450ms">
          <header><span>Your CRM</span></header>
          <div class="cc__pipe"><i></i><i></i><i></i></div>
        </div>

        <div class="cc__card cc__card--rev fx fx-pop" data-from="4">
          <header><span>Revenue per merchant</span></header>
          <div class="cc__rev">
            <i class="a"><span>Processing</span></i>
            <i class="b"><span>+ Software fees</span></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <ol class="cc__steps">
    {
      layers.map((l, i) => (
        <li>
          <button type="button" data-go={i}>
            <Icon name={l.icon} size={15} />
            {l.label}
          </button>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .cc {
    --cc-brand: #4b74ff;
  }
  .cc__stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1.15fr;
    align-items: stretch;
    gap: clamp(10px, 2vw, 26px);
    container-type: inline-size;
  }
  .cc__lane {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: clamp(300px, 34vw, 420px);
    padding: clamp(16px, 2vw, 26px);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .cc__lane--same {
    background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.025) 0 12px, transparent 12px 24px), #0a0d14;
    color: #7c8598;
  }
  .cc__lane--yours {
    background: radial-gradient(120% 90% at 70% 10%, rgba(21, 73, 255, 0.28), transparent 60%), #0a0e18;
    border-color: rgba(75, 116, 255, 0.4);
  }
  .cc__tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6d7892;
  }
  .cc__tag--on {
    color: var(--blue-3);
  }
  .cc__note {
    margin-top: auto;
    font-size: 0.92rem;
    color: #7c8598;
  }
  .cc__arrow {
    align-self: center;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    color: var(--blue-3);
  }

  /* belt */
  .cc__belt {
    position: relative;
    margin: auto -30px 0;
    padding: 34px 0 16px;
    border-bottom: 3px dashed rgba(255, 255, 255, 0.14);
    mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
  }
  .cc__track {
    display: flex;
    gap: 16px;
    width: max-content;
    animation: cc-belt 16s linear infinite;
  }
  .cc__kit {
    flex: 0 0 104px;
    display: grid;
    gap: 7px;
    padding: 12px;
    border-radius: 14px;
    border: 1.5px dashed rgba(255, 255, 255, 0.22);
    background: #10141d;
    color: #6d7892;
  }
  .cc__kit i {
    height: 5px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.12);
  }
  .cc__kit i:nth-of-type(2) {
    width: 70%;
  }
  .cc__kit i:nth-of-type(3) {
    width: 85%;
  }
  .cc__kit small {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.04em;
  }
  .cc__cutter {
    position: absolute;
    left: 50%;
    top: 56px;
    width: 124px;
    height: 150px;
    margin-left: -62px;
    z-index: 2;
    pointer-events: none;
    animation: cc-stamp 2.67s cubic-bezier(0.7, 0, 0.3, 1) infinite;
  }
  .cc__cutter span {
    position: absolute;
    inset: 0;
    border-radius: 18px;
    border: 2px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.05);
  }
  .cc__cutter::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 2px;
    height: 60px;
    background: rgba(255, 255, 255, 0.3);
  }

  /* build */
  .cc__build {
    position: relative;
    flex: 1;
    margin-top: 10px;
    font-size: clamp(10px, 1.25cqw, 14px);
  }
  .cc__halo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 60%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(75, 116, 255, 0.5), transparent);
    opacity: 0;
    transition: opacity 0.8s;
  }
  .cc:not([data-step='0']) .cc__halo {
    opacity: 1;
  }
  .cc__core {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    z-index: 3;
    display: grid;
    justify-items: center;
    gap: 0.35em;
    width: 12.5em;
    padding: 1.3em 1em;
    border-radius: 1.4em;
    text-align: center;
    border: 1.5px dashed rgba(255, 255, 255, 0.25);
    background: #10141d;
    color: #7c8598;
    transition:
      border-color 0.6s,
      background 0.6s,
      color 0.6s,
      box-shadow 0.6s,
      scale 0.6s var(--spring);
  }
  .cc:not([data-step='0']) .cc__core {
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    background: linear-gradient(160deg, #1b2a55, #0d1430);
    color: #fff;
    box-shadow: 0 1.6em 3em -1em rgba(21, 73, 255, 0.8);
    scale: 1.06;
  }
  .cc__badge {
    display: grid;
    place-items: center;
    width: 3.6em;
    height: 3.6em;
    border-radius: 1em;
    background: rgba(255, 255, 255, 0.06);
    transition: background 0.5s;
  }
  .cc:not([data-step='0']) .cc__badge {
    background: linear-gradient(140deg, #4b74ff, #1549ff);
  }
  .cc__logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4em;
    letter-spacing: -0.04em;
    animation: cc-pop 0.6s var(--spring);
  }
  .cc__core b {
    font-family: var(--font-display);
    font-size: 1.25em;
    letter-spacing: -0.02em;
  }
  .cc__core small {
    font-size: 0.82em;
    opacity: 0.75;
  }

  .cc__card {
    position: absolute;
    z-index: 2;
    width: 11.5em;
    padding: 0.8em;
    border-radius: 1em;
    background: #fff;
    color: #0a0e18;
    box-shadow: 0 1.4em 2.6em -1em rgba(0, 0, 0, 0.8);
  }
  .cc__card header {
    display: flex;
    align-items: center;
    gap: 0.3em;
    margin-bottom: 0.6em;
    font-size: 0.74em;
    font-weight: 700;
    color: #4d566b;
  }
  .cc__card header i {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: #d5d9e3;
  }
  .cc__card header span {
    margin-left: 0.2em;
  }
  .cc__card u {
    display: block;
    height: 0.55em;
    margin-bottom: 0.4em;
    border-radius: 0.3em;
    background: #e6e9f0;
    text-decoration: none;
  }
  .cc__card u:nth-child(2) {
    width: 70%;
  }
  .cc__card u:nth-child(3) {
    width: 85%;
    background: #1549ff;
  }
  .cc__card em {
    display: inline-block;
    margin-top: 0.2em;
    padding: 0.2em 0.6em;
    border-radius: 99em;
    font-style: normal;
    font-size: 0.68em;
    font-weight: 700;
    color: #1549ff;
    background: #e5ecff;
  }
  .cc__card--soft {
    left: 0;
    top: 2%;
    rotate: -4deg;
  }
  .cc__card--web {
    right: 0;
    top: 0;
    rotate: 3deg;
  }
  .cc__card--web strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05em;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 0.5em;
  }
  .cc__card--web u {
    width: 45%;
    height: 1.1em;
    border-radius: 99em;
    background: #1549ff;
    margin: 0;
  }
  .cc__card--crm {
    left: 2%;
    bottom: 2%;
    rotate: 3deg;
  }
  .cc__pipe {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.3em;
    align-items: end;
    height: 2.6em;
  }
  .cc__pipe i {
    border-radius: 0.3em;
    background: #c9d6ff;
    height: 60%;
  }
  .cc__pipe i:nth-child(2) {
    height: 100%;
    background: #1549ff;
  }
  .cc__pipe i:nth-child(3) {
    height: 40%;
  }
  .cc__card--rev {
    right: 0;
    bottom: 0;
    rotate: -3deg;
    width: 13em;
  }
  .cc__rev {
    display: grid;
    gap: 0.3em;
  }
  .cc__rev i {
    display: block;
    padding: 0.45em 0.7em;
    border-radius: 0.5em;
    font-style: normal;
    font-size: 0.74em;
    font-weight: 700;
    color: #fff;
    background: #0a0e18;
  }
  .cc__rev i.b {
    background: linear-gradient(90deg, #1549ff, #7c4dff);
    transform-origin: left;
    animation: cc-grow 0.9s var(--ease-out) 0.5s both;
  }

  .cc__steps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 22px;
  }
  .cc__steps button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 15px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--muted);
    transition:
      color 0.3s,
      background 0.3s,
      border-color 0.3s;
  }
  .cc__steps button.is-active {
    color: #fff;
    background: var(--blue);
    border-color: var(--blue);
  }
  .cc__steps li:first-child button.is-active {
    background: #2a3142;
    border-color: #2a3142;
  }

  @keyframes cc-belt {
    to {
      transform: translateX(-720px);
    }
  }
  @keyframes cc-stamp {
    0%,
    55%,
    100% {
      transform: translateY(-34px);
      opacity: 0.55;
    }
    72%,
    82% {
      transform: translateY(12px);
      opacity: 1;
    }
  }
  @keyframes cc-pop {
    from {
      scale: 0.3;
      opacity: 0;
    }
  }
  @keyframes cc-grow {
    from {
      transform: scaleX(0);
    }
  }

  @media (max-width: 860px) {
    .cc__stage {
      grid-template-columns: 1fr;
    }
    .cc__arrow {
      justify-self: center;
      rotate: 90deg;
    }
    .cc__lane--same {
      min-height: 280px;
    }
    .cc__lane--yours {
      min-height: 400px;
    }
    .cc__build {
      font-size: 11px;
    }
  }
</style>
