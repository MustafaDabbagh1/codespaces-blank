---
// Global header (v2): the PPD lockup, four quiet links and one action.
// Transparent over the hero, it tightens into a floating bar once the page
// scrolls. Self-contained (own tokens + scoped styles) so it renders the same
// in SiteLayout and in the legacy BaseLayout, which passes `solid` because
// several older pages open on a light background.
import Icon from './Icon.astro';
import { products, industries, logins, company } from '../data/site';

interface Props {
  solid?: boolean;
}
const { solid = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isAgents = ['/agents', '/iso', '/isv-solutions', '/refer'].includes(path);
const isProducts = ['/products', '/forge', '/repair', '/merchant', '/products/ppd-rewards'].includes(path);
---

<header class:list={['sh', { 'sh--solid': solid }]} data-site-header>
  <div class="sh__bar">
    <a class="sh__logo" href="/" aria-label="PPD Technology home">
      <svg viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="1.2" y="1.2" width="29.6" height="21.6" rx="6"></rect>
        <path d="M11.1 1.4 15.9 5.7l4.8-4.3M15.9 5.7v.95a1.2 1.2 0 0 1-1.2 1.2H1.3M10.6 7.85v7.25M1.3 15.1h29.4M21.5 15.1V9.05a1.2 1.2 0 0 1 1.2-1.2h8M15.9 15.1v2.1M11.1 22.6l4.8-5.4 4.8 5.4"></path>
      </svg>
      <span><b>PPD</b>Technology</span>
    </a>

    <nav class="sh__nav" aria-label="Primary">
      <div class="sh__item" data-menu>
        <button class:list={['sh__link', { 'is-current': isProducts }]} type="button" aria-expanded="false" aria-controls="sh-products">Products</button>
        <div class="sh__panel" id="sh-products">
          <ul>
            {products.map((p) => <li><a href={p.href}>{p.name}<em>{p.kind}</em></a></li>)}
            <li class="sh__panel-foot"><a href="/products">Everything we offer <Icon name="arrow-right" size={14} /></a></li>
          </ul>
        </div>
      </div>
      <a class:list={['sh__link', { 'is-current': isAgents }]} href="/agents">Agents</a>
      <div class="sh__item" data-menu>
        <button class="sh__link" type="button" aria-expanded="false" aria-controls="sh-industries">Industries</button>
        <div class="sh__panel sh__panel--two" id="sh-industries">
          <ul>
            {industries.map((i) => <li><a href={i.href}>{i.name}</a></li>)}
          </ul>
        </div>
      </div>
      <a class="sh__link" href="/customer-support">Support</a>
    </nav>

    <div class="sh__actions">
      <div class="sh__item sh__item--login" data-menu>
        <button class="sh__link" type="button" aria-expanded="false" aria-controls="sh-login">Log in</button>
        <div class="sh__panel sh__panel--right" id="sh-login">
          <ul>
            {logins.map((l) => <li><a href={l.href} rel="noopener">{l.name}</a></li>)}
          </ul>
        </div>
      </div>
      <a class="sh__cta" href="/signup">Get started <Icon name="arrow-up-right" size={14} stroke={2.4} /></a>
      <button class="sh__burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sh-mobile">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="sh__mobile" id="sh-mobile" hidden>
    <div class="sh__mobile-inner">
      <details open>
        <summary>Products <Icon name="chevron" size={18} stroke={2.2} /></summary>
        <ul>
          {products.map((p) => <li><a href={p.href}>{p.name}<em>{p.kind}</em></a></li>)}
          <li><a href="/products" class="sh__m-all">Everything we offer</a></li>
        </ul>
      </details>
      <a class="sh__m-link" href="/agents">Agents</a>
      <details>
        <summary>Industries <Icon name="chevron" size={18} stroke={2.2} /></summary>
        <ul>
          {industries.map((i) => <li><a href={i.href}>{i.name}</a></li>)}
        </ul>
      </details>
      <a class="sh__m-link" href="/customer-support">Support</a>
      <a class="sh__m-link" href="/contact">Contact</a>
      <details>
        <summary>Log in <Icon name="chevron" size={18} stroke={2.2} /></summary>
        <ul>
          {logins.map((l) => <li><a href={l.href} rel="noopener">{l.name}</a></li>)}
        </ul>
      </details>
      <div class="sh__m-cta">
        <a class="sh__cta" href="/signup">Get started <Icon name="arrow-up-right" size={14} stroke={2.4} /></a>
        <a class="sh__m-phone" href={`tel:${company.salesTel}`}>Sales {company.salesPhone}</a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const menus = Array.from(header.querySelectorAll<HTMLElement>('[data-menu]'));
    const closeAll = (except?: HTMLElement) =>
      menus.forEach((m) => {
        if (m === except) return;
        m.classList.remove('open');
        m.querySelector('button')?.setAttribute('aria-expanded', 'false');
      });

    menus.forEach((m) => {
      const btn = m.querySelector('button');
      const set = (open: boolean) => {
        m.classList.toggle('open', open);
        btn?.setAttribute('aria-expanded', String(open));
      };
      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = !m.classList.contains('open');
        closeAll(m);
        set(open);
      });
      // keyboard: close when focus leaves the menu; mouse: un-pin on leave
      m.addEventListener('focusout', (e) => {
        if (!m.contains(e.relatedTarget as Node)) set(false);
      });
      m.addEventListener('pointerleave', (e) => {
        if ((e as PointerEvent).pointerType === 'mouse') set(false);
      });
    });
    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) closeAll();
    });

    const burger = header.querySelector<HTMLButtonElement>('.sh__burger');
    const sheet = header.querySelector<HTMLElement>('.sh__mobile');
    const setMobile = (open: boolean) => {
      if (!burger || !sheet) return;
      if (open === !sheet.hidden) return;
      sheet.hidden = !open;
      header.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    burger?.addEventListener('click', () => setMobile(!!sheet?.hidden));
    window.matchMedia('(min-width: 981px)').addEventListener('change', (e) => e.matches && setMobile(false));

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = menus.find((m) => m.classList.contains('open'));
      closeAll();
      open?.querySelector('button')?.focus();
      setMobile(false);
    });

    const onScroll = () => header.classList.toggle('is-stuck', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .sh {
    --sh-line: rgba(255, 255, 255, 0.12);
    --sh-cyan: #22d3ff;
    --sh-blue: #1549ff;
    --sh-display: 'Bricolage Grotesque Variable', 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
    --sh-body: 'Geist Variable', 'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --sh-mono: 'Geist Mono Variable', 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    position: sticky;
    top: 0;
    z-index: 200;
    height: 76px;
    font-family: var(--sh-body);
    font-size: 15px;
    line-height: 1.4;
    color: #eef1f8;
    pointer-events: none;
  }
  .sh :global(*) {
    box-sizing: border-box;
  }
  .sh a {
    color: inherit;
    text-decoration: none;
  }
  .sh ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sh button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
  }
  .sh :focus-visible {
    outline: 2px solid var(--sh-cyan);
    outline-offset: 3px;
    border-radius: 6px;
  }

  /* the bar: full width at rest, a floating capsule once scrolled */
  .sh__bar {
    pointer-events: auto;
    position: relative;
    display: flex;
    align-items: center;
    gap: 36px;
    width: 100%;
    max-width: 1280px;
    height: 76px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 40px);
    border: 1px solid transparent;
    border-radius: 16px;
    transition:
      max-width 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      height 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      padding 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.4s,
      border-color 0.4s,
      box-shadow 0.4s;
  }
  .sh.is-stuck .sh__bar,
  .sh.is-open .sh__bar {
    max-width: min(1000px, calc(100% - 24px));
    height: 58px;
    padding: 0 10px 0 20px;
    transform: translateY(10px);
    background: rgba(6, 10, 28, 0.78);
    border-color: rgba(140, 170, 255, 0.24);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    box-shadow: 0 18px 50px -20px rgba(0, 0, 0, 0.9);
  }

  /* legacy pages: always a solid bar */
  .sh--solid {
    background: #040714;
    border-bottom: 1px solid var(--sh-line);
    pointer-events: auto;
  }
  .sh--solid.is-stuck .sh__bar {
    max-width: 1280px;
    height: 76px;
    padding: 0 clamp(20px, 4vw, 40px);
    transform: none;
    background: none;
    border-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: none;
  }

  .sh__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .sh__logo svg {
    width: 30px;
    height: 23px;
    color: var(--sh-cyan);
    filter: drop-shadow(0 0 8px rgba(34, 211, 255, 0.55));
  }
  .sh__logo span {
    font-family: var(--sh-display);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    color: #fff;
  }
  .sh__logo b {
    font-weight: 800;
    color: var(--sh-cyan);
  }

  .sh__nav {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0 auto;
  }
  .sh__item {
    position: relative;
  }
  .sh__link {
    display: inline-flex !important;
    align-items: center;
    height: 38px;
    padding: 0 14px !important;
    border-radius: 8px;
    font-family: var(--sh-mono) !important;
    font-size: 0.74rem !important;
    font-weight: 500 !important;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #a9b4cf !important;
    transition: color 0.2s;
  }
  .sh__link:hover,
  .sh__item.open > .sh__link,
  .sh__link.is-current {
    color: #fff !important;
  }
  .sh__link.is-current {
    text-shadow: 0 0 18px rgba(34, 211, 255, 0.7);
  }

  .sh__panel {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    min-width: 310px;
    padding: 8px;
    border-radius: 14px;
    border: 1px solid rgba(140, 170, 255, 0.22);
    background: rgba(6, 10, 28, 0.96);
    box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.9);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 8px);
    transition:
      opacity 0.2s,
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s 0.2s;
  }
  .sh__panel::before {
    content: '';
    position: absolute;
    inset: -14px 0 auto 0;
    height: 14px;
  }
  .sh__panel--right {
    left: auto;
    right: 0;
    min-width: 230px;
    transform: translate(0, 8px);
  }
  .sh__panel--two {
    min-width: 380px;
  }
  .sh__panel--two ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .sh__item.open > .sh__panel {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition-delay: 0s;
  }
  .sh__item.open > .sh__panel--right {
    transform: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .sh__item:hover > .sh__panel {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
      transition-delay: 0s;
    }
    .sh__item:hover > .sh__panel--right {
      transform: none;
    }
    .sh__item:hover > .sh__link {
      color: #fff !important;
    }
  }
  .sh__panel a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    padding: 10px 12px;
    border-radius: 9px;
    font-size: 0.95rem;
    font-weight: 500;
    color: #e6ebf7;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .sh__panel a:hover {
    background: rgba(120, 160, 255, 0.14);
  }
  .sh__panel em {
    font-style: normal;
    font-size: 0.8rem;
    color: #7f8cab;
    white-space: nowrap;
  }
  .sh__panel-foot {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid var(--sh-line);
  }
  .sh__panel-foot a {
    justify-content: flex-start;
    align-items: center;
    gap: 8px;
    color: var(--sh-cyan);
  }

  .sh__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .sh__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px;
    border-radius: 9px;
    font-family: var(--sh-mono);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff !important;
    background: linear-gradient(180deg, #2f62ff, #1549ff);
    box-shadow:
      0 0 0 1px rgba(160, 190, 255, 0.4) inset,
      0 10px 26px -10px rgba(21, 73, 255, 0.9);
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s;
  }
  .sh__cta:hover {
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px rgba(190, 215, 255, 0.7) inset,
      0 14px 34px -10px rgba(34, 130, 255, 1);
  }

  .sh__burger {
    display: none !important;
    position: relative;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    border: 1px solid var(--sh-line) !important;
  }
  .sh__burger span {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 1.8px;
    border-radius: 2px;
    background: #fff;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      top 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .sh__burger span:nth-child(1) {
    top: 16px;
  }
  .sh__burger span:nth-child(2) {
    top: 24px;
  }
  .sh.is-open .sh__burger span:nth-child(1) {
    top: 20px;
    transform: rotate(45deg);
  }
  .sh.is-open .sh__burger span:nth-child(2) {
    top: 20px;
    transform: rotate(-45deg);
  }

  /* absolute, not fixed: a backdrop-filter ancestor would trap a fixed sheet */
  .sh__mobile {
    pointer-events: auto;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: -1;
    height: 100vh;
    height: 100dvh;
    padding-top: 84px;
    background: #040714;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .sh__mobile-inner {
    padding: 4px clamp(20px, 4vw, 40px) 40px;
    max-width: 640px;
    margin: 0 auto;
  }
  .sh__mobile details,
  .sh__m-link {
    border-bottom: 1px solid var(--sh-line);
  }
  .sh__mobile summary,
  .sh__m-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 2px;
    font-family: var(--sh-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    cursor: pointer;
    list-style: none;
  }
  .sh__mobile summary::-webkit-details-marker {
    display: none;
  }
  .sh__mobile summary :global(svg) {
    opacity: 0.5;
    transition: transform 0.3s;
  }
  .sh__mobile details[open] summary :global(svg) {
    transform: rotate(180deg);
  }
  .sh__mobile details ul {
    padding: 0 2px 16px;
    display: grid;
    gap: 2px;
  }
  .sh__mobile details a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 0;
    font-size: 1.05rem;
    font-weight: 500;
    color: #dfe4f0;
  }
  .sh__mobile details em {
    font-style: normal;
    font-size: 0.84rem;
    color: #7f8cab;
  }
  .sh__m-all {
    color: var(--sh-cyan) !important;
  }
  .sh__m-cta {
    display: grid;
    gap: 14px;
    margin-top: 26px;
  }
  .sh__m-cta .sh__cta {
    height: 54px;
    justify-content: center;
    font-size: 0.86rem;
  }
  .sh__m-phone {
    text-align: center;
    font-size: 0.95rem;
    color: #a9b4cf !important;
  }

  @media (max-width: 980px) {
    .sh__nav,
    .sh__item--login {
      display: none;
    }
    .sh__bar {
      justify-content: space-between;
    }
    .sh__burger {
      display: block !important;
    }
  }
  @media (max-width: 420px) {
    .sh__actions > .sh__cta {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sh__bar,
    .sh__panel,
    .sh__burger span {
      transition: none;
    }
  }
</style>
