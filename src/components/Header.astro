<style>
  .header-container{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:15px 0;
  }

  .logo{
    font-size:20px;
    font-weight:700;
    color:#0055FF;
    display:flex;
    align-items:center;
    gap:8px;
    white-space:nowrap;
    text-decoration:none;
  }

  .brandtext{
    display:inline-flex;
    gap:0;
  }

  .brandtext .ppd{
    color:#0055FF;
    font-weight:800;
  }

  .brandtext .tech{
    color:#000;
    font-weight:800;
  }

  .logo-chip{
    width:28px;
    height:28px;
    display:inline-block;
    line-height:0;
    background:#0055FF;
    -webkit-mask:url("https://mmdabbagh24.neocities.org/images/Chip-reader-EMV.png") center/contain no-repeat;
            mask:url("https://mmdabbagh24.neocities.org/images/Chip-reader-EMV.png") center/contain no-repeat;
    animation:pulse 2s infinite;
    filter:
      drop-shadow( 1px  0   0 #0055FF)
      drop-shadow(-1px  0   0 #0055FF)
      drop-shadow( 0    1px 0 #0055FF)
      drop-shadow( 0   -1px 0 #0055FF);
  }

  @supports not ((mask: url("")) or (-webkit-mask: url(""))){
    .logo-chip{
      background:none;
      filter:none;
      display:inline-flex;
      align-items:center;
      justify-content:center;
    }

    .logo-chip::before{
      content:"";
      width:28px;
      height:28px;
      background:url("https://mmdabbagh24.neocities.org/images/Chip-reader-EMV.png") center/contain no-repeat;
      animation:pulse 2s infinite;
      display:block;
    }
  }

  nav ul{
    display:flex;
    list-style:none;
    gap:20px;
    align-items:center;
  }

  nav ul li a{
    font-weight:500;
    transition:color .3s;
    position:relative;
    font-size:15px;
    text-decoration:none;
    color:inherit;
  }

  nav ul li a::after{
    content:'';
    position:absolute;
    bottom:-6px;
    left:50%;
    width:0;
    height:2px;
    background:#0055FF;
    transition:all .3s;
    transform:translateX(-50%);
  }

  nav ul li a:hover::after{
    width:100%;
  }

  .header-buttons{
    display:flex;
    gap:10px;
  }

  .btn{
    padding:10px 18px;
    border-radius:30px;
    font-weight:600;
    transition:transform .2s ease, box-shadow .25s, background .3s, color .3s;
    cursor:pointer;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    font-size:14px;
    position:relative;
    overflow:hidden;
  }

  .btn-outline{
    border:2px solid #0055FF;
    color:#0055FF;
    background:transparent;
  }

  .btn-primary{
    background:#0055FF;
    color:#fff;
    border:2px solid #0055FF;
  }

  .hamburger{
    display:none;
    flex-direction:column;
    justify-content:space-between;
    width:24px;
    height:18px;
    cursor:pointer;
  }

  .hamburger span{
    height:2px;
    width:100%;
    background:#0055FF;
    border-radius:2px;
    transition:all .3s;
  }

  .dropdown{
    position:relative;
  }

  .dropdown > a{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding-right:16px;
  }

  .dropdown > a .chev{
    font-size:12px;
    transition:transform .25s;
  }

  .dropdown-menu{
    position:absolute;
    top:100%;
    left:0;
    min-width:260px;
    background:#fff;
    border:1px solid #E2E8F0;
    border-radius:12px;
    box-shadow:0 12px 28px rgba(0,0,0,.08);
    padding:10px;
    display:none;
    z-index:999;
    animation:menuPop .2s ease forwards;
  }

  .dropdown-menu::before{
    content:'';
    position:absolute;
    left:0;
    right:0;
    top:-12px;
    height:12px;
  }

  .dropdown-menu a{
    display:flex;
    gap:10px;
    align-items:center;
    padding:10px 12px;
    border-radius:10px;
    color:#0F1B35;
    font-weight:500;
    font-size:14px;
    transition:transform .15s ease;
  }

  .dropdown-menu a:hover{
    transform:translateX(3px);
  }

  .dropdown:hover .dropdown-menu,
  .dropdown:focus-within .dropdown-menu{
    display:block;
  }

  .dropdown:hover > a .chev,
  .dropdown:focus-within > a .chev{
    transform:rotate(180deg);
  }

  .dropdown-menu a i,
  .dropdown-menu a svg{
    width:16px;
    height:16px;
    flex:0 0 16px;
  }

  @keyframes pulse{
    0%{transform:scale(1)}
    50%{transform:scale(1.1)}
    100%{transform:scale(1)}
  }

  @keyframes menuPop{
    from{opacity:0;transform:translateY(8px) scale(.98)}
    to{opacity:1;transform:none}
  }

  @media (max-width:767px){
    .header-container{
      display:grid;
      grid-template-columns:1fr auto 1fr;
      align-items:center;
      padding:15px 20px;
    }

    .logo{
      grid-column:2;
      justify-self:center;
    }

    .hamburger{
      display:flex;
      grid-column:3;
      justify-self:end;
    }

    nav,
    .header-buttons{
      display:none;
    }
  }
</style>

