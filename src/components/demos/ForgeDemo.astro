---
// Forge POS: one sale, replayed. Register screen + customer-facing display.
// Copy and sample values follow ppdforge.com.
import DemoSteps from './DemoSteps.astro';
import Icon from '../Icon.astro';

interface Props {
  layout?: 'split' | 'flip' | 'stack';
  captions?: boolean;
}
const { layout = 'split', captions = true } = Astro.props;

const steps = [
  { title: 'Scan it, search it, or tap it.', body: 'Scan a barcode, type a few letters, or tap a category tile. Items land in the cart at once.' },
  { title: 'Cash price. Card price. Always visible.', body: 'Dual pricing is built into every tile, every cart line and the customer’s screen, so nobody is surprised by the total.' },
  { title: 'EBT, deposits and rewards, handled.', body: 'EBT-eligible items are tagged, bottle deposits add themselves, and an attached customer earns rewards on the sale.' },
  { title: 'Any tender. Even two at once.', body: 'Cash, credit, debit and EBT, or split the sale across them. The card reader takes it from there.' },
  { title: 'Done. Receipt or no receipt.', body: 'Print it or skip it, and the register is ready for the next person in line.' },
];
const tiles = [
  ['All products', '#1d3a66'],
  ['Beverages', '#2a67b3'],
  ['Bakery', '#167a76'],
  ['Frozen', '#6b4bb0'],
  ['Grocery', '#a8492a'],
  ['Snacks', '#9c3f7c'],
  ['Produce', '#8a5a06'],
  ['Dairy', '#2a67b3'],
];
---

<div class:list={['demo', `demo--${layout}`, 't-forge', 'fd']} data-stepper data-durations="2600,2600,3400,3400,3000" data-rest="2">
  {
    captions && (
      <div class="demo__side">
        <slot />
        <DemoSteps steps={steps} label="Steps in a Forge sale" />
      </div>
    )
  }

  <div class="demo__stage">
    <div class="demo__glow"></div>

    <div class="fd__register" role="img" aria-label="Animated replay of a sale on the Forge register: items are scanned, cash and card prices show side by side, EBT and a bottle deposit are applied, the sale is split between EBT and card, then completed.">
      <div class="fd__ui" aria-hidden="true">
        <div class="fd__top">
          <img class="fd__logo" src="/images/brand/forge-wordmark-dark.webp" alt="" width="480" height="159" loading="lazy" />
          <span class="fd__pill"><Icon name="menu" size={12} /> Menu</span>
          <span class="fd__who"><small>Employee</small>Avery Cashier</span>
          <span class="fd__status"><small>Status</small><i></i>Online</span>
        </div>

        <div class="fd__body">
          <!-- cart -->
          <div class="fd__cart">
            <div class="fd__cart-head">
              <b>Current sale</b>
              <span class="fd__saved">Saved carts (3)</span>
            </div>

            <div class="fd__cust">
              <span class="fx-swap on" data-from="0" data-to="1"><Icon name="user" size={12} /> Add customer</span>
              <span class="fx-swap fd__cust-on" data-from="2">
                <i>MJ</i> Maya Johnson <em>Rewards member</em>
              </span>
            </div>

            <div class="fd__lines">
              <div class="fx-row fd__line-wrap" data-from="0" style="--d:700ms">
                <div>
                  <div class="fd__line">
                    <span class="fd__qty">1</span>
                    <span class="fd__name">
                      Cold Brew Coffee 12oz
                      <span class="fd__ebt fx fx-pop" data-from="2" style="--d:200ms">EBT eligible</span>
                    </span>
                    <span class="fd__price">$4.25</span>
                    <span class="fd__dual">Cash $4.25 <b>·</b> Card $4.38</span>
                  </div>
                </div>
              </div>
              <div class="fx-row fd__line-wrap" data-from="2" style="--d:500ms">
                <div>
                  <div class="fd__line">
                    <span class="fd__qty">1</span>
                    <span class="fd__name">Sparkling Water 1L</span>
                    <span class="fd__price">$2.29</span>
                    <span class="fd__dual">Cash $2.29 <b>·</b> Card $2.36 <span class="fd__dep fx fx-pop" data-from="2" style="--d:1150ms"><Icon name="bottle" size={10} /> Deposit +$0.05</span></span>
                  </div>
                </div>
              </div>
              <div class="fx-row fd__line-wrap" data-from="2" style="--d:1700ms">
                <div>
                  <div class="fd__line">
                    <span class="fd__qty">1</span>
                    <span class="fd__name">Sea Salt Kettle Chips</span>
                    <span class="fd__price">$3.49</span>
                    <span class="fd__dual">Cash $3.49 <b>·</b> Card $3.59</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="fd__total">
              <div class="fd__total-row">
                <span>Total due</span>
                <span class="fd__card-est">
                  Card est.
                  <span class="fx-swap on" data-from="0" data-to="1">$4.38</span>
                  <span class="fx-swap" data-from="2">$10.38</span>
                </span>
                <strong>
                  <span class="fx-swap on" data-from="0" data-to="1">$4.25</span>
                  <span class="fx-swap" data-from="2">$10.08</span>
                </strong>
              </div>
              <div class="fd__pay">
                <span>Pay Now</span>
                <span>
                  <span class="fx-swap on" data-from="0" data-to="1">$4.25</span>
                  <span class="fx-swap" data-from="2">$10.08</span>
                </span>
              </div>
            </div>
          </div>

          <!-- product side -->
          <div class="fd__shop">
            <div class="fd__search"><Icon name="barcode" size={13} /> Search or tap to type</div>
            <div class="fd__actions">
              <span class="fd__scan"><Icon name="barcode" size={11} /> Barcode</span>
              <span>Custom amount</span>
              <span>+ Add item</span>
            </div>
            <div class="fd__tiles">
              {tiles.map(([name, bg]) => <span style={`background:${bg}`}>{name}</span>)}
            </div>

            <div class="fd__toast fx fx-drop" data-from="0" data-to="0" style="--d:900ms">
              <Icon name="check-circle" size={13} /> Cold Brew Coffee 12oz added
            </div>

            <!-- payment sheet -->
            <div class="fd__sheet fx fx-rise" data-from="3" data-to="3">
              <b>Payment</b>
              <p>Split across tenders</p>
              <div class="fd__tender fx fx-left" data-from="3" style="--d:450ms">
                <span><Icon name="card" size={13} /> EBT</span>
                <strong>$4.25</strong>
                <i class="fd__ok fx fx-pop" data-from="3" style="--d:1000ms"><Icon name="check" size={11} stroke={3} /></i>
              </div>
              <div class="fd__tender fx fx-left" data-from="3" style="--d:1300ms">
                <span><Icon name="card" size={13} /> Card</span>
                <strong>$6.00</strong>
                <i class="fd__ok fx fx-pop" data-from="3" style="--d:2500ms"><Icon name="check" size={11} stroke={3} /></i>
              </div>
              <div class="fd__reader">
                <span></span>
                Tap, chip or swipe on the reader
              </div>
            </div>

            <!-- paid -->
            <div class="fd__sheet fd__sheet--paid fx fx-rise" data-from="4">
              <div class="fd__done fx fx-pop" data-from="4" style="--d:250ms"><Icon name="check" size={22} stroke={3} /></div>
              <b>Sale complete</b>
              <p>EBT $4.25 · Card $6.00</p>
              <div class="fd__receipt">
                <span><Icon name="receipt" size={12} /> Print receipt</span>
                <span>No receipt</span>
              </div>
              <div class="fd__pts fx fx-pop" data-from="4" style="--d:1100ms"><Icon name="star" size={11} /> +10 pts for Maya</div>
            </div>
          </div>
        </div>

        <div class="fd__beam"></div>
      </div>
    </div>

    <!-- customer-facing display -->
    <div class="fd__customer" aria-hidden="true">
      <div class="fd__ui fd__ui--cust">
        <small>Customer display</small>
        <div class="fx-swap on fd__c-live" data-from="0" data-to="2">
          <div class="fd__c-lines">
            <span class="fx fx-rise" data-from="0" style="--d:800ms">Cold Brew Coffee 12oz <b>$4.25</b></span>
            <span class="fx fx-rise" data-from="2" style="--d:600ms">Sparkling Water 1L <b>$2.29</b></span>
            <span class="fx fx-rise" data-from="2" style="--d:1800ms">Sea Salt Kettle Chips <b>$3.49</b></span>
          </div>
          <div class="fd__c-totals">
            <div>
              <small>Cash</small>
              <b><span class="fx-swap on" data-from="0" data-to="1">$4.25</span><span class="fx-swap" data-from="2">$10.08</span></b>
            </div>
            <div>
              <small>Card</small>
              <b><span class="fx-swap on" data-from="0" data-to="1">$4.38</span><span class="fx-swap" data-from="2">$10.38</span></b>
            </div>
          </div>
        </div>
        <div class="fx-swap fd__c-choice" data-from="3" data-to="3">
          <p>How are you paying?</p>
          <div><span>Credit</span><span class="is-picked">Debit</span></div>
        </div>
        <div class="fx-swap fd__c-thanks" data-from="4">
          <p>Thank you</p>
          <span>+10 pts earned</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .fd__register {
    position: relative;
    z-index: 1;
    container-type: inline-size;
    aspect-ratio: 16 / 10;
    border-radius: clamp(12px, 2vw, 22px);
    padding: clamp(5px, 0.9vw, 10px);
    background: linear-gradient(160deg, #3a4254, #12151d 40%, #0b0d13);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.14) inset,
      0 50px 90px -40px rgba(0, 0, 0, 0.9),
      0 30px 60px -30px rgba(var(--accent-rgb), 0.35);
  }
  .fd__ui {
    position: relative;
    height: 100%;
    border-radius: clamp(8px, 1.4vw, 14px);
    overflow: hidden;
    background: #223046;
    color: #eef3fb;
    font-family: var(--font-body);
    font-size: clamp(6.5px, 1.72cqw, 15px);
    line-height: 1.3;
    display: flex;
    flex-direction: column;
  }
  .fd__ui small {
    display: block;
    font-size: 0.72em;
    color: #9fb0c8;
  }
  .fd__top {
    display: flex;
    align-items: center;
    gap: 1em;
    padding: 0.7em 1em;
    background: #1b2638;
  }
  .fd__logo {
    height: 2.3em;
    width: auto;
  }
  .fd__pill,
  .fd__who,
  .fd__status {
    padding: 0.45em 0.9em;
    border-radius: 0.7em;
    background: #2a3a52;
    font-weight: 600;
  }
  .fd__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: none;
  }
  .fd__who {
    flex: 1;
  }
  .fd__status i {
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-right: 0.4em;
    border-radius: 50%;
    background: #3ddc97;
  }

  .fd__body {
    flex: 1;
    display: grid;
    grid-template-columns: 0.9fr 1fr;
    gap: 0.8em;
    padding: 0.8em;
    min-height: 0;
  }
  .fd__cart,
  .fd__shop {
    position: relative;
    border-radius: 1em;
    background: #2b3b52;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.85em;
    min-height: 0;
    overflow: hidden;
  }
  .fd__cart {
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }
  .fd__cart-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 1.12em;
  }
  .fd__saved {
    font-size: 0.7em;
    color: #9fb0c8;
  }
  .fd__cust {
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 99em;
    padding: 0.5em 1em;
    text-align: center;
    color: #9fc0ff;
    font-weight: 600;
  }
  .fd__cust > span {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }
  .fd__cust-on {
    color: #fff;
    animation: fd-in 0.5s var(--ease-out);
  }
  .fd__cust-on i {
    display: grid;
    place-items: center;
    width: 1.7em;
    height: 1.7em;
    border-radius: 50%;
    background: var(--forge);
    color: #1a0e03;
    font-style: normal;
    font-size: 0.8em;
    font-weight: 800;
  }
  .fd__cust-on em {
    font-style: normal;
    font-weight: 500;
    color: var(--forge-2);
  }
  .fd__lines {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .fd__line {
    display: grid;
    grid-template-columns: auto 1fr auto;
    column-gap: 0.7em;
    align-items: center;
    padding: 0.55em 0.7em;
    margin-bottom: 0.45em;
    border-radius: 0.8em;
    border: 1px solid rgba(255, 255, 255, 0.13);
    background: #31435c;
  }
  .fd__qty {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.1em;
    height: 2.1em;
    border-radius: 0.5em;
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-weight: 700;
  }
  .fd__name {
    font-weight: 650;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5em;
  }
  .fd__ebt {
    font-size: 0.68em;
    font-weight: 700;
    color: #57e3a6;
    padding: 0.15em 0.55em;
    border-radius: 99em;
    background: rgba(61, 220, 151, 0.14);
  }
  .fd__price {
    font-weight: 750;
    font-size: 1.08em;
    font-feature-settings: 'tnum' 1;
  }
  .fd__dual {
    grid-column: 2 / -1;
    display: flex;
    align-items: center;
    gap: 0.45em;
    font-size: 0.78em;
    color: #b9c6da;
    border-radius: 0.4em;
    transition:
      color 0.4s,
      background 0.4s,
      box-shadow 0.4s;
  }
  .fd__dual b {
    opacity: 0.5;
  }
  /* step 2 of the story: the dual price lights up */
  .fd[data-step='1'] .fd__dual {
    color: #ffd9b3;
    background: rgba(244, 123, 32, 0.2);
    box-shadow: 0 0 0 0.35em rgba(244, 123, 32, 0.2);
  }
  .fd__dep {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    margin-left: auto;
    padding: 0.1em 0.55em;
    border-radius: 99em;
    font-weight: 700;
    color: #1a0e03;
    background: var(--forge-2);
  }
  .fd__total {
    display: grid;
    gap: 0.5em;
  }
  .fd__total-row {
    display: flex;
    align-items: baseline;
    gap: 0.7em;
    font-weight: 700;
    font-size: 1.1em;
  }
  .fd__card-est {
    margin-left: auto;
    font-size: 0.66em;
    font-weight: 500;
    color: #b9c6da;
  }
  .fd__total-row strong {
    font-size: 1.3em;
    font-feature-settings: 'tnum' 1;
  }
  .fd__pay {
    display: flex;
    justify-content: space-between;
    padding: 0.7em 1.1em;
    border-radius: 0.8em;
    background: var(--forge);
    color: #1a0e03;
    font-size: 1.15em;
    font-weight: 800;
    transition:
      transform 0.4s var(--spring),
      box-shadow 0.4s;
  }
  .fd[data-step='3'] .fd__pay {
    transform: scale(0.97);
    box-shadow: 0 0 0 0.4em rgba(244, 123, 32, 0.3);
  }

  .fd__shop {
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }
  .fd__search {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.7em 0.9em;
    border-radius: 0.7em;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #9fb0c8;
  }
  .fd__actions {
    display: flex;
    gap: 0.5em;
    font-size: 0.86em;
    font-weight: 600;
  }
  .fd__actions span {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.5em 0.8em;
    border-radius: 0.6em;
    background: #34475f;
    white-space: nowrap;
  }
  .fd[data-step='0'] .fd__scan {
    background: var(--forge);
    color: #1a0e03;
  }
  .fd__tiles {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5em;
    min-height: 0;
  }
  .fd__tiles span {
    display: grid;
    place-items: center;
    padding: 0.3em;
    border-radius: 0.7em;
    font-weight: 700;
    font-size: 0.9em;
    text-align: center;
  }
  .fd__toast {
    position: absolute;
    left: 50%;
    top: 0.8em;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.55em 1em;
    border-radius: 99em;
    background: #0e1620;
    border: 1px solid rgba(244, 123, 32, 0.6);
    color: #ffd9b3;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 1em 2em -0.6em #000;
  }
  .fd__sheet {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55em;
    padding: 1.1em;
    background: rgba(27, 38, 56, 0.97);
    pointer-events: none;
  }
  .fd__sheet > b {
    font-size: 1.3em;
  }
  .fd__sheet > p {
    color: #9fb0c8;
    font-size: 0.86em;
    margin-top: -0.4em;
  }
  .fd__tender {
    display: flex;
    align-items: center;
    gap: 0.8em;
    padding: 0.8em 1em;
    border-radius: 0.8em;
    background: #31435c;
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-weight: 650;
  }
  .fd__tender span {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    flex: 1;
  }
  .fd__tender strong {
    font-size: 1.15em;
    font-feature-settings: 'tnum' 1;
  }
  .fd__ok {
    display: grid;
    place-items: center;
    width: 1.6em;
    height: 1.6em;
    border-radius: 50%;
    background: #3ddc97;
    color: #062b1b;
  }
  .fd__reader {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.8em;
    font-size: 0.86em;
    color: #b9c6da;
  }
  .fd__reader span {
    width: 1.2em;
    height: 1.2em;
    border-radius: 50%;
    border: 0.2em solid rgba(244, 123, 32, 0.3);
    border-top-color: var(--forge);
    animation: fd-spin 0.9s linear infinite;
  }
  .fd__sheet--paid {
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .fd__done {
    display: grid;
    place-items: center;
    width: 3.6em;
    height: 3.6em;
    border-radius: 50%;
    background: #3ddc97;
    color: #062b1b;
    box-shadow: 0 0 0 0.7em rgba(61, 220, 151, 0.16);
  }
  .fd__receipt {
    display: flex;
    gap: 0.6em;
    margin-top: 0.4em;
    font-weight: 650;
  }
  .fd__receipt span {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.6em 1.1em;
    border-radius: 0.7em;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .fd__receipt span:first-child {
    background: var(--forge);
    border-color: transparent;
    color: #1a0e03;
  }
  .fd__pts {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 0.3em;
    padding: 0.35em 0.9em;
    border-radius: 99em;
    font-weight: 700;
    font-size: 0.86em;
    color: var(--forge-2);
    background: rgba(244, 123, 32, 0.16);
  }

  /* scanner beam, step 1 only */
  .fd__beam {
    position: absolute;
    left: 46%;
    right: 2%;
    top: 20%;
    height: 0.18em;
    border-radius: 1em;
    background: #ff5a3c;
    box-shadow: 0 0 1.2em 0.3em rgba(255, 90, 60, 0.7);
    opacity: 0;
    pointer-events: none;
  }
  .fd[data-step='0'] .fd__beam {
    animation: fd-beam 0.9s var(--ease) 0.1s 1 both;
  }

  /* customer display */
  .fd__customer {
    position: absolute;
    z-index: 2;
    right: -3%;
    bottom: -11%;
    width: 37%;
    container-type: inline-size;
    aspect-ratio: 16 / 10.5;
    border-radius: clamp(8px, 1.3vw, 16px);
    padding: clamp(3px, 0.5vw, 6px);
    background: linear-gradient(160deg, #3a4254, #0b0d13 50%);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.16) inset,
      0 30px 50px -20px rgba(0, 0, 0, 0.95);
    transform: rotate(2.5deg);
  }
  .fd__ui--cust {
    font-size: clamp(6px, 4.5cqw, 14px);
    padding: 1em;
    gap: 0.6em;
    background: #10171f;
    border-radius: clamp(5px, 0.9vw, 10px);
  }
  .fd__ui--cust > small {
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.6em;
  }
  .fd__c-live {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .fd__c-lines {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 0.35em;
    font-size: 0.86em;
  }
  .fd__c-lines span {
    display: flex;
    justify-content: space-between;
    gap: 0.6em;
    color: #c9d4e5;
  }
  .fd__c-totals {
    display: grid;
