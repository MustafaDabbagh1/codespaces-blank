---
// PPD Rewards: processing volume becomes a balance, the balance becomes a credit.
// Flow follows ppdrewards.com; every figure is illustrative sample data.
import DemoSteps from './DemoSteps.astro';
import Icon from '../Icon.astro';

interface Props {
  layout?: 'split' | 'flip' | 'stack';
  captions?: boolean;
}
const { layout = 'split', captions = true } = Astro.props;

const steps = [
  { title: 'Process with PPD.', body: 'Run your payments through PPD Technology like you do today.' },
  { title: 'Earn rewards monthly.', body: 'Eligible processing volume is converted into rewards each month.' },
  { title: 'Redeem when you’re ready.', body: 'Choose a statement credit, or a digital gift card or Visa prepaid card.' },
  { title: 'One wallet, every location.', body: 'Track rewards by location while viewing one combined balance for the business.' },
];
---

<div class:list={['demo', `demo--${layout}`, 't-rewards', 'wd']} data-stepper data-durations="2800,2800,3200,3200" data-rest="1">
  {
    captions && (
      <div class="demo__side">
        <slot />
        <DemoSteps steps={steps} label="How PPD Rewards works" />
      </div>
    )
  }

  <div class="demo__stage">
    <div class="demo__glow"></div>
    <div class="wd__win" role="img" aria-label="Animated illustration of PPD Rewards: monthly processing volume fills a meter, a reward is added to the wallet balance, and the balance is redeemed as a statement credit, with rewards tracked per location.">
      <div class="wd__ui" aria-hidden="true">
        <div class="wd__vol">
          <div class="wd__head">
            <img src="/images/brand/rewards-logo.webp" alt="" width="240" height="240" loading="lazy" />
            <div><b>PPD Rewards</b><small>Good standing · enrolled</small></div>
          </div>
          <small class="wd__lab">Eligible volume this month</small>
          <div class="wd__locs">
            <div>
              <span>Main Street</span>
              <div class="wd__meter"><i style="--w:82%"></i></div>
            </div>
            <div>
              <span>Westside</span>
              <div class="wd__meter"><i style="--w:61%;--dl:250ms"></i></div>
            </div>
            <div>
              <span>Airport kiosk</span>
              <div class="wd__meter"><i style="--w:38%;--dl:500ms"></i></div>
            </div>
          </div>
          <div class="wd__hist">
            <small class="wd__lab">Rewards earned · last 6 months</small>
            <div class="wd__histbars">
              {[46, 58, 52, 70, 66, 78].map((h, i) => <i style={`--h:${h}%`} class:list={{ 'is-now': i === 5 }} />)}
            </div>
          </div>
          <div class="wd__perloc">
            <span class="fx fx-pop" data-from="3" style="--d:200ms">Main Street <b>+$6.10</b></span>
            <span class="fx fx-pop" data-from="3" style="--d:500ms">Westside <b>+$4.20</b></span>
            <span class="fx fx-pop" data-from="3" style="--d:800ms">Airport kiosk <b>+$2.10</b></span>
          </div>
        </div>

        <div class="wd__wallet">
          <small class="wd__lab">Rewards wallet</small>
          <div class="wd__bal">
            <span class="fx-swap on" data-from="0" data-to="0">$236.10</span>
            <span class="fx-swap wd__bump" data-from="1" data-to="1">$248.50</span>
            <span class="fx-swap" data-from="2" data-to="2">$248.50</span>
            <span class="fx-swap wd__bump" data-from="3">$198.50</span>
          </div>
          <small>Available balance</small>

          <div class="wd__coin fx" data-from="1" data-to="1"><Icon name="plus" size={11} stroke={3} /> $12.40 this month</div>

          <div class="wd__opts">
            <div class="wd__opt is-pick">
              <Icon name="receipt" size={14} />
              <span>Statement credit</span>
            </div>
            <div class="wd__opt">
              <Icon name="gift" size={14} />
              <span>Digital gift card</span>
            </div>
          </div>

          <div class="wd__status">
            <p class="fx-swap on" data-from="0" data-to="0">Rewards post after each monthly cycle.</p>
            <p class="fx-swap is-up" data-from="1" data-to="1"><Icon name="plus" size={13} stroke={3} /> $12.40 added from this month’s eligible volume.</p>
            <p class="fx-swap is-done" data-from="2"><Icon name="check-circle" size={14} /> $50.00 statement credit submitted.</p>
          </div>

          <div class="wd__ledger">
            <div class="fx-row" data-from="1" style="--d:900ms"><div><span>Processing reward</span><b class="up">+$12.40</b></div></div>
            <div class="fx-row" data-from="2" style="--d:1500ms"><div><span>Statement credit</span><b>−$50.00</b></div></div>
            <div class="fx-row on" data-from="0"><div><span>Processing reward · last month</span><b class="up">+$11.85</b></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .wd__win {
    position: relative;
    z-index: 1;
    container-type: inline-size;
    aspect-ratio: 16 / 10;
    border-radius: clamp(10px, 1.6vw, 18px);
    overflow: hidden;
    background: linear-gradient(150deg, #101a36, #080d1c);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.14) inset,
      0 50px 90px -40px rgba(0, 0, 0, 0.9),
      0 30px 70px -30px rgba(var(--accent-rgb), 0.45);
  }
  .wd__ui {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 0.95fr;
    gap: 1.2em;
    padding: 1.4em;
    color: #f4f1e6;
    font-family: var(--font-body);
    font-size: clamp(6.5px, 1.72cqw, 15px);
    line-height: 1.3;
  }
  .wd__ui small {
    display: block;
    font-size: 0.74em;
    color: #a9a48f;
  }
  .wd__lab {
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.64em !important;
  }
  .wd__vol,
  .wd__wallet {
    display: flex;
    flex-direction: column;
    gap: 0.8em;
    min-height: 0;
  }
  .wd__head {
    display: flex;
    align-items: center;
    gap: 0.8em;
    margin-bottom: 0.6em;
  }
  .wd__head img {
    width: 3.4em;
    height: 3.4em;
  }
  .wd__head b {
    font-family: var(--font-display);
    font-size: 1.35em;
    letter-spacing: -0.02em;
  }
  .wd__locs {
    display: grid;
    gap: 0.9em;
  }
  .wd__locs span {
    display: block;
    margin-bottom: 0.35em;
    font-size: 0.86em;
    font-weight: 600;
  }
  .wd__meter {
    height: 0.75em;
    border-radius: 99em;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }
  .wd__meter i {
    display: block;
    width: var(--w);
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #b8791a, #ffd77a);
    transform-origin: left;
  }
  .wd[data-step='0'] .wd__meter i {
    animation: wd-fill 1.6s var(--ease-out) var(--dl, 0ms) both;
  }
  .wd__hist {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    margin-top: 0.6em;
    min-height: 0;
  }
  .wd__histbars {
    flex: 1;
    display: flex;
    align-items: flex-end;
    gap: 5%;
    min-height: 0;
  }
  .wd__histbars i {
    flex: 1;
    height: var(--h);
    border-radius: 0.35em 0.35em 0 0;
    background: rgba(255, 215, 122, 0.22);
  }
  .wd__histbars i.is-now {
    background: linear-gradient(#ffd77a, #b8791a);
  }
  .wd__perloc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45em;
    min-height: 2.1em;
  }
  .wd__status {
    flex: 1;
    display: grid;
    align-content: center;
    min-height: 0;
  }
  .wd__status p {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.8em 0.9em;
    border-radius: 0.8em;
    font-size: 0.9em;
    font-weight: 600;
    line-height: 1.35;
    background: rgba(255, 255, 255, 0.06);
    color: #d9d4c0;
    animation: wd-in 0.5s var(--ease-out);
  }
  .wd__status p.is-up {
    color: #ffe9b3;
    background: rgba(255, 215, 122, 0.14);
  }
  .wd__status p.is-done {
    color: #b9f3d6;
    background: rgba(46, 211, 160, 0.14);
  }
  .wd__perloc span {
    padding: 0.4em 0.8em;
    border-radius: 99em;
    font-size: 0.78em;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 215, 122, 0.28);
  }
  .wd__perloc b {
    color: #ffd77a;
  }

  .wd__wallet {
    position: relative;
    padding: 1.2em;
    border-radius: 1.1em;
    background: linear-gradient(160deg, rgba(255, 215, 122, 0.16), rgba(255, 215, 122, 0.03));
    border: 1px solid rgba(255, 215, 122, 0.32);
    gap: 0.35em;
  }
  .wd__bal {
    font-family: var(--font-display);
    font-size: 2.9em;
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1;
    font-feature-settings: 'tnum' 1;
    color: #ffe9b3;
  }
  .wd__bump {
    display: inline-block;
    animation: wd-bump 0.7s var(--spring) 0.5s both;
  }
  .wd__coin {
    position: absolute;
    right: 1.2em;
    top: 1.2em;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.4em 0.8em;
    border-radius: 99em;
    font-weight: 700;
    font-size: 0.82em;
    color: #2a1c00;
    background: #ffd77a;
    transform: translateX(-9em) scale(0.6);
  }
  .wd__coin.on {
    transform: none;
    transition:
      opacity 0.3s,
      transform 0.9s var(--ease-out);
  }
  .wd__opts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5em;
    margin-top: 0.9em;
  }
  .wd__opt {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.7em;
    border-radius: 0.7em;
    font-size: 0.82em;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.16);
    transition:
      background 0.4s,
      border-color 0.4s,
      color 0.4s;
  }
  .wd[data-step='2'] .wd__opt.is-pick,
  .wd[data-step='3'] .wd__opt.is-pick {
    background: #ffd77a;
    border-color: #ffd77a;
    color: #2a1c00;
    transition-delay: 0.6s;
  }
  .wd__ledger {
    padding-top: 0.2em;
  }
  .wd__ledger div div {
    display: flex;
    justify-content: space-between;
    gap: 0.8em;
    padding: 0.42em 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8em;
  }
  .wd__ledger span {
    color: #c9c4b0;
  }
  .wd__ledger b {
    font-feature-settings: 'tnum' 1;
  }
  .wd__ledger b.up {
    color: #7be0b0;
  }

  @keyframes wd-fill {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes wd-in {
    from {
      opacity: 0;
      transform: translateY(0.5em);
    }
  }
  @keyframes wd-bump {
    0% {
      transform: scale(0.86);
      color: #fff;
    }
    100% {
      transform: none;
    }
  }
</style>
