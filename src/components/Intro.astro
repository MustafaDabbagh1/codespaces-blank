---
// Entrance sequence: light streaks rush past while a counter "authorizes" to
// 100, the chip mark confirms, and the page is revealed. Plays once per
// browser session, can be skipped with any key, click or scroll, and never
// plays for visitors who prefer reduced motion. The decision is made by the
// inline script in SiteLayout's <head>, which sets html.intro-on before paint.
---

<div class="intro" data-intro role="status" aria-label="Loading PPD Technology">
  <canvas aria-hidden="true"></canvas>
  <div class="intro__mark" aria-hidden="true">
    <svg viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="1.2" y="1.2" width="29.6" height="21.6" rx="6"></rect>
      <path d="M11.1 1.4 15.9 5.7l4.8-4.3M15.9 5.7v.95a1.2 1.2 0 0 1-1.2 1.2H1.3M10.6 7.85v7.25M1.3 15.1h29.4M21.5 15.1V9.05a1.2 1.2 0 0 1 1.2-1.2h8M15.9 15.1v2.1M11.1 22.6l4.8-5.4 4.8 5.4"></path>
    </svg>
  </div>
  <div class="intro__hud" aria-hidden="true">
    <p class="intro__line"><span></span><b data-intro-label>Authorizing</b><i data-intro-count>000</i></p>
    <p class="intro__sub">PPD Technology · secure channel</p>
  </div>
  <button class="intro__skip" type="button" data-intro-skip>Skip intro</button>
</div>

<script>
  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>('[data-intro]');

  const ready = () => root.classList.add('is-ready');

  if (!el || !root.classList.contains('intro-on')) {
    el?.remove();
    ready();
  } else {
    const canvas = el.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const count = el.querySelector<HTMLElement>('[data-intro-count]')!;
    const label = el.querySelector<HTMLElement>('[data-intro-label]')!;

    const WARP = 2100;
    const HOLD = 480;
    const OUT = 900;
    const palette = ['#ffffff', '#cfe0ff', '#8fb8ff', '#5aa2ff', '#62e3ff'];

    let w = 0;
    let h = 0;
    let maxR = 0;
    const size = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      maxR = Math.hypot(w, h) / 2;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    size();
    window.addEventListener('resize', size);

    type Star = { a: number; r: number; v: number; c: string; lw: number; o: number };
    const spawn = (anywhere: boolean): Star => ({
      a: Math.random() * Math.PI * 2,
      r: anywhere ? Math.random() * maxR : 12 + Math.random() * 60,
      v: 0.35 + Math.random() * 1.5,
      c: palette[(Math.random() * palette.length) | 0],
      lw: 0.5 + Math.random() * 1.3,
      o: 0.35 + Math.random() * 0.65,
    });
    const stars: Star[] = Array.from({ length: Math.min(420, Math.round((w * h) / 3600)) }, () => spawn(true));

    const start = performance.now();
    let last = start;
    let raf = 0;
    let state: 'warp' | 'hold' | 'out' = 'warp';

    // slow drift, a hard burst, then a glide back down
    const speedAt = (t: number) => 0.3 + 9 * Math.pow(Math.sin(Math.PI * Math.min(1, Math.max(0, (t - 0.04) / 0.96))), 2);

    const draw = (now: number) => {
      const dt = Math.min(48, now - last) / 16.7;
      last = now;
      const t = Math.min(1, (now - start) / WARP);
      const speed = state === 'warp' ? speedAt(t) : 0.25;

      ctx.fillStyle = 'rgba(2, 4, 14, 0.42)';
      ctx.fillRect(0, 0, w, h);
      const cx = w / 2;
      const cy = h / 2;
      ctx.lineCap = 'round';
      for (const s of stars) {
        const step = speed * s.v * dt * (0.6 + s.r / maxR) * 3.2;
        s.r += step;
        // a faint radial field is there from the first frame; the burst stretches it
        const len = Math.max(s.r * 0.07, Math.min(s.r * 0.55, step * (5 + speed * 2.4)));
        const cos = Math.cos(s.a);
        const sin = Math.sin(s.a);
        ctx.globalAlpha = Math.min(1, s.r / (maxR * 0.22)) * s.o * (0.45 + Math.min(1, speed / 4) * 0.55);
        ctx.strokeStyle = s.c;
        ctx.lineWidth = s.lw * (0.5 + s.r / maxR);
        ctx.beginPath();
        ctx.moveTo(cx + cos * (s.r - len), cy + sin * (s.r - len));
        ctx.lineTo(cx + cos * s.r, cy + sin * s.r);
        ctx.stroke();
        if (s.r - len > maxR) Object.assign(s, spawn(false));
      }
      ctx.globalAlpha = 1;

      if (state === 'warp') {
        const eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
        count.textContent = String(Math.round(eased * 100)).padStart(3, '0');
        if (t >= 1) approve();
      }
      raf = requestAnimationFrame(draw);
    };

    let timer = 0;
    const approve = () => {
      if (state !== 'warp') return;
      state = 'hold';
      count.textContent = '100';
      label.textContent = 'Approved';
      el.classList.add('is-approved');
      timer = window.setTimeout(leave, HOLD);
    };

    const leave = () => {
      if (state === 'out') return;
      state = 'out';
      window.clearTimeout(timer);
      try {
        sessionStorage.setItem('ppd-intro', '1');
      } catch {
        /* private mode: the intro simply plays again next time */
      }
      ready();
      el.classList.add('is-leaving');
      window.setTimeout(() => {
        cancelAnimationFrame(raf);
        window.removeEventListener('resize', size);
        root.classList.remove('intro-on');
        el.remove();
      }, OUT);
      off();
    };

    const skip = () => leave();
    const events = ['pointerdown', 'keydown', 'wheel', 'touchstart'] as const;
    const off = () => events.forEach((e) => window.removeEventListener(e, skip));
    events.forEach((e) => window.addEventListener(e, skip, { passive: true }));

    raf = requestAnimationFrame(draw);
  }
</script>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    background: #02040e;
    color: #dfe8ff;
    overflow: hidden;
    transition:
      opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.9s cubic-bezier(0.4, 0, 0.2, 1),
      filter 0.8s;
    /* if scripts never run, get out of the way on its own */
    animation: intro-failsafe 1ms linear 7s forwards;
  }
  :global(html.intro-on) .intro {
    display: block;
  }
  .intro.is-leaving {
    opacity: 0;
    transform: scale(1.08);
    filter: blur(6px);
    pointer-events: none;
  }
  .intro canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .intro__mark {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 84px;
    height: 84px;
    margin: -42px 0 0 -42px;
    display: grid;
    place-items: center;
    border-radius: 24px;
    color: #62e3ff;
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.35s,
      transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .intro__mark svg {
    width: 56px;
    height: 42px;
    filter: drop-shadow(0 0 14px rgba(98, 227, 255, 0.9));
  }
  .intro__mark::before,
  .intro__mark::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px solid rgba(98, 227, 255, 0.7);
    opacity: 0;
  }
  .intro.is-approved .intro__mark {
    opacity: 1;
    transform: none;
  }
  .intro.is-approved .intro__mark::before {
    animation: intro-ring 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .intro.is-approved .intro__mark::after {
    animation: intro-ring 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.14s both;
  }
  .intro__hud {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(36px, 8vh, 80px);
    display: grid;
    gap: 8px;
    justify-items: center;
    font-family: 'Geist Mono Variable', 'Geist Mono', ui-monospace, monospace;
    text-transform: uppercase;
  }
  .intro__line {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.3em;
  }
  .intro__line span {
    width: 28px;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }
  .intro__line b {
    font-weight: 500;
  }
  .intro__line i {
    font-style: normal;
    font-variant-numeric: tabular-nums;
    color: #62e3ff;
    min-width: 3ch;
  }
  .intro.is-approved .intro__line b {
    color: #62e3ff;
  }
  .intro__sub {
    margin: 0;
    font-size: 0.64rem;
    letter-spacing: 0.26em;
    color: #6f7fa6;
  }
  .intro__skip {
    position: absolute;
    right: clamp(16px, 3vw, 36px);
    top: clamp(16px, 3vw, 30px);
    padding: 8px 12px;
    font: 500 0.7rem/1 'Geist Mono Variable', 'Geist Mono', ui-monospace, monospace;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6f7fa6;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .intro__skip:hover,
  .intro__skip:focus-visible {
    color: #fff;
  }
  @keyframes intro-ring {
    from {
      opacity: 0.9;
      transform: scale(0.7);
    }
    to {
      opacity: 0;
      transform: scale(2.6);
    }
  }
  @keyframes intro-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
