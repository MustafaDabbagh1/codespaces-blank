---
// Layout for the rebuilt pages. Legacy pages continue to use BaseLayout.
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Intro from '../components/Intro.astro';

const defaultDescription =
  'PPD Technology pairs payment processing with software we build ourselves: Forge POS, PPD Repair, PPD Merchant and PPD Rewards. For businesses that want more than a terminal, and agents who want more than an ISO.';

const {
  title = 'PPD Technology | Payments and the software that runs on top',
  description = defaultDescription,
  ogImage = '/images/og-default.png',
  ogType = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const resolvedOgImage = new URL(ogImage, Astro.site ?? Astro.url.origin).href;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // Runs before first paint: drop the no-JS fallback and decide whether the
      // entrance sequence plays (once per session, never with reduced motion).
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        var play = false;
        try {
          play = !window.matchMedia('(prefers-reduced-motion: reduce)').matches && sessionStorage.getItem('ppd-intro') !== '1';
        } catch (e) {}
        d.classList.add(play ? 'intro-on' : 'is-ready');
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="theme-color" content="#05070d" />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="PPD Technology" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
    <slot name="head" />
  </head>
  <body>
    <Intro />
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script>
      import { initSteppers } from '../scripts/stepper';

      initSteppers();

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          });
        },
        { threshold: 0.14, rootMargin: '0px 0px -6% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Statements whose words light up as they travel up the screen.
      const lit = Array.from(document.querySelectorAll<HTMLElement>('[data-lightup]'));
      lit.forEach((el) => {
        const words = (el.textContent || '').trim().split(/\s+/);
        el.setAttribute('aria-label', words.join(' '));
        el.replaceChildren(
          ...words.flatMap((word) => {
            const span = document.createElement('span');
            span.className = 'w';
            span.setAttribute('aria-hidden', 'true');
            span.textContent = word;
            return [span, document.createTextNode(' ')];
          }),
        );
      });
      if (lit.length) {
        let queued = false;
        const paint = () => {
          queued = false;
          const vh = window.innerHeight;
          lit.forEach((el) => {
            const rect = el.getBoundingClientRect();
            if (rect.bottom < 0 || rect.top > vh) return;
            // 0 when the block enters at 85% of the screen, 1 when it reaches 35%
            const progress = Math.min(1, Math.max(0, (vh * 0.85 - rect.top) / (vh * 0.5 + rect.height * 0.6)));
            const spans = el.querySelectorAll('.w');
            const upTo = Math.round(progress * spans.length);
            spans.forEach((s, i) => s.classList.toggle('on', i < upTo));
          });
        };
        const onScroll = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(paint);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        paint();
      }
    </script>

    <style is:global>
      .skip {
        position: fixed;
        left: 16px;
        top: -80px;
        z-index: 999;
        padding: 12px 18px;
        border-radius: 12px;
        background: #fff;
        color: #05070d;
        font-weight: 600;
        transition: top 0.2s;
      }
      .skip:focus {
        top: 16px;
      }
    </style>
  </body>
</html>
