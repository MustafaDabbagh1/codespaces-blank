---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title = "PPD Technology | Modern Payment Solutions" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style is:global>
      :root{
        --primary:#0055FF;--primary-dark:#0044CC;--secondary:#0F1B35;--accent:#00CC96;
        --light:#F5F7FA;--dark:#1A232E;--gray:#64748B;--light-gray:#E2E8F0;
        --glow:#80a8ff;--warning:#FFD166;
        --mobile-hero-top: calc(64px + env(safe-area-inset-top,0px));
      }
      *{margin:0;padding:0;box-sizing:border-box}
      html,body{background:var(--light);color:var(--dark);line-height:1.6;overflow-x:hidden}
      body{font-family:'Inter',sans-serif}
      a{text-decoration:none;color:inherit}
      .container{width:100%;max-width:1200px;margin:0 auto;padding:0 20px}

      .scroll-progress{position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,var(--primary),var(--accent));width:0%;z-index:9999;transition:width .1s linear}

      header{background:#fff;box-shadow:0 2px 10px rgba(0,0,0,.08);position:sticky;top:0;z-index:100;transition:all .3s ease}
      header.shrink{transform:translateY(-2px);box-shadow:0 8px 30px rgba(0,0,0,.12)}
      .header-container{display:flex;justify-content:space-between;align-items:center;padding:15px 0}
      .logo{font-size:20px;font-weight:700;color:var(--primary);display:flex;align-items:center;gap:8px;white-space:nowrap}
      .logo span{color:var(--secondary)}

      .brandtext{display:inline-flex;gap:0}
      .brandtext .ppd{color:var(--primary);font-weight:800}
      .brandtext .tech{color:#000;font-weight:800}

      .logo-chip{
        width:28px;height:28px;display:inline-block;line-height:0;
        background:var(--primary);
        -webkit-mask:url("https://ppdtechnology.com/images/Chip-reader-EMV.png") center/contain no-repeat;
                mask:url("https://ppdtechnology.com/images/Chip-reader-EMV.png") center/contain no-repeat;
        animation:pulse 2s infinite;
        filter:
          drop-shadow( 1px  0   0 var(--primary))
          drop-shadow(-1px  0   0 var(--primary))
          drop-shadow( 0    1px 0 var(--primary))
          drop-shadow( 0   -1px 0 var(--primary));
      }
      @supports not ((mask: url("")) or (-webkit-mask: url(""))){
        .logo-chip{background:none;filter:none;display:inline-flex;align-items:center;justify-content:center}
        .logo-chip::before{content:"";width:28px;height:28px;background:url("https://ppdtechnology.com/images/Chip-reader-EMV.png") center/contain no-repeat;animation:pulse 2s infinite;display:block}
      }

      nav ul{display:flex;list-style:none;gap:20px;align-items:center}
      nav ul li a{font-weight:500;transition:color .3s;position:relative;font-size:15px}
      nav ul li a::after{content:'';position:absolute;bottom:-6px;left:50%;width:0;height:2px;background:var(--primary);transition:all .3s;transform:translateX(-50%)}
      nav ul li a:hover::after{width:100%}
      .header-buttons{display:flex;gap:10px}
      .btn{padding:10px 18px;border-radius:30px;font-weight:600;transition:transform .2s ease, box-shadow .25s, background .3s, color .3s;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;font-size:14px;position:relative;overflow:hidden}
      .btn::after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent,rgba(255,255,255,.6),transparent);transform:translateX(-150%);}
      .btn:hover::after{animation:btnSweep .8s ease}
      .btn-outline{border:2px solid var(--primary);color:var(--primary);background:transparent}
      .btn-outline:hover{background:var(--primary);color:#fff;transform:translateY(-3px);box-shadow:0 10px 20px rgba(0,85,255,.2)}
      .btn-primary{background:var(--primary);color:#fff;border:2px solid var(--primary)}
      .btn-primary:hover{background:var(--primary-dark);border-color:var(--primary-dark);transform:translateY(-3px);box-shadow:0 10px 20px rgba(0,85,255,.3)}
      .hamburger{display:none;flex-direction:column;justify-content:space-between;width:24px;height:18px;cursor:pointer}
      .hamburger span{height:2px;width:100%;background:var(--primary);border-radius:2px;transition:all .3s}
      @media (max-width:767px){
        .header-container{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:15px 20px}
        .logo{grid-column:2;justify-self:center}
        .hamburger{display:flex;grid-column:3;justify-self:end}
        nav,.header-buttons{display:none}
      }

      .dropdown{position:relative}
      .dropdown>a{display:inline-flex;align-items:center;gap:6px;padding-right:16px}
      .dropdown>a .chev{font-size:12px;transition:transform .25s}
      .dropdown-menu{position:absolute;top:100%;left:0;min-width:260px;background:#fff;border:1px solid var(--light-gray);border-radius:12px;box-shadow:0 12px 28px rgba(0,0,0,.08);padding:10px;display:none;z-index:999;animation:menuPop .2s ease forwards}
      .dropdown-menu::before{content:'';position:absolute;left:0;right:0;top:-12px;height:12px}
      .dropdown-menu a{display:flex;gap:10px;align-items:center;padding:10px 12px;border-radius:10px;color:var(--secondary);font-weight:500;font-size:14px;transition:transform .15s ease}
      .dropdown-menu a:hover{transform:translateX(3px)}
      .dropdown:hover .dropdown-menu,.dropdown:focus-within .dropdown-menu{display:block}
      .dropdown:hover>a .chev,.dropdown:focus-within>a .chev{transform:rotate(180deg)}
      .dropdown-menu a i,.dropdown-menu a svg{width:16px;height:16px;flex:0 0 16px}

      .mobile-menu{position:fixed;top:0;right:-100%;width:80%;max-width:320px;height:100vh;background:#fff;z-index:1000;padding:80px 30px 30px;box-shadow:-5px 0 25px rgba(0,0,0,.1);transition:right .3s ease;overflow-y:auto}
      .mobile-menu.active{right:0}
      .mobile-menu ul{list-style:none}
      .mobile-menu ul li{margin-bottom:14px}
      .mobile-menu ul li a{font-size:18px;font-weight:500;color:var(--secondary);display:block;padding:10px 0;border-bottom:1px solid rgba(0,0,0,.1)}
      .mobile-menu .header-buttons{flex-direction:column;margin-top:30px;gap:15px}
      .close-menu{position:absolute;top:20px;right:20px;font-size:24px;background:none;border:none;color:var(--primary);cursor:pointer}
      .overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.5);z-index:999;opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s}
      .overlay.active{opacity:1;visibility:visible}
      .mobile-submenu-toggle{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(0,0,0,.1);font-size:18px;font-weight:600;color:var(--secondary);cursor:pointer}
      .mobile-submenu{display:none;padding-left:10px}
      .mobile-submenu a{border:none;font-size:16px;padding:8px 0;color:#0F1B35}
      .mobile-submenu.open{display:block}

      .hero{background:radial-gradient(1200px 600px at 20% -10%,rgba(0,85,255,.35),transparent 60%),linear-gradient(135deg,var(--secondary) 0%,var(--primary-dark) 100%);color:#fff;padding:60px 0;position:relative;overflow:hidden;display:flex;align-items:center;z-index:1}
      .hero::after{content:"";position:absolute;inset:-20%;background:conic-gradient(from 180deg at 50% 50%,rgba(255,255,255,.06),transparent 30%,rgba(255,255,255,.06));filter:blur(60px);opacity:.4;animation:spinSlow 30s linear infinite;z-index:0}
      .hero-content{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:40px;position:relative;z-index:2}
      .hero-text{flex:1;text-align:center;padding:0 10px}
      .hero-kicker{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);padding:6px 12px;border-radius:999px;margin-bottom:14px;font-size:12px;backdrop-filter:blur(6px)}
      .hero-text h1{font-size:2.2rem;line-height:1.2;margin-bottom:16px;animation:fadeInUp .9s ease-out}
      .hero-text p{font-size:1rem;margin-bottom:28px;opacity:.95;animation:fadeInUp 1s ease-out .2s both}
      .hero-buttons{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;animation:fadeInUp 1s ease-out .4s both}

      .tech-animation.binary-code{position:absolute;inset:0;pointer-events:none;opacity:.15}
      .tech-animation .column{position:absolute;top:-100%;width:20px;white-space:nowrap;color:#9ec7ff;font-family:monospace;font-size:12px;animation:rain 6s linear infinite}

      .hero-animation{flex:1;position:relative;height:300px;width:100%;display:flex;justify-content:center;align-items:center;overflow:visible}
      .payment-terminal{position:relative;width:260px;height:180px;background:linear-gradient(145deg,#2c3e50,#4a6580);border-radius:12px;box-shadow:0 15px 30px rgba(0,0,0,.3);z-index:3;overflow:hidden;animation:float 6s ease-in-out infinite}
      .payment-terminal::before{content:"";position:absolute;inset:-2px;border-radius:14px;padding:2px;background:linear-gradient(90deg,rgba(255,255,255,.15),rgba(0,85,255,.6),rgba(255,255,255,.15));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;animation:borderShift 5s linear infinite}
      .terminal-screen{width:85%;height:60px;background:#0F1B35;margin:25px auto 20px;border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--accent);font-weight:600;font-size:16px;position:relative;overflow:hidden;font-family:'Courier New',monospace;box-shadow:inset 0 0 10px rgba(0,0,0,.5)}
      .terminal-screen::after{content:"";position:absolute;top:0;left:-100%;width:50%;height:100%;background:linear-gradient(to right,transparent,rgba(255,255,255,.15),transparent);animation:screenShine 4s infinite}
      .card-slot{width:60%;height:6px;background:linear-gradient(to right,#888,#aaa,#888);margin:0 auto;border-radius:3px}
      .payment-card{position:absolute;width:70px;height:45px;background:linear-gradient(45deg,#1a1f71,#3c5ccf);border-radius:6px;box-shadow:0 5px 15px rgba(0,0,0,.2);z-index:2;display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:bold;animation:cardSlideMobile 12s infinite ease-in-out;transform-style:preserve-3d}
      .payment-card::after{content:"";position:absolute;inset:0;border-radius:6px;background:linear-gradient(120deg,transparent,rgba(255,255,255,.25),transparent);transform:translateZ(30px);opacity:.7}
      .data-flow{position:absolute;width:50px;height:5px;background:var(--accent);border-radius:3px;z-index:1;box-shadow:0 0 10px var(--accent);animation:dataFlowMobile 4s infinite linear}
      .security-badge{position:absolute;width:35px;height:35px;background:rgba(255,255,255,.95);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:14px;box-shadow:0 0 15px rgba(0,85,255,.5);animation:badgePulse 5s infinite ease-in-out;z-index:4}
      .approval-check{position:absolute;width:30px;height:30px;background:var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;box-shadow:0 0 15px var(--accent);animation:checkPulse 4s infinite;z-index:3}
      .digital-currency{position:absolute;width:45px;height:45px;background:linear-gradient(45deg,#00CC96,#00B386);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:bold;font-size:16px;box-shadow:0 5px 15px rgba(0,0,0,.3);animation:currencyFloat 8s infinite ease-in-out;z-index:2}
      .background-element{position:absolute;border-radius:50%;opacity:.1;z-index:0}
      .circle-1{width:200px;height:200px;background:var(--accent);top:-100px;right:-100px;animation:pulseElement 15s infinite}
      .circle-2{width:150px;height:150px;background:var(--primary);bottom:-75px;left:10%;animation:pulseElement 12s infinite 2s}

      .marquee{background:#fff;padding:14px 0;position:relative;overflow:hidden;z-index:3}
      .marquee::before,.marquee::after{content:"";position:absolute;top:0;bottom:0;width:60px;pointer-events:none}
      .marquee::before{left:0;background:linear-gradient(90deg,#fff,rgba(255,255,255,0))}
      .marquee::after{right:0;background:linear-gradient(270deg,#fff,rgba(255,255,255,0))}
      .brands-viewport{overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;scroll-snap-type:x mandatory;scroll-behavior:smooth;touch-action:pan-x pinch-zoom;overscroll-behavior-x:contain;scrollbar-width:none}
      .brands-viewport::-webkit-scrollbar{display:none}
      .brands-track{display:flex;gap:16px;align-items:center;padding:2px 12px;width:max-content;animation:none !important;will-change:auto}
      .brand-pill{display:inline-flex;align-items:center;gap:10px;padding:10px 18px;border-radius:999px;background:rgba(15,27,53,.04);border:1px solid #e6ebf5;box-shadow:inset 0 -2px 6px rgba(0,0,0,.04),0 8px 16px rgba(16,24,40,.06);backdrop-filter:blur(6px);transition:transform .2s ease, box-shadow .25s ease, background .25s ease;flex:0 0 auto;scroll-snap-align:center}
      .brand-pill i{font-size:22px;color:#8aa1c2;opacity:.9;transition:color .25s ease, filter .25s ease}
      .brand-pill:hover{transform:translateY(-3px);box-shadow:0 12px 24px rgba(16,24,40,.10)}
      .brand-pill[data-brand="visa"]:hover i{color:#1a1f71}
      .brand-pill[data-brand="mastercard"]:hover i{color:#eb001b}
      .brand-pill[data-brand="amex"]:hover i{color:#2e77bb}
      .brand-pill[data-brand="discover"]:hover i{color:#ff6000}
      .brand-pill[data-brand="applepay"]:hover i{color:#111}
      .brand-pill[data-brand="googlepay"]:hover i{color:#0f9d58}

      .features{padding:70px 0;background:var(--light)}
      .section-title{text-align:center;margin-bottom:28px}
      .section-title h2{font-size:2rem;color:var(--secondary);margin-bottom:10px}
      .section-title p{font-size:1rem;color:var(--gray);max-width:700px;margin:0 auto}
      .metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:800px;margin:22px auto 0}
      .metric{background:#fff;border:1px solid var(--light-gray);border-radius:12px;padding:16px;display:flex;flex-direction:column;align-items:center;gap:2px;box-shadow:0 8px 24px rgba(16,24,40,.06)}
      .metric .num{font-size:28px;font-weight:800;color:var(--secondary)}
      .metric .label{font-size:12px;color:#475569}
      .features-grid{display:grid;grid-template-columns:1fr;gap:20px;margin-top:26px}
      .feature-card{background:#fff;border-radius:16px;padding:25px;box-shadow:0 18px 40px rgba(16,24,40,.08);transition:transform .25s,box-shadow .25s,opacity .4s;opacity:0;transform:translateY(24px);position:relative;overflow:hidden;will-change:transform}
      .feature-card::before{content:'';position:absolute;top:0;left:0;width:5px;height:0;background:var(--primary);transition:height .5s}
      .feature-card.animated{opacity:1;transform:translateY(0)}
      .feature-card.animated::before{height:100%}
      .feature-card:hover{transform:translateY(-6px) rotate3d(.2,.6,0,2deg);box-shadow:0 24px 60px rgba(16,24,40,.12)}
      .feature-icon{width:60px;height:60px;background:rgba(0,85,255,.1);border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:15px;transition:all .4s;transform-style:preserve-3d}
      .feature-card:hover .feature-icon{transform:rotateY(180deg) scale(1.1);background:var(--primary)}
      .feature-card:hover .feature-icon i{color:#fff}
      .feature-icon i{font-size:24px;color:var(--primary);transition:all .4s}
      .feature-card h3{font-size:1.2rem;margin-bottom:12px;color:var(--secondary)}

      .solutions{padding:70px 0;background:#fff;position:relative;overflow:hidden}
      .solutions::before{content:'';position:absolute;width:220px;height:220px;background:rgba(0,85,255,.05);border-radius:50%;top:-110px;right:-110px;animation:pulseElement 15s infinite}
      .solutions::after{content:'';position:absolute;width:180px;height:180px;background:rgba(0,204,150,.06);border-radius:50%;bottom:-90px;left:-90px;animation:pulseElement 12s infinite 2s}
      .slider-shell{position:relative}
      .slider-viewport{overflow:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:8px}
      .slider-viewport::-webkit-scrollbar{display:none}
      .slider-track{display:flex;gap:22px;align-items:stretch}
      .slide{scroll-snap-align:start;flex:0 0 88%}
      @media (min-width:600px){.slide{flex-basis:48%}}
      @media (min-width:992px){.slide{flex-basis:31%}}
      .solution-card{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 12px 28px rgba(16,24,40,.08);transition:transform .25s,box-shadow .25s,height .25s;display:flex;flex-direction:column;transform-style:preserve-3d}
      .solution-card:hover{transform:translateY(-4px) rotate3d(.4,.4,0,2deg);box-shadow:0 16px 36px rgba(16,24,40,.12)}
      .solution-visual{height:170px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}
      .solution-visual i{font-size:3rem;color:#fff;z-index:2;animation:popIn .6s ease}
      .solution-visual::after{content:"";position:absolute;inset:0;opacity:.18;background-size:300px 300px;background-repeat:repeat}
      .solution-content{padding:22px}
      .solution-content h3{font-size:1.25rem;margin-bottom:12px;color:var(--secondary)}
      .solution-content p{color:#475569}
      .bg-restaurant{background:linear-gradient(135deg,#6D28D9,#10B981)}
      .bg-restaurant::after{background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 100 100" fill="none"><g fill="white"><circle cx="10" cy="10" r="2"/><rect x="40" y="40" width="20" height="12" rx="2"/><path d="M75 32 h8 v6 h-8z"/><circle cx="80" cy="60" r="3"/></g></svg>')}
      .bg-retail{background:linear-gradient(135deg,#2563EB,#22C55E)}
      .bg-retail::after{background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 100 100" fill="white" opacity="1"><path d="M20 40 h60 v35 H20z"/><circle cx="35" cy="30" r="8"/><circle cx="65" cy="30" r="8"/></svg>')}
      .bg-ecom{background:linear-gradient(135deg,#4338CA,#06B6D4)}
      .bg-ecom::after{background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 100 100" fill="white"><rect x="20" y="30" width="60" height="40" rx="6"/><rect x="30" y="40" width="40" height="6"/></svg>')}
      .bg-health{background:linear-gradient(135deg,#0EA5E9,#14B8A6)}
      .bg-health::after{background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 100 100" fill="white"><path d="M50 18 v20 M40 28 h20" stroke="white" stroke-width="6"/><rect x="22" y="50" width="56" height="30" rx="8" fill="white"/></svg>')}
      .bg-contract{background:linear-gradient(135deg,#1D4ED8,#F59E0B)}
      .bg-contract::after{background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 100 100" fill="white"><rect x="20" y="50" width="60" height="10"/><rect x="30" y="35" width="40" height="10"/><polygon points="50,15 60,30 40,30"/></svg>')}
      .bg-nonprofit{background:linear-gradient(135deg,#7C3AED,#EF4444)}
      .bg-nonprofit::after{background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 100 100" fill="white"><path d="M50 70 C30 55,15 45,25 30 a12 12 0 0 1 25 0 a12 12 0 0 1 25 0 c10 15 -5 25 -25 40z"/></svg>')}
      .bg-edu{background:linear-gradient(135deg,#0F766E,#22D3EE)}
      .bg-edu::after{background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 100 100" fill="white"><polygon points="10,40 50,25 90,40 50,55"/><rect x="45" y="55" width="10" height="20"/></svg>')}
      .slider-nav{display:flex;gap:10px;justify-content:flex-end;margin-top:14px}
      .slider-btn{background:#fff;border:1px solid var(--light-gray);width:40px;height:40px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 8px 16px rgba(0,0,0,.06);transition:transform .2s,background .2s}
      .slider-btn:hover{transform:translateY(-2px);background:#F8FAFF}
      .slider-btn:disabled{opacity:.4;cursor:not-allowed;transform:none}

      .cta{color:#fff;padding:70px 0;text-align:center;position:relative;overflow:hidden;background:linear-gradient(135deg,var(--primary) 0%,var(--primary-dark) 100%);background-size:200% 200%;animation:ctaGradient 12s ease-in-out infinite}
      .cta h2{font-size:2rem;margin-bottom:16px;opacity:0;transform:translateY(20px);transition:all .8s ease;position:relative}
      .cta p{font-size:1rem;max-width:700px;margin:0 auto 24px;opacity:0;transform:translateY(20px);transition:all .8s ease .15s}
      .cta .btn{opacity:0;transform:translateY(20px);transition:all .8s ease .3s;position:relative;overflow:hidden}
      .cta.animated h2,.cta.animated p,.cta.animated .btn{opacity:1;transform:translateY(0)}
      .cta::before,.cta::after{content:"";position:absolute;width:150px;height:150px;border-radius:50%;background:rgba(255,255,255,.1)}
      .cta::before{top:-75px;left:-75px;animation:pulseElement 15s infinite}
      .cta::after{bottom:-75px;right:-75px;animation:pulseElement 15s infinite 5s}
      .cta h2::after{content:"";position:absolute;left:50%;bottom:-10px;height:3px;width:0%;transform:translateX(-50%);background:rgba(255,255,255,.8);border-radius:999px;animation:ctaUnderline 1.4s ease forwards .3s}

      footer{background:var(--secondary);color:#fff;padding:60px 0 20px;position:relative;overflow:hidden}
      footer::before{content:'';position:absolute;width:150px;height:150px;background:rgba(255,255,255,.03);border-radius:50%;top:-75px;left:-75px}
      footer::after{content:'';position:absolute;width:120px;height:120px;background:rgba(0,204,150,.05);border-radius:50%;bottom:-60px;right:-60px}
      .footer-grid{display:grid;grid-template-columns:1fr;gap:30px;margin-bottom:40px;position:relative;z-index:2}
      .footer-column{opacity:0;transform:translateY(20px);transition:all .6s ease}
      .footer-column.animated{opacity:1;transform:translateY(0)}
      .footer-column:nth-child(1){transition-delay:.1s}.footer-column:nth-child(2){transition-delay:.2s}.footer-column:nth-child(3){transition-delay:.3s}.footer-column:nth-child(4){transition-delay:.4s}
      .footer-column h3{font-size:1.2rem;margin-bottom:15px;color:var(--accent);position:relative;display:inline-block}
      .footer-column h3::after{content:'';position:absolute;bottom:-8px;left:0;width:0;height:2px;background:var(--accent);transition:width .5s}
      .footer-column:hover h3::after{width:100%}
      .footer-column ul{list-style:none}
      .footer-column ul li{margin-bottom:10px;opacity:.85;transition:all .3s;transform:translateX(0)}
      .footer-column ul li:hover{opacity:1;transform:translateX(5px)}
      .footer-bottom{border-top:1px solid rgba(255,255,255,.1);padding-top:15px;text-align:center;opacity:.8;font-size:.9rem;position:relative;z-index:2;opacity:0;transform:translateY(20px);transition:all .6s ease .5s}
      .footer-bottom.animated{opacity:.8;transform:translateY(0)}

      @media (min-width:768px){
        .header-container{padding:20px 0}.logo{font-size:24px}nav ul{gap:30px}nav ul li a{font-size:16px}
        .btn{padding:12px 24px;font-size:16px}.hero{padding:86px 0;min-height:80vh}
        .hero-content{flex-direction:row;text-align:left}.hero-text{text-align:left;padding:0}
        .hero-text h1{font-size:3.5rem}.hero-text p{font-size:1.1rem}
        .hero-buttons{justify-content:flex-start}.hero-animation{height:420px}
        .payment-terminal{width:320px;height:220px}.terminal-screen{height:80px;font-size:20px;margin:35px auto 25px}
        .payment-card{width:100px;height:65px;font-size:14px;animation:cardSlide 12s infinite ease-in-out}
        .data-flow{width:80px;height:8px;animation:dataFlow 4s infinite linear}
        .features-grid{grid-template-columns:repeat(2,1fr);gap:25px}
        .footer-grid{grid-template-columns:repeat(2,1fr);gap:35px}
        .tech-animation.binary-code{display:block}
      }
      @media (min-width:992px){
        .features-grid{grid-template-columns:repeat(3,1fr)}
        .footer-grid{grid-template-columns:repeat(4,1fr)}
        .hero-text h1{font-size:3.6rem}
      }
      @media (max-width:767px){
        .solution-floating-element,.cta-element,.footer-floating-element,.cta-tech-animation,.footer-tech-animation{display:none}
      }
      @media (max-width:767px){
        .hero{padding-top:var(--mobile-hero-top);padding-bottom:48px;overflow:visible}
        .hero-kicker{margin-top:0}
        .hero-text h1{line-height:1.15;text-wrap:balance;font-size:clamp(1.6rem,5.6vw,2rem);max-width:26ch;margin-inline:auto}
      }
      @media (max-width:380px){.hero-text h1{max-width:27ch}}

      @keyframes pulse{0%{transform:scale(1)}50%{transform:scale(1.1)}100%{transform:scale(1)}}
      @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-15px)}}
      @keyframes screenShine{0%{left:-100%}20%{left:100%}100%{left:100%}}
      @keyframes cardSlideMobile{0%,100%{transform:translateX(-120px) rotate(-10deg);opacity:0}10%,90%{opacity:1}50%{transform:translateX(0) rotate(0)}90%{transform:translateX(120px) rotate(10deg);opacity:0}}
      @keyframes chipGlow{0%{box-shadow:0 0 5px #FFD700}100%{box-shadow:0 0 15px #FFD700,0 0 20px #FFA500}}
      @keyframes dataFlowMobile{0%{transform:translateX(-60px) scale(.8);opacity:0}10%{opacity:1}90%{opacity:1}100%{transform:translateX(60px) scale(1.2);opacity:0}}
      @keyframes badgePulse{0%,100%{transform:scale(1);opacity:.9}50%{transform:scale(1.1);opacity:1}}
      @keyframes checkPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.1)}}
      @keyframes currencyFloat{0%,100%{transform:translateY(0) rotate(0)}25%{transform:translateY(-30px) rotate(5deg)}50%{transform:translateY(0) rotate(0)}75%{transform:translateY(30px) rotate(-5deg)}}
      @keyframes pulseElement{0%,100%{transform:scale(1);opacity:.1}50%{transform:scale(1.1);opacity:.17}}
      @keyframes fadeInUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}
      @keyframes cardSlide{0%,100%{transform:translateX(-200px) rotate(-10deg);opacity:0}10%,90%{opacity:1}50%{transform:translateX(0) rotate(0)}90%{transform:translateX(200px) rotate(10deg);opacity:0}}
      @keyframes dataFlow{0%{transform:translateX(-100px) scale(.8);opacity:0}10%{opacity:1}90%{opacity:1}100%{transform:translateX(100px) scale(1.2);opacity:0}}
      @keyframes ctaGradient{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
      @keyframes ctaUnderline{from{width:0%;opacity:0}to{width:160px;opacity:1}}
      @keyframes borderShift{to{filter:hue-rotate(360deg)}}
      @keyframes spinSlow{to{transform:rotate(360deg)}}
      @keyframes rain{to{transform:translateY(220%)}}
      @keyframes menuPop{from{opacity:0;transform:translateY(8px) scale(.98)}to{opacity:1;transform:none}}
      @keyframes btnSweep{from{transform:translateX(-150%)}to{transform:translateX(150%)}}

      @media (prefers-reduced-motion: reduce){
        *{animation:none !important;transition:none !important}
        .slider-viewport{scroll-behavior:auto}
      }
    </style>
  </head>

  <body>
    <div class="scroll-progress" id="scrollProgress"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      const dropdowns=document.querySelectorAll('nav .dropdown');
      dropdowns.forEach(d=>{const t=d.querySelector('a');d.addEventListener('mouseenter',()=>t&&t.setAttribute('aria-expanded','true'));d.addEventListener('mouseleave',()=>t&&t.setAttribute('aria-expanded','false'));});

      const hamburger=document.getElementById('hamburger');
      const mobileMenu=document.getElementById('mobile-menu');
      const closeMenu=document.getElementById('close-menu');
      const overlay=document.getElementById('overlay');

      function closeAll(){
        mobileMenu.classList.remove('active');
        overlay.classList.remove('active');
        document.body.style.overflow='auto';
        hamburger?.setAttribute('aria-expanded','false');
        mobileMenu?.setAttribute('aria-hidden','true');
      }
      hamburger?.addEventListener('click',()=>{mobileMenu.classList.add('active');overlay.classList.add('active');document.body.style.overflow='hidden';hamburger.setAttribute('aria-expanded','true');mobileMenu.setAttribute('aria-hidden','false');});
      closeMenu?.addEventListener('click',closeAll);
      overlay?.addEventListener('click',closeAll);

      const indToggle=document.getElementById('industries-toggle');
      const indSub=document.getElementById('industries-submenu');
      const indCaret=document.getElementById('industries-caret');
      indToggle?.addEventListener('click',()=>{const open=indSub.classList.toggle('open');indCaret.style.transform=open?'rotate(180deg)':'rotate(0deg)';});

      const prodToggle=document.getElementById('products-toggle');
      const prodSub=document.getElementById('products-submenu');
      const prodCaret=document.getElementById('products-caret');
      prodToggle?.addEventListener('click',()=>{const open=prodSub.classList.toggle('open');prodCaret.style.transform=open?'rotate(180deg)':'rotate(0deg)';});

      document.addEventListener('DOMContentLoaded',function(){
        const featureCards=document.querySelectorAll('.feature-card');
        const ctaSection=document.getElementById('cta');
        const footerColumns=document.querySelectorAll('.footer-column');
        const footerBottom=document.querySelector('.footer-bottom');

        const io=new IntersectionObserver((entries)=>{
          entries.forEach(e=>{
            if(e.isIntersecting){e.target.classList.add('animated');}
          })
        },{threshold:.2});

        featureCards.forEach(el=>io.observe(el));
        footerColumns.forEach(el=>io.observe(el));
        ctaSection && io.observe(ctaSection);
        footerBottom && io.observe(footerBottom);

        const mo=new IntersectionObserver((entries)=>{
          entries.forEach(({isIntersecting,target})=>{
            if(!isIntersecting) return; mo.unobserve(target);
            const el=target.querySelector('.num');
            if(!el) return; const end=parseFloat(el.dataset.count);
            const isPercent=end>50;
            const dur=1200; const start=performance.now();
            function tick(now){
              const p=Math.min(1,(now-start)/dur);
              const val=end*p; el.textContent=isPercent?val.toFixed(2)+'%':Math.round(val);
              if(p<1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
          });
        },{threshold:.6});
        document.querySelectorAll('.metric').forEach(m=>mo.observe(m));
      });

      (function(){
        const viewport=document.getElementById('solutionsViewport');
        const track=document.getElementById('solutionsTrack');
        const prev=document.getElementById('prevBtn');
        const next=document.getElementById('nextBtn');
        if(!viewport||!track||!prev||!next) return;

        function getStep(){
          const first=track.querySelector('.slide'); if(!first) return 300;
          const rect=first.getBoundingClientRect(); return rect.width+22;
        }
        function updateDisabled(){
          prev.disabled=viewport.scrollLeft<=0;
          const max=track.scrollWidth-viewport.clientWidth-4;
          next.disabled=viewport.scrollLeft>=max;
        }
        prev.addEventListener('click',()=>{viewport.scrollBy({left:-getStep(),behavior:'smooth'});setTimeout(updateDisabled,350);});
        next.addEventListener('click',()=>{viewport.scrollBy({left:getStep(),behavior:'smooth'});setTimeout(updateDisabled,350);});
        viewport.addEventListener('scroll',updateDisabled,{passive:true});
        window.addEventListener('resize',updateDisabled);
        updateDisabled();

        let auto; const start=()=>{auto=setInterval(()=>{const max=track.scrollWidth-viewport.clientWidth-4; if(viewport.scrollLeft>=max-5){viewport.scrollTo({left:0,behavior:'smooth'});}else{viewport.scrollBy({left:getStep(),behavior:'smooth'});} }, 3500)};
        const stop=()=>clearInterval(auto);
        viewport.addEventListener('mouseenter',stop); viewport.addEventListener('mouseleave',start);
        start();
      })();

      (function () {
        const heading = document.querySelector('.hero-text .split');
        if (!heading) return;

        const original = heading.textContent;
        const words = original.split(' ');
        heading.textContent = '';

        let charIndex = 0;
        words.forEach((word) => {
          const wordWrap = document.createElement('span');
          wordWrap.style.display = 'inline-block';
          wordWrap.style.marginRight = '0.5ch';

          [...word].forEach((ch) => {
            const span = document.createElement('span');
            span.textContent = ch;
            span.style.display = 'inline-block';
            span.style.opacity = '0';
            span.style.transform = 'translateY(18px)';
            const delay = charIndex * 12;
            span.style.transition = `transform .6s ${delay}ms, opacity .6s ${delay}ms`;
            wordWrap.appendChild(span);
            charIndex++;
          });

          heading.appendChild(wordWrap);
        });

        requestAnimationFrame(() => {
          heading.querySelectorAll('span span').forEach((s) => {
            s.style.opacity = '1';
            s.style.transform = 'translateY(0)';
          });
        });
      })();

      (function(){
        const header=document.getElementById('siteHeader');
        const bar=document.getElementById('scrollProgress');
        window.addEventListener('scroll',()=>{
          const y=window.scrollY;
          header.classList.toggle('shrink', y>8);
          const height=document.documentElement.scrollHeight - window.innerHeight;
          const w=Math.max(0, Math.min(1, y/height))*100; bar.style.width=w+'%';
        },{passive:true});
      })();

      document.querySelectorAll('.magnet').forEach(btn=>{
        const strength=24;
        btn.addEventListener('mousemove',e=>{
          const r=btn.getBoundingClientRect(); const x=e.clientX - (r.left + r.width/2); const y=e.clientY - (r.top + r.height/2);
          btn.style.transform=`translate(${x/strength}px, ${y/strength}px)`;
        });
        btn.addEventListener('mouseleave',()=>{btn.style.transform='translate(0,0)'});
      });

      document.querySelectorAll('.tilt').forEach(card=>{
        const damp=18; const r=()=>card.getBoundingClientRect();
        card.addEventListener('mousemove',e=>{
          const b=r(); const cx=b.left+b.width/2; const cy=b.top+b.height/2; const dx=(e.clientX-cx)/damp; const dy=(e.clientY-cy)/damp;
          card.style.transform=`perspective(900px) rotateY(${dx}deg) rotateX(${-dy}deg) translateY(-4px)`;
        });
        card.addEventListener('mouseleave',()=>{card.style.transform='translateY(0)';});
      });

      (function(){
        const hero=document.getElementById('hero');
        if(!hero) return;
        const items=hero.querySelectorAll('.payment-card,.data-flow,.security-badge,.approval-check,.digital-currency,.circle-1,.circle-2');
        hero.addEventListener('mousemove',e=>{
          const r=hero.getBoundingClientRect(); const x=(e.clientX-r.left)/r.width - .5; const y=(e.clientY-r.top)/r.height - .5;
          items.forEach((el,i)=>{const depth=(i%5+1)*4; el.style.transform=`translate(${-x*depth}px, ${-y*depth}px)`;});
        });
        hero.addEventListener('mouseleave',()=>{items.forEach(el=>el.style.transform='')});
      })();

      (function(){
        const layer=document.getElementById('binaryLayer'); if(!layer) return;
        const cols=Math.min(24, Math.floor(window.innerWidth/40));
        for(let i=0;i<cols;i++){
          const col=document.createElement('div'); col.className='column';
          col.style.left=(i*40+10)+'px'; col.style.animationDuration=(4+Math.random()*4)+'s'; col.style.animationDelay=(Math.random()*-6)+'s';
          col.textContent = Array.from({length:40},()=> (Math.random()>0.5?'1':'0')).join('\n');
          layer.appendChild(col);
        }
      })();
    </script>
  </body>
</html>