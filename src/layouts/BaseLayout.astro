---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title = "PPD Technology | Modern Payment Solutions" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    {Astro.slots.has('head') && <slot name="head" />}
    <style is:global>

/* ─── DESIGN TOKENS ─────────────────────────────────────────── */
:root {
  --navy:        #060E21;
  --navy-2:      #0C1A38;
  --navy-3:      #12224A;
  --blue:        #1549FF;
  --blue-mid:    #2D60FF;
  --blue-dark:   #0F38CC;
  --blue-glow:   rgba(21,73,255,.32);
  --cyan:        #00CFFF;
  --cyan-glow:   rgba(0,207,255,.25);
  --green:       #00E5A0;
  --green-glow:  rgba(0,229,160,.25);
  --white:       #FFFFFF;
  --surface:     #F5F8FF;
  --surface-2:   #EBF0FB;
  --text-1:      #060E21;
  --text-2:      #2C4268;
  --text-3:      #7B93B0;
  --border:      rgba(0,0,0,.08);
  --border-md:   rgba(0,0,0,.12);
  --border-dark: rgba(255,255,255,.1);
  --shadow-xs:   0 1px 4px rgba(0,0,0,.05);
  --shadow-sm:   0 2px 12px rgba(0,0,0,.07);
  --shadow-md:   0 8px 32px rgba(0,0,0,.1);
  --shadow-lg:   0 20px 60px rgba(0,0,0,.15);
  --shadow-blue: 0 8px 28px rgba(21,73,255,.35);
  --r-sm:        8px;
  --r-md:        12px;
  --r-lg:        16px;
  --r-xl:        24px;
  --r-pill:      9999px;
  --section-py:  clamp(72px, 9vw, 112px);
  --section-py-sm: clamp(48px, 6vw, 72px);

  /* legacy compat */
  --primary:      var(--blue);
  --primary-dark: var(--blue-dark);
  --secondary:    var(--navy-2);
  --accent:       var(--green);
  --light:        var(--surface);
  --dark:         var(--text-1);
  --gray:         var(--text-3);
  --light-gray:   var(--surface-2);
  --glow:         var(--cyan);
  --mobile-hero-top: calc(64px + env(safe-area-inset-top,0px));
}

/* ─── RESET ──────────────────────────────────────────────────── */
*{margin:0;padding:0;box-sizing:border-box}
html,body{background:var(--white);color:var(--text-1);line-height:1.65;overflow-x:hidden}
body{font-family:'Inter',sans-serif;font-size:16px;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}

/* ─── LAYOUT ─────────────────────────────────────────────────── */
.container{width:100%;max-width:1200px;margin:0 auto;padding:0 24px}

/* ─── SCROLL PROGRESS ────────────────────────────────────────── */
.scroll-progress{
  position:fixed;top:0;left:0;height:3px;
  background:linear-gradient(90deg,var(--blue),var(--cyan));
  width:0%;z-index:9999;transition:width .1s linear;
}

/* ─── HEADER ─────────────────────────────────────────────────── */
header{
  background:rgba(6,14,33,0.96);
  backdrop-filter:blur(20px) saturate(180%);
  -webkit-backdrop-filter:blur(20px) saturate(180%);
  border-bottom:1px solid rgba(255,255,255,.07);
  position:sticky;top:0;z-index:100;
  transition:box-shadow .3s,background .3s;
}
header.shrink{box-shadow:0 4px 32px rgba(0,0,0,.35)}
.header-container{display:flex;justify-content:space-between;align-items:center;padding:16px 0}

/* Logo */
.logo{
  font-size:20px;font-weight:800;color:#fff;
  display:flex;align-items:center;gap:10px;white-space:nowrap;
}
.brandtext{display:inline-flex;gap:0}
.brandtext .ppd{color:var(--cyan);font-weight:800}
.brandtext .tech{color:#fff;font-weight:800}
.logo-chip{
  width:28px;height:28px;display:inline-block;line-height:0;
  background:var(--cyan);
  -webkit-mask:url("https://ppdtechnology.com/images/Chip-reader-EMV.png") center/contain no-repeat;
  mask:url("https://ppdtechnology.com/images/Chip-reader-EMV.png") center/contain no-repeat;
  animation:pulse 2.5s ease-in-out infinite;
  filter:drop-shadow(0 0 8px var(--cyan));
}
@supports not ((mask:url("")) or (-webkit-mask:url(""))){
  .logo-chip{background:none;filter:none;display:inline-flex;align-items:center;justify-content:center}
  .logo-chip::before{content:"";width:28px;height:28px;background:url("https://ppdtechnology.com/images/Chip-reader-EMV.png") center/contain no-repeat;display:block}
}

/* Nav */
nav ul{display:flex;list-style:none;gap:4px;align-items:center}
nav ul li a{
  font-weight:500;color:rgba(255,255,255,.8);
  padding:8px 12px;border-radius:var(--r-md);
  transition:color .2s,background .2s;font-size:14.5px;
}
nav ul li a:hover{color:#fff;background:rgba(255,255,255,.08)}

/* Header buttons */
.header-buttons{display:flex;gap:8px}
.btn{
  padding:10px 20px;border-radius:var(--r-pill);font-weight:600;
  cursor:pointer;display:inline-flex;align-items:center;justify-content:center;
  gap:6px;font-size:14px;border:none;
  transition:transform .2s,box-shadow .25s,background .2s,color .2s;
  position:relative;overflow:hidden;font-family:'Inter',sans-serif;
  letter-spacing:.01em;line-height:1;
}
.btn::after{
  content:"";position:absolute;inset:0;
  background:linear-gradient(120deg,transparent,rgba(255,255,255,.18),transparent);
  transform:translateX(-150%);
}
.btn:hover::after{animation:btnSweep .7s ease}
.btn-outline{
  border:1.5px solid rgba(255,255,255,.3);
  color:rgba(255,255,255,.9);background:rgba(255,255,255,.06);
}
.btn-outline:hover{
  border-color:rgba(255,255,255,.6);color:#fff;
  background:rgba(255,255,255,.1);transform:translateY(-2px);
}
.btn-primary{
  background:linear-gradient(135deg,var(--blue-mid),var(--blue));
  color:#fff;box-shadow:var(--shadow-blue);
}
.btn-primary:hover{
  background:linear-gradient(135deg,var(--blue),var(--blue-dark));
  transform:translateY(-2px);box-shadow:0 12px 32px rgba(21,73,255,.45);
}

/* Dropdown */
.dropdown{position:relative}
.dropdown>a{display:inline-flex;align-items:center;gap:5px;padding:8px 12px;border-radius:var(--r-md)}
.dropdown>a .chev{font-size:11px;transition:transform .25s;opacity:.6}
.dropdown:hover>a .chev,.dropdown:focus-within>a .chev{transform:rotate(180deg)}
.dropdown-menu{
  position:absolute;top:calc(100% + 8px);left:0;min-width:240px;
  background:var(--navy-2);
  border:1px solid rgba(255,255,255,.1);border-radius:var(--r-lg);
  box-shadow:0 20px 60px rgba(0,0,0,.4);
  padding:8px;display:none;z-index:999;
  animation:menuPop .18s ease forwards;
}
.dropdown-menu::before{content:'';position:absolute;left:0;right:0;top:-12px;height:12px}
.dropdown-menu a{
  display:flex;gap:10px;align-items:center;
  padding:10px 12px;border-radius:var(--r-md);
  color:rgba(255,255,255,.8);font-weight:500;font-size:13.5px;
  transition:background .15s,color .15s;
}
.dropdown-menu a i,.dropdown-menu a svg{width:15px;height:15px;flex:0 0 15px;opacity:.7}
.dropdown-menu a:hover{background:rgba(255,255,255,.08);color:#fff}
.dropdown-menu a:hover i,.dropdown-menu a:hover svg{opacity:1}
.dropdown:hover .dropdown-menu,.dropdown:focus-within .dropdown-menu{display:block}

/* Hamburger */
.hamburger{display:none;flex-direction:column;justify-content:space-between;width:22px;height:16px;cursor:pointer}
.hamburger span{height:2px;width:100%;background:#fff;border-radius:2px;transition:all .3s}
@media(max-width:767px){
  .header-container{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:14px 20px}
  .logo{grid-column:2;justify-self:center}
  .hamburger{display:flex;grid-column:3;justify-self:end}
  nav,.header-buttons{display:none}
}
@media(min-width:768px){
  .logo{font-size:22px}
  nav ul{gap:2px}
  .btn{padding:11px 22px;font-size:14px}
  .header-container{padding:18px 0}
}

/* Mobile menu */
.mobile-menu{
  position:fixed;top:0;right:-100%;width:82%;max-width:320px;height:100vh;
  background:var(--navy-2);z-index:1000;padding:80px 28px 28px;
  box-shadow:-8px 0 40px rgba(0,0,0,.4);
  border-left:1px solid rgba(255,255,255,.08);
  transition:right .3s ease;overflow-y:auto;
}
.mobile-menu.active{right:0}
.mobile-menu ul{list-style:none}
.mobile-menu ul li{margin-bottom:4px}
.mobile-menu ul li a{
  font-size:16px;font-weight:500;color:rgba(255,255,255,.85);
  display:block;padding:10px 12px;border-radius:var(--r-md);
  border-bottom:1px solid rgba(255,255,255,.07);
  transition:background .2s,color .2s;
}
.mobile-menu ul li a:hover{background:rgba(255,255,255,.08);color:#fff}
.mobile-menu .header-buttons{flex-direction:column;margin-top:24px;gap:10px}
.close-menu{position:absolute;top:20px;right:20px;font-size:22px;background:none;border:none;color:rgba(255,255,255,.7);cursor:pointer}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:999;opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s;backdrop-filter:blur(4px)}
.overlay.active{opacity:1;visibility:visible}
.mobile-submenu-toggle{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 12px;border-radius:var(--r-md);font-size:16px;font-weight:600;
  color:rgba(255,255,255,.85);cursor:pointer;border-bottom:1px solid rgba(255,255,255,.07);
}
.mobile-submenu{display:none;padding-left:10px}
.mobile-submenu a{border:none;font-size:14.5px;padding:8px 10px;color:rgba(255,255,255,.7)}
.mobile-submenu.open{display:block}

/* ─── HERO ───────────────────────────────────────────────────── */
.hero{
  background:
    radial-gradient(ellipse 120% 80% at 80% -20%, rgba(21,73,255,.25) 0%, transparent 60%),
    radial-gradient(ellipse 80% 60% at -10% 100%, rgba(0,207,255,.15) 0%, transparent 50%),
    linear-gradient(160deg, var(--navy) 0%, var(--navy-2) 60%, #0a1c42 100%);
  color:#fff;padding:var(--section-py) 0;
  position:relative;overflow:hidden;display:flex;align-items:center;min-height:85vh;z-index:1;
}
.hero::before{
  content:"";position:absolute;inset:0;
  background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.025'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  pointer-events:none;opacity:.4;
}
.hero-content{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:40px;position:relative;z-index:2}
.hero-text{flex:1;text-align:center;padding:0 10px}
.hero-kicker{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.14);
  padding:6px 14px;border-radius:var(--r-pill);
  margin-bottom:20px;font-size:12px;font-weight:500;
  backdrop-filter:blur(8px);color:rgba(255,255,255,.9);
  letter-spacing:.03em;text-transform:uppercase;
}
.hero-kicker i{color:var(--cyan)}
.hero-text h1{
  font-size:clamp(2.4rem,6vw,4rem);line-height:1.12;font-weight:800;
  margin-bottom:20px;animation:fadeInUp .9s ease-out;
  letter-spacing:-.02em;
}
.hero-text h1 .hl{
  background:linear-gradient(135deg,var(--cyan),var(--blue-mid));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.hero-text p{
  font-size:clamp(1rem,2vw,1.15rem);margin-bottom:32px;
  opacity:.85;animation:fadeInUp 1s ease-out .2s both;
  max-width:52ch;margin-left:auto;margin-right:auto;line-height:1.7;
}
.hero-buttons{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;animation:fadeInUp 1s ease-out .4s both}

/* Hero animation */
.tech-animation.binary-code{position:absolute;inset:0;pointer-events:none;opacity:.12}
.tech-animation .column{position:absolute;top:-100%;width:20px;white-space:nowrap;color:#5d9bff;font-family:monospace;font-size:12px;animation:rain 6s linear infinite}
.hero-animation{flex:1;position:relative;height:300px;width:100%;display:flex;justify-content:center;align-items:center;overflow:visible}
.payment-terminal{
  position:relative;width:260px;height:180px;
  background:linear-gradient(145deg,rgba(21,73,255,.15),rgba(0,207,255,.08));
  border:1px solid rgba(255,255,255,.15);
  border-radius:var(--r-lg);
  box-shadow:0 24px 60px rgba(0,0,0,.4),0 0 60px rgba(21,73,255,.2),inset 0 1px 0 rgba(255,255,255,.15);
  z-index:3;overflow:hidden;animation:float 6s ease-in-out infinite;
  backdrop-filter:blur(16px);
}
.payment-terminal::before{
  content:"";position:absolute;inset:-1px;border-radius:17px;padding:1px;
  background:linear-gradient(135deg,rgba(0,207,255,.5),rgba(21,73,255,.3),rgba(0,229,160,.3));
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  animation:borderShift 5s linear infinite;
}
.terminal-screen{
  width:85%;height:60px;background:rgba(6,14,33,.8);
  margin:25px auto 20px;border-radius:var(--r-md);
  display:flex;align-items:center;justify-content:center;
  color:var(--green);font-weight:700;font-size:16px;
  font-family:'Courier New',monospace;
  box-shadow:inset 0 0 20px rgba(0,229,160,.1),0 0 20px rgba(0,229,160,.08);
  position:relative;overflow:hidden;
}
.terminal-screen::after{content:"";position:absolute;top:0;left:-100%;width:50%;height:100%;background:linear-gradient(to right,transparent,rgba(255,255,255,.1),transparent);animation:screenShine 4s infinite}
.card-slot{width:60%;height:5px;background:linear-gradient(to right,rgba(255,255,255,.2),rgba(255,255,255,.35),rgba(255,255,255,.2));margin:0 auto;border-radius:3px}
.payment-card{
  position:absolute;width:70px;height:45px;
  background:linear-gradient(135deg,rgba(21,73,255,.6),rgba(45,96,255,.8));
  border:1px solid rgba(255,255,255,.2);
  border-radius:var(--r-sm);box-shadow:0 8px 24px rgba(0,0,0,.3);
  z-index:2;display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:10px;font-weight:700;
  backdrop-filter:blur(8px);
  animation:cardSlideMobile 12s infinite ease-in-out;
}
.data-flow{position:absolute;width:50px;height:4px;background:linear-gradient(90deg,transparent,var(--cyan),transparent);border-radius:3px;z-index:1;box-shadow:0 0 12px var(--cyan);animation:dataFlowMobile 4s infinite linear}
.security-badge{position:absolute;width:36px;height:36px;background:rgba(255,255,255,.95);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--blue);font-size:14px;box-shadow:0 0 20px rgba(21,73,255,.5);animation:badgePulse 5s infinite ease-in-out;z-index:4}
.approval-check{position:absolute;width:30px;height:30px;background:var(--green);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;box-shadow:0 0 20px var(--green-glow);animation:checkPulse 4s infinite;z-index:3}
.digital-currency{position:absolute;width:44px;height:44px;background:linear-gradient(135deg,var(--cyan),var(--blue-mid));border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:16px;box-shadow:0 8px 24px rgba(0,207,255,.4);animation:currencyFloat 8s infinite ease-in-out;z-index:2}
.background-element{position:absolute;border-radius:50%;opacity:.06;z-index:0;filter:blur(1px)}
.circle-1{width:280px;height:280px;background:var(--cyan);top:-140px;right:-100px;animation:pulseElement 15s infinite}
.circle-2{width:200px;height:200px;background:var(--blue-mid);bottom:-100px;left:5%;animation:pulseElement 12s infinite 2s}

/* ─── MARQUEE ────────────────────────────────────────────────── */
.marquee{
  background:#fff;padding:18px 0;position:relative;overflow:hidden;z-index:3;
  border-top:1px solid var(--border);border-bottom:1px solid var(--border);
}
.marquee::before,.marquee::after{content:"";position:absolute;top:0;bottom:0;width:80px;pointer-events:none;z-index:1}
.marquee::before{left:0;background:linear-gradient(90deg,#fff,transparent)}
.marquee::after{right:0;background:linear-gradient(270deg,#fff,transparent)}
.brands-viewport{overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;scroll-snap-type:x mandatory;scroll-behavior:smooth;touch-action:pan-x;overscroll-behavior-x:contain;scrollbar-width:none}
.brands-viewport::-webkit-scrollbar{display:none}
.brands-track{display:flex;gap:12px;align-items:center;padding:2px 16px;width:max-content}
.brand-pill{
  display:inline-flex;align-items:center;gap:8px;padding:10px 20px;
  border-radius:var(--r-pill);background:var(--surface);
  border:1px solid var(--border);
  box-shadow:var(--shadow-xs);
  transition:transform .2s,box-shadow .2s,background .2s;
  flex:0 0 auto;cursor:pointer;font-weight:500;font-size:14px;color:var(--text-2);
}
.brand-pill i{font-size:20px;color:var(--text-3);transition:color .25s}
.brand-pill:hover{transform:translateY(-3px);box-shadow:var(--shadow-md);background:#fff}
.brand-pill[data-brand="visa"]:hover i{color:#1a1f71}
.brand-pill[data-brand="mastercard"]:hover i{color:#eb001b}
.brand-pill[data-brand="amex"]:hover i{color:#2e77bb}
.brand-pill[data-brand="discover"]:hover i{color:#ff6000}
.brand-pill[data-brand="applepay"]:hover i{color:#111}
.brand-pill[data-brand="googlepay"]:hover i{color:#0f9d58}

/* ─── SECTION TITLES ─────────────────────────────────────────── */
.section-title{text-align:center;margin-bottom:40px}
.section-eyebrow{
  display:inline-flex;align-items:center;gap:6px;
  background:rgba(21,73,255,.08);color:var(--blue);
  border:1px solid rgba(21,73,255,.15);
  padding:5px 12px;border-radius:var(--r-pill);
  font-size:12px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;
  margin-bottom:14px;
}
.section-title h2{
  font-size:clamp(1.8rem,3.5vw,2.6rem);color:var(--text-1);
  font-weight:800;margin-bottom:14px;letter-spacing:-.02em;line-height:1.2;
}
.section-title p{font-size:1.05rem;color:var(--text-2);max-width:600px;margin:0 auto;line-height:1.7}

/* ─── METRICS ────────────────────────────────────────────────── */
.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:720px;margin:32px auto 0}
.metric{
  background:#fff;border:1px solid var(--border);border-radius:var(--r-lg);
  padding:20px 16px;display:flex;flex-direction:column;align-items:center;gap:4px;
  box-shadow:var(--shadow-sm);transition:transform .2s,box-shadow .2s;
}
.metric:hover{transform:translateY(-3px);box-shadow:var(--shadow-md)}
.metric .num{font-size:2rem;font-weight:800;color:var(--text-1);letter-spacing:-.03em}
.metric .label{font-size:12px;color:var(--text-3);font-weight:500;text-transform:uppercase;letter-spacing:.04em}

/* ─── FEATURES SECTION ───────────────────────────────────────── */
.features{padding:var(--section-py) 0;background:var(--surface)}
.features-grid{display:grid;grid-template-columns:1fr;gap:20px;margin-top:32px}
.feature-card{
  background:#fff;border-radius:var(--r-lg);padding:28px;
  border:1px solid var(--border);
  box-shadow:var(--shadow-sm);
  transition:transform .25s,box-shadow .25s,opacity .4s;
  opacity:0;transform:translateY(24px);
  position:relative;overflow:hidden;
}
.feature-card::before{
  content:'';position:absolute;top:0;left:0;width:4px;height:0;
  background:linear-gradient(180deg,var(--blue),var(--cyan));
  transition:height .5s;border-radius:0 0 4px 4px;
}
.feature-card.animated{opacity:1;transform:translateY(0)}
.feature-card.animated::before{height:100%}
.feature-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg)}
.feature-icon{
  width:56px;height:56px;
  background:rgba(21,73,255,.08);border-radius:var(--r-md);
  display:flex;align-items:center;justify-content:center;
  margin-bottom:18px;transition:all .3s;
}
.feature-card:hover .feature-icon{background:var(--blue);box-shadow:var(--shadow-blue)}
.feature-card:hover .feature-icon i{color:#fff;transform:scale(1.1)}
.feature-icon i{font-size:22px;color:var(--blue);transition:all .3s}
.feature-card h3{font-size:1.1rem;font-weight:700;margin-bottom:10px;color:var(--text-1)}
.feature-card p{color:var(--text-2);font-size:.95rem;line-height:1.65}

/* ─── SOLUTIONS SECTION ──────────────────────────────────────── */
.solutions{
  padding:var(--section-py) 0;background:#fff;
  position:relative;overflow:hidden;
}
.solutions::before{
  content:'';position:absolute;width:400px;height:400px;
  background:radial-gradient(circle,rgba(21,73,255,.06),transparent 70%);
  border-radius:50%;top:-200px;right:-100px;
}
.slider-shell{position:relative}
.slider-viewport{overflow:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:8px}
.slider-viewport::-webkit-scrollbar{display:none}
.slider-track{display:flex;gap:20px;align-items:stretch}
.slide{scroll-snap-align:start;flex:0 0 88%}
@media(min-width:600px){.slide{flex-basis:48%}}
@media(min-width:992px){.slide{flex-basis:31%}}
.solution-card{
  background:#fff;border-radius:var(--r-lg);overflow:hidden;
  border:1px solid var(--border);
  box-shadow:var(--shadow-sm);
  transition:transform .25s,box-shadow .25s;
  display:flex;flex-direction:column;height:100%;
}
.solution-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg)}
.solution-visual{height:160px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}
.solution-visual i{font-size:2.8rem;color:#fff;z-index:2}
.solution-visual::after{content:"";position:absolute;inset:0;opacity:.15;background-size:300px 300px;background-repeat:repeat}
.solution-content{padding:22px}
.solution-content h3{font-size:1.1rem;font-weight:700;margin-bottom:10px;color:var(--text-1)}
.solution-content p{color:var(--text-2);font-size:.9rem;line-height:1.65}
.bg-restaurant{background:linear-gradient(135deg,#5B21B6,#059669)}
.bg-retail{background:linear-gradient(135deg,#1D4ED8,#16A34A)}
.bg-ecom{background:linear-gradient(135deg,#3730A3,#0891B2)}
.bg-health{background:linear-gradient(135deg,#0284C7,#0D9488)}
.bg-contract{background:linear-gradient(135deg,#1E40AF,#D97706)}
.bg-nonprofit{background:linear-gradient(135deg,#6D28D9,#DC2626)}
.bg-edu{background:linear-gradient(135deg,#0F766E,#06B6D4)}
.slider-nav{display:flex;gap:8px;justify-content:flex-end;margin-top:20px}
.slider-btn{
  background:#fff;border:1px solid var(--border);
  width:40px;height:40px;border-radius:var(--r-pill);
  display:inline-flex;align-items:center;justify-content:center;
  cursor:pointer;box-shadow:var(--shadow-sm);
  transition:transform .2s,background .2s,box-shadow .2s;
  color:var(--text-2);
}
.slider-btn:hover{transform:translateY(-2px);background:var(--blue);color:#fff;border-color:var(--blue);box-shadow:var(--shadow-blue)}
.slider-btn:disabled{opacity:.4;cursor:not-allowed;transform:none}

/* ─── CTA SECTION ────────────────────────────────────────────── */
.cta{
  color:#fff;padding:var(--section-py) 0;text-align:center;
  position:relative;overflow:hidden;
  background:
    radial-gradient(ellipse 100% 80% at 50% -10%, rgba(0,207,255,.2) 0%, transparent 60%),
    linear-gradient(160deg, var(--navy) 0%, var(--navy-2) 50%, #0a1840 100%);
}
.cta::before{
  content:"";position:absolute;inset:0;
  background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.025'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  pointer-events:none;
}
.cta-orb{position:absolute;border-radius:50%;filter:blur(80px);opacity:.15;pointer-events:none}
.orb-1{width:400px;height:400px;background:var(--blue-mid);top:-200px;left:-100px;animation:orbFloat 20s ease-in-out infinite}
.orb-2{width:300px;height:300px;background:var(--cyan);bottom:-150px;right:-50px;animation:orbFloat 25s ease-in-out infinite reverse}
.orb-3{width:200px;height:200px;background:var(--green);top:50%;left:50%;transform:translate(-50%,-50%);animation:orbFloat 18s ease-in-out infinite 5s}
.cta h2{
  font-size:clamp(2rem,4vw,3rem);margin-bottom:16px;font-weight:800;
  letter-spacing:-.02em;position:relative;
  opacity:0;transform:translateY(20px);transition:all .8s ease;
}
.cta p{
  font-size:clamp(1rem,2vw,1.15rem);max-width:600px;margin:0 auto 32px;
  opacity:0;transform:translateY(20px);transition:all .8s ease .15s;color:rgba(255,255,255,.85);line-height:1.7;
}
.cta .btn{opacity:0;transform:translateY(20px);transition:all .8s ease .3s}
.cta.animated h2,.cta.animated p,.cta.animated .btn{opacity:1;transform:translateY(0)}
.cta .btn-white{background:#fff;color:var(--blue);font-weight:700;box-shadow:0 8px 32px rgba(0,0,0,.3)}
.cta .btn-white:hover{background:rgba(255,255,255,.92);transform:translateY(-3px);box-shadow:0 16px 48px rgba(0,0,0,.4)}

/* ─── FOOTER ─────────────────────────────────────────────────── */
footer{
  background:var(--navy);color:#fff;padding:72px 0 24px;
  position:relative;overflow:hidden;
  border-top:1px solid rgba(255,255,255,.06);
}
footer::before{
  content:"";position:absolute;inset:0;
  background:
    radial-gradient(ellipse 60% 50% at 0% 100%, rgba(21,73,255,.08), transparent),
    radial-gradient(ellipse 40% 40% at 100% 0%, rgba(0,207,255,.05), transparent);
  pointer-events:none;
}
.footer-grid{display:grid;grid-template-columns:1fr;gap:36px;margin-bottom:48px;position:relative;z-index:2}
.footer-column{opacity:0;transform:translateY(20px);transition:all .6s ease}
.footer-column.animated{opacity:1;transform:translateY(0)}
.footer-column:nth-child(1){transition-delay:.1s}
.footer-column:nth-child(2){transition-delay:.2s}
.footer-column:nth-child(3){transition-delay:.3s}
.footer-column:nth-child(4){transition-delay:.4s}
.footer-logo{
  font-size:18px;font-weight:800;color:#fff;
  display:flex;align-items:center;gap:10px;margin-bottom:14px;
}
.footer-logo .ppd{color:var(--cyan)}
.footer-column p.footer-desc{color:rgba(255,255,255,.55);font-size:.9rem;line-height:1.7;max-width:260px}
.footer-column h3{
  font-size:.8rem;font-weight:700;color:rgba(255,255,255,.45);
  letter-spacing:.1em;text-transform:uppercase;margin-bottom:16px;
}
.footer-column ul{list-style:none}
.footer-column ul li{margin-bottom:10px}
.footer-column ul li a{
  color:rgba(255,255,255,.6);font-size:.9rem;
  transition:color .2s,padding-left .2s;display:inline-block;
}
.footer-column ul li a:hover{color:#fff;padding-left:4px}
.footer-bottom{
  border-top:1px solid rgba(255,255,255,.08);
  padding-top:20px;
  display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;
  position:relative;z-index:2;
  opacity:0;transform:translateY(20px);transition:all .6s ease .5s;
}
.footer-bottom.animated{opacity:1;transform:translateY(0)}
.footer-bottom p{color:rgba(255,255,255,.45);font-size:.85rem}
.footer-iso{
  background:var(--navy-2);border-top:1px solid rgba(255,255,255,.06);
  color:rgba(255,255,255,.4);text-align:center;padding:12px 16px;font-size:.78rem;
  position:relative;z-index:2;
}

/* ─── RESPONSIVE ─────────────────────────────────────────────── */
@media(min-width:768px){
  .hero{padding:var(--section-py) 0;min-height:80vh}
  .hero-content{flex-direction:row;text-align:left}
  .hero-text{text-align:left;padding:0}
  .hero-text p{margin-left:0;margin-right:0}
  .hero-buttons{justify-content:flex-start}
  .hero-animation{height:440px}
  .payment-terminal{width:320px;height:220px}
  .terminal-screen{height:80px;font-size:20px;margin:35px auto 25px}
  .payment-card{width:100px;height:65px;font-size:14px;animation:cardSlide 12s infinite ease-in-out}
  .data-flow{width:80px;height:6px;animation:dataFlow 4s infinite linear}
  .features-grid{grid-template-columns:repeat(2,1fr);gap:24px}
  .footer-grid{grid-template-columns:repeat(2,1fr);gap:40px}
  .tech-animation.binary-code{display:block}
}
@media(min-width:992px){
  .features-grid{grid-template-columns:repeat(3,1fr)}
  .footer-grid{grid-template-columns:1.5fr 1fr 1fr 1fr}
}
@media(max-width:767px){
  .hero{padding-top:var(--mobile-hero-top);padding-bottom:56px;overflow:visible}
  .hero-kicker{margin-top:0}
  .hero-text h1{font-size:clamp(2rem,7vw,2.8rem);max-width:26ch;margin-inline:auto}
  .metrics{gap:12px}
  .metric .num{font-size:1.6rem}
  .solution-floating-element,.cta-element,.footer-floating-element,.cta-tech-animation,.footer-tech-animation{display:none}
}

/* ─── SHARED PAGE UTILITY CLASSES ────────────────────────────── */
.page-hero-dark{
  background:
    radial-gradient(ellipse 100% 80% at 80% -10%, rgba(21,73,255,.25) 0%, transparent 60%),
    linear-gradient(160deg, var(--navy) 0%, var(--navy-2) 100%);
  color:#fff;padding:var(--section-py) 0 var(--section-py-sm);position:relative;overflow:hidden;
}
.page-hero-dark::before{
  content:"";position:absolute;inset:0;
  background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.025'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  pointer-events:none;opacity:.3;
}

/* ─── GLOBAL ANIMATIONS ──────────────────────────────────────── */
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.12)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
@keyframes screenShine{0%{left:-100%}20%{left:100%}100%{left:100%}}
@keyframes cardSlideMobile{0%,100%{transform:translateX(-120px) rotate(-10deg);opacity:0}10%,90%{opacity:1}50%{transform:translateX(0) rotate(0)}90%{transform:translateX(120px) rotate(10deg);opacity:0}}
@keyframes cardSlide{0%,100%{transform:translateX(-180px) rotate(-12deg);opacity:0}10%,90%{opacity:1}50%{transform:translateX(0) rotate(0)}90%{transform:translateX(180px) rotate(12deg);opacity:0}}
@keyframes dataFlowMobile{0%{transform:translateX(-120px) scaleX(0)}30%{transform:translateX(-30px) scaleX(1)}70%{transform:translateX(30px) scaleX(1)}100%{transform:translateX(120px) scaleX(0)}}
@keyframes dataFlow{0%{transform:translateX(-200px) scaleX(0)}30%{transform:translateX(-50px) scaleX(1)}70%{transform:translateX(50px) scaleX(1)}100%{transform:translateX(200px) scaleX(0)}}
@keyframes badgePulse{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}
@keyframes checkPulse{0%,100%{transform:scale(1);box-shadow:0 0 0 0 rgba(0,229,160,.4)}50%{transform:scale(1.1);box-shadow:0 0 0 8px rgba(0,229,160,0)}}
@keyframes currencyFloat{0%,100%{transform:translateY(0) rotate(-5deg)}50%{transform:translateY(-12px) rotate(5deg)}}
@keyframes fadeInUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}
@keyframes menuPop{from{opacity:0;transform:translateY(6px) scale(.98)}to{opacity:1;transform:none}}
@keyframes rain{0%{transform:translateY(-100%)}100%{transform:translateY(100vh)}}
@keyframes pulseElement{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}
@keyframes borderShift{0%{filter:hue-rotate(0deg)}100%{filter:hue-rotate(360deg)}}
@keyframes btnSweep{0%{transform:translateX(-150%)}100%{transform:translateX(150%)}}
@keyframes ctaGradient{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
@keyframes ctaUnderline{from{width:0}to{width:60%}}
@keyframes spinSlow{to{transform:rotate(360deg)}}
@keyframes orbFloat{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(30px,-20px) scale(1.05)}66%{transform:translate(-20px,15px) scale(.97)}}
@keyframes popIn{0%{transform:scale(.7);opacity:0}80%{transform:scale(1.05)}100%{transform:scale(1);opacity:1}}
@keyframes floatSolo{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@keyframes shine{0%{left:-60%}100%{left:120%}}

    </style>
  </head>
  <body>
    <div class="scroll-progress" id="scrollProgress"></div>
    <Header />
    <div class="mobile-menu" id="mobileMenu">
      <button class="close-menu" id="closeMenu" aria-label="Close menu">✕</button>
      <ul>
        <div class="mobile-submenu-toggle" id="mobileIndustriesToggle">Industries <i class="fa-solid fa-chevron-down"></i></div>
        <div class="mobile-submenu" id="mobileIndustriesMenu">
          <a href="/restaurants"><i class="fa-solid fa-utensils"></i> Restaurants</a>
          <a href="/retail"><i class="fa-solid fa-store"></i> Retail</a>
          <a href="/ecommerce"><i class="fa-solid fa-cart-shopping"></i> E-commerce</a>
          <a href="/healthcare"><i class="fa-solid fa-user-doctor"></i> Healthcare</a>
          <a href="/contractors"><i class="fa-solid fa-helmet-safety"></i> Contractors</a>
          <a href="/non-profits"><i class="fa-solid fa-hand-holding-heart"></i> Non-profits</a>
          <a href="/higher-education"><i class="fa-solid fa-graduation-cap"></i> Higher Education</a>
          <a href="/repair"><i class="fa-solid fa-screwdriver-wrench"></i> Repair</a>
          <a href="/merchant"><i class="fa-solid fa-building"></i> B2B</a>
        </div>
        <div class="mobile-submenu-toggle" id="mobileProductsToggle">Products <i class="fa-solid fa-chevron-down"></i></div>
        <div class="mobile-submenu" id="mobileProductsMenu">
          <a href="/repair"><i class="fa-solid fa-screwdriver-wrench"></i> PPD Repair</a>
          <a href="/merchant"><i class="fa-solid fa-store"></i> PPD Merchant</a>
          <a href="/mx-build"><i class="fa-solid fa-layer-group"></i> MX-Build</a>
          <a href="/passport-banking"><i class="fa-solid fa-passport"></i> Passport Banking</a>
          <a href="/pays-pos"><i class="fa-solid fa-cash-register"></i> Pays POS</a>
          <a href="/korona">KORONA POS</a>
          <a href="/vp-800"><i class="fa-solid fa-credit-card"></i> VP-800</a>
          <a href="/clover">Clover POS</a>
        </div>
        <li><a href="/become-a-partner">Partner Program</a></li>
        <li><a href="/iso">ISO Solutions</a></li>
        <li><a href="/customer-support">Customer Support</a></li>
      </ul>
      <div class="header-buttons">
        <button class="btn btn-outline" onclick="location.href='https://ppdmerchant.com/'">Login</button>
        <button class="btn btn-primary" onclick="location.href='/signup'">Get Started</button>
      </div>
    </div>
    <div class="overlay" id="overlay"></div>
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      // Scroll progress
      const bar = document.getElementById('scrollProgress');
      window.addEventListener('scroll', () => {
        const pct = (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100;
        if (bar) bar.style.width = pct + '%';
      }, {passive: true});

      // Header shrink
      const hdr = document.getElementById('siteHeader');
      window.addEventListener('scroll', () => {
        if (hdr) hdr.classList.toggle('shrink', window.scrollY > 40);
      }, {passive: true});

      // Mobile menu
      const hamburger = document.getElementById('hamburger');
      const mobileMenu = document.getElementById('mobileMenu');
      const closeMenu  = document.getElementById('closeMenu');
      const overlay    = document.getElementById('overlay');
      function openMenu(){mobileMenu?.classList.add('active');overlay?.classList.add('active')}
      function closeM(){mobileMenu?.classList.remove('active');overlay?.classList.remove('active')}
      hamburger?.addEventListener('click', openMenu);
      closeMenu?.addEventListener('click', closeM);
      overlay?.addEventListener('click', closeM);

      // Mobile submenu toggles
      ['Industries','Products'].forEach(name => {
        document.getElementById('mobile'+name+'Toggle')?.addEventListener('click', function(){
          const sub = document.getElementById('mobile'+name+'Menu');
          sub?.classList.toggle('open');
        });
      });

      // Intersection observer for animations
      const observer = new IntersectionObserver(entries => {
        entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('animated') });
      }, {threshold:.12});
      document.querySelectorAll('.feature-card,.footer-column,.footer-bottom,.cta,.metric').forEach(el => observer.observe(el));

      // Slider (used by retail and other pages)
      const viewport = document.getElementById('solutionsViewport');
      const prevBtn  = document.getElementById('prevBtn');
      const nextBtn  = document.getElementById('nextBtn');
      if(viewport && prevBtn && nextBtn){
        const getSlideW = () => (viewport.querySelector('.slide')?.offsetWidth||0) + 20;
        nextBtn.addEventListener('click', () => viewport.scrollBy({left:getSlideW(),behavior:'smooth'}));
        prevBtn.addEventListener('click', () => viewport.scrollBy({left:-getSlideW(),behavior:'smooth'}));
      }
    </script>
  </body>
</html>
