---
import Landing from '../components/Landing.astro';
import FormExtras from '../components/FormExtras.astro';

const features = [
  { title: 'Estimating and change orders', body: 'Assemblies, markups and e-sign, then convert the estimate to a project in one click.' },
  { title: 'Scheduling and tasks', body: 'Gantt views, crews and mobile updates from the field.' },
  { title: 'Timecards and job costing', body: 'GPS stamps, cost codes and approvals, tied back to the job.' },
  { title: 'Progress billing', body: 'Bill by percent complete or by line item, and attach photos, change orders and lien waivers.' },
  { title: 'Materials and purchase orders', body: 'Order against the job and see what has arrived.' },
  { title: 'Documents and photos', body: 'Plans, RFIs and punch lists in one place.' },
];
const payments = [
  { name: 'Card and ACH payments', note: 'Clients pay an emailed invoice by card or bank transfer.' },
  { name: 'Deposits and retainage', note: 'Take the deposit up front and hold back what the contract says.' },
  { name: 'Surcharging and cash discount', note: 'Offset card costs where your program allows it.' },
  { name: 'QuickBooks sync', note: 'Payments land in the books without retyping.' },
  { name: 'Branded payment pages', note: 'Your logo on the page your client pays from.' },
  { name: 'Next-day funding options', note: 'Get paid sooner on the work you have finished.' },
];
---

<Landing
  title="MX-Build construction software with PPD payments | PPD Technology"
  description="MX Build brings estimating, scheduling, timecards, purchase orders and progress billing into one system, with PPD payments built in."
  accent={{ rgb: '255, 200, 58', main: '#e0a800', soft: '#ffd86b' }}
  eyebrow="MX-Build + PPD payments"
  headline={['Estimate, schedule, track', 'and bill in one system.']}
  lede="MX Build runs the job from estimate to final invoice. With PPD payments built in, clients pay by card or ACH from the invoice you email them."
  cta={[{ label: 'Book a demo', href: '#demo' }, { label: 'Enable payments', href: '/signup' }]}
  chips={['General contractors', 'Subcontractors', 'HVAC', 'Electrical', 'Plumbing', 'Roofing']}
  statement="Faster cash flow and less paperwork: the invoice, the payment and the job record are the same thing."
  featuresHead={{ eyebrow: 'What MX Build does', title: 'The whole job, in order.' }}
  features={features}
  gear={{ eyebrow: 'Payments with PPD', title: 'Get paid from the invoice.', items: payments }}
  form={{ tag: 'mx-build-demo', subject: 'New MX-Build Demo Request', title: 'See MX Build with payments switched on.', lede: 'We will walk through an estimate, a schedule and a progress invoice the way your team would use them.', cta: 'Book a demo' }}
>
  <img slot="visual" src="/images/hw/mx-build.webp" alt="MX Build scheduling screen" width="900" height="737" />

  <Fragment slot="fields">
    <FormExtras id="mx" select={{ name: 'trade', label: 'Your trade', options: ['General contracting', 'Roofing', 'HVAC', 'Plumbing', 'Electrical', 'Concrete', 'Landscaping', 'Other'] }} />
  </Fragment>
</Landing>
