    }

    .rest-demo-foot-inline{
      display:flex;justify-content:flex-end;gap:10px;
      margin-top:8px;flex-wrap:wrap;
    }

    .rest-demo-foot{
      display:flex;justify-content:flex-end;gap:10px;
      padding:14px 20px;border-top:1px solid rgba(255,255,255,.06);flex-wrap:wrap;
    }

    .rest-demo-note{margin-top:8px;font-size:11px;color:#5E7A9A}
    .rest-demo-note i{color:#00CFFF;margin-right:4px}

    .rest-demo-list{
      list-style:none;padding:0;margin:6px 0 0;
      display:flex;flex-direction:column;gap:8px;
    }
    .rest-demo-list li{
      font-size:13px;color:#94A3B8;
      display:flex;align-items:center;gap:8px;
    }
    .rest-demo-list li i{color:#00E5A0;font-size:11px;flex-shrink:0}

    .rest-demo-spacer{height:14px}
    .rest-demo-sub{font-size:13px;color:#5E7A9A;margin:0}

    .rest-video-wrap{
      position:relative;padding-top:56.25%;
      border-radius:10px;overflow:hidden;
      border:1px solid rgba(255,255,255,.06);
    }
    .rest-video-wrap iframe{position:absolute;inset:0;width:100%;height:100%;border:0}

    .rest-toast{
      position:fixed;left:50%;transform:translateX(-50%);
      bottom:20px;
      background:#1549FF;color:#fff;
      padding:12px 20px;border-radius:999px;font-weight:600;font-size:14px;
      box-shadow:0 8px 28px rgba(21,73,255,.4);
      display:none;z-index:4500;
    }
    .rest-toast.show{display:flex;align-items:center;gap:8px}

    @media(max-width:1024px){
      .rest-hero__inner{grid-template-columns:1fr;gap:40px}
      .rest-hero-card--qr{left:10px;bottom:10px}
      .rest-hero-card--online{right:10px;top:10px}
    }

    @media(max-width:900px){
      .rest-features,
      .rest-menu-grid,
      .rest-hw-grid{grid-template-columns:1fr 1fr}
      .rest-kds__grid{grid-template-columns:1fr 1fr}
      .rest-metrics__grid{grid-template-columns:repeat(2,1fr)}
    }

    @media(max-width:768px){
      .rest-features,
      .rest-menu-grid,
      .rest-hw-grid,
      .rest-metrics__grid{grid-template-columns:1fr}
      .rest-testi-grid{grid-template-columns:1fr}
      .rest-hero__actions{flex-direction:column;width:100%}
      .rest-hero__actions button{width:100%;justify-content:center}
      .rest-hero-app__kpis{grid-template-columns:repeat(2,1fr)}
      .rest-hero-card{display:none}
    }

    @media(max-width:640px){
      .rest-kds__grid{grid-template-columns:1fr}
      .rest-demo-grid{grid-template-columns:1fr}
      .rest-demo-row{grid-template-columns:1fr}
      .rest-hero-app__kpis{grid-template-columns:1fr}
      .rest-float-cta{right:12px;bottom:12px}
      .rest-float-cta .rest-btn-pill{padding:10px 16px;font-size:13px}
    }

    @keyframes rest-float{
      0%,100%{transform:translateY(0)}
      50%{transform:translateY(-10px)}
    }

    @keyframes rest-pop{
      from{transform:scale(.96);opacity:0}
      to{transform:scale(1);opacity:1}
    }
  </style>

  <script is:inline>
    // @ts-nocheck
    (() => {
      document.querySelectorAll('.rest-menu-card').forEach((card) => {
        const base = parseFloat(card.dataset.base || '0');
        const priceEl = card.querySelector('.rest-price-val');
        const chips = [...card.querySelectorAll('.rest-mod')];

        function update() {
          const groups = {};
          chips.forEach((c) => {
            const g = c.dataset.group;
            if (g) {
              groups[g] = groups[g] || [];
              if (c.classList.contains('active')) groups[g].push(parseFloat(c.dataset.delta || '0'));
            }
          });

          let total = base;
          Object.values(groups).forEach((arr) => {
            total += arr[0] ?? 0;
          });

          chips.forEach((c) => {
            if (!c.dataset.group && c.classList.contains('active')) {
              total += parseFloat(c.dataset.delta || '0');
            }
          });

          if (priceEl) priceEl.textContent = total.toFixed(2);
        }

        function syncAria() {
          chips.forEach((c) => {
            c.setAttribute('aria-pressed', c.classList.contains('active') ? 'true' : 'false');
          });
        }

        chips.forEach((c) => {
          c.addEventListener('click', () => {
            const g = c.dataset.group;
            if (g) {
              chips.filter((x) => x.dataset.group === g).forEach((x) => x.classList.remove('active'));
              c.classList.add('active');
            } else {
              c.classList.toggle('active');
            }
            syncAria();
            update();
          });
        });

        const groupsInit = new Set(chips.filter((c) => c.dataset.group).map((c) => c.dataset.group));
        groupsInit.forEach((g) => {
          const first = chips.find((c) => c.dataset.group === g);
          if (first) first.classList.add('active');
        });
        syncAria();

        update();
      });

      const kcols = {
        new: document.querySelector('.rest-kds__col[data-col="new"]'),
        prep: document.querySelector('.rest-kds__col[data-col="prep"]'),
        expo: document.querySelector('.rest-kds__col[data-col="expo"]'),
        ready: document.querySelector('.rest-kds__col[data-col="ready"]')
      };

      const readyTimestamps = new Map();

      function setPill(ticket, state) {
        const pill = ticket.querySelector('.rest-ticket__pill');
        if (!pill) return;
        pill.className = `rest-ticket__pill ${state}`;
        pill.textContent = state.toUpperCase();
      }

      function clearOldReadyTickets() {
        const now = Date.now();
        const readyTickets = kcols.ready?.querySelectorAll('.rest-ticket') || [];
        readyTickets.forEach((ticket) => {
          const id = ticket.getAttribute('data-ticket-id') || '';
          const t = readyTimestamps.get(id);
          if (t && now - t > 5000) {
            ticket.style.animation = 'rest-pop 0.35s ease reverse';
            setTimeout(() => {
              ticket.remove();
              readyTimestamps.delete(id);
            }, 300);
          }
        });
      }

      function makeTicket(id, items) {
        const el = document.createElement('div');
        el.className = 'rest-ticket';
        el.setAttribute('data-ticket-id', id);
        el.innerHTML = `
          <div class="rest-ticket__meta">
            <span>${id}</span>
            <span class="rest-ticket__pill new">NEW</span>
          </div>
          <ul>${items.map((i) => `<li>${i}</li>`).join('')}</ul>
        `;
        return el;
      }

      if (kcols.new && kcols.prep && kcols.expo && kcols.ready) {
        function advance() {
          clearOldReadyTickets();

          const expo = kcols.expo.querySelector('.rest-ticket');
          if (expo) {
            const id = expo.getAttribute('data-ticket-id') || '';
            setPill(expo, 'ready');
            kcols.ready.appendChild(expo);
            readyTimestamps.set(id, Date.now());
            return;
          }

          const prep = kcols.prep.querySelector('.rest-ticket');
          if (prep) {
            setPill(prep, 'expo');
            kcols.expo.appendChild(prep);
            return;
          }

          const nw = kcols.new.querySelector('.rest-ticket');
          if (nw) {
            setPill(nw, 'prep');
            kcols.prep.appendChild(nw);
            return;
          }

          if (Math.random() > 0.7) {
            const id = '#' + (1050 + Math.floor(Math.random() * 50)).toString();
            const menuItems = [
              ['QR Table ' + (Math.floor(Math.random() * 10) + 1) + ' — Nachos', '2x House Marg'],
              ['Breakfast Burrito', 'Coffee'],
              ['Caesar Salad', 'Garlic Bread'],
              ['Fish Tacos x3', 'Lime Wedge'],
              ['Vegan Bowl', 'Green Tea'],
              ['Steak Frites', 'House Red']
            ];
            const items = menuItems[Math.floor(Math.random() * menuItems.length)];
            kcols.new.appendChild(makeTicket(id, items));
          }
        }

        setInterval(advance, 1800);
        setInterval(clearOldReadyTickets, 1000);
      }

      const backdrop = document.getElementById('demoBackdrop');
      const demoForm = document.getElementById('demoForm');
      const toast = document.getElementById('toast');
      let lastFocused;

      function trapFocus(e) {
        const focusables = backdrop?.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        const list = Array.from(focusables || []).filter((el) => !el.disabled && el.offsetParent !== null);
        if (list.length === 0) return;

        const first = list[0];
        const last = list[list.length - 1];

        if (e.key === 'Tab') {
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }

        if (e.key === 'Escape') {
          window.closeDemo();
        }
      }

      window.openDemo = function () {
        lastFocused = document.activeElement;
        backdrop?.classList.add('active');
        backdrop?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        const firstInput = backdrop?.querySelector('input, select, textarea, button');
        firstInput?.focus();
        document.addEventListener('keydown', trapFocus);
      };

      window.closeDemo = function () {
        backdrop?.classList.remove('active');
        backdrop?.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = 'auto';
        document.removeEventListener('keydown', trapFocus);
        lastFocused?.focus?.();
      };

      backdrop?.addEventListener('click', (e) => {
        if (e.target === backdrop) window.closeDemo();
      });

      demoForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(demoForm).entries());

        if (!data.name || !data.business || !data.phone || !data.email) {
          alert('Please fill name, restaurant, phone, and email.');
          return;
        }

        try {
          const res = await fetch(demoForm.action, {
            method: demoForm.method || 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(demoForm)
          });

          if (res.ok) {
            window.closeDemo();
            demoForm.reset();
            toast?.classList.add('show');
            setTimeout(() => toast?.classList.remove('show'), 2400);
          } else {
            alert('There was a problem submitting the form. Please try again.');
          }
        } catch {
          alert('Network error submitting the form. Please try again.');
        }
      });

      const params = new URLSearchParams(location.search);
      if (params.get('demo') === '1') {
        window.openDemo();
      }
    })();
  </script>
</BaseLayout>
