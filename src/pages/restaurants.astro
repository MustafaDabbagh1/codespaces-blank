    .rest-demo-form input:focus,
    .rest-demo-form select:focus,
    .rest-demo-form textarea:focus{border-color:rgba(21,73,255,.4)}

    .rest-demo-form select{color:#CBD5E1}
    .rest-demo-form select option{background:#0F172A;color:#E2E8F0}

    .rest-demo-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}

    .rest-demo-checks{margin-bottom:6px}
    .rest-demo-checks label{
      display:flex;gap:8px;align-items:center;
