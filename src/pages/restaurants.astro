---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PPD Technology | Restaurants">
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Spectral:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <section class="restaurants-page">
    <section class="rest-hero">
      <div class="rest-container">
        <div class="rest-hero-grid">
          <div>
            <span class="rest-eyebrow"><i class="fa-solid fa-utensils"></i> Restaurants</span>
            <h1>Serve faster, tip higher, run smoother.</h1>
            <p>
              From counter to curbside, PPD gives restaurants Toast-level speed with
              Square-simple tools, online ordering, QR pay, kitchen display (KDS),
              and real-time analytics that keep every table turning.
            </p>

            <div class="rest-badge-row">
              <span class="rest-badge"><i class="fa-solid fa-bolt"></i> Lightning-fast orders</span>
              <span class="rest-badge"><i class="fa-solid fa-qrcode"></i> QR menus &amp; pay</span>
              <span class="rest-badge"><i class="fa-solid fa-gauge-high"></i> KDS throughput</span>
              <span class="rest-badge"><i class="fa-solid fa-chart-line"></i> Live sales</span>
            </div>

            <div class="rest-hero-actions">
              <button class="rest-btn rest-btn-primary" type="button" onclick="openDemo()">
                <i class="fa-solid fa-rocket"></i> Start for Free
              </button>
              <button
                class="rest-btn rest-btn-outline"
                type="button"
                onclick="document.getElementById('features')?.scrollIntoView({ behavior: 'smooth' })"
              >
                <i class="fa-solid fa-circle-play"></i> See Features
              </button>
            </div>

            <p class="rest-muted rest-hero-note">
              <i class="fa-solid fa-shield-halved"></i> PCI Level 1 · Offline Mode · Next-day funding
            </p>
          </div>

          <div class="rest-plate">
            <div class="rest-frame">
              <div
                class="rest-slide active"
                style="background-image:url('https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?q=80&w=1400&auto=format&fit=crop');"
              ></div>
              <div
                class="rest-slide"
                style="background-image:url('https://images.unsplash.com/photo-1498654896293-37aacf113fd9?q=80&w=1400&auto=format&fit=crop');"
              ></div>
              <div
                class="rest-slide"
                style="background-image:url('https://images.unsplash.com/photo-1559339352-11d035aa65de?q=80&w=1400&auto=format&fit=crop');"
              ></div>
              <div
                class="rest-slide"
                style="background-image:url('https://images.unsplash.com/photo-1544025162-d76694265947?q=80&w=1400&auto=format&fit=crop');"
              ></div>

              <div class="rest-steam"><span></span><span></span><span></span></div>
              <div class="rest-chip tomato">🍅</div>
              <div class="rest-chip basil">🌿</div>
              <div class="rest-chip onion">🧅</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rest-metrics">
      <div class="rest-container">
        <div class="rest-metrics-grid">
          <div class="rest-metric">
            <i class="fa-solid fa-stopwatch"></i>
            <div><div class="num">-28%</div><div class="label">ticket time</div></div>
          </div>
          <div class="rest-metric">
            <i class="fa-solid fa-money-bill-trend-up"></i>
            <div><div class="num">+21%</div><div class="label">avg. tip rate</div></div>
          </div>
          <div class="rest-metric">
            <i class="fa-solid fa-burger"></i>
            <div><div class="num">+18%</div><div class="label">order volume</div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="rest-section" id="features">
      <div class="rest-container">
        <div class="rest-section-title">
          <h2>Everything restaurants need, front to back of house</h2>
          <p>
            Inspired by leaders like Toast, Square, and Clover, shaped to your flow.
            Counter service, full service, food trucks, and multi-location groups.
          </p>
        </div>

        <div class="rest-features-grid">
          <div class="rest-feature">
            <div class="rest-feature-image">
              <img
                src="https://mmdabbagh24.neocities.org/images/online%20ordering.png"
                alt="Online Ordering"
                onerror="this.src='https://via.placeholder.com/300x160/f1e5d8/8a6a4a?text=Online+Ordering'"
              />
            </div>
            <h3>Online Ordering &amp; Pickup</h3>
            <p>Branded web ordering, throttling, curbside pickup, and DoorDash Drive hand-offs. Smart upsells per item.</p>
          </div>

          <div class="rest-feature">
            <div class="rest-feature-image">
              <img
                src="https://mmdabbagh24.neocities.org/images/countertopQR%20Code.png"
                alt="QR Menu"
                onerror="this.src='https://via.placeholder.com/300x160/f1e5d8/8a6a4a?text=QR+Menu'"
              />
            </div>
            <h3>QR Menus &amp; Pay at Table</h3>
            <p>Guests scan, order, split, and tip without waiting. Your servers focus on hospitality, not hand terminals.</p>
          </div>

          <div class="rest-feature">
            <div class="rest-feature-image">
              <img
                src="https://mmdabbagh24.neocities.org/images/Kitchen-Display-System.png"
                alt="Kitchen Display System"
                onerror="this.src='https://via.placeholder.com/300x160/f1e5d8/8a6a4a?text=KDS'"
              />
            </div>
            <h3>Kitchen Display (KDS)</h3>
            <p>Route tickets by station, hold &amp; fire, and track make times. Color states keep the line moving.</p>
          </div>

          <div class="rest-feature">
            <div class="rest-feature-image">
              <img
                src="https://mmdabbagh24.neocities.org/images/cash%20diuscount%20pro.png"
                alt="Cash Discount Pro"
                onerror="this.src='https://via.placeholder.com/300x160/f1e5d8/8a6a4a?text=Cash+Discount'"
              />
            </div>
            <h3>Cash Discount Pro</h3>
            <p>Offer a cash discount to save on credit card fees. Automatically adjust pricing and comply with regulations.</p>
          </div>

          <div class="rest-feature">
            <div class="rest-feature-image">
              <img
                src="https://mmdabbagh24.neocities.org/images/inventorypos.png"
                alt="Inventory Management"
                onerror="this.src='https://via.placeholder.com/300x160/f1e5d8/8a6a4a?text=Inventory'"
              />
            </div>
            <h3>Inventory &amp; Recipes</h3>
            <p>Recipe costs, theoretical vs. actual, low-stock alerts, and invoice scanning to sync COGS.</p>
          </div>

          <div class="rest-feature">
            <div class="rest-feature-image">
              <img
                src="https://mmdabbagh24.neocities.org/images/doordashlogo.png"
                alt="Third Party Integrations"
                onerror="this.src='https://via.placeholder.com/300x160/f1e5d8/8a6a4a?text=Integrations'"
              />
            </div>
            <h3>Third Party Integrations</h3>
            <p>Seamlessly integrate with DoorDash, Uber Eats, and other third-party delivery services. Manage all orders in one place.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="rest-section rest-mods-section">
      <div class="rest-container">
        <div class="rest-section-title">
          <h2>Interactive Menu Experience</h2>
          <p>Customize your order with real-time pricing updates</p>
        </div>

        <div class="rest-mods">
          <div class="rest-item-card" data-base="9.00">
            <div
              class="rest-item-cover"
              style="background-image:url('https://images.unsplash.com/photo-1550547660-d9450f859349?q=80&w=1400&auto=format&fit=crop')"
            ></div>
            <div class="rest-item-body">
              <div class="rest-item-top">
                <strong>Smash Burger</strong>
                <div class="rest-price">$<span class="rest-price-val">9.00</span></div>
              </div>
              <div class="rest-muted">Pick size and add-ons, just like on a Clover/Toast order pad.</div>
              <div class="rest-row-divider"></div>
              <div class="rest-mods-row">
                <span class="rest-chip-mod" data-group="size" data-delta="0">Single</span>
                <span class="rest-chip-mod" data-group="size" data-delta="2.5">Double +$2.50</span>
                <span class="rest-chip-mod" data-group="size" data-delta="4.5">Triple +$4.50</span>
              </div>
              <div class="rest-mods-row">
                <span class="rest-chip-mod" data-delta="1.0">Cheddar +$1</span>
                <span class="rest-chip-mod" data-delta=".75">Bacon +$0.75</span>
                <span class="rest-chip-mod" data-delta=".50">Avocado +$0.50</span>
                <span class="rest-chip-mod" data-delta="0">No Onions</span>
              </div>
            </div>
          </div>

          <div class="rest-item-card" data-base="14.00">
            <div
              class="rest-item-cover"
              style="background-image:url('https://mmdabbagh24.neocities.org/images/Neapolitan_Pizza_Mike_Fitzick_pizza_jew_-_Large_4a602f93-1316-494f-9435-a7436bbf5d4d.png')"
            ></div>
            <div class="rest-item-body">
              <div class="rest-item-top">
                <strong>Neapolitan Pizza</strong>
                <div class="rest-price">$<span class="rest-price-val">14.00</span></div>
              </div>
              <div class="rest-muted">Tap toppings; size is single-select.</div>
              <div class="rest-row-divider"></div>
              <div class="rest-mods-row">
                <span class="rest-chip-mod" data-group="size" data-delta="0">12"</span>
                <span class="rest-chip-mod" data-group="size" data-delta="3">16" +$3</span>
                <span class="rest-chip-mod" data-group="size" data-delta="6">18" +$6</span>
              </div>
              <div class="rest-mods-row">
                <span class="rest-chip-mod" data-delta="1">Pepperoni +$1</span>
                <span class="rest-chip-mod" data-delta="1">Mushroom +$1</span>
                <span class="rest-chip-mod" data-delta="1.5">Extra Cheese +$1.5</span>
                <span class="rest-chip-mod" data-delta="0">Gluten-Free</span>
              </div>
            </div>
          </div>

          <div class="rest-item-card" data-base="4.25">
            <div
              class="rest-item-cover"
              style="background-image:url('https://images.unsplash.com/photo-1504754524776-8f4f37790ca0?q=80&w=1400&auto=format&fit=crop')"
            ></div>
            <div class="rest-item-body">
              <div class="rest-item-top">
                <strong>Oat Latte</strong>
                <div class="rest-price">$<span class="rest-price-val">4.25</span></div>
              </div>
              <div class="rest-muted">Size &amp; flavor shots, instant price update.</div>
              <div class="rest-row-divider"></div>
              <div class="rest-mods-row">
                <span class="rest-chip-mod" data-group="size" data-delta="0">12oz</span>
                <span class="rest-chip-mod" data-group="size" data-delta=".5">16oz +$0.50</span>
                <span class="rest-chip-mod" data-group="size" data-delta="1">20oz +$1</span>
              </div>
              <div class="rest-mods-row">
                <span class="rest-chip-mod" data-delta=".5">Caramel +$0.50</span>
                <span class="rest-chip-mod" data-delta=".5">Vanilla +$0.50</span>
                <span class="rest-chip-mod" data-delta=".75">Extra Shot +$0.75</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rest-section rest-kds-section">
      <div class="rest-container">
        <div class="rest-section-title">
          <h2>Kitchen Display System</h2>
          <p>Streamline your kitchen workflow with real-time order tracking</p>
        </div>

        <div class="rest-kds-wrap">
          <div class="rest-kds-head">
            <strong><i class="fa-solid fa-display"></i> KDS — Line Status</strong>
            <span class="rest-muted">Tickets flow automatically from New → Prep → Expo → Ready</span>
          </div>
          <div class="rest-kds-grid">
            <div class="rest-kcol" data-col="new">
              <h4>NEW</h4>

              <div class="rest-ticket" data-ticket-id="#1047">
                <div class="meta">
                  <span>#1047</span>
                  <span class="rest-pill new">NEW</span>
                </div>
                <ul>
                  <li>Smash Burger x2</li>
                  <li>Fries</li>
                  <li>Vanilla Shake</li>
                </ul>
                <div class="rest-ticket-note"><i class="fa-solid fa-info-circle"></i> No onions</div>
              </div>

              <div class="rest-ticket" data-ticket-id="#1048">
                <div class="meta">
                  <span>#1048</span>
                  <span class="rest-pill new">NEW</span>
                </div>
                <ul>
                  <li>Neapolitan 16"</li>
                  <li>Arugula Salad</li>
                </ul>
              </div>

              <div class="rest-ticket" data-ticket-id="#1049">
                <div class="meta">
                  <span>#1049</span>
                  <span class="rest-pill new">NEW</span>
                </div>
                <ul>
                  <li>Oat Latte 16oz</li>
                  <li>Blueberry Muffin</li>
                </ul>
              </div>

              <div class="rest-ticket" data-ticket-id="#1050">
                <div class="meta">
                  <span>#1050</span>
                  <span class="rest-pill new">NEW</span>
                </div>
                <ul>
                  <li>Spicy Ramen</li>
                  <li>Gyoza x6</li>
                </ul>
              </div>
            </div>

            <div class="rest-kcol" data-col="prep"><h4>PREP</h4></div>
            <div class="rest-kcol" data-col="expo"><h4>EXPO</h4></div>
            <div class="rest-kcol" data-col="ready"><h4>READY</h4></div>
          </div>
        </div>
      </div>
    </section>

    <section class="rest-section">
      <div class="rest-container">
        <div class="rest-section-title">
          <h2>Hardware for every part of your restaurant</h2>
          <p>From front-of-house to kitchen, we have the tools to streamline your operations.</p>
        </div>

        <div class="rest-products-showcase">
          <div class="rest-product-card">
            <div class="rest-product-image">
              <img
                src="https://mmdabbagh24.neocities.org/images/clover-duo-printer-mini3-facing-customer.png"
                alt="Clover Duo"
                onerror="this.src='https://via.placeholder.com/200x140/f1e5d8/8a6a4a?text=Clover+Duo'"
              />
            </div>
            <div class="rest-product-info">
              <h3>Clover Duo</h3>
              <p>All-in-one POS system with customer-facing display and integrated payment processing.</p>
            </div>
          </div>

          <div class="rest-product-card">
            <div class="rest-product-image">
              <img
                src="https://mmdabbagh24.neocities.org/images/payskiosk.png"
                alt="Self Order Kiosk"
                onerror="this.src='https://via.placeholder.com/200x140/f1e5d8/8a6a4a?text=Self+Order+Kiosk'"
              />
            </div>
            <div class="rest-product-info">
              <h3>Self Order Kiosk</h3>
              <p>Reduce wait times with intuitive self-service ordering for customers.</p>
            </div>
          </div>

          <div class="rest-product-card">
            <div class="rest-product-image">
              <img
                src="https://mmdabbagh24.neocities.org/images/Pos%20system.png"
                alt="Pays POS"
                onerror="this.src='https://via.placeholder.com/200x140/f1e5d8/8a6a4a?text=POS+Terminal'"
              />
            </div>
            <div class="rest-product-info">
              <h3>Pays POS Terminal</h3>
              <p>Reliable countertop POS system with fast payment processing and order management.</p>
            </div>
          </div>

          <div class="rest-product-card">
            <div class="rest-product-image">
              <img
                src="https://mmdabbagh24.neocities.org/images/handheld%20pos.png"
                alt="Handheld POS"
                onerror="this.src='https://via.placeholder.com/200x140/f1e5d8/8a6a4a?text=Handheld+POS'"
              />
            </div>
            <div class="rest-product-info">
              <h3>Handheld POS</h3>
              <p>Mobile payment and order taking solution for tableside service and busy environments.</p>
            </div>
          </div>

          <div class="rest-product-card">
            <div class="rest-product-image">
              <img
                src="https://mmdabbagh24.neocities.org/images/cash_drawer.png"
                alt="Cash Drawer"
                onerror="this.src='https://via.placeholder.com/200x140/f1e5d8/8a6a4a?text=Cash+Drawer'"
              />
            </div>
            <div class="rest-product-info">
              <h3>Cash Drawer</h3>
              <p>Secure cash management with durable construction and seamless POS integration.</p>
            </div>
          </div>

          <div class="rest-product-card">
            <div class="rest-product-image">
              <img
                src="https://mmdabbagh24.neocities.org/images/Kitchen-printer.png"
                alt="Kitchen Printer"
                onerror="this.src='https://via.placeholder.com/200x140/f1e5d8/8a6a4a?text=Kitchen+Printer'"
              />
            </div>
            <div class="rest-product-info">
              <h3>Kitchen Printer</h3>
              <p>High-speed thermal printer for reliable kitchen order tickets and reduced errors.</p>
            </div>
          </div>
        </div>

        <div class="rest-testi">
          <div class="rest-t-card">
            <div class="rest-pulse-dot"></div>
            <div class="rest-stars">
              <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star-half-stroke"></i>
            </div>
            "QR pay cut our table turns by 9 minutes. Tips are up and the line finally moves."
            <div class="rest-t-author">
              <div class="rest-avatar">JD</div>
              <div><strong>Jasmine Diaz</strong><div class="rest-muted">Owner, Ember Taqueria</div></div>
            </div>
          </div>

          <div class="rest-t-card">
            <div class="rest-pulse-dot"></div>
            <div class="rest-stars">
              <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
            </div>
            "KDS routing cut remake waste in half. Closing shifts are finally... sane."
            <div class="rest-t-author">
              <div class="rest-avatar">RL</div>
              <div><strong>Ramon Lee</strong><div class="rest-muted">GM, Noodle Lab</div></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rest-cta">
      <div class="rest-confetti">
        <span style="left:10%;top:-20px"></span>
        <span style="left:20%;top:-40px;animation-delay:.6s"></span>
        <span style="left:35%;top:-30px;animation-delay:1.2s"></span>
        <span style="left:55%;top:-10px;animation-delay:.9s"></span>
        <span style="left:70%;top:-50px;animation-delay:1.6s"></span>
        <span style="left:85%;top:-20px;animation-delay:.3s"></span>
      </div>
      <div class="rest-container">
        <h3>Let's get every ticket out hot.</h3>
        <p>Launch online ordering and QR pay today. Install KDS this week. We'll migrate your menu and train your crew.</p>
        <button class="rest-btn rest-btn-primary" type="button" onclick="openDemo()">
          <i class="fa-solid fa-bowl-food"></i> Get a Demo
        </button>
      </div>
    </section>

    <div class="rest-float-cta">
      <button class="rest-btn rest-btn-primary" type="button" onclick="openDemo()">
        <i class="fa-solid fa-mug-hot"></i>&nbsp; Book a Demo
      </button>
    </div>

    <div class="rest-demo-backdrop" id="demoBackdrop" aria-hidden="true">
      <div class="rest-demo-modal" role="dialog" aria-modal="true" aria-labelledby="demoTitle">
        <div class="rest-demo-head">
          <h3 id="demoTitle"><i class="fa-solid fa-utensils"></i> Book a Restaurant Demo</h3>
          <button class="rest-demo-close" aria-label="Close demo form" type="button" onclick="closeDemo()">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div class="rest-demo-body">
          <div class="rest-demo-grid">
            <div class="rest-demo-card">
              <h4><i class="fa-solid fa-clipboard-check"></i> Tell us about your concept</h4>

              <form
                id="demoForm"
                class="rest-demo-form"
                novalidate
                action="https://formspree.io/f/mkgqbwvd"
                method="POST"
              >
                <div class="rest-demo-row">
                  <div>
                    <label>Full Name</label>
                    <input required name="name" placeholder="Jane Doe" />
                  </div>
                  <div>
                    <label>Restaurant</label>
                    <input required name="business" placeholder="Ember Taqueria" />
                  </div>
                </div>

                <div class="rest-demo-row">
                  <div>
                    <label>Phone</label>
                    <input required name="phone" inputmode="tel" placeholder="(555) 555-5555" />
                  </div>
                  <div>
                    <label>Email</label>
                    <input required name="email" type="email" placeholder="you@domain.com" />
                  </div>
                </div>

                <div class="rest-demo-row">
                  <div>
                    <label>Location</label>
                    <input name="city" placeholder="City, State" />
                  </div>
                  <div>
                    <label>Best Contact Time</label>
                    <select name="time">
                      <option value="">Select…</option>
                      <option>Morning</option>
                      <option>Afternoon</option>
                      <option>Evening</option>
                    </select>
                  </div>
                </div>

                <label>What do you want to see?</label>

                <div class="rest-demo-row rest-demo-checks">
                  <label><input type="checkbox" name="topics" value="QR Pay" /> QR Menus &amp; Pay</label>
                  <label><input type="checkbox" name="topics" value="KDS" /> Kitchen Display (KDS)</label>
                </div>

                <div class="rest-demo-row rest-demo-checks">
                  <label><input type="checkbox" name="topics" value="Online Ordering" /> Online Ordering</label>
                  <label><input type="checkbox" name="topics" value="Inventory" /> Inventory/Recipes</label>
                </div>

                <label>Notes</label>
                <textarea name="notes" rows="3" placeholder="Shift change is crazy; want KDS to speed expo…"></textarea>

                <div class="rest-demo-foot rest-inline-foot">
                  <button type="button" class="rest-btn rest-btn-outline" onclick="closeDemo()">Cancel</button>
                  <button type="submit" class="rest-btn rest-btn-primary">
                    <i class="fa-solid fa-paper-plane"></i> Request Demo
                  </button>
                </div>

                <p class="rest-muted rest-demo-note">
                  <i class="fa-solid fa-shield-heart"></i> We never share your info. By submitting, you agree to be contacted about PPD products.
                </p>
              </form>
            </div>

            <div class="rest-demo-card">
              <h4><i class="fa-solid fa-gauge-high"></i> What we’ll cover</h4>
              <ul class="rest-demo-list">
                <li>Live walk-through: Online ordering + QR pay</li>
                <li>KDS routing &amp; make time tracking</li>
                <li>Hardware fit: countertop, handhelds, kitchen</li>
                <li>Migration: menu import &amp; staff training</li>
