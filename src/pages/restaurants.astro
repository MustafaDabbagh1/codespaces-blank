---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PPD Technology | Restaurant POS & Online Ordering">
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <section class="rest-page">

    <section class="rest-hero">
      <div class="rest-hero__grid-bg"></div>
      <div class="rest-hero__orb rest-hero__orb--1"></div>
      <div class="rest-hero__orb rest-hero__orb--2"></div>

      <div class="rest-container rest-hero__inner">
        <div class="rest-hero__text">
          <span class="rest-pill"><i class="fa-solid fa-utensils"></i> Restaurant Solutions</span>
          <h1>Serve Faster. Earn More.<br>Run It All with <span class="rest-grad">PPD</span></h1>
          <p>
            Online ordering, QR pay, kitchen display, real-time analytics, and
            next-day funding — everything your restaurant needs in one system.
          </p>

          <div class="rest-hero__badges">
            <span class="rest-hero__badge"><i class="fa-solid fa-mobile-screen-button"></i> Online Ordering</span>
            <span class="rest-hero__badge"><i class="fa-solid fa-qrcode"></i> QR Pay</span>
            <span class="rest-hero__badge"><i class="fa-solid fa-display"></i> KDS</span>
            <span class="rest-hero__badge"><i class="fa-solid fa-bolt"></i> Next-Day Funding</span>
          </div>

          <div class="rest-hero__actions">
            <button class="rest-btn-primary" type="button" onclick="openDemo()">
              <i class="fa-solid fa-calendar-check"></i> Get a Demo
            </button>
            <button
              class="rest-btn-ghost"
              type="button"
              onclick="document.getElementById('features')?.scrollIntoView({ behavior: 'smooth' })"
            >
              <i class="fa-solid fa-play"></i> See Features
            </button>
          </div>

          <div class="rest-hero__trust">
            <span><i class="fa-solid fa-shield-halved"></i> PCI Level 1</span>
            <span><i class="fa-solid fa-wifi-slash"></i> Offline Mode</span>
            <span><i class="fa-solid fa-headset"></i> U.S. Support</span>
          </div>
        </div>

        <div class="rest-hero__visual">
          <div class="rest-hero-app">
            <div class="rest-hero-app__bar">
              <div class="rest-hero-app__dots"><span></span><span></span><span></span></div>
              <span class="rest-hero-app__title">PPD Restaurant — Dashboard</span>
            </div>
            <div class="rest-hero-app__body">
              <div class="rest-hero-app__sidebar">
                <div class="rest-hero-app__nav active"><i class="fa-solid fa-chart-line"></i></div>
                <div class="rest-hero-app__nav"><i class="fa-solid fa-utensils"></i></div>
                <div class="rest-hero-app__nav"><i class="fa-solid fa-cash-register"></i></div>
                <div class="rest-hero-app__nav"><i class="fa-solid fa-display"></i></div>
                <div class="rest-hero-app__nav"><i class="fa-solid fa-users"></i></div>
                <div class="rest-hero-app__nav"><i class="fa-solid fa-gear"></i></div>
              </div>
              <div class="rest-hero-app__main">
                <div class="rest-hero-app__topbar">
                  <div><strong>Good morning</strong><span class="rest-hero-app__sub">Ember Taqueria — Main St</span></div>
                  <div class="rest-hero-app__presets"><span class="active">Today</span><span>7d</span><span>30d</span></div>
                </div>
                <div class="rest-hero-app__kpis">
                  <div class="rest-kpi"><span class="rest-kpi__label">Revenue</span><span class="rest-kpi__val">$6,842</span><span class="rest-kpi__tag green"><i class="fa-solid fa-arrow-up"></i> 21%</span></div>
                  <div class="rest-kpi"><span class="rest-kpi__label">Orders</span><span class="rest-kpi__val">147</span><span class="rest-kpi__tag cyan">42 online</span></div>
                  <div class="rest-kpi"><span class="rest-kpi__label">Avg Ticket</span><span class="rest-kpi__val">$46</span><span class="rest-kpi__tag green"><i class="fa-solid fa-arrow-up"></i> 8%</span></div>
                  <div class="rest-kpi"><span class="rest-kpi__label">Tips</span><span class="rest-kpi__val">$1,024</span><span class="rest-kpi__tag green"><i class="fa-solid fa-arrow-up"></i> 15%</span></div>
                </div>
                <div class="rest-hero-app__orders">
                  <div class="rest-hero-app__orders-hdr"><strong>Live Orders</strong><span>View All</span></div>
                  <div class="rest-hero-order"><span class="rest-order-badge amber">Cooking</span><span class="rest-order-item">Table 7 — Smash Burger x2, Fries</span><span class="rest-order-price">$28.50</span></div>
                  <div class="rest-hero-order"><span class="rest-order-badge green">Ready</span><span class="rest-order-item">Online #412 — Neapolitan 16"</span><span class="rest-order-price">$17.00</span></div>
                  <div class="rest-hero-order"><span class="rest-order-badge blue">New</span><span class="rest-order-item">QR Table 3 — Oat Latte, Muffin</span><span class="rest-order-price">$9.25</span></div>
                </div>
              </div>
            </div>
          </div>

          <div class="rest-hero-card rest-hero-card--qr">
            <div class="rest-hero-card__hdr"><i class="fa-solid fa-qrcode"></i> QR Pay — Table 3</div>
            <div class="rest-hero-card__line"><span>Oat Latte 16oz</span><span>$4.75</span></div>
            <div class="rest-hero-card__line"><span>Blueberry Muffin</span><span>$4.50</span></div>
            <div class="rest-hero-card__total"><span>Total</span><span>$9.25</span></div>
            <div class="rest-hero-card__bar">
              <span class="active"><i class="fa-solid fa-credit-card"></i> Card</span>
              <span><i class="fa-brands fa-apple-pay"></i></span>
              <span><i class="fa-brands fa-google-pay"></i></span>
            </div>
          </div>

          <div class="rest-hero-card rest-hero-card--online">
            <div class="rest-hero-card__hdr"><i class="fa-solid fa-mobile-screen-button"></i> Online Order #412</div>
            <div class="rest-hero-card__status"><i class="fa-solid fa-circle-check"></i> Confirmed — Pickup 6:30pm</div>
          </div>
        </div>
      </div>
    </section>

    <section class="rest-metrics">
      <div class="rest-container">
        <div class="rest-metrics__grid">
          <div class="rest-metric-card">
            <div class="rest-metric-card__icon"><i class="fa-solid fa-stopwatch"></i></div>
            <div class="rest-metric-card__num">-28%</div>
            <div class="rest-metric-card__label">Ticket Time</div>
          </div>
          <div class="rest-metric-card">
            <div class="rest-metric-card__icon"><i class="fa-solid fa-money-bill-trend-up"></i></div>
            <div class="rest-metric-card__num">+21%</div>
            <div class="rest-metric-card__label">Avg. Tip Rate</div>
          </div>
          <div class="rest-metric-card">
            <div class="rest-metric-card__icon"><i class="fa-solid fa-burger"></i></div>
            <div class="rest-metric-card__num">+18%</div>
            <div class="rest-metric-card__label">Order Volume</div>
          </div>
          <div class="rest-metric-card">
            <div class="rest-metric-card__icon"><i class="fa-solid fa-gauge-high"></i></div>
            <div class="rest-metric-card__num">Next Day</div>
            <div class="rest-metric-card__label">Funding Speed</div>
          </div>
        </div>
      </div>
    </section>

    <section class="rest-section" id="features">
      <div class="rest-container">
        <div class="rest-section-hdr">
          <span class="rest-section-pill"><i class="fa-solid fa-grid-2"></i> Feature Set</span>
          <h2>Everything Restaurants Need</h2>
          <p>Front of house to back of house — counter service, full service, food trucks, and multi-location groups.</p>
        </div>

        <div class="rest-features">
          <div class="rest-feat">
            <div class="rest-feat__img"><img src="/images/online ordering.png" alt="Online Ordering" /></div>
            <h3>Online Ordering & Pickup</h3>
            <p>Branded web ordering with throttling, curbside pickup, DoorDash Drive hand-offs, and smart upsells per item.</p>
          </div>
          <div class="rest-feat">
            <div class="rest-feat__img"><img src="/images/countertopQR Code.png" alt="QR Menu" /></div>
            <h3>QR Menus & Pay at Table</h3>
            <p>Guests scan, order, split, and tip without waiting. Servers focus on hospitality, not hand terminals.</p>
          </div>
          <div class="rest-feat">
            <div class="rest-feat__img"><img src="/images/Kitchen-Display-System.png" alt="Kitchen Display System" /></div>
            <h3>Kitchen Display (KDS)</h3>
            <p>Route tickets by station with hold & fire and make-time tracking. Color states keep the line moving.</p>
          </div>
          <div class="rest-feat">
            <div class="rest-feat__img"><img src="/images/cash diuscount pro.png" alt="Cash Discount Pro" /></div>
            <h3>Cash Discount Pro</h3>
            <p>Offer a cash discount to save on credit card fees. Automatically adjust pricing and stay compliant.</p>
          </div>
          <div class="rest-feat">
            <div class="rest-feat__img"><img src="/images/inventorypos.png" alt="Inventory Management" /></div>
            <h3>Inventory & Recipes</h3>
            <p>Recipe costs, theoretical vs. actual usage, low-stock alerts, and invoice scanning to sync COGS.</p>
          </div>
          <div class="rest-feat">
            <div class="rest-feat__img"><img src="/images/doordashlogo.png" alt="Third Party Integrations" /></div>
            <h3>Third-Party Integrations</h3>
            <p>DoorDash, Uber Eats, and other delivery services — all orders managed in one place.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="rest-section rest-menu-section">
      <div class="rest-container">
        <div class="rest-section-hdr">
          <span class="rest-section-pill"><i class="fa-solid fa-wand-magic-sparkles"></i> Live Demo</span>
          <h2>Interactive Menu Experience</h2>
          <p>Tap modifiers and watch prices update in real time — just like the real ordering interface.</p>
        </div>

        <div class="rest-menu-grid">
          <div class="rest-menu-card" data-base="9.00">
            <div
              class="rest-menu-card__img"
              style="background-image:url('https://images.unsplash.com/photo-1550547660-d9450f859349?q=80&w=800&auto=format&fit=crop')"
            ></div>
            <div class="rest-menu-card__body">
              <div class="rest-menu-card__top">
                <strong>Smash Burger</strong>
                <div class="rest-menu-price">$<span class="rest-price-val">9.00</span></div>
              </div>
              <span class="rest-menu-hint">Pick size and add-ons</span>
              <div class="rest-menu-divider"></div>
              <div class="rest-menu-mods">
                <button type="button" class="rest-mod" data-group="size" data-delta="0" aria-pressed="false">Single</button>
                <button type="button" class="rest-mod" data-group="size" data-delta="2.5" aria-pressed="false">Double +$2.50</button>
                <button type="button" class="rest-mod" data-group="size" data-delta="4.5" aria-pressed="false">Triple +$4.50</button>
              </div>
              <div class="rest-menu-mods">
                <button type="button" class="rest-mod" data-delta="1.0" aria-pressed="false">Cheddar +$1</button>
                <button type="button" class="rest-mod" data-delta=".75" aria-pressed="false">Bacon +$0.75</button>
                <button type="button" class="rest-mod" data-delta=".50" aria-pressed="false">Avocado +$0.50</button>
                <button type="button" class="rest-mod" data-delta="0" aria-pressed="false">No Onions</button>
              </div>
            </div>
          </div>

          <div class="rest-menu-card" data-base="14.00">
            <div
              class="rest-menu-card__img"
              style="background-image:url('https://images.unsplash.com/photo-1574071318508-1cdbab80d002?q=80&w=800&auto=format&fit=crop')"
            ></div>
            <div class="rest-menu-card__body">
              <div class="rest-menu-card__top">
                <strong>Neapolitan Pizza</strong>
                <div class="rest-menu-price">$<span class="rest-price-val">14.00</span></div>
              </div>
              <span class="rest-menu-hint">Tap toppings; size is single-select</span>
              <div class="rest-menu-divider"></div>
              <div class="rest-menu-mods">
                <button type="button" class="rest-mod" data-group="size" data-delta="0" aria-pressed="false">12"</button>
                <button type="button" class="rest-mod" data-group="size" data-delta="3" aria-pressed="false">16" +$3</button>
                <button type="button" class="rest-mod" data-group="size" data-delta="6" aria-pressed="false">18" +$6</button>
              </div>
              <div class="rest-menu-mods">
                <button type="button" class="rest-mod" data-delta="1" aria-pressed="false">Pepperoni +$1</button>
                <button type="button" class="rest-mod" data-delta="1" aria-pressed="false">Mushroom +$1</button>
                <button type="button" class="rest-mod" data-delta="1.5" aria-pressed="false">Extra Cheese +$1.5</button>
                <button type="button" class="rest-mod" data-delta="0" aria-pressed="false">Gluten-Free</button>
              </div>
            </div>
          </div>

          <div class="rest-menu-card" data-base="4.25">
            <div
              class="rest-menu-card__img"
              style="background-image:url('https://images.unsplash.com/photo-1504754524776-8f4f37790ca0?q=80&w=800&auto=format&fit=crop')"
            ></div>
            <div class="rest-menu-card__body">
              <div class="rest-menu-card__top">
                <strong>Oat Latte</strong>
                <div class="rest-menu-price">$<span class="rest-price-val">4.25</span></div>
              </div>
              <span class="rest-menu-hint">Size & flavor shots</span>
              <div class="rest-menu-divider"></div>
              <div class="rest-menu-mods">
                <button type="button" class="rest-mod" data-group="size" data-delta="0" aria-pressed="false">12oz</button>
                <button type="button" class="rest-mod" data-group="size" data-delta=".5" aria-pressed="false">16oz +$0.50</button>
                <button type="button" class="rest-mod" data-group="size" data-delta="1" aria-pressed="false">20oz +$1</button>
              </div>
              <div class="rest-menu-mods">
                <button type="button" class="rest-mod" data-delta=".5" aria-pressed="false">Caramel +$0.50</button>
                <button type="button" class="rest-mod" data-delta=".5" aria-pressed="false">Vanilla +$0.50</button>
                <button type="button" class="rest-mod" data-delta=".75" aria-pressed="false">Extra Shot +$0.75</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rest-section rest-kds-section">
      <div class="rest-container">
        <div class="rest-section-hdr">
          <span class="rest-section-pill"><i class="fa-solid fa-display"></i> Kitchen Display</span>
          <h2>Kitchen Display System</h2>
          <p>Tickets flow automatically from New to Ready — watch the live simulation below.</p>
        </div>

        <div class="rest-kds">
          <div class="rest-kds__head">
            <div class="rest-kds__head-left">
              <i class="fa-solid fa-display"></i>
              <strong>KDS — Line Status</strong>
            </div>
            <span class="rest-kds__head-sub">Tickets auto-advance: New → Prep → Expo → Ready</span>
          </div>
          <div class="rest-kds__grid">
            <div class="rest-kds__col" data-col="new">
              <div class="rest-kds__col-head rest-kds__col-head--new"><span class="rest-kds__dot"></span> NEW</div>
              <div class="rest-ticket" data-ticket-id="#1047">
                <div class="rest-ticket__meta"><span>#1047</span><span class="rest-ticket__pill new">NEW</span></div>
                <ul><li>Smash Burger x2</li><li>Fries</li><li>Vanilla Shake</li></ul>
                <div class="rest-ticket__note"><i class="fa-solid fa-circle-info"></i> No onions</div>
              </div>
              <div class="rest-ticket" data-ticket-id="#1048">
                <div class="rest-ticket__meta"><span>#1048</span><span class="rest-ticket__pill new">NEW</span></div>
                <ul><li>Neapolitan 16"</li><li>Arugula Salad</li></ul>
              </div>
              <div class="rest-ticket" data-ticket-id="#1049">
                <div class="rest-ticket__meta"><span>#1049</span><span class="rest-ticket__pill new">NEW</span></div>
                <ul><li>Oat Latte 16oz</li><li>Blueberry Muffin</li></ul>
              </div>
              <div class="rest-ticket" data-ticket-id="#1050">
                <div class="rest-ticket__meta"><span>#1050</span><span class="rest-ticket__pill new">NEW</span></div>
                <ul><li>Spicy Ramen</li><li>Gyoza x6</li></ul>
              </div>
            </div>
            <div class="rest-kds__col" data-col="prep">
              <div class="rest-kds__col-head rest-kds__col-head--prep"><span class="rest-kds__dot"></span> PREP</div>
            </div>
            <div class="rest-kds__col" data-col="expo">
              <div class="rest-kds__col-head rest-kds__col-head--expo"><span class="rest-kds__dot"></span> EXPO</div>
            </div>
            <div class="rest-kds__col" data-col="ready">
              <div class="rest-kds__col-head rest-kds__col-head--ready"><span class="rest-kds__dot"></span> READY</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rest-section">
      <div class="rest-container">
        <div class="rest-section-hdr">
          <span class="rest-section-pill"><i class="fa-solid fa-server"></i> Hardware</span>
          <h2>Hardware for Every Station</h2>
          <p>From the host stand to the kitchen line — purpose-built hardware that works as one system.</p>
        </div>

        <div class="rest-hw-grid">
          <div class="rest-hw">
            <div class="rest-hw__img"><img src="/images/payskiosk.png" alt="Self Order Kiosk" /></div>
            <h3>Self-Order Kiosk</h3>
            <p>Reduce wait times with intuitive self-service ordering for guests.</p>
          </div>
          <div class="rest-hw">
            <div class="rest-hw__img"><img src="/images/Pos system.png" alt="POS Terminal" /></div>
            <h3>POS Terminal</h3>
            <p>Reliable countertop system with fast payment processing and order management.</p>
          </div>
          <div class="rest-hw">
            <div class="rest-hw__img"><img src="/images/handheld pos.png" alt="Handheld POS" /></div>
            <h3>Handheld POS</h3>
            <p>Mobile order and pay for tableside service and busy environments.</p>
          </div>
          <div class="rest-hw">
            <div class="rest-hw__img"><img src="/images/cash_drawer.png" alt="Cash Drawer" /></div>
            <h3>Cash Drawer</h3>
            <p>Secure cash management with durable construction and seamless POS integration.</p>
          </div>
          <div class="rest-hw">
            <div class="rest-hw__img"><img src="/images/Kitchen-printer.png" alt="Kitchen Printer" /></div>
            <h3>Kitchen Printer</h3>
            <p>High-speed thermal printer for reliable kitchen order tickets.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="rest-section rest-testi-section">
      <div class="rest-container">
        <div class="rest-section-hdr">
          <span class="rest-section-pill"><i class="fa-solid fa-quote-left"></i> Customer Stories</span>
          <h2>What Restaurant Owners Say</h2>
        </div>

        <div class="rest-testi-grid">
          <div class="rest-testi">
            <div class="rest-testi__stars">
              <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star-half-stroke"></i>
            </div>
            <p class="rest-testi__quote">"QR pay cut our table turns by 9 minutes. Tips are up and the line finally moves the way it should."</p>
            <div class="rest-testi__author">
              <div class="rest-testi__avatar">JD</div>
              <div>
                <strong>Jasmine Diaz</strong>
                <span>Owner, Ember Taqueria</span>
              </div>
            </div>
          </div>
          <div class="rest-testi">
            <div class="rest-testi__stars">
              <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
            </div>
            <p class="rest-testi__quote">"KDS routing cut remake waste in half. Closing shifts are finally manageable, and the kitchen runs smoother than ever."</p>
            <div class="rest-testi__author">
              <div class="rest-testi__avatar">RL</div>
              <div>
                <strong>Ramon Lee</strong>
                <span>GM, Noodle Lab</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rest-cta-band">
      <div class="rest-container rest-cta-band__inner">
        <h3>Let's get every ticket out hot.</h3>
        <p>Launch online ordering and QR pay today. Install KDS this week. We'll migrate your menu and train your crew.</p>
        <button class="rest-btn-primary" type="button" onclick="openDemo()">
          <i class="fa-solid fa-calendar-check"></i> Get a Demo
        </button>
      </div>
    </section>

    <div class="rest-float-cta">
      <button class="rest-btn-primary rest-btn-pill" type="button" onclick="openDemo()">
        <i class="fa-solid fa-utensils"></i> Book a Demo
      </button>
    </div>

    <div class="rest-demo-backdrop" id="demoBackdrop" aria-hidden="true">
      <div class="rest-demo-modal" role="dialog" aria-modal="true" aria-labelledby="demoTitle">
        <div class="rest-demo-head">
          <h3 id="demoTitle"><i class="fa-solid fa-utensils"></i> Book a Restaurant Demo</h3>
          <button class="rest-demo-close" aria-label="Close demo form" type="button" onclick="closeDemo()">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div class="rest-demo-body">
          <div class="rest-demo-grid">
            <div class="rest-demo-card">
              <h4><i class="fa-solid fa-clipboard-check"></i> Tell us about your concept</h4>

              <form
                id="demoForm"
                class="rest-demo-form"
                novalidate
                action="https://formspree.io/f/mkgqbwvd"
                method="POST"
              >
                <div class="rest-demo-row">
                  <div>
                    <label for="rest-name">Full Name</label>
                    <input required name="name" id="rest-name" placeholder="Jane Doe" />
                  </div>
                  <div>
                    <label for="rest-business">Restaurant</label>
                    <input required name="business" id="rest-business" placeholder="Ember Taqueria" />
                  </div>
                </div>

                <div class="rest-demo-row">
                  <div>
                    <label for="rest-phone">Phone</label>
                    <input required name="phone" id="rest-phone" inputmode="tel" placeholder="(555) 555-5555" />
                  </div>
                  <div>
                    <label for="rest-email">Email</label>
                    <input required name="email" id="rest-email" type="email" placeholder="you@domain.com" />
                  </div>
                </div>

                <div class="rest-demo-row">
                  <div>
                    <label for="rest-city">Location</label>
                    <input name="city" id="rest-city" placeholder="City, State" />
                  </div>
                  <div>
                    <label for="rest-time">Best Contact Time</label>
                    <select name="time" id="rest-time">
                      <option value="">Select…</option>
                      <option>Morning</option>
                      <option>Afternoon</option>
                      <option>Evening</option>
                    </select>
                  </div>
                </div>

                <label>What do you want to see?</label>
                <div class="rest-demo-row rest-demo-checks">
