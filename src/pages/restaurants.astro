---
import Landing from '../components/Landing.astro';
import FormExtras from '../components/FormExtras.astro';
import KdsDemo from '../components/demos/KdsDemo.astro';

const features = [
  { title: 'Online ordering and pickup', body: 'Branded web ordering with throttling, curbside pickup, DoorDash Drive hand-offs and smart upsells per item.' },
  { title: 'QR menus and pay at the table', body: 'Guests scan, order, split and tip without waiting. Servers focus on hospitality, not hand terminals.' },
  { title: 'Kitchen display', body: 'Route tickets by station with hold and fire and make-time tracking. Colour states keep the line moving.' },
  { title: 'Cash Discount Pro', body: 'Offer a cash discount to offset card fees, with pricing that adjusts automatically.' },
  { title: 'Inventory and recipes', body: 'Recipe costs, theoretical versus actual usage, low-stock alerts and invoice scanning.' },
  { title: 'Delivery integrations', body: 'DoorDash, Uber Eats and other delivery services, with every order managed in one place.' },
];
const gear = [
  { name: 'POS terminal', note: 'Countertop system for fast payments and order management.', img: '/images/hw/pos-terminal.webp', href: '/pays-pos' },
  { name: 'Handheld POS', note: 'Order and pay at the table or in the line.', img: '/images/hw/handheld.webp', href: '/pays-pos' },
  { name: 'Self-order kiosk', note: 'Self-service ordering that shortens the wait.', img: '/images/hw/kiosk.webp', href: '/pays-pos' },
  { name: 'Kitchen printer', note: 'High-speed thermal tickets for the line.', img: '/images/hw/kitchen-printer.webp' },
  { name: 'Cash drawer', note: 'Durable cash management that connects to the POS.', img: '/images/hw/cash-drawer.webp' },
  { name: 'Forge Restaurant', note: 'Our own restaurant POS. Coming soon, now booking early access.', href: '/forge' },
];
---

<Landing
  title="Restaurant POS, online ordering and payments | PPD Technology"
  description="Online ordering, QR pay, kitchen display and payments for restaurants, set up and supported by PPD Technology."
  accent={{ rgb: '255, 106, 0', main: '#ff6a00', soft: '#ffb057' }}
  eyebrow="Restaurants"
  headline={['Serve faster.', 'Run it all on one system.']}
  lede="Online ordering, QR pay, kitchen display and next-day funding options. Everything your restaurant needs, set up and supported by one team."
  cta={[{ label: 'Book a demo', href: '#demo' }, { label: 'Free rate review', href: '/rate-review' }]}
  chips={['Dine-in', 'Takeout', 'Delivery', 'Fast casual', 'Food trucks']}
  statement="Counter, table, website or delivery app: every order lands in one place, and every ticket reaches the right station."
  featuresHead={{ eyebrow: 'What you get', title: 'Front of house to back of house.' }}
  features={features}
  gear={{ eyebrow: 'Hardware', title: 'Hardware for every station.', items: gear }}
  form={{ tag: 'restaurants-demo', subject: 'New Restaurants Demo Request', title: 'Let’s get every ticket out hot.', lede: 'Tell us about your concept. We will walk you through ordering, the kitchen display and the hardware that fits, then migrate your menu and train your crew.' }}
>
  <div class="photos" slot="visual" aria-hidden="true">
    {[1, 2, 3, 4].map((n) => <img src={`/images/restaurant/hero-${n}.webp`} alt="" width="1024" height="1024" loading={n === 1 ? 'eager' : 'lazy'} style={`--n:${n - 1}`} />)}
  </div>

  <section class="section" slot="demo">
    <div class="wrap demo-block">
      <div class="section-head">
        <p class="eyebrow reveal">Kitchen display</p>
        <h2 class="h-1 reveal" style="--i:1">From tap to ticket.</h2>
      </div>
      <div class="demo-block__stage reveal"><KdsDemo /></div>
    </div>
  </section>

  <Fragment slot="fields">
    <FormExtras id="rest" city time topics={['QR menus and pay', 'Kitchen display', 'Online ordering', 'Inventory and recipes']} />
  </Fragment>
</Landing>

<style>
  .photos {
    position: relative;
    width: 100%;
    aspect-ratio: 1.08;
    border-radius: 26px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 40px 80px -40px rgba(255, 106, 0, 0.6);
  }
  .photos img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
    opacity: 0;
    animation: photo 20s linear infinite;
    animation-delay: calc(var(--n) * 5s);
  }
  @keyframes photo {
    0% {
      opacity: 0;
      transform: scale(1.06);
    }
    4%,
    25% {
      opacity: 1;
    }
    30%,
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .photos img {
      animation: none;
    }
    .photos img:first-child {
      opacity: 1;
    }
  }
</style>
