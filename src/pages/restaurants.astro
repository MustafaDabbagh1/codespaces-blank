  <script is:inline>
    // @ts-nocheck
    (() => {
      const slides = [...document.querySelectorAll('.rest-slide')];
      let si = 0;

      if (slides.length > 1) {
        setInterval(() => {
          slides[si]?.classList.remove('active');
          si = (si + 1) % slides.length;
          slides[si]?.classList.add('active');
        }, 3200);
      }

      document.querySelectorAll('.rest-item-card').forEach((card) => {
        const base = parseFloat(card.dataset.base || '0');
        const priceEl = card.querySelector('.rest-price-val');
        const chips = [...card.querySelectorAll('.rest-chip-mod')];

        function update() {
          const groups = {};
          chips.forEach((c) => {
            const g = c.dataset.group;
            if (g) {
              groups[g] = groups[g] || [];
              if (c.classList.contains('active')) groups[g].push(parseFloat(c.dataset.delta || '0'));
            }
          });

          let total = base;
          Object.values(groups).forEach((arr) => {
            total += arr[0] ?? 0;
          });

          chips.forEach((c) => {
            if (!c.dataset.group && c.classList.contains('active')) {
              total += parseFloat(c.dataset.delta || '0');
            }
          });

          if (priceEl) priceEl.textContent = total.toFixed(2);
        }

        chips.forEach((c) => {
          c.addEventListener('click', () => {
            const g = c.dataset.group;
            if (g) {
              chips.filter((x) => x.dataset.group === g).forEach((x) => x.classList.remove('active'));
              c.classList.add('active');
            } else {
              c.classList.toggle('active');
            }
            update();
          });
        });

        const groupsInit = new Set(chips.filter((c) => c.dataset.group).map((c) => c.dataset.group));
        groupsInit.forEach((g) => {
          const first = chips.find((c) => c.dataset.group === g);
          if (first) first.classList.add('active');
        });

        update();
      });

      const kcols = {
        new: document.querySelector('.rest-kcol[data-col="new"]'),
        prep: document.querySelector('.rest-kcol[data-col="prep"]'),
        expo: document.querySelector('.rest-kcol[data-col="expo"]'),
        ready: document.querySelector('.rest-kcol[data-col="ready"]')
      };

      const readyTimestamps = new Map();

      function setPill(ticket, state) {
        const pill = ticket.querySelector('.rest-pill');
        if (!pill) return;
        pill.className = `rest-pill ${state}`;
        pill.textContent = state.toUpperCase();
      }

      function clearOldReadyTickets() {
        const now = Date.now();
        const readyTickets = kcols.ready?.querySelectorAll('.rest-ticket') || [];
        readyTickets.forEach((ticket) => {
          const id = ticket.getAttribute('data-ticket-id') || '';
          const t = readyTimestamps.get(id);
          if (t && now - t > 5000) {
            ticket.style.animation = 'rest-pop 0.35s ease reverse';
            setTimeout(() => {
              ticket.remove();
              readyTimestamps.delete(id);
            }, 300);
          }
        });
      }

      function makeTicket(id, items) {
        const el = document.createElement('div');
        el.className = 'rest-ticket';
        el.setAttribute('data-ticket-id', id);
        el.innerHTML = `
          <div class="meta">
            <span>${id}</span>
            <span class="rest-pill new">NEW</span>
          </div>
          <ul>${items.map((i) => `<li>${i}</li>`).join('')}</ul>
        `;
        return el;
      }

      if (kcols.new && kcols.prep && kcols.expo && kcols.ready) {
        function advance() {
          clearOldReadyTickets();

          const expo = kcols.expo.querySelector('.rest-ticket');
          if (expo) {
            const id = expo.getAttribute('data-ticket-id') || '';
            setPill(expo, 'ready');
            kcols.ready.appendChild(expo);
            readyTimestamps.set(id, Date.now());
            return;
          }

          const prep = kcols.prep.querySelector('.rest-ticket');
          if (prep) {
            setPill(prep, 'expo');
            kcols.expo.appendChild(prep);
            return;
          }

          const nw = kcols.new.querySelector('.rest-ticket');
          if (nw) {
            setPill(nw, 'prep');
            kcols.prep.appendChild(nw);
            return;
          }

          if (Math.random() > 0.7) {
            const id = '#' + (1050 + Math.floor(Math.random() * 50)).toString();
            const menuItems = [
              ['QR Table ' + (Math.floor(Math.random() * 10) + 1) + ' — Nachos', '2x House Marg'],
              ['Breakfast Burrito', 'Coffee'],
              ['Caesar Salad', 'Garlic Bread'],
              ['Fish Tacos x3', 'Lime Wedge'],
              ['Vegan Bowl', 'Green Tea'],
              ['Steak Frites', 'House Red']
            ];
            const items = menuItems[Math.floor(Math.random() * menuItems.length)];
            kcols.new.appendChild(makeTicket(id, items));
          }
        }

        setInterval(advance, 1800);
        setInterval(clearOldReadyTickets, 1000);
      }

      const backdrop = document.getElementById('demoBackdrop');
      const demoForm = document.getElementById('demoForm');
      const toast = document.getElementById('toast');
      let lastFocused;

      function trapFocus(e) {
        const focusables = backdrop?.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        const list = Array.from(focusables || []).filter((el) => !el.disabled && el.offsetParent !== null);
        if (list.length === 0) return;

        const first = list[0];
        const last = list[list.length - 1];

        if (e.key === 'Tab') {
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }

        if (e.key === 'Escape') {
          window.closeDemo();
        }
      }

      window.openDemo = function () {
        lastFocused = document.activeElement;
        backdrop?.classList.add('active');
        backdrop?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        const firstInput = backdrop?.querySelector('input, select, textarea, button');
        firstInput?.focus();
        document.addEventListener('keydown', trapFocus);
      };

      window.closeDemo = function () {
        backdrop?.classList.remove('active');
        backdrop?.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = 'auto';
        document.removeEventListener('keydown', trapFocus);
        lastFocused?.focus?.();
      };

      backdrop?.addEventListener('click', (e) => {
        if (e.target === backdrop) window.closeDemo();
      });

      demoForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(demoForm).entries());

        if (!data.name || !data.business || !data.phone || !data.email) {
          alert('Please fill name, restaurant, phone, and email.');
          return;
        }

        try {
          const res = await fetch(demoForm.action, {
            method: demoForm.method || 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(demoForm)
          });

          if (res.ok) {
            window.closeDemo();
            demoForm.reset();
            toast?.classList.add('show');
            setTimeout(() => toast?.classList.remove('show'), 2400);
          } else {
            alert('There was a problem submitting the form. Please try again.');
          }
        } catch {
          alert('Network error submitting the form. Please try again.');
        }
      });

      const params = new URLSearchParams(location.search);
      if (params.get('demo') === '1') {
        window.openDemo();
      }
    })();
  </script>
</BaseLayout>