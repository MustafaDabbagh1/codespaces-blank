    }

    .rest-demo-card h4{
      font-size:14px;color:#E2E8F0;margin:0 0 12px;
    }
    .rest-demo-card h4 i{color:#00CFFF;margin-right:6px}

    .rest-demo-form label{
      font-weight:600;font-size:12px;color:#5E7A9A;display:block;
