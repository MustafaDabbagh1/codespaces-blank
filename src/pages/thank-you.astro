---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Thank You | PPD Technology" description="Your message has been received. We'll be in touch shortly.">
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
  </Fragment>

  <section class="ty-page">
    <div class="ty-orb ty-orb--1"></div>
    <div class="ty-orb ty-orb--2"></div>

    <div class="ty-card">
      <div class="ty-icon"><i class="fa-solid fa-circle-check"></i></div>
      <span class="ty-pill"><i class="fa-solid fa-envelope-circle-check"></i> Message Received</span>
      <h1>Thank you — we got it.</h1>
      <p>
        A PPD Technology specialist will reach out within one business day.
        For urgent items, call <a href="tel:2487260085">(248) 726-0085</a>
        or email <a href="mailto:info@ppdtechnology.com">info@ppdtechnology.com</a>.
      </p>
      <div class="ty-actions">
        <a class="ty-btn ty-btn--primary" href="/"><i class="fa-solid fa-house"></i> Back to Home</a>
        <a class="ty-btn ty-btn--ghost" href="/contact"><i class="fa-solid fa-headset"></i> Contact Us</a>
      </div>
    </div>
  </section>

  <style>
    .ty-page {
      min-height: 70vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 80px 24px;
      background:
        radial-gradient(ellipse 80% 60% at 80% 0%, rgba(0,207,255,.18) 0%, transparent 60%),
        radial-gradient(ellipse 60% 60% at 0% 100%, rgba(21,73,255,.18) 0%, transparent 55%),
        linear-gradient(160deg, #060E21 0%, #0C1A38 60%, #0a1c42 100%);
      color: #fff;
      position: relative;
      overflow: hidden;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }
    .ty-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(110px);
      opacity: .25;
      pointer-events: none;
    }
    .ty-orb--1 { width: 520px; height: 520px; background: #1549FF; top: -180px; right: -120px; }
    .ty-orb--2 { width: 360px; height: 360px; background: #00CFFF; bottom: -120px; left: -100px; }

    .ty-card {
      position: relative;
      z-index: 2;
      max-width: 560px;
      width: 100%;
      text-align: center;
      background: rgba(12, 26, 56, .6);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 20px;
      padding: 56px 32px 40px;
      backdrop-filter: blur(20px);
      box-shadow: 0 30px 80px rgba(0,0,0,.4);
    }
    .ty-icon {
      width: 84px;
      height: 84px;
      margin: 0 auto 18px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, rgba(0,207,255,.2), rgba(21,73,255,.25));
      border: 1px solid rgba(0,207,255,.4);
      font-size: 38px;
      color: #00CFFF;
    }
    .ty-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255,255,255,.08);
      border: 1px solid rgba(255,255,255,.15);
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .04em;
      text-transform: uppercase;
      margin-bottom: 14px;
    }
    .ty-pill i { color: #00CFFF; }
    .ty-card h1 {
      font-size: clamp(1.8rem, 4vw, 2.4rem);
      font-weight: 800;
      letter-spacing: -.02em;
      margin: 0 0 12px;
    }
    .ty-card p {
      color: rgba(255,255,255,.78);
      line-height: 1.6;
      margin: 0 0 28px;
    }
    .ty-card a { color: #00CFFF; text-decoration: none; font-weight: 600; }
    .ty-card a:hover { text-decoration: underline; }
    .ty-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
    }
    .ty-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 22px;
      border-radius: 999px;
      font-weight: 700;
      font-size: 14px;
      text-decoration: none;
      transition: all .25s;
    }
    .ty-btn--primary {
      background: linear-gradient(135deg, #1549FF, #00CFFF);
      color: #fff;
      box-shadow: 0 10px 30px rgba(21,73,255,.4);
    }
    .ty-btn--primary:hover { transform: translateY(-2px); color: #fff; text-decoration: none; }
    .ty-btn--ghost {
      background: rgba(255,255,255,.06);
      color: #fff;
      border: 1px solid rgba(255,255,255,.18);
    }
    .ty-btn--ghost:hover { background: rgba(255,255,255,.12); color: #fff; text-decoration: none; }
  </style>
</BaseLayout>
