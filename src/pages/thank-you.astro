---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { company } from '../data/site';
---

<SiteLayout title="Thank you | PPD Technology" description="We received your message. A PPD Technology specialist will reach out within one business day.">
  <meta name="robots" content="noindex" slot="head" />
  <section class="ty">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="wrap ty__inner">
      <span class="ty__check" aria-hidden="true"><Icon name="check" size={34} stroke={2.6} /></span>
      <p class="eyebrow eyebrow--plain">Message received</p>
      <h1 class="h-1">Thank you. We got it.</h1>
      <p class="lede">
        A PPD Technology specialist will reach out within one business day. For anything urgent, call
        <a href={`tel:${company.salesTel}`}>{company.salesPhone}</a> or email
        <a href={`mailto:${company.email}`}>{company.email}</a>.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Back to home <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost" href="/products">See the products</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .ty {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 70vh;
    padding: clamp(64px, 10vw, 140px) 0;
    overflow: hidden;
  }
  .ty__inner {
    position: relative;
    display: grid;
    gap: 22px;
    justify-items: center;
    text-align: center;
  }
  .ty__check {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    color: #062b1b;
    background: var(--ok);
    box-shadow: 0 0 0 14px rgba(46, 211, 160, 0.14);
    animation: ty-pop 0.7s var(--spring) both;
  }
  .ty .lede a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ty .btn-row {
    justify-content: center;
  }
  @keyframes ty-pop {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }
</style>
