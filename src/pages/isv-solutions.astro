---
import Landing from '../components/Landing.astro';
import FormExtras from '../components/FormExtras.astro';
import Icon from '../components/Icon.astro';

const features = [
  { title: 'Embed payments into your platform', body: 'Card-present, card-not-present, recurring, invoice and online payment flows inside your own software.' },
  { title: 'Build the software with us', body: 'If you have the niche, the relationships and the sales motion but not the full product team, we can help scope, design and build it.' },
  { title: 'Monetize beyond subscriptions', body: 'Revenue from processing, software fees, setup fees, premium modules and long-term merchant retention.' },
  { title: 'Launch with a sales engine', body: 'Landing pages, merchant acquisition funnels, sales materials, onboarding flows and positioning for your vertical.' },
];
const pathA = ['Embedded payment integration', 'Gateway and processor setup', 'Merchant onboarding flow', 'Terminal and device options', 'Recurring billing and invoices', 'Reporting and reconciliation support', 'Revenue share strategy', 'Developer and integration support'];
const pathB = ['Product strategy and scope', 'UI and UX design', 'Custom vertical software buildout', 'Payment workflow planning', 'Merchant dashboard', 'Admin portal', 'Branded experience', 'Launch and sales support'];
const steps = [
  { t: 'Find the vertical', b: 'We identify the merchant niche, workflow, pain points and revenue opportunity.' },
  { t: 'Map the product', b: 'We define the features, payment flows, merchant dashboard, admin tools and launch plan.' },
  { t: 'Build the platform', b: 'We help create the branded software experience, payment workflows, CRM tools and reporting.' },
  { t: 'Launch with payments', b: 'We connect the payment stack, onboarding process, devices, processing and merchant support.' },
  { t: 'Sell and scale', b: 'You focus on merchant acquisition, demos, referrals and expanding the vertical.' },
];
const faqs = [
  { q: 'Do I need to already have software?', a: 'No. If you already have software, we can help with payment integration and monetization. If you do not, PPD Technology can help scope and build a platform around your vertical.' },
  { q: 'Can PPD build the software for my ISV company?', a: 'Yes. For the right partner and market, we can help design and build a branded software platform with payments built into the workflow.' },
  { q: 'Can the software be branded as my company?', a: 'Yes. Branding, co-branding or white-label style options may be available depending on the project structure.' },
  { q: 'How do ISVs make money with payments?', a: 'From processing volume, software fees, setup or implementation fees, premium modules and long-term merchant retention.' },
  { q: 'Can we support in-person devices?', a: 'Yes. Device and terminal options can be part of the payment strategy, depending on the vertical and integration.' },
  { q: 'What if my software is already built?', a: 'We can review the current payment flow, identify integration options, improve onboarding and plan how to monetize payments.' },
  { q: 'How long does it take to launch?', a: 'It depends on whether you already have software, the complexity of the payment workflow and the custom features needed. The first step is a strategy call to map the best path.' },
];
---

<Landing
  title="ISV Solutions | Embedded payments and build-for-you software | PPD Technology"
  description="Already have software? PPD helps you embed payments and monetize every transaction. Need software built? PPD can help build the platform so you can focus on selling."
  accent={{ rgb: '124, 77, 255', main: '#7c4dff', soft: '#b9a0ff' }}
  eyebrow="ISV solutions"
  headline={['Payments, software and', 'launch support for ISVs.']}
  lede="Already have software? We help you embed payments and monetize every transaction. Need software built? We can help build the platform so you can focus on selling."
  cta={[{ label: 'Book an ISV strategy call', href: '#demo' }, { label: 'Estimate the revenue', href: '#estimator' }]}
  chips={['Embedded payments', 'Merchant onboarding', 'Build-for-you software', 'White-label options', 'Go-to-market support']}
  statement="Most providers give ISVs payment APIs and a partner agreement. We can help with the software, the payments, the onboarding and the selling system behind it."
  featuresHead={{ eyebrow: 'Why PPD for ISVs', title: 'More than a payment integration.' }}
  features={features}
  faqs={faqs}
  form={{ tag: 'isv-strategy-call', subject: 'New ISV Strategy Call Request', title: 'Ready to build, embed or monetize payments?', lede: 'Tell us what you are building, who you sell to, and whether you already have software. We will help you map the right path.', cta: 'Book a strategy call' }}
>
  <Fragment slot="demo">
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow reveal">Choose your path</p>
          <h2 class="h-1 reveal" style="--i:1">Whether you have software or just the market, we can help.</h2>
        </div>
        <div class="paths">
          <div class="paths__col reveal">
            <p class="mono">Path A</p>
            <h3>I already have software.</h3>
            <ul>{pathA.map((x) => <li><Icon name="check" size={16} stroke={2.6} /> {x}</li>)}</ul>
          </div>
          <div class="paths__col paths__col--b frame reveal" style="--i:1">
            <p class="mono">Path B</p>
            <h3>I need software built.</h3>
            <ul>{pathB.map((x) => <li><Icon name="check" size={16} stroke={2.6} /> {x}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>
  </Fragment>

  <Fragment slot="extra">
    <section class="section section--raised">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow reveal">Build-for-you software</p>
          <h2 class="h-1 reveal" style="--i:1">You sell the market. We help build the software.</h2>
        </div>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li class="reveal" style={`--i:${i}`}>
                <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                <b>{s.t}</b>
                <p>{s.b}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section" id="estimator">
      <div class="wrap est">
        <div>
          <p class="eyebrow reveal">Monetize payments</p>
          <h2 class="h-1 reveal" style="--i:1">Turn payments into a real revenue stream.</h2>
          <p class="lede reveal" style="--i:2">Subscriptions are one line. Processing, software fees and implementation fees are three more, and payments make the software harder to leave.</p>
        </div>
        <div class="est__card frame reveal" style="--i:1" data-estimator>
          <div class="est__inputs">
            <label>Active merchants <input type="number" min="0" step="1" value="50" data-k="merchants" /></label>
            <label>Monthly volume per merchant ($) <input type="number" min="0" step="1000" value="25000" data-k="volume" /></label>
            <label>Software fee per merchant ($ / mo) <input type="number" min="0" step="1" value="49" data-k="fee" /></label>
            <label>Estimated payment margin (%) <input type="number" min="0" step="0.05" value="0.5" data-k="margin" /></label>
          </div>
          <dl>
            <div><dt>Processing revenue / mo</dt><dd data-o="processing">$6,250</dd></div>
            <div><dt>Software revenue / mo</dt><dd data-o="software">$2,450</dd></div>
            <div class="est__total"><dt>Estimated monthly revenue</dt><dd data-o="monthly">$8,700</dd></div>
            <div><dt>Estimated annual revenue</dt><dd data-o="annual">$104,400</dd></div>
          </dl>
          <p class="fine">Illustrative estimate only. Actual revenue depends on your pricing, program and processing terms.</p>
        </div>
      </div>
    </section>
  </Fragment>

  <Fragment slot="fields">
    <FormExtras id="isv" select={{ name: 'software_status', label: 'Where are you today?', options: ['I already have software', 'I need software built', 'Somewhere in between'] }} />
  </Fragment>
</Landing>

<script>
  document.querySelectorAll<HTMLElement>('[data-estimator]').forEach((root) => {
    const money = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    const get = (k: string) => Math.max(0, parseFloat(root.querySelector<HTMLInputElement>(`[data-k="${k}"]`)?.value || '0') || 0);
    const set = (k: string, v: number) => {
      const el = root.querySelector(`[data-o="${k}"]`);
      if (el) el.textContent = money(v);
    };
    const run = () => {
      const processing = (get('merchants') * get('volume') * get('margin')) / 100;
      const software = get('merchants') * get('fee');
      set('processing', processing);
      set('software', software);
      set('monthly', processing + software);
      set('annual', (processing + software) * 12);
    };
    root.addEventListener('input', run);
    run();
  });
</script>

<style>
  .paths {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(14px, 2vw, 26px);
  }
  .paths__col {
    padding: clamp(24px, 3.4vw, 44px);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
  }
  .paths__col--b {
    border-radius: 0;
    border-color: transparent;
    background: rgba(124, 77, 255, 0.14);
  }
  .paths .mono {
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-2);
  }
  .paths h3 {
    margin: 10px 0 20px;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
  }
  .paths ul {
    display: grid;
    gap: 11px;
  }
  .paths li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .paths li :global(svg) {
    flex-shrink: 0;
    margin-top: 5px;
    color: var(--accent-2);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border-top: 1px solid var(--line-2);
  }
  .steps li {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 22px 20px 0 0;
  }
  .steps .mono {
    font-size: 0.74rem;
    color: var(--accent-2);
  }
  .steps b {
    font-family: var(--font-display);
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }
  .steps p {
    font-size: 0.93rem;
    color: var(--muted);
  }
  .est {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }
  .est > div:first-child {
    display: grid;
    gap: 20px;
  }
  .est__card {
    display: grid;
    gap: 22px;
    padding: clamp(24px, 3.4vw, 44px);
    background: rgba(124, 77, 255, 0.1);
  }
  .est__inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .est__inputs label {
    display: grid;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
  }
  .est__inputs input {
    min-height: 46px;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--line-2);
    background: rgba(255, 255, 255, 0.05);
    color: inherit;
    font: inherit;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }
  .est__inputs input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .est dl {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .est dl div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .est dt {
    color: var(--muted);
  }
  .est dd {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .est__total dd {
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    color: var(--accent-2);
  }
  @media (max-width: 900px) {
    .paths,
    .est {
      grid-template-columns: 1fr;
    }
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .steps,
    .est__inputs {
      grid-template-columns: 1fr;
    }
  }
</style>
