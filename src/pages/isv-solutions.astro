    .isv-vert{background:#fff;border:1px solid var(--border);border-radius:var(--r-xl);box-shadow:var(--shadow-md);overflow:hidden}
    .isv-vert-tabs{display:flex;flex-wrap:wrap;gap:8px;padding:18px;background:var(--surface-2);border-bottom:1px solid var(--border)}
    .isv-vert-tab{display:inline-flex;align-items:center;gap:8px;font-size:13.5px;font-weight:700;color:var(--text-2);background:#fff;border:1px solid var(--border);border-radius:var(--r-pill);padding:9px 16px;cursor:pointer;transition:all .2s ease}
    .isv-vert-tab i{font-size:12px;color:var(--blue)}
    .isv-vert-tab:hover{border-color:var(--blue);color:var(--text-1)}
    .isv-vert-tab.active{background:linear-gradient(135deg,var(--blue-mid),var(--blue));color:#fff;border-color:transparent;box-shadow:var(--shadow-blue)}
    .isv-vert-tab.active i{color:#fff}
    .isv-vert-panel{padding:28px}
    .isv-vert-panel-head{display:flex;align-items:center;gap:16px;margin-bottom:20px}
    .isv-vert-ico{width:54px;height:54px;flex:none;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;color:#fff;background:linear-gradient(135deg,var(--blue),var(--cyan));box-shadow:0 8px 22px rgba(21,73,255,.3)}
    .isv-vert-panel-head h3{font-size:20px;font-weight:900;color:var(--text-1);margin:0 0 3px}
    .isv-vert-panel-head p{font-size:13px;color:var(--text-3);margin:0}
    .isv-vert-modules{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
    .isv-vert-modules :global(li){display:flex;align-items:center;gap:9px;font-size:14px;font-weight:600;color:var(--text-1);background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px 12px}
    .isv-vert-modules :global(li i){color:var(--green);font-size:13px}

    /* ---------- Monetization calculator ---------- */
    .isv-calc{margin-top:36px;display:grid;grid-template-columns:1fr 1fr;gap:0;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.12);border-radius:var(--r-xl);overflow:hidden}
    .isv-calc-inputs{padding:28px;display:grid;gap:16px;align-content:start;border-right:1px solid rgba(255,255,255,.1)}
    .isv-calc-tag{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--cyan)}
    .isv-calc-field{display:grid;gap:7px}
    .isv-calc-field span{font-size:13px;font-weight:600;color:rgba(255,255,255,.8)}
    .isv-calc-field input{
      font-size:15px;font-weight:700;color:#fff;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);
      border-radius:10px;padding:11px 13px;width:100%;transition:border .2s ease}
    .isv-calc-field input:focus{outline:none;border-color:var(--cyan);background:rgba(255,255,255,.1)}
    .isv-calc-out{padding:28px;background:linear-gradient(180deg,rgba(21,73,255,.18),rgba(0,207,255,.06));display:flex;flex-direction:column;justify-content:center;gap:14px}
    .isv-calc-out-row{display:flex;justify-content:space-between;align-items:center;font-size:14px;color:rgba(255,255,255,.8)}
    .isv-calc-out-row strong{font-size:16px;font-weight:800;color:#fff}
    .isv-calc-out-total{display:flex;justify-content:space-between;align-items:center;padding-top:14px;margin-top:4px;border-top:1px solid rgba(255,255,255,.14)}
    .isv-calc-out-total span{font-size:14px;font-weight:700;color:rgba(255,255,255,.9)}
    .isv-calc-out-total strong{font-size:28px;font-weight:900;background:linear-gradient(120deg,var(--cyan),#9b8cff);-webkit-background-clip:text;background-clip:text;color:transparent}
    .isv-calc-out-annual{display:flex;justify-content:space-between;align-items:center;font-size:13px;color:rgba(255,255,255,.7)}
    .isv-calc-out-annual strong{font-size:16px;color:var(--green)}
    .isv-calc-note{font-size:11px;color:rgba(255,255,255,.5);margin:6px 0 0;line-height:1.5}

    /* ---------- Go-to-market ---------- */
    .isv-gtm-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}
    .isv-gtm{display:flex;flex-direction:column;gap:12px;background:#fff;border:1px solid var(--border);border-radius:14px;padding:20px 16px;font-size:14px;font-weight:700;color:var(--text-1);box-shadow:var(--shadow-xs);transition:transform .2s ease,box-shadow .2s ease}
    .isv-gtm:hover{transform:translateY(-5px);box-shadow:var(--shadow-md)}
    .isv-gtm i{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:16px;color:#fff;background:linear-gradient(135deg,var(--blue-mid),var(--cyan))}

    /* ---------- Onboarding + security ---------- */
    .isv-sec-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    .isv-sec{display:flex;align-items:center;gap:13px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:18px;font-size:14.5px;font-weight:600;color:rgba(255,255,255,.9)}
    .isv-sec i{width:38px;height:38px;flex:none;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:15px;color:var(--cyan);background:rgba(0,207,255,.12);border:1px solid rgba(0,207,255,.24)}

    /* ---------- FAQ ---------- */
    .isv-faq-wrap{max-width:820px}
    .isv-faq{display:grid;gap:12px}
    .isv-faq-item{background:#fff;border:1px solid var(--border);border-radius:14px;overflow:hidden;transition:box-shadow .2s ease}
    .isv-faq-item[open]{box-shadow:var(--shadow-sm)}
    .isv-faq-item summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:18px 20px;font-size:15.5px;font-weight:700;color:var(--text-1)}
    .isv-faq-item summary::-webkit-details-marker{display:none}
    .isv-faq-item summary i{color:var(--blue);transition:transform .25s ease;font-size:14px}
    .isv-faq-item[open] summary i{transform:rotate(180deg)}
    .isv-faq-a{padding:0 20px 20px;font-size:14.5px;line-height:1.65;color:var(--text-2)}

    /* ---------- Final CTA ---------- */
    .isv-cta{position:relative;padding:var(--section-py) 0;background:linear-gradient(135deg,var(--navy),#0A2B74);color:#fff;overflow:hidden;text-align:center}
    .isv-cta-glow{position:absolute;top:50%;left:50%;width:700px;height:700px;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(0,207,255,.22),transparent 60%);pointer-events:none}
    .isv-cta-inner{position:relative;z-index:1;max-width:720px}
    .isv-cta h2{font-size:clamp(28px,4vw,44px);font-weight:900;letter-spacing:-.02em;margin:0 0 16px}
    .isv-cta p{font-size:17px;line-height:1.6;color:rgba(255,255,255,.8);margin:0 0 30px}
    .isv-cta-actions{display:flex;flex-wrap:wrap;gap:14px;justify-content:center}

    /* ---------- Reveal ---------- */
    .reveal{opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s ease}
    .reveal.is-visible{opacity:1;transform:translateY(0)}

    /* ---------- Responsive ---------- */
    @media (max-width:980px){
      .isv-hero-inner{grid-template-columns:1fr;gap:40px}
      .isv-grid-4{grid-template-columns:1fr 1fr}
      .isv-paths{grid-template-columns:1fr}
      .isv-path--feature{transform:none}
      .isv-build{grid-template-columns:1fr;gap:28px}
      .isv-build-mock{position:static}
      .isv-cap-grid{grid-template-columns:1fr 1fr}
      .isv-vert-modules{grid-template-columns:repeat(3,1fr)}
      .isv-gtm-grid{grid-template-columns:repeat(3,1fr)}
      .isv-sec-grid{grid-template-columns:1fr 1fr}
    }
    @media (max-width:640px){
      .isv-grid-4{grid-template-columns:1fr}
      .isv-hero-actions{flex-direction:column;align-items:stretch}
      .isv-hero-actions .isv-btn{width:100%}
      .isv-dash-stats{grid-template-columns:1fr}
      .isv-cap-grid{grid-template-columns:1fr}
      .isv-vert-modules{grid-template-columns:1fr 1fr}
      .isv-vert-tabs{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch}
      .isv-vert-tab{white-space:nowrap}
      .isv-calc{grid-template-columns:1fr}
      .isv-calc-inputs{border-right:none;border-bottom:1px solid rgba(255,255,255,.1)}
      .isv-gtm-grid{grid-template-columns:1fr 1fr}
      .isv-sec-grid{grid-template-columns:1fr}
      .isv-cta-actions{flex-direction:column}
      .isv-cta-actions .isv-btn{width:100%}
    }
    @media (prefers-reduced-motion:reduce){
      .reveal{opacity:1;transform:none;transition:none}
      .isv-dash-panel{animation:none}
    }
  </style>

  <script>
    // ---- Reveal on scroll ----
    (() => {
      const els = document.querySelectorAll('.isv-page .reveal');
      if (!('IntersectionObserver' in window) || !els.length) {
        els.forEach((el) => el.classList.add('is-visible'));
        return;
      }
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.12 });
      els.forEach((el) => io.observe(el));
    })();

    // ---- Hero dashboard tabs (roving tabindex) ----
    (() => {
      const tabs = Array.from(document.querySelectorAll('.isv-dash-tab[data-isv-tab]'));
      const panels = Array.from(document.querySelectorAll('.isv-dash-panel[data-isv-panel]'));
      if (!tabs.length) return;

      const activate = (key, focus) => {
        tabs.forEach((t) => {
          const on = t.dataset.isvTab === key;
          t.classList.toggle('active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.setAttribute('tabindex', on ? '0' : '-1');
          if (on && focus) t.focus();
        });
        panels.forEach((p) => {
          const on = p.dataset.isvPanel === key;
          p.hidden = !on;
          p.classList.toggle('is-active', on);
        });
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => activate(tab.dataset.isvTab, false));
        tab.addEventListener('keydown', (ev) => {
          if (ev.key === 'ArrowRight' || ev.key === 'ArrowLeft') {
            ev.preventDefault();
            const dir = ev.key === 'ArrowRight' ? 1 : -1;
            const next = tabs[(i + dir + tabs.length) % tabs.length];
            activate(next.dataset.isvTab, true);
          }
        });
      });
    })();

    // ---- Vertical examples tabs ----
    (() => {
      const tabs = Array.from(document.querySelectorAll('.isv-vert-tab[data-isv-vert]'));
      const titleEl = document.querySelector('[data-isv-vert-title]');
      const modulesEl = document.querySelector('[data-isv-vert-modules]');
      const icoEl = document.querySelector('[data-isv-vert-ico]');
      if (!tabs.length || !titleEl || !modulesEl) return;

      const data = {
        restaurants: { label: 'Restaurants', icon: 'fa-utensils', modules: ['Table orders', 'Tips', 'Loyalty', 'Online ordering', 'Staff reports'] },
        repair: { label: 'Repair Shops', icon: 'fa-screwdriver-wrench', modules: ['Repair tickets', 'Device intake', 'Warranty tracking', 'SMS updates', 'Deposits'] },
        retail: { label: 'Retail', icon: 'fa-store', modules: ['Inventory', 'Gift cards', 'Customer profiles', 'Product reporting', 'Checkout'] },
        contractors: { label: 'Contractors', icon: 'fa-helmet-safety', modules: ['Estimates', 'Job deposits', 'Mobile invoices', 'Recurring billing', 'Field payments'] },
        medspas: { label: 'Med Spas', icon: 'fa-spa', modules: ['Packages', 'Memberships', 'Deposits', 'Client profiles', 'Payment plans'] },
        automotive: { label: 'Automotive', icon: 'fa-car', modules: ['Repair orders', 'Parts tracking', 'Invoices', 'Deposits', 'Customer history'] },
        healthcare: { label: 'Healthcare', icon: 'fa-user-doctor', modules: ['Patient payments', 'Payment plans', 'Invoices', 'Recurring billing', 'Reporting'] },
        fitness: { label: 'Fitness', icon: 'fa-dumbbell', modules: ['Memberships', 'Class packages', 'Recurring payments', 'Check-ins', 'Client profiles'] },
        b2b: { label: 'B2B Services', icon: 'fa-briefcase', modules: ['Invoices', 'ACH options', 'Recurring billing', 'Customer accounts', 'Reporting'] },
      };

      const render = (key) => {
        const d = data[key];
        if (!d) return;
        titleEl.textContent = d.label;
        if (icoEl) icoEl.innerHTML = '<i class="fa-solid ' + d.icon + '"></i>';
        modulesEl.innerHTML = d.modules
          .map((m) => '<li><i class="fa-solid fa-check"></i> ' + m + '</li>')
          .join('');
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => {
            const on = t === tab;
            t.classList.toggle('active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
            t.setAttribute('tabindex', on ? '0' : '-1');
          });
          render(tab.dataset.isvVert);
        });
        tab.addEventListener('keydown', (ev) => {
          if (ev.key === 'ArrowRight' || ev.key === 'ArrowLeft') {
            ev.preventDefault();
            const dir = ev.key === 'ArrowRight' ? 1 : -1;
            const next = tabs[(i + dir + tabs.length) % tabs.length];
            next.click();
            next.focus();
          }
        });
      });
    })();

    // ---- Monetization estimator ----
    (() => {
      const merchantsEl = document.getElementById('isvMerchants');
      const volumeEl = document.getElementById('isvVolume');
      const feeEl = document.getElementById('isvFee');
      const marginEl = document.getElementById('isvMargin');
      const outProc = document.getElementById('isvOutProcessing');
      const outSoft = document.getElementById('isvOutSoftware');
      const outMonthly = document.getElementById('isvOutMonthly');
      const outAnnual = document.getElementById('isvOutAnnual');
      if (!merchantsEl || !outMonthly) return;

      const money = (n) => '$' + Math.round(n).toLocaleString('en-US');
      const num = (el) => {
        const v = parseFloat(el.value);
        return Number.isFinite(v) && v > 0 ? v : 0;
      };

      const compute = () => {
        const merchants = num(merchantsEl);
        const volume = num(volumeEl);
        const fee = num(feeEl);
        const margin = num(marginEl);
        const processing = merchants * volume * (margin / 100);
        const software = merchants * fee;
        const monthly = processing + software;
        outProc.textContent = money(processing);
        outSoft.textContent = money(software);
        outMonthly.textContent = money(monthly);
        outAnnual.textContent = money(monthly * 12);
      };

      [merchantsEl, volumeEl, feeEl, marginEl].forEach((el) => el.addEventListener('input', compute));
      compute();
    })();
  </script>
</BaseLayout>
