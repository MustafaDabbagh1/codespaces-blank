---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="ISV Solutions | PPD Technology"
  description="Embedded payments, merchant onboarding, and build-for-you software solutions for ISVs, SaaS companies, and vertical software teams."
>
  <div class="isv-page">

    <!-- ===================== 1. HERO ===================== -->
    <section class="isv-hero">
      <div class="isv-hero-grid" aria-hidden="true"></div>
      <div class="isv-orb isv-orb--1" aria-hidden="true"></div>
      <div class="isv-orb isv-orb--2" aria-hidden="true"></div>

      <div class="container isv-hero-inner">
        <div class="isv-hero-text">
          <span class="isv-badge isv-badge--on-dark"><i class="fa-solid fa-plug-circle-bolt"></i> ISV Solutions</span>
          <h1 class="isv-hero-title">
            Payments, software, and launch support for <span class="isv-grad">ISVs ready to scale.</span>
          </h1>
          <p class="isv-hero-sub">
            Already have software? We'll help you embed payments and monetize every transaction. Need software built?
            PPD Technology can help build the platform so you can focus on selling.
          </p>
          <p class="isv-hero-support">
            From payment integration and merchant onboarding to branded software, reporting, and go-to-market support,
            we help ISV companies turn payment processing into a stronger revenue engine.
          </p>

          <div class="isv-hero-actions">
            <a class="isv-btn isv-btn-primary isv-btn-lg" href="/contact">
              <i class="fa-solid fa-calendar-check"></i> Book an ISV Strategy Call
            </a>
            <a class="isv-btn isv-btn-ghost isv-btn-lg" href="#build">
              <i class="fa-solid fa-cubes"></i> Explore Build-for-You Software
            </a>
          </div>

          <ul class="isv-chips" aria-label="What PPD offers ISVs">
            <li><i class="fa-solid fa-bolt"></i> Embedded payments</li>
            <li><i class="fa-solid fa-user-check"></i> Merchant onboarding</li>
            <li><i class="fa-solid fa-screwdriver-wrench"></i> Build-for-you software</li>
            <li><i class="fa-solid fa-tags"></i> White-label options</li>
            <li><i class="fa-solid fa-coins"></i> Software fees + processing</li>
            <li><i class="fa-solid fa-rocket"></i> Go-to-market support</li>
          </ul>
        </div>

        <!-- Interactive dashboard mockup -->
        <div class="isv-hero-visual">
          <div class="isv-dash">
            <div class="isv-dash-bar">
              <span class="isv-dash-dot" style="background:#ff5f57"></span>
              <span class="isv-dash-dot" style="background:#febc2e"></span>
              <span class="isv-dash-dot" style="background:#28c840"></span>
              <span class="isv-dash-title">ISV Growth Dashboard</span>
              <span class="isv-dash-api"><span class="isv-dash-api-dot"></span> API Operational</span>
            </div>

            <div class="isv-dash-tabs" role="tablist" aria-label="ISV dashboard views">
              <button type="button" class="isv-dash-tab active" role="tab" aria-selected="true" tabindex="0" data-isv-tab="existing">Existing Software</button>
              <button type="button" class="isv-dash-tab" role="tab" aria-selected="false" tabindex="-1" data-isv-tab="build">Build My Software</button>
              <button type="button" class="isv-dash-tab" role="tab" aria-selected="false" tabindex="-1" data-isv-tab="white">White-Label Launch</button>
            </div>

            <div class="isv-dash-body">
              <!-- Panel 1: Existing Software -->
              <div class="isv-dash-panel is-active" role="tabpanel" data-isv-panel="existing">
                <p class="isv-dash-headline">Embed payments into your current platform.</p>
                <div class="isv-dash-stats">
                  <div class="isv-dash-stat"><span class="isv-dash-stat-label">Payment Volume</span><span class="isv-dash-stat-value">$1.8M</span></div>
                  <div class="isv-dash-stat"><span class="isv-dash-stat-label">Active Merchants</span><span class="isv-dash-stat-value">74</span></div>
                  <div class="isv-dash-stat"><span class="isv-dash-stat-label">Software Fees</span><span class="isv-dash-stat-value">$6,240</span></div>
                  <div class="isv-dash-stat"><span class="isv-dash-stat-label">Boarding Status</span><span class="isv-dash-stat-value">18 in progress</span></div>
                </div>
                <div class="isv-dash-activity">
                  <span class="isv-dash-activity-title"><i class="fa-solid fa-wave-square"></i> Payment Activity</span>
                  <div class="isv-dash-row"><i class="fa-solid fa-circle-check"></i> New merchant boarded</div>
                  <div class="isv-dash-row"><i class="fa-solid fa-circle-check"></i> Gateway connected</div>
                  <div class="isv-dash-row"><i class="fa-solid fa-circle-check"></i> Recurring billing enabled</div>
                </div>
              </div>

              <!-- Panel 2: Build My Software -->
              <div class="isv-dash-panel" role="tabpanel" data-isv-panel="build" hidden>
                <p class="isv-dash-headline">Turn your vertical idea into a sellable platform.</p>
                <div class="isv-dash-stats">
                  <div class="isv-dash-stat"><span class="isv-dash-stat-label">MVP Modules</span><span class="isv-dash-stat-value">8</span></div>
                  <div class="isv-dash-stat"><span class="isv-dash-stat-label">Launch Timeline</span><span class="isv-dash-stat-value">Scoped</span></div>
                  <div class="isv-dash-stat"><span class="isv-dash-stat-label">Demo Accounts</span><span class="isv-dash-stat-value">Ready</span></div>
                  <div class="isv-dash-stat"><span class="isv-dash-stat-label">Sales Pipeline</span><span class="isv-dash-stat-value">Building</span></div>
                </div>
                <div class="isv-dash-activity">
                  <span class="isv-dash-activity-title"><i class="fa-solid fa-wave-square"></i> Build Activity</span>
                  <div class="isv-dash-row"><i class="fa-solid fa-circle-check"></i> Workflow mapped</div>
                  <div class="isv-dash-row"><i class="fa-solid fa-circle-check"></i> Dashboard prototype created</div>
                  <div class="isv-dash-row"><i class="fa-solid fa-circle-check"></i> Payment flow planned</div>
                </div>
              </div>

              <!-- Panel 3: White-Label Launch -->
              <div class="isv-dash-panel" role="tabpanel" data-isv-panel="white" hidden>
                <p class="isv-dash-headline">Launch under your brand with PPD behind the build.</p>
                <div class="isv-dash-stats">
                  <div class="isv-dash-stat"><span class="isv-dash-stat-label">Brand Setup</span><span class="isv-dash-stat-value">Complete</span></div>
                  <div class="isv-dash-stat"><span class="isv-dash-stat-label">Merchant Apps</span><span class="isv-dash-stat-value">Digital</span></div>
                  <div class="isv-dash-stat"><span class="isv-dash-stat-label">Revenue Streams</span><span class="isv-dash-stat-value">Software + Processing</span></div>
                  <div class="isv-dash-stat"><span class="isv-dash-stat-label">Support Model</span><span class="isv-dash-stat-value">Defined</span></div>
                </div>
                <div class="isv-dash-activity">
                  <span class="isv-dash-activity-title"><i class="fa-solid fa-wave-square"></i> Launch Activity</span>
                  <div class="isv-dash-row"><i class="fa-solid fa-circle-check"></i> Branded portal configured</div>
                  <div class="isv-dash-row"><i class="fa-solid fa-circle-check"></i> Onboarding emails drafted</div>
                  <div class="isv-dash-row"><i class="fa-solid fa-circle-check"></i> Sales assets prepared</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== 2. DIFFERENTIATOR ===================== -->
    <section class="isv-section isv-section--light">
      <div class="container">
        <div class="isv-head reveal">
          <span class="isv-badge"><i class="fa-solid fa-layer-group"></i> Why PPD for ISVs</span>
          <h2 class="isv-h2">More than a payment integration.</h2>
          <p class="isv-sub">
            Most providers give ISVs payment APIs and a partner agreement. PPD Technology can help with the software,
            the payments, the onboarding, and the selling system behind it.
          </p>
        </div>

        <div class="isv-grid-4">
          <div class="isv-card reveal">
            <div class="isv-card-ico"><i class="fa-solid fa-plug"></i></div>
            <h3>Embed Payments Into Your Platform</h3>
            <p>Add card-present, card-not-present, recurring, invoice, and online payment flows directly into your software experience.</p>
          </div>
          <div class="isv-card reveal">
            <div class="isv-card-ico"><i class="fa-solid fa-screwdriver-wrench"></i></div>
            <h3>Build the Software With Us</h3>
            <p>If you have the niche, relationships, and sales motion but not the full product team, we can help scope, design, and build the software around your market.</p>
          </div>
          <div class="isv-card reveal">
            <div class="isv-card-ico"><i class="fa-solid fa-coins"></i></div>
            <h3>Monetize Beyond Subscriptions</h3>
            <p>Create revenue through processing, software fees, setup fees, premium modules, and long-term merchant retention.</p>
          </div>
          <div class="isv-card reveal">
            <div class="isv-card-ico"><i class="fa-solid fa-rocket"></i></div>
            <h3>Launch With a Sales Engine</h3>
            <p>Get support around landing pages, merchant acquisition funnels, sales materials, onboarding flows, and positioning for your vertical.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== 3. TWO PATHS ===================== -->
    <section class="isv-section isv-section--dark">
      <div class="container">
        <div class="isv-head reveal">
          <span class="isv-badge isv-badge--on-dark"><i class="fa-solid fa-code-branch"></i> Choose Your Path</span>
          <h2 class="isv-h2 isv-h2--light">Whether you have software or just the market, we can help.</h2>
        </div>

        <div class="isv-paths">
          <div class="isv-path reveal">
            <span class="isv-path-tag">Path A</span>
            <h3>I already have software.</h3>
            <p class="isv-path-sub">We help you add payments and monetize your user base.</p>
            <ul class="isv-path-list">
              <li><i class="fa-solid fa-check"></i> Embedded payment integration</li>
              <li><i class="fa-solid fa-check"></i> Gateway and processor setup</li>
              <li><i class="fa-solid fa-check"></i> Merchant onboarding flow</li>
              <li><i class="fa-solid fa-check"></i> Terminal and device options</li>
              <li><i class="fa-solid fa-check"></i> Recurring billing and invoices</li>
              <li><i class="fa-solid fa-check"></i> Reporting and reconciliation support</li>
              <li><i class="fa-solid fa-check"></i> Revenue share strategy</li>
              <li><i class="fa-solid fa-check"></i> Developer / integration support</li>
            </ul>
            <a class="isv-btn isv-btn-outline-dark isv-btn-block" href="/contact">Integrate Payments</a>
          </div>

          <div class="isv-path isv-path--feature reveal">
            <span class="isv-path-flag"><i class="fa-solid fa-star"></i> PPD Differentiator</span>
            <span class="isv-path-tag isv-path-tag--feature">Path B</span>
            <h3>I need software built.</h3>
            <p class="isv-path-sub">We help you build the platform so you can focus on selling.</p>
            <ul class="isv-path-list">
              <li><i class="fa-solid fa-check"></i> Product strategy and scope</li>
              <li><i class="fa-solid fa-check"></i> UI/UX design</li>
              <li><i class="fa-solid fa-check"></i> Custom vertical software buildout</li>
              <li><i class="fa-solid fa-check"></i> Payment workflow planning</li>
              <li><i class="fa-solid fa-check"></i> Merchant dashboard</li>
              <li><i class="fa-solid fa-check"></i> Admin portal</li>
              <li><i class="fa-solid fa-check"></i> Branded experience</li>
              <li><i class="fa-solid fa-check"></i> Launch and sales support</li>
            </ul>
            <a class="isv-btn isv-btn-primary isv-btn-block" href="/contact">Build My ISV Platform</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== 4. BUILD-FOR-YOU ===================== -->
    <section class="isv-section isv-section--light" id="build">
      <div class="container">
        <div class="isv-head reveal">
          <span class="isv-badge"><i class="fa-solid fa-cubes"></i> Build-for-You Software</span>
          <h2 class="isv-h2">You sell the market. We help build the software.</h2>
          <p class="isv-sub">
            Some ISV founders already know the vertical, the merchants, and the pain points. They just need the product
            built the right way. PPD Technology can help turn that niche knowledge into a software platform with payments
            built in from the start.
          </p>
        </div>

        <div class="isv-build">
          <ol class="isv-timeline">
            <li class="isv-step reveal">
              <span class="isv-step-num">1</span>
              <div class="isv-step-body">
                <h3>Find the vertical</h3>
                <p>We identify the merchant niche, workflow, pain points, and revenue opportunity.</p>
              </div>
            </li>
            <li class="isv-step reveal">
              <span class="isv-step-num">2</span>
              <div class="isv-step-body">
                <h3>Map the product</h3>
                <p>We define the features, payment flows, merchant dashboard, admin tools, and launch plan.</p>
              </div>
            </li>
            <li class="isv-step reveal">
              <span class="isv-step-num">3</span>
              <div class="isv-step-body">
                <h3>Build the platform</h3>
                <p>We help create the branded software experience, payment workflows, CRM tools, and reporting.</p>
              </div>
            </li>
            <li class="isv-step reveal">
              <span class="isv-step-num">4</span>
              <div class="isv-step-body">
                <h3>Launch with payments</h3>
                <p>We connect the payment stack, onboarding process, devices, processing, and merchant support flow.</p>
              </div>
            </li>
            <li class="isv-step reveal">
              <span class="isv-step-num">5</span>
              <div class="isv-step-body">
                <h3>Sell and scale</h3>
                <p>You focus on merchant acquisition, demos, referrals, and expanding the vertical.</p>
              </div>
            </li>
          </ol>

          <aside class="isv-build-mock reveal" aria-label="Build blueprint preview">
            <div class="isv-build-mock-head"><i class="fa-solid fa-diagram-project"></i> Platform Blueprint</div>
            <div class="isv-build-mock-item"><i class="fa-solid fa-map"></i> <span>Product roadmap</span><em>Scoped</em></div>
            <div class="isv-build-mock-item"><i class="fa-solid fa-object-group"></i> <span>UI wireframe</span><em>In design</em></div>
            <div class="isv-build-mock-item"><i class="fa-solid fa-code"></i> <span>Payment API connection</span><em>Mapped</em></div>
            <div class="isv-build-mock-item"><i class="fa-solid fa-address-book"></i> <span>Merchant CRM</span><em>Planned</em></div>
            <div class="isv-build-mock-item"><i class="fa-solid fa-sack-dollar"></i> <span>Revenue model</span><em>Modeled</em></div>
            <div class="isv-build-mock-foot">
              <div class="isv-build-mock-bar"><span style="width:72%"></span></div>
              <span class="isv-build-mock-note">Build progress preview — sample data</span>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ===================== 5. PAYMENT CAPABILITIES ===================== -->
    <section class="isv-section isv-section--dark">
      <div class="container">
        <div class="isv-head reveal">
          <span class="isv-badge isv-badge--on-dark"><i class="fa-solid fa-layer-group"></i> Payment Stack</span>
          <h2 class="isv-h2 isv-h2--light">The payment features ISVs need to compete.</h2>
          <p class="isv-sub isv-sub--light">
            Build a better software experience with payment tools that fit how your merchants actually get paid.
          </p>
        </div>

        <div class="isv-cap-grid">
          <div class="isv-cap reveal"><i class="fa-solid fa-store"></i> In-person payments</div>
          <div class="isv-cap reveal"><i class="fa-solid fa-cart-shopping"></i> Online checkout</div>
          <div class="isv-cap reveal"><i class="fa-solid fa-mobile-screen"></i> Mobile payments</div>
          <div class="isv-cap reveal"><i class="fa-solid fa-arrows-rotate"></i> Recurring billing</div>
          <div class="isv-cap reveal"><i class="fa-solid fa-file-invoice-dollar"></i> Invoices and payment links</div>
          <div class="isv-cap reveal"><i class="fa-solid fa-building-columns"></i> ACH where applicable</div>
          <div class="isv-cap reveal"><i class="fa-solid fa-shield-halved"></i> Card tokenization</div>
          <div class="isv-cap reveal"><i class="fa-solid fa-keyboard"></i> Hosted payment fields</div>
          <div class="isv-cap reveal"><i class="fa-solid fa-plug"></i> Gateway integrations</div>
          <div class="isv-cap reveal"><i class="fa-solid fa-user-check"></i> Merchant onboarding</div>
          <div class="isv-cap reveal"><i class="fa-solid fa-chart-line"></i> Reporting dashboards</div>
          <div class="isv-cap reveal"><i class="fa-solid fa-credit-card"></i> Terminal and device options</div>
          <div class="isv-cap reveal"><i class="fa-solid fa-hand-holding-dollar"></i> Tips, adjustments &amp; partial approvals where supported</div>
          <div class="isv-cap reveal"><i class="fa-solid fa-gift"></i> Gift, loyalty &amp; value-added services where applicable</div>
          <div class="isv-cap reveal"><i class="fa-solid fa-sitemap"></i> Portfolio and residual visibility</div>
        </div>

        <p class="isv-compliance reveal">
          <i class="fa-solid fa-lock"></i> PCI-conscious payment workflows, tokenization-supported payment experiences,
          and security-focused implementation with compliance support and processor-supported tools where available.
        </p>
      </div>
    </section>

    <!-- ===================== 6. VERTICAL EXAMPLES ===================== -->
    <section class="isv-section isv-section--light">
      <div class="container">
        <div class="isv-head reveal">
          <span class="isv-badge"><i class="fa-solid fa-diagram-project"></i> Vertical Software</span>
          <h2 class="isv-h2">Built around the industries your merchants actually operate in.</h2>
          <p class="isv-sub">Generic payment tools are easy to copy. Vertical software is harder to replace.</p>
        </div>

        <div class="isv-vert reveal">
          <div class="isv-vert-tabs" role="tablist" aria-label="Vertical software examples">
            <button type="button" class="isv-vert-tab active" role="tab" aria-selected="true" tabindex="0" data-isv-vert="restaurants"><i class="fa-solid fa-utensils"></i> Restaurants</button>
            <button type="button" class="isv-vert-tab" role="tab" aria-selected="false" tabindex="-1" data-isv-vert="repair"><i class="fa-solid fa-screwdriver-wrench"></i> Repair Shops</button>
            <button type="button" class="isv-vert-tab" role="tab" aria-selected="false" tabindex="-1" data-isv-vert="retail"><i class="fa-solid fa-store"></i> Retail</button>
            <button type="button" class="isv-vert-tab" role="tab" aria-selected="false" tabindex="-1" data-isv-vert="contractors"><i class="fa-solid fa-helmet-safety"></i> Contractors</button>
            <button type="button" class="isv-vert-tab" role="tab" aria-selected="false" tabindex="-1" data-isv-vert="medspas"><i class="fa-solid fa-spa"></i> Med Spas</button>
            <button type="button" class="isv-vert-tab" role="tab" aria-selected="false" tabindex="-1" data-isv-vert="automotive"><i class="fa-solid fa-car"></i> Automotive</button>
            <button type="button" class="isv-vert-tab" role="tab" aria-selected="false" tabindex="-1" data-isv-vert="healthcare"><i class="fa-solid fa-user-doctor"></i> Healthcare</button>
            <button type="button" class="isv-vert-tab" role="tab" aria-selected="false" tabindex="-1" data-isv-vert="fitness"><i class="fa-solid fa-dumbbell"></i> Fitness</button>
            <button type="button" class="isv-vert-tab" role="tab" aria-selected="false" tabindex="-1" data-isv-vert="b2b"><i class="fa-solid fa-briefcase"></i> B2B Services</button>
          </div>

          <div class="isv-vert-panel" role="tabpanel">
            <div class="isv-vert-panel-head">
              <span class="isv-vert-ico" data-isv-vert-ico><i class="fa-solid fa-utensils"></i></span>
              <div>
                <h3 data-isv-vert-title>Restaurants</h3>
                <p>Example modules built into the platform</p>
              </div>
            </div>
            <ul class="isv-vert-modules" data-isv-vert-modules>
              <li><i class="fa-solid fa-check"></i> Table orders</li>
              <li><i class="fa-solid fa-check"></i> Tips</li>
              <li><i class="fa-solid fa-check"></i> Loyalty</li>
              <li><i class="fa-solid fa-check"></i> Online ordering</li>
              <li><i class="fa-solid fa-check"></i> Staff reports</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== 7. MONETIZATION ===================== -->
    <section class="isv-section isv-section--dark">
      <div class="container">
        <div class="isv-head reveal">
          <span class="isv-badge isv-badge--on-dark"><i class="fa-solid fa-coins"></i> Monetize Payments</span>
          <h2 class="isv-h2 isv-h2--light">Turn payments into a real revenue stream.</h2>
          <p class="isv-sub isv-sub--light">
            ISVs should not only make money from software subscriptions. With the right payment strategy, every active
            merchant relationship can become more valuable.
          </p>
        </div>

        <div class="isv-grid-4">
          <div class="isv-card isv-card--glass reveal">
            <div class="isv-card-ico"><i class="fa-solid fa-chart-column"></i></div>
            <h3>Processing Revenue</h3>
            <p>Earn from the payment volume running through the software.</p>
          </div>
          <div class="isv-card isv-card--glass reveal">
            <div class="isv-card-ico"><i class="fa-solid fa-cubes-stacked"></i></div>
            <h3>Software Fees</h3>
            <p>Add monthly platform fees, premium modules, or vertical-specific feature packages.</p>
          </div>
          <div class="isv-card isv-card--glass reveal">
            <div class="isv-card-ico"><i class="fa-solid fa-screwdriver-wrench"></i></div>
            <h3>Implementation Fees</h3>
            <p>Charge for onboarding, setup, migration, training, or custom workflows where appropriate.</p>
          </div>
          <div class="isv-card isv-card--glass reveal">
            <div class="isv-card-ico"><i class="fa-solid fa-arrows-to-circle"></i></div>
            <h3>Retention and Expansion</h3>
            <p>Payments make the software stickier, helping you retain merchants and expand into more locations or modules.</p>
          </div>
        </div>

        <div class="isv-calc reveal">
          <div class="isv-calc-inputs">
            <span class="isv-calc-tag"><i class="fa-solid fa-calculator"></i> Revenue Estimator</span>
            <label class="isv-calc-field">
              <span>Active merchants</span>
              <input type="number" id="isvMerchants" min="0" step="1" value="50" inputmode="numeric" />
            </label>
            <label class="isv-calc-field">
              <span>Average monthly volume ($ / merchant)</span>
              <input type="number" id="isvVolume" min="0" step="1000" value="25000" inputmode="numeric" />
            </label>
            <label class="isv-calc-field">
              <span>Software fee ($ / merchant / mo)</span>
              <input type="number" id="isvFee" min="0" step="1" value="49" inputmode="numeric" />
            </label>
            <label class="isv-calc-field">
              <span>Estimated payment margin (%)</span>
              <input type="number" id="isvMargin" min="0" step="0.05" value="0.5" inputmode="decimal" />
            </label>
          </div>
          <div class="isv-calc-out">
            <div class="isv-calc-out-row">
              <span>Processing revenue / mo</span>
              <strong id="isvOutProcessing">$0</strong>
            </div>
            <div class="isv-calc-out-row">
              <span>Software revenue / mo</span>
              <strong id="isvOutSoftware">$0</strong>
            </div>
            <div class="isv-calc-out-total">
              <span>Estimated monthly revenue</span>
              <strong id="isvOutMonthly">$0</strong>
            </div>
            <div class="isv-calc-out-annual">
              <span>Estimated annual revenue</span>
