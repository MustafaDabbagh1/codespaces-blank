---
import Landing from '../components/Landing.astro';
import FormExtras from '../components/FormExtras.astro';
import MerchantDemo from '../components/demos/MerchantDemo.astro';
import Icon from '../components/Icon.astro';

const features = [
  { title: 'Patient payment portal', body: 'Patients view statements, pay online and set up payment plans without calling the office.' },
  { title: 'Point-of-service payments', body: 'Take payment at check-in, at checkout or chairside, on a terminal or a mobile device.' },
  { title: 'Payment plans and recurring billing', body: 'Split a balance into scheduled payments and see which ones need a follow-up.' },
  { title: 'Insurance payment support', body: 'Help with posting and reconciling insurance payments, where your systems support it.' },
  { title: 'Security-focused setup', body: 'Encryption, tokenization and role-based access, configured with your compliance requirements in mind.' },
  { title: 'EHR and practice system options', body: 'We review the systems you run today and set payments up to work alongside them, where integrations are available.' },
];
---

<Landing
  title="Healthcare payments for practices and clinics | PPD Technology"
  description="Patient payments at the desk and online: statements, payment plans and point-of-service payments, set up and supported by PPD Technology."
  accent={{ rgb: '6, 182, 212', main: '#06b6d4', soft: '#7fe3f3' }}
  eyebrow="Healthcare"
  headline={['Patient payments,', 'without the paperwork.']}
  lede="Simplify how patients pay and cut the administrative work behind it, at the front desk, at checkout and online."
  cta={[{ label: 'Schedule a demo', href: '#demo' }, { label: 'Free rate review', href: '/rate-review' }]}
  chips={['Co-pays', 'Statements', 'Payment plans', 'HSA and FSA cards']}
  statement="Patients expect to pay the way they pay everywhere else. Your staff should not have to chase them to do it."
  featuresHead={{ eyebrow: 'What you get', title: 'Collect more, with less back-and-forth.' }}
  features={features}
  form={{ tag: 'healthcare-demo', subject: 'New Healthcare Demo Request', title: 'Tell us about your practice.', lede: 'We will reach out with a walkthrough tailored to how your office bills and collects today.', cta: 'Request a demo' }}
>
  <section class="section t-merchant" slot="demo">
    <div class="wrap demo-block">
      <div class="section-head">
        <p class="eyebrow reveal">PPD Merchant, built by PPD</p>
        <h2 class="h-1 reveal" style="--i:1">Send the statement. Get paid from a link.</h2>
        <a class="link-arrow reveal" style="--i:2" href="/merchant">Explore PPD Merchant <Icon name="arrow-right" /></a>
      </div>
      <div class="demo-block__stage reveal"><MerchantDemo captions="line" /></div>
    </div>
  </section>

  <Fragment slot="fields">
    <FormExtras id="health" city time topics={['Patient payment portal', 'Point-of-service payments', 'Payment plans', 'EHR and practice systems']} />
  </Fragment>
</Landing>
