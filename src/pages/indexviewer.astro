<script>
  // ── TERMINAL TYPEWRITER ──
  const lines = [
    { type: 'cmd', text: '$ ppd connect --env production' },
    { type: 'out', text: 'Authenticating merchant credentials...' },
    { type: 'success', text: '✓ Connected to PPD Payment Network' },
    { type: 'cmd', text: '$ process --amount 142.50 --card visa' },
    { type: 'out', text: 'Routing to optimal acquiring bank...' },
    { type: 'out', text: 'Running fraud check [██████████] 100%' },
    { type: 'success', text: '✓ APPROVED · Auth: 7F3K2 · 1.1ms' },
    { type: 'cmd', text: '$ fund --schedule next-day' },
    { type: 'success', text: '✓ Funding confirmed · ETA: 09:00 tomorrow' },
    { type: 'cursor', text: '' }
  ];

  const body = document.getElementById('terminal-body');
  let li = 0, ci = 0;
  const delay = ms => new Promise(r => setTimeout(r, ms));

  async function typeTerminal() {
    for (const line of lines) {
      const div = document.createElement('div');
      div.className = 't-line';
      if (line.type === 'cursor') {
        div.innerHTML = '<span class="t-prompt">$</span><span class="t-cursor"></span>';
        body.appendChild(div);
        break;
      }
      const cls = line.type === 'cmd' ? 't-cmd' : line.type === 'success' ? 't-success' : 't-out';
      const span = document.createElement('span');
      span.className = cls;
      if (line.type === 'cmd') {
        const prompt = document.createElement('span');
        prompt.className = 't-prompt';
        prompt.textContent = '$ ';
        div.appendChild(prompt);
        span.textContent = line.text.slice(2);
      } else {
        span.textContent = '';
      }
      div.appendChild(span);
      body.appendChild(div);
      body.scrollTop = body.scrollHeight;

      if (line.type !== 'cmd') {
        span.textContent = line.text;
        await delay(220);
      } else {
        for (const ch of line.text.slice(2)) {
          span.textContent += ch;
          await delay(38);
        }
        await delay(300);
      }
    }
  }

  window.addEventListener('load', () => setTimeout(typeTerminal, 800));

  // ── SCROLL FADE-IN ──
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.12 });

  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

  // ── COUNT-UP NUMBERS ──
  const numObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target;
      const target = parseFloat(el.dataset.target);
      const suffix = el.dataset.suffix || '';
      const isFloat = target % 1 !== 0;
      let start = null;
      const duration = 1400;

      function step(ts) {
        if (!start) start = ts;
        const prog = Math.min((ts - start) / duration, 1);
        const ease = 1 - Math.pow(1 - prog, 3);
        const val = ease * target;
        el.textContent = (isFloat ? val.toFixed(2) : Math.round(val)) + suffix;
        if (prog < 1) requestAnimationFrame(step);
        else el.textContent = (isFloat ? target.toFixed(2) : target) + suffix;
      }

      requestAnimationFrame(step);
      numObserver.unobserve(el);
    });
  }, { threshold: 0.5 });

  document.querySelectorAll('.count-num').forEach(el => numObserver.observe(el));
</script>

