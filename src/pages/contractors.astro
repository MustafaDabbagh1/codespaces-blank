---
import Landing from '../components/Landing.astro';
import FormExtras from '../components/FormExtras.astro';

const features = [
  { title: 'Visual pipelines', body: 'Track leads through stages and forecast revenue with clarity.' },
  { title: 'Estimates and invoices', body: 'Create branded estimates, send invoices and get approvals online.' },
  { title: 'Scheduling', body: 'Book site visits, assign crews and automate confirmations.' },
  { title: 'Tasks and checklists', body: 'Stay on top of callbacks, inspections and follow-ups.' },
  { title: 'PPD payments', body: 'Cards and ACH with payment links, deposits and automatic reconciliation.' },
  { title: 'Contact records', body: 'Notes, files, tags and job history in one view.' },
];
const gear = [
  { name: 'MX-Build', note: 'Estimating, scheduling, timecards and progress billing.', img: '/images/hw/mx-build.webp', href: '/mx-build' },
  { name: 'PPD Merchant', note: 'Invoices, payment links, ACH and signed agreements in one workspace.', href: '/merchant' },
  { name: 'Mobile and countertop terminals', note: 'Take a deposit on site or at the office.', img: '/images/hw/dejavoo-p18.webp' },
];
---

<Landing
  title="Contractor software and payments with MX Build | PPD Technology"
  description="Estimates, pipelines, scheduling, invoicing and payments for contractors with MX Build and PPD merchant services."
  accent={{ rgb: '255, 200, 58', main: '#e0a800', soft: '#ffd86b' }}
  eyebrow="Contractors"
  headline={['Estimates, jobs and payments,', 'in one place.']}
  lede="We set contractors up with MX Build for fast estimates, organized pipelines, scheduling and invoicing, with PPD’s merchant services built in."
  cta={[{ label: 'Request a demo', href: '#demo' }, { label: 'See MX-Build', href: '/mx-build' }]}
  chips={['General contracting', 'Roofing', 'HVAC', 'Plumbing', 'Electrical', 'Landscaping']}
  statement="Quote the job, schedule the crew, take the deposit and collect the balance, without retyping any of it."
  featuresHead={{ eyebrow: 'What you get with MX Build', title: 'Close more jobs with fewer clicks.' }}
  features={features}
  gear={{ eyebrow: 'What we set you up with', title: 'Software, payments and the devices to take them.', items: gear }}
  form={{ tag: 'contractors-demo', subject: 'New Contractors Demo Request', title: 'Get MX Build with PPD payments.', lede: 'We will tailor the setup, bring your contacts over and switch payments on, so you can quote and collect faster.' }}
>
  <img slot="visual" src="/images/hw/mx-build.webp" alt="MX Build scheduling screen" width="900" height="737" />

  <Fragment slot="fields">
    <FormExtras
      id="contractor"
      city
      select={{ name: 'trade', label: 'Your trade', options: ['General contracting', 'Roofing', 'HVAC', 'Plumbing', 'Electrical', 'Landscaping', 'Other'] }}
      topics={['Pipelines', 'Scheduling', 'Estimates', 'Payments']}
    />
  </Fragment>
</Landing>
