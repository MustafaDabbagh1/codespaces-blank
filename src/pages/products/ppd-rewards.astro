---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="PPD Rewards | Earn, Track & Redeem Rewards on Your Processing"
  description="PPD Rewards helps eligible merchants earn rewards from processing activity, refer other businesses, and redeem rewards as statement credits or digital options — all from one portal."
>
  <div class="pr-page">

    <!-- ============== HERO ============== -->
    <section class="pr-hero">
      <div class="pr-hero-grid"></div>
      <div class="pr-orb pr-orb-1"></div>
      <div class="pr-orb pr-orb-2"></div>
      <div class="pr-orb pr-orb-3"></div>

      <div class="container pr-hero-inner">
        <div class="pr-hero-text">
          <span class="pr-pill"><i class="fa-solid fa-gift"></i> PPD Rewards — Merchant Program</span>
          <h1>Turn Everyday Processing Into <span class="pr-grad-text">Real Rewards</span></h1>
          <p class="pr-hero-sub">
            PPD Rewards helps eligible merchants earn, track, and redeem rewards while making it easy to refer other businesses to PPD. Get more value from every dollar you process.
          </p>
          <div class="pr-hero-actions">
            <a class="pr-btn pr-btn-primary pr-btn-lg" href="/contact">
              <i class="fa-solid fa-bolt"></i> Request Access
            </a>
            <a class="pr-btn pr-btn-outline-hero pr-btn-lg" href="#how-it-works">
              <i class="fa-solid fa-play"></i> See How It Works
            </a>
          </div>
          <div class="pr-hero-proof">
            <div class="pr-proof-dots">
              <span style="background:#F59E0B"><i class="fa-solid fa-coins"></i></span>
              <span style="background:#1549FF"><i class="fa-solid fa-wallet"></i></span>
              <span style="background:#00E5A0"><i class="fa-solid fa-handshake"></i></span>
            </div>
            <span>Rewards on eligible settled volume &middot; Easy referral tracking</span>
          </div>
        </div>

        <!-- Mock Rewards Dashboard Card -->
        <div class="pr-hero-visual">
          <div class="pr-dash">
            <div class="pr-dash-bar">
              <span class="pr-dash-dot" style="background:#ff5f57"></span>
              <span class="pr-dash-dot" style="background:#febc2e"></span>
              <span class="pr-dash-dot" style="background:#28c840"></span>
              <span class="pr-dash-title"><i class="fa-solid fa-gift"></i> PPD Rewards Wallet</span>
              <span class="pr-dash-tag">Good Standing</span>
            </div>
            <div class="pr-dash-body">
              <div class="pr-wallet-hero">
                <div class="pr-wallet-label">Available Rewards</div>
                <div class="pr-wallet-amount">$248.50</div>
                <div class="pr-wallet-trend"><i class="fa-solid fa-arrow-up"></i> +$32.40 this month</div>
              </div>
              <div class="pr-wallet-grid">
                <div class="pr-wallet-stat">
                  <span class="pr-wallet-stat-label"><i class="fa-solid fa-hourglass-half"></i> Pending</span>
                  <span class="pr-wallet-stat-value">$48.20</span>
                </div>
                <div class="pr-wallet-stat">
                  <span class="pr-wallet-stat-label"><i class="fa-solid fa-handshake"></i> Referral Earnings</span>
                  <span class="pr-wallet-stat-value">$120.00</span>
                </div>
                <div class="pr-wallet-stat">
                  <span class="pr-wallet-stat-label"><i class="fa-solid fa-trophy"></i> Lifetime Rewards</span>
                  <span class="pr-wallet-stat-value">$1,842.75</span>
                </div>
                <div class="pr-wallet-stat">
                  <span class="pr-wallet-stat-label"><i class="fa-solid fa-check-double"></i> Redeemed</span>
                  <span class="pr-wallet-stat-value">$1,594.25</span>
                </div>
              </div>
              <button class="pr-redeem-btn" type="button">
                <i class="fa-solid fa-gift"></i> Redeem Rewards
              </button>
            </div>
          </div>
          <div class="pr-float pr-float-1">
            <i class="fa-solid fa-coins"></i>
            <div>
              <strong>+$12.40</strong>
              <span>Reward earned</span>
            </div>
          </div>
          <div class="pr-float pr-float-2">
            <i class="fa-solid fa-user-plus"></i>
            <div>
              <strong>Referral Approved</strong>
              <span>Bella Salon Group</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============== METRICS STRIP ============== -->
    <section class="pr-strip">
      <div class="container pr-strip-inner">
        <div class="pr-strip-item">
          <i class="fa-solid fa-percent"></i>
          <div><strong>0.01%</strong><span>of eligible volume</span></div>
        </div>
        <div class="pr-strip-item">
          <i class="fa-solid fa-rotate"></i>
          <div><strong>Monthly</strong><span>reward cycles</span></div>
        </div>
        <div class="pr-strip-item">
          <i class="fa-solid fa-handshake"></i>
          <div><strong>Unlimited</strong><span>business referrals</span></div>
        </div>
        <div class="pr-strip-item">
          <i class="fa-solid fa-shield-halved"></i>
          <div><strong>Transparent</strong><span>activity ledger</span></div>
        </div>
      </div>
    </section>

    <!-- ============== HOW IT WORKS ============== -->
    <section class="pr-section" id="how-it-works">
      <div class="container">
        <div class="pr-head-center">
          <span class="pr-chip"><i class="fa-solid fa-list-check"></i> How It Works</span>
          <h2>Four Simple Steps to Start Earning</h2>
          <p class="pr-sub">From processing to payout — see how PPD Rewards turns your everyday activity into real value.</p>
        </div>

        <div class="pr-steps">
          <div class="pr-step">
            <span class="pr-step-num">1</span>
            <div class="pr-step-icon"><i class="fa-solid fa-credit-card"></i></div>
            <h3>Process with PPD</h3>
            <p>Run your business as usual. Every eligible settled transaction counts toward your monthly rewards.</p>
          </div>
          <div class="pr-step">
            <span class="pr-step-num">2</span>
            <div class="pr-step-icon"><i class="fa-solid fa-coins"></i></div>
            <h3>Earn Monthly Rewards</h3>
            <p>Eligible processing activity generates rewards each cycle, tracked automatically in your wallet.</p>
          </div>
          <div class="pr-step">
            <span class="pr-step-num">3</span>
            <div class="pr-step-icon"><i class="fa-solid fa-handshake"></i></div>
            <h3>Refer Other Businesses</h3>
            <p>Send referrals to PPD and follow their status from submission to approval — all from one portal.</p>
          </div>
          <div class="pr-step">
            <span class="pr-step-num">4</span>
            <div class="pr-step-icon"><i class="fa-solid fa-gift"></i></div>
            <h3>Redeem Rewards</h3>
            <p>Cash in available rewards as statement credits or eligible digital reward options when you're ready.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============== MERCHANT BENEFITS ============== -->
    <section class="pr-section pr-section-alt" id="benefits">
      <div class="container">
        <div class="pr-head-center">
          <span class="pr-chip"><i class="fa-solid fa-star"></i> Merchant Benefits</span>
          <h2>Built to Reward Active Merchants</h2>
          <p class="pr-sub">Everything you need to track, grow, and redeem rewards — in plain sight.</p>
        </div>

        <div class="pr-benefit-grid">
          <div class="pr-benefit-card">
            <div class="pr-benefit-icon"><i class="fa-solid fa-coins"></i></div>
            <h3>Earn From Processing</h3>
            <p>Earn rewards on eligible settled processing volume each month — no extra workflow required.</p>
          </div>
          <div class="pr-benefit-card">
            <div class="pr-benefit-icon"><i class="fa-solid fa-users"></i></div>
            <h3>Refer &amp; Track</h3>
            <p>Submit business referrals and follow their progress from review to approval in real time.</p>
          </div>
          <div class="pr-benefit-card">
            <div class="pr-benefit-icon"><i class="fa-solid fa-wallet"></i></div>
            <h3>Pending &amp; Available View</h3>
            <p>See exactly what's pending, what's available, and what's already been redeemed at a glance.</p>
          </div>
          <div class="pr-benefit-card">
            <div class="pr-benefit-icon"><i class="fa-solid fa-credit-card"></i></div>
            <h3>Flexible Redemption</h3>
            <p>Redeem available rewards as statement credits or eligible digital reward options.</p>
          </div>
          <div class="pr-benefit-card">
            <div class="pr-benefit-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
            <h3>Full Reward History</h3>
            <p>One clear timeline of earned, pending, redeemed, and adjusted rewards — always up to date.</p>
          </div>
          <div class="pr-benefit-card">
            <div class="pr-benefit-icon"><i class="fa-solid fa-shield-halved"></i></div>
            <h3>Good-Standing Transparency</h3>
            <p>Built for active merchants in good standing, with clear program rules and no hidden gotchas.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============== INTERACTIVE FEATURE TABS ============== -->
    <section class="pr-section pr-demos-section" id="features">
      <div class="container">
        <div class="pr-head-center">
          <span class="pr-chip-light"><i class="fa-solid fa-desktop"></i> Inside the Portal</span>
          <h2>Everything You Need, One Place</h2>
          <p class="pr-sub-light">Click any feature to see a preview of how it looks inside the PPD Rewards portal.</p>
        </div>

        <div class="pr-demo-tabs" role="tablist" aria-label="PPD Rewards features">
          <button class="pr-demo-tab active" role="tab" aria-selected="true" aria-controls="pr-tab-dash" data-tab="pr-tab-dash" tabindex="0">
            <i class="fa-solid fa-gauge-high"></i><span>Rewards Dashboard</span>
          </button>
          <button class="pr-demo-tab" role="tab" aria-selected="false" aria-controls="pr-tab-ref" data-tab="pr-tab-ref" tabindex="-1">
            <i class="fa-solid fa-handshake"></i><span>Referral Tracking</span>
          </button>
          <button class="pr-demo-tab" role="tab" aria-selected="false" aria-controls="pr-tab-redeem" data-tab="pr-tab-redeem" tabindex="-1">
            <i class="fa-solid fa-gift"></i><span>Redemption Options</span>
          </button>
          <button class="pr-demo-tab" role="tab" aria-selected="false" aria-controls="pr-tab-hist" data-tab="pr-tab-hist" tabindex="-1">
            <i class="fa-solid fa-clock-rotate-left"></i><span>Reward History</span>
          </button>
          <button class="pr-demo-tab" role="tab" aria-selected="false" aria-controls="pr-tab-trust" data-tab="pr-tab-trust" tabindex="-1">
            <i class="fa-solid fa-shield-halved"></i><span>Good Standing</span>
          </button>
        </div>

        <div class="pr-demo-viewport">

          <!-- DASHBOARD -->
          <div class="pr-demo-panel active" id="pr-tab-dash" role="tabpanel">
            <div class="pr-demo-info">
              <h3><i class="fa-solid fa-gauge-high"></i> Rewards Dashboard</h3>
              <p>See available rewards, pending rewards, redeemed rewards, and lifetime earnings at a glance. Every cent of activity is tracked automatically — no spreadsheets, no guessing.</p>
              <ul class="pr-feat-list">
                <li><i class="fa-solid fa-check"></i> Live wallet balance</li>
                <li><i class="fa-solid fa-check"></i> Monthly earning trend</li>
                <li><i class="fa-solid fa-check"></i> Quick redeem actions</li>
              </ul>
            </div>
            <div class="pr-demo-chrome">
              <div class="pr-demo-topbar">
                <div class="pr-demo-topbar-left"><i class="fa-solid fa-gift"></i> Rewards Dashboard</div>
                <div class="pr-demo-topbar-right">
                  <button class="pr-demo-action-btn"><i class="fa-solid fa-gift"></i> Redeem</button>
                </div>
              </div>
              <div class="pr-demo-content">
                <div class="pr-demo-kpi-row">
                  <div class="pr-demo-kpi"><div class="pr-kpi-icon gold"><i class="fa-solid fa-wallet"></i></div><div><span>Available</span><strong>$248.50</strong></div></div>
                  <div class="pr-demo-kpi"><div class="pr-kpi-icon yellow"><i class="fa-solid fa-hourglass-half"></i></div><div><span>Pending</span><strong>$48.20</strong></div></div>
                  <div class="pr-demo-kpi"><div class="pr-kpi-icon green"><i class="fa-solid fa-check-double"></i></div><div><span>Redeemed</span><strong>$1,594.25</strong></div></div>
                  <div class="pr-demo-kpi"><div class="pr-kpi-icon blue"><i class="fa-solid fa-trophy"></i></div><div><span>Lifetime</span><strong>$1,842.75</strong></div></div>
                </div>
                <div class="pr-demo-chart-box">
                  <div class="pr-demo-chart-head">Rewards Earned — Last 6 Months</div>
                  <svg viewBox="0 0 320 70" preserveAspectRatio="none" class="pr-demo-chart-svg">
                    <defs><linearGradient id="prGrad1" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="rgba(245,158,11,.35)"/><stop offset="100%" stop-color="rgba(245,158,11,0)"/></linearGradient></defs>
                    <path d="M0 58 Q40 50 80 44 T160 28 T240 20 T320 10 V70 H0 Z" fill="url(#prGrad1)"/>
                    <path d="M0 58 Q40 50 80 44 T160 28 T240 20 T320 10" fill="none" stroke="#F59E0B" stroke-width="2.5"/>
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <!-- REFERRAL -->
          <div class="pr-demo-panel" id="pr-tab-ref" role="tabpanel">
            <div class="pr-demo-info">
              <h3><i class="fa-solid fa-handshake"></i> Referral Tracking</h3>
              <p>Submit business referrals and follow their progress from review to approval. You'll always know where each referral stands and what it could be worth.</p>
              <ul class="pr-feat-list">
                <li><i class="fa-solid fa-check"></i> Simple referral submission form</li>
                <li><i class="fa-solid fa-check"></i> Live status updates</li>
                <li><i class="fa-solid fa-check"></i> Referral earnings rolled into your wallet</li>
              </ul>
            </div>
            <div class="pr-demo-chrome">
              <div class="pr-demo-topbar">
                <div class="pr-demo-topbar-left"><i class="fa-solid fa-handshake"></i> My Referrals</div>
                <div class="pr-demo-topbar-right">
                  <button class="pr-demo-action-btn"><i class="fa-solid fa-plus"></i> New Referral</button>
                </div>
              </div>
              <div class="pr-demo-content">
                <div class="pr-demo-table">
                  <div class="pr-demo-table-head"><span>Business</span><span>Contact</span><span>Submitted</span><span>Status</span></div>
                  <div class="pr-demo-table-row"><span>Bella Salon Group</span><span>Ana Rivera</span><span>2 days ago</span><span class="pr-badge green">Approved</span></div>
                  <div class="pr-demo-table-row"><span>Metro Dental</span><span>Dr. Patel</span><span>5 days ago</span><span class="pr-badge yellow">Under Review</span></div>
                  <div class="pr-demo-table-row"><span>QuickBite LLC</span><span>Marcus Thompson</span><span>1 week ago</span><span class="pr-badge blue">Onboarding</span></div>
                  <div class="pr-demo-table-row"><span>FastLane Auto</span><span>Sarah Chen</span><span>2 weeks ago</span><span class="pr-badge green">Approved</span></div>
                  <div class="pr-demo-table-row"><span>Nails by Nova</span><span>Nova Kim</span><span>3 weeks ago</span><span class="pr-badge green">Approved</span></div>
                </div>
              </div>
            </div>
          </div>

          <!-- REDEEM -->
          <div class="pr-demo-panel" id="pr-tab-redeem" role="tabpanel">
            <div class="pr-demo-info">
              <h3><i class="fa-solid fa-gift"></i> Redemption Options</h3>
              <p>Redeem available rewards through statement credits or eligible digital payout options. Pick what works for your business.</p>
              <ul class="pr-feat-list">
                <li><i class="fa-solid fa-check"></i> Statement credit on your processing</li>
                <li><i class="fa-solid fa-check"></i> Digital reward options</li>
                <li><i class="fa-solid fa-check"></i> Track redemption status in real time</li>
              </ul>
            </div>
            <div class="pr-demo-chrome">
              <div class="pr-demo-topbar">
                <div class="pr-demo-topbar-left"><i class="fa-solid fa-gift"></i> Redeem Rewards</div>
                <div class="pr-demo-topbar-right"><span class="pr-demo-badge-period">Available: $248.50</span></div>
              </div>
              <div class="pr-demo-content">
                <div class="pr-redeem-grid">
                  <div class="pr-redeem-opt featured">
                    <div class="pr-redeem-icon"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                    <h4>Statement Credit</h4>
                    <p>Apply your rewards directly to your processing statement.</p>
                    <span class="pr-redeem-pop">Most Popular</span>
                  </div>
                  <div class="pr-redeem-opt">
                    <div class="pr-redeem-icon"><i class="fa-solid fa-bolt"></i></div>
                    <h4>Digital Rewards</h4>
                    <p>Redeem through eligible digital reward options.</p>
                  </div>
                  <div class="pr-redeem-opt">
                    <div class="pr-redeem-icon"><i class="fa-solid fa-gift"></i></div>
                    <h4>Gift Card Options</h4>
                    <p>Choose from select gift card options when available.</p>
                  </div>
                </div>
                <p class="pr-redeem-fine">Available options may vary by program settings and merchant eligibility.</p>
              </div>
            </div>
          </div>

          <!-- HISTORY -->
          <div class="pr-demo-panel" id="pr-tab-hist" role="tabpanel">
            <div class="pr-demo-info">
              <h3><i class="fa-solid fa-clock-rotate-left"></i> Reward History</h3>
              <p>Keep a clear record of earned, redeemed, pending, and adjusted rewards. Every entry is timestamped and easy to filter.</p>
              <ul class="pr-feat-list">
                <li><i class="fa-solid fa-check"></i> Full activity ledger</li>
                <li><i class="fa-solid fa-check"></i> Filter by type or date</li>
                <li><i class="fa-solid fa-check"></i> Export-ready records</li>
              </ul>
            </div>
            <div class="pr-demo-chrome">
              <div class="pr-demo-topbar">
                <div class="pr-demo-topbar-left"><i class="fa-solid fa-clock-rotate-left"></i> Reward Activity</div>
                <div class="pr-demo-topbar-right"><div class="pr-demo-search"><i class="fa-solid fa-search"></i> Search activity...</div></div>
              </div>
              <div class="pr-demo-content">
                <div class="pr-demo-table">
                  <div class="pr-demo-table-head"><span>Date</span><span>Type</span><span>Description</span><span>Amount</span></div>
                  <div class="pr-demo-table-row"><span>May 22, 2026</span><span><i class="fa-solid fa-coins" style="color:#F59E0B"></i> Earned</span><span>Monthly rewards — April cycle</span><span style="color:#16a34a">+$32.40</span></div>
                  <div class="pr-demo-table-row"><span>May 18, 2026</span><span><i class="fa-solid fa-handshake" style="color:#1549FF"></i> Referral</span><span>Bella Salon Group approved</span><span style="color:#16a34a">+$50.00</span></div>
                  <div class="pr-demo-table-row"><span>May 10, 2026</span><span><i class="fa-solid fa-gift" style="color:#0BA360"></i> Redeemed</span><span>Statement credit applied</span><span style="color:#dc2626">−$200.00</span></div>
                  <div class="pr-demo-table-row"><span>Apr 28, 2026</span><span><i class="fa-solid fa-hourglass-half" style="color:#febc2e"></i> Pending</span><span>March cycle — settlement window</span><span style="color:#a16207">$48.20</span></div>
                  <div class="pr-demo-table-row"><span>Apr 22, 2026</span><span><i class="fa-solid fa-coins" style="color:#F59E0B"></i> Earned</span><span>Monthly rewards — March cycle</span><span style="color:#16a34a">+$28.10</span></div>
                </div>
              </div>
            </div>
          </div>

          <!-- TRUST -->
          <div class="pr-demo-panel" id="pr-tab-trust" role="tabpanel">
            <div class="pr-demo-info">
              <h3><i class="fa-solid fa-shield-halved"></i> Good-Standing Transparency</h3>
              <p>Rewards are available to eligible merchants whose accounts remain active and in good standing. Status is always visible — no surprises.</p>
              <ul class="pr-feat-list">
                <li><i class="fa-solid fa-check"></i> Clear eligibility indicator</li>
                <li><i class="fa-solid fa-check"></i> Plain-language program terms</li>
                <li><i class="fa-solid fa-check"></i> Direct support if anything changes</li>
              </ul>
            </div>
            <div class="pr-demo-chrome">
              <div class="pr-demo-topbar">
                <div class="pr-demo-topbar-left"><i class="fa-solid fa-shield-halved"></i> Account Status</div>
                <div class="pr-demo-topbar-right"><span class="pr-badge green">Active &amp; Good Standing</span></div>
              </div>
              <div class="pr-demo-content">
                <div class="pr-trust-grid">
                  <div class="pr-trust-row"><i class="fa-solid fa-circle-check"></i><div><strong>Processing Active</strong><span>Account is processing and eligible to earn.</span></div></div>
                  <div class="pr-trust-row"><i class="fa-solid fa-circle-check"></i><div><strong>Program Enrolled</strong><span>You're enrolled in PPD Rewards.</span></div></div>
                  <div class="pr-trust-row"><i class="fa-solid fa-circle-check"></i><div><strong>Eligible to Redeem</strong><span>Account meets redemption requirements.</span></div></div>
                  <div class="pr-trust-row"><i class="fa-solid fa-circle-check"></i><div><strong>No Outstanding Issues</strong><span>No flags or restrictions on the account.</span></div></div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ============== REWARDS CALCULATOR ============== -->
    <section class="pr-section pr-section-alt" id="calculator">
      <div class="container">
        <div class="pr-head-center">
          <span class="pr-chip"><i class="fa-solid fa-calculator"></i> Rewards Calculator</span>
          <h2>See What You Could Earn</h2>
          <p class="pr-sub">Enter your monthly eligible processing volume to get a quick estimate.</p>
        </div>

        <div class="pr-calc">
          <div class="pr-calc-input">
            <label for="prVolume">Monthly Eligible Processing Volume</label>
            <div class="pr-calc-field">
              <span class="pr-calc-prefix">$</span>
              <input id="prVolume" type="number" min="0" step="1000" value="100000" inputmode="numeric" />
            </div>
            <input id="prVolumeRange" type="range" min="0" max="2000000" step="5000" value="100000" />
            <div class="pr-calc-presets">
              <button type="button" data-vol="25000">$25K</button>
              <button type="button" data-vol="50000">$50K</button>
              <button type="button" data-vol="100000" class="active">$100K</button>
              <button type="button" data-vol="250000">$250K</button>
              <button type="button" data-vol="500000">$500K</button>
              <button type="button" data-vol="1000000">$1M</button>
            </div>
          </div>
          <div class="pr-calc-output">
            <div class="pr-calc-out-label">Estimated Monthly Rewards</div>
            <div class="pr-calc-out-value" id="prMonthly">$10.00</div>
            <div class="pr-calc-out-grid">
              <div><span>Annual Estimate</span><strong id="prAnnual">$120.00</strong></div>
              <div><span>Rate</span><strong>0.01% of eligible volume</strong></div>
            </div>
            <a class="pr-btn pr-btn-primary pr-btn-md" href="/contact"><i class="fa-solid fa-bolt"></i> Start Earning Rewards</a>
            <p class="pr-calc-fine">Estimates are for illustration only. Actual rewards depend on eligible settled volume, program enrollment, account status, and PPD Rewards terms.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============== REDEMPTION OPTIONS ============== -->
    <section class="pr-section" id="redemption">
      <div class="container">
        <div class="pr-head-center">
          <span class="pr-chip"><i class="fa-solid fa-gift"></i> Redemption</span>
          <h2>Redeem Rewards Your Way</h2>
