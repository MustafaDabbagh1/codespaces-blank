  </style>

  <script>
    // ============ TABS ============
    const tabs = document.querySelectorAll<HTMLButtonElement>('.pr-demo-tab');
    const panels = document.querySelectorAll<HTMLElement>('.pr-demo-panel');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        tabs.forEach((t) => {
          const isActive = t === tab;
          t.classList.toggle('active', isActive);
          t.setAttribute('aria-selected', String(isActive));
          t.tabIndex = isActive ? 0 : -1;
        });
        panels.forEach((p) => p.classList.toggle('active', p.id === target));
      });
      tab.addEventListener('keydown', (e) => {
        const idx = Array.from(tabs).indexOf(tab);
        let next = idx;
        if (e.key === 'ArrowRight') next = (idx + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (idx - 1 + tabs.length) % tabs.length;
        else return;
        e.preventDefault();
        tabs[next].focus();
        tabs[next].click();
      });
    });

    // ============ CALCULATOR ============
    const volInput = document.getElementById('prVolume') as HTMLInputElement | null;
    const volRange = document.getElementById('prVolumeRange') as HTMLInputElement | null;
    const monthlyEl = document.getElementById('prMonthly');
    const annualEl = document.getElementById('prAnnual');
    const presetBtns = document.querySelectorAll<HTMLButtonElement>('.pr-calc-presets button');
    const RATE = 0.0001; // 0.01%

    const fmt = (n: number) =>
      n.toLocaleString('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 2 });

    function update(volRaw: number, source: 'input' | 'range' | 'preset') {
      const vol = isFinite(volRaw) && volRaw > 0 ? volRaw : 0;
      const monthly = vol * RATE;
      const annual = monthly * 12;
      if (monthlyEl) monthlyEl.textContent = fmt(monthly);
      if (annualEl) annualEl.textContent = fmt(annual);
      if (volInput && source !== 'input') volInput.value = String(vol);
      if (volRange && source !== 'range') volRange.value = String(Math.min(vol, Number(volRange.max)));
      presetBtns.forEach((b) => b.classList.toggle('active', Number(b.dataset.vol) === vol));
    }

    volInput?.addEventListener('input', () => update(Number(volInput.value), 'input'));
    volRange?.addEventListener('input', () => update(Number(volRange.value), 'range'));
    presetBtns.forEach((b) =>
      b.addEventListener('click', () => update(Number(b.dataset.vol), 'preset')),
    );

    // initial sync
    if (volInput) update(Number(volInput.value), 'preset');
  </script>
</BaseLayout>
