---
import ProductPage from '../../components/ProductPage.astro';
import RewardsDemo from '../../components/demos/RewardsDemo.astro';

const features = [
  { icon: 'receipt', title: 'Statement credits', body: 'Apply rewards toward your processing statement.' },
  { icon: 'gift', title: 'Digital gift cards', body: 'Redeem rewards for digital gift cards and Visa prepaid cards when you are ready.' },
  { icon: 'store', title: 'Per-location visibility', body: 'See what each location earned, so multi-location operators know where rewards come from.' },
  { icon: 'wallet', title: 'One combined wallet', body: 'One balance for the whole business, however many locations feed it.' },
  { icon: 'file-text', title: 'A transparent ledger', body: 'Every reward earned and every redemption is listed, with pending amounts shown before they become available.' },
  { icon: 'handshake', title: 'Know a business? Refer it.', body: 'PPD pays $200 per approved merchant signup through the referral program.' },
];

const faqs = [
  { q: 'Who can join PPD Rewards?', a: 'PPD Rewards is available to enrolled PPD Technology merchants in good standing. If you already process with PPD, contact your PPD sales agent to request enrollment.' },
  { q: 'How are rewards earned?', a: 'Eligible processing volume is converted into rewards each month. You keep running payments through PPD Technology the way you do today.' },
  { q: 'How do I redeem?', a: 'Choose a statement credit, or a digital gift card or Visa prepaid card, whenever you are ready. Available options may vary by program settings and merchant eligibility.' },
  { q: 'I have several locations. How does that work?', a: 'Rewards are tracked by location and roll up into one combined balance for your business.' },
];
---

<ProductPage
  productKey="rewards"
  title="PPD Rewards | Earn rewards on eligible processing volume | PPD Technology"
  description="PPD Rewards helps eligible PPD Technology merchants turn processing volume into statement credits and digital gift cards, tracked by location with one combined balance."
  headline="Rewards on every eligible dollar you process."
  lede="PPD Rewards helps eligible merchants turn processing volume into statement credits and digital gift cards, while keeping every reward transparent and easy to track."
  audiences={['Enrolled PPD merchants', 'Single or multi-location', 'Statement credits', 'Digital gift cards']}
  demo={{ eyebrow: 'How it works', title: 'Process. Earn. Redeem.' }}
  featuresHead={{ eyebrow: 'Redemption and tracking', title: 'A reward you can actually follow.' }}
  features={features}
  pricing={{
    label: 'Eligibility',
    price: 'Included',
    unit: 'For enrolled PPD Technology merchants in good standing.',
    includes: ['Rewards on eligible processing volume, posted monthly', 'Statement credits or digital gift cards', 'Per-location tracking with one combined balance', 'A full activity ledger in the portal'],
    note: 'Program terms apply. Available options may vary by program settings and merchant eligibility. Figures in the animation above are illustrative sample data.',
  }}
  faqs={faqs}
  form={{ tag: 'rewards-enrollment', subject: 'New PPD Rewards Enrollment Request', title: 'Already process with PPD? Ask to enroll.', lede: 'Tell us who you are and we will route your request to your PPD sales agent. Not processing with PPD yet? Start with a free rate review.', cta: 'Request enrollment' }}
>
  <RewardsDemo>
    <p class="eyebrow">How it works</p>
    <h2 class="h-2">Process. Earn. Redeem.</h2>
  </RewardsDemo>

  <div class="field field--full" slot="fields">
    <label for="rewards-mid">Merchant ID <span class="opt">optional</span></label>
    <input id="rewards-mid" name="mid" type="text" />
  </div>
</ProductPage>
