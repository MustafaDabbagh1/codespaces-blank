---
import Landing from '../components/Landing.astro';
import FormExtras from '../components/FormExtras.astro';

const features = [
  { title: 'Optimized checkout', body: 'Hosted, embedded or headless checkout, with autofill and network tokens to cut declines.' },
  { title: '3-D Secure and risk tools', body: 'Step-up authentication, velocity rules and allow or deny lists to stop fraud before it lands.' },
  { title: 'Subscriptions and billing', body: 'Plans, trials, coupons, proration and dunning for the whole billing lifecycle.' },
  { title: 'Tokenization and vault', body: 'Store payment methods securely for one-click repeat purchases and simple refunds.' },
  { title: 'More ways to pay', body: 'Cards, ACH and wallets, so customers can pay the way they prefer.' },
  { title: 'Revenue reporting', body: 'Authorization rates, chargebacks and conversion in one dashboard.' },
];
const faqs = [
  { q: 'Do you support subscriptions and trials?', a: 'Yes. Plans, trials, coupons, proration and automated dunning are part of the billing tools.' },
  { q: 'How do you improve authorization rates?', a: 'Network tokenization, account updater, smart retries and 3-D Secure step-up all help more good payments go through.' },
  { q: 'Which platforms do you work with?', a: 'WooCommerce, BigCommerce, Magento and Shopify (via compatible gateways), plus custom and headless storefronts.' },
  { q: 'How fast can we go live?', a: 'It depends on your platform and how you want checkout to work. Tell us what you run today and we will give you a realistic timeline.' },
];
---

<Landing
  title="E-commerce payments and online checkout | PPD Technology"
  description="Accept cards, ACH, wallets and subscriptions online with tokenization and 3-D Secure, set up and supported by PPD Technology."
  accent={{ rgb: '34, 211, 255', main: '#22b8ff', soft: '#8fe6ff' }}
  eyebrow="E-commerce"
  headline={['Checkout that converts.', 'Security that scales.']}
  lede="Accept cards, ACH, wallets and subscriptions with tokenization, 3-D Secure and smart retries built in."
  cta={[{ label: 'Talk to us', href: '#demo' }, { label: 'Start an application', href: '/signup' }]}
  chips={['WooCommerce', 'BigCommerce', 'Magento', 'Shopify (via gateway)', 'Custom and headless']}
  statement="A customer who reaches checkout has already decided. Our job is to make sure the payment does not change their mind."
  featuresHead={{ eyebrow: 'What you get', title: 'Fewer declines. Less fraud.' }}
  features={features}
  faqs={faqs}
  form={{ tag: 'ecommerce-demo', subject: 'New E-commerce Inquiry', title: 'Tell us what you sell online.', lede: 'Share your platform and volume and we will show you how checkout, billing and reporting would work for your store.', cta: 'Send' }}
>
  <Fragment slot="fields">
    <FormExtras id="ecom" select={{ name: 'platform', label: 'Your platform', options: ['WooCommerce', 'BigCommerce', 'Magento', 'Shopify', 'Custom or headless', 'Not sure yet'] }} />
  </Fragment>
</Landing>
