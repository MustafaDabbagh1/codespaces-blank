---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PPD Technology — Merchant Processing Application" description="Apply for merchant payment processing in minutes. Secure, streamlined onboarding for POS solutions, online payments, and next-day funding options.">
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </Fragment>

  <section class="su-page">

    <section class="su-hero">
      <div class="su-hero__inner">
        <div class="su-hero__text">
          <span class="su-badge"><i class="fa-solid fa-shield-halved"></i> Secure Merchant Application</span>
          <h1>Apply for Merchant Processing<br/>with <span class="su-grad">PPD Technology</span></h1>
          <p class="su-hero__sub">Secure, streamlined business onboarding for payment processing, POS solutions, and next-day funding options. Complete your application in minutes.</p>
          <div class="su-hero__ctas">
            <a href="#application" class="su-btn su-btn--primary"><i class="fa-solid fa-rocket"></i> Start Your Application</a>
            <a href="#faq" class="su-btn su-btn--outline"><i class="fa-solid fa-circle-question"></i> Questions Before Applying?</a>
          </div>
        </div>
        <div class="su-hero__journey" aria-hidden="true">
          <div class="su-journey">
            <div class="su-journey__line"></div>
            <div class="su-journey__node su-journey__node--done" style="--delay:0s">
              <div class="su-journey__dot"><i class="fa-solid fa-check"></i></div>
              <div class="su-journey__card">
                <div class="su-journey__icon"><i class="fa-solid fa-industry"></i></div>
                <strong>Industry Selected</strong>
                <small>Restaurant</small>
              </div>
            </div>
            <div class="su-journey__node su-journey__node--done" style="--delay:.15s">
              <div class="su-journey__dot"><i class="fa-solid fa-check"></i></div>
              <div class="su-journey__card">
                <div class="su-journey__icon"><i class="fa-solid fa-cash-register"></i></div>
                <strong>Product Selected</strong>
                <small>KORONA POS</small>
              </div>
            </div>
            <div class="su-journey__node su-journey__node--done" style="--delay:.3s">
              <div class="su-journey__dot"><i class="fa-solid fa-check"></i></div>
              <div class="su-journey__card">
                <div class="su-journey__icon"><i class="fa-solid fa-building"></i></div>
                <strong>Business Verified</strong>
                <small>EIN confirmed</small>
              </div>
            </div>
            <div class="su-journey__node su-journey__node--active" style="--delay:.45s">
              <div class="su-journey__dot"><i class="fa-solid fa-lock"></i></div>
              <div class="su-journey__card su-journey__card--glow">
                <div class="su-journey__icon"><i class="fa-solid fa-building-columns"></i></div>
                <strong>Bank Secured</strong>
                <small>256-bit encrypted</small>
              </div>
            </div>
            <div class="su-journey__node" style="--delay:.6s">
              <div class="su-journey__dot"><i class="fa-solid fa-paper-plane"></i></div>
              <div class="su-journey__card">
                <div class="su-journey__icon"><i class="fa-solid fa-file-signature"></i></div>
                <strong>Application Submitted</strong>
                <small>Ready for review</small>
              </div>
            </div>
            <div class="su-journey__node" style="--delay:.75s">
              <div class="su-journey__dot"><i class="fa-solid fa-magnifying-glass-chart"></i></div>
              <div class="su-journey__card">
                <div class="su-journey__icon"><i class="fa-solid fa-clipboard-check"></i></div>
                <strong>Underwriting Review</strong>
                <small>24–48 hrs typical</small>
              </div>
            </div>
          </div>
          <div class="su-journey__glow"></div>
        </div>
      </div>
    </section>

    <section class="su-trust">
      <div class="su-trust__inner">
        <div class="su-trust__item"><i class="fa-solid fa-lock"></i><span>Encrypted Application</span></div>
        <div class="su-trust__item"><i class="fa-solid fa-building-columns"></i><span>Secure Bank Submission</span></div>
        <div class="su-trust__item"><i class="fa-solid fa-clock"></i><span>Fast Review Process</span></div>
        <div class="su-trust__item"><i class="fa-solid fa-headset"></i><span>U.S.-Based Support</span></div>
        <div class="su-trust__item"><i class="fa-solid fa-cash-register"></i><span>POS & Terminal Options</span></div>
        <div class="su-trust__item"><i class="fa-solid fa-file-contract"></i><span>Underwriting Ready</span></div>
      </div>
    </section>

    <section class="su-process">
      <div class="su-process__inner">
        <h2>How the Application Works</h2>
        <div class="su-process__grid">
          <div class="su-process__card">
            <div class="su-process__num">1</div>
            <h4>Choose Your Industry &amp; Solution</h4>
            <p>Select your business type and the processing solution or hardware that fits your needs.</p>
          </div>
          <div class="su-process__arrow"><i class="fa-solid fa-arrow-right"></i></div>
          <div class="su-process__card">
            <div class="su-process__num">2</div>
            <h4>Enter Business &amp; Owner Details</h4>
            <p>Provide your business information, ownership details, and processing profile for underwriting.</p>
          </div>
          <div class="su-process__arrow"><i class="fa-solid fa-arrow-right"></i></div>
          <div class="su-process__card">
            <div class="su-process__num">3</div>
            <h4>Submit Securely for Review</h4>
            <p>Your encrypted application is reviewed by our team. A specialist follows up within 1-2 business days.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="su-form-section" id="application">
      <div class="su-form-section__inner">
        <div class="su-form-section__head">
          <h2>Merchant Processing Application</h2>
          <p>Complete the form below to apply. All information is securely encrypted and used solely for application review and account setup.</p>
        </div>

        <form id="appForm" class="su-form" action="/api/lead" method="POST" novalidate>
          <input type="hidden" name="_form" value="merchant-signup" />
          <input type="hidden" name="_subject" value="New PPD Merchant Processing Application" />
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" aria-hidden="true" />

          <div class="su-stepper" aria-label="Application progress">
            <div class="su-stepper__track">
              <div class="su-stepper__fill" id="stepperFill"></div>
            </div>
            <div class="su-stepper__labels">
              <button type="button" class="su-stepper__step active" data-step-btn="1" aria-current="step"><span class="su-stepper__num">1</span><span class="su-stepper__label">Solution</span></button>
              <button type="button" class="su-stepper__step" data-step-btn="2"><span class="su-stepper__num">2</span><span class="su-stepper__label">Business</span></button>
              <button type="button" class="su-stepper__step" data-step-btn="3"><span class="su-stepper__num">3</span><span class="su-stepper__label">Owner</span></button>
              <button type="button" class="su-stepper__step" data-step-btn="4"><span class="su-stepper__num">4</span><span class="su-stepper__label">Processing</span></button>
              <button type="button" class="su-stepper__step" data-step-btn="5"><span class="su-stepper__num">5</span><span class="su-stepper__label">Banking</span></button>
              <button type="button" class="su-stepper__step" data-step-btn="6"><span class="su-stepper__num">6</span><span class="su-stepper__label">Review</span></button>
            </div>
          </div>

          <div class="su-pane" data-step="1">
            <div class="su-pane__header">
              <i class="fa-solid fa-compass"></i>
              <div>
                <h3>Industry &amp; Solution Selection</h3>
                <p>Tell us about your industry and choose the processing solution that fits your business.</p>
              </div>
            </div>

            <div class="su-field">
              <label for="industry">What industry is your business in? <span class="su-req">*</span></label>
              <select required id="industry" name="industry">
                <option value="">Select your industry</option>
                <option value="Restaurant / Food Service">Restaurant / Food Service</option>
                <option value="Retail">Retail</option>
                <option value="Professional Services">Professional Services</option>
                <option value="Healthcare">Healthcare</option>
                <option value="E-commerce">E-commerce</option>
                <option value="Salon / Spa / MedSpa">Salon / Spa / MedSpa</option>
                <option value="Grocery / Convenience / EBT">Grocery / Convenience / EBT</option>
                <option value="Repair / Service">Repair / Service</option>
                <option value="Contractors">Contractors</option>
                <option value="Non-Profit">Non-Profit</option>
                <option value="Education">Education</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="su-prod-section">
              <label class="su-prod-label">Select your solution <span class="su-req">*</span></label>
              <div class="su-prod-filter" id="prodFilter">
                <button type="button" class="su-filter-btn active" data-cat="all">All</button>
                <button type="button" class="su-filter-btn" data-cat="pos">POS Systems</button>
                <button type="button" class="su-filter-btn" data-cat="terminal">Terminals &amp; Pinpads</button>
                <button type="button" class="su-filter-btn" data-cat="software">Software</button>
                <button type="button" class="su-filter-btn" data-cat="gateway">Gateway &amp; Virtual</button>
              </div>
              <div class="su-prod-grid" id="prodGrid">
                <label class="su-prod-card" data-cat="pos"><input type="radio" name="selected_product" value="KORONA POS" required /><div class="su-prod-card__inner"><img src="/images/Korona/Hardware-Group-with-KORONA-POS-Software.png" alt="KORONA POS" loading="lazy" /><strong>KORONA POS</strong><small>Cloud POS for retail, QSR, and ticketing with real-time inventory</small></div><div class="su-prod-card__check"><i class="fa-solid fa-circle-check"></i></div></label>
                <label class="su-prod-card" data-cat="pos"><input type="radio" name="selected_product" value="Pays POS" /><div class="su-prod-card__inner"><img src="/images/Pos system.png" alt="Pays POS" loading="lazy" /><strong>Pays POS</strong><small>Full POS with payments, inventory, analytics, and dual pricing</small></div><div class="su-prod-card__check"><i class="fa-solid fa-circle-check"></i></div></label>
                <label class="su-prod-card" data-cat="pos"><input type="radio" name="selected_product" value="NRS POS" /><div class="su-prod-card__inner"><img src="/images/nrs-pos1-min.png" alt="NRS POS" loading="lazy" /><strong>NRS POS</strong><small>All-in-one POS with inventory, CRM, loyalty, and EBT support</small></div><div class="su-prod-card__check"><i class="fa-solid fa-circle-check"></i></div></label>
                <label class="su-prod-card" data-cat="pos"><input type="radio" name="selected_product" value="Clover POS" /><div class="su-prod-card__inner"><img src="/images/clover-duo-printer-mini3-facing-customer.png" alt="Clover POS" loading="lazy" /><strong>Clover POS</strong><small>Versatile POS ecosystem with Duo, Flex, Mini, and Solo options</small></div><div class="su-prod-card__check"><i class="fa-solid fa-circle-check"></i></div></label>
                <label class="su-prod-card" data-cat="terminal"><input type="radio" name="selected_product" value="Dejavoo VP800" /><div class="su-prod-card__inner"><img src="/images/VP800-View-01.png" alt="Dejavoo VP800" loading="lazy" /><strong>Dejavoo VP800</strong><small>Countertop EMV terminal with tap-to-pay, tip prompts, and receipts</small></div><div class="su-prod-card__check"><i class="fa-solid fa-circle-check"></i></div></label>
                <label class="su-prod-card" data-cat="terminal"><input type="radio" name="selected_product" value="Dejavoo P18" /><div class="su-prod-card__inner"><img src="/images/p18.png" alt="Dejavoo P18" loading="lazy" /><strong>Dejavoo P18</strong><small>Modern touchscreen terminal for busy countertops with full EMV</small></div><div class="su-prod-card__check"><i class="fa-solid fa-circle-check"></i></div></label>
                <label class="su-prod-card" data-cat="terminal"><input type="radio" name="selected_product" value="Pinpads (P12 & P17)" /><div class="su-prod-card__inner"><img src="/images/Pin-Pads-p12p17.png" alt="Pinpads P12 & P17" loading="lazy" /><strong>Pinpads P12 &amp; P17</strong><small>Compact customer-facing EMV and contactless pin pads</small></div><div class="su-prod-card__check"><i class="fa-solid fa-circle-check"></i></div></label>
                <label class="su-prod-card" data-cat="software"><input type="radio" name="selected_product" value="PPD Repair" /><div class="su-prod-card__inner"><div class="su-prod-card__iconbox"><i class="fa-solid fa-screwdriver-wrench"></i></div><strong>PPD Repair</strong><small>Repair shop SaaS with POS, ticketing, inventory, and payments</small></div><div class="su-prod-card__check"><i class="fa-solid fa-circle-check"></i></div></label>
                <label class="su-prod-card" data-cat="software"><input type="radio" name="selected_product" value="PPD Merchant" /><div class="su-prod-card__inner"><div class="su-prod-card__iconbox"><i class="fa-solid fa-chart-pie"></i></div><strong>PPD Merchant</strong><small>Merchant analytics dashboard with reporting, risk, and portfolio tools</small></div><div class="su-prod-card__check"><i class="fa-solid fa-circle-check"></i></div></label>
                <label class="su-prod-card" data-cat="software"><input type="radio" name="selected_product" value="MX-Build" /><div class="su-prod-card__inner"><div class="su-prod-card__iconbox"><i class="fa-solid fa-layer-group"></i></div><strong>MX-Build</strong><small>Digital experience builder for merchant onboarding and portals</small></div><div class="su-prod-card__check"><i class="fa-solid fa-circle-check"></i></div></label>
                <label class="su-prod-card" data-cat="software"><input type="radio" name="selected_product" value="Passport Banking" /><div class="su-prod-card__inner"><div class="su-prod-card__iconbox"><i class="fa-solid fa-passport"></i></div><strong>Passport Banking</strong><small>Banking-as-a-service platform for embedded financial solutions</small></div><div class="su-prod-card__check"><i class="fa-solid fa-circle-check"></i></div></label>
                <label class="su-prod-card" data-cat="gateway"><input type="radio" name="selected_product" value="eCommerce Gateway" /><div class="su-prod-card__inner"><div class="su-prod-card__iconbox"><i class="fa-solid fa-globe"></i></div><strong>eCommerce Gateway</strong><small>Online payment gateway for web stores and checkout integrations</small></div><div class="su-prod-card__check"><i class="fa-solid fa-circle-check"></i></div></label>
                <label class="su-prod-card" data-cat="gateway"><input type="radio" name="selected_product" value="Virtual Terminal" /><div class="su-prod-card__inner"><div class="su-prod-card__iconbox"><i class="fa-solid fa-laptop"></i></div><strong>Virtual Terminal</strong><small>Browser-based terminal for keyed-in and MOTO transactions</small></div><div class="su-prod-card__check"><i class="fa-solid fa-circle-check"></i></div></label>
                <label class="su-prod-card" data-cat="gateway"><input type="radio" name="selected_product" value="Mobile Reader" /><div class="su-prod-card__inner"><div class="su-prod-card__iconbox"><i class="fa-solid fa-mobile-screen-button"></i></div><strong>Mobile Reader</strong><small>Bluetooth card reader paired with smartphone for on-the-go payments</small></div><div class="su-prod-card__check"><i class="fa-solid fa-circle-check"></i></div></label>
              </div>

              <div class="su-selected-summary" id="selectedSummary" hidden>
                <div class="su-selected-summary__inner">
                  <i class="fa-solid fa-circle-check"></i>
                  <div>
                    <strong id="selectedName">—</strong>
                    <small>Selected solution</small>
                  </div>
                  <button type="button" class="su-selected-summary__clear" id="clearSelection">Change</button>
                </div>
              </div>
            </div>

            <div class="su-pane__actions">
              <div></div>
              <button type="button" class="su-btn su-btn--primary" data-next>Continue <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </div>

          <div class="su-pane" data-step="2" hidden>
            <div class="su-pane__header">
              <i class="fa-solid fa-building"></i>
              <div>
                <h3>Business Information</h3>
                <p>Tell us about your business so we can tailor the best processing solution.</p>
              </div>
            </div>
            <div class="su-grid-2">
              <div class="su-field"><label for="legal_name">Legal Business Name <span class="su-req">*</span></label><input required id="legal_name" name="legal_name" placeholder="e.g., Acme Enterprises LLC" /></div>
              <div class="su-field"><label for="dba">DBA (Doing Business As)</label><input id="dba" name="dba" placeholder="e.g., Acme Coffee Shop" /></div>
            </div>
            <div class="su-grid-2">
              <div class="su-field"><label for="entity_type">Business Entity Type <span class="su-req">*</span></label><select required id="entity_type" name="entity_type"><option value="">Select entity type</option><option>Sole Proprietorship</option><option>LLC</option><option>Corporation</option><option>Partnership</option><option>Non-Profit</option><option>Government</option></select></div>
              <div class="su-field"><label for="years_in_biz">Years in Business <span class="su-req">*</span></label><select required id="years_in_biz" name="years_in_business"><option value="">Select</option><option>Less than 1 year</option><option>1-3 years</option><option>3-5 years</option><option>5-10 years</option><option>10+ years</option></select></div>
            </div>
            <div class="su-grid-2">
              <div class="su-field"><label for="ein">EIN / Tax ID <span class="su-req">*</span></label><input required id="ein" name="ein" placeholder="XX-XXXXXXX" /></div>
              <div class="su-field"><label for="state_inc">State of Incorporation <span class="su-req">*</span></label><input required id="state_inc" name="state_of_incorporation" placeholder="e.g., California" /></div>
            </div>
            <div class="su-grid-2">
              <div class="su-field"><label for="biz_phone">Business Phone <span class="su-req">*</span></label><input required id="biz_phone" name="business_phone" type="tel" placeholder="(555) 555-1234" /></div>
              <div class="su-field"><label for="biz_email">Business Email <span class="su-req">*</span></label><input required id="biz_email" name="business_email" type="email" placeholder="owner@business.com" /></div>
            </div>
            <div class="su-field"><label for="business_website">Business Website</label><input id="business_website" name="business_website" type="url" placeholder="https://www.yourbusiness.com" /></div>
            <div class="su-field"><label for="biz_address">Business Address <span class="su-req">*</span></label><input required id="biz_address" name="business_address" placeholder="123 Main St, Suite 100, City, State ZIP" /></div>
            <div class="su-field"><label for="mail_address">Mailing Address (if different)</label><input id="mail_address" name="mailing_address" placeholder="PO Box or alternate address" /></div>
            <div class="su-grid-2">
              <div class="su-field"><label for="num_locations">Number of Locations</label><input id="num_locations" name="number_of_locations" type="number" min="1" placeholder="1" /></div>
              <div class="su-field"><label for="sales_channels">Sales Channels <span class="su-req">*</span></label><select required id="sales_channels" name="sales_channels"><option value="">Select primary channel</option><option>In-store</option><option>Online</option><option>Mobile</option><option>Invoice / Recurring</option><option>MOTO (Mail/Telephone)</option><option>Multiple channels</option></select></div>
            </div>
            <div class="su-field"><label for="products_desc">Describe Products / Services Sold <span class="su-req">*</span></label><textarea required id="products_desc" name="products_services" rows="3" placeholder="Brief description of what your business sells or the services you provide..."></textarea></div>
            <div class="su-pane__actions">
              <button type="button" class="su-btn su-btn--ghost" data-prev><i class="fa-solid fa-arrow-left"></i> Back</button>
              <button type="button" class="su-btn su-btn--primary" data-next>Continue <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </div>

          <div class="su-pane" data-step="3" hidden>
            <div class="su-pane__header">
              <i class="fa-solid fa-user-tie"></i>
              <div>
                <h3>Owner / Principal Information</h3>
                <p>Required for underwriting review. Information is encrypted and handled securely.</p>
              </div>
            </div>
            <div class="su-grid-2">
              <div class="su-field"><label for="owner_name">Full Legal Name <span class="su-req">*</span></label><input required id="owner_name" name="owner_name" placeholder="First Middle Last" /></div>
              <div class="su-field"><label for="owner_title">Title / Role <span class="su-req">*</span></label><input required id="owner_title" name="owner_title" placeholder="e.g., Owner, CEO, Managing Partner" /></div>
            </div>
            <div class="su-grid-2">
              <div class="su-field"><label for="owner_pct">Ownership % <span class="su-req">*</span></label><input required id="owner_pct" name="ownership_pct" placeholder="e.g., 100%" /></div>
              <div class="su-field"><label for="owner_dob">Date of Birth <span class="su-req">*</span></label><input required id="owner_dob" name="owner_dob" type="date" /></div>
            </div>
            <div class="su-grid-2">
              <div class="su-field"><label for="owner_ssn">SSN (Last 4 Digits) <span class="su-req">*</span></label><div class="su-input-icon"><i class="fa-solid fa-lock"></i><input required id="owner_ssn" name="owner_ssn_last4" placeholder="••••" inputmode="numeric" maxlength="4" pattern="^\d{4}$" title="Enter last 4 digits of SSN" /></div></div>
              <div class="su-field"><label for="owner_mobile">Mobile Phone <span class="su-req">*</span></label><input required id="owner_mobile" name="owner_mobile" type="tel" placeholder="(555) 555-1234" /></div>
            </div>
            <div class="su-field"><label for="owner_email">Owner Email <span class="su-req">*</span></label><input required id="owner_email" name="owner_email" type="email" placeholder="owner@email.com" /></div>
            <div class="su-field"><label for="owner_address">Home Address <span class="su-req">*</span></label><input required id="owner_address" name="owner_home_address" placeholder="123 Oak Ave, City, State ZIP" /></div>
            <div class="su-disclosure">
              <button type="button" class="su-disclosure__toggle" id="addOwnerToggle" aria-expanded="false" aria-controls="addOwnerBody"><i class="fa-solid fa-user-plus"></i> Add Additional Owner / Principal<i class="fa-solid fa-chevron-down su-disclosure__chevron"></i></button>
              <div class="su-disclosure__body" id="addOwnerBody" hidden>
                <div class="su-grid-2">
                  <div class="su-field"><label for="owner2_name">Full Legal Name</label><input id="owner2_name" name="owner2_name" placeholder="First Last" /></div>
                  <div class="su-field"><label for="owner2_pct">Ownership %</label><input id="owner2_pct" name="owner2_pct" placeholder="e.g., 50%" /></div>
                </div>
                <div class="su-grid-2">
                  <div class="su-field"><label for="owner2_title">Title</label><input id="owner2_title" name="owner2_title" placeholder="e.g., Partner, VP" /></div>
                  <div class="su-field"><label for="owner2_ssn">SSN (Last 4)</label><input id="owner2_ssn" name="owner2_ssn_last4" placeholder="••••" inputmode="numeric" maxlength="4" /></div>
                </div>
                <div class="su-field"><label for="owner2_email">Email</label><input id="owner2_email" name="owner2_email" type="email" placeholder="partner@email.com" /></div>
              </div>
            </div>
            <div class="su-pane__actions">
              <button type="button" class="su-btn su-btn--ghost" data-prev><i class="fa-solid fa-arrow-left"></i> Back</button>
              <button type="button" class="su-btn su-btn--primary" data-next>Continue <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </div>

          <div class="su-pane" data-step="4" hidden>
            <div class="su-pane__header">
              <i class="fa-solid fa-chart-line"></i>
              <div>
                <h3>Processing Profile</h3>
                <p>Help us understand your transaction volume and processing needs.</p>
              </div>
            </div>
            <div class="su-grid-2">
