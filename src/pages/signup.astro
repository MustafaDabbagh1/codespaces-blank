---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PPD Technology — Merchant Processing Application">
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </Fragment>

  <section class="su-page">

    <section class="su-hero">
      <div class="su-hero__inner">
        <div class="su-hero__text">
          <span class="su-badge"><i class="fa-solid fa-shield-halved"></i> Secure Merchant Application</span>
          <h1>Apply for Merchant Processing<br/>with <span class="su-grad">PPD Technology</span></h1>
          <p class="su-hero__sub">Secure, streamlined business onboarding for payment processing, POS solutions, and next-day funding options. Complete your application in minutes.</p>
          <div class="su-hero__ctas">
            <a href="#application" class="su-btn su-btn--primary"><i class="fa-solid fa-rocket"></i> Start Your Application</a>
            <a href="#faq" class="su-btn su-btn--outline"><i class="fa-solid fa-circle-question"></i> Questions Before Applying?</a>
          </div>
        </div>
        <div class="su-hero__mockup">
          <div class="su-mockup-card">
            <div class="su-mockup__bar">
              <span class="su-dot su-dot--r"></span><span class="su-dot su-dot--y"></span><span class="su-dot su-dot--g"></span>
              <span class="su-mockup__title">PPD Application Portal</span>
            </div>
            <div class="su-mockup__body">
              <div class="su-mockup__row">
                <div class="su-mockup__stat">
                  <small>Application Status</small>
                  <strong class="su-green">Under Review</strong>
                </div>
                <div class="su-mockup__stat">
                  <small>Avg. Approval Time</small>
                  <strong>24–48 hrs</strong>
                </div>
              </div>
              <div class="su-mockup__progress">
                <div class="su-mockup__pbar"><div class="su-mockup__pfill" style="width:65%"></div></div>
                <small>Step 3 of 6 — Processing Profile</small>
              </div>
              <div class="su-mockup__checklist">
                <div class="su-check su-check--done"><i class="fa-solid fa-circle-check"></i> Business Information</div>
                <div class="su-check su-check--done"><i class="fa-solid fa-circle-check"></i> Owner Verification</div>
                <div class="su-check su-check--active"><i class="fa-solid fa-spinner fa-spin"></i> Processing Profile</div>
                <div class="su-check"><i class="fa-regular fa-circle"></i> Bank & Funding</div>
                <div class="su-check"><i class="fa-regular fa-circle"></i> Equipment Selection</div>
                <div class="su-check"><i class="fa-regular fa-circle"></i> Review & Submit</div>
              </div>
            </div>
          </div>
          <div class="su-float su-float--1">
            <i class="fa-solid fa-lock"></i>
            <div><strong>256-bit Encryption</strong><small>Bank-grade security</small></div>
          </div>
          <div class="su-float su-float--2">
            <i class="fa-solid fa-bolt"></i>
            <div><strong>Next-Day Funding</strong><small>For eligible accounts</small></div>
          </div>
        </div>
      </div>
    </section>

    <section class="su-trust">
      <div class="su-trust__inner">
        <div class="su-trust__item"><i class="fa-solid fa-lock"></i><span>Encrypted Application</span></div>
        <div class="su-trust__item"><i class="fa-solid fa-building-columns"></i><span>Secure Bank Submission</span></div>
        <div class="su-trust__item"><i class="fa-solid fa-clock"></i><span>Fast Review Process</span></div>
        <div class="su-trust__item"><i class="fa-solid fa-headset"></i><span>U.S.-Based Support</span></div>
        <div class="su-trust__item"><i class="fa-solid fa-cash-register"></i><span>POS & Terminal Options</span></div>
        <div class="su-trust__item"><i class="fa-solid fa-file-contract"></i><span>Underwriting Ready</span></div>
      </div>
    </section>

    <section class="su-prepare">
      <div class="su-prepare__inner">
        <div class="su-prepare__head">
          <span class="su-badge su-badge--sm"><i class="fa-solid fa-clipboard-list"></i> Before You Begin</span>
          <h2>What You'll Need to Apply</h2>
          <p>Having these items ready will help you complete the application quickly and avoid delays.</p>
        </div>
        <div class="su-prepare__grid">
          <div class="su-prep-card">
            <div class="su-prep-card__icon"><i class="fa-solid fa-building"></i></div>
            <h4>Legal Business Info</h4>
            <p>Business name, DBA, entity type, EIN, address, and state of incorporation</p>
          </div>
          <div class="su-prep-card">
            <div class="su-prep-card__icon"><i class="fa-solid fa-user-tie"></i></div>
            <h4>Owner Details</h4>
            <p>Full legal name, ownership percentage, date of birth, SSN, and home address</p>
          </div>
          <div class="su-prep-card">
            <div class="su-prep-card__icon"><i class="fa-solid fa-chart-line"></i></div>
            <h4>Processing Estimates</h4>
            <p>Monthly card volume, average ticket size, and card-present vs. card-not-present breakdown</p>
          </div>
          <div class="su-prep-card">
            <div class="su-prep-card__icon"><i class="fa-solid fa-building-columns"></i></div>
            <h4>Bank Information</h4>
            <p>Bank name, routing number, and account number for deposit setup</p>
          </div>
          <div class="su-prep-card">
            <div class="su-prep-card__icon"><i class="fa-solid fa-file-invoice"></i></div>
            <h4>Processing History</h4>
            <p>Current processor, chargeback history, and refund policy details if applicable</p>
          </div>
          <div class="su-prep-card">
            <div class="su-prep-card__icon"><i class="fa-solid fa-laptop"></i></div>
            <h4>Equipment Needs</h4>
            <p>POS, terminal, gateway, virtual terminal, or mobile reader requirements</p>
          </div>
        </div>
      </div>
    </section>

    <section class="su-form-section" id="application">
      <div class="su-form-section__inner">
        <div class="su-form-section__head">
          <h2>Merchant Processing Application</h2>
          <p>Complete the form below to apply. All information is securely encrypted and used solely for application review and account setup.</p>
        </div>

        <form id="appForm" class="su-form" action="https://formspree.io/f/mvgwalay" method="POST" novalidate>
          <input type="hidden" name="_subject" value="New PPD Merchant Processing Application" />
          <input type="hidden" name="_redirect" value="" />
          <input type="text" name="_gotcha" style="display:none" />

          <div class="su-stepper" aria-label="Application progress">
            <div class="su-stepper__track">
              <div class="su-stepper__fill" id="stepperFill"></div>
            </div>
            <div class="su-stepper__labels">
              <button type="button" class="su-stepper__step active" data-step-btn="1" aria-current="step"><span class="su-stepper__num">1</span><span class="su-stepper__label">Business</span></button>
              <button type="button" class="su-stepper__step" data-step-btn="2"><span class="su-stepper__num">2</span><span class="su-stepper__label">Owner</span></button>
              <button type="button" class="su-stepper__step" data-step-btn="3"><span class="su-stepper__num">3</span><span class="su-stepper__label">Processing</span></button>
              <button type="button" class="su-stepper__step" data-step-btn="4"><span class="su-stepper__num">4</span><span class="su-stepper__label">Banking</span></button>
              <button type="button" class="su-stepper__step" data-step-btn="5"><span class="su-stepper__num">5</span><span class="su-stepper__label">Equipment</span></button>
              <button type="button" class="su-stepper__step" data-step-btn="6"><span class="su-stepper__num">6</span><span class="su-stepper__label">Review</span></button>
            </div>
          </div>

          <!-- Step 1: Business Information -->
          <div class="su-pane" data-step="1">
            <div class="su-pane__header">
              <i class="fa-solid fa-building"></i>
              <div>
                <h3>Business Information</h3>
                <p>Tell us about your business so we can tailor the best processing solution.</p>
              </div>
            </div>

            <div class="su-grid-2">
              <div class="su-field">
                <label for="legal_name">Legal Business Name <span class="su-req">*</span></label>
                <input required id="legal_name" name="legal_name" placeholder="e.g., Acme Enterprises LLC" />
              </div>
              <div class="su-field">
                <label for="dba">DBA (Doing Business As)</label>
                <input id="dba" name="dba" placeholder="e.g., Acme Coffee Shop" />
              </div>
            </div>

            <div class="su-grid-2">
              <div class="su-field">
                <label for="entity_type">Business Entity Type <span class="su-req">*</span></label>
                <select required id="entity_type" name="entity_type">
                  <option value="">Select entity type</option>
                  <option>Sole Proprietorship</option>
                  <option>LLC</option>
                  <option>Corporation</option>
                  <option>Partnership</option>
                  <option>Non-Profit</option>
                  <option>Government</option>
                </select>
              </div>
              <div class="su-field">
                <label for="industry">Industry / Business Type <span class="su-req">*</span></label>
                <select required id="industry" name="industry">
                  <option value="">Select industry</option>
                  <option>Restaurant / Food Service</option>
                  <option>Retail</option>
                  <option>Professional Services</option>
                  <option>Healthcare</option>
                  <option>E-commerce</option>
                  <option>Salon / Spa / MedSpa</option>
                  <option>Grocery / Convenience / EBT</option>
                  <option>Repair / Service</option>
                  <option>Contractors</option>
                  <option>Non-Profit</option>
                  <option>Education</option>
                  <option>Other</option>
                </select>
              </div>
            </div>

            <div class="su-grid-2">
              <div class="su-field">
                <label for="years_in_biz">Years in Business <span class="su-req">*</span></label>
                <select required id="years_in_biz" name="years_in_business">
                  <option value="">Select</option>
                  <option>Less than 1 year</option>
                  <option>1–3 years</option>
                  <option>3–5 years</option>
                  <option>5–10 years</option>
                  <option>10+ years</option>
                </select>
              </div>
              <div class="su-field">
                <label for="biz_start_date">Business Start Date</label>
                <input id="biz_start_date" name="business_start_date" type="date" />
              </div>
            </div>

            <div class="su-grid-2">
              <div class="su-field">
                <label for="ein">EIN / Tax ID <span class="su-req">*</span></label>
                <input required id="ein" name="ein" placeholder="XX-XXXXXXX" />
              </div>
              <div class="su-field">
                <label for="state_inc">State of Incorporation <span class="su-req">*</span></label>
                <input required id="state_inc" name="state_of_incorporation" placeholder="e.g., California" />
              </div>
            </div>

            <div class="su-grid-2">
              <div class="su-field">
                <label for="biz_phone">Business Phone <span class="su-req">*</span></label>
                <input required id="biz_phone" name="business_phone" type="tel" placeholder="(555) 555-1234" />
              </div>
              <div class="su-field">
                <label for="biz_email">Business Email <span class="su-req">*</span></label>
                <input required id="biz_email" name="business_email" type="email" placeholder="owner@business.com" />
              </div>
            </div>

            <div class="su-field">
              <label for="website">Business Website</label>
              <input id="website" name="website" type="url" placeholder="https://www.yourbusiness.com" />
            </div>

            <div class="su-field">
              <label for="biz_address">Business Address <span class="su-req">*</span></label>
              <input required id="biz_address" name="business_address" placeholder="123 Main St, Suite 100, City, State ZIP" />
            </div>

            <div class="su-field">
              <label for="mail_address">Mailing Address (if different)</label>
              <input id="mail_address" name="mailing_address" placeholder="PO Box or alternate address" />
            </div>

            <div class="su-grid-2">
              <div class="su-field">
                <label for="num_locations">Number of Locations</label>
                <input id="num_locations" name="number_of_locations" type="number" min="1" placeholder="1" />
              </div>
              <div class="su-field">
                <label for="sales_channels">Sales Channels <span class="su-req">*</span></label>
                <select required id="sales_channels" name="sales_channels">
                  <option value="">Select primary channel</option>
                  <option>In-store</option>
                  <option>Online</option>
                  <option>Mobile</option>
                  <option>Invoice / Recurring</option>
                  <option>MOTO (Mail/Telephone)</option>
                  <option>Multiple channels</option>
                </select>
              </div>
            </div>

            <div class="su-field">
              <label for="products_desc">Describe Products / Services Sold <span class="su-req">*</span></label>
              <textarea required id="products_desc" name="products_services" rows="3" placeholder="Brief description of what your business sells or the services you provide..."></textarea>
            </div>

            <div class="su-pane__actions">
              <div></div>
              <button type="button" class="su-btn su-btn--primary" data-next>Continue <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </div>

          <!-- Step 2: Owner / Principal Information -->
          <div class="su-pane" data-step="2" hidden>
            <div class="su-pane__header">
              <i class="fa-solid fa-user-tie"></i>
              <div>
                <h3>Owner / Principal Information</h3>
                <p>Required for underwriting review. Information is encrypted and handled securely.</p>
              </div>
            </div>

            <div class="su-grid-2">
              <div class="su-field">
                <label for="owner_name">Full Legal Name <span class="su-req">*</span></label>
                <input required id="owner_name" name="owner_name" placeholder="First Middle Last" />
              </div>
              <div class="su-field">
                <label for="owner_title">Title / Role <span class="su-req">*</span></label>
                <input required id="owner_title" name="owner_title" placeholder="e.g., Owner, CEO, Managing Partner" />
              </div>
            </div>

            <div class="su-grid-2">
              <div class="su-field">
                <label for="owner_pct">Ownership % <span class="su-req">*</span></label>
                <input required id="owner_pct" name="ownership_pct" placeholder="e.g., 100%" />
              </div>
              <div class="su-field">
                <label for="owner_dob">Date of Birth <span class="su-req">*</span></label>
                <input required id="owner_dob" name="owner_dob" type="date" />
              </div>
            </div>

            <div class="su-grid-2">
              <div class="su-field">
                <label for="owner_ssn">SSN (Last 4 Digits) <span class="su-req">*</span></label>
                <div class="su-input-icon">
                  <i class="fa-solid fa-lock"></i>
                  <input required id="owner_ssn" name="owner_ssn_last4" placeholder="••••" inputmode="numeric" maxlength="4" pattern="^\d{4}$" title="Enter last 4 digits of SSN" />
                </div>
              </div>
              <div class="su-field">
                <label for="owner_mobile">Mobile Phone <span class="su-req">*</span></label>
                <input required id="owner_mobile" name="owner_mobile" type="tel" placeholder="(555) 555-1234" />
              </div>
            </div>

            <div class="su-field">
              <label for="owner_email">Owner Email <span class="su-req">*</span></label>
              <input required id="owner_email" name="owner_email" type="email" placeholder="owner@email.com" />
            </div>

            <div class="su-field">
              <label for="owner_address">Home Address <span class="su-req">*</span></label>
              <input required id="owner_address" name="owner_home_address" placeholder="123 Oak Ave, City, State ZIP" />
            </div>

            <div class="su-disclosure">
              <button type="button" class="su-disclosure__toggle" id="addOwnerToggle" aria-expanded="false" aria-controls="addOwnerBody">
                <i class="fa-solid fa-user-plus"></i> Add Additional Owner / Principal
                <i class="fa-solid fa-chevron-down su-disclosure__chevron"></i>
              </button>
              <div class="su-disclosure__body" id="addOwnerBody" hidden>
                <div class="su-grid-2">
                  <div class="su-field">
                    <label for="owner2_name">Full Legal Name</label>
                    <input id="owner2_name" name="owner2_name" placeholder="First Last" />
                  </div>
                  <div class="su-field">
                    <label for="owner2_pct">Ownership %</label>
                    <input id="owner2_pct" name="owner2_pct" placeholder="e.g., 50%" />
                  </div>
                </div>
                <div class="su-grid-2">
                  <div class="su-field">
                    <label for="owner2_title">Title</label>
                    <input id="owner2_title" name="owner2_title" placeholder="e.g., Partner, VP" />
                  </div>
                  <div class="su-field">
                    <label for="owner2_ssn">SSN (Last 4)</label>
                    <input id="owner2_ssn" name="owner2_ssn_last4" placeholder="••••" inputmode="numeric" maxlength="4" />
                  </div>
                </div>
                <div class="su-field">
                  <label for="owner2_email">Email</label>
                  <input id="owner2_email" name="owner2_email" type="email" placeholder="partner@email.com" />
                </div>
              </div>
            </div>

            <div class="su-pane__actions">
              <button type="button" class="su-btn su-btn--ghost" data-prev><i class="fa-solid fa-arrow-left"></i> Back</button>
              <button type="button" class="su-btn su-btn--primary" data-next>Continue <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </div>

          <!-- Step 3: Processing Profile -->
          <div class="su-pane" data-step="3" hidden>
            <div class="su-pane__header">
              <i class="fa-solid fa-chart-line"></i>
              <div>
                <h3>Processing Profile</h3>
                <p>Help us understand your transaction volume and processing needs.</p>
              </div>
            </div>

            <div class="su-grid-2">
              <div class="su-field">
                <label for="monthly_volume">Estimated Monthly Card Volume <span class="su-req">*</span></label>
                <select required id="monthly_volume" name="monthly_card_volume">
                  <option value="">Select range</option>
                  <option>Under $10,000</option>
                  <option>$10,000 – $25,000</option>
                  <option>$25,000 – $75,000</option>
                  <option>$75,000 – $200,000</option>
                  <option>$200,000 – $500,000</option>
                  <option>$500,000+</option>
                </select>
              </div>
              <div class="su-field">
                <label for="avg_ticket">Average Ticket Size <span class="su-req">*</span></label>
                <input required id="avg_ticket" name="average_ticket" placeholder="e.g., $45.00" />
              </div>
            </div>

            <div class="su-grid-2">
              <div class="su-field">
                <label for="high_ticket">Highest Ticket Size</label>
                <input id="high_ticket" name="highest_ticket" placeholder="e.g., $2,500.00" />
              </div>
              <div class="su-field">
                <label for="cp_pct">Card Present % <span class="su-req">*</span></label>
                <select required id="cp_pct" name="card_present_pct">
                  <option value="">Select</option>
                  <option>100% Card Present</option>
                  <option>75% Present / 25% Not Present</option>
                  <option>50% / 50%</option>
                  <option>25% Present / 75% Not Present</option>
                  <option>100% Card Not Present</option>
                </select>
              </div>
            </div>

            <div class="su-grid-2">
              <div class="su-field">
                <label for="processed_before">Have You Processed Cards Before? <span class="su-req">*</span></label>
                <select required id="processed_before" name="processed_before">
                  <option value="">Select</option>
                  <option>Yes</option>
                  <option>No — New to card processing</option>
                </select>
              </div>
              <div class="su-field">
                <label for="current_processor">Current Processor</label>
                <input id="current_processor" name="current_processor" placeholder="e.g., Square, Stripe, Clover, etc." />
              </div>
            </div>

            <div class="su-grid-2">
              <div class="su-field">
                <label for="chargeback_history">Chargeback History</label>
                <select id="chargeback_history" name="chargeback_history">
                  <option value="">Select</option>
                  <option>None</option>
                  <option>Minimal (1–3 per year)</option>
                  <option>Moderate (4–10 per year)</option>
                  <option>Significant (10+)</option>
                </select>
              </div>
              <div class="su-field">
                <label for="fulfillment_days">Days Between Sale & Fulfillment</label>
                <select id="fulfillment_days" name="fulfillment_days">
                  <option value="">Select</option>
                  <option>Same day</option>
                  <option>1–7 days</option>
                  <option>7–14 days</option>
                  <option>14–30 days</option>
                  <option>30+ days</option>
                </select>
              </div>
            </div>

            <div class="su-field">
              <label for="refund_policy">Refund / Return Policy</label>
              <textarea id="refund_policy" name="refund_policy" rows="2" placeholder="Briefly describe your refund or return policy..."></textarea>
            </div>

            <fieldset class="su-fieldset">
              <legend>Additional Services Needed</legend>
              <div class="su-check-grid">
                <label class="su-checkbox"><input type="checkbox" name="needs_ach" value="yes" /> ACH Payments</label>
                <label class="su-checkbox"><input type="checkbox" name="needs_virtual_terminal" value="yes" /> Virtual Terminal</label>
                <label class="su-checkbox"><input type="checkbox" name="needs_invoicing" value="yes" /> Invoicing</label>
                <label class="su-checkbox"><input type="checkbox" name="needs_online" value="yes" /> Online Payments / eCommerce</label>
                <label class="su-checkbox"><input type="checkbox" name="needs_pos" value="yes" /> POS or Terminal Hardware</label>
                <label class="su-checkbox"><input type="checkbox" name="needs_recurring" value="yes" /> Recurring Billing</label>
              </div>
            </fieldset>

            <div class="su-pane__actions">
              <button type="button" class="su-btn su-btn--ghost" data-prev><i class="fa-solid fa-arrow-left"></i> Back</button>
              <button type="button" class="su-btn su-btn--primary" data-next>Continue <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </div>

          <!-- Step 4: Bank / Funding Information -->
          <div class="su-pane" data-step="4" hidden>
            <div class="su-pane__header su-pane__header--secure">
              <i class="fa-solid fa-building-columns"></i>
              <div>
                <h3>Bank & Funding Information</h3>
                <p>Your bank details are encrypted and used exclusively for deposit setup. We never store sensitive credentials beyond what is required for funding.</p>
              </div>
            </div>

            <div class="su-secure-banner">
              <i class="fa-solid fa-shield-halved"></i>
              <span>This section is protected with 256-bit SSL encryption. Your information is transmitted securely.</span>
            </div>

            <div class="su-grid-2">
              <div class="su-field">
                <label for="bank_name">Bank Name <span class="su-req">*</span></label>
                <input required id="bank_name" name="bank_name" placeholder="e.g., Chase, Wells Fargo, Bank of America" />
              </div>
              <div class="su-field">
                <label for="account_name">Name on Bank Account <span class="su-req">*</span></label>
                <input required id="account_name" name="bank_account_name" placeholder="As it appears on the account" />
              </div>
            </div>

            <div class="su-grid-2">
              <div class="su-field">
                <label for="routing">Routing Number <span class="su-req">*</span></label>
                <div class="su-input-icon">
                  <i class="fa-solid fa-lock"></i>
                  <input required id="routing" name="routing_number" placeholder="•••••••••" inputmode="numeric" pattern="[0-9]{9}" title="Enter 9-digit routing number" maxlength="9" />
                </div>
              </div>
              <div class="su-field">
                <label for="account_type">Account Type <span class="su-req">*</span></label>
                <select required id="account_type" name="account_type">
                  <option value="">Select</option>
                  <option>Checking</option>
                  <option>Savings</option>
                </select>
              </div>
            </div>

            <div class="su-grid-2">
              <div class="su-field">
