    .su-check-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .su-checkbox{display:flex;align-items:center;gap:8px;font-size:.88rem;color:rgba(255,255,255,.7);cursor:pointer;padding:6px 0}
    .su-checkbox input[type="checkbox"]{accent-color:var(--su-cyan);width:16px;height:16px}

    .su-disclosure{margin:20px 0}
    .su-disclosure__toggle{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:var(--su-radius);padding:14px 18px;color:var(--su-cyan);font-family:var(--su-font);font-size:.9rem;font-weight:600;cursor:pointer;width:100%;transition:all .2s}
    .su-disclosure__toggle:hover{background:rgba(255,255,255,.06)}
    .su-disclosure__chevron{margin-left:auto;transition:transform .2s;font-size:.75rem}
    .su-disclosure__toggle[aria-expanded="true"] .su-disclosure__chevron{transform:rotate(180deg)}
    .su-disclosure__body{padding:20px 0 0}

    .su-fieldset--consent{border-color:rgba(255,255,255,.08)}
    .su-fieldset--consent .su-checkbox{padding:8px 0;line-height:1.5}

    .su-pane__actions{display:flex;justify-content:space-between;align-items:center;margin-top:28px;padding-top:20px;border-top:1px solid rgba(255,255,255,.06)}

    .su-prod-section{margin-bottom:20px}
    .su-prod-label{display:block;font-size:.85rem;font-weight:600;color:rgba(255,255,255,.8);margin-bottom:12px}
    .su-prod-filter{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}
    .su-filter-btn{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:99px;padding:8px 18px;font-family:var(--su-font);font-size:.82rem;font-weight:500;color:rgba(255,255,255,.5);cursor:pointer;transition:all .2s}
    .su-filter-btn.active,.su-filter-btn:hover{background:rgba(21,73,255,.15);border-color:var(--su-blue);color:#fff}
    .su-prod-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px;margin-bottom:16px}
    .su-prod-card{position:relative;cursor:pointer;display:block}
    .su-prod-card input[type="radio"]{position:absolute;opacity:0;width:0;height:0}
    .su-prod-card__inner{background:rgba(255,255,255,.03);border:2px solid rgba(255,255,255,.06);border-radius:var(--su-radius);padding:16px;text-align:center;transition:all .25s;display:flex;flex-direction:column;align-items:center;gap:8px;height:100%}
    .su-prod-card__inner img{width:100%;max-width:140px;height:90px;object-fit:contain;border-radius:8px;margin-bottom:4px}
    .su-prod-card__inner strong{font-size:.88rem;color:#fff;display:block}
    .su-prod-card__inner small{font-size:.76rem;color:rgba(255,255,255,.4);line-height:1.4;display:block}
    .su-prod-card__iconbox{width:60px;height:60px;border-radius:12px;background:linear-gradient(135deg,rgba(21,73,255,.15),rgba(0,207,255,.1));display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:var(--su-cyan);margin-bottom:4px}
    .su-prod-card__check{position:absolute;top:10px;right:10px;opacity:0;font-size:1.1rem;color:var(--su-green);transition:opacity .2s}
    .su-prod-card:hover .su-prod-card__inner{border-color:rgba(255,255,255,.15);background:rgba(255,255,255,.05)}
    .su-prod-card input:checked ~ .su-prod-card__inner{border-color:var(--su-cyan);background:rgba(0,207,255,.06);box-shadow:0 0 20px rgba(0,207,255,.1)}
    .su-prod-card input:checked ~ .su-prod-card__check{opacity:1}
    .su-prod-card[hidden]{display:none}

    .su-selected-summary{margin-top:4px}
    .su-selected-summary__inner{display:flex;align-items:center;gap:12px;background:rgba(0,229,160,.06);border:1px solid rgba(0,229,160,.15);border-radius:var(--su-radius);padding:14px 18px}
    .su-selected-summary__inner>i{color:var(--su-green);font-size:1.2rem}
    .su-selected-summary__inner strong{color:#fff;font-size:.92rem;display:block}
    .su-selected-summary__inner small{color:rgba(255,255,255,.4);font-size:.78rem}
    .su-selected-summary__clear{margin-left:auto;background:none;border:1px solid rgba(255,255,255,.15);border-radius:6px;color:rgba(255,255,255,.6);padding:6px 14px;font-size:.8rem;font-family:var(--su-font);cursor:pointer;transition:all .2s}
    .su-selected-summary__clear:hover{border-color:var(--su-cyan);color:var(--su-cyan)}

    .su-review{margin-bottom:24px}
    .su-review__group{margin-bottom:16px}
    .su-review__group h4{font-size:.9rem;font-weight:700;color:var(--su-cyan);margin:0 0 8px;display:flex;align-items:center;gap:8px}
    .su-review__row{display:grid;grid-template-columns:180px 1fr;gap:4px;padding:6px 0;border-bottom:1px solid rgba(255,255,255,.04);font-size:.85rem}
    .su-review__row dt{color:rgba(255,255,255,.45)}
    .su-review__row dd{color:#fff;margin:0}

    .su-success{text-align:center;padding:60px 20px}
    .su-success__icon{font-size:3.5rem;color:var(--su-green);margin-bottom:20px}
    .su-success h3{font-size:1.6rem;font-weight:800;margin:0 0 12px}
    .su-success p{color:rgba(255,255,255,.5);font-size:1rem;max-width:520px;margin:0 auto 36px}
    .su-success__steps{display:flex;gap:20px;justify-content:center;margin-bottom:36px;flex-wrap:wrap}
    .su-success__step{display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);border-radius:var(--su-radius);padding:16px 20px}
    .su-success__num{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--su-blue),var(--su-blue-mid));display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0}
    .su-success__step strong{font-size:.88rem;display:block}
    .su-success__step small{font-size:.78rem;color:rgba(255,255,255,.4)}
    .su-success__ctas{display:flex;gap:16px;justify-content:center}

    .su-why{padding:80px 24px;background:var(--su-navy2)}
    .su-why__inner{max-width:1100px;margin:0 auto;text-align:center}
    .su-why__inner h2{font-size:clamp(1.6rem,3vw,2.2rem);font-weight:800;margin-bottom:48px}
    .su-why__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
    .su-why__card{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);border-radius:var(--su-radius);padding:32px 24px;text-align:left;transition:all .3s}
    .su-why__card:hover{border-color:rgba(0,207,255,.2);transform:translateY(-4px)}
    .su-why__card i{font-size:1.4rem;color:var(--su-cyan);margin-bottom:16px;display:block}
    .su-why__card h4{font-size:1rem;font-weight:700;margin:0 0 8px}
    .su-why__card p{font-size:.88rem;color:rgba(255,255,255,.45);line-height:1.6;margin:0}

    .su-faq{padding:80px 24px;background:var(--su-navy)}
    .su-faq__inner{max-width:780px;margin:0 auto}
    .su-faq__inner h2{text-align:center;font-size:clamp(1.6rem,3vw,2.2rem);font-weight:800;margin-bottom:40px}
    .su-faq__item{border:1px solid rgba(255,255,255,.06);border-radius:var(--su-radius);margin-bottom:12px;overflow:hidden}
    .su-faq__item summary{padding:18px 20px;font-weight:600;font-size:.95rem;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;transition:background .2s}
    .su-faq__item summary::-webkit-details-marker{display:none}
    .su-faq__item summary::after{content:'+';font-size:1.2rem;color:var(--su-cyan);transition:transform .2s}
    .su-faq__item[open] summary::after{content:'-'}
    .su-faq__item summary:hover{background:rgba(255,255,255,.03)}
    .su-faq__item p{padding:0 20px 18px;margin:0;font-size:.9rem;color:rgba(255,255,255,.55);line-height:1.7}

    .su-mobile-sticky{display:none;position:fixed;bottom:0;left:0;right:0;padding:12px 16px;background:rgba(6,14,33,.95);backdrop-filter:blur(12px);border-top:1px solid rgba(255,255,255,.06);z-index:100}

    @media(max-width:900px){
      .su-hero__inner{grid-template-columns:1fr;gap:40px}
      .su-hero__journey{max-width:420px}
      .su-process__grid{flex-direction:column}
      .su-process__arrow{transform:rotate(90deg)}
      .su-why__grid{grid-template-columns:1fr 1fr}
      .su-grid-2{grid-template-columns:1fr}
      .su-check-grid{grid-template-columns:1fr}
      .su-prod-grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}
    }
    @media(max-width:600px){
      .su-hero{padding:60px 16px 40px}
      .su-hero__text h1{font-size:1.8rem}
      .su-hero__ctas{flex-direction:column}
      .su-hero__ctas .su-btn{justify-content:center}
      .su-form{padding:20px 16px}
      .su-why__grid{grid-template-columns:1fr}
      .su-success__steps{flex-direction:column;align-items:center}
      .su-mobile-sticky{display:block}
      .su-stepper__label{display:none}
      .su-prod-grid{grid-template-columns:1fr 1fr;gap:10px}
      .su-prod-card__inner{padding:12px}
      .su-prod-card__inner img{max-width:100px;height:65px}
      .su-prod-filter{gap:6px}
      .su-filter-btn{padding:6px 12px;font-size:.78rem}
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded',()=>{
      const form=document.getElementById('appForm');
      const panes=[...form.querySelectorAll('.su-pane')];
      const total=panes.length;
      let cur=0;
      const fill=document.getElementById('stepperFill');
      const stepBtns=[...form.querySelectorAll('[data-step-btn]')];
      const statusEl=document.getElementById('formStatus');
      const successEl=document.getElementById('successState');
      let initialized=false;

      function showStep(idx,scroll){
        cur=idx;
        panes.forEach((p,i)=>{p.hidden=i!==cur;});
        fill.style.width=((cur/(total-1))*100)+'%';
        stepBtns.forEach((b,i)=>{
          b.classList.remove('active','done');
          b.removeAttribute('aria-current');
          if(i<cur)b.classList.add('done');
          if(i===cur){b.classList.add('active');b.setAttribute('aria-current','step');}
        });
        if(cur===total-1)buildReview();
        if(scroll&&initialized){
          form.scrollIntoView({behavior:'smooth',block:'start'});
          const heading=panes[cur].querySelector('h3');
          if(heading){heading.setAttribute('tabindex','-1');heading.focus({preventScroll:true});}
        }
      }

      function validatePane(idx){
        const pane=panes[idx];
        let valid=true;

        if(idx===0){
          const ind=pane.querySelector('#industry');
          ind.classList.remove('su-invalid');ind.removeAttribute('aria-invalid');
          if(!ind.value){ind.classList.add('su-invalid');ind.setAttribute('aria-invalid','true');valid=false;}
          const radios=pane.querySelectorAll('input[name="selected_product"]');
          let productSelected=false;
          radios.forEach(r=>{if(r.checked)productSelected=true;});
          if(!productSelected){
            valid=false;
            const grid=pane.querySelector('#prodGrid');
            if(grid&&!pane.querySelector('.su-invalid'))grid.classList.add('su-invalid');
          } else {
            const grid=pane.querySelector('#prodGrid');
            if(grid)grid.classList.remove('su-invalid');
          }
        } else {
          const fields=pane.querySelectorAll('[required]');
          fields.forEach(f=>{
            f.classList.remove('su-invalid');f.removeAttribute('aria-invalid');
            if(f.type==='checkbox'){
              if(!f.checked){f.classList.add('su-invalid');f.setAttribute('aria-invalid','true');valid=false;}
            } else if(!f.value.trim()||(f.type==='email'&&!f.checkValidity())||(f.pattern&&!new RegExp(f.pattern).test(f.value))){
              f.classList.add('su-invalid');f.setAttribute('aria-invalid','true');valid=false;
            }
          });
        }

        if(idx===4){
          const acct=pane.querySelector('#account_num');
          const confirm=pane.querySelector('#account_confirm');
          if(acct&&confirm&&acct.value&&confirm.value&&acct.value!==confirm.value){
            confirm.classList.add('su-invalid');confirm.setAttribute('aria-invalid','true');
            valid=false;
            statusEl.textContent='Account numbers do not match.';
            statusEl.setAttribute('role','alert');
            confirm.focus();
            return false;
          }
        }

        if(!valid){
          const first=panes[idx].querySelector('.su-invalid');
          if(first)first.focus();
          statusEl.textContent='Please fill in all required fields before continuing.';
          statusEl.setAttribute('role','alert');
        }else{
          statusEl.textContent='';statusEl.removeAttribute('role');
        }
        return valid;
      }

      form.querySelectorAll('[data-next]').forEach(b=>b.addEventListener('click',e=>{
        e.preventDefault();
        if(validatePane(cur)&&cur<total-1)showStep(cur+1,true);
      }));
      form.querySelectorAll('[data-prev]').forEach(b=>b.addEventListener('click',e=>{
        e.preventDefault();
        if(cur>0)showStep(cur-1,true);
      }));
      stepBtns.forEach(b=>b.addEventListener('click',()=>{
        const target=parseInt(b.dataset.stepBtn)-1;
        if(target<cur)showStep(target,true);
      }));

      const filterBtns=[...document.querySelectorAll('.su-filter-btn')];
      const prodCards=[...document.querySelectorAll('.su-prod-card')];
      filterBtns.forEach(b=>b.setAttribute('aria-pressed',b.classList.contains('active')?'true':'false'));
      filterBtns.forEach(btn=>btn.addEventListener('click',()=>{
        filterBtns.forEach(b=>{b.classList.remove('active');b.setAttribute('aria-pressed','false');});
        btn.classList.add('active');btn.setAttribute('aria-pressed','true');
        const cat=btn.dataset.cat;
        prodCards.forEach(c=>{
          if(cat==='all'||c.dataset.cat===cat){c.hidden=false;}else{c.hidden=true;}
        });
      }));

      const summaryEl=document.getElementById('selectedSummary');
      const nameEl=document.getElementById('selectedName');
      const clearBtn=document.getElementById('clearSelection');
      const prodRadios=[...form.querySelectorAll('input[name="selected_product"]')];

      prodRadios.forEach(r=>r.addEventListener('change',()=>{
        nameEl.textContent=r.value;
        summaryEl.hidden=false;
      }));
      clearBtn.addEventListener('click',()=>{
        prodRadios.forEach(r=>{r.checked=false;});
        summaryEl.hidden=true;
        nameEl.textContent='';
      });

      const addOwnerToggle=document.getElementById('addOwnerToggle');
      const addOwnerBody=document.getElementById('addOwnerBody');
      if(addOwnerToggle){
        addOwnerToggle.addEventListener('click',()=>{
          const expanded=addOwnerToggle.getAttribute('aria-expanded')==='true';
          addOwnerToggle.setAttribute('aria-expanded',String(!expanded));
          addOwnerBody.hidden=expanded;
        });
      }

      function buildReview(){
        const data=new FormData(form);
        const groups=[
          {title:'Solution',icon:'fa-compass',fields:[['Industry','industry'],['Selected Product','selected_product']]},
          {title:'Business',icon:'fa-building',fields:[['Legal Name','legal_name'],['DBA','dba'],['Entity Type','entity_type'],['Years in Business','years_in_business'],['EIN','ein'],['State of Inc.','state_of_incorporation'],['Phone','business_phone'],['Email','business_email'],['Website','website'],['Address','business_address'],['Mailing Address','mailing_address'],['Locations','number_of_locations'],['Sales Channels','sales_channels'],['Products/Services','products_services']]},
          {title:'Owner',icon:'fa-user-tie',fields:[['Name','owner_name'],['Title','owner_title'],['Ownership %','ownership_pct'],['DOB','owner_dob'],['SSN Last 4','owner_ssn_last4'],['Mobile','owner_mobile'],['Email','owner_email'],['Address','owner_home_address']]},
          {title:'Processing',icon:'fa-chart-line',fields:[['Monthly Volume','monthly_card_volume'],['Avg Ticket','average_ticket'],['High Ticket','highest_ticket'],['Card Present %','card_present_pct'],['Processed Before','processed_before'],['Current Processor','current_processor'],['Chargeback History','chargeback_history'],['Fulfillment Days','fulfillment_days'],['Refund Policy','refund_policy']]},
          {title:'Banking',icon:'fa-building-columns',fields:[['Bank Name','bank_name'],['Account Name','bank_account_name'],['Routing','routing_number'],['Account Type','account_type'],['Account #','account_number']]}
        ];
        let html='';
        groups.forEach(g=>{
          let rows='';
          g.fields.forEach(([label,name])=>{
            const val=data.get(name);
            if(val)rows+=`<div class="su-review__row"><dt>${label}</dt><dd>${val.replace(/</g,'&lt;')}</dd></div>`;
          });
          if(rows)html+=`<div class="su-review__group"><h4><i class="fa-solid ${g.icon}"></i> ${g.title}</h4><dl>${rows}</dl></div>`;
        });
        document.getElementById('reviewSummary').innerHTML=html;
      }

      form.addEventListener('submit',async(e)=>{
        e.preventDefault();
        if(!validatePane(cur))return;
        const btn=document.getElementById('submitBtn');
        btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Submitting...';
        try{
          const resp=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{'Accept':'application/json'}});
          if(resp.ok){
            form.hidden=true;
            document.querySelector('.su-stepper').hidden=true;
            successEl.hidden=false;
            successEl.scrollIntoView({behavior:'smooth',block:'start'});
          }else{throw new Error();}
        }catch(err){
          btn.disabled=false;btn.innerHTML='<i class="fa-solid fa-paper-plane"></i> Submit Application';
          statusEl.textContent='Something went wrong. Please try again.';statusEl.setAttribute('role','alert');
        }
      });

      showStep(0,false);
      initialized=true;

      const mobileCta=document.getElementById('mobileCta');
      if(mobileCta&&window.innerWidth<=600){
        const formSection=document.getElementById('application');
        const obs=new IntersectionObserver(([e])=>{mobileCta.style.display=e.isIntersecting?'none':'block';},{threshold:0.1});
        obs.observe(formSection);
      }
    });
  </script>

</BaseLayout>
