      .signup-card{padding:12px}
      .signup-deal-visual{height:150px}
      .signup-deal-foot{justify-content:flex-start}
    }
  </style>

  <script is:inline>
    // @ts-nocheck
    document.addEventListener('DOMContentLoaded', () => {
      (() => {
        const rail = document.getElementById('rail');
        const slides = Array.from(rail.querySelectorAll('.signup-slide'));
        const dotsWrap = document.getElementById('dots');
        const prev = document.getElementById('prev');
        const next = document.getElementById('next');
        let i = 0;

        slides.forEach((_, idx) => {
          const d = document.createElement('button');
          d.className = 'signup-dot';
          d.type = 'button';
          d.setAttribute('aria-label', 'Go to slide ' + (idx + 1));
          d.addEventListener('click', () => go(idx));
          dotsWrap.appendChild(d);
        });

        function width() {
          return slides[0].getBoundingClientRect().width + 14;
        }

        function update() {
          dotsWrap.querySelectorAll('.signup-dot').forEach((d, idx) =>
            d.setAttribute('aria-current', idx === i ? 'true' : 'false')
          );
          prev.disabled = i === 0;
          next.disabled = i >= slides.length - 1;
        }

        function go(n) {
          i = Math.max(0, Math.min(slides.length - 1, n));
          rail.scrollTo({ left: width() * i, behavior: 'smooth' });
          update();
        }

        prev.addEventListener('click', () => go(i - 1));
        next.addEventListener('click', () => go(i + 1));
        window.addEventListener('resize', update);
        update();
      })();

      (() => {
        const dualModal = document.getElementById('dualModal');
        document.getElementById('openDual')?.addEventListener('click', (e) => {
          e.preventDefault();
          dualModal.showModal();
        });
        document.getElementById('closeDual')?.addEventListener('click', () => dualModal.close());
      })();

      (() => {
        const form = document.getElementById('appForm');
        const panes = form.querySelectorAll('.signup-step-pane[data-step]');
        const steps = document.querySelectorAll('.signup-form-steps .signup-stepper-pill');
        const thankyou = document.getElementById('thankyouBlock');
        const statusEl = document.getElementById('formStatus');
        let idx = 0;

        thankyou.hidden = true;
        form.hidden = false;

        function show(i) {
          idx = Math.max(0, Math.min(panes.length - 1, i));
          panes.forEach((p, j) => p.hidden = j !== idx);
          steps.forEach((s, j) => s.classList.toggle('active', j === idx));
          form.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        form.querySelectorAll('[data-next]').forEach((b) => b.addEventListener('click', (e) => {
          e.preventDefault();
          if (idx < panes.length - 1) show(idx + 1);
        }));

        form.querySelectorAll('[data-prev]').forEach((b) => b.addEventListener('click', (e) => {
          e.preventDefault();
          if (idx > 0) show(idx - 1);
        }));

        form.querySelectorAll('input[type="checkbox"][name="hardware[]"]').forEach((cb) => {
          const qtyId = cb.getAttribute('data-qty');
          const qtySel = qtyId ? document.getElementById(qtyId) : null;
          const sync = () => {
            if (qtySel) qtySel.disabled = !cb.checked;
          };
          cb.addEventListener('change', sync);
          sync();
        });

        function hasHardwareSelection() {
          return !!form.querySelector('input[name="hardware[]"]:checked');
        }

        form.addEventListener('submit', async (e) => {
          if (!form.checkValidity()) {
            return;
          }

          if (!hasHardwareSelection()) {
            e.preventDefault();
            alert('Please select at least one piece of equipment.');
            return;
          }

          e.preventDefault();
          statusEl.textContent = '';
          const btn = form.querySelector('[type="submit"]');
          if (btn) btn.disabled = true;

          try {
            const res = await fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              headers: { 'Accept': 'application/json' }
            });

            if (res.ok) {
              form.reset();
              form.querySelectorAll('select[id^="qty_"]').forEach((s) => s.disabled = true);
              form.hidden = true;
              thankyou.hidden = false;
              window.scrollTo({
                top: thankyou.getBoundingClientRect().top + window.scrollY - 40,
                behavior: 'smooth'
              });
            } else {
              statusEl.textContent = 'Something went wrong submitting your application. Please try again or email sales@ppdtechnology.com.';
              if (btn) btn.disabled = false;
            }
          } catch (err) {
            statusEl.textContent = 'Network error. Please try again.';
            if (btn) btn.disabled = false;
          }
        });

        document.getElementById('newAppBtn')?.addEventListener('click', () => {
          thankyou.hidden = true;
          form.hidden = false;
          show(0);
        });

        show(0);
      })();
    });
  </script>
</BaseLayout>