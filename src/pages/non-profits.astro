---
import Landing from '../components/Landing.astro';
import FormExtras from '../components/FormExtras.astro';

const features = [
  { title: 'Recurring gifts and pledges', body: 'Monthly, quarterly or annual giving with reminders and easy updates.' },
  { title: 'Donor covers fees', body: 'Let supporters opt in to cover fees, so more of every gift reaches your mission.' },
  { title: 'Event and QR giving', body: 'Event pages with QR codes and live totals for galas, pop-ups and drives.' },
  { title: 'Text to give', body: 'Assign a keyword, track campaigns and invite recurring support from any phone.' },
  { title: 'Instant tax receipts', body: 'Automatic receipt emails, plus annual summaries for your donors.' },
  { title: 'Chapters and sub-accounts', body: 'Separate deposits and dashboards for each chapter, with headquarters seeing all of it.' },
];
---

<Landing
  title="Nonprofit donations and payments | PPD Technology"
  description="Accept donations on your website, at events, by QR code and by text, with recurring gifts and chapter accounts. $0 monthly platform fees for eligible nonprofits."
  accent={{ rgb: '225, 29, 72', main: '#e11d48', soft: '#ff8fa6' }}
  eyebrow="Non-profits"
  headline={['Raise more.', 'Spend less doing it.']}
  lede="Accept donations anywhere: your website, events, QR codes and text to give. Built for volunteers, chapters and growing organizations."
  cta={[{ label: 'Talk to us', href: '#demo' }, { label: 'Start an application', href: '/signup' }]}
  chips={['Museums and arts', 'Youth programs', 'Shelters', 'Community chapters']}
  statement="A gift should take a donor seconds, and reach your mission with as little taken out along the way as possible."
  featuresHead={{ eyebrow: 'Donor-first features', title: 'Run every fundraiser from one place.' }}
  features={features}
  pricing={{
    label: 'For eligible 501(c)(3) organizations',
    price: '$0',
    unit: 'monthly platform fees for eligible nonprofits.',
    includes: ['Donation pages, event QR and text to give', 'Recurring gifts and pledges', 'Donor-covered fees', 'Chapter sub-accounts with central reporting'],
    note: 'Eligibility is confirmed when you apply. Card processing rates are quoted separately.',
  }}
  form={{ tag: 'nonprofit-inquiry', subject: 'New Nonprofit Inquiry', title: 'Tell us about your organization.', lede: 'We will confirm eligibility and show you how donations, recurring gifts and chapters would be set up.', cta: 'Send' }}
>
  <Fragment slot="fields">
    <FormExtras id="np" city topics={['Online donations', 'Events and QR', 'Text to give', 'Recurring gifts']} />
  </Fragment>
</Landing>
