  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const sections = document.querySelectorAll(".pays-section");
      const features = document.querySelectorAll(".pays-feature");
      const products = document.querySelectorAll(".pays-product");
      const specCards = document.querySelectorAll(".pays-spec-card, .pays-callout");

      const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");

          if (entry.target.id === "pays-software") {
            features.forEach((item, index) => {
              window.setTimeout(() => item.classList.add("is-animated"), index * 100);
            });
          }

          if (entry.target.id === "pays-hardware") {
            products.forEach((item, index) => {
              window.setTimeout(() => item.classList.add("is-animated"), index * 100);
            });

            specCards.forEach((item, index) => {
              window.setTimeout(() => item.classList.add("is-animated"), index * 100);
            });
          }
        });
      }, { threshold: 0.1 });

      sections.forEach((section) => sectionObserver.observe(section));

      const particlesContainer = document.getElementById("paysParticles");
      if (particlesContainer instanceof HTMLElement) {
        for (let i = 0; i < 15; i += 1) {
          const particle = document.createElement("div");
          particle.className = "pays-particle";
          const size = Math.random() * 20 + 5;
          particle.style.width = `${size}px`;
          particle.style.height = `${size}px`;
          particle.style.left = `${Math.random() * 100}%`;
          particle.style.animationDelay = `${Math.random() * 15}s`;
          particle.style.animationDuration = `${Math.random() * 10 + 10}s`;
          particlesContainer.appendChild(particle);
        }
      }

      const slides = Array.from(document.querySelectorAll(".pays-slide"));
      let slideIndex = 0;

      if (slides.length > 1) {
        window.setInterval(() => {
          slides[slideIndex]?.classList.remove("is-active");
          slideIndex = (slideIndex + 1) % slides.length;
          slides[slideIndex]?.classList.add("is-active");
        }, 3600);
      }

      const frame = document.getElementById("paysDeviceFrame");
      if (frame instanceof HTMLElement && window.matchMedia("(pointer:fine)").matches) {
        const handleTilt = (event: MouseEvent) => {
          const rect = frame.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const centerY = rect.top + rect.height / 2;
          const dx = (event.clientX - centerX) / rect.width;
          const dy = (event.clientY - centerY) / rect.height;
          const rotateY = dx * 10;
          const rotateX = -dy * 8;
          frame.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        };

        const resetTilt = () => {
          frame.style.transform = "rotateX(0deg) rotateY(0deg)";
        };

        frame.addEventListener("mousemove", handleTilt);
        frame.addEventListener("mouseleave", resetTilt);
      }

      const modal = document.getElementById("paysDemoModal");
      const openButtons = document.querySelectorAll(".js-open-demo");
      const closeButton = document.getElementById("paysCloseModal");
      const cancelButton = document.getElementById("paysCancelModal");

      const openModal = () => {
        if (!(modal instanceof HTMLElement)) return;
        modal.classList.add("is-open");
        document.body.style.overflow = "hidden";
      };

      const closeModal = () => {
        if (!(modal instanceof HTMLElement)) return;
        modal.classList.remove("is-open");
        document.body.style.overflow = "";
      };

      openButtons.forEach((button) => {
        button.addEventListener("click", openModal);
      });

      closeButton?.addEventListener("click", closeModal);
      cancelButton?.addEventListener("click", closeModal);

      if (modal instanceof HTMLElement) {
        modal.addEventListener("click", (event: MouseEvent) => {
          if (event.target === modal) {
            closeModal();
          }
        });
      }

      document.addEventListener("keydown", (event: KeyboardEvent) => {
        if (event.key === "Escape") {
          closeModal();
        }
      });

      const paysForm = document.getElementById("paysDemoForm");
      if (paysForm instanceof HTMLFormElement) {
        paysForm.addEventListener("submit", async (event: SubmitEvent) => {
          event.preventDefault();
          const submitBtn = paysForm.querySelector('button[type="submit"]');
          const originalText = submitBtn instanceof HTMLButtonElement ? submitBtn.innerHTML : "";
          if (submitBtn instanceof HTMLButtonElement) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending…';
          }
          try {
            const data = new FormData(paysForm);
            data.append("_page", window.location.pathname);
            const res = await fetch("/api/lead", { method: "POST", body: data });
            if (!res.ok) throw new Error("Network");
            window.location.href = "/thank-you";
          } catch {
            window.alert("Sorry, something went wrong sending your request. Please email info@ppdtechnology.com and we'll help right away.");
            if (submitBtn instanceof HTMLButtonElement) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = originalText;
            }
          }
        });
      }

      let demoInterval: ReturnType<typeof window.setInterval> | null = null;
      let currentStep = 0;
      let speed = 1500;

      const startBtn = document.getElementById("paysStartDemo");
      const resetBtn = document.getElementById("paysResetDemo");
      const speedControl = document.getElementById("paysSpeedControl");
      const demoSteps = Array.from(document.querySelectorAll(".pays-demo-step"));
      const lines = [document.getElementById("paysLine1"), document.getElementById("paysLine2")];
      const paymentSuccess = document.getElementById("paysPaymentSuccess");

      const clearDemo = () => {
        demoSteps.forEach((step) => step.classList.remove("is-active"));
        lines.forEach((line) => line?.classList.remove("is-active"));
        paymentSuccess?.classList.remove("is-active");
      };

      const stopDemo = () => {
        if (demoInterval !== null) {
          window.clearInterval(demoInterval);
          demoInterval = null;
        }
        if (startBtn instanceof HTMLButtonElement) startBtn.disabled = false;
        if (resetBtn instanceof HTMLButtonElement) resetBtn.disabled = false;
      };

      const tickDemo = () => {
        if (currentStep < demoSteps.length) {
          demoSteps.forEach((step) => step.classList.remove("is-active"));
          demoSteps[currentStep]?.classList.add("is-active");

          for (let i = 0; i < currentStep; i += 1) {
            lines[i]?.classList.add("is-active");
          }

          currentStep += 1;
        } else {
          stopDemo();
          window.setTimeout(() => paymentSuccess?.classList.add("is-active"), 400);
        }
      };

      const startDemo = () => {
        stopDemo();
        if (speedControl instanceof HTMLSelectElement) {
          speed = Number.parseInt(speedControl.value, 10);
        }
        currentStep = 0;
        clearDemo();
        if (startBtn instanceof HTMLButtonElement) startBtn.disabled = true;
        if (resetBtn instanceof HTMLButtonElement) resetBtn.disabled = true;
        demoInterval = window.setInterval(tickDemo, speed);
      };

      const resetDemo = () => {
        stopDemo();
        currentStep = 0;
        clearDemo();
      };

      if (startBtn instanceof HTMLButtonElement) {
        const startHandler = (event: Event) => {
          event.preventDefault();
          startDemo();
        };

        startBtn.addEventListener("click", startHandler);
        startBtn.addEventListener("touchstart", startHandler, { passive: false });
      }

      if (resetBtn instanceof HTMLButtonElement) {
        const resetHandler = (event: Event) => {
          event.preventDefault();
          resetDemo();
        };

        resetBtn.addEventListener("click", resetHandler);
        resetBtn.addEventListener("touchstart", resetHandler, { passive: false });
      }

      if (speedControl instanceof HTMLSelectElement) {
        speedControl.addEventListener("change", () => {
          const running = demoInterval !== null;
          if (running) {
            stopDemo();
            startDemo();
          } else {
            speed = Number.parseInt(speedControl.value, 10);
          }
        });
      }
    });
  </script>
</BaseLayout>