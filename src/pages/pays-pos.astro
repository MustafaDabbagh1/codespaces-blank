---
import Landing from '../components/Landing.astro';
import FormExtras from '../components/FormExtras.astro';
import KdsDemo from '../components/demos/KdsDemo.astro';

const features = [
  { title: 'Online ordering', body: 'Take orders from your own site and send them straight to the kitchen.' },
  { title: 'QR menus and pay', body: 'Guests scan, order, split and tip from the table.' },
  { title: 'Kitchen display', body: 'Route by station, hold and fire, and track make times.' },
  { title: 'Inventory and recipes', body: 'Know what you have, what it costs and when to reorder.' },
  { title: 'Delivery integrations', body: 'Delivery app orders arrive in the same queue as everything else.' },
  { title: 'Cash Discount Pro', body: 'Offer a cash discount to offset card fees, with pricing that adjusts automatically.' },
];
const hardware = [
  { name: 'Pays POS terminal', note: '13-inch all-in-one countertop station.', img: '/images/hw/pos-terminal.webp' },
  { name: 'Handheld POS', note: 'Orders and payments at the table.', img: '/images/hw/handheld.webp' },
  { name: 'Self-order kiosk', note: 'Self-service ordering for the front of the line.', img: '/images/hw/kiosk.webp' },
  { name: 'Kitchen printer', note: 'Thermal tickets for the line.', img: '/images/hw/kitchen-printer.webp' },
  { name: 'Cash drawer', note: 'Five-bill drawer that connects to the terminal.', img: '/images/hw/cash-drawer.webp' },
];
---

<Landing
  title="Pays POS for restaurants | PPD Technology"
  description="Pays POS: restaurant point of sale with online ordering, QR pay, kitchen display and handhelds. $59.99 per month with PPD processing."
  accent={{ rgb: '255, 106, 0', main: '#ff6a00', soft: '#ffb057' }}
  eyebrow="Pays POS"
  headline={['Fast, flexible and', 'built for restaurants.']}
  lede="From front counter to kitchen, Pays POS brings payments, orders and operations together. Add handhelds, printers and kiosks as you grow."
  cta={[{ label: 'Get a demo', href: '#demo' }, { label: 'Free rate review', href: '/rate-review' }]}
  chips={['Offline mode', 'QR and tap to pay', 'Kitchen display', 'Real-time sync']}
  featuresHead={{ eyebrow: 'Software', title: 'Every module included.' }}
  features={features}
  gear={{ eyebrow: 'Hardware', title: 'Start with a terminal. Add as you grow.', items: hardware }}
  pricing={{
    label: 'Pricing with PPD processing',
    price: '$59.99',
    unit: 'per month for the software, all modules included.',
    includes: ['Hardware bundle: $899', 'In-person payments: 2.6% + 10¢', 'Online and keyed payments: 2.9% + 25¢', 'Setup and support from PPD'],
    note: 'Your quote confirms the exact pricing and hardware for your restaurant.',
  }}
  form={{ tag: 'pays-pos-demo', subject: 'New Pays POS Demo Request', title: 'See Pays POS run your menu.', lede: 'Tell us how you serve and we will walk you through ordering, the kitchen and checkout.', cta: 'Get a demo' }}
>
  <img slot="visual" src="/images/hw/pays-pos.webp" alt="Pays POS dual-screen terminal" width="900" height="900" />

  <section class="section" slot="demo">
    <div class="wrap demo-block">
      <div class="section-head">
        <p class="eyebrow reveal">Kitchen display</p>
        <h2 class="h-1 reveal" style="--i:1">Order placed. Ticket routed.</h2>
      </div>
      <div class="demo-block__stage reveal"><KdsDemo /></div>
    </div>
  </section>

  <Fragment slot="fields">
    <FormExtras id="pays" city time />
  </Fragment>
</Landing>
