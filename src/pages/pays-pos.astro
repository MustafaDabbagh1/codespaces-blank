---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PPD Technology | Pays POS & Accessories" description="Pays POS system and accessories. Affordable, powerful point of sale hardware and software for small businesses and retail stores.">
  <style>
    .pays-page{
      --pays-ink:#101214;
      --pays-orange:#ff6a00;
      --pays-orange-2:#ff8a1d;
      --pays-ember:#b24200;
      --pays-cream:#fff7ef;
      --pays-paper:#ffffff;
      --pays-line:#ece6de;
      --pays-accent:#12b886;
      --pays-shadow:0 14px 40px rgba(16,18,20,.12);
      --pays-soft:0 10px 28px rgba(16,18,20,.08);
      --pays-tint:#fff2e8;
      --pays-toast-tint:#f3f4f6;
      --pays-border:#ff8a1d;
      background:var(--pays-cream);
      color:var(--pays-ink);
    }

    .pays-page *{box-sizing:border-box}
    .pays-page a{text-decoration:none;color:inherit}

    .pays-shell{
      max-width:1200px;
      margin:0 auto;
      padding:0 clamp(18px,6vw,28px);
    }

    .pays-btn{
      padding:10px 18px;
      border-radius:12px;
      font-weight:800;
      font-size:14px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      transition:.22s;
      cursor:pointer;
      position:relative;
      overflow:hidden;
      border:none;
      text-decoration:none;
    }

    .pays-btn-outline{
      border:1px solid var(--pays-line);
      background:#fff;
      color:var(--pays-ink);
    }

    .pays-btn-outline:hover{
      border-color:var(--pays-orange);
      color:var(--pays-orange);
      transform:translateY(-2px);
      box-shadow:0 5px 15px rgba(255,106,0,0.1);
    }

    .pays-btn-primary{
      background:linear-gradient(90deg,var(--pays-orange),var(--pays-orange-2));
      border:1px solid var(--pays-orange);
      color:#fff;
      box-shadow:0 10px 24px rgba(255,106,0,.25);
    }

    .pays-btn-primary:hover{
      filter:brightness(.98) saturate(1.05);
      transform:translateY(-2px);
      box-shadow:0 12px 20px rgba(255,106,0,.35);
    }

    .pays-hero{
      position:relative;
      isolation:isolate;
      min-height:calc(100vh - 80px);
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
      padding:40px 0;
      background:
        radial-gradient(1000px 600px at 110% -10%, rgba(255,255,255,.35), transparent 60%),
        linear-gradient(160deg, #fff3e4 0%, #ffe1c5 35%, #ffd3a6 70%, #ffc48a 100%);
      animation:pays-gradient-shift 15s ease infinite;
    }

    .pays-hero::before{
      content:"";
      position:absolute;
      inset:0;
      opacity:.45;
      pointer-events:none;
      background:radial-gradient(circle at 1px 1px, rgba(255,138,29,.12) 1px, transparent 0) 0 0/18px 18px;
      animation:pays-float 20s linear infinite;
    }

    .pays-particles{
      position:absolute;
      inset:0;
      overflow:hidden;
      z-index:1;
    }

    .pays-particle{
      position:absolute;
      background:rgba(255,106,0,0.1);
      border-radius:50%;
      animation:pays-float-particle 15s linear infinite;
    }

    .pays-hero .pays-shell{
      position:relative;
      z-index:2;
      width:100%;
    }

    .pays-hero-grid{
      display:grid;
      grid-template-columns:1.1fr .9fr;
      gap:32px;
      align-items:center;
    }

    @media(max-width:960px){
      .pays-hero-grid{
        grid-template-columns:1fr;
        text-align:center;
      }
    }

    .pays-eyebrow{
      display:inline-flex;
      gap:8px;
      align-items:center;
      background:rgba(255,138,29,.08);
      border:1px solid rgba(255,138,29,.35);
      padding:6px 10px;
      border-radius:999px;
      font-size:12px;
      font-weight:900;
      color:var(--pays-ember);
      animation:pays-bounce 2s infinite;
    }

    .pays-page h1{
      font-family:Spectral, serif;
      font-weight:800;
      letter-spacing:.2px;
      font-size:44px;
      line-height:1.12;
      margin:20px 0 16px;
      color:#1c0f03;
      opacity:0;
      transform:translateY(20px);
      animation:pays-fade-up 1s .3s forwards;
    }

    .pays-hero-copy p{
      max-width:640px;
      color:#502f10;
      margin-bottom:16px;
      opacity:0;
      transform:translateY(20px);
      animation:pays-fade-up 1s .5s forwards;
    }

    .pays-badge-row{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      margin:20px 0 28px;
      opacity:0;
      transform:translateY(20px);
      animation:pays-fade-up 1s .7s forwards;
    }

    .pays-badge{
      font-size:12px;
      border:1px solid rgba(255,138,29,.35);
      padding:6px 10px;
      border-radius:999px;
      background:rgba(255,255,255,.7);
      transition:all .3s ease;
    }

    .pays-badge:hover{
      transform:translateY(-2px);
      box-shadow:0 5px 10px rgba(255,106,0,0.1);
    }

    .pays-actions{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      margin-bottom:16px;
      opacity:0;
      transform:translateY(20px);
      animation:pays-fade-up 1s .9s forwards;
    }

    .pays-muted{
      color:#7b624a;
      margin-top:10px;
    }

    @media (max-width:768px){
      .pays-hero{
        min-height:auto;
        padding:60px 0;
      }

      .pays-page h1{
        font-size:36px;
        margin:16px 0 12px;
      }

      .pays-actions{
        flex-direction:column;
        width:100%;
        gap:10px;
      }

      .pays-actions .pays-btn{
        width:100%;
      }

      .pays-badge-row{
        justify-content:center;
        margin:16px 0 24px;
      }
    }

    .pays-plate{
      position:relative;
      background:transparent;
      border:none;
      box-shadow:none;
      perspective:1000px;
      opacity:0;
      transform:translateY(20px);
      animation:pays-fade-up 1s 1.1s forwards;
    }

    .pays-frame{
      position:relative;
      width:100%;
      height:460px;
      display:flex;
      align-items:center;
      justify-content:center;
      transform-style:preserve-3d;
      transition:transform .2s ease;
    }

    @media (max-width:768px){
      .pays-frame{height:320px}
    }

    .pays-slide{
      position:absolute;
      inset:0;
      background-size:contain;
      background-position:center;
      background-repeat:no-repeat;
      opacity:0;
      transform:scale(1.02) translateZ(40px);
      transition:opacity .9s ease, transform 1.2s ease;
      filter:drop-shadow(0 28px 50px rgba(16,18,20,.35));
    }

    .pays-slide.is-active{
      opacity:1;
      transform:scale(1) translateZ(60px);
    }

    .pays-device-shadow{
      position:absolute;
      bottom:-12px;
      left:50%;
      transform:translateX(-50%);
      width:68%;
      height:26px;
      border-radius:50%;
      background:radial-gradient(closest-side, rgba(0,0,0,.24), transparent 70%);
      filter:blur(6px);
      animation:pays-float 6s ease-in-out infinite 1.2s;
    }

    .pays-beams{
      position:absolute;
      inset:-10% -15% -20% -15%;
      z-index:-1;
      pointer-events:none;
      filter:blur(18px);
      background:
        conic-gradient(from 0deg at 60% 45%, rgba(255,138,29,.30), transparent 60%),
        conic-gradient(from 180deg at 40% 55%, rgba(255,106,0,.28), transparent 60%),
        radial-gradient(600px 220px at 50% 80%, rgba(255,255,255,.6), transparent 70%);
      animation:pays-rotate 18s linear infinite;
      opacity:.75;
      mix-blend-mode:screen;
    }

    .pays-frame::before{
      content:"";
      position:absolute;
      inset:10% 8% 18% 8%;
      border-radius:50%;
      background:
        conic-gradient(from 0deg, rgba(255,138,29,.18), transparent 40%, rgba(18,184,134,.15), transparent 70%, rgba(91,108,255,.15), transparent 100%);
      mask: radial-gradient(closest-side, transparent 74%, #000 76%);
      animation:pays-rotate 12s linear infinite;
      filter:blur(.3px);
    }

    .pays-sparkle{
      position:absolute;
      border-radius:50%;
      background:rgba(255,255,255,.85);
      box-shadow:0 0 12px rgba(255,255,255,.9), 0 0 28px rgba(255,138,29,.45);
      animation:pays-float 8s linear infinite;
    }

    .pays-section{
      padding:64px 0;
      opacity:0;
      transform:translateY(30px);
      transition:all .8s ease;
    }

    .pays-section.is-visible{
      opacity:1;
      transform:translateY(0);
    }

    .pays-section-title{
      text-align:center;
      margin-bottom:10px;
    }

    .pays-section-title h2{
      font-family:Spectral, serif;
      font-size:34px;
      color:#1c0f03;
      position:relative;
      display:inline-block;
    }

    .pays-section-title h2::after{
      content:"";
      position:absolute;
      bottom:-5px;
      left:50%;
      transform:translateX(-50%);
      width:60px;
      height:3px;
      background:var(--pays-orange);
      border-radius:2px;
    }

    .pays-section-title p{
      color:#6d5139;
      max-width:760px;
      margin:8px auto 0;
    }

    .pays-features-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:18px;
      margin-top:26px;
    }

    @media(max-width:980px){
      .pays-features-grid{grid-template-columns:1fr 1fr}
    }

    @media(max-width:680px){
      .pays-features-grid{grid-template-columns:1fr}
    }

    .pays-feature{
      background:var(--pays-paper);
      border:1px solid var(--pays-line);
      border-radius:16px;
      padding:22px;
      box-shadow:var(--pays-shadow);
      transition:.22s;
      position:relative;
      overflow:hidden;
      transform:translateY(20px);
      opacity:0;
    }

    .pays-feature.is-animated{
      transform:translateY(0);
      opacity:1;
    }

    .pays-feature:hover{
      transform:translateY(-4px);
      box-shadow:0 20px 40px rgba(16,18,20,.15);
    }

    .pays-feature::before{
      content:"";
      position:absolute;
      inset:0;
      background:linear-gradient(135deg, rgba(255,106,0,0.05) 0%, transparent 70%);
      opacity:0;
      transition:opacity .3s ease;
    }

    .pays-feature:hover::before{opacity:1}

    .pays-feature-image{
      width:100%;
      height:160px;
      border-radius:12px;
      overflow:hidden;
      margin-bottom:16px;
      display:flex;
      align-items:center;
      justify-content:center;
      background:#f9f9f9;
      position:relative;
    }

    .pays-feature-image::after{
      content:"";
      position:absolute;
      top:0;
      left:-100%;
      width:100%;
      height:100%;
      background:linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
      transition:all .6s;
    }

    .pays-feature:hover .pays-feature-image::after{left:100%}

    .pays-feature-image img{
      width:100%;
      height:100%;
      object-fit:cover;
      transition:all .5s ease;
    }

    .pays-feature:hover .pays-feature-image img{transform:scale(1.05)}
    .pays-feature h3{font-size:18px;margin-bottom:6px;transition:all .3s ease}
    .pays-feature:hover h3{color:var(--pays-orange)}
    .pays-feature p{color:#6d5139}

    .pays-products{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:20px;
      margin-top:26px;
    }

    @media(max-width:980px){
      .pays-products{grid-template-columns:1fr 1fr}
    }

    @media(max-width:680px){
      .pays-products{grid-template-columns:1fr}
    }

    .pays-product{
      background:#fff;
      border:1px solid var(--pays-line);
      border-radius:16px;
      overflow:hidden;
      box-shadow:var(--pays-shadow);
      transition:.22s;
      transform:translateY(20px);
      opacity:0;
    }

    .pays-product.is-animated{
      transform:translateY(0);
      opacity:1;
    }

    .pays-product:hover{
      transform:translateY(-4px) scale(1.02);
      box-shadow:0 20px 40px rgba(16,18,20,.15);
    }

    .pays-product-image{
      height:200px;
      width:100%;
      display:flex;
      align-items:center;
      justify-content:center;
      background:#f9f9f9;
      padding:20px;
      position:relative;
      overflow:hidden;
    }

    .pays-product-image::before{
      content:"";
      position:absolute;
      inset:0;
      background:linear-gradient(135deg, rgba(255,106,0,0.05) 0%, transparent 70%);
      opacity:0;
      transition:opacity .3s ease;
    }

    .pays-product:hover .pays-product-image::before{opacity:1}

    .pays-product-image img{
      max-height:160px;
      max-width:100%;
      object-fit:contain;
      transition:all .5s ease;
    }

    .pays-product:hover .pays-product-image img{transform:scale(1.1)}
    .pays-product-info{padding:16px;position:relative;z-index:2}
    .pays-product-info h3{font-size:18px;margin-bottom:6px;transition:all .3s ease}
    .pays-product:hover .pays-product-info h3{color:var(--pays-orange)}
    .pays-product-info p{color:#6d5139;font-size:14px}

    .pays-specs{
      display:grid;
      grid-template-columns:1.2fr .8fr;
      gap:18px;
      margin-top:26px;
    }

    @media(max-width:900px){
      .pays-specs{grid-template-columns:1fr}
    }

    .pays-spec-card,
    .pays-callout{
      background:#fff;
      border:1px solid var(--pays-line);
      border-radius:16px;
      box-shadow:var(--pays-soft);
      padding:18px;
      transform:translateY(20px);
      opacity:0;
      transition:all .5s ease;
    }

    .pays-spec-card.is-animated,
    .pays-callout.is-animated{
      transform:translateY(0);
      opacity:1;
    }

    .pays-spec-card:hover,
    .pays-callout:hover{
      transform:translateY(-5px);
      box-shadow:0 15px 30px rgba(16,18,20,.1);
    }

    .pays-spec-card h4{font-size:16px;margin-bottom:8px}

    .pays-spec-list{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
      margin-top:10px;
    }

    .pays-spec-item{
      background:#fff;
      border:1px dashed var(--pays-line);
      border-radius:12px;
      padding:10px;
      font-weight:700;
      transition:all .3s ease;
    }

    .pays-spec-item:hover{
      background:#fff7ef;
      border-color:var(--pays-orange);
      transform:translateY(-2px);
    }

    .pays-callout{background:linear-gradient(90deg,#fff,#fff7ef)}
    .pays-callout ul{margin-left:18px;margin-top:8px}

    .pays-comparison-table{
      background:#fff;
      border:1px solid var(--pays-line);
      border-radius:16px;
      overflow:hidden;
      box-shadow:var(--pays-shadow);
      margin-top:30px;
    }

    .pays-table-header,
    .pays-category-row,
    .pays-feature-row,
    .pays-savings-row{
      display:grid;
      grid-template-columns:1.5fr 1fr 1fr;
    }

    .pays-table-header{
      background:linear-gradient(90deg, #fff7ef, #fff);
      border-bottom:1px solid var(--pays-line);
      font-weight:800;
      padding:18px 20px;
    }

    .pays-category-row{
      background:#f9f9f9;
      padding:12px 20px;
      font-weight:800;
      color:var(--pays-ember);
      border-bottom:1px solid var(--pays-line);
    }

    .pays-feature-row,
    .pays-savings-row{
      padding:16px 20px;
      border-bottom:1px solid var(--pays-line);
      transition:all 0.3s ease;
    }

    .pays-feature-row:hover{background:#fff7ef}

    .pays-savings-row{
      background:linear-gradient(90deg, rgba(255,106,0,0.05), transparent);
      border-bottom:none;
    }

    .pays-feature-column{
      display:flex;
      flex-direction:column;
      justify-content:center;
    }

    .pays-feature-name{font-weight:700;margin-bottom:4px}
    .pays-feature-desc{font-size:.85rem;color:#6d5139;opacity:.8}

    .pays-col,
    .pays-toast-col{
      display:flex;
      flex-direction:column;
      justify-content:center;
      align-items:center;
      text-align:center;
      position:relative;
    }

    .pays-col{border-right:1px dashed var(--pays-line)}

    .pays-price{
      font-size:1.2rem;
      font-weight:800;
      margin-bottom:6px;
    }

    .pays-col .pays-price{color:var(--pays-ember)}
    .pays-toast-col .pays-price{color:#6d5139}

    .pays-highlight{
      background:var(--pays-orange);
      color:#fff;
      padding:4px 8px;
      border-radius:6px;
      font-size:.75rem;
      font-weight:700;
    }

    .pays-breakdown{
      font-size:.8rem;
      color:#6d5139;
      opacity:.8;
      max-width:160px;
    }

    .pays-savings-amount{
      font-size:1.5rem;
      font-weight:800;
      color:var(--pays-accent);
    }

    .pays-comparison-note{
      font-size:.85rem;
      color:#6d5139;
      font-weight:700;
    }

    .pays-comparison-cta{
      text-align:center;
      margin-top:40px;
      padding:30px;
      background:#fff;
      border-radius:16px;
      border:1px solid var(--pays-line);
      box-shadow:var(--pays-soft);
    }

    .pays-comparison-cta h3{
      font-family:Spectral, serif;
      font-size:26px;
      margin-bottom:8px;
      color:#1c0f03;
    }

    .pays-comparison-cta p{
      max-width:500px;
      margin:0 auto 20px;
      color:#6d5139;
    }

    @media (max-width:768px){
      .pays-comparison-table{display:none}
      .pays-mobile-comparison{display:block;margin-top:30px}

      .pays-mobile-category{
        background:var(--pays-orange);
        color:#fff;
        padding:12px 16px;
        border-radius:12px 12px 0 0;
        font-weight:800;
        margin-top:20px;
      }

      .pays-mobile-card{
        background:#fff;
        border:1px solid var(--pays-line);
        border-radius:0 0 12px 12px;
        padding:0 0 16px;
        margin-bottom:20px;
        box-shadow:var(--pays-soft);
      }

      .pays-mobile-label-row{
        display:grid;
        grid-template-columns:1fr 1fr;
        border-bottom:1px solid var(--pays-line);
      }

      .pays-mobile-label{
        padding:10px 12px;
        font-weight:900;
        font-size:.9rem;
        text-transform:uppercase;
        letter-spacing:.3px;
      }

      .pays-mobile-label.pays{
        background:var(--pays-tint);
        border-right:1px solid var(--pays-border);
        color:var(--pays-ember);
      }

      .pays-mobile-label.toast{
        background:var(--pays-toast-tint);
        color:#2f3137;
      }

      .pays-mobile-wrap{padding:16px}
      .pays-mobile-name{font-weight:700;margin-bottom:4px;font-size:1.1rem}
      .pays-mobile-desc{font-size:.9rem;color:#6d5139;margin-bottom:14px}

      .pays-mobile-row{
        display:grid;
        grid-template-columns:1fr 1fr;
      }

      .pays-mobile-pays,
      .pays-mobile-toast{
        padding:14px 10px;
        text-align:center;
      }

      .pays-mobile-pays{
        background:var(--pays-tint);
        border-right:1px dashed var(--pays-border);
      }

      .pays-mobile-toast{background:#fff}

      .pays-mobile-price{
        font-size:1.1rem;
        font-weight:800;
        margin-bottom:6px;
      }

      .pays-mobile-pays .pays-mobile-price{color:var(--pays-ember)}
      .pays-mobile-toast .pays-mobile-price{color:#6d5139}

      .pays-mobile-badge{
        background:var(--pays-orange);
        color:#fff;
        padding:4px 8px;
        border-radius:6px;
        font-size:.75rem;
        font-weight:700;
        display:inline-block;
        margin-top:4px;
      }

      .pays-mobile-breakdown{
        font-size:.8rem;
        color:#6d5139;
        max-width:140px;
        margin:0 auto;
      }

      .pays-mobile-divider{
        height:1px;
        background:var(--pays-line);
        margin:8px 0;
      }

      .pays-mobile-savings{
        background:linear-gradient(90deg, rgba(255,106,0,0.05), transparent);
        border:1px solid var(--pays-line);
        border-radius:12px;
        padding:20px;
        text-align:center;
        margin-top:20px;
      }

      .pays-mobile-savings-amount{
        font-size:1.5rem;
        font-weight:800;
        color:var(--pays-accent);
        margin-bottom:8px;
      }

      .pays-mobile-savings-note{
        font-size:.9rem;
        color:#6d5139;
        font-weight:700;
      }

      .pays-comparison-cta{
        padding:20px;
        margin-top:30px;
      }

      .pays-comparison-cta .pays-btn{
        width:100%;
      }
    }

    @media (min-width:769px){
      .pays-mobile-comparison{display:none}
    }

    .pays-order-demo{
      margin-top:40px;
      background:#fff;
      border-radius:20px;
      padding:30px;
      box-shadow:var(--pays-shadow);
      border:1px solid var(--pays-line);
      position:relative;
    }

    .pays-demo-controls{
      display:flex;
      justify-content:center;
      align-items:center;
      gap:20px;
      margin-bottom:40px;
      flex-wrap:wrap;
      z-index:1;
    }

    .pays-demo-speed{
      display:flex;
