---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import { company } from '../data/site';

const industries = ['Restaurant & Hospitality', 'Retail', 'E-commerce', 'Repair Shop', 'Healthcare', 'Contractor', 'Non-profit', 'Education', 'Other'];
const hours = [
  ['Monday to Thursday', '8:00 AM – 8:00 PM'],
  ['Friday', '8:00 AM – 6:00 PM'],
  ['Saturday', '9:00 AM – 2:00 PM'],
  ['Sunday', 'Closed'],
];
const times = ['Morning (8 – 11 AM)', 'Midday (11 AM – 2 PM)', 'Afternoon (2 – 5 PM)', 'Evening (5 – 8 PM)'];
---

<SiteLayout title="Contact PPD Technology" description="Talk to PPD Technology about payment processing, POS, software or the agent program. Send a message, request a call, or reach sales and merchant support by phone.">
  <section class="ct-hero">
    <div class="ct-hero__glow" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow fade-up">Contact</p>
      <h1 class="h-hero">
        <span class="rise" style="--i:1"><span>Talk to a person.</span></span>
        <span class="rise" style="--i:2"><span class="grad">We pick up.</span></span>
      </h1>
      <ul class="ct-lines fade-up" style="--i:4">
        <li>
          <span>Sales</span>
          <a href={`tel:${company.salesTel}`}>{company.salesPhone}</a>
        </li>
        <li>
          <span>Merchant support</span>
          <a href={`tel:${company.supportTel}`}>{company.supportPhone}</a>
        </li>
        <li>
          <span>Email</span>
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap ct-grid">
      <div class="ct-card reveal">
        <h2 class="h-2">Send us a message</h2>
        <LeadForm form="contact-message" subject="New Contact Message" cta="Send message" note="We reply within one business day.">
          <div class="field">
            <label for="ct-name">Full name</label>
            <input id="ct-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="ct-email">Email</label>
            <input id="ct-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="ct-phone">Phone <span class="opt">optional</span></label>
            <input id="ct-phone" name="phone" type="tel" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="ct-company">Company <span class="opt">optional</span></label>
            <input id="ct-company" name="company" type="text" autocomplete="organization" />
          </div>
          <div class="field">
            <label for="ct-industry">Industry <span class="opt">optional</span></label>
            <select id="ct-industry" name="industry">
              <option value="">Select</option>
              {industries.map((i) => <option>{i}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="ct-subject">Subject</label>
            <input id="ct-subject" name="subject" type="text" required />
          </div>
          <div class="field field--full">
            <label for="ct-message">Message</label>
            <textarea id="ct-message" name="message" rows="4" required></textarea>
          </div>
        </LeadForm>
      </div>

      <div class="ct-side">
        <div class="ct-card reveal" style="--i:1" id="call">
          <h2 class="h-2">Or request a call</h2>
          <p class="ct-note">Pick a day and a rough time. We will confirm by email.</p>
          <LeadForm form="contact-call-request" subject="New Schedule a Call Request" cta="Request a call" id="lf-call">
            <input type="hidden" name="intent" value="Contact - Schedule a Call" />
            <div class="field">
              <label for="cl-first">First name</label>
              <input id="cl-first" name="firstName" type="text" autocomplete="given-name" required />
            </div>
            <div class="field">
              <label for="cl-last">Last name</label>
              <input id="cl-last" name="lastName" type="text" autocomplete="family-name" required />
            </div>
            <div class="field">
              <label for="cl-email">Work email</label>
              <input id="cl-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="cl-phone">Phone</label>
              <input id="cl-phone" name="phone" type="tel" autocomplete="tel" required />
            </div>
            <div class="field field--full">
              <label for="cl-company">Company</label>
              <input id="cl-company" name="company" type="text" autocomplete="organization" required />
            </div>
            <div class="field">
              <label for="cl-date">Preferred day</label>
              <input id="cl-date" name="preferred_date" type="date" required data-min-today />
            </div>
            <div class="field">
              <label for="cl-time">Preferred time (ET)</label>
              <select id="cl-time" name="preferred_time" required>
                <option value="">Select</option>
                {times.map((t) => <option>{t}</option>)}
              </select>
            </div>
          </LeadForm>
        </div>

        <div class="ct-hours reveal" style="--i:2">
          <p class="eyebrow">Hours, Eastern time</p>
          <dl>
            {
              hours.map(([d, h]) => (
                <div>
                  <dt>{d}</dt>
                  <dd>{h}</dd>
                </div>
              ))
            }
          </dl>
          <a class="link-arrow" href="/customer-support">Already a customer? Open a support ticket <Icon name="arrow-right" /></a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  // The call form only accepts today or later.
  document.querySelectorAll<HTMLInputElement>('[data-min-today]').forEach((el) => {
    const d = new Date();
    el.min = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  });
</script>

<style>
  .ct-hero {
    position: relative;
    padding: var(--hero-top) 0 clamp(40px, 5vw, 64px);
    overflow: hidden;
  }
  .ct-hero__glow {
    position: absolute;
    inset: 0 0 auto 0;
    height: 700px;
    background: radial-gradient(55% 60% at 18% 22%, rgba(21, 73, 255, 0.34), transparent 70%);
    pointer-events: none;
  }
  .ct-hero .wrap {
    position: relative;
    display: grid;
    gap: 24px;
  }
  .ct-hero .h-hero {
    font-size: clamp(2.5rem, 6vw, 5.2rem);
  }
  .ct-lines {
    display: flex;
    flex-wrap: wrap;
    gap: 18px clamp(28px, 5vw, 72px);
    margin-top: 14px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .ct-lines li {
    display: grid;
    gap: 4px;
  }
  .ct-lines span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .ct-lines a {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .ct-lines a:hover {
    color: var(--cyan);
  }
  .ct-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 16px;
    align-items: start;
  }
  .ct-side {
    display: grid;
    gap: 16px;
  }
  .ct-card {
    display: grid;
    gap: 20px;
    padding: clamp(24px, 3.4vw, 44px);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: rgba(8, 13, 31, 0.8);
    scroll-margin-top: 90px;
  }
  .ct-note {
    margin-top: -10px;
    color: var(--muted);
  }
  .ct-card :global(.opt) {
    font-weight: 400;
    color: var(--dim);
  }
  .ct-hours {
    display: grid;
    gap: 16px;
    padding: clamp(24px, 3.4vw, 36px);
  }
  .ct-hours dl {
    border-top: 1px solid var(--line);
  }
  .ct-hours dl div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }
  .ct-hours dt {
    color: var(--muted);
  }
  .ct-hours dd {
    font-weight: 500;
  }
  @media (max-width: 940px) {
    .ct-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
