---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PPD Technology | KORONA POS for Retail" description="KORONA POS — cloud-based retail operating system. Smart inventory, multi-location reporting, fast checkout, and modern hardware, powered by PPD Technology.">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="korona-page">

    <!-- ══════════════ HERO ══════════════ -->
    <section class="kp-hero">
      <div class="kp-hero__grid-bg"></div>
      <span class="kp-hero__orb kp-hero__orb--1"></span>
      <span class="kp-hero__orb kp-hero__orb--2"></span>

      <div class="container kp-hero__inner">
        <div class="kp-hero__text">
          <span class="kp-eyebrow"><i class="fa-solid fa-barcode"></i> KORONA POS · Powered by PPD Technology</span>
          <h1>The retail operating system built for <span class="kp-grad-text">smarter stores</span>.</h1>
          <p class="kp-hero__sub">
            Run faster checkouts, control inventory across every location, and unlock real-time
            insight into the products and people driving your business.
          </p>

          <div class="kp-hero__actions">
            <a class="kp-btn kp-btn--primary" href="#demo-form">
              <i class="fa-solid fa-rocket"></i> Get a Demo
            </a>
            <a class="kp-btn kp-btn--ghost" href="#hardware">
              <i class="fa-solid fa-box-open"></i> View Hardware
            </a>
          </div>

          <div class="kp-hero__chips">
            <span><i class="fa-solid fa-shield-halved"></i> PCI Level 1</span>
            <span><i class="fa-solid fa-bolt"></i> Next-Day Funding</span>
            <span><i class="fa-solid fa-cloud"></i> Cloud-native</span>
            <span><i class="fa-solid fa-lock"></i> End-to-end encryption</span>
          </div>
        </div>

        <div class="kp-hero__visual">
          <!-- Mock retail dashboard -->
          <div class="kp-dash">
            <div class="kp-dash__bar">
              <span class="kp-dash__dot" style="background:#ff5f57"></span>
              <span class="kp-dash__dot" style="background:#febc2e"></span>
              <span class="kp-dash__dot" style="background:#28c840"></span>
              <span class="kp-dash__title">KORONA · Retail Dashboard</span>
              <span class="kp-dash__live" aria-hidden="true">Live</span>
            </div>

            <div class="kp-dash__body">
              <div class="kp-dash__stats">
                <div class="kp-dash__stat">
                  <span class="kp-dash__stat-label">Today's Sales</span>
                  <span class="kp-dash__stat-value" data-count="9482" data-prefix="$" data-commas="1">$9,482</span>
                  <span class="kp-dash__stat-trend up"><i class="fa-solid fa-arrow-up"></i> 14.2%</span>
                </div>
                <div class="kp-dash__stat">
                  <span class="kp-dash__stat-label">Items Sold</span>
                  <span class="kp-dash__stat-value" data-count="284" data-commas="1">284</span>
                  <span class="kp-dash__stat-trend up"><i class="fa-solid fa-arrow-up"></i> 8.6%</span>
                </div>
                <div class="kp-dash__stat">
                  <span class="kp-dash__stat-label">Avg Ticket</span>
                  <span class="kp-dash__stat-value" data-count="33.39" data-prefix="$" data-decimals="2">$33.39</span>
                  <span class="kp-dash__stat-trend up"><i class="fa-solid fa-arrow-up"></i> 3.1%</span>
                </div>
              </div>

              <div class="kp-dash__panel">
                <div class="kp-dash__panel-head">
                  <h4><i class="fa-solid fa-boxes-stacked"></i> Inventory Health</h4>
                  <span class="kp-tag kp-tag--warn">3 low stock</span>
                </div>
                <ul class="kp-stock">
                  <li>
                    <span class="kp-stock__name">Cold Brew 12oz <em>SKU 4421</em></span>
                    <span class="kp-stock__bar"><span style="width:78%;background:linear-gradient(90deg,#1549FF,#00CFFF)"></span></span>
                    <span class="kp-stock__qty">142</span>
                  </li>
                  <li>
                    <span class="kp-stock__name">Organic Tee · M <em>SKU 7820</em></span>
                    <span class="kp-stock__bar"><span style="width:38%;background:linear-gradient(90deg,#FFB020,#FF6A00)"></span></span>
                    <span class="kp-stock__qty">28</span>
                  </li>
                  <li>
                    <span class="kp-stock__name">Beam Lantern <em>SKU 3105</em></span>
                    <span class="kp-stock__bar"><span style="width:18%;background:linear-gradient(90deg,#FF5050,#FF8A1D)"></span></span>
                    <span class="kp-stock__qty kp-stock__qty--low">9</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Floating chips -->
          <div class="kp-float kp-float--scan">
            <i class="fa-solid fa-barcode"></i>
            <div>
              <strong>Scanner Connected</strong>
              <span>Zebra DS2208 · Lane 2</span>
            </div>
          </div>

          <div class="kp-float kp-float--store">
            <i class="fa-solid fa-store"></i>
            <div>
              <strong>4 Stores Synced</strong>
              <span>Inventory updated 2s ago</span>
            </div>
          </div>

          <div class="kp-float kp-float--badge">
            <i class="fa-solid fa-bolt"></i>
            <span>Sub-second checkout</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════ TRUST STRIP ══════════════ -->
    <div class="kp-strip">
      <div class="container kp-strip__inner">
        <span class="kp-strip__label">Built for modern retail</span>
        <span class="kp-strip__pill"><i class="fa-solid fa-store"></i> Specialty Retail</span>
        <span class="kp-strip__pill"><i class="fa-solid fa-mug-saucer"></i> Coffee &amp; QSR</span>
        <span class="kp-strip__pill"><i class="fa-solid fa-wine-bottle"></i> Wine, Beer &amp; Liquor</span>
        <span class="kp-strip__pill"><i class="fa-solid fa-shirt"></i> Apparel</span>
        <span class="kp-strip__pill"><i class="fa-solid fa-screwdriver-wrench"></i> Hardware Stores</span>
        <span class="kp-strip__pill"><i class="fa-solid fa-cannabis"></i> Cannabis</span>
      </div>
    </div>

    <!-- ══════════════ FEATURE GRID ══════════════ -->
    <section class="kp-section kp-section--light" id="software">
      <div class="container">
        <div class="kp-section-title">
          <span class="kp-pill"><i class="fa-solid fa-grid-2"></i> Retail-Grade Software</span>
          <h2>Sell smarter with <span class="kp-grad-text">enterprise tooling</span>.</h2>
          <p>Everything you need to run a serious retail operation — inventory, promotions, loyalty, and reporting — in one cloud platform.</p>
        </div>

        <div class="kp-feature-grid">
          <article class="kp-feature" data-anim>
            <div class="kp-feature__icon"><i class="fa-solid fa-bolt"></i></div>
            <h3>Fast Checkout</h3>
            <p>Scan barcodes, auto-apply discounts, and accept tap, chip, or cash — even when the internet drops.</p>
            <div class="kp-feature__viz">
              <span class="kp-chip kp-chip--pulse"><span></span> Sub-second</span>
              <span class="kp-chip">Offline mode</span>
              <span class="kp-chip">Tap · Chip · Cash</span>
            </div>
          </article>

          <article class="kp-feature" data-anim>
            <div class="kp-feature__icon"><i class="fa-solid fa-boxes-stacked"></i></div>
            <h3>Inventory &amp; Costing</h3>
            <p>Variants, bundles, reorder points, and vendor pricing — keep margins tight across every SKU.</p>
            <div class="kp-feature__viz">
              <div class="kp-bars">
                <span style="height:60%"></span><span style="height:40%"></span><span style="height:78%"></span>
                <span style="height:55%"></span><span style="height:90%"></span><span style="height:48%"></span>
              </div>
            </div>
          </article>

          <article class="kp-feature" data-anim>
            <div class="kp-feature__icon"><i class="fa-solid fa-print"></i></div>
            <h3>Labels &amp; Barcodes</h3>
            <p>Print shelf and item labels in-house with price, lot, and expiration data when you need it.</p>
            <div class="kp-feature__viz kp-feature__viz--label">
              <div class="kp-label-mock">
                <div class="kp-label-mock__price">$24.99</div>
                <div class="kp-label-mock__name">Cold Brew · 12oz</div>
                <div class="kp-label-mock__bars"></div>
              </div>
            </div>
          </article>

          <article class="kp-feature" data-anim>
            <div class="kp-feature__icon"><i class="fa-solid fa-globe"></i></div>
            <h3>Omnichannel Sync</h3>
            <p>Sync products and stock to your online store and marketplaces — one source of truth.</p>
            <div class="kp-feature__viz">
              <span class="kp-chip"><i class="fa-brands fa-shopify"></i> Shopify</span>
              <span class="kp-chip"><i class="fa-brands fa-wordpress"></i> WooCommerce</span>
              <span class="kp-chip"><i class="fa-brands fa-amazon"></i> Amazon</span>
            </div>
          </article>

          <article class="kp-feature" data-anim>
            <div class="kp-feature__icon"><i class="fa-solid fa-heart-circle-bolt"></i></div>
            <h3>Loyalty &amp; CRM</h3>
            <p>Points, punch programs, store credit, and gift cards — working seamlessly across every location.</p>
            <div class="kp-feature__viz kp-feature__viz--loyalty">
              <div class="kp-loyalty">
                <span class="kp-loyalty__name">Sarah K.</span>
                <span class="kp-loyalty__pts">2,840 pts</span>
                <span class="kp-loyalty__bar"><span style="width:72%"></span></span>
              </div>
            </div>
          </article>

          <article class="kp-feature" data-anim>
            <div class="kp-feature__icon"><i class="fa-solid fa-chart-line"></i></div>
            <h3>Real-Time Reporting</h3>
            <p>Live sales, category performance, and shrink — exportable or scheduled to your inbox.</p>
            <div class="kp-feature__viz">
              <svg viewBox="0 0 200 60" preserveAspectRatio="none" class="kp-spark">
                <defs>
                  <linearGradient id="kpSparkGrad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="rgba(21,73,255,.4)"/>
                    <stop offset="100%" stop-color="rgba(21,73,255,0)"/>
                  </linearGradient>
                </defs>
                <path d="M0 50 Q20 40 40 35 T80 25 T120 18 T160 12 T200 8 V60 H0 Z" fill="url(#kpSparkGrad)"/>
                <path d="M0 50 Q20 40 40 35 T80 25 T120 18 T160 12 T200 8" fill="none" stroke="#1549FF" stroke-width="2"/>
              </svg>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ══════════════ LIVE OS WIDGETS ══════════════ -->
    <section class="kp-section kp-section--dark" id="os">
      <div class="kp-section__bg-grid"></div>
      <div class="container">
        <div class="kp-section-title kp-section-title--dark">
          <span class="kp-pill kp-pill--dark"><i class="fa-solid fa-circle-nodes"></i> The Live Retail OS</span>
          <h2>One platform. <span class="kp-grad-text">Total visibility.</span></h2>
          <p>Watch your stores operate in real time — inventory, sales, employees, and more — from any browser, anywhere.</p>
        </div>

        <div class="kp-os-grid">
          <article class="kp-os-card" data-anim>
            <div class="kp-os-card__head">
              <h4><i class="fa-solid fa-boxes-stacked"></i> Smart Inventory Control</h4>
              <span class="kp-tag kp-tag--ok">Healthy</span>
            </div>
            <ul class="kp-os-stock">
              <li>
                <span>Cold Brew 12oz</span>
                <span class="kp-os-stock__bar"><span style="width:82%;background:linear-gradient(90deg,#1549FF,#00CFFF)"></span></span>
                <strong>142</strong>
              </li>
              <li>
                <span>Organic Tee · M</span>
                <span class="kp-os-stock__bar"><span style="width:38%;background:linear-gradient(90deg,#FFB020,#FF6A00)"></span></span>
                <strong>28</strong>
              </li>
              <li>
                <span>Beam Lantern</span>
                <span class="kp-os-stock__bar"><span style="width:18%;background:linear-gradient(90deg,#FF5050,#FF8A1D)"></span></span>
                <strong style="color:#FF8A1D">9</strong>
              </li>
              <li>
                <span>Hand-Pour Candle</span>
                <span class="kp-os-stock__bar"><span style="width:62%;background:linear-gradient(90deg,#1549FF,#00CFFF)"></span></span>
                <strong>74</strong>
              </li>
            </ul>
            <p class="kp-os-card__sub">Reorder points, vendor pricing, and stock-by-store updated in real time.</p>
          </article>

          <article class="kp-os-card" data-anim>
            <div class="kp-os-card__head">
              <h4><i class="fa-solid fa-trophy"></i> Top SKUs Today</h4>
              <span class="kp-tag">Live</span>
            </div>
            <ul class="kp-os-rank">
              <li><span class="kp-os-rank__num">1</span><span>Cold Brew 12oz</span><strong>$1,284</strong></li>
              <li><span class="kp-os-rank__num">2</span><span>Organic Tee · M</span><strong>$932</strong></li>
              <li><span class="kp-os-rank__num">3</span><span>Beam Lantern</span><strong>$684</strong></li>
              <li><span class="kp-os-rank__num">4</span><span>Hand-Pour Candle</span><strong>$502</strong></li>
              <li><span class="kp-os-rank__num">5</span><span>Trail Mix · 8oz</span><strong>$418</strong></li>
            </ul>
            <p class="kp-os-card__sub">Spot bestsellers as they happen and double down on what's working.</p>
          </article>

          <article class="kp-os-card" data-anim>
            <div class="kp-os-card__head">
              <h4><i class="fa-solid fa-map-location-dot"></i> Multi-Store Visibility</h4>
              <span class="kp-tag kp-tag--ok">4 online</span>
            </div>
            <ul class="kp-os-stores">
              <li>
                <span class="kp-os-stores__dot"></span>
                <span class="kp-os-stores__name">Downtown · Flagship</span>
                <strong>$3,184</strong>
              </li>
              <li>
                <span class="kp-os-stores__dot"></span>
                <span class="kp-os-stores__name">Westside Plaza</span>
                <strong>$2,402</strong>
              </li>
              <li>
                <span class="kp-os-stores__dot"></span>
                <span class="kp-os-stores__name">Airport Kiosk</span>
                <strong>$2,108</strong>
              </li>
              <li>
                <span class="kp-os-stores__dot"></span>
                <span class="kp-os-stores__name">Online Store</span>
                <strong>$1,788</strong>
              </li>
            </ul>
            <p class="kp-os-card__sub">Roll up sales, transfer inventory between stores, and price-by-location.</p>
          </article>

          <article class="kp-os-card" data-anim>
            <div class="kp-os-card__head">
              <h4><i class="fa-solid fa-user-shield"></i> Employee &amp; Register Controls</h4>
              <span class="kp-tag">Roles</span>
            </div>
            <table class="kp-os-perms">
              <thead>
                <tr><th>Role</th><th>Refunds</th><th>Discounts</th><th>Reports</th></tr>
              </thead>
              <tbody>
                <tr><td>Cashier</td><td>—</td><td>—</td><td>—</td></tr>
                <tr><td>Lead</td><td><i class="fa-solid fa-check"></i></td><td><i class="fa-solid fa-check"></i></td><td>—</td></tr>
                <tr><td>Manager</td><td><i class="fa-solid fa-check"></i></td><td><i class="fa-solid fa-check"></i></td><td><i class="fa-solid fa-check"></i></td></tr>
                <tr><td>Owner</td><td><i class="fa-solid fa-check"></i></td><td><i class="fa-solid fa-check"></i></td><td><i class="fa-solid fa-check"></i></td></tr>
              </tbody>
            </table>
            <p class="kp-os-card__sub">Granular permissions, register-level controls, and full audit trails.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ══════════════ HARDWARE ══════════════ -->
    <section class="kp-section kp-section--light" id="hardware">
      <div class="container">
        <div class="kp-section-title">
          <span class="kp-pill"><i class="fa-solid fa-box-open"></i> Hardware</span>
          <h2>Counter-ready hardware that <span class="kp-grad-text">just works</span>.</h2>
          <p>Countertop registers, handhelds for line-busting, plus scanners and label printers — all pre-configured.</p>
        </div>

        <div class="kp-hw-grid">
          <article class="kp-hw" data-anim>
            <div class="kp-hw__media">
              <img
                src="https://ppdtechnology.com/images/Korona/Hardware-Group-with-KORONA-POS-Software.png"
                alt="KORONA register and peripherals"
                loading="lazy"
              />
            </div>
            <div class="kp-hw__body">
              <h4>Retail Register + Peripherals</h4>
              <p>Touch register, cash drawer, receipt printer, and scanner — bundled and ready out of the box.</p>
              <div class="kp-hw__chips">
                <span><i class="fa-solid fa-cash-register"></i> Touch register</span>
                <span><i class="fa-solid fa-receipt"></i> Receipt printer</span>
                <span><i class="fa-solid fa-barcode"></i> Scanner</span>
              </div>
            </div>
          </article>

          <article class="kp-hw" data-anim>
            <div class="kp-hw__media">
              <img
                src="https://ppdtechnology.com/images/Korona/Desktop-Tablet-KPhone.png"
                alt="KORONA desktop, tablet, and phone"
                loading="lazy"
              />
            </div>
            <div class="kp-hw__body">
              <h4>Desktop · Tablet · Phone</h4>
              <p>Run KORONA on the device that fits the moment — back-office desktop, tableside tablet, or in-aisle phone.</p>
              <div class="kp-hw__chips">
                <span><i class="fa-solid fa-desktop"></i> Desktop</span>
                <span><i class="fa-solid fa-tablet-screen-button"></i> Tablet</span>
                <span><i class="fa-solid fa-mobile-screen"></i> Phone</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ══════════════ COMPARE ══════════════ -->
    <section class="kp-section kp-section--alt" id="compare">
      <div class="container">
        <div class="kp-section-title">
          <span class="kp-pill"><i class="fa-solid fa-scale-balanced"></i> Pricing Comparison</span>
          <h2>Save compared to <span class="kp-grad-text">Square</span>.</h2>
          <p>Transparent software pricing and flexible processing — based on common retail assumptions.</p>
        </div>

        <div class="kp-compare" role="table" aria-label="PPD KORONA vs Square comparison table">
          <div class="kp-compare__row kp-compare__row--head" role="row">
            <div role="columnheader">Feature</div>
            <div class="kp-compare__cell kp-compare__cell--ppd" role="columnheader">
              <span class="kp-compare__brand"><span class="kp-grad-text">PPD</span> + KORONA</span>
            </div>
            <div class="kp-compare__cell" role="columnheader">Square</div>
          </div>

          <div class="kp-compare__row" role="row">
            <div role="rowheader">
              <strong>Software (per location)</strong>
              <div class="kp-compare__note">Includes inventory, promos, reports, loyalty</div>
            </div>
            <div class="kp-compare__cell" role="cell"><span class="kp-price">$59.99</span><span class="kp-compare__per">/mo</span></div>
            <div class="kp-compare__cell" role="cell"><span class="kp-price kp-price--muted">$99</span><span class="kp-compare__per">/mo*</span></div>
          </div>

          <div class="kp-compare__row" role="row">
            <div role="rowheader">
              <strong>In-person card rate</strong>
              <div class="kp-compare__note">Tap / insert / swipe</div>
            </div>
            <div class="kp-compare__cell" role="cell"><span class="kp-price">2.5% + 5¢</span></div>
            <div class="kp-compare__cell" role="cell"><span class="kp-price kp-price--muted">2.8% + 10¢*</span></div>
          </div>

          <div class="kp-compare__row" role="row">
            <div role="rowheader"><strong>Online / keyed</strong></div>
            <div class="kp-compare__cell" role="cell"><span class="kp-price">2.6% + 25¢</span></div>
            <div class="kp-compare__cell" role="cell"><span class="kp-price kp-price--muted">2.9% + 30¢*</span></div>
          </div>

          <div class="kp-compare__row kp-compare__row--save" role="row">
            <div role="rowheader">
              <strong>Example monthly savings</strong>
              <div class="kp-compare__note">Assuming $30,000 card volume &amp; $40 avg ticket</div>
            </div>
            <div class="kp-compare__cell" role="cell">
              <span class="kp-save"><i class="fa-solid fa-piggy-bank"></i> $177.51/mo</span>
            </div>
            <div class="kp-compare__cell" role="cell"><span class="kp-compare__note">vs Square</span></div>
          </div>
        </div>

        <div class="kp-savings">
          <div class="kp-savings__head">
            <h4><i class="fa-solid fa-calculator"></i> Savings Snapshot</h4>
            <span class="kp-tag kp-tag--ok"><i class="fa-solid fa-piggy-bank"></i> Save up to $2,130/yr</span>
          </div>
          <div class="kp-savings__grid">
            <div class="kp-savings__cell">
              <span>Monthly card volume</span>
              <strong>$30,000</strong>
            </div>
            <div class="kp-savings__cell">
              <span>Average ticket</span>
              <strong>$40</strong>
            </div>
            <div class="kp-savings__cell">
              <span>PPD in-person rate</span>
              <strong>2.5% + 5¢</strong>
            </div>
            <div class="kp-savings__cell">
              <span>Square in-person rate</span>
              <strong>2.8% + 10¢</strong>
            </div>
          </div>
          <div class="kp-savings__cta">
            <a class="kp-btn kp-btn--primary" href="#demo-form">
              <i class="fa-regular fa-calendar-check"></i> Get a Personalized Quote
            </a>
          </div>
          <p class="kp-savings__note">
            * Square figures shown as common published base rates for reference. Your actual pricing may vary.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════════ CTA ══════════════ -->
    <section class="kp-cta">
      <div class="kp-cta__bg-grid"></div>
      <span class="kp-cta__orb kp-cta__orb--1"></span>
      <span class="kp-cta__orb kp-cta__orb--2"></span>

      <div class="container kp-cta__inner">
        <span class="kp-pill kp-pill--dark"><i class="fa-solid fa-rocket"></i> Get Started</span>
        <h2>Ready to upgrade your <span class="kp-grad-text">retail line</span>?</h2>
        <p>Book a 15-minute walkthrough — we'll migrate your products and train your staff.</p>
        <div class="kp-cta__actions">
          <a class="kp-btn kp-btn--white" href="#demo-form"><i class="fa-regular fa-calendar-check"></i> Book a Demo</a>
          <a class="kp-btn kp-btn--ghost-light" href="/contact"><i class="fa-solid fa-headset"></i> Talk to Sales</a>
        </div>
      </div>
    </section>

    <!-- ══════════════ DEMO FORM ══════════════ -->
    <section class="kp-section kp-section--light" id="demo-form">
      <div class="container">
        <div class="kp-section-title">
