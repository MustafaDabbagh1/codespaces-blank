---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PPD Technology | KORONA POS for Retail">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Spectral:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
  </Fragment>

  <div class="korona-page">
    <section class="hero">
      <div class="container">
        <div class="hero-grid">
          <div>
            <span class="eyebrow"><i class="fa-solid fa-barcode"></i> KORONA POS for Retail</span>
            <h1>Barcode-first retail POS with pro inventory, promotions, and real-time reporting.</h1>
            <p>
              Run faster checkouts, track SKUs and variants at scale, and sync every channel.
              Add scanners, label printers, and payment devices as you grow, no headaches.
            </p>

            <div class="badge-row">
              <span class="badge"><i class="fa-solid fa-boxes-stacked"></i> Advanced inventory & SKUs</span>
              <span class="badge"><i class="fa-solid fa-tags"></i> Promotions & bundles</span>
              <span class="badge"><i class="fa-solid fa-sliders"></i> Price books by store</span>
              <span class="badge"><i class="fa-solid fa-cloud"></i> Cloud reporting</span>
            </div>

            <div class="hero-actions">
              <a class="page-btn page-btn-primary" href="#demo-form">
                <i class="fa-solid fa-rocket"></i> Get a Demo
              </a>
              <a class="page-btn page-btn-outline" href="#hardware">
                <i class="fa-solid fa-box-open"></i> View Hardware
              </a>
            </div>

            <p class="muted hero-note">
              <i class="fa-solid fa-shield-halved"></i> PCI Level 1 · End-to-end encryption · Next-day funding
            </p>
          </div>

          <div class="hero-visual">
            <img
              class="korona-logo"
              alt="KORONA POS logo"
              src="https://ppdtechnology.com/images/Korona/KORONA-POS-Logo-Long.png"
            />
            <div class="device-wrap">
              <img
                class="hero-image"
                alt="KORONA dashboards"
                src="https://ppdtechnology.com/images/Korona/Dashboards.jpg"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="software">
      <div class="container">
        <div class="section-title">
          <h2>Sell smarter with retail-grade tools</h2>
          <p>
            Everything you need for barcodes, stock control, and multi-store promotions,
            built into one POS.
          </p>
        </div>

        <div class="features-grid">
          <div class="feature">
            <img class="feature-image" src="https://ppdtechnology.com/images/Korona/Desktop-Tablet-KPhone.png" alt="Checkout and mobile POS" />
            <h3>Fast Checkout</h3>
            <p>Scan barcodes, auto-apply discounts, and accept tap, chip, or cash, even if the internet drops.</p>
          </div>

          <div class="feature">
            <img class="feature-image" src="https://ppdtechnology.com/images/Korona/Dashboards.jpg" alt="Inventory and dashboards" />
            <h3>Inventory & Costing</h3>
            <p>Variants, assemblies/bundles, reorder points, and vendor pricing to keep margins tight.</p>
          </div>

          <div class="feature">
            <img class="feature-image" src="https://ppdtechnology.com/images/Korona/Side_Images_Hardware-w-New-Logo.png" alt="Label printing" />
            <h3>Labels & Barcodes</h3>
            <p>Print shelf and item labels in-house with price, lot, and expiration when needed.</p>
          </div>

          <div class="feature">
            <img class="feature-image" src="https://ppdtechnology.com/images/Korona/Dashboards.jpg" alt="Omnichannel" />
            <h3>Omnichannel</h3>
            <p>Sync products and stock to your online store and marketplaces, single source of truth.</p>
          </div>

          <div class="feature">
            <img class="feature-image" src="https://ppdtechnology.com/images/Korona/Hardware-set-with-background.png" alt="Loyalty and CRM" />
            <h3>Loyalty & CRM</h3>
            <p>Points, punch, store credit, and gift cards that work across all locations.</p>
          </div>

          <div class="feature">
            <img class="feature-image" src="https://ppdtechnology.com/images/Korona/Dashboards.jpg" alt="Reporting" />
            <h3>Reporting</h3>
            <p>Real-time sales, category performance, and shrink, export or schedule to email.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="hardware">
      <div class="container">
        <div class="section-title">
          <h2>Hardware that fits your counter</h2>
          <p>
            Countertop registers, handhelds for line-busting, and scanners and label printers
            that just work.
          </p>
        </div>

        <div class="gallery">
          <div class="panel">
            <h4>Retail Register + Peripherals</h4>
            <img
              class="gallery-image"
              src="https://ppdtechnology.com/images/Korona/Hardware-Group-with-KORONA-POS-Software.png"
              alt="Korona hardware group"
            />
          </div>

          <div class="panel">
            <h4>Desktop • Tablet • Phone</h4>
            <img
              class="gallery-image"
              src="https://ppdtechnology.com/images/Korona/Desktop-Tablet-KPhone.png"
              alt="Korona devices"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="compare">
      <div class="container">
        <div class="section-title">
          <h2>Save compared to Square</h2>
          <p>
            Transparent software pricing and flexible processing based on common retail pricing assumptions.
          </p>
        </div>

        <div class="comparison-table" aria-label="Comparison table">
          <div class="table-header">
            <div>Feature</div>
            <div class="col-center">PPD + KORONA POS</div>
            <div class="col-center">Square</div>
          </div>

          <div class="table-row">
            <div>
              <strong>Software (per location)</strong>
              <div class="note">Includes inventory, promotions, reports, loyalty</div>
            </div>
            <div class="col-center"><span class="price">$59.99</span>/mo</div>
            <div class="col-center"><span class="price">$99</span>/mo*</div>
          </div>

          <div class="table-row alt">
            <div>
              <strong>In-person card rate</strong>
              <div class="note">Tap/insert/swipe</div>
            </div>
            <div class="col-center"><span class="price">2.5% + 5¢</span></div>
            <div class="col-center"><span class="price">2.8% + 10¢*</span></div>
          </div>

          <div class="table-row">
            <div><strong>Online / keyed</strong></div>
            <div class="col-center"><span class="price">2.6% + 25¢</span></div>
            <div class="col-center"><span class="price">2.9% + 30¢*</span></div>
          </div>

          <div class="table-row alt">
            <div>
              <strong>Example monthly savings</strong>
              <div class="note">Assuming $30,000 card volume & $40 avg ticket</div>
            </div>
            <div class="col-center save">$177.51/mo</div>
            <div class="col-center"><span class="note">vs Square</span></div>
          </div>
        </div>

        <div class="panel savings-panel">
          <h4><i class="fa-solid fa-calculator"></i> Savings Snapshot</h4>
          <div class="calc-static">
            <div class="calc-box">
              <strong>Monthly card volume</strong>
              <span>$30,000</span>
            </div>
            <div class="calc-box">
              <strong>Average ticket</strong>
              <span>$40</span>
            </div>
            <div class="calc-box">
              <strong>PPD in-person rate</strong>
              <span>2.5% + 5¢</span>
            </div>
            <div class="calc-box">
              <strong>Square in-person rate</strong>
              <span>2.8% + 10¢</span>
            </div>
          </div>

          <div class="calc-actions">
            <a class="page-btn page-btn-primary" href="#demo-form">
              <i class="fa-regular fa-calendar-check"></i> Get a Personalized Quote
            </a>
          </div>

          <p class="note calc-note">
            * Square figures shown as common published base rates for reference. Your actual pricing may vary.
          </p>
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="container">
        <h3>Ready to upgrade your retail line?</h3>
        <p>Book a 15-minute walkthrough. We’ll migrate your products and train your staff.</p>
        <a class="page-btn page-btn-primary" href="#demo-form">
          <i class="fa-regular fa-calendar-check"></i> Book a Demo
        </a>
      </div>
    </section>

    <section class="demo-section" id="demo-form">
      <div class="container">
        <div class="section-title">
          <h2>Book a Demo • KORONA POS</h2>
          <p>Tell us about your store and we’ll reach out with a tailored walkthrough.</p>
        </div>

        <div class="demo-grid">
          <div class="demo-card">
            <h4><i class="fa-regular fa-calendar-check"></i> Retail Demo Request</h4>

            <form
              class="demo-form"
              action="https://formspree.io/f/mkgqpnyz"
              method="POST"
            >
              <div class="demo-row">
                <div>
                  <label for="name">Full Name</label>
                  <input id="name" type="text" name="name" placeholder="Jane Doe" required />
                </div>
                <div>
                  <label for="business">Business Name</label>
                  <input id="business" type="text" name="business" placeholder="My Retail Store" />
                </div>
              </div>

              <div class="demo-row">
                <div>
                  <label for="email">Your email</label>
                  <input id="email" type="email" name="email" placeholder="you@company.com" required />
                </div>
                <div>
                  <label for="phone">Phone</label>
                  <input id="phone" type="tel" name="phone" placeholder="(555) 555-5555" />
                </div>
              </div>

              <div class="demo-row">
                <div>
                  <label for="city_state">Location</label>
                  <input id="city_state" type="text" name="city_state" placeholder="City, State" />
                </div>
                <div>
                  <label for="preferred_time">Preferred Time</label>
                  <select id="preferred_time" name="preferred_time">
                    <option value="">Select…</option>
                    <option>Morning</option>
                    <option>Afternoon</option>
                    <option>Evening</option>
                  </select>
                </div>
              </div>

              <label for="message">Message</label>
              <textarea id="message" name="message" placeholder="What would you like to see in the demo?"></textarea>

              <input type="hidden" name="page" value="KORONA POS for Retail" />

              <div class="form-actions">
                <button type="submit" class="page-btn page-btn-primary">
                  <i class="fa-solid fa-paper-plane"></i> Send
                </button>
              </div>
            </form>
          </div>

          <div class="demo-card">
            <h4><i class="fa-solid fa-store"></i> What we’ll cover</h4>
            <ul class="demo-list">
              <li>Barcode workflows and checkout speed</li>
              <li>Inventory, variants, bundles, and vendors</li>
              <li>Promotions, loyalty, and gift cards</li>
              <li>Hardware and payment device setup</li>
            </ul>

            <div class="demo-preview">
              <img
                class="preview-image"
                src="https://ppdtechnology.com/images/Korona/Hardware-set-with-background.png"
                alt="Korona POS preview"
              />
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <style>
    .korona-page {
      --ink: #101214;
      --orange: #ff6a00;
      --orange-2: #ff8a1d;
      --ember: #b24200;
      --cream: #fff7ef;
      --paper: #ffffff;
      --line: #ece6de;
      --accent: #12b886;
      --shadow: 0 14px 40px rgba(16, 18, 20, 0.12);
      --soft: 0 10px 28px rgba(16, 18, 20, 0.08);
      font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
      color: var(--ink);
      background: var(--cream);
      line-height: 1.6;
      overflow-x: hidden;
    }

    .korona-page img {
      display: block;
      max-width: 100%;
      height: auto;
    }

    .korona-page .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 clamp(18px, 6vw, 28px);
    }

    .korona-page .page-btn {
      padding: 10px 18px;
      border-radius: 12px;
      font-weight: 800;
      font-size: 14px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: .2s;
      cursor: pointer;
      text-decoration: none;
      border: 1px solid transparent;
    }

    .korona-page .page-btn-primary {
      background: linear-gradient(90deg, var(--orange), var(--orange-2));
      border-color: var(--orange);
      color: #fff;
      box-shadow: 0 10px 24px rgba(255, 106, 0, .25);
    }

    .korona-page .page-btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 22px rgba(255, 106, 0, .35);
    }

    .korona-page .page-btn-outline {
      border-color: var(--line);
      background: #fff;
      color: var(--ink);
    }

    .korona-page .page-btn-outline:hover {
      border-color: var(--orange);
      color: var(--orange);
      transform: translateY(-2px);
    }

    .korona-page .hero {
      position: relative;
      isolation: isolate;
      padding: 64px 0 24px;
      background: linear-gradient(160deg, #fff5ec 0%, #ffe2c5 60%, #ffd1a1 100%);
    }

    .korona-page .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 32px;
      align-items: center;
    }

    .korona-page .eyebrow {
      display: inline-flex;
      gap: 8px;
      align-items: center;
      background: rgba(255, 138, 29, .08);
      border: 1px solid rgba(255, 138, 29, .35);
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 900;
      color: var(--ember);
    }

    .korona-page h1 {
      font-family: Spectral, serif;
      font-weight: 800;
      letter-spacing: .2px;
      font-size: 44px;
      line-height: 1.12;
      margin: 16px 0 12px;
      color: #1c0f03;
    }

    .korona-page .hero p {
      max-width: 640px;
      color: #502f10;
      margin-bottom: 16px;
    }

    .korona-page .badge-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin: 18px 0 26px;
    }

    .korona-page .badge {
      font-size: 12px;
      border: 1px solid rgba(255, 138, 29, .35);
      padding: 6px 10px;
      border-radius: 999px;
      background: rgba(255, 255, 255, .7);
    }

    .korona-page .hero-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .korona-page .hero-note {
      margin-top: 10px;
    }

    .korona-page .muted {
      color: #7b624a;
    }

    .korona-page .hero-visual {
      display: grid;
      gap: 14px;
      align-items: center;
    }

    .korona-page .korona-logo {
      max-height: 46px;
      width: auto;
      object-fit: contain;
      filter: drop-shadow(0 2px 6px rgba(0, 0, 0, .1));
    }

    .korona-page .device-wrap,
    .korona-page .panel,
    .korona-page .feature,
    .korona-page .comparison-table,
    .korona-page .demo-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 16px;
      box-shadow: var(--shadow);
    }

    .korona-page .device-wrap {
      padding: 16px;
    }

    .korona-page .hero-image {
      width: 100%;
      max-height: 420px;
      object-fit: cover;
      border-radius: 12px;
    }

    .korona-page .section {
      padding: 64px 0;
    }

    .korona-page .section-title {
      text-align: center;
      margin-bottom: 8px;
    }

    .korona-page .section-title h2 {
      font-family: Spectral, serif;
      font-size: 34px;
      color: #1c0f03;
      display: inline-block;
      position: relative;
    }

    .korona-page .section-title h2::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 3px;
      background: var(--orange);
      border-radius: 2px;
    }

    .korona-page .section-title p {
      color: #6d5139;
      max-width: 760px;
      margin: 8px auto 0;
    }

    .korona-page .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: 26px;
    }

    .korona-page .feature {
      padding: 18px;
      transition: .2s;
    }

    .korona-page .feature:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px rgba(16, 18, 20, .15);
    }

    .korona-page .feature-image {
      width: 100%;
      height: 220px;
      object-fit: contain;
      border-radius: 12px;
      background: #fffaf5;
      border: 1px solid var(--line);
      padding: 10px;
    }

    .korona-page .feature h3 {
      font-size: 18px;
      margin: 10px 0 6px;
    }

    .korona-page .feature p {
      color: #6d5139;
    }

    .korona-page .gallery {
      display: grid;
      grid-template-columns: 1.2fr .8fr;
      gap: 18px;
      margin-top: 22px;
    }

    .korona-page .panel {
      padding: 16px;
      box-shadow: var(--soft);
    }

    .korona-page .panel h4 {
      font-size: 16px;
      margin-bottom: 8px;
    }

    .korona-page .gallery-image {
      width: 100%;
      height: 320px;
      object-fit: contain;
      background: #fffaf5;
      border-radius: 12px;
      border: 1px solid var(--line);
      padding: 10px;
    }

    .korona-page .comparison-table {
      overflow: hidden;
      margin-top: 26px;
    }

    .korona-page .table-header,
    .korona-page .table-row {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr;
    }

    .korona-page .table-header {
      background: linear-gradient(90deg, #fff7ef, #fff);
      font-weight: 800;
      padding: 16px 18px;
      border-bottom: 1px solid var(--line);
    }

    .korona-page .table-row {
      padding: 14px 18px;
      border-bottom: 1px solid var(--line);
    }

    .korona-page .table-row.alt {
      background: #fafafa;
    }

    .korona-page .col-center {
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .korona-page .price {
      font-weight: 800;
    }

    .korona-page .save {
      color: var(--accent);
      font-weight: 800;
    }

    .korona-page .note {
      font-size: .85rem;
      color: #6d5139;
    }

    .korona-page .savings-panel {
      margin-top: 16px;
    }

    .korona-page .calc-static {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-top: 16px;
    }

    .korona-page .calc-box {
      background: #fffaf5;
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 14px;
    }

    .korona-page .calc-box strong {
      display: block;
      font-size: 13px;
      color: #6b4b2c;
      margin-bottom: 6px;
    }

    .korona-page .calc-box span {
      font-weight: 800;
      color: #1c0f03;
    }

    .korona-page .calc-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 12px;
    }

    .korona-page .calc-note {
      display: block;
      margin-top: 10px;
    }

    .korona-page .cta {
      background: linear-gradient(135deg, var(--orange), var(--orange-2));
      color: #2b1600;
      padding: 66px 0;
      text-align: center;
    }

    .korona-page .cta h3 {
      font-family: Spectral, serif;
      font-size: 30px;
      margin-bottom: 8px;
    }

    .korona-page .demo-section {
      padding: 64px 0 80px;
    }

    .korona-page .demo-grid {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 18px;
      margin-top: 26px;
    }

    .korona-page .demo-card {
      padding: 18px;
    }

    .korona-page .demo-form label {
      font-weight: 700;
      font-size: 12px;
      color: #6b4b2c;
      margin-bottom: 6px;
      display: block;
    }

    .korona-page .demo-form input,
    .korona-page .demo-form textarea,
    .korona-page .demo-form select {
      width: 100%;
      padding: 10px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: #fff;
      font: inherit;
    }

    .korona-page .demo-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 12px;
    }

    .korona-page .demo-form textarea {
      min-height: 120px;
      resize: vertical;
    }

    .korona-page .form-actions {
      margin-top: 12px;
    }

    .korona-page .demo-list {
      padding-left: 18px;
      color: #6d5139;
      margin-bottom: 16px;
    }

    .korona-page .preview-image {
      width: 100%;
      max-height: 320px;
      object-fit: contain;
      border-radius: 14px;
      border: 1px solid var(--line);
      background: #fffaf5;
      padding: 10px;
    }

    @media (max-width: 980px) {
      .korona-page .features-grid {
        grid-template-columns: 1fr 1fr;
      }

      .korona-page .hero-grid,
      .korona-page .gallery,
      .korona-page .demo-grid {
        grid-template-columns: 1fr;
      }

      .korona-page .hero {
        text-align: center;
      }

      .korona-page .hero p {
        margin-left: auto;
        margin-right: auto;
      }

      .korona-page .hero-actions,
      .korona-page .badge-row {
        justify-content: center;
      }

      .korona-page .calc-static {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 680px) {
      .korona-page .features-grid,
      .korona-page .demo-row,
      .korona-page .calc-static {
        grid-template-columns: 1fr;
      }

      .korona-page h1 {
        font-size: 34px;
      }

      .korona-page .feature-image,
      .korona-page .gallery-image,
      .korona-page .preview-image {
        height: auto;
        max-height: 260px;
      }
    }
  </style>
</BaseLayout>