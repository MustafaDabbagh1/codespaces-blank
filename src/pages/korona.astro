  </div>

  <style>
    /* ═══════════════════════════════════════════════════
       KORONA PAGE — premium retail-tech / SaaS aesthetic
       ═══════════════════════════════════════════════════ */
    .korona-page{
      --navy:#060E21; --navy-2:#0C1A38; --navy-3:#0a1c42;
      --blue:#1549FF; --blue-mid:#2D60FF; --blue-dark:#0E36C2;
      --cyan:#00CFFF; --green:#00E5A0;
      --orange:#FF6A00; --orange-2:#FF8A1D;
      --ink:#0B1220; --ink-2:#3B4661; --ink-3:#6E7892;
      --paper:#FFFFFF; --bg:#F5F8FD; --bg-2:#EEF3FB;
      --line:#E3E8F0;
      --r-md:12px; --r-lg:16px; --r-pill:999px;
      --shadow-sm:0 2px 8px rgba(11,18,32,.06);
      --shadow:0 12px 36px rgba(11,18,32,.10);
      --shadow-lg:0 22px 60px rgba(11,18,32,.16);
      --shadow-blue:0 14px 40px rgba(21,73,255,.28);
      font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
      color:var(--ink); background:var(--bg); line-height:1.6; overflow-x:hidden;
    }
    .korona-page img{display:block;max-width:100%;height:auto}
    .korona-page .container{max-width:1200px;margin:0 auto;padding:0 clamp(18px,5vw,28px)}

    /* ── Reusable bits ── */
    .kp-grad-text{
      background:linear-gradient(135deg,var(--cyan),var(--blue-mid));
      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
    }
    .kp-pill{
      display:inline-flex;align-items:center;gap:8px;
      background:rgba(21,73,255,.08);border:1px solid rgba(21,73,255,.16);
      padding:7px 16px;border-radius:var(--r-pill);
      font-size:12px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;
      color:var(--blue);
    }
    .kp-pill i{color:var(--blue)}
    .kp-pill--dark{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.18);color:#fff}
    .kp-pill--dark i{color:var(--cyan)}
    .kp-eyebrow{
      display:inline-flex;align-items:center;gap:8px;
      background:linear-gradient(90deg,rgba(0,207,255,.18),rgba(21,73,255,.18));
      border:1px solid rgba(0,207,255,.35);
      padding:7px 14px;border-radius:var(--r-pill);
      font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;
      color:#fff;
    }
    .kp-eyebrow i{color:var(--cyan)}

    /* Buttons */
    .kp-btn{
      display:inline-flex;align-items:center;justify-content:center;gap:8px;
      padding:13px 24px;font-weight:700;font-size:14px;border-radius:var(--r-pill);
      text-decoration:none;border:1px solid transparent;cursor:pointer;
      transition:all .25s ease;position:relative;overflow:hidden;isolation:isolate;
    }
    .kp-btn--primary{
      background:linear-gradient(135deg,var(--blue-mid),var(--blue));
      color:#fff;box-shadow:var(--shadow-blue);
    }
    .kp-btn--primary::before{
      content:"";position:absolute;inset:-2px;border-radius:inherit;
      background:linear-gradient(135deg,var(--cyan),var(--blue),var(--blue-dark));
      filter:blur(12px);opacity:0;transition:opacity .35s ease;z-index:-1;
    }
    .kp-btn--primary:hover{transform:translateY(-2px);background:linear-gradient(135deg,var(--blue),var(--blue-dark))}
    .kp-btn--primary:hover::before{opacity:.6}
    .kp-btn--ghost{
      background:#fff;color:var(--ink);border-color:var(--line);
      box-shadow:var(--shadow-sm);
    }
    .kp-btn--ghost:hover{border-color:var(--blue);color:var(--blue);transform:translateY(-2px)}
    .kp-btn--white{background:#fff;color:var(--blue);font-weight:800;box-shadow:0 12px 32px rgba(0,0,0,.25)}
    .kp-btn--white:hover{transform:translateY(-3px);background:rgba(255,255,255,.94);box-shadow:0 18px 48px rgba(0,0,0,.35)}
    .kp-btn--ghost-light{background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.25)}
    .kp-btn--ghost-light:hover{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.55);transform:translateY(-2px)}

    /* Section base */
    .kp-section{padding:clamp(64px,9vw,110px) 0;position:relative}
    .kp-section--light{background:var(--bg)}
    .kp-section--alt{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
    .kp-section--dark{
      background:
        radial-gradient(ellipse 100% 60% at 50% 0%, rgba(21,73,255,.18) 0%, transparent 60%),
        linear-gradient(160deg,#060E21 0%,#0C1A38 60%,#0a1c42 100%);
      color:#fff;overflow:hidden;
    }
    .kp-section--dark::after{
      content:"";position:absolute;left:0;right:0;top:0;height:1px;
      background:linear-gradient(90deg,transparent,rgba(0,207,255,.45),transparent);
      pointer-events:none;
    }
    .kp-section__bg-grid{
      position:absolute;inset:0;
      background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      pointer-events:none;
    }
    .kp-section-title{text-align:center;max-width:680px;margin:0 auto 48px}
    .kp-section-title h2{
      font-size:clamp(1.9rem,4vw,2.6rem);font-weight:800;
      letter-spacing:-.025em;line-height:1.18;margin:14px 0 12px;color:var(--ink);
    }
    .kp-section-title p{font-size:1.02rem;color:var(--ink-2);margin:0;line-height:1.7}
    .kp-section-title--dark h2{color:#fff}
    .kp-section-title--dark p{color:rgba(255,255,255,.75)}

    /* ═══════ HERO ═══════ */
    .kp-hero{
      position:relative;isolation:isolate;overflow:hidden;color:#fff;
      padding:clamp(96px,12vw,140px) 0 clamp(56px,8vw,90px);
      background:linear-gradient(160deg,#060E21 0%,#0C1A38 55%,#0a1c42 100%);
    }
    .kp-hero__grid-bg{
      position:absolute;inset:0;
      background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23ffffff' fill-opacity='0.035'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      pointer-events:none;
    }
    .kp-hero__orb{position:absolute;border-radius:50%;filter:blur(110px);opacity:.2;pointer-events:none}
    .kp-hero__orb--1{width:600px;height:600px;background:var(--blue);top:-280px;right:-180px;animation:kpOrbFloat 22s ease-in-out infinite}
    .kp-hero__orb--2{width:420px;height:420px;background:var(--cyan);bottom:-220px;left:-120px;animation:kpOrbFloat 26s ease-in-out infinite reverse}
    @keyframes kpOrbFloat{0%,100%{transform:translate(0,0)}50%{transform:translate(40px,-30px)}}

    .kp-hero__inner{position:relative;z-index:2;display:grid;grid-template-columns:1fr;gap:48px;align-items:center}
    .kp-hero__text{max-width:560px}
    .kp-hero__text > *{opacity:0;transform:translateY(18px);animation:kpHeroIn .9s cubic-bezier(.2,.7,.2,1) forwards}
    .kp-hero__text > .kp-eyebrow{animation-delay:.05s}
    .kp-hero__text > h1{animation-delay:.18s}
    .kp-hero__text > .kp-hero__sub{animation-delay:.32s}
    .kp-hero__text > .kp-hero__actions{animation-delay:.46s}
    .kp-hero__text > .kp-hero__chips{animation-delay:.6s}
    @keyframes kpHeroIn{to{opacity:1;transform:translateY(0)}}

    .kp-hero h1{
      font-size:clamp(2.2rem,5vw,3.4rem);line-height:1.1;font-weight:800;
      letter-spacing:-.025em;margin:18px 0;color:#fff;
    }
    .kp-hero__sub{font-size:clamp(1rem,1.7vw,1.12rem);opacity:.82;line-height:1.7;margin-bottom:30px;max-width:50ch}
    .kp-hero__actions{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:24px}
    .kp-hero__chips{display:flex;flex-wrap:wrap;gap:10px}
    .kp-hero__chips span{
      display:inline-flex;align-items:center;gap:7px;
      font-size:12px;font-weight:600;color:rgba(255,255,255,.78);
      padding:6px 12px;border-radius:var(--r-pill);
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);
    }
    .kp-hero__chips i{color:var(--cyan);font-size:11px}

    /* Hero visual — mock dashboard */
    .kp-hero__visual{position:relative;perspective:1200px;padding:32px 12px}
    .kp-dash{
      background:rgba(12,26,56,.85);border:1px solid rgba(255,255,255,.1);
      border-radius:16px;overflow:hidden;backdrop-filter:blur(20px);
      box-shadow:0 30px 80px rgba(0,0,0,.5),0 0 0 1px rgba(255,255,255,.05);
      transform:rotateY(-4deg) rotateX(2deg);
      transition:transform .6s ease;
      animation:kpDashFloat 8s ease-in-out infinite;
    }
    .kp-dash:hover{transform:rotateY(0) rotateX(0)}
    @keyframes kpDashFloat{0%,100%{transform:rotateY(-4deg) rotateX(2deg)}50%{transform:rotateY(-2deg) rotateX(1deg) translateY(-6px)}}

    .kp-dash__bar{
      display:flex;align-items:center;gap:6px;padding:12px 16px;
      background:rgba(0,0,0,.32);border-bottom:1px solid rgba(255,255,255,.06);
    }
    .kp-dash__dot{width:10px;height:10px;border-radius:50%}
    .kp-dash__title{margin-left:auto;font-size:11px;opacity:.5;font-weight:600}
    .kp-dash__live{
      display:inline-flex;align-items:center;gap:6px;margin-left:10px;
      font-size:9px;font-weight:800;color:#00E5A0;text-transform:uppercase;
      letter-spacing:.08em;background:rgba(0,229,160,.1);padding:3px 9px;
      border-radius:999px;border:1px solid rgba(0,229,160,.25);
    }
    .kp-dash__live::before{
      content:"";width:6px;height:6px;border-radius:50%;background:#00E5A0;
      box-shadow:0 0 0 0 rgba(0,229,160,.7);
      animation:kpLivePing 1.6s ease-out infinite;
    }
    @keyframes kpLivePing{
      0%{box-shadow:0 0 0 0 rgba(0,229,160,.55)}
      70%{box-shadow:0 0 0 8px rgba(0,229,160,0)}
      100%{box-shadow:0 0 0 0 rgba(0,229,160,0)}
    }
    .kp-dash__body{padding:16px;display:flex;flex-direction:column;gap:14px}
    .kp-dash__stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
    .kp-dash__stat{
      background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);
      border-radius:10px;padding:12px;
    }
    .kp-dash__stat-label{display:block;font-size:10px;opacity:.55;margin-bottom:4px;text-transform:uppercase;letter-spacing:.05em}
    .kp-dash__stat-value{display:block;font-size:18px;font-weight:800;letter-spacing:-.02em;color:#fff}
    .kp-dash__stat-trend{font-size:10px;font-weight:600}
    .kp-dash__stat-trend.up{color:var(--green)}

    .kp-dash__panel{
      background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);
      border-radius:10px;padding:12px;
    }
    .kp-dash__panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
    .kp-dash__panel-head h4{font-size:12px;font-weight:700;color:#fff;display:flex;align-items:center;gap:8px;margin:0}
    .kp-dash__panel-head i{color:var(--cyan);font-size:11px}
    .kp-tag{
      font-size:10px;font-weight:700;padding:3px 9px;border-radius:999px;
      background:rgba(255,255,255,.08);color:rgba(255,255,255,.78);
      border:1px solid rgba(255,255,255,.14);text-transform:uppercase;letter-spacing:.05em;
    }
    .kp-tag--ok{background:rgba(0,229,160,.12);color:var(--green);border-color:rgba(0,229,160,.3)}
    .kp-tag--warn{background:rgba(255,138,29,.14);color:var(--orange-2);border-color:rgba(255,138,29,.32)}

    .kp-stock{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
    .kp-stock li{display:grid;grid-template-columns:1.1fr 1fr 38px;align-items:center;gap:10px;font-size:11px}
    .kp-stock__name{color:rgba(255,255,255,.85);display:flex;flex-direction:column;line-height:1.3}
    .kp-stock__name em{font-style:normal;color:rgba(255,255,255,.4);font-size:10px;font-weight:500}
    .kp-stock__bar{display:block;height:6px;background:rgba(255,255,255,.08);border-radius:999px;overflow:hidden}
    .kp-stock__bar > span{display:block;height:100%;border-radius:999px}
    .kp-stock__qty{font-weight:700;color:#fff;text-align:right;font-size:12px}
    .kp-stock__qty--low{color:#FF8A1D}

    /* Floating chips */
    .kp-float{
      position:absolute;background:linear-gradient(160deg,rgba(28,46,86,.98),rgba(18,32,68,.98));
      border:1px solid rgba(0,207,255,.22);border-radius:12px;
      padding:11px 15px;backdrop-filter:blur(16px);
      box-shadow:0 16px 44px rgba(0,0,0,.55),0 0 0 1px rgba(255,255,255,.04);
      display:flex;align-items:center;gap:10px;font-size:12px;z-index:5;
      opacity:0;animation:kpFloatIn .9s ease forwards;
    }
    .kp-float i{font-size:18px}
    .kp-float strong{display:block;font-size:12px;font-weight:700;color:#fff}
    .kp-float span{display:block;opacity:.6;font-size:11px;color:#fff}
    .kp-float--scan{top:-26px;left:-12px;animation-delay:.6s}
    .kp-float--scan i{color:var(--cyan)}
    .kp-float--store{bottom:-26px;right:24px;animation-delay:.9s}
    .kp-float--store i{color:var(--green)}
    .kp-float--badge{bottom:24%;right:-22px;animation-delay:1.2s;gap:8px;padding:9px 14px}
    .kp-float--badge i{color:var(--orange-2);font-size:14px}
    .kp-float--badge span{opacity:.9;font-weight:600;font-size:12px;color:#fff}
    @keyframes kpFloatIn{from{opacity:0;transform:translateY(14px) scale(.95)}to{opacity:1;transform:translateY(0) scale(1)}}

    /* ═══════ TRUST STRIP ═══════ */
    .kp-strip{background:#fff;border-bottom:1px solid var(--line);padding:22px 0}
    .kp-strip__inner{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:14px}
    .kp-strip__label{
      font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);
    }
    .kp-strip__pill{
      display:inline-flex;align-items:center;gap:7px;
      font-size:13px;color:var(--ink-2);font-weight:600;
      padding:7px 14px;border-radius:var(--r-pill);
      background:var(--bg);border:1px solid var(--line);
      transition:all .25s ease;
    }
    .kp-strip__pill i{color:var(--blue);font-size:12px}
    .kp-strip__pill:hover{border-color:rgba(21,73,255,.35);color:var(--blue);transform:translateY(-2px)}

    /* ═══════ FEATURE GRID ═══════ */
    .kp-feature-grid{display:grid;grid-template-columns:1fr;gap:18px}
    .kp-feature{
      background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);
      padding:24px 22px;box-shadow:var(--shadow-sm);
      opacity:0;transform:translateY(20px);transition:all .55s ease;
      position:relative;overflow:hidden;
    }
    .kp-feature.animated{opacity:1;transform:translateY(0)}
    .kp-feature::before{
      content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;
      background:linear-gradient(135deg,rgba(21,73,255,.55),rgba(0,207,255,.55),rgba(21,73,255,0));
      -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
              mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
      -webkit-mask-composite:xor;mask-composite:exclude;
      opacity:0;transition:opacity .35s ease;pointer-events:none;
    }
    .kp-feature:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg)}
    .kp-feature:hover::before{opacity:1}
    .kp-feature__icon{
      width:48px;height:48px;border-radius:var(--r-md);
      background:rgba(21,73,255,.08);
      display:flex;align-items:center;justify-content:center;
      margin-bottom:16px;color:var(--blue);transition:all .35s ease;
    }
    .kp-feature__icon i{font-size:20px}
    .kp-feature:hover .kp-feature__icon{
      background:linear-gradient(135deg,var(--blue),var(--blue-mid));
      color:#fff;transform:translateY(-2px) rotate(-3deg);
      box-shadow:0 10px 26px rgba(21,73,255,.32);
    }
    .kp-feature h3{font-size:1.1rem;font-weight:700;margin:0 0 8px;color:var(--ink)}
    .kp-feature p{font-size:.93rem;color:var(--ink-2);line-height:1.65;margin:0 0 16px}
    .kp-feature__viz{
      background:var(--bg);border:1px solid var(--line);border-radius:var(--r-md);
      padding:14px;display:flex;flex-wrap:wrap;align-items:center;gap:8px;min-height:72px;
    }
    .kp-feature__viz--label{justify-content:center}
    .kp-feature__viz--loyalty{padding:14px}
    .kp-chip{
      display:inline-flex;align-items:center;gap:6px;
      font-size:11px;font-weight:600;padding:5px 11px;
      border-radius:999px;background:#fff;border:1px solid var(--line);color:var(--ink-2);
    }
    .kp-chip i{color:var(--blue);font-size:11px}
    .kp-chip--pulse > span{
      width:7px;height:7px;border-radius:50%;background:var(--green);
      animation:kpLivePing 1.6s ease-out infinite;box-shadow:0 0 0 0 rgba(0,229,160,.7);
    }
    .kp-bars{display:flex;align-items:flex-end;gap:6px;height:48px;width:100%}
    .kp-bars span{
      flex:1;background:linear-gradient(180deg,rgba(21,73,255,.35),rgba(21,73,255,.85));
      border-radius:3px 3px 0 0;transition:all .3s ease;
    }
    .kp-bars span:last-child{background:linear-gradient(180deg,var(--cyan),var(--blue))}
    .kp-feature:hover .kp-bars span{filter:brightness(1.1)}
    .kp-label-mock{
      background:#fff;border:1px solid var(--line);border-radius:8px;padding:10px 14px;
      box-shadow:var(--shadow-sm);text-align:center;min-width:140px;
    }
    .kp-label-mock__price{font-size:18px;font-weight:800;color:var(--ink);letter-spacing:-.02em}
    .kp-label-mock__name{font-size:10px;color:var(--ink-2);margin:2px 0 6px}
    .kp-label-mock__bars{
      height:14px;background:repeating-linear-gradient(
        90deg,#0B1220 0 2px,transparent 2px 4px,#0B1220 4px 5px,transparent 5px 8px,
        #0B1220 8px 10px,transparent 10px 12px
      );border-radius:2px;
    }
    .kp-loyalty{width:100%;display:flex;flex-direction:column;gap:6px}
    .kp-loyalty__name{font-size:12px;font-weight:700;color:var(--ink)}
    .kp-loyalty__pts{font-size:11px;color:var(--blue);font-weight:600}
    .kp-loyalty__bar{display:block;height:8px;background:var(--bg-2);border-radius:999px;overflow:hidden}
    .kp-loyalty__bar > span{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,var(--blue),var(--cyan))}
    .kp-spark{width:100%;height:48px;display:block}

    /* ═══════ LIVE OS WIDGETS (DARK) ═══════ */
    .kp-os-grid{display:grid;grid-template-columns:1fr;gap:18px;position:relative;z-index:2}
    .kp-os-card{
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.1);
      border-radius:var(--r-lg);padding:22px;color:#fff;
      backdrop-filter:blur(8px);
      box-shadow:0 16px 40px rgba(0,0,0,.3);
      opacity:0;transform:translateY(20px);transition:all .55s ease;
    }
    .kp-os-card.animated{opacity:1;transform:translateY(0)}
    .kp-os-card:hover{transform:translateY(-4px);border-color:rgba(0,207,255,.32);box-shadow:0 22px 60px rgba(0,207,255,.18)}
    .kp-os-card__head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
    .kp-os-card__head h4{font-size:.95rem;font-weight:700;color:#fff;display:flex;align-items:center;gap:8px;margin:0}
    .kp-os-card__head i{color:var(--cyan);font-size:14px}
    .kp-os-card__sub{font-size:.85rem;color:rgba(255,255,255,.65);line-height:1.6;margin:14px 0 0;border-top:1px solid rgba(255,255,255,.08);padding-top:12px}

    .kp-os-stock{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px}
    .kp-os-stock li{display:grid;grid-template-columns:1.2fr 1fr 36px;align-items:center;gap:10px;font-size:12px;color:rgba(255,255,255,.85)}
    .kp-os-stock__bar{display:block;height:6px;background:rgba(255,255,255,.08);border-radius:999px;overflow:hidden}
    .kp-os-stock__bar > span{display:block;height:100%;border-radius:999px}
    .kp-os-stock li strong{text-align:right;font-weight:700;color:#fff}

    .kp-os-rank{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
    .kp-os-rank li{
      display:grid;grid-template-columns:24px 1fr auto;align-items:center;gap:12px;
      padding:8px 10px;background:rgba(255,255,255,.03);border-radius:8px;font-size:12px;color:rgba(255,255,255,.85);
    }
    .kp-os-rank__num{
      width:22px;height:22px;border-radius:50%;
      background:rgba(0,207,255,.15);color:var(--cyan);
      display:flex;align-items:center;justify-content:center;
      font-size:11px;font-weight:800;
    }
    .kp-os-rank li:first-child .kp-os-rank__num{background:linear-gradient(135deg,var(--cyan),var(--blue));color:#fff}
    .kp-os-rank li strong{color:#fff;font-weight:700}

    .kp-os-stores{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
    .kp-os-stores li{
      display:grid;grid-template-columns:14px 1fr auto;align-items:center;gap:12px;
      padding:9px 12px;background:rgba(255,255,255,.03);border-radius:8px;font-size:12px;color:rgba(255,255,255,.85);
    }
    .kp-os-stores__name{color:rgba(255,255,255,.85);font-weight:500}
    .kp-os-stores__dot{
      width:9px;height:9px;border-radius:50%;background:var(--green);
      box-shadow:0 0 0 3px rgba(0,229,160,.18);
      animation:kpDotPulse 2.4s ease-in-out infinite;
    }
    @keyframes kpDotPulse{0%,100%{opacity:.85}50%{opacity:1;box-shadow:0 0 0 5px rgba(0,229,160,.18)}}
    .kp-os-stores li strong{color:#fff;font-weight:700}

    .kp-os-perms{width:100%;border-collapse:collapse;font-size:12px}
    .kp-os-perms th,.kp-os-perms td{padding:9px 8px;text-align:center;color:rgba(255,255,255,.85);border-bottom:1px solid rgba(255,255,255,.08)}
    .kp-os-perms th{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.55);text-align:left}
    .kp-os-perms td:first-child,.kp-os-perms th:first-child{text-align:left;font-weight:600;color:#fff}
    .kp-os-perms tbody tr:last-child td{border-bottom:0}
    .kp-os-perms i{color:var(--green)}

    /* ═══════ HARDWARE ═══════ */
    .kp-hw-grid{display:grid;grid-template-columns:1fr;gap:24px}
    .kp-hw{
      background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);
      box-shadow:var(--shadow-sm);overflow:hidden;
      opacity:0;transform:translateY(20px);transition:all .55s ease;
    }
    .kp-hw.animated{opacity:1;transform:translateY(0)}
    .kp-hw:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg)}
    .kp-hw__media{
      background:linear-gradient(135deg,#fff,#F5F8FD);
      padding:30px;display:flex;align-items:center;justify-content:center;
      border-bottom:1px solid var(--line);
    }
    .kp-hw__media img{max-height:280px;width:auto;object-fit:contain}
    .kp-hw__body{padding:24px}
    .kp-hw__body h4{font-size:1.15rem;font-weight:700;margin:0 0 8px;color:var(--ink)}
    .kp-hw__body p{font-size:.95rem;color:var(--ink-2);line-height:1.65;margin:0 0 14px}
    .kp-hw__chips{display:flex;flex-wrap:wrap;gap:8px}
    .kp-hw__chips span{
      display:inline-flex;align-items:center;gap:6px;
      font-size:11px;font-weight:600;color:var(--ink-2);
      padding:5px 11px;border-radius:999px;background:var(--bg);border:1px solid var(--line);
    }
    .kp-hw__chips i{color:var(--blue);font-size:11px}

    /* ═══════ COMPARE ═══════ */
    .kp-compare{
      background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);
      overflow:hidden;box-shadow:var(--shadow);margin-bottom:32px;
    }
    .kp-compare__row{
      display:grid;grid-template-columns:1.6fr 1fr 1fr;align-items:center;
      padding:18px 22px;border-bottom:1px solid var(--line);
    }
    .kp-compare__row:last-child{border-bottom:0}
    .kp-compare__row--head{
      background:linear-gradient(160deg,#060E21,#0C1A38);
      color:#fff;font-weight:700;text-transform:uppercase;letter-spacing:.06em;font-size:12px;
    }
    .kp-compare__row strong{font-weight:700;color:var(--ink);font-size:14px}
    .kp-compare__note{font-size:.82rem;color:var(--ink-3);margin-top:3px}
    .kp-compare__cell{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:2px}
    .kp-compare__cell--ppd{color:#fff}
    .kp-compare__brand{font-weight:800;font-size:14px}
    .kp-price{font-weight:800;font-size:1rem;color:var(--ink)}
    .kp-price--muted{color:var(--ink-3);text-decoration:line-through;text-decoration-thickness:1.5px;text-decoration-color:rgba(110,120,146,.4)}
    .kp-compare__per{font-size:11px;color:var(--ink-3)}
    .kp-compare__row--save{background:linear-gradient(90deg,rgba(0,229,160,.06),rgba(0,207,255,.04))}
    .kp-save{
      display:inline-flex;align-items:center;gap:8px;
      background:linear-gradient(135deg,var(--green),#00B080);
      color:#022;padding:8px 14px;border-radius:999px;font-weight:800;font-size:.95rem;
      box-shadow:0 8px 20px rgba(0,229,160,.3);
    }

    .kp-savings{
      background:linear-gradient(160deg,#fff,#F5F8FD);
      border:1px solid var(--line);border-radius:var(--r-lg);
      padding:24px;box-shadow:var(--shadow-sm);
    }
    .kp-savings__head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:18px}
    .kp-savings__head h4{font-size:1.05rem;font-weight:700;margin:0;color:var(--ink);display:flex;align-items:center;gap:8px}
    .kp-savings__head i{color:var(--blue)}
    .kp-savings__head .kp-tag{font-size:11px;color:#0a8060;background:rgba(0,229,160,.16);border-color:rgba(0,229,160,.32)}
    .kp-savings__head .kp-tag i{color:#0a8060}
    .kp-savings__grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px}
    .kp-savings__cell{
      background:#fff;border:1px solid var(--line);border-radius:var(--r-md);
      padding:14px;display:flex;flex-direction:column;gap:4px;
    }
    .kp-savings__cell span{font-size:11px;font-weight:700;color:var(--ink-3);text-transform:uppercase;letter-spacing:.05em}
    .kp-savings__cell strong{font-size:1.1rem;color:var(--ink);font-weight:800;letter-spacing:-.02em}
    .kp-savings__cta{margin-bottom:10px}
    .kp-savings__note{font-size:.8rem;color:var(--ink-3);margin:0}

    /* ═══════ CTA ═══════ */
    .kp-cta{
      padding:clamp(80px,10vw,120px) 0;text-align:center;color:#fff;
      position:relative;overflow:hidden;
      background:
        radial-gradient(ellipse 100% 80% at 50% -10%,rgba(0,207,255,.18) 0%,transparent 60%),
        radial-gradient(ellipse 60% 60% at 100% 100%,rgba(21,73,255,.15) 0%,transparent 50%),
        linear-gradient(160deg,#060E21 0%,#0C1A38 50%,#0a1840 100%);
    }
    .kp-cta__bg-grid{
      position:absolute;inset:0;
      background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23ffffff' fill-opacity='0.025'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      pointer-events:none;
    }
    .kp-cta__orb{position:absolute;border-radius:50%;filter:blur(100px);opacity:.13;pointer-events:none}
    .kp-cta__orb--1{width:500px;height:500px;background:var(--blue);top:-250px;left:-100px;animation:kpOrbFloat 22s ease-in-out infinite}
    .kp-cta__orb--2{width:350px;height:350px;background:var(--cyan);bottom:-180px;right:-80px;animation:kpOrbFloat 18s ease-in-out infinite reverse}
    .kp-cta__inner{position:relative;z-index:2;max-width:680px;margin:0 auto}
    .kp-cta h2{font-size:clamp(1.9rem,4.5vw,2.8rem);font-weight:800;letter-spacing:-.025em;line-height:1.18;margin:18px 0 14px;color:#fff}
    .kp-cta p{font-size:1.05rem;opacity:.78;line-height:1.7;margin-bottom:30px}
    .kp-cta__actions{display:flex;flex-wrap:wrap;justify-content:center;gap:12px}

    /* ═══════ DEMO FORM ═══════ */
    .kp-demo-grid{display:grid;grid-template-columns:1fr;gap:18px}
    .kp-demo-card{
      background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);
      padding:26px;box-shadow:var(--shadow-sm);
    }
    .kp-demo-card h4{font-size:1.05rem;font-weight:700;margin:0 0 18px;color:var(--ink);display:flex;align-items:center;gap:8px}
    .kp-demo-card h4 i{color:var(--blue)}
    .kp-demo-card--side{
      background:linear-gradient(160deg,#fff,#F5F8FD);
    }

    .kp-demo-form label{display:block;font-size:11px;font-weight:700;color:var(--ink-3);margin-bottom:6px;text-transform:uppercase;letter-spacing:.04em}
    .kp-demo-form input,.kp-demo-form textarea,.kp-demo-form select{
      width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:10px;
      background:#fff;font:inherit;font-size:14px;color:var(--ink);
      transition:all .2s ease;
    }
    .kp-demo-form input:focus,.kp-demo-form textarea:focus,.kp-demo-form select:focus{
      outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(21,73,255,.12);
    }
    .kp-demo-row{display:grid;grid-template-columns:1fr;gap:12px;margin-bottom:14px}
    .kp-demo-form textarea{min-height:110px;resize:vertical}
    .kp-form-actions{margin-top:14px}

    .kp-demo-list{list-style:none;padding:0;margin:0 0 18px;display:flex;flex-direction:column;gap:10px}
    .kp-demo-list li{display:flex;align-items:flex-start;gap:10px;font-size:.95rem;color:var(--ink-2)}
    .kp-demo-list i{color:var(--green);margin-top:5px;font-size:11px}
    .kp-demo-stats{
      display:grid;grid-template-columns:repeat(3,1fr);gap:12px;
      padding-top:18px;border-top:1px solid var(--line);
    }
    .kp-demo-stats > div{text-align:center}
    .kp-demo-stats strong{display:block;font-size:1.4rem;font-weight:800;color:var(--ink);letter-spacing:-.02em;line-height:1.1}
    .kp-demo-stats span{font-size:11px;color:var(--ink-3);font-weight:600;text-transform:uppercase;letter-spacing:.04em}

    /* ═══════ RESPONSIVE ═══════ */
    @media(min-width:768px){
      .kp-hero__inner{grid-template-columns:1fr 1.05fr;gap:40px}
      .kp-feature-grid{grid-template-columns:repeat(2,1fr)}
      .kp-os-grid{grid-template-columns:repeat(2,1fr)}
      .kp-hw-grid{grid-template-columns:1fr 1fr}
      .kp-demo-grid{grid-template-columns:1.2fr .8fr}
      .kp-demo-row{grid-template-columns:1fr 1fr}
      .kp-savings__grid{grid-template-columns:repeat(4,1fr)}
    }
    @media(min-width:992px){
      .kp-feature-grid{grid-template-columns:repeat(3,1fr)}
    }
    @media(max-width:767px){
      .kp-hero__visual{display:none}
      .kp-hero__text{text-align:center;margin:0 auto}
      .kp-hero__actions{justify-content:center}
      .kp-hero__chips{justify-content:center}
      .kp-compare__row{grid-template-columns:1.4fr 1fr 1fr;padding:14px 16px;gap:8px}
      .kp-compare__row strong{font-size:13px}
      .kp-price{font-size:.9rem}
      .kp-strip__inner{gap:8px}
    }
    @media(prefers-reduced-motion:reduce){
      .kp-hero__orb,.kp-cta__orb{animation:none}
      .kp-dash{animation:none;transform:none}
      .kp-float{animation:none;opacity:1;transform:none}
      .kp-hero__text > *{animation:none;opacity:1;transform:none}
      .kp-feature,.kp-os-card,.kp-hw{opacity:1;transform:none;transition:none}
      .kp-os-stores__dot,.kp-dash__live::before,.kp-chip--pulse > span{animation:none}
    }
  </style>

  <script>
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Reveal-on-scroll
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if(e.isIntersecting){ e.target.classList.add('animated'); io.unobserve(e.target); }
      });
    }, { threshold: .15 });
    document.querySelectorAll('.korona-page [data-anim]').forEach(el => io.observe(el));

    // Count-up
    function fmt(val, decimals, useCommas){
      if(useCommas){
        return val.toLocaleString(undefined, { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
      }
      return val.toFixed(decimals);
    }
    document.querySelectorAll('.korona-page [data-count]').forEach(el => {
      const target = parseFloat(el.dataset.count);
      const suffix = el.dataset.suffix || '';
      const prefix = el.dataset.prefix || '';
      const decimals = parseInt(el.dataset.decimals) || 0;
      const useCommas = el.dataset.commas === '1';
      if(prefersReducedMotion){
        el.textContent = prefix + fmt(target, decimals, useCommas) + suffix;
        return;
      }
      el.textContent = prefix + '0' + suffix;
      const obs = new IntersectionObserver(entries => {
        if(entries[0].isIntersecting){
          let start = 0;
          const dur = 1800;
          const step = 16;
          const timer = setInterval(() => {
            start += step;
            const progress = Math.min(start / dur, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            const val = eased * target;
            el.textContent = prefix + fmt(val, decimals, useCommas) + suffix;
            if(start >= dur){ clearInterval(timer); }
          }, step);
          obs.disconnect();
        }
      }, { threshold: .5 });
      obs.observe(el);
    });
  </script>
</BaseLayout>
