---
import Landing from '../components/Landing.astro';
import FormExtras from '../components/FormExtras.astro';

const features = [
  { title: 'Fast checkout', body: 'Scan barcodes, apply discounts automatically and accept tap, chip or cash, even when the internet drops.' },
  { title: 'Inventory and costing', body: 'Variants, bundles, reorder points and vendor pricing keep margins tight across every SKU.' },
  { title: 'Labels and barcodes', body: 'Print shelf and item labels in-house, with price, lot and expiration data when you need it.' },
  { title: 'Online store sync', body: 'Sync products and stock to your online store and marketplaces, from one source of truth.' },
  { title: 'Loyalty and customers', body: 'Points, punch programs, store credit and gift cards that work across every location.' },
  { title: 'Real-time reporting', body: 'Live sales, category performance and shrink, exportable or scheduled to your inbox.' },
];
---

<Landing
  title="KORONA POS for retail | Authorized reseller | PPD Technology"
  description="KORONA POS cloud retail point of sale, sold and supported by PPD Technology, an authorized KORONA POS reseller. $59.99 per month per location."
  accent={{ rgb: '255, 106, 0', main: '#ff6a00', soft: '#ffb057' }}
  eyebrow="KORONA POS · authorized reseller"
  headline={['The retail operating system', 'for smarter stores.']}
  lede="Run faster checkouts, control inventory across every location, and see which products and people are driving the business."
  cta={[{ label: 'Get a demo', href: '#demo' }, { label: 'Free rate review', href: '/rate-review' }]}
  chips={['Specialty retail', 'Coffee and quick service', 'Grocery', 'Apparel', 'Hardware stores', 'Gift shops']}
  featuresHead={{ eyebrow: 'What you get', title: 'Inventory, promotions, loyalty and reporting in one cloud platform.' }}
  features={features}
  pricing={{
    label: 'Pricing with PPD processing',
    price: '$59.99',
    unit: 'per month, per location, for the KORONA POS software.',
    includes: ['In-person payments: 2.5% + 5¢', 'Online and keyed payments: 2.6% + 25¢', 'Hardware quoted for your counter', 'Setup and support from PPD'],
    note: 'Rates shown are PPD’s published KORONA program rates. Your quote confirms the exact pricing for your business.',
  }}
  form={{ tag: 'korona-demo', subject: 'New KORONA POS Demo Request', title: 'See KORONA on your own catalog.', lede: 'A 15-minute walkthrough, no pressure, and a reply within 24 hours.', cta: 'Get a demo' }}
>
  <img slot="visual" src="/images/hw/korona.webp" alt="KORONA POS register with scanner and card reader" width="900" height="506" />

  <Fragment slot="fields">
    <FormExtras id="korona" city time />
  </Fragment>
</Landing>
