---
import Landing from '../components/Landing.astro';

const features = [
  { title: 'Embedded and virtual accounts', body: 'Spin up sub-accounts for programs, customers or locations, with tagged flows and controls.' },
  { title: 'Programmable money movement', body: 'ACH, wires and RTP with rules, approvals and automated sweeps between accounts.' },
  { title: 'Cash forecasting', body: 'Forecast balances and exposure from real-time inflow and outflow.' },
  { title: 'Reconciliation at scale', body: 'Match transactions to their sources automatically with virtual account mapping.' },
  { title: 'Granular controls', body: 'Role-based permissions, two-factor sign-in, policy enforcement and audit logs across teams and entities.' },
  { title: 'APIs and webhooks', body: 'Embed Passport Banking into the systems your finance team already uses.' },
];
const faqs = [
  { q: 'What payment rails are supported?', a: 'ACH, wires, RTP and card payouts. Rules and approvals can be applied across rails and accounts.' },
  { q: 'How are accounts structured?', a: 'Embedded accounts with on-demand virtual sub-accounts per customer, region or program, for precise tracking and reconciliation.' },
  { q: 'What security controls are available?', a: 'Multi-factor sign-in, role-based permissions, policy workflows and exportable audit trails.' },
];
---

<Landing
  title="Passport Banking: accounts and treasury for operators | PPD Technology"
  description="Passport Banking brings embedded accounts, money movement, reconciliation and controls into one platform, offered through PPD Technology."
  eyebrow="Passport Banking"
  headline={['Banking and treasury,', 'built for operators.']}
  lede="Consolidate cash across accounts, automate reconciliation and move money with confidence, from one platform."
  cta={[{ label: 'Talk to us', href: '#demo' }, { label: 'Log in', href: 'https://customer.prioritypassport.com/' }]}
  chips={['ACH', 'Wires', 'RTP', 'Virtual accounts', 'Approvals and audit trails']}
  statement="Finance teams lose days to moving money between accounts and matching what arrived. Passport does both for them."
  featuresHead={{ eyebrow: 'What you get', title: 'Banking functions operators actually use.' }}
  features={features}
  faqs={faqs}
  form={{ tag: 'passport-banking-inquiry', subject: 'New Passport Banking Inquiry', title: 'Bring banking and treasury under one roof.', lede: 'Tell us how your accounts are set up today and we will show you what Passport would change.', cta: 'Send' }}
/>
