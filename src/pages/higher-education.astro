---
import Landing from '../components/Landing.astro';
import FormExtras from '../components/FormExtras.astro';

const features = [
  { title: 'Installments and auto-pay', body: 'Flexible schedules and automatic reminders that nudge on time, with no line at the bursar.' },
  { title: 'International payments', body: 'Cross-border payments for global programs and students paying from abroad.' },
  { title: 'Campus commerce', body: 'POS, mobile and QR payments for dining, the bookstore, events and pop-ups, with unified reporting.' },
  { title: 'Security built in', body: 'Hosted fields and tokenization keep sensitive card data off your servers.' },
  { title: 'Revenue and receivables reporting', body: 'Track time to collect and payment-plan health by program, campus or term.' },
  { title: 'Works with your SIS and ERP', body: 'Sync balances and post payments back by API or file drop, via compatible integrations.' },
];
const faqs = [
  { q: 'Do you support installment plans and auto-debit?', a: 'Yes. Set up flexible schedules, auto-debit and reminders to reduce delinquencies.' },
  { q: 'How do you handle international students?', a: 'We support cross-border payments and can offer FX options for students paying from abroad.' },
  { q: 'Can we integrate with our SIS or ERP?', a: 'Yes, through APIs and webhooks or SFTP file drops that sync balances and post payments back.' },
  { q: 'What is the PCI impact for our team?', a: 'Hosted fields and tokenization keep sensitive data off your servers, which helps reduce scope and audit effort.' },
];
---

<Landing
  title="Higher education payments: tuition, fees and campus commerce | PPD Technology"
  description="Tuition and fee payments, installment plans and campus commerce for colleges and universities, set up and supported by PPD Technology."
  accent={{ rgb: '124, 58, 237', main: '#7c3aed', soft: '#c4a8ff' }}
  eyebrow="Higher education"
  headline={['Tuition, fees and', 'campus commerce.']}
  lede="From tuition and housing to dining, events and alumni giving: one student-friendly way to pay, online and on campus."
  cta={[{ label: 'Talk to us', href: '#demo' }, { label: 'Start an application', href: '/signup' }]}
  chips={['Tuition and fees', 'Housing and meal plans', 'Bookstore', 'Athletics and tickets', 'Alumni giving']}
  statement="Shorter lines at the bursar, fewer overdue balances, and one consistent way to pay across campus."
  featuresHead={{ eyebrow: 'What you get', title: 'Student-first features that grow collections.' }}
  features={features}
  faqs={faqs}
  form={{ tag: 'higher-education-inquiry', subject: 'New Higher Education Inquiry', title: 'Tell us about your campus.', lede: 'Share what you collect today and the systems you run, and we will map out how it would work.', cta: 'Send' }}
>
  <Fragment slot="fields">
    <FormExtras id="edu" city topics={['Tuition and payment plans', 'Campus commerce', 'International payments', 'SIS and ERP sync']} />
  </Fragment>
</Landing>
