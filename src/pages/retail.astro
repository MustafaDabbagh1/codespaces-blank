---
import Landing from '../components/Landing.astro';
import FormExtras from '../components/FormExtras.astro';
import ForgeDemo from '../components/demos/ForgeDemo.astro';
import Icon from '../components/Icon.astro';

const features = [
  { title: 'Checkout that keeps the line moving', body: 'Barcode scanning, quick keys, split payments and tap to pay, at the counter or on a handheld.' },
  { title: 'Real-time inventory', body: 'Track stock across locations with low-stock alerts, reorder points and variants.' },
  { title: 'Loyalty and customers', body: 'Capture customer profiles at checkout, run promotions and send digital receipts.' },
  { title: 'Pickup and ship-from-store', body: 'Buy online and pick up in store, with curbside handoff and label printing.' },
  { title: 'Returns and exchanges', body: 'Look up the sale, restock by rule and refund without the hunt.' },
  { title: 'Security', body: 'Point-to-point encryption and tokenization, with dispute workflows built in.' },
];
const gear = [
  { name: 'Forge POS', note: 'Our own register for busy counters: dual pricing, EBT and deposits.', href: '/forge' },
  { name: 'KORONA POS', note: 'Cloud retail POS with multi-location inventory.', img: '/images/hw/korona.webp', href: '/korona' },
  { name: 'Clover', note: 'Station Duo, Solo, Mini and Flex.', img: '/images/hw/clover.webp', href: '/clover' },
  { name: 'Valor VP800', note: 'Dual-screen countertop terminal.', img: '/images/hw/valor-vp800.webp', href: '/vp-800' },
  { name: 'Dejavoo P18', note: 'All-in-one handheld with tap to pay and scanning.', img: '/images/hw/dejavoo-p18.webp' },
  { name: 'Dejavoo P12 and P17', note: 'Chip, swipe and contactless pin pads.', img: '/images/hw/dejavoo-pinpads.webp' },
];
---

<Landing
  title="Retail POS and payments | PPD Technology"
  description="Checkout, inventory and payments for retail, from a single counter to multiple locations. Set up and supported by PPD Technology."
  eyebrow="Retail"
  headline={['Retail payments', 'that sell smarter.']}
  lede="From boutique to big box: checkout, tap to pay, inventory and online sales that stay connected, so every transaction is fast and every count is right."
  cta={[{ label: 'Book a demo', href: '#demo' }, { label: 'Free rate review', href: '/rate-review' }]}
  chips={['Barcode and SKU', 'Tap to pay', 'Dual pricing', 'EBT', 'Returns and exchanges']}
  featuresHead={{ eyebrow: 'What you get', title: 'Move lines. Move inventory.' }}
  features={features}
  gear={{ eyebrow: 'Hardware and software', title: 'Pick what fits your counter.', items: gear }}
  form={{ tag: 'retail-demo', subject: 'New Retail Demo Request', title: 'Ready to ring up more sales?', lede: 'Tell us about your store and we will show you the setup that fits, in store and online.' }}
>
  <section class="section t-forge" slot="demo">
    <div class="wrap demo-block">
      <div class="section-head">
        <p class="eyebrow reveal">Forge POS, built by PPD</p>
        <h2 class="h-1 reveal" style="--i:1">Watch a sale happen.</h2>
        <a class="link-arrow reveal" style="--i:2" href="/forge">Explore Forge <Icon name="arrow-right" /></a>
      </div>
      <div class="demo-block__stage reveal"><ForgeDemo captions="line" /></div>
    </div>
  </section>

  <Fragment slot="fields">
    <FormExtras id="retail" city select={{ name: 'locations', label: 'Number of locations', options: ['1', '2 to 5', '6 to 10', '11 or more'] }} />
  </Fragment>
</Landing>
