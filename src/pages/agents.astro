---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import BrandStudio from '../components/agents/BrandStudio.astro';
import LevelUp from '../components/agents/LevelUp.astro';
import PitchDuel from '../components/agents/PitchDuel.astro';
import { company } from '../data/site';

const pills = ['Keep your book', 'Higher agent split', 'Branded niche software', 'Software fees + processing', 'Built for seasoned agents'];

const tools = [
  { icon: 'layers', title: 'Custom vertical software', body: 'Niche-specific POS or merchant software built around the vertical you know best. Something your competitors cannot easily copy.' },
  { icon: 'users', title: 'A CRM for your book', body: 'Leads, merchants, follow-ups, onboarding, deal stages and partner activity in one place that is yours.' },
  { icon: 'globe', title: 'Websites and merchant acquisition', body: 'Landing pages, niche websites and funnels, so merchants come to you instead of the other way round.' },
  { icon: 'file-text', title: 'Partner sales assets', body: 'Decks, one-pagers and demo material that carry your name and speak your vertical’s language.' },
  { icon: 'handshake', title: 'Merchant onboarding support', body: 'We work the application, the equipment and the install with you, so a signed deal becomes a live merchant.' },
  { icon: 'chart', title: 'Portfolio growth strategy', body: 'A plan for the next niche, the next product and the next hundred merchants, reviewed with people who build the software.' },
];

const paths = [
  { title: 'Running an ISO?', body: 'Proprietary vertical software, a custom ISO CRM and merchant-acquisition sites, engineered for your organization.', href: '/iso', link: 'ISO solutions' },
  { title: 'Already have software?', body: 'Embed payments and monetize every transaction, or have the platform built so you can focus on selling it.', href: '/isv-solutions', link: 'ISV solutions' },
  { title: 'Just know a business?', body: 'Send us the lead and we handle the rest. $200 per approved signup.', href: '/refer', link: 'Refer a merchant' },
];

const faqs = [
  {
    q: 'Do I keep my book?',
    a: 'Yes. The program is built around agent ownership: you bring your relationships with you and keep growing them here.',
  },
  {
    q: 'Can I still sell Clover, Dejavoo and Valor?',
    a: 'Yes. Keep selling the terminals, gateways and processing your merchants are used to. The difference is that you now lead with software, and the hardware follows.',
  },
  {
    q: 'What does “branded software” actually mean?',
    a: 'We build niche-specific POS or merchant software around the vertical you know best and put your agency’s brand on it. What gets built, and whether it is branded or co-branded, is scoped with you on a strategy call.',
  },
  {
    q: 'How does compensation work?',
    a: 'You earn processing residuals, plus software fees on the software your merchants use. Your split depends on your volume, your verticals and the support you need, so we walk through exact numbers on your strategy call rather than publish a one-size sheet.',
  },
  {
    q: 'Is this for new agents?',
    a: 'It is built for seasoned agents who already know how to sell payments and want to move past generic ISO selling. If you would rather just send us a business, the referral program pays $200 per approved signup.',
  },
  {
    q: 'What should I bring to the strategy call?',
    a: 'The niche you win in, a rough picture of your book, and the questions merchants ask that you cannot answer today. We will map the software to that.',
  },
];
---

<SiteLayout
  title="Agent Program | PPD Technology: your tech and branding partner"
  description="Keep your book, get a higher split, and launch branded payment software built around your niche. PPD Technology is not a cookie-cutter ISO: we are the tech and branding partner behind payment sales agents."
>
  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section class="ahero">
    <div class="ahero__glow" aria-hidden="true"></div>
    <div class="wrap">
      <div class="ahero__copy">
        <p class="eyebrow fade-up">Agent program</p>
        <h1 class="h-hero">
          <span class="rise" style="--i:1"><span>Not just your ISO.</span></span>
          <span class="rise" style="--i:2"><span class="grad">Your tech and branding partner.</span></span>
        </h1>
        <p class="lede fade-up" style="--i:4">
          You already know how to sell payments. We build the software, the brand and the sales system around the niche you know best. You keep your book.
        </p>
        <div class="btn-row fade-up" style="--i:5">
          <a class="btn btn--primary" href="#book">Book a strategy call <Icon name="arrow-right" /></a>
          <a class="btn btn--ghost" href="#apply">Apply now</a>
        </div>
        <p class="ahero__pills fade-up" style="--i:6">{pills.join('  ·  ')}</p>
      </div>

      <div class="studio section--paper fade-up" style="--i:6">
        <BrandStudio />
      </div>
    </div>
  </section>

  <!-- ── WHAT MAKES PPD DIFFERENT ─────────────────────────── -->
  <section class="section" id="different">
    <div class="wrap">
      <p class="eyebrow reveal">What makes PPD different</p>
      <p class="statement" data-lightup>
        Keep selling the Clover, Dejavoo and Valor terminals your merchants know. But when every agent carries the same hardware, the pitch needs something else. So we make you custom payment software for your main niche, and put your name on it.
      </p>
    </div>
  </section>

  <!-- ── LEVEL UP ─────────────────────────────────────────── -->
  <section class="section section--raised" id="levels">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow reveal">Where we take you</p>
        <h2 class="h-1 reveal" style="--i:1">Four levels.<br />Most ISOs stop at the first.</h2>
      </div>
      <div class="reveal"><LevelUp /></div>
    </div>
  </section>

  <!-- ── THE PITCH ────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow reveal">The pitch</p>
        <h2 class="h-1 reveal" style="--i:1">Same doorway.<br />Different conversation.</h2>
      </div>
      <div class="reveal"><PitchDuel /></div>
    </div>
  </section>

  <!-- ── TOOLS ────────────────────────────────────────────── -->
  <section class="section section--paper">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow reveal">Enablement</p>
        <h2 class="h-1 reveal" style="--i:1">Tools other ISOs do not give you</h2>
      </div>
      <ul class="tools">
        {
          tools.map((t, i) => (
            <li class="reveal" style={`--i:${i % 2}`}>
              <span class="tools__n mono">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h-2">{t.title}</h3>
              <p>{t.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── OTHER PATHS + FAQ ────────────────────────────────── -->
  <section class="section">
    <div class="wrap faqwrap">
      <div>
        <div class="section-head">
          <p class="eyebrow reveal">Good questions</p>
          <h2 class="h-2 reveal" style="--i:1">Straight answers.</h2>
        </div>
        <ul class="paths">
          {
            paths.map((p, i) => (
              <li class="reveal" style={`--i:${i}`}>
                <a href={p.href}>
                  <b>{p.title}</b>
                  <span>{p.body}</span>
                  <em class="link-arrow">{p.link} <Icon name="arrow-right" /></em>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="faq reveal">
        {
          faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>
                {f.q}
                <Icon name="plus" size={20} />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── BOOK + APPLY ─────────────────────────────────────── -->
  <section class="section section--raised start" id="book">
    <div class="wrap">
      <div class="section-head section-head--center">
        <p class="eyebrow eyebrow--plain reveal">Next step</p>
        <h2 class="h-1 reveal" style="--i:1">Tell us the niche you win in.</h2>
        <p class="lede reveal" style="--i:2">
          We will map out the software your merchants would actually pay for, what your brand looks like on it, and what the numbers look like for your book.
        </p>
      </div>

      <div class="start__grid">
        <div class="start__card reveal">
          <h3 class="h-3">Book a strategy call</h3>
          <p>Pick a time that works. Thirty minutes, no deck, real answers.</p>
          <div class="cal" data-cal data-src={company.agentCalendar}>
            <button type="button" class="btn btn--primary" data-cal-open>Show available times <Icon name="arrow-right" /></button>
            <p class="fine">Opens Google Calendar scheduling in this page.</p>
          </div>
          <ul class="start__alt">
            <li><Icon name="phone" size={16} /> <a href={`tel:${company.salesTel}`}>{company.salesPhone}</a></li>
            <li><Icon name="mail" size={16} /> <a href={`mailto:${company.email}`}>{company.email}</a></li>
          </ul>
        </div>

        <div class="start__card reveal" style="--i:1" id="apply">
          <h3 class="h-3">Or apply now</h3>
          <p>Tell us a little about your book and our partnership team will contact you.</p>
          <LeadForm form="become-a-partner" subject="New Partner Application" cta="Send application" note="We reply within one business day.">
            <div class="field">
              <label for="ap-first">First name</label>
              <input id="ap-first" name="firstName" type="text" autocomplete="given-name" required />
            </div>
            <div class="field">
              <label for="ap-last">Last name</label>
              <input id="ap-last" name="lastName" type="text" autocomplete="family-name" required />
            </div>
            <div class="field">
              <label for="ap-email">Email</label>
              <input id="ap-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="ap-phone">Phone</label>
              <input id="ap-phone" name="phone" type="tel" autocomplete="tel" required />
            </div>
            <div class="field">
              <label for="ap-company">Company <span class="opt">optional</span></label>
              <input id="ap-company" name="company" type="text" autocomplete="organization" />
            </div>
            <div class="field">
              <label for="ap-niche">Your main niche <span class="opt">optional</span></label>
              <input id="ap-niche" name="niche" type="text" placeholder="Restaurants, repair shops, retail…" />
            </div>
            <div class="field">
              <label for="ap-exp">Years selling payments</label>
              <select id="ap-exp" name="experience" required>
                <option value="">Select</option>
                <option>0-1 years</option>
                <option>1-3 years</option>
                <option>3-5 years</option>
                <option>5+ years</option>
              </select>
            </div>
            <div class="field">
              <label for="ap-type">You are a</label>
              <select id="ap-type" name="partnerType" required>
                <option value="">Select</option>
                <option>Sales agent</option>
                <option>Agent office or team</option>
                <option>ISO</option>
                <option>ISV or software company</option>
                <option>Referral partner</option>
              </select>
            </div>
            <div class="field field--full">
              <label for="ap-vol">Monthly volume of your book</label>
              <select id="ap-vol" name="volume" required>
                <option value="">Select</option>
                <option>$0 – $100,000</option>
                <option>$100,000 – $500,000</option>
                <option>$500,000 – $5,000,000</option>
                <option>$5,000,000+</option>
              </select>
            </div>
            <div class="field field--full">
              <label for="ap-msg">Anything we should know? <span class="opt">optional</span></label>
              <textarea id="ap-msg" name="message" rows="3"></textarea>
            </div>
          </LeadForm>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  // Load the scheduling iframe only when asked, so the page stays fast and
  // nothing third-party loads until the visitor wants it.
  document.querySelectorAll<HTMLElement>('[data-cal]').forEach((cal) => {
    cal.querySelector('[data-cal-open]')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = cal.dataset.src || '';
      frame.title = 'Book an agent strategy call';
      frame.loading = 'lazy';
      cal.replaceChildren(frame);
      cal.classList.add('is-open');
    });
  });
</script>

<style>
  .ahero {
    position: relative;
    padding: var(--hero-top) 0 clamp(64px, 8vw, 110px);
    overflow: hidden;
  }
  .ahero__glow {
    position: absolute;
    inset: 0 0 auto 0;
    height: 900px;
    background:
      radial-gradient(60% 60% at 20% 20%, rgba(21, 73, 255, 0.36), transparent 70%),
      radial-gradient(40% 50% at 85% 30%, rgba(34, 211, 255, 0.12), transparent 70%);
    pointer-events: none;
  }
  .ahero .wrap {
    position: relative;
  }
  .ahero__copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .ahero .h-hero {
    font-size: clamp(2.4rem, 5.6vw, 4.9rem);
  }
  .ahero__pills {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    white-space: pre-wrap;
  }
  .studio {
    margin-top: clamp(40px, 5vw, 68px);
    padding: clamp(22px, 4vw, 56px);
    border-radius: var(--r-lg);
    background: var(--paper);
  }

  .statement {
    margin-top: 28px;
    max-width: 1040px;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.8vw, 3.2rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .tools {
    display: grid;
    border-top: 1px solid var(--paper-line);
  }
  .tools li {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) minmax(0, 1fr);
    gap: 10px 32px;
    align-items: baseline;
    padding: clamp(22px, 3vw, 34px) 0;
    border-bottom: 1px solid var(--paper-line);
  }
  .tools__n {
    font-size: 0.76rem;
    color: #9aa1b2;
  }
  .tools h3 {
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
  }
  .tools p {
    color: var(--paper-muted);
  }

  .faqwrap {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .paths {
    display: grid;
    gap: 12px;
  }
  .paths a {
    display: grid;
    gap: 6px;
    padding: 20px 22px;
    border-radius: var(--r);
    border: 1px solid var(--line);
    transition:
      border-color 0.3s,
      background 0.3s;
  }
  .paths a:hover {
    border-color: var(--blue-2);
    background: rgba(21, 73, 255, 0.1);
  }
  .paths b {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .paths span {
    font-size: 0.94rem;
    color: var(--muted);
  }
  .paths em {
    font-style: normal;
    font-size: 0.92rem;
    margin-top: 4px;
  }
  .faq {
    border-top: 1px solid var(--line-2);
  }
  .faq details {
    border-bottom: 1px solid var(--line-2);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary :global(svg) {
    flex-shrink: 0;
    color: var(--blue-3);
    transition: transform 0.35s var(--ease-out);
  }
  .faq details[open] summary :global(svg) {
    transform: rotate(45deg);
  }
  .faq p {
    padding: 0 40px 24px 0;
    color: var(--muted);
    max-width: 62ch;
  }

  .start__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 16px;
    align-items: start;
  }
  .start__card {
    display: grid;
    gap: 16px;
    padding: clamp(24px, 3.4vw, 44px);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--ink);
    scroll-margin-top: 96px;
  }
  .start__card > p {
    color: var(--muted);
  }
  .cal {
    display: grid;
    gap: 12px;
    justify-items: start;
    padding: 22px;
    border-radius: var(--r);
    border: 1px dashed var(--line-2);
  }
  .cal.is-open {
    padding: 0;
    border: 0;
    overflow: hidden;
    background: #fff;
  }
  .cal :global(iframe) {
    width: 100%;
    height: 620px;
    border: 0;
  }
  .start__alt {
    display: grid;
    gap: 8px;
    color: var(--muted);
  }
  .start__alt li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .start__alt a {
    color: var(--text);
    font-weight: 500;
  }
  .opt {
    font-weight: 400;
    color: var(--dim);
  }

  @media (max-width: 1000px) {
    .faqwrap,
    .start__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .tools li {
      grid-template-columns: 1fr;
    }
  }
</style>
