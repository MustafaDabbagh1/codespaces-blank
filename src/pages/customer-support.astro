    .cs-cta-inner{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
    .cs-cta-inner h2{font-size:clamp(22px,2.5vw,30px);letter-spacing:-.02em;margin-bottom:4px}
    .cs-cta-inner p{color:rgba(255,255,255,.7);font-size:15px}
    .cs-cta-btns{display:flex;gap:10px}

    .cs-reg-bar{
      background:var(--cs-navy);color:rgba(255,255,255,.5);text-align:center;
      padding:14px 16px;font-size:12px;
    }

    @media (min-width:900px){
      .cs-hero-inner{grid-template-columns:1fr}
    }
    @media (max-width:900px){
      .cs-hero-cards{grid-template-columns:1fr}
      .cs-status-grid{grid-template-columns:1fr}
      .cs-form-layout{grid-template-columns:1fr}
      .cs-form-row{grid-template-columns:1fr}
      .cs-cta-inner{flex-direction:column;text-align:center}
      .cs-cta-btns{flex-direction:column;width:100%}
      .cs-status-head{flex-direction:column}
      .cs-status-head>p{text-align:left}
    }
    @media (min-width:640px) and (max-width:900px){
      .cs-hero-cards{grid-template-columns:repeat(3,1fr)}
      .cs-status-grid{grid-template-columns:repeat(3,1fr)}
    }
  </style>

  <script is:inline>
    (() => {
      const root = document.querySelector('.cs-page');
      if (!root) return;

      root.querySelectorAll('.cs-faq-item').forEach(d => {
        d.addEventListener('toggle', () => {
          const icon = d.querySelector('summary i');
          if (icon) icon.className = d.open ? 'fa-solid fa-minus' : 'fa-solid fa-plus';
        });
      });

      const ticketForm = root.querySelector('#csTicketForm');
      ticketForm?.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (this.website && this.website.value) return;
        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn ? submitBtn.innerHTML : '';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending…';
        }
        try {
          const data = new FormData(this);
          // strip files (lead endpoint emails fields, not attachments)
          data.delete('files');
          data.append('_page', window.location.pathname);
          const res = await fetch('/api/lead', { method: 'POST', body: data });
          if (!res.ok) throw new Error('Network');
          window.location.href = '/thank-you';
        } catch {
          alert("Sorry, something went wrong submitting your ticket. Please email info@ppdtechnology.com and we'll help right away.");
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
          }
        }
      });
    })();
  </script>
</BaseLayout>
