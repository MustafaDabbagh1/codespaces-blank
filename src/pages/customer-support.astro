    .cs-phone-note{font-size:13px;color:rgba(255,255,255,.6);margin-bottom:14px;line-height:1.5}

    .cs-section-head-center{text-align:center;display:flex;flex-direction:column;align-items:center;gap:8px;margin-bottom:28px}
    .cs-section-head-center h2{font-size:clamp(24px,2.5vw,32px);letter-spacing:-.02em}
    .cs-faq-container{max-width:800px}
    .cs-faq-grid{display:flex;flex-direction:column;gap:10px}
    .cs-faq-item{
