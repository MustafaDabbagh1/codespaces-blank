---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import { company, logins } from '../data/site';

const topics = ['Account & Billing', 'Terminals & POS', 'E-commerce / API', 'Deposits & Payouts', 'Chargebacks / Disputes', 'Other'];
const priorities = ['Low - general question', 'Normal - needs attention', 'High - blocking one location', 'Critical - processing outage'];
const faqs = [
  { q: 'My terminal will not connect. What should I check?', a: 'Check power and the network (Wi-Fi or Ethernet), then restart the device and the router. If it is still offline, open a ticket with the device serial number and the last four digits of a recent transaction.' },
  { q: 'When will my deposits arrive?', a: 'Most deposits settle the next business day for batches closed by the cutoff. Holidays and holds can affect timing. Your deposits report shows the details for your account.' },
  { q: 'How do I respond to a chargeback?', a: 'Gather receipts, order details, proof of shipment and any communication with the customer, and submit the evidence before the deadline shown on the dispute.' },
  { q: 'Where do I log in?', a: 'Each product has its own portal. Use the Log in menu at the top of the page, or the list on this page.' },
];
---

<SiteLayout title="Customer support | PPD Technology" description="Get help from PPD Technology's U.S.-based support team: call merchant support, open a ticket, or find your portal login.">
  <section class="cs-hero">
    <div class="cs-hero__glow" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow fade-up">Customer support</p>
      <h1 class="h-hero">
        <span class="rise" style="--i:1"><span>We’re here to help,</span></span>
        <span class="rise" style="--i:2"><span class="grad">fast.</span></span>
      </h1>
      <div class="cs-opts fade-up" style="--i:4">
        <a class="cs-opt" href={`tel:${company.supportTel}`}>
          <Icon name="phone" size={22} />
          <b>Call merchant support</b>
          <span>{company.supportPhone}</span>
          <em>{company.hours}</em>
        </a>
        <a class="cs-opt" href="#ticket">
          <Icon name="ticket" size={22} />
          <b>Open a support ticket</b>
          <span>We route it to the right specialist.</span>
          <em>Best for anything that is not urgent</em>
        </a>
        <a class="cs-opt" href={`mailto:${company.email}`}>
          <Icon name="mail" size={22} />
          <b>Email us</b>
          <span>{company.email}</span>
          <em>For terminal outages, please call</em>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--tight" id="ticket">
    <div class="wrap cs-grid">
      <div class="cs-card reveal">
        <h2 class="h-2">Open a support ticket</h2>
        <p class="cs-note">Please leave out full card numbers and other sensitive cardholder data.</p>
        <LeadForm form="customer-support" subject="New Customer Support Ticket" cta="Submit ticket">
          <div class="field">
            <label for="cs-name">Your name</label>
            <input id="cs-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="cs-email">Work email</label>
            <input id="cs-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="cs-company">Company</label>
            <input id="cs-company" name="company" type="text" autocomplete="organization" required />
          </div>
          <div class="field">
            <label for="cs-callback">Callback number <span class="opt">optional</span></label>
            <input id="cs-callback" name="callback" type="tel" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="cs-mid">Merchant ID <span class="opt">if known</span></label>
            <input id="cs-mid" name="mid" type="text" />
          </div>
          <div class="field">
            <label for="cs-terminal">Terminal or device ID <span class="opt">if known</span></label>
            <input id="cs-terminal" name="terminal" type="text" />
          </div>
          <div class="field">
            <label for="cs-topic">Issue type</label>
            <select id="cs-topic" name="topic" required>
              <option value="">Select</option>
              {topics.map((t) => <option>{t}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="cs-severity">Priority</label>
            <select id="cs-severity" name="severity" required>
              <option value="">Select</option>
              {priorities.map((t) => <option>{t}</option>)}
            </select>
          </div>
          <div class="field field--full">
            <label for="cs-subject">Subject</label>
            <input id="cs-subject" name="subject" type="text" required />
          </div>
          <div class="field field--full">
            <label for="cs-details">Details</label>
            <textarea id="cs-details" name="details" rows="5" required></textarea>
          </div>
        </LeadForm>
      </div>

      <div class="cs-side">
        <div class="reveal" style="--i:1">
          <p class="eyebrow">Your portals</p>
          <ul class="cs-logins">
            {logins.map((l) => <li><a href={l.href} rel="noopener">{l.name} <Icon name="arrow-up-right" size={15} /></a></li>)}
          </ul>
        </div>
        <div class="reveal" style="--i:2">
          <p class="eyebrow">Common questions</p>
          <div class="cs-faq">
            {
              faqs.map((f, i) => (
                <details open={i === 0}>
                  <summary>
                    {f.q}
                    <Icon name="plus" size={18} />
                  </summary>
                  <p>{f.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .cs-hero {
    position: relative;
    padding: var(--hero-top) 0 clamp(40px, 5vw, 64px);
    overflow: hidden;
  }
  .cs-hero__glow {
    position: absolute;
    inset: 0 0 auto 0;
    height: 700px;
    background: radial-gradient(55% 60% at 18% 22%, rgba(21, 73, 255, 0.34), transparent 70%);
    pointer-events: none;
  }
  .cs-hero .wrap {
    position: relative;
    display: grid;
    gap: 24px;
  }
  .cs-hero .h-hero {
    font-size: clamp(2.5rem, 6vw, 5.2rem);
  }
  .cs-opts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 16px;
  }
  .cs-opt {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 24px;
    border-radius: var(--r);
    border: 1px solid var(--line-2);
    background: rgba(255, 255, 255, 0.03);
    transition:
      border-color 0.3s,
      transform 0.45s var(--ease-out);
  }
  .cs-opt:hover {
    transform: translateY(-4px);
    border-color: var(--cyan);
  }
  .cs-opt :global(svg) {
    color: var(--cyan);
    margin-bottom: 8px;
  }
  .cs-opt b {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }
  .cs-opt span {
    font-weight: 500;
  }
  .cs-opt em {
    font-style: normal;
    font-size: 0.86rem;
    color: var(--muted);
  }
  .cs-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(24px, 4vw, 60px);
    align-items: start;
  }
  .cs-card {
    display: grid;
    gap: 20px;
    padding: clamp(24px, 3.4vw, 44px);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: rgba(8, 13, 31, 0.8);
  }
  .cs-note {
    margin-top: -10px;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .cs-card :global(.opt) {
    font-weight: 400;
    color: var(--dim);
  }
  .cs-side {
    display: grid;
    gap: clamp(32px, 4vw, 52px);
  }
  .cs-logins {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 14px;
    border-top: 1px solid var(--line);
  }
  .cs-logins a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 10px 12px 0;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
    transition: color 0.2s;
  }
  .cs-logins a:hover {
    color: var(--cyan);
  }
  .cs-logins a :global(svg) {
    opacity: 0.5;
  }
  .cs-faq {
    margin-top: 14px;
    border-top: 1px solid var(--line-2);
  }
  .cs-faq details {
    border-bottom: 1px solid var(--line-2);
  }
  .cs-faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .cs-faq summary::-webkit-details-marker {
    display: none;
  }
  .cs-faq summary :global(svg) {
    flex-shrink: 0;
    color: var(--cyan);
    transition: transform 0.35s var(--ease-out);
  }
  .cs-faq details[open] summary :global(svg) {
    transform: rotate(45deg);
  }
  .cs-faq p {
    padding: 0 30px 18px 0;
    color: var(--muted);
    font-size: 0.96rem;
  }
  @media (max-width: 940px) {
    .cs-opts,
    .cs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
