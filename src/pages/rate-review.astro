---
import Landing from '../components/Landing.astro';
import LeadForm from '../components/LeadForm.astro';

const features = [
  { title: 'Your current rates and fees', body: 'What you are actually paying, line by line, not just the headline rate.' },
  { title: 'Cash discount or dual pricing', body: 'Whether a compliant program could offset your processing costs.' },
  { title: 'POS and terminal setup', body: 'Whether the equipment and software you run still fit your industry.' },
  { title: 'Funding speed', body: 'Next-day funding options for your account.' },
  { title: 'Reporting and back office', body: 'The tools you have for seeing what happened, and what you are missing.' },
];
const industries = ['Restaurant & Hospitality', 'Retail', 'E-commerce', 'Repair Shop', 'Contractor', 'Healthcare', 'Non-profit', 'Higher Education', 'Other'];
const volumes = ['Under $10,000', '$10,000 – $50,000', '$50,000 – $100,000', '$100,000 – $250,000', '$250,000 – $1M', 'Over $1M'];
---

<Landing
  title="Free rate review | PPD Technology"
  description="See if your business could lower payment processing costs or improve its POS setup. Send a few details and PPD Technology will review your current setup, with no obligation."
  eyebrow="Free rate review"
  headline={['See what you pay.', 'See what you could pay.']}
  lede="Send us a few details and our team will review your current processing setup. No obligation, and a straight answer either way."
  cta={[{ label: 'Request your review', href: '#review' }]}
  chips={['No obligation', 'U.S.-based team', 'Fast turnaround']}
  featuresHead={{ eyebrow: 'What we look at', title: 'Five things, in plain numbers.' }}
  features={features}
  form={{ id: 'review', tag: 'rate-review', subject: 'New Free Rate Review Request', title: 'Request your rate review.', lede: 'Tell us a bit about your business and current setup. We will take it from there.' }}
>
  <Fragment slot="form">
    <LeadForm form="rate-review" subject="New Free Rate Review Request" cta="Get my free rate review" note="Free, no obligation. We only use your details to review your setup.">
      <div class="field">
        <label for="rr-name">Name</label>
        <input id="rr-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="rr-business">Business name</label>
        <input id="rr-business" name="business_name" type="text" autocomplete="organization" required />
      </div>
      <div class="field">
        <label for="rr-phone">Phone</label>
        <input id="rr-phone" name="phone" type="tel" autocomplete="tel" required />
      </div>
      <div class="field">
        <label for="rr-email">Email</label>
        <input id="rr-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="rr-industry">Industry</label>
        <select id="rr-industry" name="industry" required>
          <option value="">Select</option>
          {industries.map((i) => <option>{i}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="rr-processor">Current processor <span class="opt">optional</span></label>
        <input id="rr-processor" name="current_processor" type="text" />
      </div>
      <div class="field field--full">
        <label for="rr-volume">Estimated monthly processing volume <span class="opt">optional</span></label>
        <select id="rr-volume" name="monthly_volume">
          <option value="">Select</option>
          {volumes.map((v) => <option>{v}</option>)}
        </select>
      </div>
      <div class="field field--full">
        <label for="rr-message">Notes <span class="opt">optional</span></label>
        <textarea id="rr-message" name="message" rows="3"></textarea>
      </div>
    </LeadForm>
  </Fragment>
</Landing>
