---
import BaseLayout from "../layouts/BaseLayout.astro";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<BaseLayout title="Clover Devices | PPD Technology" description="Clover POS devices and payment solutions through PPD Technology. Countertop, mobile, and kiosk options for restaurants, retail, and service businesses.">
  <div class="clover-page">
    <div class="crumbs">
      <div class="container">
        <a href="https://ppdtechnology.com">Home</a>
        <span class="sep">›</span>
        <span>Products</span>
        <span class="sep">›</span>
        <strong>Clover</strong>
      </div>
    </div>

    <section class="hero">
      <div class="container hero-grid">
        <div>
          <span class="kicker"><i class="fa-solid fa-leaf"></i> Clover POS Ecosystem</span>
          <h1 class="reveal">All-in-one Clover devices for counter, handheld, and on-the-go payments</h1>
          <p class="reveal">
            Choose the perfect mix of Clover hardware to run your business, whether you sell at the counter, tableside, curbside, or on the move.
            Set up quickly with PPD Technology onboarding, next-day funding, and 24/7 support.
          </p>
          <div class="hero-actions reveal">
            <a class="btn btn-primary magnet" href="#lineup">Explore Lineup</a>
            <a class="btn btn-outline magnet" href="#compare">Compare Models</a>
          </div>
        </div>

        <div class="solo-anim reveal" aria-hidden="true">
          <div class="solo-frame">
            <span class="solo-shine"></span>
            <img
              loading="lazy"
              src="https://mmdabbagh24.neocities.org/images/Clover/Clover%20solo.png"
              alt="Clover Station Solo"
            />
          </div>
        </div>
      </div>
    </section>

    <div class="tabs" id="lineup">
      <div class="container">
        <button class="tab active" data-target="#station-duo">Station Duo</button>
        <button class="tab" data-target="#station-solo">Station Solo</button>
        <button class="tab" data-target="#mini">Mini</button>
        <button class="tab" data-target="#flex">Flex 3</button>
      </div>
    </div>

    <section id="station-duo" class="device alt">
      <div class="container device-grid">
        <div>
          <span class="tag"><i class="fa-solid fa-bolt"></i> Best for busy counters</span>
          <h2 class="reveal">Clover Station Duo, two screens, zero bottlenecks</h2>
          <p class="reveal">
            Run your front counter at full speed with a merchant screen and a dedicated customer-facing display for PIN, tips, and signatures.
            Accept cards, contactless payments, and mobile wallets with fast EMV processing.
          </p>

          <div class="points">
            <div class="point reveal">
              <i class="fa-solid fa-display"></i>
              <div><strong>Dual displays</strong><br />Cashier and customer screens for faster checkouts.</div>
            </div>
            <div class="point reveal">
              <i class="fa-solid fa-credit-card"></i>
              <div><strong>All payment types</strong><br />EMV, swipe, tap, Apple Pay, and Google Pay.</div>
            </div>
            <div class="point reveal">
              <i class="fa-solid fa-print"></i>
              <div><strong>Built-in printer support</strong><br />Optional accessories that fit your setup.</div>
            </div>
            <div class="point reveal">
              <i class="fa-solid fa-store"></i>
              <div><strong>Great for retail and quick-serve</strong><br />Inventory, barcode, and modifiers included.</div>
            </div>
          </div>

          <div class="device-actions reveal">
            <button class="btn btn-primary open-pricing" type="button">Get pricing</button>
            <a class="btn btn-outline" href="#compare">Compare</a>
          </div>
        </div>

        <div class="device-visual reveal tilt">
          <span class="badge"><i class="fa-solid fa-star"></i> Popular</span>
          <img
            loading="lazy"
            src="https://mmdabbagh24.neocities.org/images/Clover/Clover%20station%20with%20kit%20duo.png"
            alt="Clover Station Duo"
          />
        </div>
      </div>
    </section>

    <section id="station-solo" class="device">
      <div class="container device-grid">
        <div class="device-visual reveal tilt">
          <img
            loading="lazy"
            src="https://mmdabbagh24.neocities.org/images/Clover/Clover%20solo.png"
            alt="Clover Station Solo"
          />
        </div>

        <div>
          <span class="tag"><i class="fa-solid fa-layer-group"></i> Countertop powerhouse</span>
          <h2 class="reveal">Clover Station Solo, big screen, simple workflow</h2>
          <p class="reveal">
            The large HD touchscreen keeps menus, modifiers, and orders easy to manage. Add accessories like barcode scanners,
            scales, label printers, or cash drawers as you grow.
          </p>

          <div class="points">
            <div class="point reveal">
              <i class="fa-solid fa-tablet-screen-button"></i>
              <div><strong>Large display</strong><br />Easy order entry and employee management.</div>
            </div>
            <div class="point reveal">
              <i class="fa-solid fa-shield-halved"></i>
              <div><strong>PCI and tokenization</strong><br />Bank-level security with end-to-end encryption.</div>
            </div>
            <div class="point reveal">
              <i class="fa-solid fa-cloud"></i>
              <div><strong>Cloud reporting</strong><br />Sales, refunds, tips, and taxes in real time.</div>
            </div>
            <div class="point reveal">
              <i class="fa-solid fa-puzzle-piece"></i>
              <div><strong>Apps and integrations</strong><br />Payroll, loyalty, gift cards, and more.</div>
            </div>
          </div>

          <div class="device-actions reveal">
            <a class="btn btn-primary" href="#contact">Talk to sales</a>
            <a class="btn btn-outline" href="#compare">Compare</a>
          </div>
        </div>
      </div>
    </section>

    <section id="mini" class="device alt">
      <div class="container device-grid">
        <div>
          <span class="tag"><i class="fa-solid fa-compress"></i> Small footprint</span>
          <h2 class="reveal">Clover Mini, compact counter with full POS power</h2>
          <p class="reveal">
            A space-saving POS with a bright screen. Great for boutiques, food trucks, pop-ups, and any tight counter where speed matters.
          </p>

          <div class="points">
            <div class="point reveal">
              <i class="fa-solid fa-gauge-high"></i>
              <div><strong>Fast EMV</strong><br />Quick dips and taps with less line time.</div>
            </div>
            <div class="point reveal">
              <i class="fa-solid fa-wifi"></i>
              <div><strong>Wi-Fi and Ethernet</strong><br />Stay connected wherever you sell.</div>
            </div>
            <div class="point reveal">
              <i class="fa-solid fa-credit-card"></i>
              <div><strong>Tips and signatures</strong><br />Customer-friendly screen workflow.</div>
            </div>
            <div class="point reveal">
              <i class="fa-solid fa-receipt"></i>
              <div><strong>Built-in printing support</strong><br />Works well for quick countertop receipts.</div>
            </div>
          </div>

          <div class="device-actions reveal">
            <a class="btn btn-primary" href="#contact">Check availability</a>
            <a class="btn btn-outline" href="#compare">Compare</a>
          </div>
        </div>

        <div class="device-visual reveal tilt">
          <img
            loading="lazy"
            src="https://mmdabbagh24.neocities.org/images/Clover/clover-mini-paid.png"
            alt="Clover Mini"
          />
        </div>
      </div>
    </section>

    <section id="flex" class="device">
      <div class="container device-grid">
        <div class="device-visual reveal tilt">
          <img
            loading="lazy"
            src="https://mmdabbagh24.neocities.org/images/Clover/flex3-diagram-web.png"
            alt="Clover Flex 3 handheld"
          />
        </div>

        <div>
          <span class="tag"><i class="fa-solid fa-mobile-screen-button"></i> Handheld freedom</span>
          <h2 class="reveal">Clover Flex 3, take payments anywhere</h2>
          <p class="reveal">
            Great for tableside, curbside, delivery, and line-busting. Accept tap, chip, and swipe payments,
            plus tips and receipts, all from one handheld device.
          </p>

          <div class="points">
            <div class="point reveal">
              <i class="fa-solid fa-location-arrow"></i>
              <div><strong>On the go</strong><br />Wi-Fi and optional LTE keep you selling.</div>
            </div>
            <div class="point reveal">
              <i class="fa-solid fa-user-check"></i>
              <div><strong>Line-busting</strong><br />Take orders and payments anywhere.</div>
            </div>
            <div class="point reveal">
              <i class="fa-solid fa-clipboard-check"></i>
              <div><strong>Tips and receipts</strong><br />Digital or printed receipts on the spot.</div>
            </div>
            <div class="point reveal">
              <i class="fa-solid fa-battery-full"></i>
              <div><strong>All-day battery</strong><br />Built to handle service rushes.</div>
            </div>
          </div>

          <div class="device-actions reveal">
            <a class="btn btn-primary" href="#contact">Request a demo</a>
            <a class="btn btn-outline" href="#compare">Compare</a>
          </div>
        </div>
      </div>
    </section>

    <div class="promo">
      <div class="container">
        <span class="pill"><i class="fa-solid fa-shield-halved"></i> PCI-compliant and encrypted</span>
        <span class="pill"><i class="fa-solid fa-bolt"></i> Next-day funding</span>
        <span class="pill"><i class="fa-solid fa-headset"></i> 24/7 U.S. support</span>
        <span class="pill"><i class="fa-solid fa-sack-dollar"></i> Transparent pricing</span>
      </div>
    </div>

    <section id="compare" class="compare">
      <div class="container">
        <h3 class="reveal">Compare Clover Models</h3>
        <div class="table-wrap reveal">
          <table>
            <thead>
              <tr>
                <th>Feature</th>
                <th>Station Duo</th>
                <th>Station Solo</th>
                <th>Mini</th>
                <th>Flex 3</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Display</td><td>14&quot; + Customer 7&quot;</td><td>14&quot;</td><td>8&quot;</td><td>5&quot;</td></tr>
              <tr><td>Payments</td><td class="yes">EMV / Swipe / Tap</td><td class="yes">EMV / Swipe / Tap</td><td class="yes">EMV / Swipe / Tap</td><td class="yes">EMV / Swipe / Tap</td></tr>
              <tr><td>Receipt printing</td><td class="yes">Built-in</td><td class="yes">Built-in</td><td class="yes">Built-in</td><td class="yes">Built-in</td></tr>
              <tr><td>Connectivity</td><td>Ethernet / Wi-Fi</td><td>Ethernet / Wi-Fi</td><td>Ethernet / Wi-Fi</td><td>Wi-Fi / optional LTE</td></tr>
              <tr><td>Best for</td><td>Retail &amp; QSR</td><td>Counter service</td><td>Small counters</td><td>Tableside &amp; mobile</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="callouts">
      <div class="container">
        <div class="grid">
          <div class="callout reveal">
            <i class="fa-solid fa-download"></i>
            <h4>Fast setup</h4>
            <p>We help pre-configure your Clover devices and make setup easier so you can go live quickly.</p>
          </div>
          <div class="callout reveal">
            <i class="fa-solid fa-cubes"></i>
            <h4>Add-ons that scale</h4>
            <p>Barcode scanners, scales, kitchen printers, label printers, customer displays, and more.</p>
          </div>
          <div class="callout reveal">
            <i class="fa-solid fa-diagram-project"></i>
            <h4>Apps and integrations</h4>
            <p>Payroll, loyalty, gift cards, online ordering, and many useful Clover marketplace apps.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="faq" id="faq">
      <div class="container">
        <h3 class="reveal">Clover FAQs</h3>
        <div class="accordion">
          <div class="faq-item reveal">
            <div class="faq-q">
              Can I use my existing Clover with PPD Technology?
              <i class="fa-solid fa-chevron-down"></i>
            </div>
            <div class="faq-a">
              Often yes. We can review compatible Clover hardware and confirm what can be re-boarded.
            </div>
          </div>

          <div class="faq-item reveal">
            <div class="faq-q">
              Do you support tips, tabs, and split payments?
              <i class="fa-solid fa-chevron-down"></i>
            </div>
            <div class="faq-a">
              Yes. Tipping, bar tabs, split bills, and other workflow tools are available depending on the business type.
            </div>
          </div>

          <div class="faq-item reveal">
            <div class="faq-q">
              What’s the warranty and support like?
              <i class="fa-solid fa-chevron-down"></i>
            </div>
            <div class="faq-a">
              Devices include manufacturer coverage, and PPD Technology support is available to help with setup and ongoing issues.
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="cta" id="contact">
      <div class="container">
        <h2>Ready to outfit your business with Clover?</h2>
        <p>
          Tell us your industry and locations and we’ll recommend the ideal mix of Clover hardware with transparent pricing.
        </p>
        <a class="btn btn-primary magnet" href="https://ppdtechnology.com/contact">Talk to Sales</a>
      </div>
    </section>

    <div id="pricingModal" class="modal" aria-hidden="true" role="dialog" aria-modal="true">
      <div class="modal-dialog" role="document">
        <div class="modal-header">
          <h3>Get pricing for Clover</h3>
          <button class="close-x" id="pricingClose" aria-label="Close">✕</button>
        </div>
        <div class="modal-body">
          <form id="pricingForm" action="/api/lead" method="POST" novalidate>
            <input type="hidden" name="_form" value="clover-pricing" />
            <input type="hidden" name="_subject" value="New Clover Pricing Request" />
            <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" aria-hidden="true" />
            <div class="form-grid">
              <div class="field">
                <label for="name">Full name <span class="required">*</span></label>
                <input id="name" name="name" type="text" placeholder="Jane Smith" required />
              </div>

              <div class="field">
                <label for="email">Work email <span class="required">*</span></label>
                <input id="email" name="email" type="email" placeholder="name@company.com" required />
              </div>

              <div class="field">
                <label for="business">Business name <span class="required">*</span></label>
                <input id="business" name="business" type="text" placeholder="Acme Retail" required />
              </div>

              <div class="field">
                <label for="volume">Monthly processing (approx.)</label>
                <select id="volume" name="volume">
                  <option value="">Select range</option>
                  <option>&lt;$10k</option>
                  <option>$10k–$30k</option>
                  <option>$30k–$75k</option>
                  <option>$75k–$150k</option>
                  <option>$150k+</option>
                </select>
              </div>

              <div class="field">
                <label for="industry">Industry</label>
                <select id="industry" name="industry">
                  <option value="">Select industry</option>
                  <option>Restaurant</option>
                  <option>Retail</option>
                  <option>Healthcare</option>
                  <option>Contractor/Field</option>
                  <option>Non-profit</option>
                  <option>Higher-ed</option>
                  <option>Other</option>
                </select>
              </div>

              <div class="field">
                <label>Devices interested in</label>
                <div class="inline small">
                  <label><input type="checkbox" name="devices" value="Station Duo" /> Station Duo</label>
                  <label><input type="checkbox" name="devices" value="Station Solo" /> Station Solo</label>
                  <label><input type="checkbox" name="devices" value="Mini" /> Mini</label>
                  <label><input type="checkbox" name="devices" value="Flex 3" /> Flex 3</label>
                </div>
              </div>

              <div class="field">
                <label for="contactMethod">Preferred contact</label>
                <select id="contactMethod" name="contactMethod">
                  <option>Email</option>
                  <option>Phone</option>
                </select>
              </div>

              <div class="field field-full">
                <label for="notes">Notes</label>
                <textarea id="notes" name="notes" rows="4" placeholder="Locations, terminals needed, timeline, special requirements..."></textarea>
              </div>
            </div>

            {turnstileSiteKey && (
              <div class="field field-full">
                <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="flexible"></div>
              </div>
            )}

            <div class="inline actions-row">
              <span class="small">By submitting, you agree to be contacted by PPD Technology.</span>
              <button class="btn btn-primary" type="submit">Request pricing</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="toast" id="pricingToast">Request received. We’ll reach out shortly.</div>
  </div>

  <style>
    .clover-page{
      --primary:#1549FF;
      --primary-dark:#0F38CC;
      --secondary:#060E21;
      --accent:#00E5A0;
      --light:#F5F8FF;
      --dark:#060E21;
      --gray:#7B93B0;
      --light-gray:#E2E8F4;
      --clover:#00C389;
      background:var(--light);
      color:var(--dark);
    }

    .clover-page *{box-sizing:border-box}
    .clover-page a{text-decoration:none;color:inherit}
    .clover-page img{max-width:100%;display:block}
    .clover-page .container{width:100%;max-width:1200px;margin:0 auto;padding:0 20px}

    .clover-page .crumbs{background:#fff;border-bottom:1px solid var(--light-gray)}
    .clover-page .crumbs .container{display:flex;align-items:center;gap:8px;padding:10px 20px}
    .clover-page .crumbs a,.clover-page .crumbs span,.clover-page .crumbs strong{font-size:13px;color:#475569}
    .clover-page .crumbs strong{color:var(--secondary)}
    .clover-page .crumbs .sep{opacity:.5}

    .clover-page .hero{
      background:
        radial-gradient(ellipse 100% 70% at 80% -10%, rgba(21,73,255,.28) 0%, transparent 60%),
        linear-gradient(160deg, #060E21 0%, #0C1A38 60%, #0a1c42 100%);
      color:#fff;
      padding:80px 0 56px;
      position:relative;
      overflow:hidden;
    }
    .clover-page .hero::before{
      content:"";position:absolute;inset:0;
      background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.025'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      pointer-events:none;opacity:.3;
    }
    .clover-page .hero-grid{display:grid;gap:30px;align-items:center}
    @media (min-width:900px){
      .clover-page .hero-grid{grid-template-columns:1.2fr .8fr}
    }

    .clover-page .kicker{
      display:inline-flex;align-items:center;gap:8px;
      background:rgba(0,195,137,.12);
      border:1px solid rgba(0,195,137,.3);
      padding:6px 12px;border-radius:999px;
      margin-bottom:14px;font-size:12px;
      color:var(--clover);
      font-weight:700;letter-spacing:.03em;text-transform:uppercase;
    }
    .clover-page .hero h1{font-size:clamp(2rem,4.2vw,3.4rem);line-height:1.12;margin-bottom:14px;font-weight:800;letter-spacing:-.02em;color:#fff}
    .clover-page .hero p{font-size:1.05rem;opacity:.85;margin-bottom:20px;max-width:58ch;color:rgba(255,255,255,.85)}
    .clover-page .hero-actions{display:flex;gap:10px;flex-wrap:wrap}

    .clover-page .solo-anim{position:relative;min-height:360px;display:flex;align-items:center;justify-content:center;will-change:transform;transition:transform .08s ease-out}
    .clover-page .solo-frame{position:relative;width:min(560px,92%);background:transparent;animation:floatSolo 7s ease-in-out infinite}
    .clover-page .solo-frame img{width:100%;height:auto}
    .clover-page .solo-shine{
      position:absolute;top:0;left:-60%;width:40%;height:100%;
      background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);
      transform:skewX(-20deg);animation:shine 5.5s infinite;
    }

    .clover-page .tabs{
      position:sticky;top:64px;background:#fff;border-bottom:1px solid var(--light-gray);z-index:10
    }
    .clover-page .tabs .container{display:flex;gap:12px;overflow:auto;padding:10px 20px}
    .clover-page .tab{
      flex:0 0 auto;padding:10px 14px;border-radius:999px;border:1px solid var(--light-gray);
      background:#fff;font-weight:600;color:#0f172a;cursor:pointer;transition:all .25s;
    }
    .clover-page .tab:hover{transform:translateY(-2px)}
    .clover-page .tab.active{
      background:var(--clover);border-color:var(--clover);color:#fff;
      box-shadow:0 10px 20px rgba(0,195,137,.2);
    }

    .clover-page .device{padding:64px 0;background:#fff}
    .clover-page .device.alt{background:linear-gradient(180deg,#fff 0%, #f9fbff 100%)}
    .clover-page .device-grid{display:grid;gap:28px;align-items:center}
    @media (min-width:980px){
      .clover-page .device-grid{grid-template-columns:1.2fr .8fr}
    }

    .clover-page .tag{
      display:inline-flex;align-items:center;gap:8px;padding:6px 10px;border-radius:999px;
      background:rgba(0,85,255,.08);color:var(--primary);font-weight:700;font-size:12px;margin-bottom:10px
    }
    .clover-page .device h2{font-size:clamp(1.8rem,3.8vw,2.4rem);margin-bottom:10px;color:var(--secondary)}
    .clover-page .device p{color:#334155;margin-bottom:18px}

    .clover-page .points{display:grid;grid-template-columns:1fr;gap:10px;margin:16px 0}
    @media (min-width:720px){
      .clover-page .points{grid-template-columns:repeat(2,1fr)}
    }

    .clover-page .point{
      display:flex;gap:10px;align-items:flex-start;background:#fff;border:1px solid var(--light-gray);
      border-radius:12px;padding:12px 14px;box-shadow:0 8px 20px rgba(16,24,40,.06)
    }
    .clover-page .point i{color:var(--primary)}
    .clover-page .device-actions{display:flex;gap:10px;flex-wrap:wrap}

    .clover-page .device-visual{
      position:relative;border-radius:16px;overflow:hidden;background:#fff;border:1px solid var(--light-gray);
      box-shadow:0 8px 20px rgba(16,24,40,.06)
    }
    .clover-page .badge{
      position:absolute;top:12px;left:12px;background:#fff;border:1px solid var(--light-gray);border-radius:10px;
      padding:6px 10px;display:inline-flex;align-items:center;gap:8px;font-weight:700;box-shadow:0 6px 16px rgba(16,24,40,.08)
    }

    .clover-page .compare{padding:64px 0;background:#fff}
    .clover-page .compare h3{text-align:center;font-size:1.8rem;margin-bottom:18px;color:var(--secondary)}
    .clover-page .table-wrap{overflow:auto}
    .clover-page table{
      width:100%;border-collapse:collapse;background:#fff;border:1px solid var(--light-gray);
      box-shadow:0 14px 28px rgba(16,24,40,.08);border-radius:16px;overflow:hidden
    }
    .clover-page th,.clover-page td{padding:14px 12px;text-align:left;border-bottom:1px solid var(--light-gray)}
    .clover-page thead th{background:#f7faff;color:#0f172a;font-size:.95rem}
    .clover-page tbody tr:hover{background:#f9fbff}
    .clover-page .yes{color:#10B981;font-weight:700}

    .clover-page .promo{background:linear-gradient(135deg,var(--clover) 0%, #00a876 100%);color:#fff;padding:18px 0}
    .clover-page .promo .container{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:12px}
    .clover-page .pill{
      display:inline-flex;gap:8px;align-items:center;padding:8px 12px;border-radius:999px;
      background:#fff;color:var(--clover);border:1px solid rgba(0,195,137,.25);
      box-shadow:0 6px 14px rgba(0,195,137,.18);transition:transform .2s ease;font-weight:700
    }
    .clover-page .pill:hover{transform:translateY(-2px)}
    .clover-page .pill i{color:var(--clover)}

    .clover-page .callouts{padding:60px 0;background:#fff}
    .clover-page .grid{display:grid;gap:18px}
    @media (min-width:900px){
      .clover-page .grid{grid-template-columns:repeat(3,1fr)}
    }
    .clover-page .callout{
      background:#fff;border:1px solid var(--light-gray);border-radius:16px;padding:20px;
      box-shadow:0 10px 24px rgba(16,24,40,.08);transition:transform .25s, box-shadow .25s
    }
    .clover-page .callout:hover{transform:translateY(-4px);box-shadow:0 16px 36px rgba(16,24,40,.12)}
    .clover-page .callout h4{margin:8px 0;color:var(--secondary)}

    .clover-page .faq{padding:64px 0;background:linear-gradient(180deg,#fff 0%, #f9fbff 100%)}
    .clover-page .faq h3{text-align:center;font-size:1.8rem;margin-bottom:18px;color:var(--secondary)}
    .clover-page .accordion{max-width:900px;margin:0 auto}
    .clover-page .faq-item{background:#fff;border:1px solid var(--light-gray);border-radius:12px;margin-bottom:10px;overflow:hidden}
    .clover-page .faq-q{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px;cursor:pointer;font-weight:700}
    .clover-page .faq-a{display:none;padding:0 18px 16px 18px;color:#334155}
    .clover-page .faq-item.open .faq-a{display:block}

    .clover-page .cta{
      color:#fff;padding:70px 0;text-align:center;position:relative;overflow:hidden;
      background:linear-gradient(135deg,var(--clover) 0%, #00a876 100%);
      background-size:200% 200%;animation:ctaGradient 12s ease-in-out infinite
    }
    .clover-page .cta h2{font-size:2rem;margin-bottom:12px}
    .clover-page .cta p{opacity:.95;max-width:720px;margin:0 auto 18px}

    .clover-page .btn{
      padding:10px 18px;border-radius:30px;font-weight:700;transition:transform .2s ease, box-shadow .25s, background .3s, color .3s;
      cursor:pointer;display:inline-flex;align-items:center;justify-content:center;font-size:14px;position:relative;overflow:hidden;border:2px solid transparent
    }
    .clover-page .btn::after{
      content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent,rgba(255,255,255,.6),transparent);transform:translateX(-150%)
    }
    .clover-page .btn:hover::after{animation:btnSweep .8s ease}
    .clover-page .btn-outline{border:1.5px solid rgba(255,255,255,.3);color:#fff;background:rgba(255,255,255,.06)}
    .clover-page .btn-outline:hover{border-color:rgba(255,255,255,.6);color:#fff;background:rgba(255,255,255,.1);transform:translateY(-2px)}
    .clover-page .btn-primary{background:linear-gradient(135deg,#2D60FF,#1549FF);color:#fff;border:none;box-shadow:0 8px 28px rgba(21,73,255,.35)}
    .clover-page .btn-primary:hover{background:linear-gradient(135deg,#1549FF,#0F38CC);transform:translateY(-2px);box-shadow:0 12px 32px rgba(21,73,255,.45)}

    .clover-page .reveal{opacity:0;transform:translateY(22px);transition:all .7s ease}
    .clover-page .reveal.show{opacity:1;transform:translateY(0)}
    .clover-page .tilt{will-change:transform;transition:transform .2s ease}

    .clover-page .modal{
      position:fixed;inset:0;background:rgba(2,6,23,.5);display:none;align-items:center;justify-content:center;
      z-index:1200;padding:20px
    }
    .clover-page .modal.active{display:flex}
    .clover-page .modal-dialog{
      width:100%;max-width:720px;background:#fff;border-radius:18px;box-shadow:0 24px 60px rgba(16,24,40,.22);
      overflow:hidden;border:1px solid var(--light-gray)
    }
    .clover-page .modal-header{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid var(--light-gray)}
    .clover-page .modal-header h3{margin:0;color:var(--secondary)}
    .clover-page .close-x{background:none;border:none;font-size:22px;cursor:pointer;color:#334155}
    .clover-page .modal-body{padding:18px}
    .clover-page .form-grid{display:grid;gap:12px}
    @media (min-width:780px){
      .clover-page .form-grid{grid-template-columns:repeat(2,1fr)}
    }
    .clover-page .field{display:flex;flex-direction:column;gap:6px}
    .clover-page .field label{font-weight:700;font-size:.92rem;color:#0f172a}
    .clover-page .field input,
    .clover-page .field select,
    .clover-page .field textarea{
      padding:10px 12px;border-radius:10px;border:1px solid var(--light-gray);background:#fff;outline:none
    }
    .clover-page .field input:focus,
    .clover-page .field select:focus,
    .clover-page .field textarea:focus{
      border-color:var(--clover);box-shadow:0 0 0 3px rgba(0,195,137,.15)
    }
    .clover-page .field-full{grid-column:1 / -1}
    .clover-page .inline{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
    .clover-page .actions-row{justify-content:space-between;margin-top:12px}
    .clover-page .small{font-size:.85rem;color:#475569}
    .clover-page .required{color:#ef4444;margin-left:2px}

    .clover-page .toast{
      position:fixed;bottom:20px;left:50%;transform:translateX(-50%);
      background:#0f172a;color:#fff;padding:10px 14px;border-radius:10px;
      box-shadow:0 10px 20px rgba(0,0,0,.25);display:none;z-index:1300
    }
    .clover-page .toast.show{display:block}

    @keyframes shine{
      0%{transform:translateX(0) skewX(-20deg)}
      50%{transform:translateX(380%) skewX(-20deg)}
      100%{transform:translateX(380%) skewX(-20deg)}
    }
    @keyframes floatSolo{
      0%,100%{transform:translateY(0)}
      50%{transform:translateY(-10px)}
    }
    @keyframes btnSweep{
      from{transform:translateX(-150%)}
      to{transform:translateX(150%)}
    }
    @keyframes ctaGradient{
      0%{background-position:0% 50%}
      50%{background-position:100% 50%}
      100%{background-position:0% 50%}
    }

    @media (prefers-reduced-motion:reduce){
      .clover-page *{animation:none !important;transition:none !important}
    }
  </style>

  <script is:inline>
    (() => {
      const root = document.querySelector(".clover-page");
      if (!root) return;

      const revealEls = root.querySelectorAll(".reveal");
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("show");
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      revealEls.forEach((el) => io.observe(el));

      const tabs = root.querySelectorAll(".tab");
      const sections = ["#station-duo", "#station-solo", "#mini", "#flex"].map((id) => root.querySelector(id));

      function setActive(id) {
        tabs.forEach((tab) => tab.classList.toggle("active", tab.dataset.target === id));
      }

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const id = tab.dataset.target;
          setActive(id);
          const section = root.querySelector(id);
          if (section) {
            window.scrollTo({ top: section.offsetTop - 60, behavior: "smooth" });
          }
        });
      });

      window.addEventListener("scroll", () => {
        let current = "#station-duo";
        sections.forEach((section) => {
          if (!section) return;
          const top = section.getBoundingClientRect().top;
          if (top < 140) current = "#" + section.id;
        });
        setActive(current);
      }, { passive: true });

      root.querySelectorAll(".tilt").forEach((card) => {
        const damp = 18;
        const rect = () => card.getBoundingClientRect();

        card.addEventListener("mousemove", (e) => {
          const b = rect();
          const cx = b.left + b.width / 2;
          const cy = b.top + b.height / 2;
          const dx = (e.clientX - cx) / damp;
          const dy = (e.clientY - cy) / damp;
          card.style.transform = `perspective(900px) rotateY(${dx}deg) rotateX(${-dy}deg)`;
        });

        card.addEventListener("mouseleave", () => {
          card.style.transform = "";
        });
      });

      root.querySelectorAll(".faq-item").forEach((item) => {
        const q = item.querySelector(".faq-q");
        q?.addEventListener("click", () => item.classList.toggle("open"));
      });

      const modal = root.querySelector("#pricingModal");
      const openers = root.querySelectorAll(".open-pricing");
      const closeBtn = root.querySelector("#pricingClose");
      const toast = root.querySelector("#pricingToast");
      const form = root.querySelector("#pricingForm");

      const openModal = () => {
        if (!modal) return;
        modal.classList.add("active");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      };

      const closeModal = () => {
        if (!modal) return;
        modal.classList.remove("active");
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "auto";
      };

      openers.forEach((btn) => btn.addEventListener("click", openModal));
      closeBtn?.addEventListener("click", closeModal);
      modal?.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && modal?.classList.contains("active")) {
          closeModal();
        }
      });

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (form.website && form.website.value) return;
        const data = new FormData(form);
        if (!data.get("name") || !data.get("email") || !data.get("business")) {
          alert("Please fill name, email, and business.");
          return;
        }
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn ? submitBtn.innerHTML : "";
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = "Sending…";
        }
        try {
          data.append("_page", window.location.pathname);
          const res = await fetch("/api/lead", { method: "POST", body: data });
          if (!res.ok) throw new Error("Network");
          closeModal();
          form.reset();
          toast?.classList.add("show");
          setTimeout(() => toast?.classList.remove("show"), 2600);
        } catch {
          alert("Sorry, something went wrong sending your request. Please email info@ppdtechnology.com and we'll help right away.");
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
          }
        }
      });

      const hero = root.querySelector(".hero");
      const wrap = root.querySelector(".solo-anim");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
      if (hero && wrap && !reduce.matches) {
        const max = 8;
        hero.addEventListener("mousemove", (e) => {
          const r = hero.getBoundingClientRect();
          const x = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);
          const y = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);
          wrap.style.transform = `translate(${x * max}px, ${y * max}px)`;
        });
        hero.addEventListener("mouseleave", () => {
          wrap.style.transform = "translate(0,0)";
        });
      }
    })();
  </script>
</BaseLayout>