---
import Landing from '../components/Landing.astro';
import FormExtras from '../components/FormExtras.astro';

const features = [
  { title: 'One system for the counter and the floor', body: 'Countertop stations, a compact Mini and a handheld Flex share the same menus, items and reporting.' },
  { title: 'Every way to pay', body: 'Chip, swipe, tap, Apple Pay and Google Pay, with tips and signatures on the customer screen.' },
  { title: 'Cloud reporting', body: 'Sales, refunds, tips and taxes in real time, from any browser.' },
  { title: 'Apps and add-ons', body: 'Payroll, loyalty, gift cards and more, plus scanners, scales, label printers and cash drawers as you grow.' },
  { title: 'Set up by PPD', body: 'We recommend the mix of devices, configure them before they ship and stay on the phone for them.' },
];
const lineup = [
  { name: 'Station Duo', note: 'Dual displays for busy counters. Best for retail and quick service.', img: '/images/hw/clover-duo.webp' },
  { name: 'Station Solo', note: 'A large touchscreen that keeps menus, modifiers and orders easy to manage.', img: '/images/hw/clover.webp' },
  { name: 'Mini', note: 'Full POS in a small footprint, for boutiques, food trucks and tight counters.', img: '/images/hw/clover-mini.webp' },
  { name: 'Flex 3', note: 'Handheld for tableside, curbside and line-busting, on Wi-Fi with optional LTE.', img: '/images/hw/clover-flex.webp' },
];
const faqs = [
  { q: 'Can I use my existing Clover with PPD Technology?', a: 'Often yes. We can review compatible Clover hardware and confirm what can be re-boarded.' },
  { q: 'Do you support tips, tabs and split payments?', a: 'Yes. Tipping, bar tabs, split bills and other workflow tools are available depending on the business type.' },
  { q: 'What is the warranty and support like?', a: 'Devices include manufacturer coverage, and PPD Technology support is available to help with setup and ongoing issues.' },
];
---

<Landing
  title="Clover POS devices from PPD Technology"
  description="Clover Station Duo, Station Solo, Mini and Flex 3, recommended, configured and supported by PPD Technology."
  accent={{ rgb: '0, 195, 137', main: '#00a876', soft: '#5eecc0' }}
  eyebrow="Clover · sold and supported by PPD"
  headline={['Clover devices for the counter,', 'the table and the road.']}
  lede="Choose the mix of Clover hardware that fits how you sell. PPD handles onboarding, setup and support."
  cta={[{ label: 'Get pricing', href: '#demo' }, { label: 'Free rate review', href: '/rate-review' }]}
  chips={['Station Duo', 'Station Solo', 'Mini', 'Flex 3']}
  featuresHead={{ eyebrow: 'Why Clover with PPD', title: 'Familiar hardware, properly set up.' }}
  features={features}
  gear={{ eyebrow: 'The lineup', title: 'Four devices. One system.', items: lineup }}
  faqs={faqs}
  form={{ tag: 'clover-pricing', subject: 'New Clover Pricing Request', title: 'Get pricing for Clover.', lede: 'Tell us your industry and locations and we will recommend the right mix of Clover hardware, with clear pricing.', cta: 'Get pricing' }}
>
  <img slot="visual" src="/images/hw/clover-duo.webp" alt="Clover Station Duo with customer display" width="768" height="455" />

  <Fragment slot="fields">
    <FormExtras
      id="clover"
      select={{ name: 'volume', label: 'Monthly card volume', options: ['Under $10k', '$10k to $50k', '$50k to $150k', '$150k or more'] }}
      topics={['Station Duo', 'Station Solo', 'Mini', 'Flex 3']}
    />
  </Fragment>
</Landing>
