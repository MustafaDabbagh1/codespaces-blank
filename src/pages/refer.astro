---
import Landing from '../components/Landing.astro';
import LeadForm from '../components/LeadForm.astro';

const features = [
  { title: '$200 per approved signup', body: 'Paid once the merchant you referred is approved.' },
  { title: 'We do the heavy lifting', body: 'Demos, documents, setup and migration are handled by us.' },
  { title: 'A partner you can vouch for', body: 'Payment solutions with ongoing support, so the introduction reflects well on you.' },
  { title: 'Fast decisions', body: 'A streamlined path from application to go-live.' },
];
---

<Landing
  title="Refer a merchant and earn $200 | PPD Technology"
  description="Know a business that takes payments? Share the lead and PPD Technology handles the rest. $200 per approved signup."
  accent={{ rgb: '46, 211, 160', main: '#12a67c', soft: '#6ef0c6' }}
  eyebrow="Referral program"
  headline={['Refer a merchant.', 'Pocket $200.']}
  lede="You share a lead. We handle everything else, from demo to underwriting. When the merchant signs up, you get paid."
  cta={[{ label: 'Refer a business', href: '#refer' }, { label: 'Selling payments? See the agent program', href: '/agents' }]}
  featuresHead={{ eyebrow: 'What you get', title: 'That simple.' }}
  features={features}
  form={{ id: 'refer', tag: 'refer-program', subject: 'New Merchant Referral • PPD Technology', title: 'Who should we call?', lede: 'Tell us who you are and which business to reach out to. We will follow up with them and keep you posted.' }}
>
  <Fragment slot="form">
    <LeadForm form="refer-program" subject="New Merchant Referral • PPD Technology" cta="Send referral" note="We only use these details to follow up on your referral.">
      <div class="field">
        <label for="rf-name">Your name</label>
        <input id="rf-name" name="yourName" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="rf-biz">Your business</label>
        <input id="rf-biz" name="yourBusiness" type="text" autocomplete="organization" required />
      </div>
      <div class="field field--full">
        <label for="rf-email">Your email</label>
        <input id="rf-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="rf-owner">Owner’s name</label>
        <input id="rf-owner" name="refOwner" type="text" required />
      </div>
      <div class="field">
        <label for="rf-refbiz">Business to refer</label>
        <input id="rf-refbiz" name="refBusiness" type="text" required />
      </div>
      <div class="field">
        <label for="rf-phone">Owner’s best contact <span class="opt">optional</span></label>
        <input id="rf-phone" name="refPhone" type="text" />
      </div>
      <div class="field">
        <label for="rf-type">Business type <span class="opt">optional</span></label>
        <input id="rf-type" name="bizType" type="text" placeholder="Restaurant, retail, repair…" />
      </div>
      <div class="field">
        <label for="rf-mid">Your MID, if you process with us <span class="opt">optional</span></label>
        <input id="rf-mid" name="mid" type="text" />
      </div>
      <div class="field">
        <label for="rf-payout">How would you like to get paid?</label>
        <select id="rf-payout" name="payout">
          <option value="">Select one</option>
          <option>Direct Deposit</option>
          <option>Statement Credit</option>
        </select>
      </div>
      <div class="field field--full">
        <label for="rf-msg">Helpful context <span class="opt">optional</span></label>
        <textarea id="rf-msg" name="message" rows="3"></textarea>
      </div>
    </LeadForm>
  </Fragment>
</Landing>
