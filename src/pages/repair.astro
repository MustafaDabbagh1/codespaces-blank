---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PPD Technology | All-in-One Repair Shop Management Software">

  <!-- ══════════════ HERO ══════════════ -->
  <section class="rp-hero">
    <div class="rp-hero__grid-bg"></div>
    <div class="rp-hero__orb rp-hero__orb--1"></div>
    <div class="rp-hero__orb rp-hero__orb--2"></div>

    <div class="container rp-hero__inner">
      <div class="rp-hero__text">
        <span class="rp-pill"><i class="fa-solid fa-microchip"></i> All-in-One Repair Shop Software</span>
        <h1>Run Your Entire<br>Repair Shop on<br><span class="rp-grad">One Powerful System</span></h1>
        <p>POS, repair tickets, inventory, customers, and employee management — built specifically for phone repair and service businesses. Stop juggling spreadsheets and disconnected tools.</p>
        <div class="rp-hero__price">
          <span class="rp-hero__price-tag">Starting at just</span>
          <span class="rp-hero__price-val">$30<span>/mo</span></span>
          <span class="rp-hero__price-note">per location · no contracts</span>
        </div>
        <div class="rp-hero__actions">
          <button class="btn btn-primary btn-lg rp-cta-open"><i class="fa-solid fa-phone"></i> Request a Demo</button>
          <button class="btn btn-outline btn-lg rp-cta-open"><i class="fa-solid fa-headset"></i> Get a Call Back</button>
          <a class="btn btn-ghost btn-lg" href="#demo"><i class="fa-solid fa-play"></i> Explore Live Demo</a>
        </div>
        <div class="rp-hero__trust">
          <span><i class="fa-solid fa-shield-halved"></i> PCI Compliant</span>
          <span><i class="fa-solid fa-clock"></i> Setup in Minutes</span>
          <span><i class="fa-solid fa-headset"></i> 24/7 Support</span>
          <span><i class="fa-solid fa-store"></i> Multi-Location</span>
        </div>
      </div>

      <div class="rp-hero__visual">
        <div class="rp-dash">
          <div class="rp-dash__bar">
            <span class="rp-dash__dot" style="background:#ff5f57"></span>
            <span class="rp-dash__dot" style="background:#febc2e"></span>
            <span class="rp-dash__dot" style="background:#28c840"></span>
            <span class="rp-dash__bar-title">PPD Repair — Dashboard</span>
          </div>
          <div class="rp-dash__body">
            <div class="rp-dash__sidebar">
              <div class="rp-dash__nav active"><i class="fa-solid fa-chart-line"></i></div>
              <div class="rp-dash__nav"><i class="fa-solid fa-cash-register"></i></div>
              <div class="rp-dash__nav"><i class="fa-solid fa-ticket"></i></div>
              <div class="rp-dash__nav"><i class="fa-solid fa-boxes-stacked"></i></div>
              <div class="rp-dash__nav"><i class="fa-solid fa-users"></i></div>
              <div class="rp-dash__nav"><i class="fa-solid fa-chart-bar"></i></div>
              <div class="rp-dash__nav"><i class="fa-solid fa-gear"></i></div>
            </div>
            <div class="rp-dash__main">
              <div class="rp-dash__greeting">
                <div>
                  <strong style="font-size:13px">Good morning, Mike</strong>
                  <span style="font-size:10px;opacity:.5;display:block">Quick Fix Wireless — Main St</span>
                </div>
                <div class="rp-dash__presets">
                  <span class="rp-dash__preset active">Today</span>
                  <span class="rp-dash__preset">7 Days</span>
                  <span class="rp-dash__preset">Month</span>
                </div>
              </div>
              <div class="rp-dash__kpi-row">
                <div class="rp-dash__kpi">
                  <span class="rp-dash__kpi-label">Gross Sales</span>
                  <span class="rp-dash__kpi-val">$4,287</span>
                  <span class="rp-dash__tag green"><i class="fa-solid fa-arrow-up"></i> 18%</span>
                </div>
                <div class="rp-dash__kpi">
                  <span class="rp-dash__kpi-label">Open Tickets</span>
                  <span class="rp-dash__kpi-val">23</span>
                  <span class="rp-dash__tag orange">5 urgent</span>
                </div>
                <div class="rp-dash__kpi">
                  <span class="rp-dash__kpi-label">Avg Ticket</span>
                  <span class="rp-dash__kpi-val">$142</span>
                  <span class="rp-dash__tag green"><i class="fa-solid fa-arrow-up"></i> 6%</span>
                </div>
              </div>
              <div class="rp-dash__chart-area">
                <div class="rp-dash__chart-bars">
                  <div class="rp-dash__chart-bar" style="height:40%"></div>
                  <div class="rp-dash__chart-bar" style="height:55%"></div>
                  <div class="rp-dash__chart-bar" style="height:35%"></div>
                  <div class="rp-dash__chart-bar" style="height:70%"></div>
                  <div class="rp-dash__chart-bar" style="height:85%"></div>
                  <div class="rp-dash__chart-bar active" style="height:75%"></div>
                  <div class="rp-dash__chart-bar" style="height:45%"></div>
                </div>
                <div class="rp-dash__chart-labels">
                  <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rp-float rp-float--alert">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <div><strong>Low Stock Alert</strong><span>iPhone 15 OLED screens: 2 left</span></div>
        </div>
        <div class="rp-float rp-float--done">
          <i class="fa-solid fa-circle-check"></i>
          <div><strong>Ticket #1041 Complete</strong><span>Ready for pickup · $189.00</span></div>
        </div>
        <div class="rp-float rp-float--pay">
          <i class="fa-solid fa-credit-card"></i>
          <div><strong>Payment Received</strong><span>Card •••• 4242 · $274.93</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ INTERACTIVE DEMO ══════════════ -->
  <section class="rp-demo" id="demo">
    <div class="container">
      <div class="rp-section-hdr">
        <span class="rp-pill rp-pill--light"><i class="fa-solid fa-laptop-code"></i> Product Tour</span>
        <h2>See the Software in Action</h2>
        <p>Click through each module to explore how the platform manages every part of your repair business — from check-in to checkout.</p>
      </div>

      <div class="rp-demo__tabs" role="tablist" aria-label="Product demo modules">
        <button class="rp-demo__tab active" data-tab="tickets" role="tab" aria-selected="true" aria-controls="panel-tickets" id="tab-tickets"><i class="fa-solid fa-ticket"></i> Repair Tickets</button>
        <button class="rp-demo__tab" data-tab="pos" role="tab" aria-selected="false" aria-controls="panel-pos" id="tab-pos"><i class="fa-solid fa-cash-register"></i> Point of Sale</button>
        <button class="rp-demo__tab" data-tab="inventory" role="tab" aria-selected="false" aria-controls="panel-inventory" id="tab-inventory"><i class="fa-solid fa-boxes-stacked"></i> Inventory</button>
        <button class="rp-demo__tab" data-tab="customers" role="tab" aria-selected="false" aria-controls="panel-customers" id="tab-customers"><i class="fa-solid fa-users"></i> Customers</button>
        <button class="rp-demo__tab" data-tab="operations" role="tab" aria-selected="false" aria-controls="panel-operations" id="tab-operations"><i class="fa-solid fa-building"></i> Operations</button>
      </div>

      <div class="rp-demo__panels">
        <!-- ─── TICKETS PANEL ─── -->
        <div class="rp-demo__panel active" data-panel="tickets" role="tabpanel" id="panel-tickets" aria-labelledby="tab-tickets">
          <div class="rp-demo__screen">
            <div class="rp-demo__screen-bar">
              <span><i class="fa-solid fa-ticket"></i> Repair Tickets</span>
              <div class="rp-demo__bar-right">
                <span class="rp-demo__count">12 tickets</span>
                <button class="rp-demo__add-btn"><i class="fa-solid fa-plus"></i> New Ticket</button>
              </div>
            </div>
            <div class="rp-demo__screen-body">
              <div class="rp-demo__filter-row">
                <div class="rp-demo__search-box"><i class="fa-solid fa-search"></i><span>Search tickets, customers, devices...</span></div>
                <div class="rp-demo__status-pills">
                  <span class="rp-status-pill active">All</span>
                  <span class="rp-status-pill">New <span class="rp-status-count">3</span></span>
                  <span class="rp-status-pill">In Progress <span class="rp-status-count">5</span></span>
                  <span class="rp-status-pill">Ready <span class="rp-status-count">2</span></span>
                  <span class="rp-status-pill">Picked Up</span>
                </div>
              </div>

              <div class="rp-demo__ticket-list">
                <div class="rp-demo-ticket">
                  <div class="rp-demo-ticket__left">
                    <span class="rp-badge rp-badge--amber">In Progress</span>
                    <h4>iPhone 15 Pro Max — Screen + Battery</h4>
                    <div class="rp-demo-ticket__meta">
                      <span><i class="fa-solid fa-user"></i> John Mitchell</span>
                      <span><i class="fa-solid fa-user-gear"></i> Tech: Mike R.</span>
                      <span><i class="fa-solid fa-phone"></i> (555) 234-5678</span>
                    </div>
                    <div class="rp-demo-ticket__details">
                      <span><i class="fa-solid fa-hashtag"></i> TK-1042</span>
                      <span><i class="fa-solid fa-mobile-screen"></i> Phone</span>
                      <span><i class="fa-solid fa-calendar"></i> Due: Today</span>
                      <span><i class="fa-solid fa-dollar-sign"></i> $268.00</span>
                    </div>
                  </div>
                  <div class="rp-demo-ticket__right">
                    <div class="rp-demo-ticket__progress-wrap">
                      <div class="rp-progress-bar"><div class="rp-progress-fill" style="width:65%"></div></div>
                      <span>65%</span>
                    </div>
                    <div class="rp-demo-ticket__checklist">
                      <span class="rp-check done"><i class="fa-solid fa-check"></i> Intake</span>
                      <span class="rp-check done"><i class="fa-solid fa-check"></i> Diagnostics</span>
                      <span class="rp-check done"><i class="fa-solid fa-check"></i> Parts Sourced</span>
                      <span class="rp-check active"><i class="fa-solid fa-wrench"></i> Repairing</span>
                      <span class="rp-check"><i class="fa-solid fa-clipboard-check"></i> QA Test</span>
                      <span class="rp-check"><i class="fa-solid fa-signature"></i> Signature</span>
                    </div>
                    <div class="rp-demo-ticket__parts">
                      <span class="rp-part-tag"><i class="fa-solid fa-microchip"></i> OLED Screen ×1</span>
                      <span class="rp-part-tag"><i class="fa-solid fa-battery-full"></i> Battery ×1</span>
                    </div>
                  </div>
                </div>

                <div class="rp-demo-ticket">
                  <div class="rp-demo-ticket__left">
                    <span class="rp-badge rp-badge--green">Ready for Pickup</span>
                    <h4>Samsung Galaxy S24 Ultra — Charging Port</h4>
                    <div class="rp-demo-ticket__meta">
                      <span><i class="fa-solid fa-user"></i> Sarah Kim</span>
                      <span><i class="fa-solid fa-user-gear"></i> Tech: Lisa T.</span>
                      <span><i class="fa-solid fa-phone"></i> (555) 876-5432</span>
                    </div>
                    <div class="rp-demo-ticket__details">
                      <span><i class="fa-solid fa-hashtag"></i> TK-1043</span>
                      <span><i class="fa-solid fa-mobile-screen"></i> Phone</span>
                      <span><i class="fa-solid fa-dollar-sign"></i> $89.00</span>
                      <span class="rp-deposit-tag"><i class="fa-solid fa-lock"></i> $50 deposit</span>
                    </div>
                  </div>
                  <div class="rp-demo-ticket__right">
                    <div class="rp-demo-ticket__progress-wrap">
                      <div class="rp-progress-bar"><div class="rp-progress-fill full" style="width:100%"></div></div>
                      <span>100%</span>
                    </div>
                    <div class="rp-demo-ticket__checklist">
                      <span class="rp-check done"><i class="fa-solid fa-check"></i> Intake</span>
                      <span class="rp-check done"><i class="fa-solid fa-check"></i> Diagnostics</span>
                      <span class="rp-check done"><i class="fa-solid fa-check"></i> Repaired</span>
                      <span class="rp-check done"><i class="fa-solid fa-check"></i> QA Passed</span>
                      <span class="rp-check done"><i class="fa-solid fa-check"></i> Customer Notified</span>
                    </div>
                  </div>
                </div>

                <div class="rp-demo-ticket">
                  <div class="rp-demo-ticket__left">
                    <span class="rp-badge rp-badge--blue">New</span>
                    <h4>MacBook Pro 14" — Liquid Damage Assessment</h4>
                    <div class="rp-demo-ticket__meta">
                      <span><i class="fa-solid fa-user"></i> Alex Park</span>
                      <span><i class="fa-solid fa-user-gear"></i> Unassigned</span>
                    </div>
                    <div class="rp-demo-ticket__details">
                      <span><i class="fa-solid fa-hashtag"></i> TK-1044</span>
                      <span><i class="fa-solid fa-laptop"></i> Laptop</span>
                      <span><i class="fa-solid fa-calendar"></i> Est: Pending</span>
                      <span class="rp-estimate-tag"><i class="fa-solid fa-file-invoice-dollar"></i> Estimate TBD</span>
                    </div>
                  </div>
                  <div class="rp-demo-ticket__right">
                    <div class="rp-demo-ticket__progress-wrap">
                      <div class="rp-progress-bar"><div class="rp-progress-fill" style="width:10%"></div></div>
                      <span>10%</span>
                    </div>
                    <div class="rp-demo-ticket__checklist">
                      <span class="rp-check active"><i class="fa-solid fa-clipboard-list"></i> Intake</span>
                      <span class="rp-check"><i class="fa-solid fa-magnifying-glass"></i> Diagnostics</span>
                      <span class="rp-check"><i class="fa-solid fa-wrench"></i> Repair</span>
                      <span class="rp-check"><i class="fa-solid fa-clipboard-check"></i> QA</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ─── POS PANEL ─── -->
        <div class="rp-demo__panel" data-panel="pos" role="tabpanel" id="panel-pos" aria-labelledby="tab-pos">
          <div class="rp-demo__screen">
            <div class="rp-demo__screen-bar">
              <span><i class="fa-solid fa-cash-register"></i> Point of Sale</span>
              <div class="rp-demo__bar-right">
                <span class="rp-demo__station"><i class="fa-solid fa-desktop"></i> Station 1 — Main Counter</span>
              </div>
            </div>
            <div class="rp-demo__screen-body">
              <div class="rp-pos-layout">
                <div class="rp-pos-left">
                  <div class="rp-pos-customer">
                    <div class="rp-pos-customer__avatar">JM</div>
                    <div>
                      <strong>John Mitchell</strong>
                      <span>john@email.com · (555) 234-5678</span>
                    </div>
                    <button class="rp-pos-customer__change"><i class="fa-solid fa-pen"></i></button>
                  </div>
                  <div class="rp-pos-cart">
                    <div class="rp-pos-cart__header">
                      <span>Cart Items</span>
                      <span>3 items</span>
                    </div>
                    <div class="rp-pos-item">
                      <div class="rp-pos-item__info">
                        <span class="rp-pos-item__cat">Repair Service</span>
                        <strong>Screen Replacement — iPhone 15 Pro</strong>
                        <span class="rp-pos-item__sku">TK-1042</span>
                      </div>
                      <div class="rp-pos-item__controls">
                        <span class="rp-pos-qty">×1</span>
                        <span class="rp-pos-item__price">$189.00</span>
                      </div>
                    </div>
                    <div class="rp-pos-item">
                      <div class="rp-pos-item__info">
                        <span class="rp-pos-item__cat">Accessory</span>
                        <strong>Tempered Glass Protector</strong>
                        <span class="rp-pos-item__sku">ACC-TG-IP15</span>
                      </div>
                      <div class="rp-pos-item__controls">
                        <span class="rp-pos-qty">×1</span>
                        <span class="rp-pos-item__price">$24.99</span>
                      </div>
                    </div>
                    <div class="rp-pos-item">
                      <div class="rp-pos-item__info">
                        <span class="rp-pos-item__cat">Accessory</span>
                        <strong>Premium Silicone Case</strong>
                        <span class="rp-pos-item__sku">ACC-CS-IP15P</span>
                      </div>
                      <div class="rp-pos-item__controls">
                        <span class="rp-pos-qty">×1</span>
                        <span class="rp-pos-item__price">$34.99</span>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="rp-pos-right">
                  <div class="rp-pos-summary">
                    <div class="rp-pos-line"><span>Subtotal</span><span>$248.98</span></div>
                    <div class="rp-pos-line"><span>Discount (10%)</span><span class="rp-pos-discount">-$24.90</span></div>
                    <div class="rp-pos-line"><span>Tax (8.25%)</span><span>$18.49</span></div>
                    <div class="rp-pos-line rp-pos-total"><span>Total</span><span>$242.57</span></div>
                  </div>
                  <div class="rp-pos-pay-methods">
                    <button class="rp-pay-btn active"><i class="fa-solid fa-credit-card"></i> Card</button>
                    <button class="rp-pay-btn"><i class="fa-solid fa-money-bill"></i> Cash</button>
                    <button class="rp-pay-btn"><i class="fa-brands fa-apple-pay"></i></button>
                  </div>
                  <div class="rp-pos-terminal">
                    <i class="fa-solid fa-wifi"></i>
                    <span>Terminal: Dejavoo Z11 — Connected</span>
                  </div>
                  <button class="rp-pos-charge"><i class="fa-solid fa-lock"></i> Charge $242.57</button>
                  <div class="rp-pos-extras">
                    <button><i class="fa-solid fa-print"></i> Print Receipt</button>
                    <button><i class="fa-solid fa-envelope"></i> Email Receipt</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ─── INVENTORY PANEL ─── -->
        <div class="rp-demo__panel" data-panel="inventory" role="tabpanel" id="panel-inventory" aria-labelledby="tab-inventory">
          <div class="rp-demo__screen">
            <div class="rp-demo__screen-bar">
              <span><i class="fa-solid fa-boxes-stacked"></i> Inventory Management</span>
              <div class="rp-demo__bar-right">
                <button class="rp-demo__add-btn"><i class="fa-solid fa-plus"></i> Add Product</button>
                <button class="rp-demo__add-btn rp-demo__add-btn--outline"><i class="fa-solid fa-truck"></i> Receive Unit</button>
              </div>
            </div>
            <div class="rp-demo__screen-body">
              <div class="rp-inv-alerts">
                <div class="rp-inv-alert rp-inv-alert--critical">
                  <i class="fa-solid fa-circle-exclamation"></i>
                  <div>
                    <strong>2 items out of stock</strong>
                    <span>iPad Pro 12.9" Digitizer, iPhone 14 Back Glass</span>
                  </div>
                  <button class="rp-inv-alert__btn rp-inv-alert__btn--red">Reorder Now</button>
                </div>
                <div class="rp-inv-alert">
                  <i class="fa-solid fa-triangle-exclamation"></i>
                  <div>
                    <strong>3 items below minimum stock</strong>
                    <span>Auto-reorder suggestions ready to review</span>
                  </div>
                  <button class="rp-inv-alert__btn">Review</button>
                </div>
              </div>

              <div class="rp-inv-tabs">
                <span class="rp-inv-tab active">Products (48)</span>
                <span class="rp-inv-tab">Serialized Units (23)</span>
                <span class="rp-inv-tab">Categories</span>
                <span class="rp-inv-tab">Vendors</span>
                <span class="rp-inv-tab">Transfers</span>
              </div>

              <table class="rp-inv-table">
                <thead>
                  <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Stock</th>
                    <th>Cost</th>
                    <th>Cash Price</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>iPhone 15 Pro OLED Screen</strong></td>
                    <td>SCR-IP15P</td>
                    <td>Screens</td>
                    <td class="rp-stock-critical">2</td>
                    <td>$85.00</td>
                    <td>$189.00</td>
                    <td><span class="rp-badge rp-badge--red">Low Stock</span></td>
                  </tr>
                  <tr>
                    <td><strong>Samsung S24 Battery</strong></td>
                    <td>BAT-SS24</td>
                    <td>Batteries</td>
                    <td>8</td>
                    <td>$22.00</td>
                    <td>$79.00</td>
                    <td><span class="rp-badge rp-badge--green">In Stock</span></td>
                  </tr>
                  <tr>
                    <td><strong>USB-C Charging Port (Universal)</strong><span class="rp-serialized-tag"><i class="fa-solid fa-fingerprint"></i> Serialized</span></td>
                    <td>PRT-USBC</td>
                    <td>Ports</td>
                    <td>15</td>
                    <td>$3.50</td>
                    <td>$49.00</td>
                    <td><span class="rp-badge rp-badge--green">In Stock</span></td>
                  </tr>
                  <tr>
                    <td><strong>Tempered Glass — Universal</strong></td>
                    <td>ACC-TG-U</td>
                    <td>Accessories</td>
                    <td>42</td>
                    <td>$1.20</td>
                    <td>$24.99</td>
                    <td><span class="rp-badge rp-badge--green">In Stock</span></td>
                  </tr>
                  <tr>
                    <td><strong>iPad Pro 12.9" Digitizer</strong></td>
                    <td>DIG-IPP12</td>
                    <td>Screens</td>
                    <td class="rp-stock-zero">0</td>
                    <td>$95.00</td>
                    <td>$249.00</td>
                    <td><span class="rp-badge rp-badge--red">Out of Stock</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ─── CUSTOMERS PANEL ─── -->
        <div class="rp-demo__panel" data-panel="customers" role="tabpanel" id="panel-customers" aria-labelledby="tab-customers">
          <div class="rp-demo__screen">
            <div class="rp-demo__screen-bar">
              <span><i class="fa-solid fa-users"></i> Customer Management</span>
              <div class="rp-demo__bar-right">
                <span class="rp-demo__count">247 customers</span>
                <button class="rp-demo__add-btn"><i class="fa-solid fa-user-plus"></i> Add Customer</button>
              </div>
            </div>
            <div class="rp-demo__screen-body">
              <div class="rp-cust-profile">
                <div class="rp-cust-header">
                  <div class="rp-cust-avatar">JM</div>
                  <div class="rp-cust-info">
                    <h4>John Mitchell</h4>
                    <div class="rp-cust-contact">
                      <span><i class="fa-solid fa-envelope"></i> john.mitchell@email.com</span>
                      <span><i class="fa-solid fa-phone"></i> (555) 234-5678</span>
                      <span><i class="fa-solid fa-location-dot"></i> Austin, TX 78701</span>
                    </div>
                  </div>
                  <div class="rp-cust-badges">
                    <span class="rp-cust-badge"><i class="fa-solid fa-star"></i> VIP Customer</span>
                    <span class="rp-cust-badge"><i class="fa-solid fa-bell"></i> Email Receipts: On</span>
                    <span class="rp-cust-badge"><i class="fa-solid fa-bell"></i> Ticket Updates: On</span>
                  </div>
                </div>

                <div class="rp-cust-stats">
                  <div class="rp-cust-stat">
                    <span class="rp-cust-stat__val">12</span>
                    <span class="rp-cust-stat__label">Total Repairs</span>
                  </div>
                  <div class="rp-cust-stat">
                    <span class="rp-cust-stat__val">$2,847</span>
                    <span class="rp-cust-stat__label">Lifetime Spend</span>
