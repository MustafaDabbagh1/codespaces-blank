---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PPD Technology | Repair Shop Management Software">

  <!-- ══════════════ HERO ══════════════ -->
  <section class="rp-hero">
    <div class="rp-hero__grid-bg"></div>
    <div class="rp-hero__orb rp-hero__orb--1"></div>
    <div class="rp-hero__orb rp-hero__orb--2"></div>

    <div class="container rp-hero__inner">
      <div class="rp-hero__text">
        <span class="rp-pill"><i class="fa-solid fa-microchip"></i> All-in-One Repair Shop Software</span>
        <h1>Run Your Repair<br>Business <span class="rp-grad">Smarter</span></h1>
        <p>Manage tickets, inventory, employees, and payments from one powerful platform — built for modern repair shops. Everything you need starting at just <strong>$30/month</strong>.</p>
        <div class="rp-hero__actions">
          <button class="btn btn-primary btn-lg rp-cta-open"><i class="fa-solid fa-phone"></i> Request a Demo</button>
          <a class="btn btn-outline btn-lg" href="#demo"><i class="fa-solid fa-play"></i> Explore the Platform</a>
        </div>
        <div class="rp-hero__trust">
          <span><i class="fa-solid fa-shield-halved"></i> PCI Compliant</span>
          <span><i class="fa-solid fa-clock"></i> Setup in Minutes</span>
          <span><i class="fa-solid fa-headset"></i> 24/7 Support</span>
        </div>
      </div>

      <div class="rp-hero__visual">
        <div class="rp-dash">
          <div class="rp-dash__bar">
            <span class="rp-dash__dot" style="background:#ff5f57"></span>
            <span class="rp-dash__dot" style="background:#febc2e"></span>
            <span class="rp-dash__dot" style="background:#28c840"></span>
            <span class="rp-dash__bar-title">RepairDesk Pro</span>
          </div>
          <div class="rp-dash__body">
            <div class="rp-dash__sidebar">
              <div class="rp-dash__nav active"><i class="fa-solid fa-ticket"></i></div>
              <div class="rp-dash__nav"><i class="fa-solid fa-cash-register"></i></div>
              <div class="rp-dash__nav"><i class="fa-solid fa-boxes-stacked"></i></div>
              <div class="rp-dash__nav"><i class="fa-solid fa-users"></i></div>
            </div>
            <div class="rp-dash__main">
              <div class="rp-dash__stat-row">
                <div class="rp-dash__stat">
                  <span class="rp-dash__label">Open Tickets</span>
                  <span class="rp-dash__val">23</span>
                  <span class="rp-dash__tag orange">5 urgent</span>
                </div>
                <div class="rp-dash__stat">
                  <span class="rp-dash__label">Today's Revenue</span>
                  <span class="rp-dash__val">$2,847</span>
                  <span class="rp-dash__tag green"><i class="fa-solid fa-arrow-up"></i> 14%</span>
                </div>
              </div>
              <div class="rp-dash__tickets">
                <div class="rp-dash__ticket">
                  <span class="rp-ticket-status done"></span>
                  <div>
                    <strong>iPhone 15 Pro — Screen Replace</strong>
                    <span>Ticket #1042 · John M.</span>
                  </div>
                  <span class="rp-ticket-price">$189</span>
                </div>
                <div class="rp-dash__ticket">
                  <span class="rp-ticket-status progress"></span>
                  <div>
                    <strong>Samsung S24 — Battery Swap</strong>
                    <span>Ticket #1043 · Sarah K.</span>
                  </div>
                  <span class="rp-ticket-price">$79</span>
                </div>
                <div class="rp-dash__ticket">
                  <span class="rp-ticket-status pending"></span>
                  <div>
                    <strong>MacBook Air — Logic Board</strong>
                    <span>Ticket #1044 · Alex P.</span>
                  </div>
                  <span class="rp-ticket-price">$349</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rp-float rp-float--alert">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <div><strong>Low Stock Alert</strong><span>iPhone 15 screens: 2 left</span></div>
        </div>
        <div class="rp-float rp-float--done">
          <i class="fa-solid fa-circle-check"></i>
          <div><strong>Repair Complete</strong><span>Ticket #1041 ready for pickup</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ INTERACTIVE DEMO ══════════════ -->
  <section class="rp-demo" id="demo">
    <div class="container">
      <div class="rp-section-hdr">
        <span class="rp-pill rp-pill--light"><i class="fa-solid fa-laptop-code"></i> Interactive Demo</span>
        <h2>Experience the Platform</h2>
        <p>Click through the modules below to see how the software manages every part of your repair business.</p>
      </div>

      <div class="rp-demo__tabs" role="tablist" aria-label="Product demo modules">
        <button class="rp-demo__tab active" data-tab="tickets" role="tab" aria-selected="true" aria-controls="panel-tickets" id="tab-tickets"><i class="fa-solid fa-ticket"></i> Repair Tickets</button>
        <button class="rp-demo__tab" data-tab="pos" role="tab" aria-selected="false" aria-controls="panel-pos" id="tab-pos"><i class="fa-solid fa-cash-register"></i> Point of Sale</button>
        <button class="rp-demo__tab" data-tab="inventory" role="tab" aria-selected="false" aria-controls="panel-inventory" id="tab-inventory"><i class="fa-solid fa-boxes-stacked"></i> Inventory</button>
        <button class="rp-demo__tab" data-tab="employees" role="tab" aria-selected="false" aria-controls="panel-employees" id="tab-employees"><i class="fa-solid fa-users-gear"></i> Employees</button>
      </div>

      <div class="rp-demo__panels">
        <!-- TICKETS PANEL -->
        <div class="rp-demo__panel active" data-panel="tickets" role="tabpanel" id="panel-tickets" aria-labelledby="tab-tickets">
          <div class="rp-demo__screen">
            <div class="rp-demo__screen-bar">
              <span>Repair Ticket Management</span>
              <button class="rp-demo__add-btn"><i class="fa-solid fa-plus"></i> New Ticket</button>
            </div>
            <div class="rp-demo__screen-body">
              <div class="rp-demo__ticket-list">
                <div class="rp-demo-ticket">
                  <div class="rp-demo-ticket__header">
                    <span class="rp-badge rp-badge--green">Completed</span>
                    <span class="rp-demo-ticket__id">#1042</span>
                  </div>
                  <h4>iPhone 15 Pro — Screen Replacement</h4>
                  <div class="rp-demo-ticket__meta">
                    <span><i class="fa-solid fa-user"></i> John Mitchell</span>
                    <span><i class="fa-solid fa-user-gear"></i> Tech: Mike R.</span>
                    <span><i class="fa-solid fa-dollar-sign"></i> $189.00</span>
                  </div>
                  <div class="rp-demo-ticket__progress">
                    <div class="rp-progress-bar"><div class="rp-progress-fill" style="width:100%"></div></div>
                    <span>100%</span>
                  </div>
                  <div class="rp-demo-ticket__checklist">
                    <span class="rp-check done"><i class="fa-solid fa-check"></i> Pre-check</span>
                    <span class="rp-check done"><i class="fa-solid fa-check"></i> Parts sourced</span>
                    <span class="rp-check done"><i class="fa-solid fa-check"></i> Repair done</span>
                    <span class="rp-check done"><i class="fa-solid fa-check"></i> QA passed</span>
                  </div>
                </div>

                <div class="rp-demo-ticket">
                  <div class="rp-demo-ticket__header">
                    <span class="rp-badge rp-badge--blue">In Progress</span>
                    <span class="rp-demo-ticket__id">#1043</span>
                  </div>
                  <h4>Samsung Galaxy S24 — Battery Replacement</h4>
                  <div class="rp-demo-ticket__meta">
                    <span><i class="fa-solid fa-user"></i> Sarah Kim</span>
                    <span><i class="fa-solid fa-user-gear"></i> Tech: Lisa T.</span>
                    <span><i class="fa-solid fa-dollar-sign"></i> $79.00</span>
                  </div>
                  <div class="rp-demo-ticket__progress">
                    <div class="rp-progress-bar"><div class="rp-progress-fill" style="width:65%"></div></div>
                    <span>65%</span>
                  </div>
                  <div class="rp-demo-ticket__checklist">
                    <span class="rp-check done"><i class="fa-solid fa-check"></i> Pre-check</span>
                    <span class="rp-check done"><i class="fa-solid fa-check"></i> Parts sourced</span>
                    <span class="rp-check active"><i class="fa-solid fa-wrench"></i> Repairing</span>
                    <span class="rp-check"><i class="fa-solid fa-clipboard-check"></i> QA</span>
                  </div>
                </div>

                <div class="rp-demo-ticket">
                  <div class="rp-demo-ticket__header">
                    <span class="rp-badge rp-badge--orange">Waiting Parts</span>
                    <span class="rp-demo-ticket__id">#1044</span>
                  </div>
                  <h4>MacBook Air M2 — Logic Board Repair</h4>
                  <div class="rp-demo-ticket__meta">
                    <span><i class="fa-solid fa-user"></i> Alex Park</span>
                    <span><i class="fa-solid fa-user-gear"></i> Unassigned</span>
                    <span><i class="fa-solid fa-dollar-sign"></i> $349.00</span>
                  </div>
                  <div class="rp-demo-ticket__progress">
                    <div class="rp-progress-bar"><div class="rp-progress-fill" style="width:20%"></div></div>
                    <span>20%</span>
                  </div>
                  <div class="rp-demo-ticket__checklist">
                    <span class="rp-check done"><i class="fa-solid fa-check"></i> Pre-check</span>
                    <span class="rp-check active"><i class="fa-solid fa-clock"></i> Awaiting parts</span>
                    <span class="rp-check"><i class="fa-solid fa-wrench"></i> Repair</span>
                    <span class="rp-check"><i class="fa-solid fa-clipboard-check"></i> QA</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- POS PANEL -->
        <div class="rp-demo__panel" data-panel="pos" role="tabpanel" id="panel-pos" aria-labelledby="tab-pos">
          <div class="rp-demo__screen">
            <div class="rp-demo__screen-bar">
              <span>Point of Sale</span>
              <span class="rp-demo__register">Register #1 — Open</span>
            </div>
            <div class="rp-demo__screen-body">
              <div class="rp-pos-layout">
                <div class="rp-pos-items">
                  <div class="rp-pos-item">
                    <span class="rp-pos-item__name">Screen Repair — iPhone 15</span>
                    <span class="rp-pos-item__qty">×1</span>
                    <span class="rp-pos-item__price">$189.00</span>
                  </div>
                  <div class="rp-pos-item">
                    <span class="rp-pos-item__name">Tempered Glass Protector</span>
                    <span class="rp-pos-item__qty">×1</span>
                    <span class="rp-pos-item__price">$24.99</span>
                  </div>
                  <div class="rp-pos-item">
                    <span class="rp-pos-item__name">Premium Phone Case</span>
                    <span class="rp-pos-item__qty">×1</span>
                    <span class="rp-pos-item__price">$39.99</span>
                  </div>
                  <div class="rp-pos-divider"></div>
                  <div class="rp-pos-item rp-pos-item--sub">
                    <span>Subtotal</span><span>$253.98</span>
                  </div>
                  <div class="rp-pos-item rp-pos-item--sub">
                    <span>Tax (8.25%)</span><span>$20.95</span>
                  </div>
                  <div class="rp-pos-item rp-pos-item--total">
                    <span>Total</span><span>$274.93</span>
                  </div>
                </div>
                <div class="rp-pos-actions">
                  <div class="rp-pos-methods">
                    <button class="rp-pay-btn active"><i class="fa-solid fa-credit-card"></i> Card</button>
                    <button class="rp-pay-btn"><i class="fa-solid fa-money-bill"></i> Cash</button>
                    <button class="rp-pay-btn"><i class="fa-brands fa-apple-pay"></i></button>
                  </div>
                  <button class="rp-pos-charge">Charge $274.93</button>
                  <div class="rp-pos-extras">
                    <button><i class="fa-solid fa-print"></i> Receipt</button>
                    <button><i class="fa-solid fa-envelope"></i> Email</button>
                    <button><i class="fa-solid fa-message"></i> SMS</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- INVENTORY PANEL -->
        <div class="rp-demo__panel" data-panel="inventory" role="tabpanel" id="panel-inventory" aria-labelledby="tab-inventory">
          <div class="rp-demo__screen">
            <div class="rp-demo__screen-bar">
              <span>Inventory Management</span>
              <button class="rp-demo__add-btn"><i class="fa-solid fa-plus"></i> Add Item</button>
            </div>
            <div class="rp-demo__screen-body">
              <div class="rp-inv-grid">
                <div class="rp-inv-alert">
                  <i class="fa-solid fa-triangle-exclamation"></i>
                  <div>
                    <strong>3 items below minimum stock</strong>
                    <span>Auto-reorder suggestions ready</span>
                  </div>
                  <button class="rp-inv-alert__btn">Review</button>
                </div>
                <table class="rp-inv-table">
                  <thead>
                    <tr>
                      <th>Item</th>
                      <th>SKU</th>
                      <th>Stock</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>iPhone 15 Pro OLED Screen</td>
                      <td>SCR-IP15P</td>
                      <td>2</td>
                      <td><span class="rp-badge rp-badge--red">Low</span></td>
                    </tr>
                    <tr>
                      <td>Samsung S24 Battery</td>
                      <td>BAT-SS24</td>
                      <td>8</td>
                      <td><span class="rp-badge rp-badge--green">In Stock</span></td>
                    </tr>
                    <tr>
                      <td>USB-C Charging Port (Universal)</td>
                      <td>PRT-USBC</td>
                      <td>15</td>
                      <td><span class="rp-badge rp-badge--green">In Stock</span></td>
                    </tr>
                    <tr>
                      <td>iPad Pro 12.9" Digitizer</td>
                      <td>DIG-IPP12</td>
                      <td>1</td>
                      <td><span class="rp-badge rp-badge--red">Critical</span></td>
                    </tr>
                    <tr>
                      <td>Tempered Glass — Universal</td>
                      <td>ACC-TG-U</td>
                      <td>42</td>
                      <td><span class="rp-badge rp-badge--green">In Stock</span></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- EMPLOYEES PANEL -->
        <div class="rp-demo__panel" data-panel="employees" role="tabpanel" id="panel-employees" aria-labelledby="tab-employees">
          <div class="rp-demo__screen">
            <div class="rp-demo__screen-bar">
              <span>Employee Management</span>
              <span class="rp-demo__register">Today · 4 Active</span>
            </div>
            <div class="rp-demo__screen-body">
              <div class="rp-emp-grid">
                <div class="rp-emp-card">
                  <div class="rp-emp-avatar" style="background:#2D60FF">MR</div>
                  <div class="rp-emp-info">
                    <strong>Mike Rodriguez</strong>
                    <span>Lead Technician</span>
                  </div>
                  <div class="rp-emp-stats">
                    <div><span class="rp-emp-num">7</span><span class="rp-emp-lbl">Tickets</span></div>
                    <div><span class="rp-emp-num">$1,420</span><span class="rp-emp-lbl">Sales</span></div>
                  </div>
                  <span class="rp-badge rp-badge--green">Clocked In</span>
                </div>
                <div class="rp-emp-card">
                  <div class="rp-emp-avatar" style="background:#00CFFF">LT</div>
                  <div class="rp-emp-info">
                    <strong>Lisa Thompson</strong>
                    <span>Technician</span>
                  </div>
                  <div class="rp-emp-stats">
                    <div><span class="rp-emp-num">5</span><span class="rp-emp-lbl">Tickets</span></div>
                    <div><span class="rp-emp-num">$890</span><span class="rp-emp-lbl">Sales</span></div>
                  </div>
                  <span class="rp-badge rp-badge--green">Clocked In</span>
                </div>
                <div class="rp-emp-card">
                  <div class="rp-emp-avatar" style="background:#00E5A0">JC</div>
                  <div class="rp-emp-info">
                    <strong>James Chen</strong>
                    <span>Sales Associate</span>
                  </div>
                  <div class="rp-emp-stats">
                    <div><span class="rp-emp-num">2</span><span class="rp-emp-lbl">Tickets</span></div>
                    <div><span class="rp-emp-num">$537</span><span class="rp-emp-lbl">Sales</span></div>
                  </div>
                  <span class="rp-badge rp-badge--green">Clocked In</span>
                </div>
                <div class="rp-emp-card">
                  <div class="rp-emp-avatar" style="background:#7C3AED">AP</div>
                  <div class="rp-emp-info">
                    <strong>Amanda Patel</strong>
                    <span>Front Desk</span>
                  </div>
                  <div class="rp-emp-stats">
                    <div><span class="rp-emp-num">0</span><span class="rp-emp-lbl">Tickets</span></div>
                    <div><span class="rp-emp-num">$210</span><span class="rp-emp-lbl">Sales</span></div>
                  </div>
                  <span class="rp-badge rp-badge--orange">Break</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ FEATURES ══════════════ -->
  <section class="rp-features" id="features">
    <div class="container">
      <div class="rp-section-hdr">
        <span class="rp-pill rp-pill--light"><i class="fa-solid fa-cubes"></i> Core Features</span>
        <h2>Everything Your Shop Needs.<br><span class="rp-grad">One Platform.</span></h2>
        <p>Stop juggling disconnected tools. Manage your entire repair operation from a single, powerful dashboard.</p>
      </div>

      <div class="rp-feat-grid">
        <div class="rp-feat" data-anim>
          <div class="rp-feat__icon"><i class="fa-solid fa-cash-register"></i></div>
          <h3>Point of Sale</h3>
          <p>Sell repair services, accessories, and gadgets from one screen. Generate invoices, collect payments via card, cash, or digital wallet, and manage checkout in seconds.</p>
          <ul class="rp-feat__list">
            <li><i class="fa-solid fa-check"></i> Multi-payment support</li>
            <li><i class="fa-solid fa-check"></i> Invoice generation & printing</li>
            <li><i class="fa-solid fa-check"></i> Upsell accessories at checkout</li>
          </ul>
        </div>

        <div class="rp-feat" data-anim>
          <div class="rp-feat__icon"><i class="fa-solid fa-ticket"></i></div>
          <h3>Repair Ticket Management</h3>
          <p>Create detailed repair tickets with custom workflows, part details, pre- and post-repair checklists, customer signatures, and technician assignment — all tracked in real time.</p>
          <ul class="rp-feat__list">
            <li><i class="fa-solid fa-check"></i> Custom repair workflows</li>
            <li><i class="fa-solid fa-check"></i> Digital signatures & checklists</li>
            <li><i class="fa-solid fa-check"></i> Auto customer notifications</li>
          </ul>
        </div>

        <div class="rp-feat" data-anim>
          <div class="rp-feat__icon"><i class="fa-solid fa-boxes-stacked"></i></div>
          <h3>Inventory Management</h3>
          <p>Track stock across locations, manage serialized inventory, create purchase orders, get low-stock alerts, and automate reordering so you never miss a repair.</p>
          <ul class="rp-feat__list">
            <li><i class="fa-solid fa-check"></i> Serialized part tracking</li>
            <li><i class="fa-solid fa-check"></i> Multi-location transfers</li>
            <li><i class="fa-solid fa-check"></i> Auto-reorder alerts</li>
          </ul>
        </div>

        <div class="rp-feat" data-anim>
          <div class="rp-feat__icon"><i class="fa-solid fa-users-gear"></i></div>
          <h3>Employee Management</h3>
          <p>Assign tasks, set roles and permissions, track shift times, monitor work progress, and see sales generated by each team member — all from one view.</p>
          <ul class="rp-feat__list">
            <li><i class="fa-solid fa-check"></i> Role-based permissions</li>
            <li><i class="fa-solid fa-check"></i> Time clock & shift tracking</li>
            <li><i class="fa-solid fa-check"></i> Per-employee sales reports</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ INDUSTRIES ══════════════ -->
  <section class="rp-industries" id="industries">
    <div class="container">
      <div class="rp-section-hdr">
        <span class="rp-pill rp-pill--dark"><i class="fa-solid fa-wrench"></i> Industries Served</span>
        <h2 class="rp-industries__h2">Built for Every<br><span class="rp-grad">Repair Business</span></h2>
        <p class="rp-industries__sub">From smartphones to small engines — one platform adapts to your workflow.</p>
      </div>

      <div class="rp-ind-grid">
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-mobile-screen-button"></i></div><h4>Cell Phone Repair</h4></div>
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-laptop"></i></div><h4>Computer Repair</h4></div>
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-gem"></i></div><h4>Jewelry Repair</h4></div>
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-clock"></i></div><h4>Watch Repair</h4></div>
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-bicycle"></i></div><h4>Bicycle Repair</h4></div>
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-screwdriver-wrench"></i></div><h4>Power Tools</h4></div>
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-camera"></i></div><h4>Camera Repair</h4></div>
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-gear"></i></div><h4>Small Engine</h4></div>
      </div>
    </div>
  </section>

  <!-- ══════════════ WHY SWITCH ══════════════ -->
  <section class="rp-compare" id="compare">
    <div class="container">
      <div class="rp-section-hdr">
        <span class="rp-pill rp-pill--light"><i class="fa-solid fa-arrow-right-arrow-left"></i> Why Switch</span>
        <h2>Ditch the Spreadsheets.<br><span class="rp-grad">Upgrade Your Operations.</span></h2>
        <p>See how a purpose-built platform compares to the tools you're patching together today.</p>
      </div>

      <div class="rp-compare__table">
        <div class="rp-compare__header">
          <span>Feature</span>
          <span>Old Tools / Spreadsheets</span>
          <span class="rp-compare__us">PPD Repair</span>
        </div>
        <div class="rp-compare__row">
          <span>Repair ticket tracking</span>
          <span class="rp-compare__old"><i class="fa-solid fa-xmark"></i> Manual / paper</span>
          <span class="rp-compare__new"><i class="fa-solid fa-check"></i> Automated workflows</span>
        </div>
        <div class="rp-compare__row">
          <span>Inventory management</span>
          <span class="rp-compare__old"><i class="fa-solid fa-xmark"></i> Spreadsheet guesswork</span>
          <span class="rp-compare__new"><i class="fa-solid fa-check"></i> Real-time stock tracking</span>
        </div>
        <div class="rp-compare__row">
          <span>Customer notifications</span>
          <span class="rp-compare__old"><i class="fa-solid fa-xmark"></i> Phone calls / texts</span>
          <span class="rp-compare__new"><i class="fa-solid fa-check"></i> Auto SMS & email updates</span>
        </div>
        <div class="rp-compare__row">
          <span>Point of Sale</span>
          <span class="rp-compare__old"><i class="fa-solid fa-xmark"></i> Separate system</span>
          <span class="rp-compare__new"><i class="fa-solid fa-check"></i> Built-in, unified POS</span>
        </div>
