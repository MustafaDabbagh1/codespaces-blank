.rp-hero__grid-bg{position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");pointer-events:none}
.rp-hero__orb{position:absolute;border-radius:50%;filter:blur(100px);opacity:.18;pointer-events:none}
.rp-hero__orb--1{width:600px;height:600px;background:#1549FF;top:-300px;right:-200px;animation:rpOrb 20s ease-in-out infinite}
.rp-hero__orb--2{width:400px;height:400px;background:#00CFFF;bottom:-200px;left:-100px;animation:rpOrb 25s ease-in-out infinite reverse}
@keyframes rpOrb{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(30px,-20px) scale(1.05)}66%{transform:translate(-20px,15px) scale(.97)}}
.rp-hero__inner{display:grid;grid-template-columns:1fr;gap:48px;position:relative;z-index:2;align-items:center}
.rp-hero__text{max-width:600px}
.rp-hero__text h1{font-size:clamp(2rem,5vw,3.2rem);line-height:1.1;font-weight:800;letter-spacing:-.03em;margin:20px 0}
.rp-hero__text>p{font-size:clamp(.95rem,1.6vw,1.05rem);opacity:.75;line-height:1.7;margin-bottom:20px;max-width:50ch}
.rp-hero__price{display:flex;align-items:center;gap:12px;margin-bottom:28px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:14px 20px;backdrop-filter:blur(8px)}
.rp-hero__price-tag{font-size:12px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;font-weight:500}
.rp-hero__price-val{font-size:32px;font-weight:900;letter-spacing:-.02em;color:#00CFFF}.rp-hero__price-val span{font-size:16px;font-weight:500;opacity:.7}
.rp-hero__price-note{font-size:12px;opacity:.5}
.rp-hero__actions{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:24px}
.rp-hero__trust{display:flex;flex-wrap:wrap;gap:16px}.rp-hero__trust span{display:inline-flex;align-items:center;gap:6px;font-size:12px;opacity:.5;font-weight:500}.rp-hero__trust span i{color:#00CFFF;opacity:.7}

/* Hero Dashboard */
.rp-hero__visual{position:relative;perspective:1200px}
.rp-dash{background:rgba(12,26,56,.85);border:1px solid rgba(255,255,255,.1);border-radius:14px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.5),0 0 0 1px rgba(255,255,255,.05);backdrop-filter:blur(20px);transform:rotateY(-4deg) rotateX(2deg);animation:rpDashFloat 8s ease-in-out infinite}
.rp-dash:hover{transform:rotateY(0) rotateX(0)}
@keyframes rpDashFloat{0%,100%{transform:rotateY(-4deg) rotateX(2deg)}50%{transform:rotateY(-2deg) rotateX(1deg) translateY(-6px)}}
.rp-dash__bar{display:flex;align-items:center;gap:6px;padding:10px 14px;background:rgba(0,0,0,.3);border-bottom:1px solid rgba(255,255,255,.06)}
.rp-dash__dot{width:10px;height:10px;border-radius:50%}
.rp-dash__bar-title{margin-left:auto;font-size:11px;opacity:.4;font-weight:500}
.rp-dash__body{display:flex;min-height:260px}
.rp-dash__sidebar{width:44px;background:rgba(0,0,0,.15);border-right:1px solid rgba(255,255,255,.06);display:flex;flex-direction:column;align-items:center;gap:2px;padding:10px 0}
.rp-dash__nav{width:30px;height:30px;border-radius:7px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.3);font-size:12px;cursor:pointer;transition:all .2s}
.rp-dash__nav.active{background:rgba(21,73,255,.3);color:#00CFFF}
.rp-dash__main{flex:1;padding:12px;display:flex;flex-direction:column;gap:8px}
.rp-dash__greeting{display:flex;justify-content:space-between;align-items:flex-start}
.rp-dash__presets{display:flex;gap:4px}
.rp-dash__preset{padding:3px 8px;border-radius:6px;font-size:9px;font-weight:600;color:rgba(255,255,255,.4);cursor:pointer}
.rp-dash__preset.active{background:rgba(21,73,255,.3);color:#00CFFF}
.rp-dash__kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.rp-dash__kpi{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);border-radius:8px;padding:8px 10px}
.rp-dash__kpi-label{display:block;font-size:8px;opacity:.5;text-transform:uppercase;letter-spacing:.04em}
.rp-dash__kpi-val{display:block;font-size:16px;font-weight:800;letter-spacing:-.02em;margin:1px 0}
.rp-dash__tag{font-size:8px;font-weight:600;padding:2px 6px;border-radius:9999px}
.rp-dash__tag.orange{background:rgba(249,115,22,.15);color:#F97316}.rp-dash__tag.green{background:rgba(0,229,160,.15);color:#00E5A0}
.rp-dash__chart-area{flex:1;display:flex;flex-direction:column;justify-content:flex-end;gap:4px}
.rp-dash__chart-bars{display:flex;align-items:flex-end;gap:6px;height:60px}
.rp-dash__chart-bar{flex:1;background:rgba(21,73,255,.25);border-radius:3px 3px 0 0;transition:all .3s}
.rp-dash__chart-bar.active{background:#1549FF}
.rp-dash__chart-labels{display:flex;gap:6px}.rp-dash__chart-labels span{flex:1;text-align:center;font-size:7px;opacity:.3}

/* Floating cards */
.rp-float{position:absolute;background:rgba(12,26,56,.92);border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:10px 14px;backdrop-filter:blur(16px);box-shadow:0 12px 40px rgba(0,0,0,.4);display:flex;align-items:center;gap:10px;font-size:12px;z-index:5;opacity:0;animation:rpFloatIn .8s ease forwards}
.rp-float i{font-size:16px}.rp-float strong{display:block;font-size:11px;font-weight:600}.rp-float span{opacity:.55;font-size:10px}
.rp-float--alert{bottom:20%;left:-10px;animation-delay:.6s}.rp-float--alert i{color:#F97316}
.rp-float--done{top:15%;right:-10px;animation-delay:.9s}.rp-float--done i{color:#00E5A0}
.rp-float--pay{bottom:5%;right:10%;animation-delay:1.2s}.rp-float--pay i{color:#00CFFF}
@keyframes rpFloatIn{from{opacity:0;transform:translateY(16px) scale(.95)}to{opacity:1;transform:translateY(0) scale(1)}}

/* ── DEMO SECTION ── */
.rp-demo{padding:var(--section-py) 0;background:var(--surface)}
.rp-demo__tabs{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-bottom:32px}
.rp-demo__tab{padding:12px 22px;border-radius:9999px;border:1px solid var(--border);background:#fff;color:var(--text-2);font-weight:600;font-size:14px;cursor:pointer;display:inline-flex;align-items:center;gap:8px;transition:all .25s;font-family:'Inter',sans-serif}
.rp-demo__tab:hover{border-color:rgba(21,73,255,.3);color:#1549FF}
.rp-demo__tab.active{background:#1549FF;color:#fff;border-color:#1549FF;box-shadow:0 8px 28px rgba(21,73,255,.35)}
.rp-demo__panel{display:none}.rp-demo__panel.active{display:block;animation:rpFadeIn .4s ease}
@keyframes rpFadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.rp-demo__screen{background:#fff;border:1px solid var(--border);border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.08);overflow:hidden;max-width:1000px;margin:0 auto}
.rp-demo__screen-bar{display:flex;justify-content:space-between;align-items:center;padding:14px 20px;background:var(--surface);border-bottom:1px solid var(--border);font-weight:600;font-size:14px;color:var(--text-1)}
.rp-demo__screen-bar i{margin-right:6px;opacity:.6}
.rp-demo__bar-right{display:flex;align-items:center;gap:10px}
.rp-demo__count{font-size:12px;color:var(--text-3);font-weight:500}
.rp-demo__station{font-size:12px;color:var(--text-3);font-weight:500}.rp-demo__station i{margin-right:4px}
.rp-demo__add-btn{padding:7px 14px;border-radius:8px;border:none;background:#1549FF;color:#fff;font-size:12px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:5px;font-family:'Inter',sans-serif}
.rp-demo__add-btn--outline{background:transparent;border:1px solid var(--border);color:var(--text-2)}
.rp-demo__screen-body{padding:20px}

/* Demo filter/search */
.rp-demo__filter-row{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:16px;align-items:center}
.rp-demo__search-box{display:flex;align-items:center;gap:8px;padding:8px 14px;border:1px solid var(--border);border-radius:10px;font-size:13px;color:var(--text-3);flex:1;min-width:200px}
.rp-demo__search-box i{opacity:.4;font-size:12px}
.rp-demo__status-pills{display:flex;flex-wrap:wrap;gap:6px}
.rp-status-pill{padding:5px 12px;border-radius:9999px;font-size:11px;font-weight:600;border:1px solid var(--border);color:var(--text-3);cursor:pointer;display:inline-flex;align-items:center;gap:4px;transition:all .2s}
.rp-status-pill.active{background:#1549FF;color:#fff;border-color:#1549FF}
.rp-status-count{background:rgba(0,0,0,.06);padding:1px 6px;border-radius:9999px;font-size:10px}

/* Demo tickets */
.rp-demo__ticket-list{display:flex;flex-direction:column;gap:14px}
.rp-demo-ticket{border:1px solid var(--border);border-radius:12px;padding:18px;display:grid;grid-template-columns:1fr;gap:16px;transition:all .2s}
.rp-demo-ticket:hover{box-shadow:0 8px 24px rgba(0,0,0,.06);transform:translateY(-2px)}
.rp-demo-ticket__left{}
.rp-demo-ticket h4{font-size:15px;font-weight:700;margin:6px 0 8px;color:var(--text-1)}
.rp-demo-ticket__meta{display:flex;flex-wrap:wrap;gap:14px;font-size:12px;color:var(--text-3);margin-bottom:8px}.rp-demo-ticket__meta i{margin-right:3px;opacity:.5}
.rp-demo-ticket__details{display:flex;flex-wrap:wrap;gap:10px;font-size:11px;color:var(--text-3)}.rp-demo-ticket__details span{display:inline-flex;align-items:center;gap:3px}
.rp-deposit-tag{background:rgba(21,73,255,.08);color:#1549FF;padding:2px 8px;border-radius:6px;font-weight:600}
.rp-estimate-tag{background:rgba(249,115,22,.08);color:#EA580C;padding:2px 8px;border-radius:6px;font-weight:600}
.rp-demo-ticket__right{}
.rp-demo-ticket__progress-wrap{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.rp-demo-ticket__progress-wrap span{font-size:12px;font-weight:700;color:var(--text-2);min-width:35px}
.rp-progress-bar{flex:1;height:6px;background:var(--surface-2,#eef1f6);border-radius:9999px;overflow:hidden}
.rp-progress-fill{height:100%;background:linear-gradient(90deg,#1549FF,#00CFFF);border-radius:9999px;transition:width 1s ease}
.rp-progress-fill.full{background:linear-gradient(90deg,#059669,#00E5A0)}
.rp-demo-ticket__checklist{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
.rp-check{font-size:10px;padding:3px 8px;border-radius:9999px;border:1px solid var(--border);color:var(--text-3);display:inline-flex;align-items:center;gap:3px}
.rp-check.done{background:rgba(0,229,160,.08);border-color:rgba(0,229,160,.2);color:#059669}
.rp-check.active{background:rgba(21,73,255,.08);border-color:rgba(21,73,255,.2);color:#1549FF}
.rp-demo-ticket__parts{display:flex;flex-wrap:wrap;gap:6px}
.rp-part-tag{font-size:10px;padding:3px 8px;border-radius:6px;background:rgba(124,58,237,.06);color:#7C3AED;display:inline-flex;align-items:center;gap:3px;font-weight:500}

/* Badges */
.rp-badge{padding:4px 10px;border-radius:9999px;font-size:11px;font-weight:600;display:inline-flex;align-items:center;gap:4px}
.rp-badge--green{background:rgba(0,229,160,.1);color:#059669}
.rp-badge--blue{background:rgba(21,73,255,.1);color:#1549FF}
.rp-badge--amber{background:rgba(217,119,6,.1);color:#B45309}
.rp-badge--orange{background:rgba(249,115,22,.1);color:#EA580C}
.rp-badge--red{background:rgba(239,68,68,.1);color:#DC2626}
.rp-badge--slate{background:rgba(100,116,139,.1);color:#475569}

/* Demo POS */
.rp-pos-layout{display:grid;grid-template-columns:1fr;gap:24px}
.rp-pos-customer{display:flex;align-items:center;gap:12px;padding:12px;background:var(--surface);border-radius:10px;margin-bottom:12px}
.rp-pos-customer__avatar{width:40px;height:40px;border-radius:10px;background:#1549FF;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;flex-shrink:0}
.rp-pos-customer div{flex:1}.rp-pos-customer strong{display:block;font-size:14px;color:var(--text-1)}.rp-pos-customer span{font-size:11px;color:var(--text-3)}
.rp-pos-customer__change{width:28px;height:28px;border-radius:6px;border:1px solid var(--border);background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text-3);font-size:11px}
.rp-pos-cart__header{display:flex;justify-content:space-between;padding:8px 0;font-size:12px;font-weight:600;color:var(--text-3);text-transform:uppercase;letter-spacing:.03em;border-bottom:1px solid var(--border);margin-bottom:8px}
.rp-pos-item{display:flex;justify-content:space-between;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--border)}
.rp-pos-item__info{flex:1}
.rp-pos-item__cat{display:block;font-size:10px;color:var(--text-3);text-transform:uppercase;letter-spacing:.03em;font-weight:600;margin-bottom:2px}
.rp-pos-item__info strong{font-size:13px;color:var(--text-1)}
.rp-pos-item__sku{display:block;font-size:10px;color:var(--text-3);margin-top:2px}
.rp-pos-item__controls{display:flex;align-items:center;gap:10px}
.rp-pos-qty{font-size:12px;color:var(--text-3);font-weight:500}
.rp-pos-item__price{font-weight:700;font-size:14px;color:var(--text-1)}
.rp-pos-right{display:flex;flex-direction:column;gap:12px}
.rp-pos-summary{background:var(--surface);border-radius:10px;padding:14px}
.rp-pos-line{display:flex;justify-content:space-between;font-size:13px;padding:4px 0;color:var(--text-2)}
.rp-pos-discount{color:#DC2626}
.rp-pos-total{font-size:18px;font-weight:800;color:var(--text-1);border-top:2px solid var(--border);padding-top:10px;margin-top:6px}
.rp-pos-pay-methods{display:flex;gap:8px}
.rp-pay-btn{flex:1;padding:10px;border-radius:10px;border:1px solid var(--border);background:#fff;font-size:13px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;transition:all .2s;font-family:'Inter',sans-serif;color:var(--text-2)}
.rp-pay-btn.active{background:#1549FF;color:#fff;border-color:#1549FF}
.rp-pos-terminal{display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:8px;background:rgba(0,229,160,.06);border:1px solid rgba(0,229,160,.15);font-size:12px;color:#059669;font-weight:500}
.rp-pos-terminal i{color:#00E5A0}
.rp-pos-charge{padding:16px;border-radius:12px;border:none;background:linear-gradient(135deg,#2D60FF,#1549FF);color:#fff;font-size:16px;font-weight:700;cursor:pointer;font-family:'Inter',sans-serif;box-shadow:0 8px 28px rgba(21,73,255,.35);transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px}
.rp-pos-charge:hover{transform:translateY(-2px);box-shadow:0 12px 36px rgba(21,73,255,.45)}
.rp-pos-extras{display:flex;gap:8px}
.rp-pos-extras button{flex:1;padding:8px;border-radius:8px;border:1px solid var(--border);background:#fff;font-size:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;color:var(--text-3);font-family:'Inter',sans-serif;transition:all .2s}
.rp-pos-extras button:hover{border-color:#1549FF;color:#1549FF}

/* Demo Inventory */
.rp-inv-alerts{display:flex;flex-direction:column;gap:10px;margin-bottom:16px}
.rp-inv-alert{display:flex;align-items:center;gap:12px;background:rgba(249,115,22,.06);border:1px solid rgba(249,115,22,.15);border-radius:12px;padding:12px 16px}.rp-inv-alert i{font-size:18px;color:#F97316}.rp-inv-alert div{flex:1}.rp-inv-alert strong{display:block;font-size:13px;color:var(--text-1)}.rp-inv-alert span{font-size:11px;color:var(--text-3)}
.rp-inv-alert--critical{background:rgba(239,68,68,.06);border-color:rgba(239,68,68,.15)}.rp-inv-alert--critical i{color:#DC2626}
.rp-inv-alert__btn{padding:7px 14px;border-radius:8px;border:1px solid rgba(249,115,22,.3);background:rgba(249,115,22,.08);color:#EA580C;font-size:11px;font-weight:600;cursor:pointer;font-family:'Inter',sans-serif;transition:all .2s;white-space:nowrap}
.rp-inv-alert__btn:hover{background:#F97316;color:#fff;border-color:#F97316}
.rp-inv-alert__btn--red{border-color:rgba(239,68,68,.3);background:rgba(239,68,68,.08);color:#DC2626}.rp-inv-alert__btn--red:hover{background:#DC2626;color:#fff;border-color:#DC2626}
.rp-inv-tabs{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:14px}
.rp-inv-tab{padding:8px 16px;font-size:12px;font-weight:600;color:var(--text-3);cursor:pointer;border-bottom:2px solid transparent;transition:all .2s}
.rp-inv-tab.active{color:#1549FF;border-bottom-color:#1549FF}
.rp-inv-table{width:100%;border-collapse:collapse;font-size:12px}
.rp-inv-table th{text-align:left;padding:8px 10px;font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:var(--text-3);border-bottom:1px solid var(--border);font-weight:600}
.rp-inv-table td{padding:10px;border-bottom:1px solid var(--border);color:var(--text-2)}
.rp-inv-table td strong{color:var(--text-1);font-weight:600}
.rp-inv-table tr:hover{background:var(--surface)}
.rp-stock-critical{color:#DC2626;font-weight:700}.rp-stock-zero{color:#DC2626;font-weight:700}
.rp-serialized-tag{display:inline-flex;align-items:center;gap:3px;font-size:9px;color:#7C3AED;background:rgba(124,58,237,.06);padding:2px 6px;border-radius:4px;margin-left:6px;font-weight:600}

/* Demo Customers */
.rp-cust-profile{}
.rp-cust-header{display:flex;flex-wrap:wrap;gap:16px;align-items:flex-start;margin-bottom:20px}
.rp-cust-avatar{width:56px;height:56px;border-radius:14px;background:rgba(21,73,255,.1);color:#1549FF;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:20px;flex-shrink:0}
.rp-cust-info{flex:1;min-width:200px}.rp-cust-info h4{font-size:18px;font-weight:700;color:var(--text-1);margin-bottom:6px}
.rp-cust-contact{display:flex;flex-wrap:wrap;gap:14px;font-size:12px;color:var(--text-3)}.rp-cust-contact i{margin-right:3px;opacity:.5}
.rp-cust-badges{display:flex;flex-wrap:wrap;gap:6px}
.rp-cust-badge{font-size:10px;padding:4px 10px;border-radius:6px;background:var(--surface);border:1px solid var(--border);color:var(--text-3);display:inline-flex;align-items:center;gap:4px;font-weight:500}
.rp-cust-badge i{color:#1549FF;font-size:9px}
.rp-cust-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}
.rp-cust-stat{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px;text-align:center}
.rp-cust-stat__val{display:block;font-size:20px;font-weight:800;color:var(--text-1);letter-spacing:-.02em}
.rp-cust-stat__label{display:block;font-size:10px;color:var(--text-3);text-transform:uppercase;letter-spacing:.03em;margin-top:2px}
.rp-cust-history h5{font-size:13px;font-weight:700;color:var(--text-1);margin-bottom:10px}
.rp-cust-history__item{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border)}
.rp-cust-history__item div{flex:1}.rp-cust-history__item strong{display:block;font-size:13px;color:var(--text-1)}.rp-cust-history__item span{font-size:11px;color:var(--text-3)}
.rp-cust-history__amount{font-weight:700;font-size:14px;color:var(--text-1)}

/* Demo Operations */
.rp-ops-grid{display:grid;grid-template-columns:1fr;gap:20px}
.rp-ops-section h5{font-size:14px;font-weight:700;color:var(--text-1);margin-bottom:12px;display:flex;align-items:center;gap:8px}.rp-ops-section h5 i{color:#1549FF;font-size:13px}
.rp-emp-list{display:flex;flex-direction:column;gap:8px}
.rp-emp-row{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--border);border-radius:10px;transition:all .2s}
.rp-emp-row:hover{box-shadow:0 4px 16px rgba(0,0,0,.04)}
.rp-emp-avatar{width:38px;height:38px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px;flex-shrink:0}
.rp-emp-details{flex:1;min-width:0}.rp-emp-details strong{display:block;font-size:13px;color:var(--text-1)}.rp-emp-details span{font-size:11px;color:var(--text-3)}
.rp-emp-kpis{display:flex;gap:14px;font-size:12px;color:var(--text-2)}.rp-emp-kpis strong{color:var(--text-1)}
.rp-ops-widgets{display:flex;flex-direction:column;gap:14px}
