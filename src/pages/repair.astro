</style>

<script>
  // ── Workflow Stepper ──
  const steps = document.querySelectorAll('.rp-step[data-step]');
  const panels = document.querySelectorAll('.rp-wf-panel');
  const connectors = document.querySelectorAll('.rp-step__connector-fill');
  const prevBtn = document.getElementById('wfPrev');
  const nextBtn = document.getElementById('wfNext');
  const counter = document.getElementById('wfCounter');
  let currentStep = 1;
  const totalSteps = 6;

  function goToStep(n) {
    if (n < 1 || n > totalSteps) return;
    currentStep = n;

    steps.forEach(s => {
      const sn = parseInt(s.dataset.step);
      s.classList.remove('active', 'done');
      s.setAttribute('aria-selected', 'false');
      s.setAttribute('tabindex', '-1');
      if (sn < n) s.classList.add('done');
      if (sn === n) { s.classList.add('active'); s.setAttribute('aria-selected', 'true'); s.setAttribute('tabindex', '0'); }
    });

    connectors.forEach(c => {
      const cn = parseInt(c.dataset.fill);
      c.classList.toggle('filled', cn < n);
    });

    panels.forEach(p => {
      const pn = parseInt(p.dataset.wf);
      if (pn === n) { p.classList.add('active'); p.removeAttribute('hidden'); }
      else { p.classList.remove('active'); p.setAttribute('hidden', ''); }
    });

    if (prevBtn) prevBtn.disabled = n === 1;
    if (nextBtn) {
      if (n === totalSteps) { nextBtn.innerHTML = '<i class="fa-solid fa-rotate-left"></i> Restart'; }
      else { nextBtn.innerHTML = 'Next Step <i class="fa-solid fa-arrow-right"></i>'; }
    }
    if (counter) counter.textContent = `Step ${n} of ${totalSteps}`;
  }

  steps.forEach(s => {
    s.addEventListener('click', () => goToStep(parseInt(s.dataset.step)));
    s.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); goToStep(Math.min(currentStep + 1, totalSteps)); steps.forEach(st => { if (parseInt(st.dataset.step) === currentStep) st.focus(); }); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); goToStep(Math.max(currentStep - 1, 1)); steps.forEach(st => { if (parseInt(st.dataset.step) === currentStep) st.focus(); }); }
    });
  });

  prevBtn?.addEventListener('click', () => goToStep(currentStep - 1));
  nextBtn?.addEventListener('click', () => {
    if (currentStep === totalSteps) goToStep(1);
    else goToStep(currentStep + 1);
  });

  // ── Modal ──
  const modal = document.getElementById('rpModal');
  const modalDialog = modal?.querySelector('.rp-modal');
  const form = document.getElementById('rpLeadForm');
  const success = document.getElementById('rpFormSuccess');
  let lastFocusedEl = null;

  function getFocusable() {
    if (!modalDialog) return [];
    return Array.from(modalDialog.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'));
  }

  function openModal() {
    lastFocusedEl = document.activeElement;
    modal?.classList.add('active');
    document.body.style.overflow = 'hidden';
    setTimeout(() => { modalDialog?.querySelector('input, button')?.focus(); }, 100);
  }
  function closeModal() {
    modal?.classList.remove('active');
    document.body.style.overflow = '';
    if (form) { form.style.display = ''; form.reset(); }
    if (success) success.style.display = 'none';
    if (lastFocusedEl && typeof lastFocusedEl.focus === 'function') lastFocusedEl.focus();
    lastFocusedEl = null;
  }

  document.querySelectorAll('.rp-cta-open').forEach(btn => btn.addEventListener('click', openModal));
  document.getElementById('rpModalClose')?.addEventListener('click', closeModal);
  document.getElementById('rpSuccessClose')?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('active')) { closeModal(); return; }
    if (e.key === 'Tab' && modal?.classList.contains('active')) {
      const focusable = getFocusable();
      if (!focusable.length) return;
      const first = focusable[0], last = focusable[focusable.length - 1];
      if (e.shiftKey) { if (document.activeElement === first) { e.preventDefault(); last.focus(); } }
      else { if (document.activeElement === last) { e.preventDefault(); first.focus(); } }
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.style.display = 'none';
    if (success) success.style.display = 'block';
  });

  // ── Module Slider ──
  (function() {
    const track = document.getElementById('sliderTrack');
    const dots = document.querySelectorAll('.rp-slider-dot');
    const prevArrow = document.getElementById('sliderPrev');
    const nextArrow = document.getElementById('sliderNext');
    const counterEl = document.getElementById('sliderCounter');
    if (!track) return;
    const slideCount = 6;
    let current = 0;
    let startX = 0, isDragging = false, dragDelta = 0;

    function goSlide(i) {
      current = Math.max(0, Math.min(i, slideCount - 1));
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, idx) => d.classList.toggle('active', idx === current));
      if (prevArrow) prevArrow.style.opacity = current === 0 ? '.35' : '1';
      if (nextArrow) nextArrow.style.opacity = current === slideCount - 1 ? '.35' : '1';
      if (counterEl) counterEl.textContent = `${current + 1} / ${slideCount}`;
    }

    prevArrow?.addEventListener('click', () => goSlide(current - 1));
    nextArrow?.addEventListener('click', () => goSlide(current + 1));
    dots.forEach(d => d.addEventListener('click', () => goSlide(parseInt(d.dataset.slide))));

    const viewport = document.getElementById('sliderViewport');
    viewport?.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; isDragging = true; dragDelta = 0; }, { passive: true });
    viewport?.addEventListener('touchmove', (e) => { if (isDragging) dragDelta = e.touches[0].clientX - startX; }, { passive: true });
    viewport?.addEventListener('touchend', () => {
      if (!isDragging) return;
      isDragging = false;
      if (Math.abs(dragDelta) > 50) goSlide(current + (dragDelta < 0 ? 1 : -1));
    });

    let sliderHovered = false;
    viewport?.addEventListener('mouseenter', () => sliderHovered = true);
    viewport?.addEventListener('mouseleave', () => sliderHovered = false);
    document.addEventListener('keydown', (e) => {
      if (!sliderHovered && !viewport?.contains(document.activeElement)) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); goSlide(current + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); goSlide(current - 1); }
    });

    goSlide(0);
  })();

  // ── Demo Micro-Interactions ──
  (function() {
    document.querySelectorAll('.rp-demo-tabs').forEach(tabBar => {
      tabBar.setAttribute('role', 'tablist');
      const tabs = tabBar.querySelectorAll('.rp-demo-tab');
      const body = tabBar.closest('.rp-mini__body');
      tabs.forEach(tab => {
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-selected', tab.classList.contains('active') ? 'true' : 'false');
        const panel = body.querySelector(`[data-panel="${tab.dataset.tab}"]`);
        if (panel) panel.setAttribute('role', 'tabpanel');
        tab.addEventListener('click', () => {
          tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
          body.querySelectorAll('.rp-demo-panel').forEach(p => p.classList.remove('active'));
          if (panel) panel.classList.add('active');
        });
      });
    });

    document.querySelectorAll('[data-toggle="pos-pay"]').forEach(group => {
      group.querySelectorAll('.rp-pos-pay').forEach(btn => {
        btn.addEventListener('click', () => {
          group.querySelectorAll('.rp-pos-pay').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        });
      });
    });

    document.querySelectorAll('[data-toggle="rpt-filter"]').forEach(group => {
      group.querySelectorAll('.rp-rpt-filter').forEach(btn => {
        btn.addEventListener('click', () => {
          group.querySelectorAll('.rp-rpt-filter').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        });
      });
    });

    document.querySelectorAll('[data-toggle="pay-type"]').forEach(group => {
      group.querySelectorAll('.rp-pay-type').forEach(btn => {
        btn.addEventListener('click', () => {
          group.querySelectorAll('.rp-pay-type').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        });
      });
    });
  })();

  // ── Scroll Animations ──
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('animated'); });
  }, { threshold: .15 });
  document.querySelectorAll('[data-anim]').forEach(el => io.observe(el));
</script>
