---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/repair-slider.css";
---

<BaseLayout title="PPDrepair | All-in-One Repair Shop Management Software">

  <!-- ══════════════ MEMBER BAR ══════════════ -->
  <div class="rp-member-bar">
    <div class="container rp-member-bar__inner">
      <span>Already a member?</span>
      <a href="https://www.ppdrepair.com/" target="_blank" rel="noopener noreferrer" class="rp-member-bar__link"><i class="fa-solid fa-right-to-bracket"></i> Login Now</a>
    </div>
  </div>

  <!-- ══════════════ HERO ══════════════ -->
  <section class="rp-hero">
    <div class="rp-hero__grid-bg"></div>
    <div class="rp-hero__orb rp-hero__orb--1"></div>
    <div class="rp-hero__orb rp-hero__orb--2"></div>

    <div class="container rp-hero__inner">
      <div class="rp-hero__text">
        <span class="rp-pill"><i class="fa-solid fa-microchip"></i> All-in-One Repair Shop Software</span>
        <h1>Run Your Repair Shop<br>from Check-In to Checkout<br>with <span class="rp-grad">PPDrepair</span></h1>
        <p>Repair tickets, POS, inventory, and customer management in one streamlined system for phone repair and service businesses. Starting at just <strong>$30/month</strong>.</p>
        <div class="rp-hero__actions">
          <button class="btn btn-primary btn-lg rp-cta-open"><i class="fa-solid fa-calendar-check"></i> Request a Demo</button>
          <a class="btn btn-ghost btn-lg" href="#workflow"><i class="fa-solid fa-play"></i> See the Repair Workflow</a>
        </div>
        <div class="rp-hero__trust">
          <span><i class="fa-solid fa-shield-halved"></i> PCI Compliant</span>
          <span><i class="fa-solid fa-clock"></i> Setup in Minutes</span>
          <span><i class="fa-solid fa-headset"></i> 24/7 Support</span>
          <span><i class="fa-solid fa-store"></i> Multi-Location</span>
        </div>
      </div>

      <div class="rp-hero__visual">
        <!-- Main Dashboard -->
        <div class="rp-hero-app">
          <div class="rp-hero-app__bar">
            <div class="rp-hero-app__dots"><span></span><span></span><span></span></div>
            <span class="rp-hero-app__title">PPDrepair — Dashboard</span>
          </div>
          <div class="rp-hero-app__body">
            <div class="rp-hero-app__sidebar">
              <div class="rp-hero-app__nav active"><i class="fa-solid fa-chart-line"></i></div>
              <div class="rp-hero-app__nav"><i class="fa-solid fa-ticket"></i></div>
              <div class="rp-hero-app__nav"><i class="fa-solid fa-cash-register"></i></div>
              <div class="rp-hero-app__nav"><i class="fa-solid fa-boxes-stacked"></i></div>
              <div class="rp-hero-app__nav"><i class="fa-solid fa-users"></i></div>
              <div class="rp-hero-app__nav"><i class="fa-solid fa-gear"></i></div>
            </div>
            <div class="rp-hero-app__main">
              <div class="rp-hero-app__topbar">
                <div><strong>Good morning, Mike</strong><span>Quick Fix Wireless — Main St</span></div>
                <div class="rp-hero-app__presets"><span class="active">Today</span><span>7d</span><span>30d</span></div>
              </div>
              <div class="rp-hero-app__kpis">
                <div class="rp-hero-kpi"><span class="rp-hero-kpi__label">Gross Sales</span><span class="rp-hero-kpi__val">$4,287</span><span class="rp-hero-kpi__tag green"><i class="fa-solid fa-arrow-up"></i> 18%</span></div>
                <div class="rp-hero-kpi"><span class="rp-hero-kpi__label">Open Tickets</span><span class="rp-hero-kpi__val">23</span><span class="rp-hero-kpi__tag orange">5 urgent</span></div>
                <div class="rp-hero-kpi"><span class="rp-hero-kpi__label">Avg Repair</span><span class="rp-hero-kpi__val">$142</span><span class="rp-hero-kpi__tag green"><i class="fa-solid fa-arrow-up"></i> 6%</span></div>
                <div class="rp-hero-kpi"><span class="rp-hero-kpi__label">Completed</span><span class="rp-hero-kpi__val">47</span><span class="rp-hero-kpi__tag green">this week</span></div>
              </div>
              <div class="rp-hero-app__tickets">
                <div class="rp-hero-app__tickets-hdr"><strong>Recent Tickets</strong><span>View All</span></div>
                <div class="rp-hero-tkt"><span class="rp-hero-tkt__badge amber">In Progress</span><span class="rp-hero-tkt__device">iPhone 15 Pro — Screen</span><span class="rp-hero-tkt__tech">Mike R.</span><span class="rp-hero-tkt__price">$189</span></div>
                <div class="rp-hero-tkt"><span class="rp-hero-tkt__badge green">Ready</span><span class="rp-hero-tkt__device">Galaxy S24 — Port</span><span class="rp-hero-tkt__tech">Lisa T.</span><span class="rp-hero-tkt__price">$89</span></div>
                <div class="rp-hero-tkt"><span class="rp-hero-tkt__badge blue">New</span><span class="rp-hero-tkt__device">MacBook Pro — Liquid</span><span class="rp-hero-tkt__tech">—</span><span class="rp-hero-tkt__price">TBD</span></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating POS Card -->
        <div class="rp-hero-card rp-hero-card--pos">
          <div class="rp-hero-card__hdr"><i class="fa-solid fa-cash-register"></i> POS — Checkout</div>
          <div class="rp-hero-card__line"><span>Screen Replacement</span><span>$189.00</span></div>
          <div class="rp-hero-card__line"><span>Glass Protector</span><span>$24.99</span></div>
          <div class="rp-hero-card__line total"><span>Total</span><span>$227.48</span></div>
          <div class="rp-hero-card__btn"><i class="fa-solid fa-lock"></i> Charge $227.48</div>
        </div>

        <!-- Floating Inventory Alert -->
        <div class="rp-hero-card rp-hero-card--inv">
          <div class="rp-hero-card__hdr"><i class="fa-solid fa-triangle-exclamation"></i> Low Stock</div>
          <div class="rp-hero-card__alert">iPhone 15 OLED — <strong>2 left</strong></div>
          <div class="rp-hero-card__alert">iPad Digitizer — <strong>0 left</strong></div>
        </div>

        <!-- Floating Customer Card -->
        <div class="rp-hero-card rp-hero-card--cust">
          <div class="rp-hero-card__hdr"><i class="fa-solid fa-user"></i> John Mitchell</div>
          <div class="rp-hero-card__stat"><span>12 repairs</span><span>$2,847 lifetime</span></div>
        </div>

        <!-- Floating Payment Card -->
        <div class="rp-hero-card rp-hero-card--pay">
          <i class="fa-solid fa-circle-check"></i>
          <div><strong>Payment Received</strong><span>Card •••• 4242 · $227.48</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ INDUSTRIES (MOVED UP) ══════════════ -->
  <section class="rp-industries" id="industries">
    <div class="container">
      <div class="rp-section-hdr">
        <span class="rp-pill rp-pill--light"><i class="fa-solid fa-wrench"></i> Built for Every Repair Business</span>
        <h2>One Platform.<br><span class="rp-grad">Every Repair Industry.</span></h2>
        <p>PPDrepair is purpose-built for phone repair shops — and adapts to any service-based repair business.</p>
      </div>

      <div class="rp-ind-grid">
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-mobile-screen-button"></i></div><h4>Cell Phone Repair</h4><span>Screens, batteries, ports, water damage</span></div>
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-laptop"></i></div><h4>Computer Repair</h4><span>Laptops, desktops, logic boards, SSDs</span></div>
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-gem"></i></div><h4>Jewelry Repair</h4><span>Resizing, stone setting, polishing</span></div>
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-clock"></i></div><h4>Watch Repair</h4><span>Movement, crystal, band repair</span></div>
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-bicycle"></i></div><h4>Bicycle Repair</h4><span>Tune-ups, parts replacement, builds</span></div>
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-screwdriver-wrench"></i></div><h4>Power Tools</h4><span>Motor, switch, blade repair</span></div>
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-camera"></i></div><h4>Camera Repair</h4><span>Lens, sensor, body service</span></div>
        <div class="rp-ind" data-anim><div class="rp-ind__icon"><i class="fa-solid fa-gear"></i></div><h4>Small Engine</h4><span>Mowers, blowers, trimmers, saws</span></div>
      </div>
    </div>
  </section>

  <!-- ══════════════ GUIDED WORKFLOW DEMO ══════════════ -->
  <section class="rp-workflow" id="workflow">
    <div class="container">
      <div class="rp-section-hdr">
        <span class="rp-pill rp-pill--dark"><i class="fa-solid fa-route"></i> Interactive Walkthrough</span>
        <h2>See How a Repair Job<br>Moves Through <span class="rp-grad">PPDrepair</span></h2>
        <p>Click through each step to see exactly how the system handles a repair — from device check-in to final payment.</p>
      </div>

      <!-- Stepper -->
      <div class="rp-stepper" role="tablist" aria-label="Repair workflow steps">
        <button class="rp-step active" data-step="1" role="tab" aria-selected="true" aria-controls="wf-1" id="wf-tab-1" tabindex="0">
          <span class="rp-step__num">1</span>
          <span class="rp-step__label">Check In Device</span>
        </button>
        <div class="rp-step__connector"><div class="rp-step__connector-fill" data-fill="1"></div></div>
        <button class="rp-step" data-step="2" role="tab" aria-selected="false" aria-controls="wf-2" id="wf-tab-2" tabindex="-1">
          <span class="rp-step__num">2</span>
          <span class="rp-step__label">Assign Tech</span>
        </button>
        <div class="rp-step__connector"><div class="rp-step__connector-fill" data-fill="2"></div></div>
        <button class="rp-step" data-step="3" role="tab" aria-selected="false" aria-controls="wf-3" id="wf-tab-3" tabindex="-1">
          <span class="rp-step__num">3</span>
          <span class="rp-step__label">Add Parts</span>
        </button>
        <div class="rp-step__connector"><div class="rp-step__connector-fill" data-fill="3"></div></div>
        <button class="rp-step" data-step="4" role="tab" aria-selected="false" aria-controls="wf-4" id="wf-tab-4" tabindex="-1">
          <span class="rp-step__num">4</span>
          <span class="rp-step__label">Take Deposit</span>
        </button>
        <div class="rp-step__connector"><div class="rp-step__connector-fill" data-fill="4"></div></div>
        <button class="rp-step" data-step="5" role="tab" aria-selected="false" aria-controls="wf-5" id="wf-tab-5" tabindex="-1">
          <span class="rp-step__num">5</span>
          <span class="rp-step__label">Notify Customer</span>
        </button>
        <div class="rp-step__connector"><div class="rp-step__connector-fill" data-fill="5"></div></div>
        <button class="rp-step" data-step="6" role="tab" aria-selected="false" aria-controls="wf-6" id="wf-tab-6" tabindex="-1">
          <span class="rp-step__num">6</span>
          <span class="rp-step__label">Final Payment</span>
        </button>
      </div>

      <!-- Workflow Panels -->
      <div class="rp-wf-panels">
        <!-- STEP 1: Check In Device -->
        <div class="rp-wf-panel active" data-wf="1" role="tabpanel" id="wf-1" aria-labelledby="wf-tab-1">
          <div class="rp-wf-screen">
            <div class="rp-wf-screen__bar">
              <span><i class="fa-solid fa-clipboard-list"></i> PPDrepair — New Repair Ticket</span>
              <span class="rp-wf-screen__badge blue">Step 1 of 6</span>
            </div>
            <div class="rp-wf-screen__body">
              <div class="rp-wf-split">
                <div class="rp-wf-form-area">
                  <h4 class="rp-wf-form-title">Device Check-In</h4>
                  <div class="rp-wf-form-grid">
                    <div class="rp-wf-field">
                      <label>Customer Name</label>
                      <div class="rp-wf-input filled">John Mitchell</div>
                    </div>
                    <div class="rp-wf-field">
                      <label>Phone Number</label>
                      <div class="rp-wf-input filled">(555) 234-5678</div>
                    </div>
                    <div class="rp-wf-field">
                      <label>Device Model</label>
                      <div class="rp-wf-input filled">iPhone 15 Pro Max</div>
                    </div>
                    <div class="rp-wf-field">
                      <label>Issue Type</label>
                      <div class="rp-wf-input filled">Cracked Screen + Battery Drain</div>
                    </div>
                    <div class="rp-wf-field full">
                      <label>Intake Notes</label>
                      <div class="rp-wf-textarea filled">Customer dropped device. Screen shattered across bottom half. Battery draining within 2 hours. Wants screen replacement + battery swap. No water damage. Face ID functional.</div>
                    </div>
                    <div class="rp-wf-field">
                      <label>Initial Estimate</label>
                      <div class="rp-wf-input filled"><strong>$268.00</strong></div>
                    </div>
                    <div class="rp-wf-field">
                      <label>Estimated Completion</label>
                      <div class="rp-wf-input filled">Today, 4:00 PM</div>
                    </div>
                  </div>
                  <div class="rp-wf-intake-checks">
                    <span class="rp-wf-check checked"><i class="fa-solid fa-square-check"></i> Pre-repair photos taken</span>
                    <span class="rp-wf-check checked"><i class="fa-solid fa-square-check"></i> Customer signature captured</span>
                    <span class="rp-wf-check checked"><i class="fa-solid fa-square-check"></i> Device condition documented</span>
                  </div>
                  <button class="rp-wf-cta-btn"><i class="fa-solid fa-ticket"></i> Create Repair Ticket — TK-1042</button>
                </div>
                <div class="rp-wf-preview-area">
                  <div class="rp-wf-ticket-preview">
                    <div class="rp-wf-ticket-preview__hdr">
                      <span class="rp-badge rp-badge--blue">New</span>
                      <span class="rp-wf-ticket-id">TK-1042</span>
                    </div>
                    <h5>iPhone 15 Pro Max</h5>
                    <p>Cracked Screen + Battery Drain</p>
                    <div class="rp-wf-ticket-meta">
                      <span><i class="fa-solid fa-user"></i> John Mitchell</span>
                      <span><i class="fa-solid fa-dollar-sign"></i> Est: $268.00</span>
                      <span><i class="fa-solid fa-clock"></i> Today 4 PM</span>
                    </div>
                    <div class="rp-wf-progress-mini">
                      <div class="rp-wf-progress-bar"><div class="rp-wf-progress-fill" style="width:8%"></div></div>
                      <span>Intake Complete</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 2: Assign Technician -->
        <div class="rp-wf-panel" data-wf="2" role="tabpanel" id="wf-2" aria-labelledby="wf-tab-2" hidden>
          <div class="rp-wf-screen">
            <div class="rp-wf-screen__bar">
              <span><i class="fa-solid fa-user-gear"></i> PPDrepair — Assign Technician</span>
              <span class="rp-wf-screen__badge amber">Step 2 of 6</span>
            </div>
            <div class="rp-wf-screen__body">
              <div class="rp-wf-split">
                <div class="rp-wf-form-area">
                  <h4 class="rp-wf-form-title">Assign to Technician</h4>
                  <div class="rp-wf-tech-list">
                    <div class="rp-wf-tech selected">
                      <div class="rp-wf-tech__avatar" style="background:#2D60FF">MR</div>
                      <div class="rp-wf-tech__info">
                        <strong>Mike Rodriguez</strong>
                        <span>Lead Tech · 3 active jobs</span>
                      </div>
                      <span class="rp-wf-tech__check"><i class="fa-solid fa-circle-check"></i></span>
                    </div>
                    <div class="rp-wf-tech">
                      <div class="rp-wf-tech__avatar" style="background:#00CFFF">LT</div>
                      <div class="rp-wf-tech__info">
                        <strong>Lisa Thompson</strong>
                        <span>Technician · 5 active jobs</span>
                      </div>
                    </div>
                    <div class="rp-wf-tech">
                      <div class="rp-wf-tech__avatar" style="background:#00E5A0">JC</div>
                      <div class="rp-wf-tech__info">
                        <strong>James Chen</strong>
                        <span>Junior Tech · 2 active jobs</span>
                      </div>
                    </div>
                  </div>
                  <div class="rp-wf-assign-fields">
                    <div class="rp-wf-field">
                      <label>Priority</label>
                      <div class="rp-wf-priority-pills">
                        <span>Low</span>
                        <span class="active">Normal</span>
                        <span>High</span>
                        <span>Urgent</span>
                      </div>
                    </div>
                    <div class="rp-wf-field">
                      <label>Estimated Time</label>
                      <div class="rp-wf-input filled">1.5 hours</div>
                    </div>
                  </div>
                  <button class="rp-wf-cta-btn"><i class="fa-solid fa-user-check"></i> Assign to Mike R. &amp; Start Job</button>
                </div>
                <div class="rp-wf-preview-area">
                  <div class="rp-wf-ticket-preview">
                    <div class="rp-wf-ticket-preview__hdr">
                      <span class="rp-badge rp-badge--amber">In Progress</span>
                      <span class="rp-wf-ticket-id">TK-1042</span>
                    </div>
                    <h5>iPhone 15 Pro Max</h5>
                    <p>Cracked Screen + Battery Drain</p>
                    <div class="rp-wf-ticket-meta">
                      <span><i class="fa-solid fa-user-gear"></i> Mike Rodriguez</span>
                      <span><i class="fa-solid fa-flag"></i> Normal Priority</span>
                      <span><i class="fa-solid fa-clock"></i> ~1.5 hrs</span>
                    </div>
                    <div class="rp-wf-progress-mini">
                      <div class="rp-wf-progress-bar"><div class="rp-wf-progress-fill" style="width:25%"></div></div>
                      <span>Technician Assigned</span>
                    </div>
                    <div class="rp-wf-status-change">
                      <span class="from">New</span>
                      <i class="fa-solid fa-arrow-right"></i>
                      <span class="to">In Progress</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 3: Add Parts -->
        <div class="rp-wf-panel" data-wf="3" role="tabpanel" id="wf-3" aria-labelledby="wf-tab-3" hidden>
          <div class="rp-wf-screen">
            <div class="rp-wf-screen__bar">
              <span><i class="fa-solid fa-boxes-stacked"></i> PPDrepair — Parts &amp; Inventory</span>
              <span class="rp-wf-screen__badge purple">Step 3 of 6</span>
            </div>
            <div class="rp-wf-screen__body">
              <div class="rp-wf-split">
                <div class="rp-wf-form-area">
                  <h4 class="rp-wf-form-title">Parts Used on TK-1042</h4>
                  <div class="rp-wf-parts-table">
                    <div class="rp-wf-part-row header"><span>Part</span><span>SKU</span><span>Cost</span><span>Price</span><span>Stock</span></div>
                    <div class="rp-wf-part-row">
                      <span><strong>iPhone 15 Pro OLED Screen</strong></span>
                      <span class="sku">SCR-IP15P</span>
                      <span>$85.00</span>
                      <span>$189.00</span>
                      <span class="rp-wf-stock low">2 → <strong>1</strong></span>
                    </div>
                    <div class="rp-wf-part-row">
                      <span><strong>iPhone 15 Pro Battery</strong></span>
                      <span class="sku">BAT-IP15P</span>
                      <span>$22.00</span>
                      <span>$79.00</span>
                      <span class="rp-wf-stock ok">8 → <strong>7</strong></span>
                    </div>
                  </div>
                  <div class="rp-wf-margin-box">
                    <div class="rp-wf-margin-line"><span>Parts Cost</span><span>$107.00</span></div>
                    <div class="rp-wf-margin-line"><span>Parts Revenue</span><span>$268.00</span></div>
                    <div class="rp-wf-margin-line profit"><span>Gross Margin</span><span>$161.00 (60%)</span></div>
                  </div>
                  <div class="rp-wf-low-stock-alert">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <div>
                      <strong>Low Stock Warning</strong>
                      <span>iPhone 15 Pro OLED Screen now at 1 unit — below minimum of 3. Reorder recommended.</span>
                    </div>
                  </div>
                </div>
                <div class="rp-wf-preview-area">
                  <div class="rp-wf-ticket-preview">
                    <div class="rp-wf-ticket-preview__hdr">
                      <span class="rp-badge rp-badge--amber">In Progress</span>
                      <span class="rp-wf-ticket-id">TK-1042</span>
                    </div>
                    <h5>iPhone 15 Pro Max</h5>
                    <div class="rp-wf-parts-added">
                      <span class="rp-part-tag"><i class="fa-solid fa-microchip"></i> OLED Screen ×1</span>
                      <span class="rp-part-tag"><i class="fa-solid fa-battery-full"></i> Battery ×1</span>
                    </div>
                    <div class="rp-wf-progress-mini">
                      <div class="rp-wf-progress-bar"><div class="rp-wf-progress-fill" style="width:50%"></div></div>
                      <span>Parts Allocated</span>
                    </div>
                    <div class="rp-wf-ticket-meta">
                      <span><i class="fa-solid fa-dollar-sign"></i> Total: $268.00</span>
                      <span><i class="fa-solid fa-chart-line"></i> Margin: 60%</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 4: Take Deposit -->
        <div class="rp-wf-panel" data-wf="4" role="tabpanel" id="wf-4" aria-labelledby="wf-tab-4" hidden>
          <div class="rp-wf-screen">
            <div class="rp-wf-screen__bar">
              <span><i class="fa-solid fa-credit-card"></i> PPDrepair — Take Deposit</span>
              <span class="rp-wf-screen__badge green">Step 4 of 6</span>
            </div>
            <div class="rp-wf-screen__body">
              <div class="rp-wf-split">
                <div class="rp-wf-form-area">
                  <h4 class="rp-wf-form-title">Collect Deposit Payment</h4>
                  <div class="rp-wf-invoice">
                    <div class="rp-wf-invoice-line"><span>Screen Replacement (iPhone 15 Pro)</span><span>$189.00</span></div>
                    <div class="rp-wf-invoice-line"><span>Battery Replacement</span><span>$79.00</span></div>
                    <div class="rp-wf-invoice-line sub"><span>Subtotal</span><span>$268.00</span></div>
                    <div class="rp-wf-invoice-line sub"><span>Tax (8.25%)</span><span>$22.11</span></div>
                    <div class="rp-wf-invoice-line total"><span>Total</span><span>$290.11</span></div>
                  </div>
                  <div class="rp-wf-deposit-section">
                    <div class="rp-wf-deposit-amount">
                      <label>Deposit Amount</label>
                      <div class="rp-wf-input filled"><strong>$100.00</strong></div>
                    </div>
                    <div class="rp-wf-pay-methods">
                      <button class="rp-wf-pay active"><i class="fa-solid fa-credit-card"></i> Card</button>
                      <button class="rp-wf-pay"><i class="fa-solid fa-money-bill"></i> Cash</button>
                    </div>
                    <div class="rp-wf-terminal-status"><i class="fa-solid fa-wifi"></i> Terminal: Dejavoo Z11 — Connected</div>
                  </div>
                  <button class="rp-wf-cta-btn"><i class="fa-solid fa-lock"></i> Process $100.00 Deposit</button>
                </div>
                <div class="rp-wf-preview-area">
                  <div class="rp-wf-ticket-preview">
                    <div class="rp-wf-ticket-preview__hdr">
                      <span class="rp-badge rp-badge--amber">In Progress</span>
                      <span class="rp-wf-ticket-id">TK-1042</span>
                    </div>
                    <h5>iPhone 15 Pro Max</h5>
