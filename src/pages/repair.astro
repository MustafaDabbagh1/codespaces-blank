/* ═══════════════ HERO ═══════════════ */
.rp-hero{background:linear-gradient(160deg,#060E21 0%,#0C1A38 55%,#0a1c42 100%);color:#fff;position:relative;overflow:hidden;padding:clamp(100px,12vw,140px) 0 clamp(60px,8vw,100px)}
.rp-hero__grid-bg{position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");pointer-events:none}
.rp-hero__orb{position:absolute;border-radius:50%;filter:blur(100px);opacity:.18;pointer-events:none}
.rp-hero__orb--1{width:600px;height:600px;background:#1549FF;top:-300px;right:-200px;animation:rpOrb 20s ease-in-out infinite}
.rp-hero__orb--2{width:400px;height:400px;background:#00CFFF;bottom:-200px;left:-100px;animation:rpOrb 25s ease-in-out infinite reverse}
@keyframes rpOrb{0%,100%{transform:translate(0) scale(1)}33%{transform:translate(30px,-20px) scale(1.05)}66%{transform:translate(-20px,15px) scale(.97)}}
.rp-hero__inner{display:grid;grid-template-columns:1fr;gap:48px;position:relative;z-index:2;align-items:center}
.rp-hero__text{max-width:600px}
.rp-hero__text h1{font-size:clamp(2rem,4.5vw,3rem);line-height:1.12;font-weight:800;letter-spacing:-.03em;margin:20px 0}
.rp-hero__text>p{font-size:clamp(.95rem,1.6vw,1.05rem);opacity:.75;line-height:1.7;margin-bottom:28px;max-width:50ch}
.rp-hero__actions{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:24px}
.rp-hero__trust{display:flex;flex-wrap:wrap;gap:16px}.rp-hero__trust span{display:inline-flex;align-items:center;gap:6px;font-size:12px;opacity:.5;font-weight:500}.rp-hero__trust span i{color:#00CFFF;opacity:.7}

/* Hero App Mockup */
.rp-hero__visual{position:relative;perspective:1200px}
.rp-hero-app{background:rgba(12,26,56,.9);border:1px solid rgba(255,255,255,.1);border-radius:14px;overflow:hidden;box-shadow:0 40px 100px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.05);backdrop-filter:blur(20px);transform:rotateY(-3deg) rotateX(2deg);animation:rpAppFloat 10s ease-in-out infinite;position:relative;z-index:2}
.rp-hero-app:hover{transform:rotateY(0) rotateX(0)}
@keyframes rpAppFloat{0%,100%{transform:rotateY(-3deg) rotateX(2deg)}50%{transform:rotateY(-1deg) rotateX(1deg) translateY(-5px)}}
.rp-hero-app__bar{display:flex;align-items:center;gap:8px;padding:10px 14px;background:rgba(0,0,0,.35);border-bottom:1px solid rgba(255,255,255,.06)}
.rp-hero-app__dots{display:flex;gap:5px}.rp-hero-app__dots span{width:10px;height:10px;border-radius:50%}.rp-hero-app__dots span:nth-child(1){background:#ff5f57}.rp-hero-app__dots span:nth-child(2){background:#febc2e}.rp-hero-app__dots span:nth-child(3){background:#28c840}
.rp-hero-app__title{margin-left:auto;font-size:11px;opacity:.4;font-weight:500}
.rp-hero-app__body{display:flex;min-height:280px}
.rp-hero-app__sidebar{width:44px;background:rgba(0,0,0,.18);border-right:1px solid rgba(255,255,255,.06);display:flex;flex-direction:column;align-items:center;gap:2px;padding:10px 0}
.rp-hero-app__nav{width:30px;height:30px;border-radius:7px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.25);font-size:12px}
.rp-hero-app__nav.active{background:rgba(21,73,255,.3);color:#00CFFF}
.rp-hero-app__main{flex:1;padding:12px;display:flex;flex-direction:column;gap:8px}
.rp-hero-app__topbar{display:flex;justify-content:space-between;align-items:flex-start}
.rp-hero-app__topbar strong{font-size:13px;display:block}.rp-hero-app__topbar span{font-size:9px;opacity:.4}
.rp-hero-app__presets{display:flex;gap:3px}.rp-hero-app__presets span{padding:3px 7px;border-radius:5px;font-size:9px;font-weight:600;color:rgba(255,255,255,.35)}.rp-hero-app__presets span.active{background:rgba(21,73,255,.3);color:#00CFFF}
.rp-hero-app__kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}
.rp-hero-kpi{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);border-radius:7px;padding:7px 8px}
.rp-hero-kpi__label{display:block;font-size:7px;opacity:.45;text-transform:uppercase;letter-spacing:.04em}
.rp-hero-kpi__val{display:block;font-size:15px;font-weight:800;letter-spacing:-.02em}
.rp-hero-kpi__tag{font-size:7px;font-weight:600;padding:1px 5px;border-radius:9999px}
.rp-hero-kpi__tag.green{background:rgba(0,229,160,.15);color:#00E5A0}.rp-hero-kpi__tag.orange{background:rgba(249,115,22,.15);color:#F97316}
.rp-hero-app__tickets{flex:1;display:flex;flex-direction:column;gap:3px}
.rp-hero-app__tickets-hdr{display:flex;justify-content:space-between;font-size:10px;font-weight:600;opacity:.6;margin-bottom:2px}
.rp-hero-app__tickets-hdr span{color:#00CFFF;font-size:9px;cursor:pointer}
.rp-hero-tkt{display:flex;align-items:center;gap:6px;padding:5px 7px;border-radius:6px;border:1px solid rgba(255,255,255,.05);background:rgba(255,255,255,.02);font-size:10px}
.rp-hero-tkt__badge{padding:2px 6px;border-radius:9999px;font-size:8px;font-weight:700;flex-shrink:0}
.rp-hero-tkt__badge.amber{background:rgba(217,119,6,.15);color:#F59E0B}.rp-hero-tkt__badge.green{background:rgba(0,229,160,.15);color:#00E5A0}.rp-hero-tkt__badge.blue{background:rgba(21,73,255,.15);color:#60A5FA}
.rp-hero-tkt__device{flex:1;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:rgba(255,255,255,.8)}
.rp-hero-tkt__tech{font-size:9px;opacity:.4;width:40px;text-align:right}
.rp-hero-tkt__price{font-weight:700;font-size:10px;width:32px;text-align:right}

/* Floating Hero Cards */
.rp-hero-card{position:absolute;background:rgba(12,26,56,.94);border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:12px 16px;backdrop-filter:blur(16px);box-shadow:0 16px 48px rgba(0,0,0,.5);font-size:12px;z-index:5;opacity:0;animation:rpCardIn .7s ease forwards}
.rp-hero-card__hdr{font-weight:700;font-size:11px;margin-bottom:8px;display:flex;align-items:center;gap:6px;color:rgba(255,255,255,.8)}.rp-hero-card__hdr i{font-size:13px}
.rp-hero-card--pos{bottom:30%;right:-20px;animation-delay:.5s;min-width:180px}
.rp-hero-card--pos .rp-hero-card__hdr i{color:#1549FF}
.rp-hero-card__line{display:flex;justify-content:space-between;font-size:10px;padding:2px 0;color:rgba(255,255,255,.55)}
.rp-hero-card__line.total{font-weight:800;color:#fff;border-top:1px solid rgba(255,255,255,.1);padding-top:6px;margin-top:4px;font-size:13px}
.rp-hero-card__btn{margin-top:8px;padding:7px;border-radius:8px;background:linear-gradient(135deg,#2D60FF,#1549FF);color:#fff;text-align:center;font-size:10px;font-weight:700}
.rp-hero-card--inv{top:10%;right:-15px;animation-delay:.8s;min-width:200px}
.rp-hero-card--inv .rp-hero-card__hdr i{color:#F97316}
.rp-hero-card__alert{font-size:10px;color:rgba(255,255,255,.6);padding:2px 0}.rp-hero-card__alert strong{color:#F97316}
.rp-hero-card--cust{bottom:5%;left:-15px;animation-delay:1.1s}
.rp-hero-card--cust .rp-hero-card__hdr i{color:#00CFFF}
.rp-hero-card__stat{display:flex;gap:12px;font-size:10px;color:rgba(255,255,255,.5)}
.rp-hero-card--pay{top:40%;left:-25px;animation-delay:1.4s;display:flex;align-items:center;gap:10px}
.rp-hero-card--pay i{font-size:18px;color:#00E5A0}
.rp-hero-card--pay strong{display:block;font-size:11px;color:rgba(255,255,255,.9)}.rp-hero-card--pay span{font-size:10px;color:rgba(255,255,255,.45)}
@keyframes rpCardIn{from{opacity:0;transform:translateY(18px) scale(.94)}to{opacity:1;transform:translateY(0) scale(1)}}

/* ═══════════════ INDUSTRIES ═══════════════ */
.rp-industries{padding:var(--section-py) 0;background:var(--surface)}
.rp-ind-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;max-width:900px;margin:0 auto}
.rp-ind{background:#fff;border:1px solid var(--border);border-radius:14px;padding:24px 20px;text-align:center;transition:all .35s;opacity:0;transform:translateY(16px)}
.rp-ind.animated{opacity:1;transform:translateY(0)}
.rp-ind:hover{border-color:rgba(21,73,255,.3);transform:translateY(-5px);box-shadow:0 16px 40px rgba(0,0,0,.07)}
.rp-ind__icon{width:52px;height:52px;margin:0 auto 12px;background:rgba(21,73,255,.07);border-radius:12px;display:flex;align-items:center;justify-content:center;transition:all .3s}
.rp-ind__icon i{font-size:22px;color:#1549FF;transition:all .3s}
.rp-ind:hover .rp-ind__icon{background:#1549FF;box-shadow:0 0 30px rgba(21,73,255,.25)}.rp-ind:hover .rp-ind__icon i{color:#fff}
.rp-ind h4{font-size:14px;font-weight:700;color:var(--text-1);margin-bottom:3px}
.rp-ind span{font-size:11px;color:var(--text-3);line-height:1.4}

/* ═══════════════ WORKFLOW DEMO ═══════════════ */
.rp-workflow{padding:clamp(80px,10vw,120px) 0;color:#fff;position:relative;overflow:hidden;background:radial-gradient(ellipse 80% 50% at 50% 0%,rgba(21,73,255,.12),transparent 50%),linear-gradient(160deg,#060E21,#0C1A38 60%,#0a1840)}
.rp-workflow .rp-section-hdr h2,.rp-workflow .rp-section-hdr p{color:rgba(255,255,255,.9) !important}

/* Stepper */
.rp-stepper{display:flex;align-items:center;justify-content:center;gap:0;margin-bottom:36px;flex-wrap:wrap}
.rp-step{display:flex;align-items:center;gap:8px;padding:10px 18px;border-radius:10px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.04);cursor:pointer;transition:all .3s;font-family:'Inter',sans-serif;color:rgba(255,255,255,.5);font-size:13px;font-weight:600}
.rp-step:hover{background:rgba(255,255,255,.08);color:rgba(255,255,255,.8)}
.rp-step.active{background:rgba(21,73,255,.2);border-color:#1549FF;color:#fff;box-shadow:0 0 30px rgba(21,73,255,.2)}
.rp-step.done{background:rgba(0,229,160,.1);border-color:rgba(0,229,160,.3);color:#00E5A0}
.rp-step__num{width:24px;height:24px;border-radius:50%;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;flex-shrink:0;transition:all .3s}
.rp-step.active .rp-step__num{background:#1549FF;color:#fff}
.rp-step.done .rp-step__num{background:#00E5A0;color:#060E21}
.rp-step__label{white-space:nowrap}
.rp-step__connector{width:24px;height:2px;background:rgba(255,255,255,.1);position:relative;flex-shrink:0;overflow:hidden;border-radius:2px}
.rp-step__connector-fill{height:100%;width:0;background:#00E5A0;border-radius:2px;transition:width .5s ease}
.rp-step__connector-fill.filled{width:100%}

/* Workflow Panels */
.rp-wf-panel{display:none;animation:rpWfIn .45s ease}.rp-wf-panel.active{display:block}
@keyframes rpWfIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.rp-wf-screen{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.1);border-radius:16px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.3);max-width:1000px;margin:0 auto}
.rp-wf-screen__bar{display:flex;justify-content:space-between;align-items:center;padding:14px 20px;background:rgba(0,0,0,.2);border-bottom:1px solid rgba(255,255,255,.06);font-weight:600;font-size:14px;color:rgba(255,255,255,.85)}
.rp-wf-screen__bar i{margin-right:6px;opacity:.6}
.rp-wf-screen__badge{padding:4px 10px;border-radius:9999px;font-size:10px;font-weight:700}
.rp-wf-screen__badge.blue{background:rgba(21,73,255,.15);color:#60A5FA}
.rp-wf-screen__badge.amber{background:rgba(217,119,6,.15);color:#F59E0B}
.rp-wf-screen__badge.purple{background:rgba(124,58,237,.15);color:#A78BFA}
.rp-wf-screen__badge.green{background:rgba(0,229,160,.15);color:#00E5A0}
.rp-wf-screen__badge.cyan{background:rgba(0,207,255,.15);color:#00CFFF}
.rp-wf-screen__body{padding:24px}
.rp-wf-split{display:grid;grid-template-columns:1fr;gap:24px}

/* Workflow Form */
.rp-wf-form-title{font-size:16px;font-weight:700;margin-bottom:16px;color:#fff}
.rp-wf-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
.rp-wf-field{display:flex;flex-direction:column;gap:4px}
.rp-wf-field.full{grid-column:1/-1}
.rp-wf-field label{font-size:10px;font-weight:600;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.04em}
.rp-wf-input{padding:9px 12px;border-radius:8px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.04);font-size:13px;color:rgba(255,255,255,.8)}
.rp-wf-input.filled{background:rgba(255,255,255,.06);border-color:rgba(21,73,255,.3)}
.rp-wf-textarea{padding:9px 12px;border-radius:8px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.04);font-size:12px;color:rgba(255,255,255,.7);line-height:1.5}
.rp-wf-textarea.filled{background:rgba(255,255,255,.06);border-color:rgba(21,73,255,.3)}
.rp-wf-intake-checks{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.rp-wf-check{font-size:11px;color:rgba(255,255,255,.5);display:flex;align-items:center;gap:4px}
.rp-wf-check.checked{color:#00E5A0}.rp-wf-check.checked i{color:#00E5A0}
.rp-wf-cta-btn{width:100%;padding:14px;border-radius:10px;border:none;background:linear-gradient(135deg,#2D60FF,#1549FF);color:#fff;font-size:14px;font-weight:700;cursor:pointer;font-family:'Inter',sans-serif;box-shadow:0 8px 28px rgba(21,73,255,.35);display:flex;align-items:center;justify-content:center;gap:8px;transition:all .2s}
.rp-wf-cta-btn:hover{transform:translateY(-2px);box-shadow:0 14px 40px rgba(21,73,255,.45)}
.rp-wf-cta-btn--success{background:linear-gradient(135deg,#059669,#00E5A0);box-shadow:0 8px 28px rgba(0,229,160,.3)}.rp-wf-cta-btn--success:hover{box-shadow:0 14px 40px rgba(0,229,160,.4)}

/* Ticket Preview */
.rp-wf-preview-area{}
.rp-wf-ticket-preview{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:16px;position:sticky;top:20px}
.rp-wf-ticket-preview__hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.rp-wf-ticket-id{font-size:11px;font-weight:700;color:rgba(255,255,255,.4);font-family:monospace;letter-spacing:.05em}
.rp-wf-ticket-preview h5{font-size:15px;font-weight:700;color:#fff;margin-bottom:6px}
.rp-wf-ticket-preview p{font-size:12px;color:rgba(255,255,255,.55);margin-bottom:10px}
.rp-wf-ticket-meta{display:flex;flex-wrap:wrap;gap:12px;font-size:11px;color:rgba(255,255,255,.5);margin-top:10px}.rp-wf-ticket-meta i{margin-right:3px;opacity:.5}
.rp-wf-progress-mini{margin:10px 0}
.rp-wf-progress-bar{height:6px;background:rgba(255,255,255,.08);border-radius:9999px;overflow:hidden;margin-bottom:4px}
.rp-wf-progress-fill{height:100%;background:linear-gradient(90deg,#1549FF,#00CFFF);border-radius:9999px;transition:width .8s ease}
.rp-wf-progress-fill.rp-fill-green{background:linear-gradient(90deg,#059669,#00E5A0)}
.rp-wf-progress-mini span{font-size:10px;color:rgba(255,255,255,.45);font-weight:500}
.rp-wf-status-change{display:flex;align-items:center;gap:8px;margin-top:10px;font-size:11px}
.rp-wf-status-change .from{padding:3px 8px;border-radius:6px;background:rgba(255,255,255,.06);color:rgba(255,255,255,.4)}
.rp-wf-status-change i{color:rgba(255,255,255,.2);font-size:10px}
.rp-wf-status-change .to{padding:3px 8px;border-radius:6px;background:rgba(21,73,255,.15);color:#60A5FA;font-weight:600}
.rp-wf-status-change .to.green{background:rgba(0,229,160,.12);color:#00E5A0}
.rp-wf-parts-added{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}
.rp-wf-ticket-preview--done{text-align:center;border-color:rgba(0,229,160,.2)}
.rp-wf-complete-icon{font-size:48px;color:#00E5A0;margin-bottom:12px}
.rp-wf-final-summary{display:grid;grid-template-columns:1fr 1fr;gap:10px;text-align:left;margin-top:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,.08)}
.rp-wf-final-summary div span{display:block;font-size:10px;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.03em}
.rp-wf-final-summary div strong{font-size:13px;color:rgba(255,255,255,.9)}

/* Tech List */
.rp-wf-tech-list{display:flex;flex-direction:column;gap:8px;margin-bottom:14px}
.rp-wf-tech{display:flex;align-items:center;gap:12px;padding:12px;border-radius:10px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.03);cursor:pointer;transition:all .2s}
.rp-wf-tech:hover{background:rgba(255,255,255,.06)}
.rp-wf-tech.selected{border-color:rgba(21,73,255,.4);background:rgba(21,73,255,.08)}
.rp-wf-tech__avatar{width:38px;height:38px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px;flex-shrink:0}
.rp-wf-tech__info{flex:1}.rp-wf-tech__info strong{display:block;font-size:13px;color:rgba(255,255,255,.9)}.rp-wf-tech__info span{font-size:11px;color:rgba(255,255,255,.4)}
.rp-wf-tech__check{color:#1549FF;font-size:18px}
.rp-wf-assign-fields{display:flex;flex-direction:column;gap:10px;margin-bottom:14px}
.rp-wf-priority-pills{display:flex;gap:6px}
.rp-wf-priority-pills span{padding:6px 14px;border-radius:8px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.04);font-size:12px;color:rgba(255,255,255,.5);cursor:pointer;transition:all .2s;font-weight:600}
.rp-wf-priority-pills span.active{background:rgba(21,73,255,.15);border-color:#1549FF;color:#60A5FA}

/* Parts Table */
.rp-wf-parts-table{margin-bottom:14px}
.rp-wf-part-row{display:grid;grid-template-columns:1.5fr .7fr .6fr .6fr .7fr;gap:8px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.06);font-size:12px;align-items:center;color:rgba(255,255,255,.65)}
.rp-wf-part-row.header{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.03em;color:rgba(255,255,255,.35);border-bottom:1px solid rgba(255,255,255,.1)}
.rp-wf-part-row strong{color:rgba(255,255,255,.9);font-weight:600}
.rp-wf-part-row .sku{font-family:monospace;font-size:10px;color:rgba(255,255,255,.35)}
.rp-wf-stock{font-weight:600}.rp-wf-stock.low{color:#F97316}.rp-wf-stock.ok{color:#00E5A0}
.rp-wf-margin-box{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:12px;margin-bottom:14px}
.rp-wf-margin-line{display:flex;justify-content:space-between;font-size:12px;color:rgba(255,255,255,.55);padding:3px 0}
.rp-wf-margin-line.profit{font-weight:700;color:#00E5A0;border-top:1px solid rgba(255,255,255,.08);padding-top:8px;margin-top:4px;font-size:14px}
.rp-wf-low-stock-alert{display:flex;align-items:flex-start;gap:10px;background:rgba(249,115,22,.08);border:1px solid rgba(249,115,22,.2);border-radius:10px;padding:12px;margin-bottom:14px}
.rp-wf-low-stock-alert i{color:#F97316;font-size:16px;margin-top:2px;flex-shrink:0}
.rp-wf-low-stock-alert strong{display:block;font-size:12px;color:rgba(255,255,255,.85)}.rp-wf-low-stock-alert span{font-size:11px;color:rgba(255,255,255,.5)}

/* Invoice/Deposit */
.rp-wf-invoice{border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:14px;margin-bottom:14px}
.rp-wf-invoice-line{display:flex;justify-content:space-between;font-size:12px;color:rgba(255,255,255,.6);padding:4px 0}
.rp-wf-invoice-line.sub{font-size:11px;color:rgba(255,255,255,.4);border-top:1px solid rgba(255,255,255,.06);padding-top:8px;margin-top:4px}
.rp-wf-invoice-line.total{font-weight:800;font-size:16px;color:#fff;border-top:1px solid rgba(255,255,255,.1);padding-top:8px;margin-top:4px}
.rp-wf-deposit-section{display:flex;flex-direction:column;gap:10px;margin-bottom:14px}
