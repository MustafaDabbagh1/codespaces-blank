---
import ProductPage from '../components/ProductPage.astro';
import RepairDemo from '../components/demos/RepairDemo.astro';
import Icon from '../components/Icon.astro';

const features = [
  { icon: 'ticket', title: 'Repair tickets', body: 'Create or pick a customer, log the device and issue, assign a technician, and follow the job from intake to pickup on one ticket.' },
  { icon: 'cart', title: 'Point of sale', body: 'Ring up repairs, parts, accessories, activations and top-ups in one cart, with cash and card pricing and automatic tax.' },
  { icon: 'box', title: 'Serialized inventory', body: 'Track parts, products and serialized units per store, with low-stock and out-of-stock alerts and inter-store transfers.' },
  { icon: 'message', title: 'Customer updates', body: 'Branded updates go out automatically as the job moves: ticket received, estimate approved, ready for pickup.' },
  { icon: 'bars', title: 'Reporting and daily close', body: 'Daily KPIs, sales and profit trends and a payment-method breakdown, so the end of the day is a glance, not a project.' },
  { icon: 'star', title: 'Google review requests', body: 'After pickup, send a review request by text or email and turn finished repairs into reputation.' },
];

const before = ['Standalone register', 'Inventory spreadsheet', 'Sticky-note tickets', 'Manual customer texts', 'Month-end guesswork'];
const after = ['Tickets', 'Inventory', 'Payments', 'Customers', 'Reporting', 'Customer updates'];

const faqs = [
  { q: 'What does PPD Repair cost?', a: '$30 per month for each location, with the full platform included. Add locations as you grow and manage them all from one account.' },
  { q: 'How do card payments work?', a: 'Payments run on Dejavoo terminals connected to PPD Repair. Card processing rates are handled with your processor, separate from the software subscription.' },
  { q: 'Is it only for phone repair?', a: 'It is strongest for cell phone repair stores, and flexible enough for computer, jewelry, watch, camera and small-engine repair shops.' },
  { q: 'Can I run more than one store?', a: 'Yes. Inventory, roles and access are per store, with transfers between locations and one account across all of them.' },
  { q: 'Can I see it before I commit?', a: 'Yes. Book a walkthrough on your own workflow first. No card is required to book a demo.' },
];
---

<ProductPage
  productKey="repair"
  title="PPD Repair | The command center for repair shops | PPD Technology"
  description="Run every repair from one command board. PPD Repair brings tickets, point of sale, serialized inventory, payments and customer updates together for $30 a month per location."
  headline="Run every repair from one command board."
  lede="PPD Repair puts tickets, parts, payments and customer updates on a single screen, so work moves from the bench to the front counter without the back-and-forth."
  audiences={['Cell phone repair', 'Computer repair', 'Jewelry repair', 'Watch repair', 'Camera repair', 'Small engine repair']}
  demo={{ eyebrow: 'From intake to pickup', title: 'Every repair, start to finish.' }}
  featuresHead={{ eyebrow: 'One system', title: 'Everything the shop runs on, connected.' }}
  features={features}
  pricing={{
    label: 'Simple, per-location pricing',
    price: '$30',
    unit: 'per month, per location. The full platform included.',
    includes: [
      'Repair tickets from intake to pickup',
      'Point of sale for repairs, parts and accessories',
      'Serialized inventory and inter-store transfers',
      'Automatic branded customer updates',
      'Dejavoo card terminal payments',
      'Roles, per-store access and technician commissions',
      'Reporting, refunds and daily close',
    ],
    note: 'Card processing rates are handled with your processor, separate from your software subscription.',
  }}
  faqs={faqs}
  form={{ tag: 'repair-demo', subject: 'New Repair Demo Request', title: 'Put your whole shop on one board.', lede: 'See how PPD Repair runs your tickets, inventory, payments and customer updates together, in a walkthrough tailored to your shop.', cta: 'Request a demo' }}
>
  <RepairDemo>
    <p class="eyebrow">From intake to pickup</p>
    <h2 class="h-2">Every repair, start to finish.</h2>
  </RepairDemo>

  <Fragment slot="extra">
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow reveal">Why one system</p>
          <h2 class="h-1 reveal" style="--i:1">Stop stitching tools together.</h2>
          <p class="lede reveal" style="--i:2">Most shops run a register here, a spreadsheet there, and texts in between. PPD Repair connects the whole job so nothing slips between apps.</p>
        </div>
        <div class="ba">
          <div class="ba__col ba__col--before reveal">
            <h3>Disconnected tools</h3>
            <ul>{before.map((b) => <li><Icon name="x" size={16} stroke={2.4} /> {b}</li>)}</ul>
          </div>
          <div class="ba__arrow reveal" aria-hidden="true"><Icon name="arrow-right" size={22} /></div>
          <div class="ba__col ba__col--after reveal" style="--i:1">
            <h3>One repair command center</h3>
            <ul>{after.map((a) => <li><Icon name="check" size={16} stroke={2.8} /> {a}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>
  </Fragment>

  <div class="field field--full" slot="fields">
    <label for="repair-type">Type of repair shop <span class="opt">optional</span></label>
    <select id="repair-type" name="type">
      <option value="">Select</option>
      <option>Cell phone repair</option>
      <option>Computer repair</option>
      <option>Jewelry repair</option>
      <option>Watch repair</option>
      <option>Camera repair</option>
      <option>Small engine repair</option>
      <option>Other</option>
    </select>
  </div>
</ProductPage>

<style>
  .ba {
    display: grid;
    grid-template-columns: 1fr auto 1.2fr;
    gap: clamp(12px, 2vw, 28px);
    align-items: center;
  }
  .ba__col {
    padding: clamp(24px, 3.4vw, 44px);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
  }
  .ba__col h3 {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    margin-bottom: 20px;
  }
  .ba__col ul {
    display: grid;
    gap: 12px;
  }
  .ba__col li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ba__col--before {
    background: #0a0d14;
    color: #8c95a8;
  }
  .ba__col--before li {
    text-decoration: line-through;
    text-decoration-color: rgba(255, 255, 255, 0.25);
  }
  .ba__col--after {
    border-color: rgba(47, 107, 255, 0.55);
    background: radial-gradient(120% 90% at 100% 0%, rgba(47, 107, 255, 0.32), transparent 60%), var(--ink-2);
  }
  .ba__col--after ul {
    grid-template-columns: 1fr 1fr;
  }
  .ba__col--after li {
    font-weight: 600;
  }
  .ba__col--after li :global(svg) {
    color: var(--repair-2);
  }
  .ba__arrow {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    color: var(--repair-2);
  }
  @media (max-width: 820px) {
    .ba {
      grid-template-columns: 1fr;
    }
    .ba__arrow {
      justify-self: center;
      rotate: 90deg;
    }
  }
</style>
