    .pm-crm-panel{display:none}
    .pm-crm-panel.active{display:block}

    .pm-gateway{background:#fff;border-top:1px solid var(--pm-border);border-bottom:1px solid var(--pm-border)}
    .pm-gateway-layout{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:center}
    .pm-gateway-text h2{font-size:clamp(24px,2.8vw,36px);letter-spacing:-.03em;margin:10px 0 8px}
    .pm-gateway-features{display:flex;flex-direction:column;gap:16px;margin-top:24px}
    .pm-gw-feat{display:flex;gap:12px;align-items:flex-start}
    .pm-gw-check{width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:rgba(0,229,160,.1);border:1px solid rgba(0,229,160,.2);color:var(--pm-green);font-size:12px;flex-shrink:0;margin-top:2px}
    .pm-gw-feat strong{display:block;font-size:14px;margin-bottom:2px}
    .pm-gw-feat span{font-size:13px;color:var(--pm-muted);line-height:1.5}

    .pm-gw-diagram{background:linear-gradient(135deg,var(--pm-navy),#0A2B74);border:1px solid rgba(21,73,255,.2);border-radius:var(--pm-r);padding:40px;display:flex;flex-direction:column;align-items:center;gap:28px}
    .pm-gw-center{display:flex;flex-direction:column;align-items:center;gap:8px;padding:20px 28px;background:rgba(21,73,255,.2);border:1px solid rgba(21,73,255,.3);border-radius:14px;color:#fff;font-weight:800;font-size:15px}
    .pm-gw-center i{font-size:24px;color:var(--pm-cyan)}
    .pm-gw-nodes{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;width:100%}
    .pm-gw-node{display:flex;flex-direction:column;align-items:center;gap:6px;padding:14px 10px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:#fff;font-size:12px;font-weight:700}
    .pm-gw-node i{font-size:18px;color:var(--pm-cyan)}

    .pm-why{background:radial-gradient(600px 400px at 30% 80%,rgba(0,229,160,.08),transparent 60%),linear-gradient(135deg,var(--pm-navy) 0%,var(--pm-navy-2) 100%);color:#fff}
    .pm-why h2{color:#fff}
    .pm-why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .pm-why-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:24px;transition:transform .25s,border-color .25s,background .25s}
    .pm-why-card:hover{transform:translateY(-4px);background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.18)}
    .pm-why-icon{width:40px;height:40px;border-radius:12px;margin-bottom:14px;display:flex;align-items:center;justify-content:center;font-size:16px;background:rgba(0,207,255,.12);border:1px solid rgba(0,207,255,.2);color:var(--pm-cyan)}
    .pm-why-card h3{font-size:16px;margin-bottom:6px}
    .pm-why-card p{font-size:13px;color:rgba(255,255,255,.6);line-height:1.55}

    .pm-cta{background:radial-gradient(500px 300px at 50% 100%,rgba(21,73,255,.25),transparent 60%),linear-gradient(135deg,var(--pm-navy) 0%,#0A2B74 55%,var(--pm-primary-dark) 100%);color:#fff;padding:clamp(64px,8vw,100px) 0;text-align:center;position:relative;overflow:hidden}
    .pm-cta-glow{position:absolute;top:-50%;left:50%;transform:translateX(-50%);width:600px;height:600px;background:rgba(21,73,255,.12);border-radius:50%;filter:blur(100px);pointer-events:none}
    .pm-cta-inner{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:14px}
    .pm-cta h2{font-size:clamp(26px,3vw,40px);letter-spacing:-.03em;max-width:700px}
    .pm-cta p{color:rgba(255,255,255,.7);max-width:620px;font-size:clamp(15px,1.2vw,17px)}
    .pm-cta-actions{display:flex;gap:12px;margin-top:10px;flex-wrap:wrap;justify-content:center}

    .pm-reg-bar{background:var(--pm-navy);color:rgba(255,255,255,.5);text-align:center;padding:14px 16px;font-size:12px}

    @media(max-width:1024px){
      .pm-hero-inner{grid-template-columns:1fr}
      .pm-dash{max-width:600px}
      .pm-value-grid{grid-template-columns:repeat(2,1fr)}
      .pm-gateway-layout{grid-template-columns:1fr}
      .pm-why-grid{grid-template-columns:repeat(2,1fr)}
    }
    @media(max-width:768px){
      .pm-value-grid{grid-template-columns:1fr}
      .pm-demo-kpi-row{grid-template-columns:repeat(2,1fr)}
      .pm-demo-split{grid-template-columns:1fr}
      .pm-demo-table-head,.pm-demo-table-row{grid-template-columns:1fr 1fr 1fr}
      .pm-demo-table-head span:nth-child(n+4),.pm-demo-table-row span:nth-child(n+4){display:none}
      .pm-why-grid{grid-template-columns:1fr}
      .pm-dash-stats{grid-template-columns:1fr 1fr}
      .pm-dash-row{grid-template-columns:1fr}
      .pm-gw-nodes{grid-template-columns:repeat(2,1fr)}
      .pm-hero h1{font-size:clamp(28px,6vw,40px)}
    }
    @media(max-width:480px){
      .pm-hero-actions{flex-direction:column}
      .pm-cta-actions{flex-direction:column;width:100%}
      .pm-demo-topbar{flex-direction:column;align-items:flex-start}
    }
  </style>

  <script is:inline>
    (() => {
      const page = document.querySelector('.pm-page');
      if (!page) return;

      function setupTabs(tabSelector, panelSelector, panelIdFn) {
        const tabs = page.querySelectorAll(tabSelector);
        const panels = page.querySelectorAll(panelSelector);
        function activate(tab) {
          tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected','false'); t.tabIndex = -1; });
          panels.forEach(p => p.classList.remove('active'));
          tab.classList.add('active');
          tab.setAttribute('aria-selected','true');
          tab.tabIndex = 0;
          tab.focus();
          const id = panelIdFn(tab);
          const target = page.querySelector('#' + id);
          if (target) target.classList.add('active');
        }
        tabs.forEach(tab => tab.addEventListener('click', () => activate(tab)));
        tabs.forEach(tab => {
          tab.addEventListener('keydown', (e) => {
            const arr = Array.from(tabs);
            const idx = arr.indexOf(tab);
            let next;
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); next = arr[(idx + 1) % arr.length]; }
            else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); next = arr[(idx - 1 + arr.length) % arr.length]; }
            else if (e.key === 'Home') { e.preventDefault(); next = arr[0]; }
            else if (e.key === 'End') { e.preventDefault(); next = arr[arr.length - 1]; }
            if (next) activate(next);
          });
        });
      }

      setupTabs('.pm-demo-tab', '.pm-demo-panel', tab => tab.dataset.tab);
      setupTabs('.pm-crm-tab', '.pm-crm-panel', tab => 'pm-crm-' + tab.dataset.crmtab);

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.style.opacity = '1';
            e.target.style.transform = 'translateY(0)';
          }
        });
      }, { threshold: 0.1 });
      page.querySelectorAll('.pm-value-card, .pm-why-card, .pm-gw-feat').forEach(el => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(20px)';
        el.style.transition = 'opacity .5s ease, transform .5s ease';
        observer.observe(el);
      });
    })();
  </script>
</BaseLayout>
