---
import ProductPage from '../components/ProductPage.astro';
import MerchantDemo from '../components/demos/MerchantDemo.astro';

const features = [
  { icon: 'card', title: 'Take payments your way', body: 'Use a virtual terminal, payment links, invoices, ACH or in-person POS, for the way your customers actually pay.' },
  { icon: 'box', title: 'Keep orders moving', body: 'Connect shop orders, fulfillment details and customer information in one operational view.' },
  { icon: 'users', title: 'Know your customers', body: 'Account history and payment activity are at hand when the next conversation happens.' },
  { icon: 'repeat', title: 'Make repeat billing easier', body: 'Set up recurring plans and see which payments need a closer look.' },
  { icon: 'pen', title: 'Put agreements in reach', body: 'Bring signed documents and financing templates into the same workspace as payments.' },
  { icon: 'chart', title: 'See what happened', body: 'Review transactions, invoices, batches and account activity without hunting between tools.' },
];

const faqs = [
  { q: 'Is the merchant portal really free?', a: 'The core PPD Merchant portal has no monthly software fee. Card processing rates are handled separately with your processor, and optional add-ons may have their own pricing.' },
  { q: 'Can I try the workspace before booking a demo?', a: 'Yes. ppdmerchant.com has a live interactive demo with real controls and safe sample data. No sign-in is required.' },
  { q: 'What kinds of payments can I manage?', a: 'Card-not-present payments on a virtual terminal, invoices and payment links, ACH, and in-person payments on a POS or a Dejavoo terminal.' },
  { q: 'Can I manage recurring billing and agreements?', a: 'Yes. Recurring Billing and E-Sign Agreements are optional add-ons that sit beside the payments they support.' },
  { q: 'Who is it built for?', a: 'Businesses that invoice customers, take phone payments, manage orders, bill repeatedly, or collect deposits and agreements: wholesalers and distributors, service and repair businesses, contractors, and POS and equipment dealers.' },
];
---

<ProductPage
  productKey="merchant"
  title="PPD Merchant | Payments, invoicing and customers in one workspace | PPD Technology"
  description="Merchant by PPD Technology: virtual terminal, invoices, payment links, ACH, orders, customers and agreements in one connected workspace. The core portal has no monthly software fee."
  headline="Every payment. The whole picture."
  lede="Payments, invoicing, orders, customers and agreements, together where business actually happens. Your business does not happen in separate tabs, and neither should your payments."
  audiences={['B2B wholesalers and distributors', 'Service and repair businesses', 'Contractors and installers', 'POS and equipment dealers']}
  demo={{ eyebrow: 'A connected workspace', title: 'From first payment to final balance.' }}
  featuresHead={{ eyebrow: 'In one place', title: 'The details connect. The work moves.' }}
  features={features}
  pricing={{
    label: 'Cost of software',
    price: 'Free',
    unit: 'Core merchant portal. No monthly software fee.',
    includes: [
      'Virtual terminal, invoicing and payment links',
      'Point of sale for in-person payments',
      'Customer accounts and payer portal',
      'Dejavoo card terminal payments',
      'Transaction reporting, refunds and batch close',
      'Roles and sales agent access',
    ],
    addons: ['Recurring Billing', 'E-Sign Agreements', 'Financing Templates', 'Advanced Reporting', 'Custom Portal Add-ons'],
    note: 'Card processing rates are handled with your processor, separate from your software. Optional add-ons may have their own pricing.',
  }}
  faqs={faqs}
  form={{ tag: 'merchant-demo', subject: 'New PPD Merchant Demo Request', title: 'Your payments deserve the full picture.', lede: 'Tell us how your business works. We will show you what Merchant can do with it.', cta: 'Book a demo' }}
>
  <MerchantDemo layout="flip">
    <p class="eyebrow">A connected workspace</p>
    <h2 class="h-2">From first payment to final balance.</h2>
  </MerchantDemo>
</ProductPage>
