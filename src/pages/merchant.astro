    .pm-demo-table-row{display:grid;grid-template-columns:repeat(5,1fr);padding:10px 14px;font-size:12px;color:rgba(255,255,255,.75);border-bottom:1px solid rgba(255,255,255,.04);align-items:center}
    .pm-demo-table-row:last-child{border-bottom:none}
    .pm-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:999px;font-size:10px;font-weight:700;width:fit-content}
    .pm-badge.green{background:rgba(16,185,129,.15);color:#34d399}
    .pm-badge.yellow{background:rgba(245,158,11,.15);color:#fbbf24}
    .pm-badge.blue{background:rgba(21,73,255,.15);color:#60a5fa}
    .pm-badge.red{background:rgba(239,68,68,.15);color:#f87171}
    .pm-badge.gray{background:rgba(255,255,255,.08);color:rgba(255,255,255,.5)}
    .pm-source{font-size:11px;display:flex;align-items:center;gap:4px;color:rgba(255,255,255,.5)}
