---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PPD Merchant | Modern Payments & Merchant Management Platform">

  <div class="pm-page">

    <div class="pm-member-bar">
      <div class="container pm-member-bar__inner">
        <span>Already a member?</span>
        <a href="https://ppdmerchant.com/" target="_blank" rel="noopener noreferrer" class="pm-member-bar__link"><i class="fa-solid fa-right-to-bracket"></i> Login Now</a>
      </div>
    </div>

    <section class="pm-hero">
      <div class="pm-hero-grid"></div>
      <div class="pm-hero-orb pm-hero-orb--1"></div>
      <div class="pm-hero-orb pm-hero-orb--2"></div>
      <div class="container pm-hero-inner">
        <div class="pm-hero-text">
          <span class="pm-pill"><i class="fa-solid fa-terminal"></i> Merchant Operating Platform</span>
          <h1>Your Gateway, CRM, Billing &amp; Portal — <span class="pm-grad-text">All in One</span></h1>
          <p class="pm-hero-sub">
            PPD Merchant helps businesses manage keyed &amp; online payments, ACH, recurring billing, customer records, sales agents, shop orders, and digital agreements from a single modern platform.
          </p>
          <div class="pm-hero-actions">
            <a class="pm-btn pm-btn-primary pm-btn-lg" href="/contact">
              <i class="fa-solid fa-calendar-check"></i> Book a Demo
            </a>
            <a class="pm-btn pm-btn-outline-hero pm-btn-lg" href="#demos">
              <i class="fa-solid fa-play"></i> Explore the Platform
            </a>
          </div>
          <div class="pm-hero-proof">
            <div class="pm-proof-dots">
              <span style="background:#1549FF"><i class="fa-solid fa-store"></i></span>
              <span style="background:#00CFFF"><i class="fa-solid fa-credit-card"></i></span>
              <span style="background:#00E5A0"><i class="fa-solid fa-file-signature"></i></span>
            </div>
            <span>Trusted by <strong>thousands</strong> of merchants nationwide</span>
          </div>
        </div>

        <div class="pm-hero-visual">
          <div class="pm-dash">
            <div class="pm-dash-bar">
              <span class="pm-dash-dot" style="background:#ff5f57"></span>
              <span class="pm-dash-dot" style="background:#febc2e"></span>
              <span class="pm-dash-dot" style="background:#28c840"></span>
              <span class="pm-dash-title">PPD Merchant Center</span>
            </div>
            <div class="pm-dash-body">
              <div class="pm-dash-sidebar">
                <div class="pm-dash-nav active"><i class="fa-solid fa-gauge-high"></i></div>
                <div class="pm-dash-nav"><i class="fa-solid fa-credit-card"></i></div>
                <div class="pm-dash-nav"><i class="fa-solid fa-users"></i></div>
                <div class="pm-dash-nav"><i class="fa-solid fa-file-invoice"></i></div>
                <div class="pm-dash-nav"><i class="fa-solid fa-gear"></i></div>
              </div>
              <div class="pm-dash-main">
                <div class="pm-dash-stats">
                  <div class="pm-dash-stat">
                    <span class="pm-dash-stat-label">Total Volume</span>
                    <span class="pm-dash-stat-value">$84,291</span>
                    <span class="pm-dash-stat-change"><i class="fa-solid fa-arrow-up"></i> 18.2%</span>
                  </div>
                  <div class="pm-dash-stat">
                    <span class="pm-dash-stat-label">Transactions</span>
                    <span class="pm-dash-stat-value">1,284</span>
                    <span class="pm-dash-stat-change"><i class="fa-solid fa-arrow-up"></i> 12.6%</span>
                  </div>
                  <div class="pm-dash-stat">
                    <span class="pm-dash-stat-label">Approval Rate</span>
                    <span class="pm-dash-stat-value">97.8%</span>
                    <span class="pm-dash-stat-change"><i class="fa-solid fa-arrow-up"></i> 0.4%</span>
                  </div>
                </div>
                <div class="pm-dash-row">
                  <div class="pm-dash-chart">
                    <div class="pm-dash-chart-label">7-Day Volume</div>
                    <svg viewBox="0 0 260 50" preserveAspectRatio="none" class="pm-chart-svg">
                      <defs>
                        <linearGradient id="pmGrad" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stop-color="rgba(21,73,255,.35)"/>
                          <stop offset="100%" stop-color="rgba(21,73,255,0)"/>
                        </linearGradient>
                      </defs>
                      <path d="M0 45 Q30 38 60 32 T120 22 T180 18 T240 12 T260 8 V50 H0 Z" fill="url(#pmGrad)"/>
                      <path d="M0 45 Q30 38 60 32 T120 22 T180 18 T240 12 T260 8" fill="none" stroke="#1549FF" stroke-width="2"/>
                    </svg>
                  </div>
                  <div class="pm-dash-ops">
                    <div class="pm-dash-ops-head">Operational</div>
                    <div class="pm-dash-ops-item"><span class="pm-dot green"></span> 4 open invoices — $2,180</div>
                    <div class="pm-dash-ops-item"><span class="pm-dot yellow"></span> 2 pending ACH</div>
                    <div class="pm-dash-ops-item"><span class="pm-dot green"></span> 12 active contracts</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pm-section pm-value" id="value">
      <div class="container">
        <div class="pm-section-head-center">
          <span class="pm-chip"><i class="fa-solid fa-bullseye"></i> Who It's For</span>
          <h2>Built for Businesses That Need More Than a Gateway</h2>
          <p class="pm-sub">Whether you take keyed transactions, send online invoices, manage recurring billing, or run a sales team — PPD Merchant gives you one platform instead of five disconnected tools.</p>
        </div>
        <div class="pm-value-grid">
          <div class="pm-value-card">
            <div class="pm-value-icon"><i class="fa-solid fa-keyboard"></i></div>
            <h3>Keyed &amp; Online Payments</h3>
            <p>Process card-not-present transactions, send payment links, and accept payments through your custom portal.</p>
          </div>
          <div class="pm-value-card">
            <div class="pm-value-icon"><i class="fa-solid fa-building-columns"></i></div>
            <h3>ACH &amp; Recurring Billing</h3>
            <p>Automate ACH debits, manage subscription contracts, track billing runs, and handle failed payment recovery.</p>
          </div>
          <div class="pm-value-card">
            <div class="pm-value-icon"><i class="fa-solid fa-users-gear"></i></div>
            <h3>Customer &amp; Agent CRM</h3>
            <p>Manage customer records, track sales agent performance, assign account ownership, and enable portal access.</p>
          </div>
          <div class="pm-value-card">
            <div class="pm-value-icon"><i class="fa-solid fa-cart-shopping"></i></div>
            <h3>Shop &amp; Order Management</h3>
            <p>Track orders from your online store, manage fulfillment, assign serial numbers, and process order payments.</p>
          </div>
          <div class="pm-value-card">
            <div class="pm-value-icon"><i class="fa-solid fa-file-signature"></i></div>
            <h3>Agreements &amp; E-Sign</h3>
            <p>Create, send, and track digital agreements for signature — built-in DocuSign-style workflows, no third-party tools.</p>
          </div>
          <div class="pm-value-card">
            <div class="pm-value-icon"><i class="fa-solid fa-microchip"></i></div>
            <h3>Device Connectivity via SPIn</h3>
            <p>Connect terminals and POS devices through SPIn integration for flexible in-person and hybrid payment flows.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="pm-section pm-demos-section" id="demos">
      <div class="container">
        <div class="pm-section-head-center">
          <span class="pm-chip-light"><i class="fa-solid fa-desktop"></i> Platform Modules</span>
          <h2>See Inside the Platform</h2>
          <p class="pm-sub-light">Interactive previews of the core modules inside PPD Merchant. Every tab shows real product capabilities.</p>
        </div>

        <div class="pm-demo-tabs" role="tablist" aria-label="Platform modules">
          <button class="pm-demo-tab active" role="tab" aria-selected="true" aria-controls="pm-tab-dash" data-tab="pm-tab-dash" tabindex="0">
            <i class="fa-solid fa-gauge-high"></i><span>Dashboard</span>
          </button>
          <button class="pm-demo-tab" role="tab" aria-selected="false" aria-controls="pm-tab-orders" data-tab="pm-tab-orders" tabindex="-1">
            <i class="fa-solid fa-cart-shopping"></i><span>Shop Orders</span>
          </button>
          <button class="pm-demo-tab" role="tab" aria-selected="false" aria-controls="pm-tab-recurring" data-tab="pm-tab-recurring" tabindex="-1">
            <i class="fa-solid fa-arrows-spin"></i><span>Recurring</span>
          </button>
          <button class="pm-demo-tab" role="tab" aria-selected="false" aria-controls="pm-tab-crm" data-tab="pm-tab-crm" tabindex="-1">
            <i class="fa-solid fa-users"></i><span>Customers &amp; Agents</span>
          </button>
          <button class="pm-demo-tab" role="tab" aria-selected="false" aria-controls="pm-tab-agreements" data-tab="pm-tab-agreements" tabindex="-1">
            <i class="fa-solid fa-file-signature"></i><span>Agreements</span>
          </button>
        </div>

        <div class="pm-demo-viewport">

          <div class="pm-demo-panel active" id="pm-tab-dash" role="tabpanel" aria-labelledby="pm-tab-dash-tab">
            <div class="pm-demo-chrome">
              <div class="pm-demo-topbar">
                <div class="pm-demo-topbar-left"><i class="fa-solid fa-gauge-high"></i> Dashboard <span class="pm-demo-badge-period">Last 7 days</span></div>
                <div class="pm-demo-topbar-right">
                  <button class="pm-demo-action-btn"><i class="fa-solid fa-bolt"></i> Take Payment</button>
                  <button class="pm-demo-action-btn outline"><i class="fa-solid fa-file-invoice"></i> Send Invoice</button>
                </div>
              </div>
              <div class="pm-demo-content">
                <div class="pm-demo-kpi-row">
                  <div class="pm-demo-kpi">
                    <div class="pm-demo-kpi-icon blue"><i class="fa-solid fa-dollar-sign"></i></div>
                    <div><span class="pm-demo-kpi-label">Total Volume</span><strong>$84,291</strong><span class="pm-demo-kpi-trend up"><i class="fa-solid fa-arrow-up"></i> 18.2%</span></div>
                  </div>
                  <div class="pm-demo-kpi">
                    <div class="pm-demo-kpi-icon cyan"><i class="fa-solid fa-credit-card"></i></div>
                    <div><span class="pm-demo-kpi-label">Transactions</span><strong>1,284</strong><span class="pm-demo-kpi-trend up"><i class="fa-solid fa-arrow-up"></i> 12.6%</span></div>
                  </div>
                  <div class="pm-demo-kpi">
                    <div class="pm-demo-kpi-icon green"><i class="fa-solid fa-chart-line"></i></div>
                    <div><span class="pm-demo-kpi-label">Approval Rate</span><strong>97.8%</strong><span class="pm-demo-kpi-trend up"><i class="fa-solid fa-arrow-up"></i> 0.4%</span></div>
                  </div>
                  <div class="pm-demo-kpi">
                    <div class="pm-demo-kpi-icon purple"><i class="fa-solid fa-users"></i></div>
                    <div><span class="pm-demo-kpi-label">Customers</span><strong>342</strong><span class="pm-demo-kpi-trend up"><i class="fa-solid fa-arrow-up"></i> 8%</span></div>
                  </div>
                </div>
                <div class="pm-demo-split">
                  <div class="pm-demo-chart-box">
                    <div class="pm-demo-chart-head">Transaction Volume</div>
                    <svg viewBox="0 0 320 70" preserveAspectRatio="none" class="pm-demo-chart-svg">
                      <defs><linearGradient id="pmDemoGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="rgba(21,73,255,.3)"/><stop offset="100%" stop-color="rgba(21,73,255,0)"/></linearGradient></defs>
                      <path d="M0 60 Q40 50 80 42 T160 28 T240 18 T320 8 V70 H0 Z" fill="url(#pmDemoGrad)"/>
                      <path d="M0 60 Q40 50 80 42 T160 28 T240 18 T320 8" fill="none" stroke="#1549FF" stroke-width="2"/>
                    </svg>
                  </div>
                  <div class="pm-demo-ops-box">
                    <div class="pm-demo-chart-head">Operational Snapshot</div>
                    <div class="pm-demo-ops-items">
                      <div class="pm-demo-ops-row"><div class="pm-demo-ops-icon blue"><i class="fa-solid fa-file-invoice"></i></div><div><span class="pm-demo-ops-label">Open Invoices</span><strong>4</strong><span class="pm-demo-ops-sub">$2,180.00</span></div></div>
                      <div class="pm-demo-ops-row"><div class="pm-demo-ops-icon red"><i class="fa-solid fa-xmark"></i></div><div><span class="pm-demo-ops-label">Failed Payments</span><strong>1</strong></div></div>
                      <div class="pm-demo-ops-row"><div class="pm-demo-ops-icon yellow"><i class="fa-solid fa-clock"></i></div><div><span class="pm-demo-ops-label">Pending ACH</span><strong>2</strong></div></div>
                      <div class="pm-demo-ops-row"><div class="pm-demo-ops-icon green"><i class="fa-solid fa-arrows-spin"></i></div><div><span class="pm-demo-ops-label">Active Contracts</span><strong>12</strong></div></div>
                    </div>
                  </div>
                </div>
                <div class="pm-demo-table">
                  <div class="pm-demo-table-head"><span>Customer</span><span>Amount</span><span>Method</span><span>Status</span><span>Source</span></div>
                  <div class="pm-demo-table-row"><span>Elite Fitness Co.</span><span>$189.00</span><span>Visa •••• 4242</span><span class="pm-badge green">Approved</span><span class="pm-source"><i class="fa-solid fa-bolt"></i> Quick Pay</span></div>
                  <div class="pm-demo-table-row"><span>QuickBite LLC</span><span>$67.50</span><span>MC •••• 8831</span><span class="pm-badge green">Settled</span><span class="pm-source"><i class="fa-solid fa-file-invoice"></i> Invoice</span></div>
                  <div class="pm-demo-table-row"><span>Bella Salon Group</span><span>$342.00</span><span>ACH •••• 6712</span><span class="pm-badge yellow">Pending</span><span class="pm-source"><i class="fa-solid fa-arrows-spin"></i> Recurring</span></div>
                  <div class="pm-demo-table-row"><span>Metro Dental</span><span>$1,200.00</span><span>Amex •••• 1009</span><span class="pm-badge green">Approved</span><span class="pm-source"><i class="fa-solid fa-cart-shopping"></i> Order</span></div>
                </div>
              </div>
            </div>
          </div>

          <div class="pm-demo-panel" id="pm-tab-orders" role="tabpanel" aria-labelledby="pm-tab-orders-tab">
            <div class="pm-demo-chrome">
              <div class="pm-demo-topbar">
                <div class="pm-demo-topbar-left"><i class="fa-solid fa-cart-shopping"></i> Shop Orders</div>
                <div class="pm-demo-topbar-right">
                  <div class="pm-demo-search"><i class="fa-solid fa-search"></i> Search orders...</div>
                </div>
              </div>
              <div class="pm-demo-content">
                <div class="pm-demo-kpi-row">
                  <div class="pm-demo-kpi"><div class="pm-demo-kpi-icon blue"><i class="fa-solid fa-shopping-bag"></i></div><div><span class="pm-demo-kpi-label">Total Orders</span><strong>89</strong></div></div>
                  <div class="pm-demo-kpi"><div class="pm-demo-kpi-icon yellow"><i class="fa-solid fa-clock"></i></div><div><span class="pm-demo-kpi-label">Pending</span><strong>12</strong></div></div>
                  <div class="pm-demo-kpi"><div class="pm-demo-kpi-icon green"><i class="fa-solid fa-check"></i></div><div><span class="pm-demo-kpi-label">Completed</span><strong>74</strong></div></div>
                  <div class="pm-demo-kpi"><div class="pm-demo-kpi-icon cyan"><i class="fa-solid fa-dollar-sign"></i></div><div><span class="pm-demo-kpi-label">Revenue</span><strong>$14,280</strong></div></div>
                </div>
                <div class="pm-demo-table">
                  <div class="pm-demo-table-head"><span>Order #</span><span>Customer</span><span>Source</span><span>Status</span><span>Total</span></div>
                  <div class="pm-demo-table-row"><span>#ORD-1089</span><span>Sarah Chen</span><span class="pm-source"><i class="fa-solid fa-store"></i> Customer Portal</span><span class="pm-badge yellow">Pending</span><span>$285.00</span></div>
                  <div class="pm-demo-table-row"><span>#ORD-1088</span><span>Marcus Thompson</span><span class="pm-source"><i class="fa-solid fa-user-tie"></i> Agent Portal</span><span class="pm-badge green">Completed</span><span>$142.50</span></div>
                  <div class="pm-demo-table-row"><span>#ORD-1087</span><span>Bella Salon Group</span><span class="pm-source"><i class="fa-solid fa-cash-register"></i> POS</span><span class="pm-badge green">Completed</span><span>$520.00</span></div>
                  <div class="pm-demo-table-row"><span>#ORD-1086</span><span>Ana Rivera</span><span class="pm-source"><i class="fa-solid fa-store"></i> Customer Portal</span><span class="pm-badge green">Completed</span><span>$89.99</span></div>
                  <div class="pm-demo-table-row"><span>#ORD-1085</span><span>David Kim</span><span class="pm-source"><i class="fa-solid fa-user-tie"></i> Agent Portal</span><span class="pm-badge yellow">Pending</span><span>$375.00</span></div>
                </div>
              </div>
            </div>
          </div>

          <div class="pm-demo-panel" id="pm-tab-recurring" role="tabpanel" aria-labelledby="pm-tab-recurring-tab">
            <div class="pm-demo-chrome">
              <div class="pm-demo-topbar">
                <div class="pm-demo-topbar-left"><i class="fa-solid fa-arrows-spin"></i> Recurring Billing</div>
                <div class="pm-demo-topbar-right">
                  <button class="pm-demo-action-btn"><i class="fa-solid fa-plus"></i> New Contract</button>
                </div>
              </div>
              <div class="pm-demo-content">
                <div class="pm-demo-kpi-row">
                  <div class="pm-demo-kpi"><div class="pm-demo-kpi-icon green"><i class="fa-solid fa-check-circle"></i></div><div><span class="pm-demo-kpi-label">Active</span><strong>12</strong></div></div>
                  <div class="pm-demo-kpi"><div class="pm-demo-kpi-icon yellow"><i class="fa-solid fa-pause"></i></div><div><span class="pm-demo-kpi-label">Paused</span><strong>2</strong></div></div>
                  <div class="pm-demo-kpi"><div class="pm-demo-kpi-icon red"><i class="fa-solid fa-triangle-exclamation"></i></div><div><span class="pm-demo-kpi-label">Failed</span><strong>1</strong></div></div>
                  <div class="pm-demo-kpi"><div class="pm-demo-kpi-icon blue"><i class="fa-solid fa-dollar-sign"></i></div><div><span class="pm-demo-kpi-label">MRR</span><strong>$4,820</strong></div></div>
                </div>
                <div class="pm-demo-table">
                  <div class="pm-demo-table-head"><span>Contract</span><span>Customer</span><span>Amount</span><span>Frequency</span><span>Status</span></div>
                  <div class="pm-demo-table-row"><span>Gym Membership</span><span>Elite Fitness Co.</span><span>$149/mo</span><span>Monthly</span><span class="pm-badge green">Active</span></div>
                  <div class="pm-demo-table-row"><span>Software License</span><span>Metro Dental</span><span>$299/mo</span><span>Monthly</span><span class="pm-badge green">Active</span></div>
                  <div class="pm-demo-table-row"><span>Cleaning Service</span><span>QuickBite LLC</span><span>$450/mo</span><span>Monthly</span><span class="pm-badge yellow">Paused</span></div>
                  <div class="pm-demo-table-row"><span>Maintenance Plan</span><span>FastLane Auto</span><span>$89/mo</span><span>Monthly</span><span class="pm-badge red">Failed</span></div>
                  <div class="pm-demo-table-row"><span>Consulting Retainer</span><span>Nails by Nova</span><span>$2,500/qtr</span><span>Quarterly</span><span class="pm-badge green">Active</span></div>
                </div>
              </div>
            </div>
          </div>

          <div class="pm-demo-panel" id="pm-tab-crm" role="tabpanel" aria-labelledby="pm-tab-crm-tab">
            <div class="pm-demo-chrome">
              <div class="pm-demo-topbar">
                <div class="pm-demo-topbar-left"><i class="fa-solid fa-users"></i> Customers &amp; Sales Agents</div>
                <div class="pm-demo-topbar-right">
                  <button class="pm-demo-action-btn"><i class="fa-solid fa-user-plus"></i> Add Customer</button>
                </div>
              </div>
              <div class="pm-demo-content">
                <div class="pm-demo-crm-toggle" role="tablist" aria-label="CRM views">
                  <button class="pm-crm-tab active" role="tab" aria-selected="true" aria-controls="pm-crm-customers" data-crmtab="customers" tabindex="0"><i class="fa-solid fa-users"></i> Customers</button>
                  <button class="pm-crm-tab" role="tab" aria-selected="false" aria-controls="pm-crm-agents" data-crmtab="agents" tabindex="-1"><i class="fa-solid fa-user-tie"></i> Sales Agents</button>
                </div>
                <div class="pm-crm-panel active" id="pm-crm-customers" role="tabpanel">
                  <div class="pm-demo-table">
                    <div class="pm-demo-table-head"><span>Customer</span><span>Company</span><span>Email</span><span>Agent</span><span>Portal</span></div>
                    <div class="pm-demo-table-row"><span><i class="fa-solid fa-circle-user"></i> Sarah Chen</span><span>Chen Wellness</span><span>sarah@chen.co</span><span>Marcus T.</span><span class="pm-badge green">Active</span></div>
                    <div class="pm-demo-table-row"><span><i class="fa-solid fa-circle-user"></i> David Kim</span><span>Kim & Associates</span><span>david@kim.law</span><span>Ana R.</span><span class="pm-badge green">Active</span></div>
                    <div class="pm-demo-table-row"><span><i class="fa-solid fa-circle-user"></i> Emily Rodriguez</span><span>ER Design Studio</span><span>emily@erdesign.co</span><span>—</span><span class="pm-badge gray">Invited</span></div>
                    <div class="pm-demo-table-row"><span><i class="fa-solid fa-circle-user"></i> James Park</span><span>Park Automotive</span><span>james@parkauto.com</span><span>Marcus T.</span><span class="pm-badge gray">None</span></div>
                  </div>
                </div>
                <div class="pm-crm-panel" id="pm-crm-agents" role="tabpanel">
                  <div class="pm-demo-table">
                    <div class="pm-demo-table-head"><span>Agent</span><span>Company</span><span>Contact</span><span>Portal</span><span>Status</span></div>
                    <div class="pm-demo-table-row"><span><i class="fa-solid fa-user-tie"></i> Marcus Thompson</span><span>Elite Sales Group</span><span>marcus@esg.com</span><span class="pm-badge green">Active</span><span class="pm-badge green">Active</span></div>
                    <div class="pm-demo-table-row"><span><i class="fa-solid fa-user-tie"></i> Ana Rivera</span><span>Rivera Partners</span><span>ana@rivera.co</span><span class="pm-badge green">Active</span><span class="pm-badge green">Active</span></div>
                    <div class="pm-demo-table-row"><span><i class="fa-solid fa-user-tie"></i> David Kim</span><span>DK Consulting</span><span>dk@dkconsult.com</span><span class="pm-badge gray">None</span><span class="pm-badge green">Active</span></div>
                    <div class="pm-demo-table-row"><span><i class="fa-solid fa-user-tie"></i> Lisa Chang</span><span>—</span><span>lisa@payments.io</span><span class="pm-badge gray">None</span><span class="pm-badge gray">Inactive</span></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="pm-demo-panel" id="pm-tab-agreements" role="tabpanel" aria-labelledby="pm-tab-agreements-tab">
            <div class="pm-demo-chrome">
              <div class="pm-demo-topbar">
                <div class="pm-demo-topbar-left"><i class="fa-solid fa-file-signature"></i> Agreements &amp; E-Sign</div>
                <div class="pm-demo-topbar-right">
                  <button class="pm-demo-action-btn"><i class="fa-solid fa-plus"></i> New Agreement</button>
                </div>
              </div>
              <div class="pm-demo-content">
