      --pp-container:1140px;
      background:var(--pp-surface);
      color:var(--pp-text);
    }
    .partner-page *{box-sizing:border-box}
    .partner-page a{color:inherit;text-decoration:none}
    .pp-container{max-width:var(--pp-container);margin-left:auto;margin-right:auto;padding-left:24px;padding-right:24px}
    .pp-section{padding:80px 0}
    .pp-section-tight{padding:56px 0}
    .pp-section-alt{background:#fff;border-top:1px solid var(--pp-border);border-bottom:1px solid var(--pp-border)}
    .pp-section-dark{
      background:linear-gradient(135deg,var(--pp-navy) 0%,#0A2B74 55%,var(--pp-primary-dark) 100%);
      color:#fff;
    }
    .pp-section-head{display:flex;flex-direction:column;gap:10px;max-width:680px}
    .pp-section-head h2{
      font-size:clamp(26px,3vw,38px);line-height:1.15;letter-spacing:-.02em;
    }
    .pp-section-dark .pp-section-head h2{color:#fff}
    .pp-sub{color:var(--pp-muted);font-size:clamp(15px,1.2vw,17px);max-width:60ch}
    .pp-sub-light{color:rgba(255,255,255,.8);font-size:clamp(15px,1.2vw,17px);max-width:60ch}

    .pp-eyebrow{
      display:inline-flex;align-items:center;gap:8px;width:fit-content;
      font-weight:700;font-size:13px;letter-spacing:.1em;text-transform:uppercase;
      color:rgba(255,255,255,.9);background:rgba(255,255,255,.12);
      border:1px solid rgba(255,255,255,.18);padding:8px 14px;border-radius:999px;
      backdrop-filter:blur(10px);
    }
    .pp-eyebrow-fit{width:fit-content}
    .pp-chip{
      display:inline-flex;align-items:center;gap:8px;width:fit-content;
      font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase;
      color:var(--pp-navy);background:rgba(21,73,255,.08);
      border:1px solid rgba(21,73,255,.12);padding:8px 14px;border-radius:999px;
    }

    .pp-btn{
      display:inline-flex;align-items:center;justify-content:center;gap:8px;
      padding:12px 20px;border-radius:999px;font-weight:700;font-size:14px;
      border:1px solid transparent;cursor:pointer;white-space:nowrap;
      transition:transform .2s,box-shadow .2s,background .2s,border-color .2s;
    }
    .pp-btn:active{transform:translateY(1px)}
    .pp-btn-primary{
      background:linear-gradient(135deg,#2D60FF,var(--pp-primary));color:#fff;
      box-shadow:0 8px 28px rgba(21,73,255,.35);
    }
    .pp-btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 32px rgba(21,73,255,.45)}
    .pp-btn-outline{background:transparent;border-color:rgba(255,255,255,.35);color:#fff}
    .pp-btn-outline:hover{background:rgba(255,255,255,.1);transform:translateY(-2px)}
    .pp-btn-ghost{background:transparent;border-color:var(--pp-border);color:var(--pp-navy)}
    .pp-btn-ghost:hover{background:#fff;transform:translateY(-2px);box-shadow:var(--pp-shadow)}
    .pp-full{width:100%}

    .pp-hero{
      background:
        radial-gradient(900px 480px at 15% 10%,rgba(0,204,150,.15),transparent 55%),
        radial-gradient(760px 420px at 85% 15%,rgba(21,73,255,.25),transparent 55%),
        linear-gradient(135deg,var(--pp-navy) 0%,#0A2B74 55%,var(--pp-primary-dark) 100%);
      color:#fff;padding:80px 0 64px;position:relative;overflow:hidden;
    }
    .pp-hero::after{
      content:"";position:absolute;inset:auto -20% -60% -20%;height:520px;border-radius:50%;
      background:radial-gradient(circle,rgba(255,255,255,.08),transparent 60%);
      transform:rotate(-8deg);pointer-events:none;
    }
    .pp-hero-grid{
      display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:center;
      position:relative;z-index:2;
    }
    .pp-hero h1{
      font-size:clamp(32px,4vw,52px);line-height:1.08;letter-spacing:-.03em;margin:16px 0 12px;
    }
    .pp-hero-ctas{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
    .pp-trust-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}
    .pp-trust-pill{
      padding:8px 12px;border-radius:999px;border:1px solid rgba(255,255,255,.18);
      background:rgba(255,255,255,.06);font-weight:700;font-size:12px;
      display:inline-flex;align-items:center;gap:7px;
    }

    .pp-dashboard{
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);
      border-radius:20px;overflow:hidden;backdrop-filter:blur(10px);
    }
    .pp-dash-header{
      display:flex;align-items:center;gap:10px;padding:12px 16px;
      border-bottom:1px solid rgba(255,255,255,.1);
    }
    .pp-dash-dots{display:flex;gap:5px}
    .pp-dash-dots span{width:8px;height:8px;border-radius:50%}
    .pp-dash-dots span:nth-child(1){background:#FF5F57}
    .pp-dash-dots span:nth-child(2){background:#FEBC2E}
    .pp-dash-dots span:nth-child(3){background:#28C840}
    .pp-dash-title{font-weight:700;font-size:13px;color:rgba(255,255,255,.7)}
    .pp-dash-body{padding:16px;display:flex;flex-direction:column;gap:12px}
    .pp-dash-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .pp-dash-stat{
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
      border-radius:12px;padding:14px;
    }
    .pp-dash-label{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.5);font-weight:600}
    .pp-dash-value{font-size:22px;font-weight:900;margin:4px 0 2px;letter-spacing:-.02em}
    .pp-dash-change{font-size:12px;font-weight:700;display:flex;align-items:center;gap:4px}
    .pp-dash-change.positive{color:var(--pp-accent)}
    .pp-dash-bar{
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
      border-radius:12px;padding:14px;
    }
    .pp-dash-bar-label{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.5);font-weight:600;margin-bottom:8px}
    .pp-dash-bar-track{height:8px;border-radius:99px;background:rgba(255,255,255,.1)}
    .pp-dash-bar-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--pp-primary),var(--pp-cyan))}

    .pp-switch-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:32px}
    .pp-switch-card{
      background:#fff;border:1px solid var(--pp-border);border-radius:var(--pp-radius);
      padding:28px;box-shadow:var(--pp-shadow);transition:transform .2s,box-shadow .2s;
    }
    .pp-switch-card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(2,6,23,.12)}
    .pp-switch-icon{
      width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;
      background:rgba(21,73,255,.08);border:1px solid rgba(21,73,255,.12);color:var(--pp-primary);font-size:18px;margin-bottom:16px;
    }
    .pp-switch-card h3{font-size:17px;font-weight:800;margin-bottom:6px;letter-spacing:-.01em}
    .pp-switch-card p{font-size:14px;color:var(--pp-muted);line-height:1.6}
    .pp-switch-cta{
      display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap;
      margin-top:28px;padding:20px 24px;border-radius:var(--pp-radius);
      background:rgba(21,73,255,.04);border:1px solid rgba(21,73,255,.1);
    }
    .pp-switch-cta p{font-size:14px;color:var(--pp-muted);font-weight:600;margin:0}

    .pp-value-grid{
      display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:32px;
    }
    .pp-value-card{
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
      border-radius:var(--pp-radius);padding:24px;
      transition:transform .2s,border-color .2s;
    }
    .pp-value-card:hover{transform:translateY(-4px);border-color:rgba(255,255,255,.2)}
    .pp-value-icon{
      width:44px;height:44px;border-radius:12px;margin-bottom:14px;
      background:rgba(21,73,255,.2);border:1px solid rgba(21,73,255,.3);
      display:flex;align-items:center;justify-content:center;font-size:18px;color:var(--pp-cyan);
    }
    .pp-value-card h3{font-size:16px;font-weight:800;margin-bottom:6px}
    .pp-value-card p{color:rgba(255,255,255,.65);font-size:14px;line-height:1.5}

    /* What makes PPD different — software split */
    .pp-diff-split{
      display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center;margin-top:36px;
    }
    .pp-diff-headline{display:flex;align-items:flex-start;gap:14px;margin-bottom:18px}
    .pp-diff-headline-icon{
      flex-shrink:0;width:48px;height:48px;border-radius:14px;
      background:linear-gradient(135deg,var(--pp-primary),var(--pp-cyan));
      display:flex;align-items:center;justify-content:center;font-size:20px;color:#fff;
      box-shadow:0 8px 24px rgba(21,73,255,.35);
    }
    .pp-diff-headline h3{font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.2;letter-spacing:-.02em;color:#fff}
    .pp-diff-body{color:rgba(255,255,255,.72);font-size:15px;line-height:1.7;margin-bottom:14px}
    .pp-diff-cta{display:flex;flex-direction:column;gap:12px;margin-top:24px}
    .pp-diff-cta .pp-btn{width:fit-content}
    .pp-diff-cta-note{color:rgba(255,255,255,.55);font-size:13px;font-weight:600;max-width:46ch}

    .pp-diff-mock{
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);
      border-radius:20px;overflow:hidden;backdrop-filter:blur(10px);
      box-shadow:0 30px 60px rgba(2,6,23,.35);
