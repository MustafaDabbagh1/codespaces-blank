---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Agents & ISOs Partner Program | PPD Technology" description="Join PPD Technology's partner program for agents and ISOs. Competitive revenue share, dedicated support, and a full suite of payment solutions to grow your portfolio.">
  <div class="partner-page">

    <section class="pp-hero">
      <div class="pp-container pp-hero-grid">
        <div class="reveal">
          <span class="pp-eyebrow"><i class="fa-solid fa-handshake"></i> Agents & ISOs</span>
          <h1>Keep your book.<br/>Get a cleaner deal.</h1>
          <p class="pp-sub">
            If you already know payments, you don't need more noise. You need clean reporting, responsive support, and a program you can scale.
          </p>
          <div class="pp-hero-ctas">
            <button class="pp-btn pp-btn-primary" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">
              Book a Quick Compare Call <i class="fa-regular fa-calendar"></i>
            </button>
            <a class="pp-btn pp-btn-outline" href="#partner-kit">
              Download Partner Kit <i class="fa-solid fa-download"></i>
            </a>
          </div>
          <div class="pp-trust-row">
            <span class="pp-trust-pill"><i class="fa-solid fa-bolt"></i> Fast onboarding</span>
            <span class="pp-trust-pill"><i class="fa-solid fa-chart-line"></i> Transparent reporting</span>
            <span class="pp-trust-pill"><i class="fa-solid fa-headset"></i> 24/7 support desk</span>
            <span class="pp-trust-pill"><i class="fa-solid fa-shield-halved"></i> Risk-aware underwriting</span>
          </div>
        </div>

        <div class="pp-dashboard reveal" aria-label="Partner program preview">
          <div class="pp-dash-header">
            <div class="pp-dash-dots"><span></span><span></span><span></span></div>
            <span class="pp-dash-title">Partner Dashboard</span>
          </div>
          <div class="pp-dash-body">
            <div class="pp-dash-row">
              <div class="pp-dash-stat">
                <div class="pp-dash-label">Active Merchants</div>
                <div class="pp-dash-value">127</div>
                <div class="pp-dash-change positive"><i class="fa-solid fa-arrow-up"></i> 12 this month</div>
              </div>
              <div class="pp-dash-stat">
                <div class="pp-dash-label">Monthly Residuals</div>
                <div class="pp-dash-value">$8,420</div>
                <div class="pp-dash-change positive"><i class="fa-solid fa-arrow-up"></i> 18.2%</div>
              </div>
            </div>
            <div class="pp-dash-row">
              <div class="pp-dash-stat">
                <div class="pp-dash-label">Avg. Approval Time</div>
                <div class="pp-dash-value">1.8 days</div>
                <div class="pp-dash-change positive"><i class="fa-solid fa-arrow-down"></i> Faster</div>
              </div>
              <div class="pp-dash-stat">
                <div class="pp-dash-label">Portfolio Retention</div>
                <div class="pp-dash-value">96.4%</div>
                <div class="pp-dash-change positive"><i class="fa-solid fa-circle-check"></i> Healthy</div>
              </div>
            </div>
            <div class="pp-dash-bar">
              <div class="pp-dash-bar-label">Revenue Growth (6mo)</div>
              <div class="pp-dash-bar-track">
                <div class="pp-dash-bar-fill" style="width:72%"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section" id="compare">
      <div class="pp-container">
        <div class="pp-section-head reveal">
          <span class="pp-chip"><i class="fa-solid fa-arrow-right-arrow-left"></i> Why PPD</span>
          <h2>Why partners switch to PPD</h2>
          <p class="pp-sub">
            The things that actually matter when you're evaluating a new program.
          </p>
        </div>

        <div class="pp-switch-grid reveal">
          <div class="pp-switch-card">
            <div class="pp-switch-icon"><i class="fa-solid fa-file-lines"></i></div>
            <h3>Cleaner Statements</h3>
            <p>Reporting you can actually reconcile. No hidden fees buried in confusing line items — just clear numbers that match what you were told.</p>
          </div>
          <div class="pp-switch-card">
            <div class="pp-switch-icon"><i class="fa-solid fa-phone"></i></div>
            <h3>Support That Picks Up</h3>
            <p>Real people on a real support desk. When your merchant has an issue, you get answers — not a ticket number and silence.</p>
          </div>
          <div class="pp-switch-card">
            <div class="pp-switch-icon"><i class="fa-solid fa-clock"></i></div>
            <h3>Faster Underwriting</h3>
            <p>Visible steps, clear next actions, and approvals that move in days. You'll always know where an app stands without chasing updates.</p>
          </div>
          <div class="pp-switch-card">
            <div class="pp-switch-icon"><i class="fa-solid fa-suitcase"></i></div>
            <h3>Your Book Is Always Yours</h3>
            <p>Yes, your book is always yours. Full stop. No vague language, no surprises down the line, no wondering what happens if you leave.</p>
          </div>
        </div>

        <div class="pp-switch-cta reveal">
          <p>Bring your current deal sheet (redacted is fine) and we'll walk through it with you.</p>
          <button class="pp-btn pp-btn-primary" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">
            Book a Compare Call <i class="fa-regular fa-calendar"></i>
          </button>
        </div>
      </div>
    </section>

    <section class="pp-section pp-section-dark" id="why-switch">
      <div class="pp-container">
        <div class="pp-section-head reveal">
          <span class="pp-eyebrow"><i class="fa-solid fa-arrow-right-arrow-left"></i> Why Partners Switch</span>
          <h2>What makes PPD different</h2>
          <p class="pp-sub-light">
            One program. No overlap. Here's what partners actually care about.
          </p>
        </div>

        <div class="pp-value-grid reveal">
          <div class="pp-value-card">
            <div class="pp-value-icon"><i class="fa-solid fa-handshake"></i></div>
            <h3>Your Book Is Yours</h3>
            <p>Your book is always yours. Clear terms, no fine print, no ambiguity about ownership.</p>
          </div>
          <div class="pp-value-card">
            <div class="pp-value-icon"><i class="fa-solid fa-chart-line"></i></div>
            <h3>Transparent Reporting</h3>
            <p>Clean statements and partner reporting you can actually reconcile.</p>
          </div>
          <div class="pp-value-card">
            <div class="pp-value-icon"><i class="fa-solid fa-gauge-high"></i></div>
            <h3>Fast Underwriting</h3>
            <p>Risk-aware approvals with visible next steps. Fewer stalls, fewer surprises.</p>
          </div>
          <div class="pp-value-card">
            <div class="pp-value-icon"><i class="fa-solid fa-headset"></i></div>
            <h3>Real Support Desk</h3>
            <p>24/7 ISO desk with structured case handling and defined escalation paths.</p>
          </div>
          <div class="pp-value-card">
            <div class="pp-value-icon"><i class="fa-solid fa-sliders"></i></div>
            <h3>Flexible Solutions</h3>
            <p>In-store, online, mobile. POS, terminals, gateways. Build the right stack per merchant.</p>
          </div>
          <div class="pp-value-card">
            <div class="pp-value-icon"><i class="fa-solid fa-money-check-dollar"></i></div>
            <h3>Monthly Residuals</h3>
            <p>Recurring income on active accounts with clear payout timing and no hard caps.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section" id="tiers">
      <div class="pp-container">
        <div class="pp-section-head reveal">
          <span class="pp-chip"><i class="fa-solid fa-handshake-simple"></i> Ways to Partner</span>
          <h2>Find the right fit for how you work</h2>
          <p class="pp-sub">Whether you send a few referrals or manage a full book, there's a partnership model that matches your business. No fees, no buy-in — just different levels of involvement and support.</p>
        </div>

        <div class="pp-tiers reveal">
          <div class="pp-tier">
            <div class="pp-tier-head">
              <div>
                <div class="pp-tier-name">Referral Partner</div>
                <div class="pp-tier-desc">Send leads, earn commissions</div>
              </div>
            </div>
            <div class="pp-tier-body">
              <p class="pp-tier-summary">You know someone who needs processing. You make an introduction, we handle the rest. Simple and low-touch.</p>
              <ul>
                <li><i class="fa-solid fa-check pp-good"></i> Per-deal referral commissions</li>
                <li><i class="fa-solid fa-check pp-good"></i> Marketing materials provided</li>
                <li><i class="fa-solid fa-check pp-good"></i> Online training and resources</li>
                <li><i class="fa-solid fa-check pp-good"></i> Dedicated partner contact</li>
              </ul>
              <button class="pp-btn pp-btn-ghost pp-full" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">Learn More</button>
            </div>
          </div>

          <div class="pp-tier pp-tier-featured">
            <div class="pp-tier-head">
              <div>
                <div class="pp-tier-name">Sales Partner</div>
                <div class="pp-tier-desc">Build a book, earn residuals</div>
              </div>
              <div class="pp-tier-badge">Most Common</div>
            </div>
            <div class="pp-tier-body">
              <p class="pp-tier-summary">You're actively selling and managing merchant relationships. You get the tools, leads, and ongoing residual income to grow.</p>
              <ul>
                <li><i class="fa-solid fa-check pp-good"></i> Monthly residual income</li>
                <li><i class="fa-solid fa-check pp-good"></i> Partner CRM and reporting</li>
                <li><i class="fa-solid fa-check pp-good"></i> Co-branded sales materials</li>
                <li><i class="fa-solid fa-check pp-good"></i> Coaching and sales support</li>
                <li><i class="fa-solid fa-check pp-good"></i> Pre-qualified lead access</li>
                <li><i class="fa-solid fa-check pp-good"></i> Priority support line</li>
              </ul>
              <button class="pp-btn pp-btn-primary pp-full" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">Learn More</button>
            </div>
          </div>

          <div class="pp-tier">
            <div class="pp-tier-head">
              <div>
                <div class="pp-tier-name">ISO Partner</div>
                <div class="pp-tier-desc">Full control, max scale</div>
              </div>
            </div>
            <div class="pp-tier-body">
              <p class="pp-tier-summary">You run your own operation with sub-agents and a growing portfolio. You need infrastructure, not hand-holding.</p>
              <ul>
                <li><i class="fa-solid fa-check pp-good"></i> Highest earning structure</li>
                <li><i class="fa-solid fa-check pp-good"></i> Portfolio ownership options</li>
                <li><i class="fa-solid fa-check pp-good"></i> Sub-agent management tools</li>
                <li><i class="fa-solid fa-check pp-good"></i> White-label capabilities</li>
                <li><i class="fa-solid fa-check pp-good"></i> Dedicated ISO support team</li>
                <li><i class="fa-solid fa-check pp-good"></i> Custom onboarding flow</li>
              </ul>
              <button class="pp-btn pp-btn-ghost pp-full" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">Learn More</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section pp-section-alt" id="tools">
      <div class="pp-container">
        <div class="pp-section-head reveal">
          <span class="pp-chip"><i class="fa-solid fa-grid-2"></i> Enablement Platform</span>
          <h2>Tools and support that help you scale</h2>
          <p class="pp-sub">One unified system: CRM, onboarding, training, marketing, and sales support.</p>
        </div>

        <div class="pp-tools-grid reveal">
          <div class="pp-tool-card">
            <i class="fa-solid fa-chart-line"></i>
            <h3>Residuals & Dashboards</h3>
            <p>Track portfolio performance with real-time reporting and clear payout visibility.</p>
          </div>
          <div class="pp-tool-card">
            <i class="fa-solid fa-file-signature"></i>
            <h3>Digital Onboarding</h3>
            <p>Submit apps, upload docs, and keep underwriting moving without email chains.</p>
          </div>
          <div class="pp-tool-card">
            <i class="fa-solid fa-shield-halved"></i>
            <h3>Risk Monitoring</h3>
            <p>Structured workflows and case visibility to protect your portfolio.</p>
          </div>
          <div class="pp-tool-card">
            <i class="fa-solid fa-graduation-cap"></i>
            <h3>Training & Coaching</h3>
            <p>Playbooks, webinars, certification, and one-on-one sales strategy sessions.</p>
          </div>
          <div class="pp-tool-card">
            <i class="fa-solid fa-bullhorn"></i>
            <h3>Marketing Support</h3>
            <p>Co-branded materials and sales-ready assets to help you close with confidence.</p>
          </div>
          <div class="pp-tool-card">
            <i class="fa-solid fa-headset"></i>
            <h3>Merchant Support 360</h3>
            <p>Responsive merchant support so you retain accounts and grow your book.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section" id="testimonials">
      <div class="pp-container">
        <div class="pp-section-head reveal">
          <span class="pp-chip"><i class="fa-solid fa-star"></i> Partner Stories</span>
          <h2>Partners who built momentum with PPD</h2>
        </div>

        <div class="pp-testimonials reveal">
          <div class="pp-quote">
            <div class="pp-quote-body">
              <i class="fa-solid fa-quote-left pp-quote-mark"></i>
              <p>"I was tired of chasing my old processor for answers every time a merchant had an issue. With PPD, I call the support desk and someone actually picks up. That alone made the switch worth it — my merchants stopped complaining and I stopped putting out fires."</p>
            </div>
            <div class="pp-quote-footer">
              <div class="pp-quote-avatar">MJ</div>
              <div>
                <div class="pp-quote-name">Michael J.</div>
                <div class="pp-quote-role">Sales Partner &middot; 3 years</div>
              </div>
            </div>
          </div>
          <div class="pp-quote">
            <div class="pp-quote-body">
              <i class="fa-solid fa-quote-left pp-quote-mark"></i>
              <p>"We moved about 60 accounts over six months. The part that surprised me was underwriting — apps that used to sit for two weeks were getting approved in a couple days. My agents noticed it too. Less follow-up, less hand-holding, more time selling."</p>
            </div>
            <div class="pp-quote-footer">
              <div class="pp-quote-avatar">SR</div>
              <div>
                <div class="pp-quote-name">Sarah R.</div>
                <div class="pp-quote-role">ISO Partner &middot; 5 years</div>
              </div>
            </div>
          </div>
          <div class="pp-quote">
            <div class="pp-quote-body">
              <i class="fa-solid fa-quote-left pp-quote-mark"></i>
              <p>"I'm not a full-time payments guy — I do IT work and my clients always ask who I recommend for processing. I just send them to PPD and get a check when they sign up. It's been a nice side income without having to learn a whole new industry."</p>
            </div>
            <div class="pp-quote-footer">
              <div class="pp-quote-avatar">JP</div>
              <div>
                <div class="pp-quote-name">John P.</div>
                <div class="pp-quote-role">Referral Partner &middot; 1 year</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section pp-section-alt" id="faq">
      <div class="pp-container">
        <div class="pp-section-head reveal">
          <span class="pp-chip"><i class="fa-solid fa-circle-question"></i> FAQ</span>
          <h2>Quick answers for agents & ISOs</h2>
        </div>

        <div class="pp-faq reveal">
          <details>
            <summary>How fast is onboarding? <i class="fa-solid fa-plus"></i></summary>
            <p>Submit apps through the partner workflow with visible underwriting steps. Most approvals move within days, not weeks.</p>
          </details>
          <details>
            <summary>What support do I get? <i class="fa-solid fa-plus"></i></summary>
            <p>24/7 ISO support desk with structured case handling, defined escalation paths, and SLA-backed response expectations.</p>
          </details>
          <details>
            <summary>What business types can I bring? <i class="fa-solid fa-plus"></i></summary>
            <p>Many categories: retail, restaurants, e-commerce, services, and more. We'll help position the right stack based on merchant needs.</p>
          </details>
          <details>
            <summary>How does the compare call work? <i class="fa-solid fa-plus"></i></summary>
            <p>Bring your current deal sheet (redacted is fine) and we'll walk through it with you on a quick call. We'll confirm exact comp based on your volume, vertical, and support needs.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="pp-section" id="partner-kit">
      <div class="pp-container">
        <div class="pp-kit-row reveal">
          <div class="pp-kit-info">
            <span class="pp-chip"><i class="fa-solid fa-toolbox"></i> Partner Kit</span>
            <h2>Download everything you need</h2>
            <p class="pp-sub">A simple kit built for agents and ISOs who want clarity before the call.</p>
          </div>
          <div class="pp-kit-cards">
            <a class="pp-kit-card" href="COMPARE_PDF_URL_HERE" target="_blank" rel="noopener">
              <i class="fa-solid fa-file-signature"></i>
              <div>
                <strong>Quick Compare Sheet</strong>
                <span>Side-by-side comp, support, reporting</span>
              </div>
              <span class="pp-kit-tag">PDF</span>
            </a>
            <a class="pp-kit-card" href="STATEMENT_BREAKDOWN_URL_HERE" target="_blank" rel="noopener">
              <i class="fa-solid fa-receipt"></i>
              <div>
                <strong>Statement Breakdown</strong>
                <span>What matters on statements</span>
              </div>
              <span class="pp-kit-tag">PDF</span>
            </a>
            <a class="pp-kit-card" href="ONBOARDING_CHECKLIST_URL_HERE" target="_blank" rel="noopener">
              <i class="fa-solid fa-list-check"></i>
              <div>
                <strong>Fast Start Checklist</strong>
                <span>Clean apps, faster onboarding</span>
              </div>
              <span class="pp-kit-tag">PDF</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section pp-section-dark pp-section-tight" id="book">
      <div class="pp-container">
        <div class="pp-cta-split reveal">
          <div class="pp-cta-left">
            <h2>Ready to compare?</h2>
            <p class="pp-sub-light">
              Pick a time that works. Bring your current deal sheet (redacted is fine) and we'll compare side-by-side.
            </p>
            <div class="pp-cta-btns">
              <a class="pp-btn pp-btn-primary" href="#partner-form">Apply Now <i class="fa-solid fa-arrow-right"></i></a>
              <a class="pp-btn pp-btn-outline" href="#compare">View Compare Table <i class="fa-solid fa-table"></i></a>
            </div>
          </div>
          <div class="pp-cta-right">
            <div class="pp-calendar-shell">
              <div class="pp-calendar-head">
                <i class="fa-regular fa-calendar"></i> Book a Quick Compare Call
              </div>
              <iframe
                class="pp-calendar-iframe"
                src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ34gwW6Fs4yYTWT4Y5PwFVZ9BDuuR_F9sdeCnIx3YhHz_pNa9FnkX-zimGF1LU92MD149NRVVMo?gv=true"
                title="Schedule a meeting"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section pp-section-tight" id="partner-form">
      <div class="pp-container">
        <div class="pp-form-shell reveal">
          <div class="pp-form-head">
            <span class="pp-eyebrow pp-eyebrow-fit"><i class="fa-solid fa-rocket"></i> Apply</span>
            <h3>Become a Partner</h3>
            <p>Fill out the form and our partnership team will contact you.</p>
          </div>
          <div class="pp-form-body">
            <form id="partnerForm" action="/api/lead" method="POST">
              <input type="hidden" name="_form" value="become-a-partner" />
              <input type="hidden" name="_subject" value="New Partner Application" />
              <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" aria-hidden="true" />
              <div class="pp-form-grid">
                <div class="pp-fg">
                  <label for="firstName">First Name</label>
                  <input type="text" id="firstName" name="firstName" required />
                </div>
                <div class="pp-fg">
                  <label for="lastName">Last Name</label>
                  <input type="text" id="lastName" name="lastName" required />
                </div>
                <div class="pp-fg">
                  <label for="email">Email Address</label>
                  <input type="email" id="email" name="email" required />
                </div>
                <div class="pp-fg">
                  <label for="phone">Phone Number</label>
                  <input type="tel" id="phone" name="phone" required />
                </div>
                <div class="pp-fg">
                  <label for="company">Company Name</label>
                  <input type="text" id="company" name="company" />
                </div>
                <div class="pp-fg">
                  <label for="experience">Years in Payments</label>
                  <select id="experience" name="experience" required>
                    <option value="">Select</option>
                    <option value="0-1">0-1 years</option>
                    <option value="1-3">1-3 years</option>
                    <option value="3-5">3-5 years</option>
                    <option value="5+">5+ years</option>
                  </select>
                </div>
                <div class="pp-fg">
                  <label for="partnerType">Partner Type</label>
                  <select id="partnerType" name="partnerType" required>
                    <option value="">Select</option>
                    <option value="referral">Referral Partner</option>
                    <option value="sales">Sales Partner</option>
                    <option value="iso">ISO Partner</option>
                  </select>
                </div>
                <div class="pp-fg">
                  <label for="volume">Monthly Processing Volume</label>
                  <select id="volume" name="volume" required>
                    <option value="">Select</option>
                    <option value="0-100k">$0 - $100,000</option>
                    <option value="100k-500k">$100,000 - $500,000</option>
                    <option value="500k-5m">$500,000 - $5,000,000</option>
                    <option value="5m+">$5,000,000+</option>
                  </select>
                </div>
                <div class="pp-fg pp-full">
                  <label for="message">Additional Information</label>
                  <textarea id="message" name="message" rows="3" placeholder="Tell us about your business and partnership goals..."></textarea>
                </div>
              </div>
              <div class="pp-form-actions">
                <button class="pp-btn pp-btn-primary" type="submit">Submit Application <i class="fa-solid fa-arrow-right"></i></button>
                <button class="pp-btn pp-btn-ghost" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">Book a Call Instead <i class="fa-regular fa-calendar"></i></button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

  </div>

  <style>
    .partner-page{
      --pp-primary:#1549FF;
      --pp-primary-dark:#0F38CC;
      --pp-navy:#060E21;
      --pp-navy-2:#0C1A38;
      --pp-accent:#00E5A0;
      --pp-cyan:#00CFFF;
      --pp-surface:#F5F8FF;
      --pp-card:#FFFFFF;
      --pp-text:#060E21;
      --pp-muted:#5E7A9A;
      --pp-border:#E2E8F4;
      --pp-shadow:0 10px 30px rgba(2,6,23,.08);
      --pp-shadow-lg:0 20px 50px rgba(2,6,23,.12);
      --pp-radius:16px;
      --pp-container:1140px;
      background:var(--pp-surface);
      color:var(--pp-text);
    }
    .partner-page *{box-sizing:border-box}
    .partner-page a{color:inherit;text-decoration:none}
    .pp-container{max-width:var(--pp-container);margin-left:auto;margin-right:auto;padding-left:24px;padding-right:24px}
    .pp-section{padding:80px 0}
    .pp-section-tight{padding:56px 0}
