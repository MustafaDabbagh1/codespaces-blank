---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Agents & ISOs Partner Program | PPD Technology">
  <div class="partner-page">
    <section class="hero">
      <div class="container hero-grid">
        <div class="reveal">
          <span class="eyebrow"><i class="fa-solid fa-handshake"></i> Agents & ISOs</span>
          <h1>Keep your book. Get a cleaner deal and faster support.</h1>
          <p class="lead">
            If you already know payments, you do not need more noise. You need clean reporting, responsive support, and a program you can scale.
            Start with a 2 minute side-by-side compare.
          </p>

          <div class="hero-cta">
            <button class="btn btn-primary" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">
              Book a Quick Compare Call <i class="fa-regular fa-calendar"></i>
            </button>
            <a class="btn btn-outline" href="#compare">
              View the Compare Table <i class="fa-solid fa-table"></i>
            </a>
            <a class="btn btn-outline" href="#partner-kit">
              Download the Partner Kit <i class="fa-solid fa-download"></i>
            </a>
          </div>

          <div class="logo-strip" aria-label="Highlights">
            <span class="logo-pill"><i class="fa-solid fa-bolt"></i> Fast onboarding</span>
            <span class="logo-pill"><i class="fa-solid fa-chart-line"></i> Residuals & reporting</span>
            <span class="logo-pill"><i class="fa-solid fa-headset"></i> 24/7 support desk</span>
            <span class="logo-pill"><i class="fa-solid fa-shield-halved"></i> Risk-aware underwriting</span>
          </div>
        </div>

        <div class="team-card-stack reveal" aria-label="Talk to our team">
          <div class="person-card">
            <div class="person-left">
              <div class="avatar">PD</div>
              <div class="pmeta">
                <div class="name">Partner Development</div>
                <div class="role">Program, comp, and onboarding</div>
              </div>
            </div>
            <a class="mini-btn" href="#book"><i class="fa-regular fa-calendar"></i> Book</a>
          </div>

          <div class="person-card">
            <div class="person-left">
              <div class="avatar">UW</div>
              <div class="pmeta">
                <div class="name">Underwriting Desk</div>
                <div class="role">Faster, clearer approvals</div>
              </div>
            </div>
            <a class="mini-btn" href="#compare"><i class="fa-solid fa-scale-balanced"></i> Compare</a>
          </div>

          <div class="person-card">
            <div class="person-left">
              <div class="avatar">CS</div>
              <div class="pmeta">
                <div class="name">Merchant Support</div>
                <div class="role">Retention and escalations</div>
              </div>
            </div>
            <a class="mini-btn" href="#crm"><i class="fa-solid fa-grid-2"></i> Tools</a>
          </div>

          <div class="person-card person-card-accent">
            <div class="person-left">
              <div class="avatar avatar-accent">$$</div>
              <div class="pmeta">
                <div class="name">Residual-Friendly Program</div>
                <div class="role">Build long-term income</div>
              </div>
            </div>
            <a class="mini-btn mini-btn-accent" href="#commission">
              <i class="fa-solid fa-sack-dollar"></i> Earnings
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="compare">
      <div class="container">
        <div class="section-head reveal compare-head">
          <span class="chip"><i class="fa-solid fa-scale-balanced"></i> Quick Compare</span>
          <h2 class="h2">Side-by-side in 2 minutes</h2>
          <p class="lead">
            Fill in your current program (middle column) or bring it to a quick call. We will confirm the exact comp we can offer based on your volume and vertical,
            then map it next to what you have today.
          </p>
        </div>

        <div class="compare-wrap reveal">
          <div>
            <div class="card card-xl">
              <div class="icon"><i class="fa-solid fa-file-arrow-down"></i></div>
              <h3>Download the compare sheet</h3>
              <p class="muted space-bottom">
                Use the PDF for a clean one-pager, or use the on-page table and print it.
              </p>

              <div class="dl" aria-label="Downloads">
                <a href="COMPARE_PDF_URL_HERE" target="_blank" rel="noopener">
                  <span class="left"><i class="fa-solid fa-file-pdf pdf-icon"></i> Partner Deal Sheet (Quick Compare)</span>
                  <span class="tag">PDF</span>
                </a>
                <a href="STATEMENT_BREAKDOWN_URL_HERE" target="_blank" rel="noopener">
                  <span class="left"><i class="fa-solid fa-receipt primary-icon"></i> Statement Breakdown (Example)</span>
                  <span class="tag">PDF</span>
                </a>
                <a href="ONBOARDING_CHECKLIST_URL_HERE" target="_blank" rel="noopener">
                  <span class="left"><i class="fa-solid fa-list-check accent-icon"></i> Fast Onboarding Checklist</span>
                  <span class="tag">PDF</span>
                </a>
              </div>

              <div class="compare-note margin-top">
                Tip: if you have a current deal sheet, you can redact sensitive info and still compare splits, fees, support, and reporting.
              </div>

              <div class="compare-tools">
                <button class="btn btn-primary" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">
                  Book a Call <i class="fa-regular fa-calendar"></i>
                </button>
                <button class="btn btn-ghost" type="button" id="printCompare">
                  Print Compare <i class="fa-solid fa-print"></i>
                </button>
              </div>

              <div class="compare-badge"><i class="fa-solid fa-shield-halved"></i> You keep your book. We help you grow it.</div>
            </div>
          </div>

          <div>
            <table class="compare-table" aria-label="Side-by-side compare table">
              <thead>
                <tr>
                  <th>Category</th>
                  <th>Your Current Program (type here)</th>
                  <th>PPD Technology</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Rev share</td>
                  <td><div class="editable" contenteditable="true" data-ph="Your split, bonus, tiers, etc."></div></td>
                  <td><div class="ppd-cell">Higher rev share options available based on volume, vertical, and support needs.</div></td>
                </tr>
                <tr>
                  <td>Statement transparency</td>
                  <td><div class="editable" contenteditable="true"></div></td>
                  <td><div class="ppd-cell">Transparent statements and clean partner reporting.</div></td>
                </tr>
                <tr>
                  <td>Support desk</td>
                  <td><div class="editable" contenteditable="true"></div></td>
                  <td><div class="ppd-cell">Real ISO support desk (24/7) with escalation paths and defined workflows.</div></td>
                </tr>
                <tr>
                  <td>Underwriting</td>
                  <td><div class="editable" contenteditable="true"></div></td>
                  <td><div class="ppd-cell">Risk-aware underwriting with clearer next steps and fewer stalls.</div></td>
                </tr>
                <tr>
                  <td>Lead flow</td>
                  <td><div class="editable" contenteditable="true"></div></td>
                  <td><div class="ppd-cell">Free, pre-qualified leads included for partners (availability may vary by market).</div></td>
                </tr>
                <tr>
                  <td>Partner portal / CRM</td>
                  <td><div class="editable" contenteditable="true"></div></td>
                  <td><div class="ppd-cell">Partner CRM, onboarding visibility, case tracking, and portfolio reporting.</div></td>
                </tr>
                <tr>
                  <td>Portfolio ownership</td>
                  <td><div class="editable" contenteditable="true"></div></td>
                  <td><div class="ppd-cell">You keep your book. Ownership options depend on partner model and agreement.</div></td>
                </tr>
                <tr>
                  <td>Payout cadence</td>
                  <td><div class="editable" contenteditable="true"></div></td>
                  <td><div class="ppd-cell">Monthly residuals with transparent reporting and clear payout timing.</div></td>
                </tr>
                <tr>
                  <td>Equipment + logistics</td>
                  <td><div class="editable" contenteditable="true"></div></td>
                  <td><div class="ppd-cell">Hardware options, shipping workflows, and partner support for deployments.</div></td>
                </tr>
                <tr>
                  <td>Compliance + risk support</td>
                  <td><div class="editable" contenteditable="true"></div></td>
                  <td><div class="ppd-cell">Structured monitoring and case visibility to protect your portfolio.</div></td>
                </tr>
              </tbody>
            </table>

            <div class="compare-note compare-note-after">
              Want us to pre-fill this? Bring your current deal sheet to the call (redacted is fine) and we will mark it up.
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-white" id="partner-kit">
      <div class="container">
        <div class="section-head reveal compare-head">
          <span class="chip"><i class="fa-solid fa-toolbox"></i> Partner Kit</span>
          <h2 class="h2">Everything you need to evaluate the program</h2>
          <p class="lead">
            A simple kit built for agents and ISOs who want clarity. Download the assets, then book a quick call to confirm the exact comp and fit.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="#book"><i class="fa-regular fa-calendar"></i> Book a Call</a>
            <a class="btn btn-ghost" href="#compare"><i class="fa-solid fa-scale-balanced"></i> View Compare</a>
          </div>
        </div>

        <div class="grid-3 reveal margin-top-lg">
          <div class="card">
            <div class="icon"><i class="fa-solid fa-file-signature"></i></div>
            <h3>Quick Compare Sheet</h3>
            <p>Side-by-side format for comp, support, reporting, and ownership terms.</p>
            <div class="card-action">
              <a class="btn btn-soft full-width" href="COMPARE_PDF_URL_HERE" target="_blank" rel="noopener">Download PDF <i class="fa-solid fa-download"></i></a>
            </div>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-receipt"></i></div>
            <h3>Statement Breakdown Example</h3>
            <p>A plain-English example of what agents look for on statements and reports.</p>
            <div class="card-action">
              <a class="btn btn-soft full-width" href="STATEMENT_BREAKDOWN_URL_HERE" target="_blank" rel="noopener">View Example <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
            </div>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-list-check"></i></div>
            <h3>Fast Start Checklist</h3>
            <p>A simple onboarding checklist to help you submit clean apps and move faster.</p>
            <div class="card-action">
              <a class="btn btn-soft full-width" href="ONBOARDING_CHECKLIST_URL_HERE" target="_blank" rel="noopener">Download <i class="fa-solid fa-download"></i></a>
            </div>
          </div>
        </div>

        <div class="grid-2 reveal margin-top-lg">
          <div class="card card-xl">
            <div class="icon"><i class="fa-solid fa-shield-halved"></i></div>
            <h3>Support promise</h3>
            <p class="muted space-bottom">
              Your merchants stay longer when support is real. We built the program around responsiveness and clear escalation paths.
            </p>
            <div class="feature-list">
              <div class="feature-row">
                <i class="fa-solid fa-circle-check accent-icon list-icon"></i>
                <div><strong>24/7 ISO desk</strong> with structured case handling.</div>
              </div>
              <div class="feature-row">
                <i class="fa-solid fa-circle-check accent-icon list-icon"></i>
                <div><strong>SLA-backed response expectations</strong> for partner escalations (details provided on call).</div>
              </div>
              <div class="feature-row">
                <i class="fa-solid fa-circle-check accent-icon list-icon"></i>
                <div><strong>Underwriting visibility</strong> so deals do not die in email chains.</div>
              </div>
            </div>
          </div>

          <div class="card card-xl">
            <div class="icon"><i class="fa-solid fa-handshake"></i></div>
            <h3>Book ownership clarity</h3>
            <p class="muted space-bottom">
              We keep the language simple. No games. Ownership and residual terms depend on partner model and agreement.
            </p>
            <div class="feature-list">
              <div class="feature-row">
                <i class="fa-solid fa-circle-check accent-icon list-icon"></i>
                <div><strong>You keep your book</strong> under the agreed partner structure.</div>
              </div>
              <div class="feature-row">
                <i class="fa-solid fa-circle-check accent-icon list-icon"></i>
                <div><strong>Transparent reporting</strong> so you can reconcile payouts and portfolio performance.</div>
              </div>
              <div class="feature-row">
                <i class="fa-solid fa-circle-check accent-icon list-icon"></i>
                <div><strong>Clean deal review</strong> so you know what you are signing before you sign.</div>
              </div>
            </div>

            <div class="form-actions margin-top">
              <a class="btn btn-primary" href="#book">Book a Call <i class="fa-regular fa-calendar"></i></a>
              <a class="btn btn-ghost" href="#partner-form">Apply <i class="fa-solid fa-arrow-right"></i></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section band" id="payouts">
      <div class="container split">
        <div class="section-head reveal">
          <span class="chip"><i class="fa-solid fa-money-check-dollar"></i> How payouts work</span>
          <h2 class="h2">Simple, predictable, and visible</h2>
          <p class="lead">
            We will confirm exact payout cadence and reporting during the call. The goal is simple: clear reporting, clean payouts, and fewer surprises.
          </p>

          <div class="actions">
            <a class="btn btn-primary" href="#book"><i class="fa-regular fa-calendar"></i> Book a Call</a>
            <a class="btn btn-ghost" href="#compare"><i class="fa-solid fa-scale-balanced"></i> Compare First</a>
          </div>
        </div>

        <div class="reveal">
          <div class="steps">
            <div class="step">
              <div class="top">
                <div class="num">1</div>
                <div class="title">Onboard</div>
              </div>
              <div class="desc">Submit apps and docs through the partner workflow. We keep underwriting steps visible.</div>
            </div>
            <div class="step">
              <div class="top">
                <div class="num">2</div>
                <div class="title">Fund and activate</div>
              </div>
              <div class="desc">Once processing starts, the account is tracked in reporting and becomes part of your portfolio.</div>
            </div>
            <div class="step">
              <div class="top">
                <div class="num">3</div>
                <div class="title">Monthly residuals</div>
              </div>
              <div class="desc">Residuals are paid monthly on active accounts. Exact timing and structure are confirmed by partner agreement.</div>
            </div>
          </div>

          <div class="compare-note margin-top">
            If you want, bring a screenshot of your current statement or residual report and we will explain what matters and what does not.
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="crm">
      <div class="container split">
        <div class="section-head sticky reveal">
          <span class="chip"><i class="fa-solid fa-layer-group"></i> All-in-One Partner CRM</span>
          <h2 class="h2">Tools that help you sell faster and manage your book cleanly</h2>
          <p class="lead">
            Keep applications, documents, equipment requests, and account status in one place so you spend more time selling and less time chasing updates.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="#book"><i class="fa-regular fa-calendar"></i> Book a Call</a>
            <a class="btn btn-ghost" href="#compare"><i class="fa-solid fa-scale-balanced"></i> Quick Compare</a>
          </div>
        </div>

        <div class="grid-3 reveal">
          <div class="card">
            <div class="icon"><i class="fa-solid fa-chart-line"></i></div>
            <h3>Residuals & Reporting</h3>
            <p>Track portfolio performance with clean reporting and predictable monthly payouts.</p>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-gauge-high"></i></div>
            <h3>Real-Time Dashboards</h3>
            <p>See account activity and sales progress in a way that’s easy to explain to your team.</p>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-file-signature"></i></div>
            <h3>Digital Onboarding</h3>
            <p>Send apps, upload docs, and keep underwriting moving without endless email threads.</p>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-shield-halved"></i></div>
            <h3>Friction-Reduced Underwriting</h3>
            <p>Clear next steps and better visibility through the approval lifecycle.</p>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <h3>Risk-Aware Monitoring</h3>
            <p>Support that protects your portfolio with structured workflows and case visibility.</p>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-headset"></i></div>
            <h3>Merchant Support 360</h3>
            <p>Keep merchants happy with responsive support so you keep accounts longer.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-white" id="invest">
      <div class="container">
        <div class="section-head reveal compare-head">
          <span class="chip"><i class="fa-solid fa-seedling"></i> We Invest in You</span>
          <h2 class="h2">Support, training, and assets built for growth</h2>
          <p class="lead">A hands-on partner program with real people, real enablement, and sales tools you can actually use.</p>
        </div>

        <div class="grid-3 reveal margin-top-lg">
          <div class="card">
            <div class="icon"><i class="fa-solid fa-user-group"></i></div>
            <h3>Human Support</h3>
            <p>Dedicated partner assistance to help you onboard, pitch, and retain merchants.</p>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-phone-volume"></i></div>
            <h3>Direct Contact</h3>
            <p>Fewer handoffs, faster answers so deals do not stall.</p>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-bullhorn"></i></div>
            <h3>Marketing Support</h3>
            <p>Co-branded materials and sales-ready assets to help you close more confidently.</p>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-graduation-cap"></i></div>
            <h3>Training Library</h3>
            <p>Practical training and playbooks for new agents and seasoned ISOs.</p>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-brain"></i></div>
            <h3>Sales Coaching</h3>
            <p>Skill-building sessions and strategy support to improve performance over time.</p>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-gears"></i></div>
            <h3>Technology-Driven</h3>
            <p>Modern tools, streamlined workflows, and flexible solutions across industries.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section guarantee">
      <div class="container">
        <div class="section-head reveal compare-head">
          <span class="chip"><i class="fa-solid fa-badge-check"></i> Partner Experience</span>
          <h2 class="h2">PPD Guarantees</h2>
          <p class="lead">A partner program that stays responsive so you can stay in motion.</p>
        </div>

        <div class="grid-4 reveal margin-top-lg">
          <div class="metric">
            <div class="top">
              <div class="label">Accessibility</div>
              <span class="badge"><i class="fa-solid fa-user"></i> Real humans</span>
            </div>
            <div class="desc">Talk to real people by phone or email when you need help.</div>
          </div>
          <div class="metric">
            <div class="top">
              <div class="label">Speed</div>
              <span class="badge"><i class="fa-solid fa-bolt"></i> Fast replies</span>
            </div>
            <div class="desc">Quick response times designed to keep deals from stalling.</div>
          </div>
          <div class="metric">
            <div class="top">
              <div class="label">Expertise</div>
              <span class="badge"><i class="fa-solid fa-chalkboard-user"></i> Know-how</span>
            </div>
            <div class="desc">Partner teams that understand pricing, risk, and merchant success.</div>
          </div>
          <div class="metric">
            <div class="top">
              <div class="label">Transparency</div>
              <span class="badge"><i class="fa-solid fa-eye"></i> Clear terms</span>
            </div>
            <div class="desc">Clear program expectations and straightforward communication.</div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="solutions">
      <div class="container">
        <div class="section-head reveal compare-head">
          <span class="chip"><i class="fa-solid fa-store"></i> Powering Your Sales Success</span>
          <h2 class="h2">Solutions you can confidently take to market</h2>
          <p class="lead">
            Sell across business types from retail and restaurants to e-commerce and service businesses with a flexible stack and strong support.
          </p>
        </div>

        <div class="grid-3 reveal margin-top-lg">
          <div class="card">
            <div class="icon"><i class="fa-solid fa-layer-group"></i></div>
            <h3>Full Service Provider</h3>
            <p>In-store, online, and mobile acceptance with one ecosystem and multiple entry points.</p>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-cash-register"></i></div>
            <h3>POS & Hardware Options</h3>
            <p>Terminals, POS systems, and accessories depending on the merchant’s workflow.</p>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-cart-shopping"></i></div>
            <h3>E-commerce & Gateway</h3>
            <p>Online checkout, invoicing, and integrations built for modern selling.</p>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-sliders"></i></div>
            <h3>Flexible Approach</h3>
            <p>Serve a wide range of business sizes and risk profiles with guidance.</p>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
            <h3>Tailored Solutions</h3>
            <p>Build the right stack for the merchant instead of forcing a one-size bundle.</p>
          </div>
          <div class="card">
            <div class="icon"><i class="fa-solid fa-tags"></i></div>
            <h3>Fee-Offset Programs</h3>
            <p>Offer cash discount or surcharge options where appropriate and compliant.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section band" id="commission">
      <div class="container split">
        <div class="section-head reveal">
          <span class="chip"><i class="fa-solid fa-sack-dollar"></i> Earnings</span>
          <h2 class="h2">A commission model designed for long-term income</h2>
          <p class="lead">
            Earn ongoing residuals while building a portfolio you’re proud to keep.
          </p>

          <div class="stats">
            <div class="stat">
              <div class="num">Monthly residuals</div>
              <div class="lab">Recurring income on active accounts</div>
            </div>
            <div class="stat">
              <div class="num">Transparent reporting</div>
              <div class="lab">Clear visibility into performance</div>
            </div>
            <div class="stat">
              <div class="num">Scale your portfolio</div>
              <div class="lab">Grow over time with support</div>
            </div>
          </div>
        </div>

        <div class="reveal">
          <div class="card card-xl">
            <div class="icon"><i class="fa-solid fa-check-circle"></i></div>
            <h3>How you earn</h3>
            <p class="muted space-bottom">Clear incentives that reward good deals and strong retention.</p>

            <div class="feature-list">
              <div class="feature-row">
                <i class="fa-solid fa-circle-check accent-icon list-icon"></i>
                <div><strong>Residual income</strong> paid monthly for the life of the account.</div>
              </div>
              <div class="feature-row">
                <i class="fa-solid fa-circle-check accent-icon list-icon"></i>
                <div><strong>Volume-based opportunities</strong> as your portfolio grows.</div>
              </div>
              <div class="feature-row">
                <i class="fa-solid fa-circle-check accent-icon list-icon"></i>
                <div><strong>Retention-focused support</strong> to help keep accounts long-term.</div>
              </div>
              <div class="feature-row">
                <i class="fa-solid fa-circle-check accent-icon list-icon"></i>
                <div><strong>No hard caps</strong> grow as much as you can sell and support.</div>
              </div>
            </div>

            <div class="form-actions margin-top">
              <a class="btn btn-primary" href="#book">Book a Call <i class="fa-regular fa-calendar"></i></a>
              <a class="btn btn-ghost" href="#faq">See FAQ <i class="fa-solid fa-circle-question"></i></a>
            </div>
