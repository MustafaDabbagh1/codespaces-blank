  <script is:inline>
    (() => {
      const root = document.querySelector(".partner-page");
      if (!root) return;

      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("show");
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      root.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      const track = root.querySelector("#track");
      const prev = root.querySelector("#prev");
      const next = root.querySelector("#next");

      if (track && prev && next) {
        let index = 0;

        function slidesPerView() {
          const w = window.innerWidth;
          if (w >= 1100) return 3;
          if (w >= 820) return 2;
          return 1;
        }

        function update() {
          const spv = slidesPerView();
          const slides = Array.from(track.children);
          const maxIndex = Math.max(0, slides.length - spv);

          index = Math.min(index, maxIndex);

          const slide = slides[0];
          const gap = 14;
          if (!slide) return;
          const slideW = slide.getBoundingClientRect().width;
          const x = index * (slideW + gap);

          track.style.transform = `translateX(-${x}px)`;
          prev.disabled = index <= 0;
          next.disabled = index >= maxIndex;
        }

        prev.addEventListener("click", () => {
          index = Math.max(0, index - 1);
          update();
        });

        next.addEventListener("click", () => {
          index = index + 1;
          update();
        });

        window.addEventListener("resize", update, { passive: true });
        update();
      }

      root.querySelectorAll("details").forEach((details) => {
        details.addEventListener("toggle", () => {
          const icon = details.querySelector("summary i");
          if (!icon) return;
          icon.className = details.open ? "fa-solid fa-minus" : "fa-solid fa-plus";
        });
      });

      root.querySelectorAll(".editable").forEach((el) => {
        const ph = el.getAttribute("data-ph") || "Type here...";
        if (!el.textContent.trim()) {
          el.dataset.empty = "true";
          el.innerHTML = `<span style="color:#94A3B8;font-weight:700">${ph}</span>`;
        }

        el.addEventListener("focus", () => {
          if (el.dataset.empty === "true") {
            el.textContent = "";
            el.dataset.empty = "false";
          }
        });

        el.addEventListener("blur", () => {
          if (!el.textContent.trim()) {
            el.dataset.empty = "true";
            el.innerHTML = `<span style="color:#94A3B8;font-weight:700">${ph}</span>`;
          }
        });
      });

      const printBtn = root.querySelector("#printCompare");
      printBtn?.addEventListener("click", () => window.print());
    })();
  </script>
