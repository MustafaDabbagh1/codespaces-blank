      font-size:9px;font-weight:800;color:#fff;background:linear-gradient(135deg,var(--pp-primary),#8B5CF6);
    }
    .pp-bn-merch-name{font-size:11.5px;font-weight:600;color:rgba(255,255,255,.85);flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .pp-bn-merch-dot{width:7px;height:7px;flex:none;border-radius:50%;background:var(--pp-accent);box-shadow:0 0 0 3px rgba(0,229,160,.15)}

    .pp-bn-bars{display:flex;align-items:flex-end;gap:5px;height:52px}
    .pp-bn-bars span{
      flex:1;border-radius:4px 4px 0 0;transform-origin:bottom;
      background:linear-gradient(180deg,var(--pp-cyan),var(--pp-primary));animation:pp-bn-grow .6s ease both;
    }
    .pp-bn-bars span:last-child{background:linear-gradient(180deg,#b79cff,#7C4DFF)}
    @keyframes pp-bn-grow{from{transform:scaleY(.05);opacity:.3}to{transform:scaleY(1);opacity:1}}

    .pp-bn-modules{display:flex;flex-wrap:wrap;gap:6px}
    .pp-bn-chip{
      padding:4px 9px;border-radius:999px;font-size:10.5px;font-weight:700;
      color:rgba(255,255,255,.82);background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);
    }

    .pp-bn-activity{display:flex;flex-direction:column;gap:6px}
    .pp-bn-act{font-size:11px;color:rgba(255,255,255,.7);display:flex;align-items:center;gap:7px;line-height:1.35}
    .pp-bn-act i{font-size:10px;color:var(--pp-accent);flex:none}
    .pp-bn-act:nth-child(2) i{color:var(--pp-cyan)}

    .pp-bn-brandline{display:flex;align-items:center;justify-content:center;gap:7px;font-size:10.5px;font-weight:700;color:rgba(255,255,255,.55);padding-top:2px}
    .pp-bn-brandline i{color:#b79cff}

    .pp-switch-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:32px}
    .pp-switch-card{
      background:#fff;border:1px solid var(--pp-border);border-radius:var(--pp-radius);
      padding:28px;box-shadow:var(--pp-shadow);transition:transform .2s,box-shadow .2s;
    }
    .pp-switch-card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(2,6,23,.12)}
    .pp-switch-icon{
      width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;
      background:rgba(21,73,255,.08);border:1px solid rgba(21,73,255,.12);color:var(--pp-primary);font-size:18px;margin-bottom:16px;
    }
    .pp-switch-card h3{font-size:17px;font-weight:800;margin-bottom:6px;letter-spacing:-.01em}
    .pp-switch-card p{font-size:14px;color:var(--pp-muted);line-height:1.6}
    .pp-switch-cta{
      display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap;
      margin-top:28px;padding:20px 24px;border-radius:var(--pp-radius);
      background:rgba(21,73,255,.04);border:1px solid rgba(21,73,255,.1);
    }
    .pp-switch-cta p{font-size:14px;color:var(--pp-muted);font-weight:600;margin:0}

    .pp-value-grid{
      display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:32px;
    }
    .pp-value-card{
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
      border-radius:var(--pp-radius);padding:24px;
      transition:transform .2s,border-color .2s;
    }
    .pp-value-card:hover{transform:translateY(-4px);border-color:rgba(255,255,255,.2)}
    .pp-value-icon{
      width:44px;height:44px;border-radius:12px;margin-bottom:14px;
      background:rgba(21,73,255,.2);border:1px solid rgba(21,73,255,.3);
      display:flex;align-items:center;justify-content:center;font-size:18px;color:var(--pp-cyan);
    }
    .pp-value-card h3{font-size:16px;font-weight:800;margin-bottom:6px}
    .pp-value-card p{color:rgba(255,255,255,.65);font-size:14px;line-height:1.5}

    /* What makes PPD different — software split */
    .pp-diff-split{
      display:grid;grid-template-columns:1fr minmax(0,540px);gap:48px;align-items:center;margin-top:36px;
    }
    .pp-diff-headline{display:flex;align-items:flex-start;gap:14px;margin-bottom:18px}
    .pp-diff-headline-icon{
      flex-shrink:0;width:48px;height:48px;border-radius:14px;
      background:linear-gradient(135deg,var(--pp-primary),var(--pp-cyan));
      display:flex;align-items:center;justify-content:center;font-size:20px;color:#fff;
      box-shadow:0 8px 24px rgba(21,73,255,.35);
    }
    .pp-diff-headline h3{font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.2;letter-spacing:-.02em;color:#fff}
    .pp-diff-body{color:rgba(255,255,255,.72);font-size:15px;line-height:1.7;margin-bottom:14px}
    .pp-diff-cta{display:flex;flex-direction:column;gap:12px;margin-top:24px}
    .pp-diff-cta .pp-btn{width:fit-content}
    .pp-diff-cta-note{color:rgba(255,255,255,.55);font-size:13px;font-weight:600;max-width:46ch}

    .pp-diff-mock{
      max-width:540px;width:100%;margin-inline:auto;
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);
      border-radius:18px;overflow:hidden;backdrop-filter:blur(10px);
      box-shadow:0 22px 44px rgba(2,6,23,.32);
    }
    .pp-diff-mock-body{padding:16px 16px 18px;display:flex;flex-direction:column;gap:12px}
    .pp-diff-tabs{display:flex;flex-wrap:wrap;gap:6px}
    .pp-diff-tab{
      padding:6px 12px;border-radius:999px;font-size:12px;font-weight:700;font-family:inherit;cursor:pointer;white-space:nowrap;
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.6);
      transition:background .18s,color .18s,border-color .18s,transform .12s;
    }
    .pp-diff-tab:hover{background:rgba(255,255,255,.14);color:#fff}
    .pp-diff-tab:active{transform:translateY(1px)}
    .pp-diff-tab.active{
      background:linear-gradient(135deg,var(--pp-primary),var(--pp-cyan));
      border-color:transparent;color:#fff;box-shadow:0 5px 14px rgba(21,73,255,.32);
    }
    .pp-diff-tab:focus-visible{outline:2px solid var(--pp-cyan);outline-offset:2px}
    .pp-diff-dashcontent{transition:opacity .2s ease}
    .pp-diff-dashcontent.pp-swapping{opacity:.25}
    .pp-diff-dashhead-title{font-size:13.5px;font-weight:800;color:#fff;letter-spacing:-.01em}
    .pp-diff-dashhead-desc{font-size:11px;color:rgba(255,255,255,.6);line-height:1.45;margin-top:4px}
    .pp-diff-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .pp-diff-stat{
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
      border-radius:10px;padding:9px 11px;
    }
    .pp-diff-stat .lbl{font-size:9px;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.5);font-weight:700;display:flex;align-items:center;gap:5px}
    .pp-diff-stat .lbl i{color:var(--pp-cyan)}
    .pp-diff-stat .val{font-size:17px;font-weight:900;margin-top:3px;letter-spacing:-.02em;color:#fff}
    .pp-diff-stat .val small{font-size:10px;font-weight:800;color:var(--pp-accent);margin-left:5px}
    .pp-diff-panels{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .pp-diff-panel{
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
      border-radius:10px;padding:11px;
    }
    .pp-diff-panel-title{font-size:9.5px;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,.5);font-weight:700;margin-bottom:8px;display:flex;align-items:center;gap:6px}
    .pp-diff-panel-title i{color:var(--pp-cyan)}
    .pp-diff-checkout-amt{font-size:20px;font-weight:900;color:#fff;letter-spacing:-.02em}
    .pp-diff-checkout-line{display:flex;justify-content:space-between;font-size:10px;color:rgba(255,255,255,.55);margin-top:6px;font-weight:600}
    .pp-diff-pay-btn{
      margin-top:10px;width:100%;padding:8px;border-radius:8px;border:none;cursor:pointer;font-family:inherit;
      background:linear-gradient(135deg,#2D60FF,var(--pp-primary));color:#fff;font-weight:800;font-size:11.5px;
      display:flex;align-items:center;justify-content:center;gap:6px;transition:filter .18s,transform .12s,background .25s;
    }
    .pp-diff-pay-btn:hover{filter:brightness(1.08)}
    .pp-diff-pay-btn:active{transform:translateY(1px)}
    .pp-diff-pay-btn.is-done{background:linear-gradient(135deg,var(--pp-accent),#00b386)}
    .pp-diff-pay-btn:focus-visible{outline:2px solid var(--pp-cyan);outline-offset:2px}
    .pp-diff-modules{display:flex;flex-wrap:wrap;gap:6px}
    .pp-diff-chip{font-size:10px;font-weight:700;color:rgba(255,255,255,.88);background:rgba(0,207,255,.1);border:1px solid rgba(0,207,255,.24);padding:4px 9px;border-radius:999px}
    .pp-diff-crm-toggle{
      display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:8px;border-radius:8px;cursor:pointer;
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);color:#fff;font-weight:800;font-size:11.5px;font-family:inherit;
      transition:background .18s,border-color .18s;
    }
    .pp-diff-crm-toggle:hover{background:rgba(255,255,255,.13)}
    .pp-diff-crm-toggle:focus-visible{outline:2px solid var(--pp-cyan);outline-offset:2px}
    .pp-diff-crm-toggle i{color:var(--pp-cyan);transition:transform .25s ease}
    .pp-diff-crm-toggle.is-open i{transform:rotate(180deg)}
    .pp-diff-crm{max-height:0;opacity:0;overflow:hidden;transition:max-height .35s ease,opacity .3s ease}
    .pp-diff-crm[hidden]{display:none}
    .pp-diff-crm.is-open{max-height:640px;opacity:1;margin-top:2px}
    .pp-diff-pipeline{display:flex;flex-direction:column;gap:8px}
    .pp-diff-pl-top{display:flex;justify-content:space-between;font-size:10px;font-weight:700;color:rgba(255,255,255,.75);margin-bottom:4px}
    .pp-diff-pl-top strong{color:#fff;font-weight:900}
    .pp-diff-pl-bar{height:4px;border-radius:99px;background:rgba(255,255,255,.1);overflow:hidden}
    .pp-diff-pl-bar span{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--pp-primary),var(--pp-cyan))}
    .pp-diff-activity{display:flex;flex-direction:column;gap:8px}
    .pp-diff-act-row{display:flex;gap:8px;align-items:flex-start;font-size:10px;color:rgba(255,255,255,.72);line-height:1.4}
    .pp-diff-act-row i{color:var(--pp-cyan);font-size:10px;margin-top:2px;flex-shrink:0}
    .pp-diff-merchant{display:flex;align-items:center;gap:9px;padding:6px;margin:0 -6px;border-radius:8px;border-bottom:1px solid rgba(255,255,255,.07);transition:background .15s}
    .pp-diff-merchant:hover{background:rgba(255,255,255,.06)}
    .pp-diff-merchant:last-child{border-bottom:none}
    .pp-diff-avatar{width:26px;height:26px;border-radius:7px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;color:#fff;background:linear-gradient(135deg,var(--pp-primary),var(--pp-cyan))}
    .pp-diff-merchant-info{flex:1;min-width:0}
    .pp-diff-merchant-name{font-size:11.5px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .pp-diff-merchant-sub{font-size:9.5px;color:rgba(255,255,255,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .pp-diff-dot{width:7px;height:7px;border-radius:50%;background:var(--pp-accent);flex-shrink:0}
    .pp-diff-chart{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:11px}
    .pp-diff-bars{display:flex;align-items:flex-end;gap:5px;height:42px}
    .pp-diff-bars span{flex:1;border-radius:4px 4px 0 0;background:linear-gradient(180deg,var(--pp-cyan),var(--pp-primary));opacity:.85}
    .pp-diff-support{margin-top:32px}

    /* Ways to Partner — hardware + software */
    .pp-hw-split{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center}
    .pp-hw-copy .pp-chip{margin-bottom:16px}
    .pp-hw-copy h2{font-size:clamp(24px,3vw,34px);font-weight:900;letter-spacing:-.02em;line-height:1.18;margin-bottom:14px;color:var(--pp-navy)}
    .pp-hw-copy .pp-sub{margin-bottom:16px}
    .pp-hw-body{color:var(--pp-muted);font-size:15px;line-height:1.7;margin-bottom:14px}
    .pp-hw-cta{display:flex;flex-direction:column;gap:12px;margin-top:22px}
    .pp-hw-cta .pp-btn{width:fit-content}
    .pp-hw-cta-note{color:var(--pp-muted);font-size:13px;font-weight:600;max-width:46ch}

    .pp-hw-visual{
      background:linear-gradient(160deg,#fff,#F5F8FF);
      border:1px solid var(--pp-border);border-radius:20px;padding:22px;
      box-shadow:var(--pp-shadow-lg);position:relative;overflow:hidden;
    }
    .pp-hw-visual::before{
      content:"";position:absolute;inset:auto -30% -40% auto;width:320px;height:320px;border-radius:50%;
      background:radial-gradient(circle,rgba(0,207,255,.14),transparent 65%);pointer-events:none;
    }
    .pp-hw-visual-head{display:flex;align-items:center;gap:11px;font-weight:800;font-size:14px;color:var(--pp-navy);margin-bottom:18px;position:relative;z-index:1}
    .pp-hw-visual-head i{width:34px;height:34px;border-radius:10px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--pp-primary),var(--pp-cyan));color:#fff;font-size:15px}
    .pp-hw-devices{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px;position:relative;z-index:1}
    .pp-hw-device{
      background:#fff;border:1px solid var(--pp-border);border-radius:14px;padding:14px 10px;
      display:flex;flex-direction:column;align-items:center;gap:10px;box-shadow:var(--pp-shadow);
      transition:transform .2s,box-shadow .2s;
    }
    .pp-hw-device:hover{transform:translateY(-4px);box-shadow:var(--pp-shadow-lg)}
    .pp-hw-device img{width:100%;height:74px;object-fit:contain}
    .pp-hw-device span{font-size:12px;font-weight:800;color:var(--pp-navy)}
    .pp-hw-device-illus{width:100%;height:74px;display:flex;align-items:center;justify-content:center}
    .pp-hw-device-illus svg{height:74px;width:auto;display:block;filter:drop-shadow(0 8px 14px rgba(13,27,57,.22))}
    .pp-hw-dash{
      background:linear-gradient(135deg,var(--pp-navy),#0A2B74);border-radius:14px;padding:16px;color:#fff;
      position:relative;z-index:1;border:1px solid rgba(255,255,255,.08);
    }
    .pp-hw-dash-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
    .pp-hw-dash-title{font-weight:800;font-size:13px;display:flex;align-items:center;gap:8px}
    .pp-hw-dash-title i{color:var(--pp-cyan)}
    .pp-hw-dash-tag{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;padding:5px 10px;border-radius:999px;background:rgba(0,207,255,.15);color:var(--pp-cyan);border:1px solid rgba(0,207,255,.25)}
    .pp-hw-dash-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
    .pp-hw-dash-stats > div{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:10px 12px}
    .pp-hw-dash-stats span{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.55);font-weight:700;margin-bottom:5px}
    .pp-hw-dash-stats strong{font-size:17px;font-weight:900;letter-spacing:-.02em}
    .pp-hw-support{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:32px}

    .pp-bad{color:#E11D48}
    .pp-muted-li{opacity:.45}

    .pp-tools-grid{
      display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:28px;
    }
    .pp-tool-card{
      background:var(--pp-surface);border:1px solid var(--pp-border);border-radius:var(--pp-radius);
      padding:24px;transition:transform .2s,box-shadow .2s,border-color .2s;
    }
    .pp-tool-card:hover{transform:translateY(-4px);box-shadow:var(--pp-shadow);border-color:rgba(21,73,255,.15)}
    .pp-tool-card>i{
      font-size:20px;color:var(--pp-primary);margin-bottom:14px;
      width:44px;height:44px;display:flex;align-items:center;justify-content:center;
      background:rgba(21,73,255,.08);border:1px solid rgba(21,73,255,.12);border-radius:12px;
    }
    .pp-tool-card h3{font-size:15px;font-weight:800;margin-bottom:6px;color:var(--pp-navy)}
    .pp-tool-card p{color:var(--pp-muted);font-size:14px;line-height:1.5}

    .pp-testimonials{
      display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:28px;
    }
    .pp-quote{
      background:#fff;border:1px solid var(--pp-border);border-radius:var(--pp-radius);
      box-shadow:var(--pp-shadow);padding:24px;
      display:flex;flex-direction:column;justify-content:space-between;gap:18px;
      transition:transform .2s,box-shadow .2s;
    }
    .pp-quote:hover{transform:translateY(-4px);box-shadow:var(--pp-shadow-lg)}
    .pp-quote-mark{color:var(--pp-primary);opacity:.25;font-size:20px;margin-bottom:4px}
    .pp-quote-body p{color:var(--pp-text);font-weight:550;font-size:15px;line-height:1.6}
    .pp-quote-footer{display:flex;align-items:center;gap:12px}
    .pp-quote-avatar{
      width:42px;height:42px;border-radius:12px;flex-shrink:0;
      background:rgba(21,73,255,.08);border:1px solid rgba(21,73,255,.12);
      display:flex;align-items:center;justify-content:center;font-weight:900;color:var(--pp-primary);
    }
    .pp-quote-name{font-weight:800;color:var(--pp-navy);font-size:14px}
    .pp-quote-role{font-size:12px;color:var(--pp-muted)}

    .pp-cta-split{
      display:grid;grid-template-columns:1fr 1.2fr;gap:40px;align-items:start;
    }
    .pp-cta-left{display:flex;flex-direction:column;gap:12px;padding-top:20px}
    .pp-cta-left h2{font-size:clamp(26px,3vw,38px);letter-spacing:-.02em}
    .pp-cta-btns{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px}
    .pp-calendar-shell{
      border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,.12);
      background:rgba(255,255,255,.06);
    }
    .pp-calendar-head{
      padding:14px 18px;font-weight:700;font-size:14px;
      border-bottom:1px solid rgba(255,255,255,.1);
      display:flex;align-items:center;gap:8px;color:rgba(255,255,255,.8);
    }
    .pp-calendar-iframe{width:100%;height:600px;border:0;display:block;background:#fff}

    .pp-form-shell{
      max-width:720px;margin:0 auto;
      background:#fff;border:1px solid var(--pp-border);border-radius:20px;
      box-shadow:var(--pp-shadow-lg);overflow:hidden;
    }
    .pp-form-head{
      padding:24px;
      background:linear-gradient(135deg,var(--pp-navy) 0%,#0A2B74 55%,var(--pp-primary-dark) 100%);
      color:#fff;display:flex;flex-direction:column;gap:6px;
    }
    .pp-form-head h3{font-size:22px;letter-spacing:-.02em}
    .pp-form-head p{color:rgba(255,255,255,.8);font-size:14px}
    .pp-form-body{padding:24px}
    .pp-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .pp-fg{display:flex;flex-direction:column;gap:6px}
    .pp-fg label{font-weight:700;color:var(--pp-navy);font-size:14px}
    .pp-fg input,.pp-fg select,.pp-fg textarea{
      padding:11px 12px;border-radius:10px;border:1px solid var(--pp-border);
      font:inherit;outline:none;transition:.2s;background:#fff;font-size:14px;
    }
    .pp-fg input:focus,.pp-fg select:focus,.pp-fg textarea:focus{
      border-color:rgba(21,73,255,.35);box-shadow:0 0 0 3px rgba(21,73,255,.08);
    }
    .pp-full{grid-column:1/-1}
    .pp-form-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}

    .partner-page .reveal{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease}
    .partner-page .reveal.show{opacity:1;transform:translateY(0)}

    @media (max-width:980px){
      .pp-hero-grid{grid-template-columns:1fr !important;gap:24px}
      .pp-value-grid,.pp-tools-grid,.pp-testimonials{grid-template-columns:1fr}
      .pp-cta-split{grid-template-columns:1fr}
      .pp-form-grid{grid-template-columns:1fr}
      .pp-switch-grid{grid-template-columns:1fr}
      .pp-diff-split{grid-template-columns:1fr;gap:28px}
      .pp-hw-split{grid-template-columns:1fr;gap:28px}
      .pp-hw-support{grid-template-columns:1fr}
    }
    @media (max-width:420px){
      .pp-diff-stats,.pp-diff-panels,.pp-hw-dash-stats{grid-template-columns:1fr}
      .pp-bn-stats,.pp-bn-panels{grid-template-columns:1fr}
