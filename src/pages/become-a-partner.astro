      width:42px;height:42px;border-radius:12px;flex-shrink:0;
      background:rgba(21,73,255,.08);border:1px solid rgba(21,73,255,.12);
      display:flex;align-items:center;justify-content:center;font-weight:900;color:var(--pp-primary);
    }
    .pp-quote-name{font-weight:800;color:var(--pp-navy);font-size:14px}
    .pp-quote-role{font-size:12px;color:var(--pp-muted)}

    .pp-cta-split{
      display:grid;grid-template-columns:1fr 1.2fr;gap:40px;align-items:start;
    }
    .pp-cta-left{display:flex;flex-direction:column;gap:12px;padding-top:20px}
    .pp-cta-left h2{font-size:clamp(26px,3vw,38px);letter-spacing:-.02em}
    .pp-cta-btns{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px}
    .pp-calendar-shell{
      border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,.12);
      background:rgba(255,255,255,.06);
    }
    .pp-calendar-head{
      padding:14px 18px;font-weight:700;font-size:14px;
      border-bottom:1px solid rgba(255,255,255,.1);
      display:flex;align-items:center;gap:8px;color:rgba(255,255,255,.8);
    }
    .pp-calendar-iframe{width:100%;height:600px;border:0;display:block;background:#fff}

    .pp-form-shell{
      max-width:720px;margin:0 auto;
      background:#fff;border:1px solid var(--pp-border);border-radius:20px;
      box-shadow:var(--pp-shadow-lg);overflow:hidden;
    }
    .pp-form-head{
      padding:24px;
      background:linear-gradient(135deg,var(--pp-navy) 0%,#0A2B74 55%,var(--pp-primary-dark) 100%);
      color:#fff;display:flex;flex-direction:column;gap:6px;
    }
    .pp-form-head h3{font-size:22px;letter-spacing:-.02em}
    .pp-form-head p{color:rgba(255,255,255,.8);font-size:14px}
    .pp-form-body{padding:24px}
    .pp-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .pp-fg{display:flex;flex-direction:column;gap:6px}
    .pp-fg label{font-weight:700;color:var(--pp-navy);font-size:14px}
    .pp-fg input,.pp-fg select,.pp-fg textarea{
      padding:11px 12px;border-radius:10px;border:1px solid var(--pp-border);
      font:inherit;outline:none;transition:.2s;background:#fff;font-size:14px;
    }
    .pp-fg input:focus,.pp-fg select:focus,.pp-fg textarea:focus{
      border-color:rgba(21,73,255,.35);box-shadow:0 0 0 3px rgba(21,73,255,.08);
    }
    .pp-full{grid-column:1/-1}
    .pp-form-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}

    .partner-page .reveal{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease}
    .partner-page .reveal.show{opacity:1;transform:translateY(0)}

    @media (max-width:980px){
      .pp-hero-grid{grid-template-columns:1fr !important;gap:24px}
      .pp-value-grid,.pp-tools-grid,.pp-testimonials{grid-template-columns:1fr}
      .pp-cta-split{grid-template-columns:1fr}
      .pp-form-grid{grid-template-columns:1fr}
      .pp-switch-grid{grid-template-columns:1fr}
      .pp-diff-split{grid-template-columns:1fr;gap:28px}
      .pp-hw-split{grid-template-columns:1fr;gap:28px}
      .pp-hw-support{grid-template-columns:1fr}
    }
    @media (max-width:420px){
      .pp-diff-stats,.pp-diff-panels,.pp-hw-dash-stats{grid-template-columns:1fr}
    }
    @media (min-width:640px) and (max-width:980px){
      .pp-value-grid,.pp-tools-grid,.pp-testimonials{grid-template-columns:repeat(2,1fr)}
    }
  </style>

  <script is:inline>
    (() => {
      const root = document.querySelector(".partner-page");
      if (!root) return;

      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add("show"); io.unobserve(e.target); }
        });
      }, { threshold: 0.12 });
      root.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      root.querySelectorAll("details").forEach((d) => {
        d.addEventListener("toggle", () => {
          const icon = d.querySelector("summary i");
          if (icon) icon.className = d.open ? "fa-solid fa-minus" : "fa-solid fa-plus";
        });
      });

      const form = document.getElementById("partnerForm");
      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn ? submitBtn.innerHTML : "";
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting…';
        }
        try {
          const data = new FormData(form);
          data.append("_page", window.location.pathname);
          const res = await fetch("/api/lead", { method: "POST", body: data });
          if (!res.ok) throw new Error("Network");
          window.location.href = "/thank-you";
        } catch {
          alert("Sorry, something went wrong submitting your application. Please email info@ppdtechnology.com and we'll help right away.");
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
          }
        }
      });
    })();
  </script>
</BaseLayout>
