      font-size:20px;color:var(--pp-primary);margin-bottom:14px;
      width:44px;height:44px;display:flex;align-items:center;justify-content:center;
      background:rgba(21,73,255,.08);border:1px solid rgba(21,73,255,.12);border-radius:12px;
