---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Agents & ISOs Partner Program | PPD Technology" description="Join PPD Technology's partner program for agents and ISOs. Competitive revenue share, dedicated support, and a full suite of payment solutions to grow your portfolio.">
  <div class="partner-page">

    <section class="pp-hero">
      <div class="pp-container pp-hero-grid">
        <div class="reveal">
          <span class="pp-eyebrow"><i class="fa-solid fa-handshake"></i> Agents & ISOs</span>
          <h1>Keep your book.<br/>Get a cleaner deal.</h1>
          <p class="pp-sub">
            If you already know payments, you don't need more noise. You need clean reporting, responsive support, and a program you can scale.
          </p>
          <div class="pp-hero-ctas">
            <button class="pp-btn pp-btn-primary" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">
              Book a Quick Compare Call <i class="fa-regular fa-calendar"></i>
            </button>
          </div>
          <div class="pp-trust-row">
            <span class="pp-trust-pill"><i class="fa-solid fa-bolt"></i> Fast onboarding</span>
            <span class="pp-trust-pill"><i class="fa-solid fa-chart-line"></i> Transparent reporting</span>
            <span class="pp-trust-pill"><i class="fa-solid fa-headset"></i> 24/7 support desk</span>
            <span class="pp-trust-pill"><i class="fa-solid fa-shield-halved"></i> Risk-aware underwriting</span>
          </div>
        </div>

        <div class="pp-dashboard reveal" aria-label="Partner program preview">
          <div class="pp-dash-header">
            <div class="pp-dash-dots"><span></span><span></span><span></span></div>
            <span class="pp-dash-title">Partner Dashboard</span>
          </div>
          <div class="pp-dash-body">
            <div class="pp-dash-row">
              <div class="pp-dash-stat">
                <div class="pp-dash-label">Active Merchants</div>
                <div class="pp-dash-value">127</div>
                <div class="pp-dash-change positive"><i class="fa-solid fa-arrow-up"></i> 12 this month</div>
              </div>
              <div class="pp-dash-stat">
                <div class="pp-dash-label">Monthly Residuals</div>
                <div class="pp-dash-value">$8,420</div>
                <div class="pp-dash-change positive"><i class="fa-solid fa-arrow-up"></i> 18.2%</div>
              </div>
            </div>
            <div class="pp-dash-row">
              <div class="pp-dash-stat">
                <div class="pp-dash-label">Avg. Approval Time</div>
                <div class="pp-dash-value">1.8 days</div>
                <div class="pp-dash-change positive"><i class="fa-solid fa-arrow-down"></i> Faster</div>
              </div>
              <div class="pp-dash-stat">
                <div class="pp-dash-label">Portfolio Retention</div>
                <div class="pp-dash-value">96.4%</div>
                <div class="pp-dash-change positive"><i class="fa-solid fa-circle-check"></i> Healthy</div>
              </div>
            </div>
            <div class="pp-dash-bar">
              <div class="pp-dash-bar-label">Revenue Growth (6mo)</div>
              <div class="pp-dash-bar-track">
                <div class="pp-dash-bar-fill" style="width:72%"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section" id="compare">
      <div class="pp-container">
        <div class="pp-section-head reveal">
          <span class="pp-chip"><i class="fa-solid fa-arrow-right-arrow-left"></i> Why PPD</span>
          <h2>Why partners switch to PPD Technology</h2>
          <p class="pp-sub">
            Stop selling the same systems every other agent has access to. We help you build a software advantage around the niche you already know best.
          </p>
        </div>

        <div class="pp-switch-grid reveal">
          <div class="pp-switch-card">
            <div class="pp-switch-icon"><i class="fa-solid fa-code"></i></div>
            <h3>Turn Your Niche Into Software</h3>
            <p>Most agents win in one or two verticals. We help you turn that focus into a custom POS or software solution built around the exact merchants you already serve.</p>
          </div>
          <div class="pp-switch-card">
            <div class="pp-switch-icon"><i class="fa-solid fa-ban"></i></div>
            <h3>Stop Selling Generic POS</h3>
            <p>Instead of pitching the same terminals, devices, and software every other ISO has, you can walk in with a niche-specific solution that feels built for the merchant.</p>
          </div>
          <div class="pp-switch-card">
            <div class="pp-switch-icon"><i class="fa-solid fa-money-check-dollar"></i></div>
            <h3>Earn Software Fees + Processing</h3>
            <p>Give merchants a better system and create a second revenue stream. Partners can earn software fees while still building processing volume and residual income.</p>
          </div>
          <div class="pp-switch-card">
            <div class="pp-switch-icon"><i class="fa-solid fa-arrow-trend-up"></i></div>
            <h3>Grow Through Happier Merchants</h3>
            <p>When your merchants get software that actually fits how they operate, retention improves, referrals become easier, and your book of business can move to the next level.</p>
          </div>
        </div>

        <div class="pp-switch-cta reveal">
          <p>Tell us the niche you win in, and we'll help map out the software your merchants would actually pay for.</p>
          <button class="pp-btn pp-btn-primary" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">
            Book a Vertical Strategy Call <i class="fa-regular fa-calendar"></i>
          </button>
        </div>
      </div>
    </section>

    <section class="pp-section pp-section-dark" id="why-switch">
      <div class="pp-container">
        <div class="pp-section-head reveal">
          <span class="pp-eyebrow"><i class="fa-solid fa-user-tie"></i> Built for Seasoned Sales Agents</span>
          <h2>What makes PPD different</h2>
          <p class="pp-sub-light">
            We help you turn your strongest niche into a custom payment software offer, so you can stand out, win better merchants, and scale beyond generic ISO selling.
          </p>
        </div>

        <div class="pp-diff-split reveal">
          <div class="pp-diff-copy">
            <div class="pp-diff-headline">
              <div class="pp-diff-headline-icon"><i class="fa-solid fa-code"></i></div>
              <h3>We make you custom payment software for your main niche.</h3>
            </div>
            <p class="pp-diff-body">You can still sell the typical Clover, Dejavoo, terminals, gateways, and processing solutions. But if every other agent has access to the same tools, you need something that makes you different. PPD Technology helps you create that edge with niche-specific software built around the merchants you already understand.</p>
            <p class="pp-diff-body">We work with seasoned sales agents who are ready to move to the next level. Bring us the niche you already sell into, and we'll help you shape a software-driven offer that makes your pitch stronger, your merchants stickier, and your book easier to grow.</p>
            <div class="pp-diff-cta">
              <button class="pp-btn pp-btn-primary" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">
                Book a Strategy Call <i class="fa-solid fa-arrow-right"></i>
              </button>
              <span class="pp-diff-cta-note">Tell us your niche. We'll show you what your software advantage could look like.</span>
            </div>
          </div>

          <div class="pp-diff-mock" aria-hidden="true">
            <div class="pp-dash-header">
              <div class="pp-dash-dots"><span></span><span></span><span></span></div>
              <span class="pp-dash-title">Custom Niche POS</span>
            </div>
            <div class="pp-diff-mock-body">
              <div class="pp-diff-tabs">
                <span class="pp-diff-tab active">Repair Shops</span>
                <span class="pp-diff-tab">Restaurants</span>
                <span class="pp-diff-tab">Retail</span>
                <span class="pp-diff-tab">Field Services</span>
              </div>

              <div class="pp-diff-stats">
                <div class="pp-diff-stat">
                  <div class="lbl"><i class="fa-solid fa-code"></i> Software Fees</div>
                  <div class="val">$4,120<small>+14%</small></div>
                </div>
                <div class="pp-diff-stat">
                  <div class="lbl"><i class="fa-solid fa-chart-line"></i> Processing Volume</div>
                  <div class="val">$1.2M</div>
                </div>
                <div class="pp-diff-stat">
                  <div class="lbl"><i class="fa-solid fa-store"></i> Active Merchants</div>
                  <div class="val">84</div>
                </div>
                <div class="pp-diff-stat">
                  <div class="lbl"><i class="fa-solid fa-users"></i> Referrals</div>
                  <div class="val">23<small>+6</small></div>
                </div>
              </div>

              <div class="pp-diff-panels">
                <div class="pp-diff-panel">
                  <div class="pp-diff-panel-title"><i class="fa-solid fa-credit-card"></i> Checkout</div>
                  <div class="pp-diff-checkout-amt">$248.50</div>
                  <div class="pp-diff-checkout-line"><span>Ticket #4821</span><span>Card ****4821</span></div>
                  <div class="pp-diff-pay-btn"><i class="fa-solid fa-lock"></i> Charge Card</div>
                </div>
                <div class="pp-diff-panel">
                  <div class="pp-diff-panel-title"><i class="fa-solid fa-user-gear"></i> Merchants</div>
                  <div class="pp-diff-merchant">
                    <div class="pp-diff-avatar">RC</div>
                    <div class="pp-diff-merchant-info">
                      <div class="pp-diff-merchant-name">Riverside Repair Co.</div>
                      <div class="pp-diff-merchant-sub">Active &middot; Software + Processing</div>
                    </div>
                    <span class="pp-diff-dot"></span>
                  </div>
                  <div class="pp-diff-merchant">
                    <div class="pp-diff-avatar">DT</div>
                    <div class="pp-diff-merchant-info">
                      <div class="pp-diff-merchant-name">Downtown Devices</div>
                      <div class="pp-diff-merchant-sub">Active &middot; Software + Processing</div>
                    </div>
                    <span class="pp-diff-dot"></span>
                  </div>
                </div>
              </div>

              <div class="pp-diff-chart">
                <div class="pp-diff-panel-title"><i class="fa-solid fa-chart-simple"></i> Revenue Activity</div>
                <div class="pp-diff-bars">
                  <span style="height:42%"></span>
                  <span style="height:58%"></span>
                  <span style="height:48%"></span>
                  <span style="height:72%"></span>
                  <span style="height:64%"></span>
                  <span style="height:86%"></span>
                  <span style="height:100%"></span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="pp-value-grid pp-diff-support reveal">
          <div class="pp-value-card">
            <div class="pp-value-icon"><i class="fa-solid fa-credit-card"></i></div>
            <h3>Still Sell the Hardware</h3>
            <p>Keep offering Clover, Dejavoo, terminals, gateways, and standard processing when they fit. We simply give you a stronger software story to lead with.</p>
          </div>
          <div class="pp-value-card">
            <div class="pp-value-icon"><i class="fa-solid fa-bullseye"></i></div>
            <h3>Own a Better Pitch</h3>
            <p>Instead of sounding like every other ISO, you can show merchants a solution designed around their industry, workflow, and pain points.</p>
          </div>
          <div class="pp-value-card">
            <div class="pp-value-icon"><i class="fa-solid fa-arrow-trend-up"></i></div>
            <h3>Scale Your Book Faster</h3>
            <p>Better software creates stickier merchants, stronger referrals, and more reasons for business owners to choose you over the next agent.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section" id="tiers">
      <div class="pp-container">
        <div class="pp-hw-split reveal">
          <div class="pp-hw-copy">
            <span class="pp-chip"><i class="fa-solid fa-layer-group"></i> Hardware + Software</span>
            <h2>Sell the hardware you know. Lead with software that makes you different.</h2>
            <p class="pp-sub">You can still sell the well-known hardware your merchants already recognize — Clover, Dejavoo, Valor, terminals, gateways, and standard processing. PPD Technology helps you add the custom niche software layer that makes your offer stand out.</p>
            <p class="pp-hw-body">Most agents have access to the same devices and payment tools. That makes it hard to separate yourself from the next ISO walking through the door. With PPD Technology, you can keep selling the hardware you trust while giving merchants a custom software solution built around their industry, workflow, and pain points.</p>
            <p class="pp-hw-body">That means a stronger pitch, stickier merchants, more referral opportunities, and the ability to earn software fees in addition to processing revenue.</p>
            <div class="pp-hw-cta">
              <button class="pp-btn pp-btn-primary" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">
                Build My Software Advantage <i class="fa-solid fa-arrow-right"></i>
              </button>
              <span class="pp-hw-cta-note">Bring us your main niche. We'll help you turn it into a stronger merchant offer.</span>
            </div>
          </div>

          <div class="pp-hw-visual">
            <div class="pp-hw-visual-head">
              <i class="fa-solid fa-shapes"></i>
              <span>Hardware You Know + Software That Stands Out</span>
            </div>

            <div class="pp-hw-devices">
              <div class="pp-hw-device">
                <!-- Approved Clover product asset. Swap here for an updated Clover image if needed. -->
                <img src="/images/Clover/Clover%20solo.png" alt="Clover payment device" loading="lazy" width="200" height="74" />
                <span>Clover</span>
              </div>
              <div class="pp-hw-device">
                <!-- Approved Valor (VP800) product asset. Swap here for an updated Valor image if needed. -->
                <img src="/images/VP800-View-01.png" alt="Valor VP800 payment device" loading="lazy" width="200" height="74" />
                <span>Valor</span>
              </div>
              <div class="pp-hw-device pp-hw-device--placeholder">
                <!-- TODO: No approved Dejavoo product image in the project yet.
                     Add one to /public/images (e.g. /images/dejavoo-device.png) and
                     replace this placeholder block with an <img> like the tiles above. -->
                <div class="pp-hw-device-ph"><i class="fa-solid fa-mobile-screen-button"></i></div>
                <span>Dejavoo</span>
              </div>
            </div>

            <div class="pp-hw-dash">
              <div class="pp-hw-dash-top">
                <span class="pp-hw-dash-title"><i class="fa-solid fa-desktop"></i> Custom Niche POS</span>
                <span class="pp-hw-dash-tag">Merchant Dashboard</span>
              </div>
              <div class="pp-hw-dash-stats">
                <div><span>Software Fees</span><strong>$4,120</strong></div>
                <div><span>Processing Volume</span><strong>$1.2M</strong></div>
                <div><span>Referrals</span><strong>23</strong></div>
              </div>
            </div>
          </div>
        </div>

        <div class="pp-hw-support reveal">
          <div class="pp-switch-card">
            <div class="pp-switch-icon"><i class="fa-solid fa-mobile-screen-button"></i></div>
            <h3>Keep Selling Familiar Devices</h3>
            <p>Clover, Dejavoo, Valor, terminals, gateways, and processing can still be part of your offer.</p>
          </div>
          <div class="pp-switch-card">
            <div class="pp-switch-icon"><i class="fa-solid fa-code"></i></div>
            <h3>Add a Custom Software Layer</h3>
            <p>We help you create niche-specific software that gives merchants a reason to choose you over another agent.</p>
          </div>
          <div class="pp-switch-card">
            <div class="pp-switch-icon"><i class="fa-solid fa-sack-dollar"></i></div>
            <h3>Earn More From Each Relationship</h3>
            <p>Add software fees, improve retention, create stronger referrals, and grow your book beyond processing alone.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section pp-section-alt" id="tools">
      <div class="pp-container">
        <div class="pp-section-head reveal">
          <span class="pp-chip"><i class="fa-solid fa-grid-2"></i> Enablement Platform</span>
          <h2>Tools other ISOs do not give you</h2>
          <p class="pp-sub">PPD Technology gives partners more than processing. We help you build the software, sales systems, and acquisition engine needed to grow a stronger book.</p>
        </div>

        <div class="pp-tools-grid reveal">
          <div class="pp-tool-card">
            <i class="fa-solid fa-code"></i>
            <h3>Custom Vertical Software for Your Main Niche</h3>
            <p>We help you create a niche-specific POS or merchant software solution so you can offer something your competitors cannot easily copy.</p>
          </div>
          <div class="pp-tool-card">
            <i class="fa-solid fa-table-columns"></i>
            <h3>Custom ISO CRM</h3>
            <p>Manage leads, merchants, follow-ups, onboarding, deal stages, and partner activity in a CRM built around how ISOs and agents actually sell.</p>
          </div>
          <div class="pp-tool-card">
            <i class="fa-solid fa-globe"></i>
            <h3>Websites & Merchant Acquisition</h3>
            <p>We can help you build landing pages, niche websites, and merchant acquisition funnels that position you as the go-to solution in your vertical.</p>
          </div>
          <div class="pp-tool-card">
            <i class="fa-solid fa-bullhorn"></i>
            <h3>Partner Sales Assets</h3>
            <p>Get sharper positioning, sales materials, and niche-specific messaging that make your offer easier for merchants to understand.</p>
          </div>
          <div class="pp-tool-card">
            <i class="fa-solid fa-file-signature"></i>
            <h3>Merchant Onboarding Support</h3>
            <p>Give merchants a cleaner path from application to launch with support around setup, implementation, and next steps.</p>
          </div>
          <div class="pp-tool-card">
            <i class="fa-solid fa-users"></i>
            <h3>Portfolio Growth Strategy</h3>
            <p>We help you identify the best verticals, offers, and acquisition channels so you can grow with a more focused plan.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section" id="testimonials">
      <div class="pp-container">
        <div class="pp-section-head reveal">
          <span class="pp-chip"><i class="fa-solid fa-star"></i> Partner Stories</span>
          <h2>Partners who built momentum with PPD</h2>
        </div>

        <div class="pp-testimonials reveal">
          <div class="pp-quote">
            <div class="pp-quote-body">
              <i class="fa-solid fa-quote-left pp-quote-mark"></i>
              <p>"I was tired of chasing my old processor for answers every time a merchant had an issue. With PPD, I call the support desk and someone actually picks up. That alone made the switch worth it — my merchants stopped complaining and I stopped putting out fires."</p>
            </div>
            <div class="pp-quote-footer">
              <div class="pp-quote-avatar">MJ</div>
              <div>
                <div class="pp-quote-name">Michael J.</div>
                <div class="pp-quote-role">Sales Partner &middot; 3 years</div>
              </div>
            </div>
          </div>
          <div class="pp-quote">
            <div class="pp-quote-body">
              <i class="fa-solid fa-quote-left pp-quote-mark"></i>
              <p>"We moved about 60 accounts over six months. The part that surprised me was underwriting — apps that used to sit for two weeks were getting approved in a couple days. My agents noticed it too. Less follow-up, less hand-holding, more time selling."</p>
            </div>
            <div class="pp-quote-footer">
              <div class="pp-quote-avatar">SR</div>
              <div>
                <div class="pp-quote-name">Sarah R.</div>
                <div class="pp-quote-role">ISO Partner &middot; 5 years</div>
              </div>
            </div>
          </div>
          <div class="pp-quote">
            <div class="pp-quote-body">
              <i class="fa-solid fa-quote-left pp-quote-mark"></i>
              <p>"I'm not a full-time payments guy — I do IT work and my clients always ask who I recommend for processing. I just send them to PPD and get a check when they sign up. It's been a nice side income without having to learn a whole new industry."</p>
            </div>
            <div class="pp-quote-footer">
              <div class="pp-quote-avatar">JP</div>
              <div>
                <div class="pp-quote-name">John P.</div>
                <div class="pp-quote-role">Referral Partner &middot; 1 year</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section pp-section-dark pp-section-tight" id="book">
      <div class="pp-container">
        <div class="pp-cta-split reveal">
          <div class="pp-cta-left">
            <h2>Ready to compare?</h2>
            <p class="pp-sub-light">
              Pick a time that works. Bring your current deal sheet (redacted is fine) and we'll compare side-by-side.
            </p>
            <div class="pp-cta-btns">
              <a class="pp-btn pp-btn-primary" href="#partner-form">Apply Now <i class="fa-solid fa-arrow-right"></i></a>
              <a class="pp-btn pp-btn-outline" href="#compare">View Compare Table <i class="fa-solid fa-table"></i></a>
            </div>
          </div>
          <div class="pp-cta-right">
            <div class="pp-calendar-shell">
              <div class="pp-calendar-head">
                <i class="fa-regular fa-calendar"></i> Book a Quick Compare Call
              </div>
              <iframe
                class="pp-calendar-iframe"
                src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ34gwW6Fs4yYTWT4Y5PwFVZ9BDuuR_F9sdeCnIx3YhHz_pNa9FnkX-zimGF1LU92MD149NRVVMo?gv=true"
                title="Schedule a meeting"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section pp-section-tight" id="partner-form">
      <div class="pp-container">
        <div class="pp-form-shell reveal">
          <div class="pp-form-head">
            <span class="pp-eyebrow pp-eyebrow-fit"><i class="fa-solid fa-rocket"></i> Apply</span>
            <h3>Become a Partner</h3>
            <p>Fill out the form and our partnership team will contact you.</p>
          </div>
          <div class="pp-form-body">
            <form id="partnerForm" action="/api/lead" method="POST">
              <input type="hidden" name="_form" value="become-a-partner" />
              <input type="hidden" name="_subject" value="New Partner Application" />
              <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" aria-hidden="true" />
              <div class="pp-form-grid">
                <div class="pp-fg">
                  <label for="firstName">First Name</label>
                  <input type="text" id="firstName" name="firstName" required />
                </div>
                <div class="pp-fg">
                  <label for="lastName">Last Name</label>
                  <input type="text" id="lastName" name="lastName" required />
                </div>
                <div class="pp-fg">
                  <label for="email">Email Address</label>
                  <input type="email" id="email" name="email" required />
                </div>
                <div class="pp-fg">
                  <label for="phone">Phone Number</label>
                  <input type="tel" id="phone" name="phone" required />
                </div>
                <div class="pp-fg">
                  <label for="company">Company Name</label>
                  <input type="text" id="company" name="company" />
                </div>
                <div class="pp-fg">
                  <label for="experience">Years in Payments</label>
                  <select id="experience" name="experience" required>
                    <option value="">Select</option>
                    <option value="0-1">0-1 years</option>
                    <option value="1-3">1-3 years</option>
                    <option value="3-5">3-5 years</option>
                    <option value="5+">5+ years</option>
                  </select>
                </div>
                <div class="pp-fg">
                  <label for="partnerType">Partner Type</label>
                  <select id="partnerType" name="partnerType" required>
                    <option value="">Select</option>
                    <option value="referral">Referral Partner</option>
                    <option value="sales">Sales Partner</option>
                    <option value="iso">ISO Partner</option>
                  </select>
                </div>
                <div class="pp-fg">
                  <label for="volume">Monthly Processing Volume</label>
                  <select id="volume" name="volume" required>
                    <option value="">Select</option>
                    <option value="0-100k">$0 - $100,000</option>
                    <option value="100k-500k">$100,000 - $500,000</option>
                    <option value="500k-5m">$500,000 - $5,000,000</option>
                    <option value="5m+">$5,000,000+</option>
                  </select>
                </div>
                <div class="pp-fg pp-full">
                  <label for="message">Additional Information</label>
                  <textarea id="message" name="message" rows="3" placeholder="Tell us about your business and partnership goals..."></textarea>
                </div>
              </div>
              <div class="pp-form-actions">
                <button class="pp-btn pp-btn-primary" type="submit">Submit Application <i class="fa-solid fa-arrow-right"></i></button>
                <button class="pp-btn pp-btn-ghost" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">Book a Call Instead <i class="fa-regular fa-calendar"></i></button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

  </div>

  <style>
    .partner-page{
      --pp-primary:#1549FF;
      --pp-primary-dark:#0F38CC;
      --pp-navy:#060E21;
      --pp-navy-2:#0C1A38;
      --pp-accent:#00E5A0;
      --pp-cyan:#00CFFF;
      --pp-surface:#F5F8FF;
      --pp-card:#FFFFFF;
      --pp-text:#060E21;
      --pp-muted:#5E7A9A;
      --pp-border:#E2E8F4;
      --pp-shadow:0 10px 30px rgba(2,6,23,.08);
      --pp-shadow-lg:0 20px 50px rgba(2,6,23,.12);
