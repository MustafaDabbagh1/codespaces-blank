    .pp-diff-mock-body{padding:16px;display:flex;flex-direction:column;gap:14px}
    .pp-diff-tabs{display:flex;flex-wrap:wrap;gap:8px}
    .pp-diff-tab{
      padding:7px 14px;border-radius:999px;font-size:12px;font-weight:700;
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.6);
    }
    .pp-diff-tab.active{
      background:linear-gradient(135deg,var(--pp-primary),var(--pp-cyan));
      border-color:transparent;color:#fff;
    }
    .pp-diff-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .pp-diff-stat{
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
      border-radius:12px;padding:12px 14px;
    }
    .pp-diff-stat .lbl{font-size:10px;text-transform:uppercase;letter-spacing:.07em;color:rgba(255,255,255,.5);font-weight:700;display:flex;align-items:center;gap:6px}
    .pp-diff-stat .lbl i{color:var(--pp-cyan)}
    .pp-diff-stat .val{font-size:20px;font-weight:900;margin-top:5px;letter-spacing:-.02em;color:#fff}
    .pp-diff-stat .val small{font-size:11px;font-weight:800;color:var(--pp-accent);margin-left:6px}
    .pp-diff-panels{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .pp-diff-panel{
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
      border-radius:12px;padding:14px;
    }
    .pp-diff-panel-title{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.5);font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:7px}
    .pp-diff-panel-title i{color:var(--pp-cyan)}
    .pp-diff-checkout-amt{font-size:24px;font-weight:900;color:#fff;letter-spacing:-.02em}
    .pp-diff-checkout-line{display:flex;justify-content:space-between;font-size:11px;color:rgba(255,255,255,.55);margin-top:8px;font-weight:600}
    .pp-diff-pay-btn{
      margin-top:12px;width:100%;padding:9px;border-radius:9px;border:none;cursor:default;
      background:linear-gradient(135deg,#2D60FF,var(--pp-primary));color:#fff;font-weight:800;font-size:12px;
      display:flex;align-items:center;justify-content:center;gap:7px;
    }
    .pp-diff-merchant{display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid rgba(255,255,255,.07)}
    .pp-diff-merchant:last-child{border-bottom:none;padding-bottom:0}
    .pp-diff-avatar{width:28px;height:28px;border-radius:8px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#fff;background:linear-gradient(135deg,var(--pp-primary),var(--pp-cyan))}
    .pp-diff-merchant-info{flex:1;min-width:0}
    .pp-diff-merchant-name{font-size:12px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .pp-diff-merchant-sub{font-size:10px;color:rgba(255,255,255,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .pp-diff-dot{width:7px;height:7px;border-radius:50%;background:var(--pp-accent);flex-shrink:0}
    .pp-diff-chart{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:14px}
    .pp-diff-bars{display:flex;align-items:flex-end;gap:6px;height:50px}
    .pp-diff-bars span{flex:1;border-radius:4px 4px 0 0;background:linear-gradient(180deg,var(--pp-cyan),var(--pp-primary));opacity:.85}
    .pp-diff-support{margin-top:32px}

    /* Ways to Partner — hardware + software */
    .pp-hw-split{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center}
    .pp-hw-copy .pp-chip{margin-bottom:16px}
    .pp-hw-copy h2{font-size:clamp(24px,3vw,34px);font-weight:900;letter-spacing:-.02em;line-height:1.18;margin-bottom:14px;color:var(--pp-navy)}
    .pp-hw-copy .pp-sub{margin-bottom:16px}
    .pp-hw-body{color:var(--pp-muted);font-size:15px;line-height:1.7;margin-bottom:14px}
    .pp-hw-cta{display:flex;flex-direction:column;gap:12px;margin-top:22px}
    .pp-hw-cta .pp-btn{width:fit-content}
    .pp-hw-cta-note{color:var(--pp-muted);font-size:13px;font-weight:600;max-width:46ch}

    .pp-hw-visual{
      background:linear-gradient(160deg,#fff,#F5F8FF);
      border:1px solid var(--pp-border);border-radius:20px;padding:22px;
      box-shadow:var(--pp-shadow-lg);position:relative;overflow:hidden;
    }
    .pp-hw-visual::before{
      content:"";position:absolute;inset:auto -30% -40% auto;width:320px;height:320px;border-radius:50%;
      background:radial-gradient(circle,rgba(0,207,255,.14),transparent 65%);pointer-events:none;
    }
    .pp-hw-visual-head{display:flex;align-items:center;gap:11px;font-weight:800;font-size:14px;color:var(--pp-navy);margin-bottom:18px;position:relative;z-index:1}
    .pp-hw-visual-head i{width:34px;height:34px;border-radius:10px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--pp-primary),var(--pp-cyan));color:#fff;font-size:15px}
    .pp-hw-devices{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px;position:relative;z-index:1}
    .pp-hw-device{
      background:#fff;border:1px solid var(--pp-border);border-radius:14px;padding:14px 10px;
      display:flex;flex-direction:column;align-items:center;gap:10px;box-shadow:var(--pp-shadow);
      transition:transform .2s,box-shadow .2s;
    }
    .pp-hw-device:hover{transform:translateY(-4px);box-shadow:var(--pp-shadow-lg)}
    .pp-hw-device img{width:100%;height:74px;object-fit:contain}
    .pp-hw-device span{font-size:12px;font-weight:800;color:var(--pp-navy)}
    .pp-hw-device-ph{
      width:100%;height:74px;border-radius:10px;display:flex;align-items:center;justify-content:center;
      background:rgba(21,73,255,.06);border:1px dashed rgba(21,73,255,.28);color:var(--pp-primary);font-size:26px;
    }
    .pp-hw-dash{
      background:linear-gradient(135deg,var(--pp-navy),#0A2B74);border-radius:14px;padding:16px;color:#fff;
      position:relative;z-index:1;border:1px solid rgba(255,255,255,.08);
    }
    .pp-hw-dash-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
    .pp-hw-dash-title{font-weight:800;font-size:13px;display:flex;align-items:center;gap:8px}
    .pp-hw-dash-title i{color:var(--pp-cyan)}
    .pp-hw-dash-tag{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;padding:5px 10px;border-radius:999px;background:rgba(0,207,255,.15);color:var(--pp-cyan);border:1px solid rgba(0,207,255,.25)}
    .pp-hw-dash-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
    .pp-hw-dash-stats > div{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:10px 12px}
    .pp-hw-dash-stats span{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.55);font-weight:700;margin-bottom:5px}
    .pp-hw-dash-stats strong{font-size:17px;font-weight:900;letter-spacing:-.02em}
    .pp-hw-support{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:32px}

    .pp-bad{color:#E11D48}
    .pp-muted-li{opacity:.45}

    .pp-tools-grid{
      display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:28px;
    }
    .pp-tool-card{
      background:var(--pp-surface);border:1px solid var(--pp-border);border-radius:var(--pp-radius);
      padding:24px;transition:transform .2s,box-shadow .2s,border-color .2s;
