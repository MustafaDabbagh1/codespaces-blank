---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Agents & ISOs Partner Program | PPD Technology" description="Join PPD Technology's partner program for agents and ISOs. Competitive revenue share, dedicated support, and a full suite of payment solutions to grow your portfolio.">
  <div class="partner-page">

    <section class="pp-hero">
      <div class="pp-container pp-hero-grid">
        <div class="reveal">
          <span class="pp-eyebrow"><i class="fa-solid fa-user-tie"></i> Sales Agents</span>
          <h1>Keep your book. Get a higher split. <span class="pp-hero-grad">Launch your own branded payment software.</span></h1>
          <p class="pp-sub">
            You already know how to sell payments. PPD Technology helps you take the next step with stronger economics, book ownership, and custom branded software built around the niche you know best.
          </p>
          <p class="pp-hero-support">
            Whether you focus on restaurants, repair shops, retail, contractors, med spas, or another vertical, we help you turn that niche into a software-driven offer merchants can actually get excited about.
          </p>
          <div class="pp-hero-ctas">
            <button class="pp-btn pp-btn-primary" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">
              Book an Agent Strategy Call <i class="fa-regular fa-calendar"></i>
            </button>
            <button class="pp-btn pp-btn-outline" type="button" onclick="document.getElementById('why-switch').scrollIntoView({behavior:'smooth'})">
              See how the software works <i class="fa-solid fa-arrow-right"></i>
            </button>
          </div>
          <div class="pp-trust-row">
            <span class="pp-trust-pill"><i class="fa-solid fa-book-bookmark"></i> Keep your book</span>
            <span class="pp-trust-pill"><i class="fa-solid fa-arrow-trend-up"></i> Higher agent split</span>
            <span class="pp-trust-pill"><i class="fa-solid fa-shapes"></i> Branded niche software</span>
            <span class="pp-trust-pill"><i class="fa-solid fa-layer-group"></i> Earn Software fees + Processing</span>
            <span class="pp-trust-pill"><i class="fa-solid fa-user-tie"></i> Built for seasoned agents</span>
          </div>
        </div>

        <div class="pp-bn-wrap reveal">
          <div class="pp-bn-mock" id="pp-bn-dash">
            <div class="pp-dash-header">
              <div class="pp-dash-dots"><span></span><span></span><span></span></div>
              <span class="pp-dash-title">Your Branded Niche Software</span>
              <span class="pp-bn-brandbadge"><i class="fa-solid fa-star"></i> Your Brand</span>
            </div>

            <div class="pp-bn-body">
              <div class="pp-bn-tabs" role="tablist" aria-label="Preview your branded software by niche">
                <button class="pp-bn-tab active" type="button" role="tab" id="pp-bn-tab-restaurants" data-niche="restaurants" aria-selected="true" aria-controls="pp-bn-panel" tabindex="0">Restaurants</button>
                <button class="pp-bn-tab" type="button" role="tab" id="pp-bn-tab-repair" data-niche="repair" aria-selected="false" aria-controls="pp-bn-panel" tabindex="-1">Repair Shops</button>
                <button class="pp-bn-tab" type="button" role="tab" id="pp-bn-tab-retail" data-niche="retail" aria-selected="false" aria-controls="pp-bn-panel" tabindex="-1">Retail</button>
                <button class="pp-bn-tab" type="button" role="tab" id="pp-bn-tab-contractors" data-niche="contractors" aria-selected="false" aria-controls="pp-bn-panel" tabindex="-1">Contractors</button>
                <button class="pp-bn-tab" type="button" role="tab" id="pp-bn-tab-medspas" data-niche="medspas" aria-selected="false" aria-controls="pp-bn-panel" tabindex="-1">Med Spas</button>
              </div>

              <div class="pp-bn-content" id="pp-bn-panel" role="tabpanel" aria-live="polite" aria-labelledby="pp-bn-tab-restaurants">
                <div class="pp-bn-head">
                  <div class="pp-bn-head-text">
                    <div class="pp-bn-title" data-field="title">RestaurantPay Pro</div>
                    <div class="pp-bn-desc" data-field="description">Orders, tabs, tips, loyalty, online ordering, and payment reporting in one branded system.</div>
                  </div>
                  <span class="pp-bn-tag">Custom Niche POS</span>
                </div>

                <div class="pp-bn-stats">
                  <div class="pp-bn-stat s-blue">
                    <div class="pp-bn-stat-ic"><i class="fa-solid fa-code"></i></div>
                    <div class="pp-bn-stat-meta">
                      <div class="pp-bn-stat-lbl">Software Fees</div>
                      <div class="pp-bn-stat-val" data-field="softwareFees">$5,860</div>
                    </div>
                  </div>
                  <div class="pp-bn-stat s-cyan">
                    <div class="pp-bn-stat-ic"><i class="fa-solid fa-chart-line"></i></div>
                    <div class="pp-bn-stat-meta">
                      <div class="pp-bn-stat-lbl">Processing Volume</div>
                      <div class="pp-bn-stat-val" data-field="processingVolume">$1.8M</div>
                    </div>
                  </div>
                  <div class="pp-bn-stat s-purple">
                    <div class="pp-bn-stat-ic"><i class="fa-solid fa-store"></i></div>
                    <div class="pp-bn-stat-meta">
                      <div class="pp-bn-stat-lbl">Active Merchants</div>
                      <div class="pp-bn-stat-val" data-field="activeMerchants">67</div>
                    </div>
                  </div>
                  <div class="pp-bn-stat s-green">
                    <div class="pp-bn-stat-ic"><i class="fa-solid fa-user-plus"></i></div>
                    <div class="pp-bn-stat-meta">
                      <div class="pp-bn-stat-lbl">Referrals</div>
                      <div class="pp-bn-stat-val" data-field="referrals">31</div>
                    </div>
                  </div>
                </div>

                <div class="pp-bn-panels">
                  <div class="pp-bn-panel">
                    <div class="pp-bn-panel-title"><i class="fa-solid fa-user-gear"></i> Merchant CRM</div>
                    <div class="pp-bn-merchants" data-field="merchants">
                      <div class="pp-bn-merch"><span class="pp-bn-avatar">HG</span><span class="pp-bn-merch-name">Harbor Grill</span><span class="pp-bn-merch-dot"></span></div>
                      <div class="pp-bn-merch"><span class="pp-bn-avatar">MT</span><span class="pp-bn-merch-name">Midtown Tacos</span><span class="pp-bn-merch-dot"></span></div>
                    </div>
                  </div>
                  <div class="pp-bn-panel">
                    <div class="pp-bn-panel-title"><i class="fa-solid fa-chart-simple"></i> Revenue</div>
                    <div class="pp-bn-bars" data-field="chart">
                      <span style="height:50%"></span><span style="height:64%"></span><span style="height:60%"></span><span style="height:78%"></span><span style="height:70%"></span><span style="height:90%"></span><span style="height:100%"></span>
                    </div>
                  </div>
                </div>

                <div class="pp-bn-modules" data-field="modules">
                  <span class="pp-bn-chip">Table Orders</span><span class="pp-bn-chip">Tip Management</span><span class="pp-bn-chip">Loyalty</span><span class="pp-bn-chip">Online Ordering</span>
                </div>

                <div class="pp-bn-panel">
                  <div class="pp-bn-panel-title"><i class="fa-solid fa-bell"></i> Recent Activity</div>
                  <div class="pp-bn-activity" data-field="activity">
                    <div class="pp-bn-act"><i class="fa-solid fa-circle-check"></i> Harbor Grill enabled online ordering</div>
                    <div class="pp-bn-act"><i class="fa-solid fa-user-plus"></i> New referral from Coastal Kitchen</div>
                  </div>
                </div>

                <div class="pp-bn-brandline"><i class="fa-solid fa-wand-magic-sparkles"></i> Branded by Your Agency</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section" id="compare">
      <div class="pp-container">
        <div class="pp-section-head reveal">
          <span class="pp-chip"><i class="fa-solid fa-arrow-right-arrow-left"></i> Why PPD</span>
          <h2>Why partners switch to PPD Technology</h2>
          <p class="pp-sub">
            Stop selling the same systems every other agent has access to. We help you build a software advantage around the niche you already know best.
          </p>
        </div>

        <div class="pp-switch-grid reveal">
          <div class="pp-switch-card">
            <div class="pp-switch-icon"><i class="fa-solid fa-code"></i></div>
            <h3>Turn Your Niche Into Software</h3>
            <p>Most agents win in one or two verticals. We help you turn that focus into a custom POS or software solution built around the exact merchants you already serve.</p>
          </div>
          <div class="pp-switch-card">
            <div class="pp-switch-icon"><i class="fa-solid fa-ban"></i></div>
            <h3>Stop Selling Generic POS</h3>
            <p>Instead of pitching the same terminals, devices, and software every other ISO has, you can walk in with a niche-specific solution that feels built for the merchant.</p>
          </div>
          <div class="pp-switch-card">
            <div class="pp-switch-icon"><i class="fa-solid fa-money-check-dollar"></i></div>
            <h3>Earn Software Fees + Processing</h3>
            <p>Give merchants a better system and create a second revenue stream. Partners can earn software fees while still building processing volume and residual income.</p>
          </div>
          <div class="pp-switch-card">
            <div class="pp-switch-icon"><i class="fa-solid fa-arrow-trend-up"></i></div>
            <h3>Grow Through Happier Merchants</h3>
            <p>When your merchants get software that actually fits how they operate, retention improves, referrals become easier, and your book of business can move to the next level.</p>
          </div>
        </div>

        <div class="pp-switch-cta reveal">
          <p>Tell us the niche you win in, and we'll help map out the software your merchants would actually pay for.</p>
          <button class="pp-btn pp-btn-primary" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">
            Book a Vertical Strategy Call <i class="fa-regular fa-calendar"></i>
          </button>
        </div>
      </div>
    </section>

    <section class="pp-section pp-section-dark" id="why-switch">
      <div class="pp-container">
        <div class="pp-section-head reveal">
          <span class="pp-eyebrow"><i class="fa-solid fa-user-tie"></i> Built for Seasoned Sales Agents</span>
          <h2>What makes PPD different</h2>
          <p class="pp-sub-light">
            We help you turn your strongest niche into a custom payment software offer, so you can stand out, win better merchants, and scale beyond generic ISO selling.
          </p>
        </div>

        <div class="pp-diff-split reveal">
          <div class="pp-diff-copy">
            <div class="pp-diff-headline">
              <div class="pp-diff-headline-icon"><i class="fa-solid fa-code"></i></div>
              <h3>We make you custom payment software for your main niche.</h3>
            </div>
            <p class="pp-diff-body">You can still sell the typical Clover, Dejavoo, Valor, terminals, gateways, and processing solutions. But when every agent has access to the same hardware, you need something that makes your pitch different. PPD Technology helps seasoned sales agents create custom software around the niche they already know best.</p>
            <p class="pp-diff-body">We work with seasoned sales agents who are ready to move to the next level. Bring us the niche you already sell into, and we'll help you shape a software-driven offer that makes your pitch stronger, your merchants stickier, and your book easier to grow.</p>
            <div class="pp-diff-cta">
              <button class="pp-btn pp-btn-primary" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">
                Book a Strategy Call <i class="fa-solid fa-arrow-right"></i>
              </button>
              <span class="pp-diff-cta-note">Tell us your niche. We'll show you what your software advantage could look like.</span>
            </div>
          </div>

          <div class="pp-diff-mock" id="pp-dash">
            <div class="pp-dash-header">
              <div class="pp-dash-dots"><span></span><span></span><span></span></div>
              <span class="pp-dash-title">Custom Niche POS</span>
            </div>
            <div class="pp-diff-mock-body">
              <div class="pp-diff-tabs" role="tablist" aria-label="Preview PPD software by niche">
                <button class="pp-diff-tab active" type="button" role="tab" id="pp-tab-repair" data-niche="repair" aria-selected="true" aria-controls="pp-diff-tabpanel">Repair Shops</button>
                <button class="pp-diff-tab" type="button" role="tab" id="pp-tab-restaurants" data-niche="restaurants" aria-selected="false" aria-controls="pp-diff-tabpanel" tabindex="-1">Restaurants</button>
                <button class="pp-diff-tab" type="button" role="tab" id="pp-tab-retail" data-niche="retail" aria-selected="false" aria-controls="pp-diff-tabpanel" tabindex="-1">Retail</button>
                <button class="pp-diff-tab" type="button" role="tab" id="pp-tab-field" data-niche="field" aria-selected="false" aria-controls="pp-diff-tabpanel" tabindex="-1">Field Services</button>
              </div>

              <div class="pp-diff-dashcontent" id="pp-diff-tabpanel" role="tabpanel" aria-live="polite" aria-labelledby="pp-tab-repair">
                <div class="pp-diff-dashhead">
                  <div class="pp-diff-dashhead-title" data-field="headline">Repair Shop POS + CRM</div>
                  <div class="pp-diff-dashhead-desc" data-field="description">Tickets, devices, estimates, payments, and warranties in one workflow.</div>
                </div>

                <div class="pp-diff-stats">
                  <div class="pp-diff-stat">
                    <div class="lbl"><i class="fa-solid fa-code"></i> Software Fees</div>
                    <div class="val"><span data-field="softwareFees">$4,120</span><small data-field="feesDelta">+14%</small></div>
                  </div>
                  <div class="pp-diff-stat">
                    <div class="lbl"><i class="fa-solid fa-chart-line"></i> Processing Volume</div>
                    <div class="val"><span data-field="processingVolume">$1.2M</span></div>
                  </div>
                  <div class="pp-diff-stat">
                    <div class="lbl"><i class="fa-solid fa-store"></i> Active Merchants</div>
                    <div class="val"><span data-field="activeMerchants">84</span></div>
                  </div>
                  <div class="pp-diff-stat">
                    <div class="lbl"><i class="fa-solid fa-users"></i> Referrals</div>
                    <div class="val"><span data-field="referrals">23</span><small data-field="refsDelta">+6</small></div>
                  </div>
                </div>

                <div class="pp-diff-panels">
                  <div class="pp-diff-panel">
                    <div class="pp-diff-panel-title"><i class="fa-solid fa-credit-card"></i> Checkout</div>
                    <div class="pp-diff-checkout-amt" data-field="checkoutAmount">$248.50</div>
                    <div class="pp-diff-checkout-line"><span data-field="ticketLabel">Ticket #4821</span><span data-field="cardLabel">Card **** 4821</span></div>
                    <button class="pp-diff-pay-btn" type="button" id="pp-charge-btn"><i class="fa-solid fa-lock"></i> Charge Card</button>
                  </div>
                  <div class="pp-diff-panel">
                    <div class="pp-diff-panel-title"><i class="fa-solid fa-user-gear"></i> Merchants</div>
                    <div class="pp-diff-merchants" data-field="merchants">
                      <div class="pp-diff-merchant">
                        <div class="pp-diff-avatar">RR</div>
                        <div class="pp-diff-merchant-info">
                          <div class="pp-diff-merchant-name">Riverside Repair Co.</div>
                          <div class="pp-diff-merchant-sub">Active &middot; Software + Processing</div>
                        </div>
                        <span class="pp-diff-dot"></span>
                      </div>
                      <div class="pp-diff-merchant">
                        <div class="pp-diff-avatar">DD</div>
                        <div class="pp-diff-merchant-info">
                          <div class="pp-diff-merchant-name">Downtown Devices</div>
                          <div class="pp-diff-merchant-sub">Active &middot; Software + Processing</div>
                        </div>
                        <span class="pp-diff-dot"></span>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="pp-diff-modules" data-field="modules">
                  <span class="pp-diff-chip">Repair Tickets</span>
                  <span class="pp-diff-chip">Device Intake</span>
                  <span class="pp-diff-chip">Warranty Tracking</span>
                  <span class="pp-diff-chip">SMS Updates</span>
                </div>

                <div class="pp-diff-chart">
                  <div class="pp-diff-panel-title"><i class="fa-solid fa-chart-simple"></i> Revenue Activity</div>
                  <div class="pp-diff-bars" data-field="chart">
                    <span style="height:42%"></span>
                    <span style="height:58%"></span>
                    <span style="height:48%"></span>
                    <span style="height:72%"></span>
                    <span style="height:64%"></span>
                    <span style="height:86%"></span>
                    <span style="height:100%"></span>
                  </div>
                </div>

                <button class="pp-diff-crm-toggle" type="button" id="pp-crm-toggle" aria-expanded="false" aria-controls="pp-crm-area">
                  <span class="pp-diff-crm-toggle-label">View CRM</span> <i class="fa-solid fa-chevron-down"></i>
                </button>

                <div class="pp-diff-crm" id="pp-crm-area" hidden>
                  <div class="pp-diff-panels">
                    <div class="pp-diff-panel">
                      <div class="pp-diff-panel-title"><i class="fa-solid fa-filter"></i> Pipeline</div>
                      <div class="pp-diff-pipeline" data-field="pipeline">
                        <div class="pp-diff-pl-row"><div class="pp-diff-pl-top"><span>New Lead</span><strong>12</strong></div><div class="pp-diff-pl-bar"><span style="width:14%"></span></div></div>
                        <div class="pp-diff-pl-row"><div class="pp-diff-pl-top"><span>Demo Booked</span><strong>7</strong></div><div class="pp-diff-pl-bar"><span style="width:8%"></span></div></div>
                        <div class="pp-diff-pl-row"><div class="pp-diff-pl-top"><span>Software Setup</span><strong>4</strong></div><div class="pp-diff-pl-bar"><span style="width:6%"></span></div></div>
                        <div class="pp-diff-pl-row"><div class="pp-diff-pl-top"><span>Live Merchant</span><strong>84</strong></div><div class="pp-diff-pl-bar"><span style="width:100%"></span></div></div>
                      </div>
                    </div>
                    <div class="pp-diff-panel">
                      <div class="pp-diff-panel-title"><i class="fa-solid fa-bell"></i> Recent Activity</div>
                      <div class="pp-diff-activity" data-field="activity">
                        <div class="pp-diff-act-row"><i class="fa-solid fa-circle-check"></i><span>Riverside Repair Co. closed 3 repair tickets today</span></div>
                        <div class="pp-diff-act-row"><i class="fa-solid fa-circle-check"></i><span>Downtown Devices added warranty tracking</span></div>
                        <div class="pp-diff-act-row"><i class="fa-solid fa-user-plus"></i><span>New referral from Northside Phone Repair</span></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="pp-value-grid pp-diff-support reveal">
          <div class="pp-value-card">
            <div class="pp-value-icon"><i class="fa-solid fa-credit-card"></i></div>
            <h3>Still Sell the Hardware</h3>
            <p>Keep offering Clover, Dejavoo, terminals, gateways, and standard processing when they fit. We simply give you a stronger software story to lead with.</p>
          </div>
          <div class="pp-value-card">
            <div class="pp-value-icon"><i class="fa-solid fa-bullseye"></i></div>
            <h3>Own a Better Pitch</h3>
            <p>Instead of sounding like every other ISO, you can show merchants a solution designed around their industry, workflow, and pain points.</p>
          </div>
          <div class="pp-value-card">
            <div class="pp-value-icon"><i class="fa-solid fa-arrow-trend-up"></i></div>
            <h3>Scale Your Book Faster</h3>
            <p>Better software creates stickier merchants, stronger referrals, and more reasons for business owners to choose you over the next agent.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section" id="tiers">
      <div class="pp-container">
        <div class="pp-hw-split reveal">
          <div class="pp-hw-copy">
            <span class="pp-chip"><i class="fa-solid fa-layer-group"></i> Hardware + Software</span>
            <h2>Sell the hardware you know. Lead with software that makes you different.</h2>
            <p class="pp-sub">You can still sell the well-known hardware your merchants already recognize — Clover, Dejavoo, Valor, terminals, gateways, and standard processing. PPD Technology helps you add the custom niche software layer that makes your offer stand out.</p>
            <p class="pp-hw-body">Most agents have access to the same devices and payment tools. That makes it hard to separate yourself from the next ISO walking through the door. With PPD Technology, you can keep selling the hardware you trust while giving merchants a custom software solution built around their industry, workflow, and pain points.</p>
            <p class="pp-hw-body">That means a stronger pitch, stickier merchants, more referral opportunities, and the ability to earn software fees in addition to processing revenue.</p>
            <div class="pp-hw-cta">
              <button class="pp-btn pp-btn-primary" type="button" onclick="document.getElementById('book').scrollIntoView({behavior:'smooth'})">
                Build My Software Advantage <i class="fa-solid fa-arrow-right"></i>
              </button>
              <span class="pp-hw-cta-note">Bring us your main niche. We'll help you turn it into a stronger merchant offer.</span>
            </div>
          </div>

          <div class="pp-hw-visual">
            <div class="pp-hw-visual-head">
              <i class="fa-solid fa-shapes"></i>
              <span>Hardware You Know + Software That Stands Out</span>
            </div>

            <div class="pp-hw-devices">
              <div class="pp-hw-device">
                <!-- Approved Clover product asset. Swap here for an updated Clover image if needed. -->
                <img src="/images/Clover/Clover%20solo.png" alt="Clover payment device" loading="lazy" width="200" height="74" />
                <span>Clover</span>
              </div>
              <div class="pp-hw-device">
                <!-- Approved Valor (VP800) product asset. Swap here for an updated Valor image if needed. -->
                <img src="/images/VP800-View-01.png" alt="Valor VP800 payment device" loading="lazy" width="200" height="74" />
                <span>Valor</span>
              </div>
              <div class="pp-hw-device">
                <!-- No approved Dejavoo product photo exists in the project assets, so this is a
                     clean branded CSS/SVG illustration of a Dejavoo-style countertop terminal.
                     When an approved Dejavoo image is added to /public/images, replace this
                     <div class="pp-hw-device-illus"> block with an <img> like the tiles above. -->
                <div class="pp-hw-device-illus" aria-hidden="true">
                  <svg viewBox="0 0 100 132" width="100" height="132" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <linearGradient id="pp-deja-screen" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#1549FF" />
                        <stop offset="1" stop-color="#00CFFF" />
                      </linearGradient>
                      <linearGradient id="pp-deja-body" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#12213f" />
                        <stop offset="1" stop-color="#0b1730" />
                      </linearGradient>
                    </defs>
                    <rect x="34" y="1.5" width="32" height="5" rx="2.5" fill="#1b2b4d" />
                    <rect x="22" y="4" width="56" height="124" rx="13" fill="url(#pp-deja-body)" stroke="rgba(255,255,255,.08)" stroke-width="1" />
                    <rect x="28.5" y="14" width="43" height="46" rx="5" fill="url(#pp-deja-screen)" />
                    <rect x="39" y="30" width="22" height="15" rx="2.5" fill="#ffffff" opacity="0.95" />
                    <rect x="42.5" y="33" width="6.5" height="5" rx="1.2" fill="#F5B301" />
                    <rect x="42" y="41" width="16" height="1.6" rx="0.8" fill="#0b1730" opacity="0.35" />
                    <path d="M55 24 a6 6 0 0 1 0 11" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" opacity="0.9" />
                    <path d="M58 21 a10 10 0 0 1 0 17" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" opacity="0.6" />
                    <g fill="rgba(255,255,255,.14)">
                      <rect x="31" y="67" width="10.5" height="9" rx="2.5" />
                      <rect x="44.75" y="67" width="10.5" height="9" rx="2.5" />
                      <rect x="58.5" y="67" width="10.5" height="9" rx="2.5" />
                      <rect x="31" y="80" width="10.5" height="9" rx="2.5" />
                      <rect x="44.75" y="80" width="10.5" height="9" rx="2.5" />
