---
import Landing from '../components/Landing.astro';

const features = [
  { title: 'POS and terminal setup', body: 'We configure your POS and terminals to apply cash discount or dual pricing automatically at checkout.' },
  { title: 'Compliant signage', body: 'In-store signage that clearly communicates your pricing, so customers know what to expect.' },
  { title: 'Receipt formatting', body: 'Receipts that show pricing accurately and transparently on every sale.' },
  { title: 'Customer-facing pricing display', body: 'Cash and card pricing shown clearly, so there are no surprises at the register.' },
  { title: 'Setup review', body: 'We review your current rates and setup to recommend the right program for your business.' },
  { title: 'Ongoing U.S.-based support', body: 'Our team is here after launch to answer questions and keep your program running smoothly.' },
];
const steps = [
  { name: '1. Request a review', note: 'Share a few details about your business and current processing setup.', href: '/rate-review' },
  { name: '2. We build your program', note: 'We recommend a compliant cash discount or dual-pricing setup for your industry.' },
  { name: '3. Launch with support', note: 'We set up your POS, signage and receipts, then support you after go-live.' },
];
---

<Landing
  title="Cash discount and dual pricing programs | PPD Technology"
  description="Offset payment processing costs with a compliant cash discount or dual-pricing program, with the POS setup, signage and support to match."
  accent={{ rgb: '46, 211, 160', main: '#12a67c', soft: '#6ef0c6' }}
  eyebrow="Cash discount and dual pricing"
  headline={['Keep more of', 'every transaction.']}
  lede="Offset your processing costs with a compliant cash discount or dual-pricing program. We review your current setup and roll it out the right way, with the POS setup, signage and support to match."
  cta={[{ label: 'Request a cash discount review', href: '/rate-review' }, { label: 'Talk to our team', href: '/contact' }]}
  statement="These programs let you pass along the cost of card acceptance, or offer a discount against it. The key is doing it correctly, and clearly for your customers."
  featuresHead={{ eyebrow: 'What PPD handles for you', title: 'Everything needed to launch a clean, transparent program.' }}
  features={features}
  gear={{ eyebrow: 'How it works', title: 'From review to launch.', items: steps }}
/>
