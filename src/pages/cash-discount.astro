---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Cash Discount & Dual Pricing Programs | PPD Technology"
  description="PPD Technology helps businesses implement compliant cash discount and dual-pricing programs — POS setup, signage, receipt formatting, customer-facing pricing display, and ongoing support."
>
  <div class="cd-page">
    <!-- ══════════════ HERO ══════════════ -->
    <section class="cd-hero">
      <div class="cd-hero__grid" aria-hidden="true"></div>
      <div class="cd-hero__orb cd-hero__orb--1" aria-hidden="true"></div>
      <div class="cd-hero__orb cd-hero__orb--2" aria-hidden="true"></div>
      <div class="container cd-hero__inner">
        <span class="cd-pill"><i class="fa-solid fa-tags"></i> Cash Discount &amp; Dual Pricing</span>
        <h1>Cash Discount &amp; Dual Pricing Programs</h1>
        <p>
          Offset your payment processing costs with a compliant cash discount or
          dual-pricing program. PPD helps you review your current setup and roll it
          out the right way — with the POS setup, signage, and support to match.
        </p>
        <div class="cd-hero__actions">
          <a class="cd-btn cd-btn--primary" href="/rate-review">
            <i class="fa-solid fa-magnifying-glass-dollar"></i> Request a Cash Discount Review
          </a>
          <a class="cd-btn cd-btn--ghost" href="/contact">
            <i class="fa-solid fa-phone"></i> Talk to Our Team
          </a>
        </div>
      </div>
    </section>

    <!-- ══════════════ INTRO ══════════════ -->
    <section class="cd-intro">
      <div class="container cd-intro__inner">
        <h2>Keep more of every transaction</h2>
        <p>
          Cash discount and dual-pricing programs let you pass along, or offer a
          discount against, the cost of card acceptance — so processing fees stop
          eating into your margins. The key is doing it correctly and clearly for
          your customers. That's where we come in: PPD reviews your current setup and
          implements a program built for your business and your industry.
        </p>
      </div>
    </section>

    <!-- ══════════════ WHAT'S INCLUDED ══════════════ -->
    <section class="cd-features">
      <div class="container">
        <div class="cd-section-head">
          <h2>What PPD handles for you</h2>
          <p>Everything needed to launch a clean, transparent program.</p>
        </div>
        <div class="cd-grid">
          <div class="cd-feature">
            <div class="cd-feature__icon"><i class="fa-solid fa-cash-register"></i></div>
            <h3>POS &amp; terminal setup</h3>
            <p>We configure your POS and terminals to apply cash discount or dual pricing automatically at checkout.</p>
          </div>
          <div class="cd-feature">
            <div class="cd-feature__icon"><i class="fa-solid fa-sign-hanging"></i></div>
            <h3>Compliant signage</h3>
            <p>In-store signage that clearly communicates your pricing so customers know what to expect.</p>
          </div>
          <div class="cd-feature">
            <div class="cd-feature__icon"><i class="fa-solid fa-receipt"></i></div>
            <h3>Receipt formatting</h3>
            <p>Receipts formatted to show pricing accurately and transparently on every sale.</p>
          </div>
          <div class="cd-feature">
            <div class="cd-feature__icon"><i class="fa-solid fa-tag"></i></div>
            <h3>Customer-facing pricing display</h3>
            <p>Clear cash and card pricing shown to customers so there are no surprises at the register.</p>
          </div>
          <div class="cd-feature">
            <div class="cd-feature__icon"><i class="fa-solid fa-clipboard-check"></i></div>
            <h3>Setup review</h3>
            <p>We review your current rates and setup to recommend the right program for your business.</p>
          </div>
          <div class="cd-feature">
            <div class="cd-feature__icon"><i class="fa-solid fa-headset"></i></div>
            <h3>Ongoing U.S.-based support</h3>
            <p>Our team is here after launch to answer questions and keep your program running smoothly.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════ STEPS ══════════════ -->
    <section class="cd-steps">
      <div class="container">
        <div class="cd-section-head">
          <h2>How it works</h2>
          <p>A simple path from review to launch.</p>
        </div>
        <div class="cd-steps__row">
          <div class="cd-step">
            <span class="cd-step__num">1</span>
            <h3>Request a review</h3>
            <p>Share a few details about your business and current processing setup.</p>
          </div>
          <div class="cd-step">
            <span class="cd-step__num">2</span>
            <h3>We build your program</h3>
            <p>We recommend a compliant cash discount or dual-pricing setup for your industry.</p>
          </div>
          <div class="cd-step">
            <span class="cd-step__num">3</span>
            <h3>Launch with support</h3>
            <p>We set up your POS, signage, and receipts — then support you after go-live.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════ CTA ══════════════ -->
    <section class="cd-cta">
      <div class="container cd-cta__inner">
        <h2>Ready to lower your processing costs?</h2>
        <p>Request a free cash discount review and our team will help you find the right program.</p>
        <a class="cd-btn cd-btn--primary cd-btn--lg" href="/rate-review">
          <i class="fa-solid fa-magnifying-glass-dollar"></i> Request a Cash Discount Review
        </a>
        <p class="cd-cta__note">Prefer to talk? Call Sales at <a href="tel:2487260085">(248) 726-0085</a>.</p>
      </div>
    </section>
  </div>

  <style>
    .cd-page{
      --navy:#060E21;--navy-2:#0C1A38;--blue:#1549FF;--blue-mid:#2D60FF;
      --cyan:#00CFFF;--green:#00E5A0;--surface:#F5F8FF;
      --ink:#0b1732;--ink-2:#48587a;--line:#E2E8F4;
      background:var(--surface);color:var(--ink);
    }
    .cd-page *{box-sizing:border-box}
    .cd-page .container{width:100%;max-width:1120px;margin:0 auto;padding:0 20px}
    .cd-page h2{letter-spacing:-.02em}

    /* Buttons */
    .cd-btn{
      display:inline-flex;align-items:center;justify-content:center;gap:9px;
      padding:13px 24px;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer;
      text-decoration:none;transition:transform .2s,box-shadow .2s,background .2s,color .2s;border:1px solid transparent;
    }
    .cd-btn--lg{padding:16px 32px;font-size:16px}
    .cd-btn--primary{color:#fff;background:linear-gradient(135deg,var(--blue-mid),var(--blue));box-shadow:0 8px 28px rgba(21,73,255,.35)}
    .cd-btn--primary:hover{transform:translateY(-2px);box-shadow:0 14px 38px rgba(21,73,255,.45)}
    .cd-btn--ghost{color:#fff;background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.2)}
    .cd-btn--ghost:hover{background:rgba(255,255,255,.12)}

    /* Hero */
    .cd-hero{
      position:relative;overflow:hidden;color:#fff;
      background:
        radial-gradient(1200px 600px at 80% -10%,rgba(21,73,255,.28),transparent 60%),
        radial-gradient(900px 500px at 0% 20%,rgba(0,207,255,.14),transparent 55%),
        linear-gradient(160deg,var(--navy) 0%,var(--navy-2) 60%,#0a1c42 100%);
      padding:100px 0 72px;
    }
    .cd-hero__grid{
      position:absolute;inset:0;opacity:.5;pointer-events:none;
      background-image:radial-gradient(rgba(255,255,255,.06) 1px,transparent 1px);background-size:28px 28px;
      -webkit-mask-image:linear-gradient(180deg,#000,transparent 85%);mask-image:linear-gradient(180deg,#000,transparent 85%);
    }
    .cd-hero__orb{position:absolute;border-radius:50%;filter:blur(80px);opacity:.42;pointer-events:none}
    .cd-hero__orb--1{width:360px;height:360px;background:rgba(21,73,255,.55);top:-90px;right:-60px}
    .cd-hero__orb--2{width:300px;height:300px;background:rgba(0,207,255,.35);bottom:-120px;left:-50px}
    .cd-hero__inner{position:relative;z-index:1;text-align:center;max-width:780px;margin:0 auto}
    .cd-pill{
      display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;
      padding:7px 16px;border-radius:999px;margin-bottom:20px;
      background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);color:#fff;
    }
    .cd-pill i{color:var(--cyan)}
    .cd-hero h1{font-size:clamp(2.1rem,5vw,3.3rem);font-weight:800;letter-spacing:-.03em;line-height:1.1;margin:0 0 18px}
    .cd-hero p{font-size:clamp(1rem,1.8vw,1.15rem);line-height:1.7;color:rgba(255,255,255,.85);margin:0 auto 30px;max-width:640px}
    .cd-hero__actions{display:flex;flex-wrap:wrap;gap:14px;justify-content:center}

    /* Intro */
    .cd-intro{padding:64px 0 8px}
    .cd-intro__inner{max-width:820px;margin:0 auto;text-align:center}
    .cd-intro h2{font-size:clamp(1.7rem,3.5vw,2.3rem);font-weight:800;color:var(--navy);margin:0 0 16px}
    .cd-intro p{font-size:1.05rem;line-height:1.8;color:var(--ink-2);margin:0}

    /* Section head */
    .cd-section-head{text-align:center;max-width:640px;margin:0 auto 44px}
    .cd-section-head h2{font-size:clamp(1.7rem,3.5vw,2.3rem);font-weight:800;color:var(--navy);margin:0 0 12px}
    .cd-section-head p{font-size:1.02rem;color:var(--ink-2);margin:0}

    /* Features */
    .cd-features{padding:64px 0}
    .cd-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
    .cd-feature{background:#fff;border:1px solid var(--line);border-radius:16px;padding:28px;box-shadow:0 10px 30px rgba(12,26,56,.06);transition:transform .2s,box-shadow .2s}
    .cd-feature:hover{transform:translateY(-4px);box-shadow:0 18px 44px rgba(12,26,56,.12)}
    .cd-feature__icon{
      width:52px;height:52px;border-radius:13px;display:flex;align-items:center;justify-content:center;margin-bottom:16px;
      background:linear-gradient(135deg,rgba(21,73,255,.12),rgba(0,207,255,.12));color:var(--blue);font-size:22px;
    }
    .cd-feature h3{font-size:1.12rem;font-weight:700;color:var(--navy);margin:0 0 8px}
    .cd-feature p{font-size:.95rem;line-height:1.65;color:var(--ink-2);margin:0}

    /* Steps */
    .cd-steps{padding:20px 0 72px}
    .cd-steps__row{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
    .cd-step{position:relative;background:#fff;border:1px solid var(--line);border-radius:16px;padding:30px 26px;box-shadow:0 10px 30px rgba(12,26,56,.06)}
    .cd-step__num{
      display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;
      background:linear-gradient(135deg,var(--blue-mid),var(--blue));color:#fff;font-weight:800;font-size:1.05rem;margin-bottom:16px;
    }
    .cd-step h3{font-size:1.12rem;font-weight:700;color:var(--navy);margin:0 0 8px}
    .cd-step p{font-size:.95rem;line-height:1.65;color:var(--ink-2);margin:0}

    /* CTA */
    .cd-cta{padding:0 0 84px}
    .cd-cta__inner{
      position:relative;overflow:hidden;text-align:center;color:#fff;border-radius:24px;padding:56px 28px;
      background:
        radial-gradient(700px 300px at 50% -20%,rgba(0,207,255,.25),transparent 60%),
        linear-gradient(135deg,var(--navy),var(--navy-2));
      max-width:1120px;margin:0 auto;
    }
    .cd-cta h2{font-size:clamp(1.6rem,3.5vw,2.2rem);font-weight:800;margin:0 0 12px}
    .cd-cta p{font-size:1.05rem;color:rgba(255,255,255,.85);margin:0 auto 26px;max-width:520px}
    .cd-cta__note{font-size:.92rem;margin:20px 0 0}
    .cd-cta__note a{color:var(--cyan);font-weight:600}

    @media (max-width:860px){
      .cd-grid,.cd-steps__row{grid-template-columns:1fr 1fr}
    }
    @media (max-width:560px){
      .cd-grid,.cd-steps__row{grid-template-columns:1fr}
      .cd-hero{padding:88px 0 56px}
    }
    @media (prefers-reduced-motion: reduce){
      .cd-btn,.cd-feature{transition:none}
    }
  </style>
</BaseLayout>
