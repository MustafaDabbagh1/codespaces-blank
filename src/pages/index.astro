---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ForgeDemo from '../components/demos/ForgeDemo.astro';
import RepairDemo from '../components/demos/RepairDemo.astro';
import MerchantDemo from '../components/demos/MerchantDemo.astro';
import RewardsDemo from '../components/demos/RewardsDemo.astro';
import CookieCutter from '../components/agents/CookieCutter.astro';
import { products, industries, company } from '../data/site';

const processing = [
  { icon: 'chart', title: 'A free rate review', body: 'Send us a statement. We show you what you pay today and what it would look like with PPD, with no obligation.', href: '/rate-review', link: 'Request a review' },
  { icon: 'tag', title: 'Cash discount and dual pricing', body: 'Offset processing costs with a compliant program: POS setup, signage, receipts and customer-facing pricing handled.', href: '/cash-discount', link: 'How it works' },
  { icon: 'bolt', title: 'Next-day funding options', body: 'Batch out today and see the deposit sooner, with settlement reporting you can actually read.' },
  { icon: 'phone', title: 'U.S.-based support', body: `A team you can call. ${company.hours}.`, href: '/customer-support', link: 'Support center' },
  { icon: 'card', title: 'Hardware you already know', body: 'Clover, Dejavoo, Valor and SUNMI devices, configured by us and shipped ready for your counter.', href: '/products#lineup', link: 'See the lineup' },
  { icon: 'globe', title: 'Every way customers pay', body: 'At the counter, at the table, on an invoice, online or over the phone, reported in one place.' },
];

const agentPoints = [
  { title: 'Keep your book', body: 'Bring your relationships with you and grow them in a program built around agent ownership.' },
  { title: 'Sell software, not a rate sheet', body: 'Walk in with Forge, Repair, Merchant and Rewards, or with software built around your niche and branded as yours.' },
  { title: 'Earn on both lines', body: 'Software fees in addition to processing residuals, from merchants who have a reason to stay.' },
];
---

<SiteLayout
  title="PPD Technology | Payment processing and the software that runs on top"
  description="PPD Technology pairs payment processing with software we build ourselves: Forge POS, PPD Repair, PPD Merchant and PPD Rewards. For businesses that want more than a terminal, and agents who want more than an ISO."
>
  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section class="hero">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <p class="eyebrow reveal">Payments · Software · Partnership</p>
      <h1 class="h-hero reveal" style="--i:1">
        <span class="hero__l1">
          Not just your
          <span class="rot" aria-hidden="true">
            <span>processor.</span>
            <span>ISO.</span>
            <span>POS vendor.</span>
          </span>
          <span class="sr-only">processor, ISO or POS vendor.</span>
        </span>
        <span class="grad hero__l2">Your technology partner.</span>
      </h1>

      <div class="hero__row">
        <p class="lede reveal" style="--i:2">
          PPD Technology pairs payment processing with software we build ourselves. Merchants run their counter, their shop and their back office on it. Agents build a brand on it.
        </p>
        <div class="doors reveal" style="--i:3">
          <a class="door" href="/products">
            <span class="door__ic"><Icon name="store" size={22} /></span>
            <span class="door__t">I run a business</span>
            <span class="door__b">Software and processing to run on</span>
            <span class="door__go"><Icon name="arrow-right" size={18} /></span>
          </a>
          <a class="door door--agent" href="/agents">
            <span class="door__ic"><Icon name="briefcase" size={22} /></span>
            <span class="door__t">I sell payments</span>
            <span class="door__b">Become a software brand</span>
            <span class="door__go"><Icon name="arrow-right" size={18} /></span>
          </a>
        </div>
      </div>
    </div>

    <!-- suite strip -->
    <div class="wrap">
      <ul class="strip">
        {
          products.map((p, i) => (
            <li class:list={['reveal', `t-${p.key}`]} style={`--i:${i + 3}`}>
              <a class="tile" href={p.href}>
                <span class="tile__head">
                  <img src={p.icon} alt="" width="44" height="44" />
                  <span>
                    <b>{p.name}</b>
                    <small>{p.kind}</small>
                  </span>
                </span>

                <span class="tile__live" aria-hidden="true">
                  {p.key === 'forge' && (
                    <span class="mw mw--forge">
                      <span class="mw__row"><i>Cold Brew 12oz</i><em>EBT</em></span>
                      <span class="mw__dual"><b>Cash $4.25</b><b>Card $4.38</b></span>
                    </span>
                  )}
                  {p.key === 'repair' && (
                    <span class="mw mw--repair">
                      <span class="mw__cols"><i>In</i><i>Bench</i><i>Ready</i></span>
                      <span class="mw__ticket">TKT-1042</span>
                    </span>
                  )}
                  {p.key === 'merchant' && (
                    <span class="mw mw--merchant">
                      <span class="mw__row"><i>Invoice · Atlas Commercial</i></span>
                      <span class="mw__inv"><b>$4,250</b><span class="mw__flip"><em>Sent</em><em>Paid</em></span></span>
                    </span>
                  )}
                  {p.key === 'rewards' && (
                    <span class="mw mw--rewards">
                      <span class="mw__row"><i>Rewards wallet</i><em>+$12.40</em></span>
                      <span class="mw__bal"><b>$236.10</b><b>$248.50</b></span>
                    </span>
                  )}
                </span>

                <span class="tile__foot">{p.tagline} <Icon name="arrow-up-right" size={16} /></span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="hero__fine fine">{company.isoLine}</p>
    </div>
  </section>

  <!-- ── SUITE ────────────────────────────────────────────── -->
  <section class="section section--raised suite" id="suite">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow reveal">Built in-house</p>
        <h2 class="h-1 reveal" style="--i:1">Software we build.<br />Watch it work.</h2>
        <p class="lede reveal" style="--i:2">
          Most processors hand you someone else’s terminal. We write the software your day runs on, then stand behind the payments underneath it.
        </p>
      </div>

      <div class="tabs" data-tabs>
        <div class="tabs__list" role="tablist" aria-label="PPD products">
          {
            products.map((p, i) => (
              <button
                type="button"
                role="tab"
                id={`suite-tab-${p.key}`}
                aria-controls={`suite-panel-${p.key}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                class:list={[`t-${p.key}`]}
              >
                <img src={p.icon} alt="" width="28" height="28" loading="lazy" />
                {p.short}
              </button>
            ))
          }
        </div>

        {
          products.map((p, i) => (
            <div class:list={['tabs__panel', `t-${p.key}`]} role="tabpanel" id={`suite-panel-${p.key}`} aria-labelledby={`suite-tab-${p.key}`} hidden={i !== 0}>
              {p.key === 'forge' && (
                <ForgeDemo>
                  <p class="eyebrow">{p.kind}</p>
                  <h3 class="h-2">{p.tagline}</h3>
                </ForgeDemo>
              )}
              {p.key === 'repair' && (
                <RepairDemo>
                  <p class="eyebrow">{p.kind}</p>
                  <h3 class="h-2">{p.tagline}</h3>
                </RepairDemo>
              )}
              {p.key === 'merchant' && (
                <MerchantDemo>
                  <p class="eyebrow">{p.kind}</p>
                  <h3 class="h-2">{p.tagline}</h3>
                </MerchantDemo>
              )}
              {p.key === 'rewards' && (
                <RewardsDemo>
                  <p class="eyebrow">{p.kind}</p>
                  <h3 class="h-2">{p.tagline}</h3>
                </RewardsDemo>
              )}

              <div class="suite__foot">
                <div class="suite__fact">
                  <b>{p.price}</b>
                  <span>{p.priceNote}</span>
                </div>
                <div class="suite__fact suite__fact--wide">
                  <b>Built for</b>
                  <span>{p.audience}</span>
                </div>
                <div class="btn-row">
                  <a class="btn btn--accent" href={p.href}>Explore {p.short} <Icon name="arrow-right" /></a>
                  <a class="btn btn--ghost" href={p.site} rel="noopener">{p.siteLabel} <Icon name="arrow-up-right" /></a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── PROCESSING ───────────────────────────────────────── -->
  <section class="section section--paper">
    <div class="wrap proc">
      <div class="proc__head">
        <p class="eyebrow reveal">Merchant services</p>
        <h2 class="h-1 reveal" style="--i:1">The processing is the easy part.</h2>
        <p class="lede reveal" style="--i:2">
          Underneath the software is a straightforward merchant account: clear pricing, hardware set up before it ships, and people to call when something needs fixing.
        </p>
        <div class="btn-row reveal" style="--i:3">
          <a class="btn btn--primary" href="/rate-review">Get a free rate review <Icon name="arrow-right" /></a>
          <a class="btn btn--ghost" href="/signup">Start an application</a>
        </div>
      </div>
      <ul class="proc__grid">
        {
          processing.map((c, i) => (
            <li class="card reveal" style={`--i:${i % 3}`}>
              <span class="proc__ic"><Icon name={c.icon} size={20} /></span>
              <h3 class="h-3">{c.title}</h3>
              <p>{c.body}</p>
              {c.href && <a class="link-arrow" href={c.href}>{c.link} <Icon name="arrow-right" /></a>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── AGENTS ───────────────────────────────────────────── -->
  <section class="section agents" id="agents">
    <div class="agents__glow" aria-hidden="true"></div>
    <div class="wrap">
      <div class="section-head section-head--center">
        <p class="eyebrow eyebrow--plain reveal">For payment sales agents</p>
        <h2 class="h-1 reveal" style="--i:1">We’re not just your ISO.<br /><span class="grad">We’re your tech and branding partner.</span></h2>
        <p class="lede reveal" style="--i:2">
          Every ISO hands its agents the same terminals and the same rate sheet. We build the software, the brand and the sales system around the niche you already win in.
        </p>
      </div>

      <div class="reveal" style="--i:2">
        <CookieCutter />
      </div>

      <ul class="agents__points">
        {
          agentPoints.map((a, i) => (
            <li class="reveal" style={`--i:${i}`}>
              <span class="mono">0{i + 1}</span>
              <h3 class="h-3">{a.title}</h3>
              <p>{a.body}</p>
            </li>
          ))
        }
      </ul>

      <div class="btn-row agents__cta reveal">
        <a class="btn btn--primary" href="/agents">See the agent program <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost" href="/agents#book">Book a strategy call</a>
      </div>
    </div>
  </section>

  <!-- ── INDUSTRIES ───────────────────────────────────────── -->
  <section class="section section--raised">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow reveal">Industries</p>
        <h2 class="h-1 reveal" style="--i:1">Set up for the way your business actually takes money.</h2>
      </div>
      <ul class="ind">
        {
          industries.map((ind, i) => (
            <li class="reveal" style={`--i:${i % 3}`}>
              <a href={ind.href}>
                <span class="ind__n mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="ind__t">{ind.name}</span>
                <span class="ind__b">{ind.note}</span>
                <span class="ind__go"><Icon name="arrow-up-right" size={18} /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── CLOSE ────────────────────────────────────────────── -->
  <section class="section close">
    <div class="wrap close__grid">
      <div class="close__card reveal">
        <p class="eyebrow">Merchants</p>
        <h2 class="h-2">See what you’d pay, and what you’d run on.</h2>
        <p>A rate review and a product walkthrough, from people who will also be the ones supporting you.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/rate-review">Free rate review <Icon name="arrow-right" /></a>
          <a class="btn btn--ghost" href="/contact">Book a demo</a>
        </div>
      </div>
      <div class="close__card close__card--agent reveal" style="--i:1">
        <p class="eyebrow">Agents</p>
        <h2 class="h-2">Tell us the niche you win in.</h2>
        <p>We’ll map out the software your merchants would actually pay for, and what your brand looks like on it.</p>
        <div class="btn-row">
          <a class="btn" href="/agents#book">Book a strategy call <Icon name="arrow-right" /></a>
          <a class="btn btn--ghost" href="/agents">The agent program</a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  // Product tabs in the suite section.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(':scope > [role="tablist"] > [role="tab"]'));
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') || '');
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        let to = -1;
        if (e.key === 'ArrowRight') to = (i + 1) % tabs.length;
        if (e.key === 'ArrowLeft') to = (i - 1 + tabs.length) % tabs.length;
        if (e.key === 'Home') to = 0;
        if (e.key === 'End') to = tabs.length - 1;
        if (to < 0) return;
        e.preventDefault();
        select(tabs[to], true);
      });
    });
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ── hero ── */
  .hero {
    position: relative;
    padding: clamp(44px, 5.5vw, 76px) 0 clamp(56px, 7vw, 96px);
    overflow: hidden;
  }
  .hero__glow {
    position: absolute;
    left: 50%;
    top: -30%;
    width: min(1300px, 130vw);
    aspect-ratio: 1.6;
    translate: -50% 0;
    background:
      radial-gradient(40% 50% at 28% 45%, rgba(21, 73, 255, 0.5), transparent 70%),
      radial-gradient(34% 44% at 74% 38%, rgba(124, 77, 255, 0.28), transparent 70%);
    filter: blur(30px);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    gap: 24px;
  }
  .hero .h-hero {
    font-size: clamp(2.5rem, 6.6vw, 5.6rem);
  }
  .hero__l1,
  .hero__l2 {
    display: block;
  }
  .hero__l2 {
    padding-bottom: 0.08em;
  }
  .hero__row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    margin-top: 10px;
  }
  .rot {
    display: inline-grid;
    vertical-align: baseline;
  }
  .rot span {
    grid-area: 1 / 1;
    white-space: nowrap;
    animation: rot 9s var(--ease-out) infinite both;
  }
  .rot span:nth-child(2) {
    animation-delay: 3s;
  }
  .rot span:nth-child(3) {
    animation-delay: 6s;
  }
  @keyframes rot {
    0% {
      transform: translateY(0.35em);
      opacity: 0;
      filter: blur(6px);
    }
    5%,
    30% {
      transform: none;
      opacity: 1;
      filter: blur(0);
    }
    35%,
    100% {
      transform: translateY(-0.35em);
      opacity: 0;
      filter: blur(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rot span {
      animation: none;
      opacity: 0;
    }
    .rot span:first-child {
      opacity: 1;
    }
  }

  .doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .door {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    column-gap: 16px;
    align-items: center;
    padding: 18px 18px;
    border-radius: var(--r);
    border: 1px solid var(--line-2);
    background: rgba(255, 255, 255, 0.04);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition:
      transform 0.4s var(--ease-out),
      border-color 0.3s,
      background 0.3s;
  }
  .door:hover {
    transform: translateY(-3px);
    border-color: var(--blue-2);
    background: rgba(21, 73, 255, 0.16);
  }
  .door__ic {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--blue-3);
  }
  .door--agent .door__ic {
    background: var(--blue);
    color: #fff;
  }
  .door__t {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .door__b {
    grid-column: 2;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .door__go {
    grid-row: 1 / span 2;
    grid-column: 3;
    color: var(--muted);
    transition:
      transform 0.4s var(--ease-out),
      color 0.3s;
  }
  .door:hover .door__go {
    transform: translateX(5px);
    color: #fff;
  }

  .strip {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: clamp(36px, 4.5vw, 60px);
  }
  .tile {
    position: relative;
    display: grid;
    gap: 18px;
    height: 100%;
    padding: 20px;
    border-radius: var(--r);
    border: 1px solid var(--line);
    background:
      radial-gradient(120% 70% at 50% 120%, rgba(var(--accent-rgb), 0.34), transparent 70%),
      var(--ink-2);
    overflow: hidden;
    transition:
      transform 0.5s var(--ease-out),
      border-color 0.3s,
      box-shadow 0.5s;
  }
  .tile:hover {
    transform: translateY(-6px);
    border-color: rgba(var(--accent-rgb), 0.7);
    box-shadow: 0 30px 60px -30px rgba(var(--accent-rgb), 0.8);
  }
  .tile__head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .tile__head img {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    object-fit: contain;
  }
  .tile__head b {
    display: block;
    font-family: var(--font-display);
    font-size: 1.18rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .tile__head small {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .tile__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.92rem;
    line-height: 1.35;
    color: var(--muted);
  }
  .tile__foot :global(svg) {
    flex-shrink: 0;
    color: var(--accent-2);
  }

  /* micro widgets inside tiles */
  .mw {
    display: grid;
    gap: 8px;
    padding: 12px;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--line);
    font-size: 0.8rem;
  }
  .mw__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    color: var(--muted);
  }
  .mw i {
    font-style: normal;
  }
  .mw em {
    font-style: normal;
    font-weight: 700;
    font-size: 0.72rem;
    padding: 2px 8px;
    border-radius: 99px;
    color: var(--accent-2);
    background: rgba(var(--accent-rgb), 0.18);
  }
  .mw b {
    font-feature-settings: 'tnum' 1;
  }
  .mw__dual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .mw__dual b {
    padding: 7px 0;
    border-radius: 8px;
    text-align: center;
    background: rgba(255, 255, 255, 0.07);
    animation: mw-dual 4s ease-in-out infinite;
  }
  .mw__dual b:last-child {
    animation-delay: 2s;
  }
  .mw__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    color: var(--dim);
  }
  .mw__cols i {
    padding-bottom: 26px;
    border-bottom: 1px dashed var(--line-2);
    font-size: 0.7rem;
  }
  .mw--repair {
    position: relative;
  }
  .mw__ticket {
    position: absolute;
    left: 12px;
    bottom: 18px;
    width: calc((100% - 36px) / 3);
    padding: 3px 0;
    border-radius: 6px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    color: #fff;
    background: var(--repair);
    animation: mw-move 6s var(--ease-out) infinite;
  }
  .mw__inv,
  .mw__bal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 1.25rem;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }
  .mw__flip {
    display: inline-grid;
  }
  .mw__flip em {
    grid-area: 1 / 1;
    font-family: var(--font-body);
    animation: mw-swap 5s ease-in-out infinite;
  }
  .mw__flip em:last-child {
    color: #062b1b;
    background: var(--ok);
    animation-delay: 2.5s;
  }
  .mw__bal {
    display: grid;
  }
  .mw__bal b {
    grid-area: 1 / 1;
    color: var(--rewards-2);
    animation: mw-swap 5s ease-in-out infinite;
  }
  .mw__bal b:last-child {
    animation-delay: 2.5s;
  }
  .mw--rewards .mw__row em {
    animation: mw-swap 5s ease-in-out 2.5s infinite;
  }
  @keyframes mw-dual {
    0%,
    45%,
    100% {
      background: rgba(255, 255, 255, 0.07);
      color: inherit;
    }
    10%,
    35% {
      background: var(--forge);
      color: #1a0e03;
    }
  }
  @keyframes mw-move {
    0%,
    18% {
      transform: translateX(0);
    }
    33%,
    55% {
