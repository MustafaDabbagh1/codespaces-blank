}
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Reveal-on-scroll for [data-anim]
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('animated'); io.unobserve(e.target); } });
  }, {threshold:.15});
  document.querySelectorAll('[data-anim]').forEach(el => io.observe(el));

  // Count-up — supports prefix, suffix, decimals, and thousand separators
  function fmt(val, decimals, useCommas){
    if(useCommas){
      return val.toLocaleString(undefined,{minimumFractionDigits:decimals,maximumFractionDigits:decimals});
    }
    return val.toFixed(decimals);
  }
  document.querySelectorAll('[data-count]').forEach(el => {
    const target = parseFloat(el.dataset.count);
    const suffix = el.dataset.suffix || '';
    const prefix = el.dataset.prefix || '';
    const decimals = parseInt(el.dataset.decimals) || 0;
    const useCommas = el.dataset.commas === '1';
    if(prefersReducedMotion){
      el.textContent = prefix + fmt(target, decimals, useCommas) + suffix;
      return;
    }
    el.textContent = prefix + '0' + suffix;
    const obs = new IntersectionObserver(entries => {
      if(entries[0].isIntersecting){
        let start = 0;
        const dur = 1800;
        const step = 16;
        const timer = setInterval(() => {
          start += step;
          const progress = Math.min(start / dur, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const val = eased * target;
          el.textContent = prefix + fmt(val, decimals, useCommas) + suffix;
          if(start >= dur){ clearInterval(timer); }
        }, step);
        obs.disconnect();
      }
    }, {threshold:.5});
    obs.observe(el);
  });

  // Hero parallax — translate dashboard visual with scroll
  const heroVisual = document.querySelector('.hp-hero__visual');
  if(heroVisual && !prefersReducedMotion){
    let raf = null;
    window.addEventListener('scroll', () => {
      if(raf) return;
      raf = requestAnimationFrame(() => {
        const y = window.scrollY;
        if(y < 900){
          heroVisual.style.transform = 'translateY(' + (y * 0.06).toFixed(1) + 'px)';
        }
        raf = null;
      });
    }, { passive: true });
  }

  // ── Hero dashboard tabs ──
  const dashTabBtns = document.querySelectorAll('.hp-dash__nav-item');
  const dashPanels = document.querySelectorAll('.hp-dash__panel');

  function fmtN(val, decimals, useCommas){
    if(useCommas){
      return val.toLocaleString(undefined,{minimumFractionDigits:decimals,maximumFractionDigits:decimals});
    }
    return val.toFixed(decimals);
  }
  function runPanelCounts(panel){
    panel.querySelectorAll('[data-pcount]').forEach(el => {
      const target = parseFloat(el.dataset.pcount);
      const suffix = el.dataset.suffix || '';
      const prefix = el.dataset.prefix || '';
      const decimals = parseInt(el.dataset.decimals) || 0;
      const useCommas = el.dataset.commas === '1';
      if(prefersReducedMotion){
        el.textContent = prefix + fmtN(target, decimals, useCommas) + suffix;
        return;
      }
      let start = 0;
      const dur = 1100;
      const step = 16;
      el.textContent = prefix + fmtN(0, decimals, useCommas) + suffix;
      const timer = setInterval(() => {
        start += step;
        const progress = Math.min(start / dur, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = prefix + fmtN(eased * target, decimals, useCommas) + suffix;
        if(start >= dur){ clearInterval(timer); }
      }, step);
    });
  }
  function reanimatePanel(panel){
    // Force-restart panel-row stagger by removing then re-adding is-active
    panel.classList.remove('is-active');
    void panel.offsetWidth;
    panel.classList.add('is-active');
    runPanelCounts(panel);
  }
  function setActiveTab(name){
    dashTabBtns.forEach(b => {
      const on = b.dataset.tab === name;
      b.classList.toggle('active', on);
      b.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    dashPanels.forEach(p => {
      const on = p.dataset.panel === name;
      if(on){
        p.hidden = false;
        reanimatePanel(p);
      } else {
        p.classList.remove('is-active');
        p.hidden = true;
      }
    });
  }
  dashTabBtns.forEach(b => {
    b.addEventListener('click', () => setActiveTab(b.dataset.tab));
  });

  // Initial count-up for the default (analytics) panel when it scrolls into view
  const initialPanel = document.querySelector('.hp-dash__panel.is-active');
  if(initialPanel){
    const initObs = new IntersectionObserver(entries => {
      if(entries[0].isIntersecting){
        runPanelCounts(initialPanel);
        initObs.disconnect();
      }
    }, {threshold:.2});
    initObs.observe(initialPanel);
  }

  // ── Operations panel toggle switches ──
  document.querySelectorAll('.hp-dash__setting .hp-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const next = btn.getAttribute('aria-checked') !== 'true';
      btn.setAttribute('aria-checked', next ? 'true' : 'false');
      btn.classList.toggle('is-on', next);
      const card = btn.closest('.hp-dash__setting');
      if(card) card.classList.toggle('is-on', next);
    });
  });

  // Dashboard simulated live activity — cycle pending row (only when analytics tab visible)
  const dashEl = document.querySelector('.hp-dash');
  const analyticsPanel = document.querySelector('.hp-dash__panel[data-panel="analytics"]');
  const dashRows = analyticsPanel ? analyticsPanel.querySelectorAll('.hp-dash__table-row') : [];
  if(dashEl && analyticsPanel && dashRows.length >= 3 && !prefersReducedMotion){
    const pendingRow = dashRows[dashRows.length - 1];
    const pendingBadge = pendingRow.querySelector('.hp-badge');
    const labelEl = pendingRow.querySelectorAll('span')[1];
    const amountEl = pendingRow.querySelector('.hp-dash__amount');
    const cards = ['Visa •••• 7821','MC •••• 3104','Amex •••• 1009','Visa •••• 4242','Disc •••• 6620'];
    const amts = ['$84.20','$216.90','$342.00','$58.75','$129.40'];
    let i = 0;
    let approved = false;
    let timer = null;
    const tick = () => {
      if(!pendingBadge) return;
      if(!analyticsPanel.classList.contains('is-active')) return;
      if(!approved){
        // Approve current pending
        pendingBadge.classList.remove('blue');
        pendingBadge.classList.add('green');
        pendingBadge.innerHTML = '<i class="fa-solid fa-check"></i>';
        pendingRow.classList.add('tx-approved');
        approved = true;
      } else {
        // Bring in a new pending tx
        i = (i + 1) % cards.length;
        if(labelEl) labelEl.textContent = cards[i];
        if(amountEl) amountEl.textContent = amts[i];
        pendingBadge.classList.remove('green');
        pendingBadge.classList.add('blue');
        pendingBadge.innerHTML = '<i class="fa-solid fa-clock"></i>';
        pendingRow.classList.remove('tx-approved');
        pendingRow.classList.add('tx-fresh');
        setTimeout(() => pendingRow.classList.remove('tx-fresh'), 600);
        approved = false;
      }
    };
    const dashObs = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if(entry.isIntersecting && !timer){
          timer = setInterval(tick, 2800);
        } else if(!entry.isIntersecting && timer){
          clearInterval(timer);
          timer = null;
        }
      });
    }, { threshold: 0.2 });
    dashObs.observe(dashEl);
  }

  // Industry card mouse-tracking spotlight + accent inheritance
  document.querySelectorAll('.hp-ind-card').forEach(card => {
    const iconEl = card.querySelector('.hp-ind-card__icon');
    const accent = iconEl && iconEl.style.getPropertyValue('--accent');
    if(accent) card.style.setProperty('--accent', accent);
    if(prefersReducedMotion) return;
    card.addEventListener('pointermove', e => {
      const rect = card.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      card.style.setProperty('--mx', x + '%');
      card.style.setProperty('--my', y + '%');
    });
  });

  /* ═══════════════ AGENT NICHE TABS ═══════════════ */
  (() => {
    const panel = document.getElementById('agPanel');
    if(!panel) return;
    const tabs = Array.from(document.querySelectorAll('.hp-agent__tab'));
    if(!tabs.length) return;

    const NICHES = {
      restaurants:{
        title:'RestaurantPay Pro',
        desc:'Orders, tips, loyalty, online ordering, and payment reporting built for restaurant merchants.',
        fees:'$5,860', volume:'$1.8M', merchants:'67', referrals:'31',
        modules:['Table Orders','Tip Management','Loyalty','Online Ordering'],
        crm:[['Bella Trattoria','Active'],['Sushi Nine','Active'],['Corner Diner','Onboarding']],
        bars:[82,64,48]
      },
      repair:{
        title:'RepairPay CRM',
        desc:'Tickets, devices, estimates, warranties, SMS updates, and payment tools for repair shops.',
        fees:'$4,120', volume:'$1.2M', merchants:'84', referrals:'23',
        modules:['Repair Tickets','Device Intake','Warranty Tracking','SMS Updates'],
        crm:[['FixIt Mobile','Active'],['Uptown Repair','Active'],['GadgetLab','Onboarding']],
        bars:[70,58,44]
      },
      retail:{
        title:'RetailFlow Payments',
        desc:'Checkout, inventory, customer profiles, gift cards, and reporting for retail merchants.',
        fees:'$3,740', volume:'$940K', merchants:'58', referrals:'19',
        modules:['Inventory Sync','Customer Profiles','Gift Cards','Product Reports'],
        crm:[['Maple & Co','Active'],['Urban Threads','Active'],['The Gift Nook','Onboarding']],
        bars:[62,52,38]
      },
      contractors:{
        title:'ContractorPay Hub',
        desc:'Mobile invoices, deposits, recurring billing, job notes, and field payment tools.',
        fees:'$6,240', volume:'$2.1M', merchants:'73', referrals:'27',
        modules:['Mobile Invoices','Job Deposits','Recurring Billing','Dispatch Notes'],
        crm:[['Summit Builders','Active'],['ProHVAC Services','Active'],['Ridgeline Roofing','Onboarding']],
        bars:[88,72,55]
      },
      medspas:{
        title:'MedSpaPay Suite',
        desc:'Packages, deposits, memberships, client profiles, payment plans, and appointment checkout.',
        fees:'$4,980', volume:'$1.4M', merchants:'52', referrals:'21',
        modules:['Memberships','Packages','Deposits','Client Profiles'],
        crm:[['Lumiere Spa','Active'],['Glow Aesthetics','Active'],['Serene MedSpa','Onboarding']],
        bars:[74,60,46]
      }
    };

    const barLabels = ['Software','Processing','Residual'];
    const esc = (s) => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
    const set = (attr, val) => { const el = panel.querySelector('[data-ag="'+attr+'"]'); if(el) el.textContent = val; };

    function render(key){
      const d = NICHES[key];
      if(!d) return;
      set('title', d.title);
      set('desc', d.desc);
      set('fees', d.fees);
      set('volume', d.volume);
      set('merchants', d.merchants);
      set('referrals', d.referrals);

      const mod = panel.querySelector('[data-ag="modules"]');
      if(mod) mod.innerHTML = d.modules.map(m => '<span class="hp-agent__module">'+esc(m)+'</span>').join('');

      const crm = panel.querySelector('[data-ag="crm"]');
      if(crm) crm.innerHTML = d.crm.map(row => '<li><span class="hp-agent__crm-name">'+esc(row[0])+'</span><span class="hp-agent__crm-tag'+(row[1]==='Active'?' is-active':'')+'">'+esc(row[1])+'</span></li>').join('');

      const bars = panel.querySelector('[data-ag="bars"]');
      if(bars) bars.innerHTML = d.bars.map((w,i) => '<div class="hp-agent__bar"><span class="hp-agent__bar-lbl">'+barLabels[i]+'</span><span class="hp-agent__bar-track"><span class="hp-agent__bar-fill" style="width:'+w+'%"></span></span></div>').join('');

      // restart panel entrance animation
      panel.style.animation = 'none';
      void panel.offsetWidth;
      panel.style.animation = '';
      panel.setAttribute('aria-labelledby', 'agTab-' + key);
    }

    function activate(tab, focus){
      tabs.forEach(t => {
        const on = t === tab;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      render(tab.dataset.niche);
      if(focus) tab.focus();
    }

    tabs.forEach(tab => tab.addEventListener('click', () => activate(tab, false)));

    const tablist = document.querySelector('.hp-agent__tabs');
    if(tablist){
      tablist.addEventListener('keydown', e => {
        const i = tabs.indexOf(document.activeElement);
        if(i === -1) return;
        let n = null;
        if(e.key === 'ArrowRight' || e.key === 'ArrowDown') n = (i + 1) % tabs.length;
        else if(e.key === 'ArrowLeft' || e.key === 'ArrowUp') n = (i - 1 + tabs.length) % tabs.length;
        else if(e.key === 'Home') n = 0;
        else if(e.key === 'End') n = tabs.length - 1;
        if(n !== null){ e.preventDefault(); activate(tabs[n], true); }
      });
    }
  })();
</script>
