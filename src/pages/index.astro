.hp-dash__nav-item:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
.hp-dash__nav-item.active{
  background:linear-gradient(135deg, rgba(21,73,255,.55), rgba(0,207,255,.22));
  color:#fff;
  box-shadow:
    0 0 0 1px rgba(0,207,255,.45),
    0 0 18px rgba(0,207,255,.35),
    inset 0 0 12px rgba(0,207,255,.18);
}
.hp-dash__nav-item.active::after{
  content:"";position:absolute;left:-10px;top:50%;
  width:3px;height:16px;border-radius:3px;
  background:var(--cyan);
  box-shadow:0 0 8px var(--cyan);
  transform:translateY(-50%);
  animation:navPulse 2.4s ease-in-out infinite;
}
@keyframes navPulse{
  0%,100%{opacity:.85;height:16px}
  50%{opacity:1;height:22px}
}
.hp-dash__main{flex:1;padding:16px;position:relative;min-height:260px}
.hp-dash__panel{display:none;flex-direction:column;gap:12px}
.hp-dash__panel.is-active{display:flex}
.hp-dash__panel.is-active > *{
  opacity:0;transform:translateY(10px);
  animation:panelRowIn .55s cubic-bezier(.2,.7,.2,1) forwards;
}
.hp-dash__panel.is-active > *:nth-child(1){animation-delay:.04s}
.hp-dash__panel.is-active > *:nth-child(2){animation-delay:.12s}
.hp-dash__panel.is-active > *:nth-child(3){animation-delay:.20s}
.hp-dash__panel.is-active > *:nth-child(4){animation-delay:.28s}
@keyframes panelRowIn{to{opacity:1;transform:translateY(0)}}

/* Chart line draw-in */
.hp-chart-line{
  stroke-dasharray:1000;
  stroke-dashoffset:1000;
}
.hp-dash__panel.is-active .hp-chart-line{
  animation:drawLine 1.6s cubic-bezier(.4,.1,.2,1) forwards;
}
.hp-chart-area{opacity:0}
.hp-dash__panel.is-active .hp-chart-area{
  animation:fadeArea .9s ease .6s forwards;
}
@keyframes drawLine{to{stroke-dashoffset:0}}
@keyframes fadeArea{to{opacity:1}}

/* Hero card (payments tab) */
.hp-dash__hero-card{
  display:flex;align-items:center;gap:12px;
  background:linear-gradient(135deg, rgba(21,73,255,.22), rgba(0,207,255,.10));
  border:1px solid rgba(0,207,255,.25);
  border-radius:12px;padding:12px 14px;
  position:relative;overflow:hidden;
}
.hp-dash__hero-card::before{
  content:"";position:absolute;inset:-1px;border-radius:12px;
  background:radial-gradient(circle at top right, rgba(0,207,255,.18), transparent 60%);
  pointer-events:none;
}
.hp-dash__hero-card-icon{
  width:38px;height:38px;border-radius:10px;flex-shrink:0;
  background:linear-gradient(135deg,#1549FF,#00CFFF);
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:16px;
  box-shadow:0 6px 20px rgba(21,73,255,.45);
}
.hp-dash__hero-card-body{display:flex;flex-direction:column;min-width:0}
.hp-dash__hero-card-label{font-size:10px;opacity:.6;text-transform:uppercase;letter-spacing:.05em}
.hp-dash__hero-card-value{font-size:20px;font-weight:800;letter-spacing:-.02em;line-height:1.1;margin-top:2px}
.hp-dash__hero-card-eta{
  margin-left:auto;font-size:11px;font-weight:600;
  color:var(--cyan);background:rgba(0,207,255,.10);
  padding:5px 9px;border-radius:999px;
  border:1px solid rgba(0,207,255,.25);
  white-space:nowrap;
}

/* Progress bar */
.hp-dash__progress{
  background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.05);
  border-radius:10px;padding:10px 12px;
}
.hp-dash__progress-row{
  display:flex;justify-content:space-between;align-items:center;
  font-size:11px;opacity:.75;margin-bottom:7px;
}
.hp-dash__progress-row span:last-child{color:var(--cyan);font-weight:700;opacity:1}
.hp-dash__progress-bar{
  height:6px;background:rgba(255,255,255,.06);
  border-radius:999px;overflow:hidden;position:relative;
}
.hp-dash__progress-fill{
  height:100%;width:0;
  background:linear-gradient(90deg,#1549FF,#00CFFF);
  border-radius:999px;
  box-shadow:0 0 12px rgba(0,207,255,.5);
  position:relative;
}
.hp-dash__panel.is-active .hp-dash__progress-fill{
  animation:fillBar 1.4s cubic-bezier(.4,.1,.2,1) .15s forwards;
}
@keyframes fillBar{to{width:var(--w,72%)}}

.hp-dash__amount.up{color:var(--green)}

/* Merchant cards */
.hp-dash__merchants{display:flex;flex-direction:column;gap:8px}
.hp-dash__merchant{
  display:flex;align-items:center;gap:10px;
  background:rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.05);
  border-radius:10px;padding:9px 11px;
  transition:transform .25s ease, background .25s ease, border-color .25s ease;
}
.hp-dash__merchant:hover{
  transform:translateX(3px);
  background:rgba(0,207,255,.06);
  border-color:rgba(0,207,255,.22);
}
.hp-dash__merchant-avatar{
  width:32px;height:32px;border-radius:50%;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:11px;font-weight:700;
  box-shadow:0 4px 14px rgba(0,0,0,.35);
}
.hp-dash__merchant-info{display:flex;flex-direction:column;min-width:0;flex:1}
.hp-dash__merchant-info strong{font-size:12px;font-weight:600}
.hp-dash__merchant-info span{font-size:10px;opacity:.55;margin-top:2px}
.hp-dash__merchant-amt{margin-left:auto;font-weight:700;font-size:13px;color:var(--cyan)}

/* Settings / Operations */
.hp-dash__settings{display:flex;flex-direction:column;gap:8px}
.hp-dash__setting{
  display:flex;align-items:center;gap:12px;
  background:rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.05);
  border-radius:10px;padding:10px 12px;
  transition:background .3s ease, border-color .3s ease;
}
.hp-dash__setting.is-on{
  background:linear-gradient(90deg, rgba(21,73,255,.10), rgba(0,207,255,.04));
  border-color:rgba(0,207,255,.20);
}
.hp-dash__setting.is-on .hp-dash__setting-text strong{color:#fff}
.hp-dash__setting-text{flex:1;display:flex;flex-direction:column;min-width:0}
.hp-dash__setting-text strong{font-size:12px;font-weight:600}
.hp-dash__setting-text span{font-size:10px;opacity:.55;margin-top:2px}
.hp-toggle{
  position:relative;display:inline-block;
  width:34px;height:18px;border-radius:999px;
  background:rgba(255,255,255,.10);
  border:1px solid rgba(255,255,255,.10);
  transition:background .3s ease, border-color .3s ease, box-shadow .3s ease, transform .12s ease;
  flex-shrink:0;
  padding:0;cursor:pointer;
  -webkit-tap-highlight-color:transparent;
  touch-action:manipulation;
}
.hp-toggle:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
.hp-toggle:active{transform:scale(.95)}
.hp-toggle > span{
  position:absolute;top:1px;left:1px;
  width:14px;height:14px;border-radius:50%;
  background:#fff;
  box-shadow:0 2px 6px rgba(0,0,0,.4);
  transition:left .3s cubic-bezier(.2,.7,.2,1), background .3s ease;
}
.hp-toggle.is-on{
  background:linear-gradient(90deg,#1549FF,#00CFFF);
  border-color:rgba(0,207,255,.5);
  box-shadow:0 0 10px rgba(0,207,255,.35);
}
.hp-toggle.is-on > span{left:17px}
.hp-dash__connections{
  display:flex;flex-wrap:wrap;gap:6px;
  padding-top:4px;margin-top:auto;
}
.hp-dash__connection{
  display:inline-flex;align-items:center;gap:5px;
  font-size:10px;font-weight:600;
  padding:5px 9px;border-radius:999px;
  background:rgba(0,229,160,.08);
  color:var(--green);
  border:1px solid rgba(0,229,160,.20);
}
.hp-dash__connection i{font-size:9px}
.hp-dash__stat-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.hp-dash__stat{
  background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);
  border-radius:10px;padding:12px;
}
.hp-dash__stat-label{display:block;font-size:10px;opacity:.5;margin-bottom:4px;text-transform:uppercase;letter-spacing:.04em}
.hp-dash__stat-value{display:block;font-size:20px;font-weight:800;letter-spacing:-.02em}
.hp-dash__stat-change{font-size:10px;font-weight:600}
.hp-dash__stat-change.up{color:var(--green)}
.hp-dash__chart{
  background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.05);
  border-radius:10px;padding:10px;overflow:hidden;
}
.hp-chart-svg{width:100%;height:60px;display:block}
.hp-dash__table{display:flex;flex-direction:column;gap:6px}
.hp-dash__table-row{
  display:flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.03);border-radius:8px;
  padding:8px 10px;font-size:12px;
}
.hp-badge{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:8px}
.hp-badge.green{background:rgba(0,229,160,.2);color:var(--green)}
.hp-badge.blue{background:rgba(21,73,255,.2);color:var(--blue-mid)}
.hp-dash__amount{margin-left:auto;font-weight:700;font-size:13px}

/* Floating cards */
.hp-float{
  position:absolute;
  background:rgba(12,26,56,.92);
  border:1px solid rgba(255,255,255,.12);
  border-radius:12px;padding:12px 16px;
  backdrop-filter:blur(16px);
  box-shadow:0 12px 40px rgba(0,0,0,.4);
  display:flex;align-items:center;gap:10px;
  font-size:12px;z-index:5;
  opacity:0;animation:floatCardIn .8s ease forwards;
}
.hp-float i{font-size:18px}
.hp-float strong{display:block;font-size:12px;font-weight:600}
.hp-float span{opacity:.55;font-size:11px}
.hp-float--approval{top:15%;right:-10px;animation-delay:.6s}
.hp-float--approval i{color:var(--green)}
.hp-float--payout{bottom:20%;left:-10px;animation-delay:.9s}
.hp-float--payout i{color:var(--cyan)}
.hp-float--shield{top:50%;right:-16px;animation-delay:1.2s;gap:8px}
.hp-float--shield i{color:var(--blue-mid);font-size:16px}
.hp-float--shield span{opacity:.8;font-weight:600;font-size:12px}

@keyframes dashFloat{0%,100%{transform:rotateY(-4deg) rotateX(2deg)}50%{transform:rotateY(-2deg) rotateX(1deg) translateY(-6px)}}
@keyframes floatCardIn{from{opacity:0;transform:translateY(16px) scale(.95)}to{opacity:1;transform:translateY(0) scale(1)}}

/* ── MARQUEE ── */
.hp-marquee{
  background:#fff;padding:16px 0;overflow:hidden;
  border-top:1px solid var(--border);border-bottom:1px solid var(--border);
}
.hp-marquee__track{overflow:hidden;position:relative}
.hp-marquee__track::before,.hp-marquee__track::after{
  content:"";position:absolute;top:0;bottom:0;width:60px;pointer-events:none;z-index:2;
}
.hp-marquee__track::before{left:0;background:linear-gradient(90deg,#fff,transparent)}
.hp-marquee__track::after{right:0;background:linear-gradient(270deg,#fff,transparent)}
.hp-marquee__inner{
  display:flex;gap:14px;width:max-content;
  animation:marqueeScroll 25s linear infinite;
}
.hp-marquee__pill{
  display:inline-flex;align-items:center;gap:8px;padding:9px 18px;
  border-radius:var(--r-pill);background:var(--surface);
  border:1px solid var(--border);font-weight:500;font-size:14px;color:var(--text-2);
  white-space:nowrap;flex:0 0 auto;
}
.hp-marquee__pill i{font-size:20px;color:var(--text-3);transition:color .25s ease}
.hp-marquee__pill{transition:border-color .25s ease,background .25s ease,color .25s ease,box-shadow .25s ease}

.hp-marquee__pill[data-brand="visa"]:hover{border-color:#1a1f71;background:rgba(26,31,113,.06)}
.hp-marquee__pill[data-brand="visa"]:hover i{color:#1a1f71}
.hp-marquee__pill[data-brand="visa"]:hover{color:#1a1f71}

.hp-marquee__pill[data-brand="mastercard"]:hover{border-color:#eb001b;background:rgba(235,0,27,.05)}
.hp-marquee__pill[data-brand="mastercard"]:hover i{color:#eb001b}
.hp-marquee__pill[data-brand="mastercard"]:hover{color:#f79e1b}

.hp-marquee__pill[data-brand="amex"]:hover{border-color:#006fcf;background:rgba(0,111,207,.05)}
.hp-marquee__pill[data-brand="amex"]:hover i{color:#006fcf}
.hp-marquee__pill[data-brand="amex"]:hover{color:#006fcf}

.hp-marquee__pill[data-brand="discover"]:hover{border-color:#ff6000;background:rgba(255,96,0,.05)}
.hp-marquee__pill[data-brand="discover"]:hover i{color:#ff6000}
.hp-marquee__pill[data-brand="discover"]:hover{color:#ff6000}

.hp-marquee__pill[data-brand="apple"]:hover{border-color:#000;background:rgba(0,0,0,.04)}
.hp-marquee__pill[data-brand="apple"]:hover i{color:#000}
.hp-marquee__pill[data-brand="apple"]:hover{color:#000}

.hp-marquee__pill[data-brand="google"]:hover{border-color:#4285f4;background:rgba(66,133,244,.05)}
.hp-marquee__pill[data-brand="google"]:hover i{color:#4285f4}
.hp-marquee__pill[data-brand="google"]:hover{color:#4285f4}

.hp-marquee__inner:hover{animation-play-state:paused}
.hp-marquee__pill:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}

@keyframes marqueeScroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* ── STATS ── */
.hp-stats{padding:var(--section-py-sm) 0;background:var(--surface)}
.hp-stats__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.hp-stat-card{
  background:#fff;border:1px solid var(--border);border-radius:var(--r-lg);
  padding:28px 24px;text-align:center;
  box-shadow:var(--shadow-sm);position:relative;overflow:hidden;
  opacity:0;transform:translateY(20px);transition:all .6s ease;
}
.hp-stat-card.animated{opacity:1;transform:translateY(0)}
.hp-stat-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,var(--blue),var(--cyan));
  transform:scaleX(0);transition:transform .8s ease .2s;transform-origin:left;
}
.hp-stat-card.animated::before{transform:scaleX(1)}
.hp-stat-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md)}
.hp-stat-card__icon{
  width:48px;height:48px;margin:0 auto 14px;
  background:rgba(21,73,255,.08);border-radius:var(--r-md);
  display:flex;align-items:center;justify-content:center;
}
.hp-stat-card__icon i{font-size:20px;color:var(--blue)}
.hp-stat-card__num{font-size:2.4rem;font-weight:800;letter-spacing:-.03em;color:var(--text-1);line-height:1.2}
.hp-stat-card__label{font-size:14px;font-weight:700;color:var(--text-1);margin:4px 0 2px}
.hp-stat-card__sub{font-size:12px;color:var(--text-3)}

/* ── PLATFORM ── */
.hp-platform{padding:var(--section-py) 0;background:#fff}
.hp-platform__grid{display:grid;grid-template-columns:1fr;gap:20px}
.hp-plat-card{
  background:#fff;border:1px solid var(--border);border-radius:var(--r-lg);
  padding:28px;position:relative;overflow:hidden;
  box-shadow:var(--shadow-sm);
  opacity:0;transform:translateY(24px);transition:all .5s ease;
}
.hp-plat-card.animated{opacity:1;transform:translateY(0)}
.hp-plat-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg)}
.hp-plat-card__icon{
  width:48px;height:48px;border-radius:var(--r-md);
  background:rgba(21,73,255,.08);
  display:flex;align-items:center;justify-content:center;
  margin-bottom:16px;transition:all .3s;
  color:var(--blue);
}
.hp-plat-card__icon i{font-size:20px;color:var(--blue);transition:all .3s}
.hp-plat-card__icon svg{transition:color .3s}
.hp-plat-card:hover .hp-plat-card__icon{background:var(--blue);box-shadow:var(--shadow-blue);color:#fff}
.hp-plat-card:hover .hp-plat-card__icon i{color:#fff}
.hp-plat-card h3{font-size:1.1rem;font-weight:700;margin-bottom:8px;color:var(--text-1)}
.hp-plat-card p{font-size:.92rem;color:var(--text-2);line-height:1.65;margin-bottom:16px}
.hp-plat-card__visual{
  background:var(--surface);border:1px solid var(--border);
  border-radius:var(--r-md);padding:16px;
  display:flex;align-items:center;justify-content:center;min-height:60px;
}

.hp-mini-chart{display:flex;align-items:flex-end;gap:6px;height:48px}
.hp-mini-chart__bar{
  width:20px;background:rgba(21,73,255,.15);border-radius:4px 4px 0 0;
  transition:height .5s ease;
}
.hp-mini-chart__bar--active{background:linear-gradient(180deg,var(--blue),var(--blue-mid))}

.hp-channel-dots{display:flex;gap:12px}
.hp-channel-dots span{
  width:40px;height:40px;border-radius:var(--r-md);
  background:rgba(21,73,255,.08);
  display:flex;align-items:center;justify-content:center;
  color:var(--blue);font-size:16px;
  transition:all .3s;
}
.hp-plat-card:hover .hp-channel-dots span{background:var(--blue);color:#fff}

.hp-device-stack{display:flex;align-items:flex-end;gap:12px}
.hp-device{
  border-radius:8px;display:flex;align-items:center;justify-content:center;
  color:#fff;
}
.hp-device--terminal{width:56px;height:40px;background:linear-gradient(135deg,var(--navy),var(--navy-2));font-size:16px;border:1px solid rgba(255,255,255,.1)}
.hp-device--mobile{width:32px;height:48px;background:linear-gradient(135deg,var(--blue),var(--blue-mid));font-size:14px;border-radius:6px}

.hp-shield-visual{position:relative;display:flex;align-items:center;justify-content:center}
.hp-shield-visual>i{font-size:24px;color:var(--blue);z-index:2}
.hp-shield-rings{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
.hp-shield-rings span{
  position:absolute;border:1px solid rgba(21,73,255,.15);border-radius:50%;
  animation:shieldPulse 3s ease-in-out infinite;
}
.hp-shield-rings span:nth-child(1){width:40px;height:40px}
.hp-shield-rings span:nth-child(2){width:56px;height:56px;animation-delay:.5s}
.hp-shield-rings span:nth-child(3){width:72px;height:72px;animation-delay:1s}
@keyframes shieldPulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:.8;transform:scale(1.05)}}

.hp-funding-bar{
  width:100%;background:rgba(21,73,255,.08);border-radius:var(--r-pill);
  height:32px;position:relative;overflow:hidden;
  display:flex;align-items:center;padding:0 12px;
}
.hp-funding-bar__fill{
  position:absolute;left:0;top:0;bottom:0;width:72%;
  background:linear-gradient(90deg,var(--blue),var(--cyan));
  border-radius:var(--r-pill);
  animation:fillBar 2s ease forwards;
}
.hp-funding-bar span{position:relative;z-index:2;font-size:11px;font-weight:600;color:var(--text-2)}
@keyframes fillBar{from{width:0}to{width:72%}}

.hp-support-visual{text-align:center}
.hp-support-bubble{
  background:var(--navy);color:#fff;padding:8px 14px;
  border-radius:12px 12px 12px 2px;font-size:12px;font-weight:500;
  display:inline-block;margin-bottom:8px;
}
.hp-support-status{display:flex;align-items:center;justify-content:center;gap:6px;font-size:11px;color:var(--green);font-weight:600}
.hp-pulse-dot{
  width:7px;height:7px;background:var(--green);border-radius:50%;
  animation:pulseDot 1.5s ease-in-out infinite;
}
@keyframes pulseDot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.3)}}

/* ── HOW IT WORKS ── */
.hp-flow{
  padding:var(--section-py) 0;
  background:
    radial-gradient(ellipse 100% 60% at 50% 0%, rgba(21,73,255,.18) 0%, transparent 60%),
    linear-gradient(160deg, #060E21 0%, #0C1A38 60%, #0a1c42 100%);
  color:#fff;position:relative;overflow:hidden;
}
.hp-flow::before{
  content:"";position:absolute;inset:0;
  background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23ffffff' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  pointer-events:none;
}
.hp-flow__steps{
  display:grid;grid-template-columns:1fr;gap:32px;
  position:relative;z-index:2;max-width:900px;margin:0 auto;
}
.hp-flow__connector{display:none}
.hp-step{
  text-align:center;position:relative;
  opacity:0;transform:translateY(20px);transition:all .6s ease;
}
.hp-step.animated{opacity:1;transform:translateY(0)}
.hp-step__number{
  font-size:48px;font-weight:900;letter-spacing:-.04em;
  background:linear-gradient(135deg,rgba(21,73,255,.3),rgba(0,207,255,.15));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  line-height:1;margin-bottom:8px;
}
.hp-step__icon{
  width:56px;height:56px;margin:0 auto 14px;
  background:rgba(21,73,255,.15);border:1px solid rgba(255,255,255,.1);
  border-radius:var(--r-md);
  display:flex;align-items:center;justify-content:center;
}
.hp-step__icon i{font-size:22px;color:var(--cyan)}
.hp-step h3{font-size:1.15rem;font-weight:700;margin-bottom:6px}
.hp-step p{font-size:.9rem;opacity:.65;line-height:1.6;max-width:280px;margin:0 auto}

/* ── ECOSYSTEM ── */
.hp-eco{padding:var(--section-py) 0;background:var(--surface)}
.hp-eco__hub{position:relative;max-width:600px;margin:0 auto;aspect-ratio:1;display:flex;align-items:center;justify-content:center}
.hp-eco__center{
  width:90px;height:90px;
  background:linear-gradient(135deg,var(--blue),var(--blue-mid));
  border-radius:50%;display:flex;align-items:center;justify-content:center;
  box-shadow:0 0 60px rgba(21,73,255,.3),var(--shadow-blue);
  z-index:3;position:relative;
}
.hp-eco__center .brandtext{font-size:13px}
.hp-eco__center .ppd{color:var(--cyan);font-weight:800}
.hp-eco__center .tech{color:#fff;font-weight:800}
.hp-eco__logo-ring{
  width:100%;height:100%;display:flex;align-items:center;justify-content:center;
}
.hp-eco__nodes{position:absolute;inset:0}
.hp-eco__node{
  position:absolute;
  left:50%;top:50%;
  width:100px;
  transform:rotate(var(--angle)) translateY(-180px) rotate(calc(-1 * var(--angle)));
  margin-left:-50px;margin-top:-40px;
  text-align:center;
  opacity:0;transition:opacity .6s ease;
}
.hp-eco__node.animated{opacity:1}
.hp-eco__node-icon{
  width:52px;height:52px;margin:0 auto 8px;
  background:#fff;border:1px solid var(--border);
  border-radius:var(--r-md);box-shadow:var(--shadow-sm);
  display:flex;align-items:center;justify-content:center;
  transition:all .3s;
}
.hp-eco__node-icon i{font-size:20px;color:var(--blue);transition:all .3s}
.hp-eco__node:hover .hp-eco__node-icon{background:var(--blue);border-color:var(--blue);box-shadow:var(--shadow-blue)}
.hp-eco__node:hover .hp-eco__node-icon i{color:#fff}
.hp-eco__node span{font-size:12px;font-weight:600;color:var(--text-2)}

/* ── INDUSTRIES ── */
.hp-industries{padding:var(--section-py) 0;background:#fff}
.hp-ind__grid{display:grid;grid-template-columns:1fr;gap:12px}
.hp-ind-card{
  display:flex;align-items:center;gap:16px;
  background:#fff;border:1px solid var(--border);
  border-radius:var(--r-lg);padding:20px 24px;
  box-shadow:var(--shadow-xs);
  transition:all .3s ease;
  opacity:0;transform:translateY(16px);
  cursor:pointer;
}
.hp-ind-card.animated{opacity:1;transform:translateY(0)}
.hp-ind-card:hover{
  transform:translateY(-4px);box-shadow:var(--shadow-lg);
  border-color:rgba(21,73,255,.2);
}
.hp-ind-card__icon{
  width:48px;height:48px;flex:0 0 48px;
  border-radius:var(--r-md);
  background:color-mix(in srgb, var(--accent) 12%, transparent);
  display:flex;align-items:center;justify-content:center;
  transition:all .3s;
}
.hp-ind-card__icon i{font-size:20px;color:var(--accent);transition:all .3s}
.hp-ind-card:hover .hp-ind-card__icon{background:var(--accent)}
.hp-ind-card:hover .hp-ind-card__icon i{color:#fff}
.hp-ind-card__content{flex:1}
.hp-ind-card__content h3{font-size:1rem;font-weight:700;margin-bottom:4px;color:var(--text-1)}
.hp-ind-card__content p{font-size:.85rem;color:var(--text-2);line-height:1.55;margin:0}
.hp-ind-card__arrow{
  color:var(--text-3);font-size:14px;
  opacity:0;transform:translateX(-8px);
  transition:all .3s;
}
.hp-ind-card:hover .hp-ind-card__arrow{opacity:1;transform:translateX(0)}

/* ── FINAL CTA ── */
.hp-cta{
  padding:clamp(80px,10vw,120px) 0;text-align:center;
  color:#fff;position:relative;overflow:hidden;
  background:
    radial-gradient(ellipse 100% 80% at 50% -10%,rgba(0,207,255,.18) 0%,transparent 60%),
    radial-gradient(ellipse 60% 60% at 100% 100%,rgba(21,73,255,.15) 0%,transparent 50%),
    linear-gradient(160deg,#060E21 0%,#0C1A38 50%,#0a1840 100%);
}
.hp-cta__bg-grid{
  position:absolute;inset:0;
  background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23ffffff' fill-opacity='0.025'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  pointer-events:none;
}
.hp-cta__orb{position:absolute;border-radius:50%;filter:blur(100px);opacity:.12;pointer-events:none}
.hp-cta__orb--1{width:500px;height:500px;background:var(--blue);top:-250px;left:-100px;animation:orbFloat 22s ease-in-out infinite}
.hp-cta__orb--2{width:350px;height:350px;background:var(--cyan);bottom:-180px;right:-80px;animation:orbFloat 18s ease-in-out infinite reverse}
.hp-cta__inner{position:relative;z-index:2;max-width:700px;margin:0 auto}
.hp-cta__inner h2{
  font-size:clamp(2rem,4.5vw,3rem);font-weight:800;
  letter-spacing:-.025em;line-height:1.15;margin:20px 0 16px;
}
.hp-cta__inner>p{
  font-size:clamp(1rem,1.8vw,1.1rem);opacity:.75;
  line-height:1.7;margin-bottom:32px;
}
.hp-cta__actions{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-bottom:36px}
.hp-cta__badges{
  display:flex;flex-wrap:wrap;justify-content:center;gap:16px;
}
.hp-cta__badges span{
  display:inline-flex;align-items:center;gap:6px;
  font-size:12px;opacity:.5;font-weight:500;
}
.hp-cta__badges span i{color:var(--cyan);opacity:.7}

/* ═══════════════════════════════════════════════════
   PREMIUM POLISH
   ═══════════════════════════════════════════════════ */

/* Hero — staggered entrance */
.hp-hero__text > *{opacity:0;transform:translateY(18px);animation:heroIn .9s cubic-bezier(.2,.7,.2,1) forwards}
.hp-hero__text > .hp-pill{animation-delay:.05s}
.hp-hero__text > h1{animation-delay:.18s}
.hp-hero__text > p{animation-delay:.32s}
.hp-hero__text > .hp-hero__actions{animation-delay:.46s}
.hp-hero__text > .hp-hero__proof{animation-delay:.6s}
@keyframes heroIn{to{opacity:1;transform:translateY(0)}}

/* Hero ambient particles */
.hp-hero__particles{position:absolute;inset:0;pointer-events:none;z-index:1;overflow:hidden}
.hp-hero__particles span{
  position:absolute;width:4px;height:4px;border-radius:50%;
  background:radial-gradient(circle,rgba(0,207,255,.95),rgba(0,207,255,0));
  opacity:0;animation:particleDrift 18s linear infinite;
}
.hp-hero__particles span:nth-child(1){left:8%;top:65%;animation-delay:0s;animation-duration:22s}
.hp-hero__particles span:nth-child(2){left:24%;top:80%;animation-delay:3s;animation-duration:18s;background:radial-gradient(circle,rgba(21,73,255,.9),rgba(21,73,255,0))}
.hp-hero__particles span:nth-child(3){left:60%;top:75%;animation-delay:6s;animation-duration:25s}
.hp-hero__particles span:nth-child(4){left:80%;top:70%;animation-delay:2s;animation-duration:20s;background:radial-gradient(circle,rgba(0,229,160,.7),rgba(0,229,160,0))}
.hp-hero__particles span:nth-child(5){left:45%;top:85%;animation-delay:8s;animation-duration:24s}
.hp-hero__particles span:nth-child(6){left:90%;top:78%;animation-delay:5s;animation-duration:19s;background:radial-gradient(circle,rgba(21,73,255,.9),rgba(21,73,255,0))}
@keyframes particleDrift{
  0%{transform:translateY(0) scale(.8);opacity:0}
  10%{opacity:.6}
  60%{opacity:.9}
  100%{transform:translateY(-220px) scale(1.4);opacity:0}
}

/* Hero parallax (set via JS) */
.hp-hero__visual{transition:transform .25s cubic-bezier(.2,.7,.2,1);will-change:transform}

/* Dashboard live ping */
.hp-dash__live{
  margin-left:auto;display:inline-flex;align-items:center;gap:6px;
  font-size:9px;font-weight:700;color:#00E5A0;text-transform:uppercase;
  letter-spacing:.08em;background:rgba(0,229,160,.1);padding:3px 9px;
  border-radius:999px;border:1px solid rgba(0,229,160,.25);
}
.hp-dash__bar-title + .hp-dash__live{margin-left:8px}
.hp-dash__bar{align-items:center}
.hp-dash__bar .hp-dash__bar-title{margin-left:auto}
.hp-dash__live::before{
  content:"";width:6px;height:6px;border-radius:50%;background:#00E5A0;
  box-shadow:0 0 0 0 rgba(0,229,160,.7);animation:livePing 1.6s ease-out infinite;
}
@keyframes livePing{
  0%{box-shadow:0 0 0 0 rgba(0,229,160,.55)}
  70%{box-shadow:0 0 0 8px rgba(0,229,160,0)}
  100%{box-shadow:0 0 0 0 rgba(0,229,160,0)}
}

/* Transaction row state animations */
.hp-dash__table-row{transition:background .35s ease,transform .35s ease}
.hp-dash__table-row.tx-approved{background:rgba(0,229,160,.10);transform:translateX(2px)}
.hp-dash__table-row.tx-fresh{animation:freshRow .55s ease}
@keyframes freshRow{from{opacity:.3;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}
.hp-badge{transition:background .35s ease,color .35s ease}

/* Section transition divider — soft glow on dark sections */
.hp-flow,.hp-cta{position:relative}
.hp-flow::after,.hp-cta::after{
  content:"";position:absolute;left:0;right:0;top:0;height:1px;
  background:linear-gradient(90deg,transparent,rgba(0,207,255,.45),transparent);
  z-index:3;pointer-events:none;
}

/* Platform card — premium gradient border on hover */
.hp-plat-card{position:relative;overflow:hidden}
.hp-plat-card::before{
  content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;
  background:linear-gradient(135deg,rgba(21,73,255,.55),rgba(0,207,255,.55),rgba(21,73,255,0));
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
          mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  opacity:0;transition:opacity .35s ease;pointer-events:none;
}
.hp-plat-card:hover::before{opacity:1}
.hp-plat-card__icon{transition:all .35s ease,transform .4s cubic-bezier(.2,.7,.2,1)}
.hp-plat-card:hover .hp-plat-card__icon{transform:translateY(-2px) rotate(-3deg)}

/* How It Works — animated gradient flow on connector + step polish */
@media(min-width:768px){
  .hp-flow__connector{
    background:linear-gradient(90deg,transparent 0%,rgba(21,73,255,.4) 25%,rgba(0,207,255,.65) 50%,rgba(21,73,255,.4) 75%,transparent 100%) !important;
    background-size:200% 100% !important;
    animation:connectorFlow 6s linear infinite;
  }
}
@keyframes connectorFlow{from{background-position:0% 50%}to{background-position:200% 50%}}
.hp-step__icon{transition:transform .4s ease,box-shadow .4s ease,background .3s ease}
.hp-step:hover .hp-step__icon{
  transform:translateY(-3px) scale(1.06);
  background:rgba(21,73,255,.3);
  box-shadow:0 12px 32px rgba(0,207,255,.25);
}
.hp-step__number{transition:filter .3s ease}
.hp-step:hover .hp-step__number{filter:drop-shadow(0 0 14px rgba(0,207,255,.45))}

/* Ecosystem connecting lines */
.hp-eco__lines{
  position:absolute;inset:0;width:100%;height:100%;
  pointer-events:none;z-index:1;
}
.hp-eco__lines line{
  stroke:url(#ecoGrad);stroke-width:.4;stroke-dasharray:1.2 1.8;
  opacity:.7;animation:ecoDash 2.5s linear infinite;
  vector-effect:non-scaling-stroke;
}
@keyframes ecoDash{to{stroke-dashoffset:-6}}
.hp-eco__center{animation:hubPulse 4s ease-in-out infinite}
@keyframes hubPulse{
  0%,100%{box-shadow:0 0 60px rgba(21,73,255,.3),var(--shadow-blue)}
  50%{box-shadow:0 0 90px rgba(0,207,255,.5),0 0 0 8px rgba(0,207,255,.07),var(--shadow-blue)}
}
.hp-eco__node-icon{position:relative}
.hp-eco__node-icon::after{
  content:"";position:absolute;inset:-4px;border-radius:inherit;
  border:1px solid rgba(0,207,255,.45);opacity:0;transition:all .4s ease;
}
.hp-eco__node:hover .hp-eco__node-icon::after{opacity:1;inset:-9px}

/* Industry card mouse-tracking spotlight + accent border */
.hp-ind-card{position:relative;overflow:hidden;--mx:50%;--my:50%;--accent:#1549FF}
.hp-ind-card::before{
  content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;
  background:radial-gradient(220px circle at var(--mx) var(--my),color-mix(in srgb,var(--accent) 16%,transparent),transparent 70%);
  opacity:0;transition:opacity .35s ease;
}
.hp-ind-card:hover::before{opacity:1}
.hp-ind-card:hover{border-color:color-mix(in srgb,var(--accent) 45%,var(--border))}
.hp-ind-card__icon{box-shadow:0 0 0 0 transparent;transition:all .35s ease,box-shadow .4s ease}
.hp-ind-card:hover .hp-ind-card__icon{
  transform:scale(1.08) rotate(-3deg);
  box-shadow:0 8px 22px color-mix(in srgb,var(--accent) 35%,transparent);
}
.hp-ind-card > *{position:relative;z-index:1}

/* Buttons — premium hover glow halo + shimmer for white */
.btn-primary{position:relative;isolation:isolate}
.btn-primary::before{
  content:"";position:absolute;inset:-2px;border-radius:inherit;
  background:linear-gradient(135deg,var(--cyan),var(--blue),var(--blue-dark));
  filter:blur(12px);opacity:0;transition:opacity .35s ease;z-index:-1;
}
.btn-primary:hover::before{opacity:.6}

/* Stat card subtle conic glow on hover */
.hp-stat-card::after{
  content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;
  background:conic-gradient(from 0deg,transparent 0%,rgba(0,207,255,.35) 25%,transparent 50%,rgba(21,73,255,.35) 75%,transparent 100%);
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
          mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;padding:1px;
  opacity:0;transition:opacity .4s ease;
}
.hp-stat-card:hover::after{opacity:1}

/* ── RESPONSIVE ── */
@media(min-width:768px){
  .hp-hero__inner{grid-template-columns:1fr 1.1fr;gap:40px}
  .hp-stats__grid{grid-template-columns:repeat(4,1fr)}
  .hp-platform__grid{grid-template-columns:repeat(2,1fr)}
  .hp-flow__steps{grid-template-columns:repeat(4,1fr);gap:24px}
  .hp-flow__connector{
    display:block;position:absolute;
    top:115px;left:10%;right:10%;height:2px;
    background:linear-gradient(90deg,transparent,rgba(21,73,255,.3),rgba(0,207,255,.3),transparent);
    z-index:0;
  }
  .hp-ind__grid{grid-template-columns:repeat(2,1fr)}
  .hp-ind-card--wide{grid-column:span 2}
}
@media(min-width:992px){
  .hp-platform__grid{grid-template-columns:repeat(3,1fr)}
  .hp-ind__grid{grid-template-columns:repeat(3,1fr)}
  .hp-ind-card--wide{grid-column:span 1}
}
@media(max-width:767px){
  .hp-hero__visual{
    margin-top:8px;
    transform:none;animation:none;
    max-width:100%;
  }
  .hp-dash{transform:none;animation:none;border-radius:14px}
  .hp-dash__body{min-height:0}
  .hp-dash__sidebar{width:42px;padding:10px 0}
  .hp-dash__nav-item{width:30px;height:30px;font-size:13px}
  .hp-dash__nav-item.active::after{display:none}
  .hp-dash__main{padding:12px;min-height:240px}
  .hp-dash__stat-value{font-size:17px}
  .hp-dash__hero-card-value{font-size:17px}
  .hp-float--approval,.hp-float--shield{display:none}
  .hp-float--payout{
    position:static;margin:10px 0 0;width:100%;
    animation-delay:.4s;
  }
  .hp-eco__lines{display:none}
  .hp-hero__text{text-align:center}
  .hp-hero__actions{justify-content:center}
  .hp-hero__proof{justify-content:center}
  .hp-eco__hub{max-width:340px;aspect-ratio:auto;min-height:400px}
  .hp-eco__node{transform:rotate(var(--angle)) translateY(-130px) rotate(calc(-1 * var(--angle)))}
  .hp-eco__node{width:80px;margin-left:-40px}
  .hp-eco__node-icon{width:42px;height:42px}
  .hp-eco__node-icon i{font-size:16px}
  .hp-eco__node span{font-size:10px}
}
@media(prefers-reduced-motion:reduce){
  .hp-marquee__inner{animation:none}
  .hp-dash{animation:none;transform:none}
  .hp-float{animation:none;opacity:1;transform:none}
  .hp-hero__orb,.hp-cta__orb{animation:none}
  .hp-pulse-dot{animation:none}
  .hp-shield-rings span{animation:none;opacity:.5}
  .hp-funding-bar__fill{animation:none;width:72%}
  .hp-stat-card,.hp-plat-card,.hp-step,.hp-eco__node,.hp-ind-card{
    opacity:1;transform:none;transition:none;
  }
  .hp-stat-card::before{transform:scaleX(1);transition:none}
  .hp-hero__particles,.hp-eco__lines line,.hp-dash__live::before,
  .hp-eco__center,.hp-flow__connector{animation:none !important}
  .hp-hero__text > *{animation:none;opacity:1;transform:none}
  .hp-hero__visual{transition:none}
}

/* ═══════════════ AGENT SECTION ═══════════════ */
.hp-agent{
  position:relative;overflow:hidden;
  background:
    radial-gradient(120% 90% at 85% 0%,rgba(124,92,255,.10),transparent 55%),
    linear-gradient(180deg,#060E21 0%,#0a1530 60%,#0b1a3a 100%);
  color:#fff;padding:clamp(64px,8vw,120px) 0;
}
.hp-agent__bg-grid{
  position:absolute;inset:0;opacity:.5;pointer-events:none;
  background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}
.hp-agent__orb{position:absolute;border-radius:50%;filter:blur(120px);opacity:.22;pointer-events:none}
.hp-agent__orb--1{width:520px;height:520px;background:var(--blue);top:-200px;left:-160px;animation:hpAgentDrift 18s ease-in-out infinite}
.hp-agent__orb--2{width:440px;height:440px;background:var(--cyan);bottom:-180px;right:-120px;animation:hpAgentDrift 22s ease-in-out infinite reverse}
.hp-agent__orb--3{width:360px;height:360px;background:#7c5cff;top:28%;right:18%;opacity:.14;animation:hpAgentDrift 26s ease-in-out infinite}
@keyframes hpAgentDrift{0%,100%{transform:translate(0,0)}50%{transform:translate(42px,-30px)}}
.hp-agent__inner{position:relative;z-index:2}

/* Layout */
.hp-agent__grid{display:grid;grid-template-columns:1.02fr .98fr;gap:clamp(32px,4vw,60px);align-items:center}

/* Reveal */
.hp-agent__copy,.hp-agent__visual{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s ease}
.hp-agent__copy.animated,.hp-agent__visual.animated{opacity:1;transform:none}
.hp-agent__visual{position:relative;transition-delay:.08s}

/* Left copy */
.hp-agent__badge i{margin-right:2px}
.hp-agent__title{font-size:clamp(2rem,3.6vw,3rem);font-weight:800;letter-spacing:-.025em;line-height:1.08;margin:18px 0 16px}
.hp-agent__sub{color:rgba(255,255,255,.82);font-size:clamp(15px,1.2vw,17px);line-height:1.6;margin:0 0 14px;max-width:560px}
.hp-agent__body{color:rgba(255,255,255,.62);font-size:14.5px;line-height:1.65;margin:0 0 24px;max-width:560px}
.hp-agent__actions{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:14px}
.hp-agent__note{display:flex;align-items:center;gap:8px;font-size:13px;color:rgba(255,255,255,.6);margin:0 0 22px}
.hp-agent__note i{color:var(--green)}
.hp-agent__chips{list-style:none;display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:0}
.hp-agent__chips li{
  display:inline-flex;align-items:center;gap:7px;
  font-size:12.5px;font-weight:600;color:rgba(255,255,255,.85);
  background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);
  padding:7px 13px;border-radius:999px;
}
.hp-agent__chips li i{color:var(--cyan);font-size:12px}

/* Right visual + floats */
.hp-agent__float{
  position:absolute;z-index:3;
  display:inline-flex;align-items:center;gap:7px;
  font-size:12px;font-weight:700;color:#fff;
  background:rgba(12,26,56,.82);backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,.14);border-radius:12px;
  padding:8px 12px;box-shadow:0 12px 30px rgba(0,0,0,.35);
