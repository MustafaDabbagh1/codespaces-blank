---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ForgeDemo from '../components/demos/ForgeDemo.astro';
import RepairDemo from '../components/demos/RepairDemo.astro';
import MerchantDemo from '../components/demos/MerchantDemo.astro';
import RewardsDemo from '../components/demos/RewardsDemo.astro';
import BrandStudio from '../components/agents/BrandStudio.astro';
import { products, industries, company } from '../data/site';

const facts = [
  { title: 'A free rate review', body: 'Send a statement. We show you what you pay now and what you would pay with us.', href: '/rate-review', link: 'Request a review' },
  { title: 'Cash discount, done properly', body: 'Compliant dual pricing with the signage, receipts and setup handled for you.', href: '/cash-discount', link: 'How it works' },
  { title: 'People who pick up', body: `U.S.-based support. ${company.hours}.`, href: '/customer-support', link: 'Support' },
];
---

<SiteLayout
  title="PPD Technology | Payment processing and the software that runs on top"
  description="PPD Technology pairs payment processing with software we build ourselves: Forge POS, PPD Repair, PPD Merchant and PPD Rewards. For businesses that want more than a terminal, and agents who want more than an ISO."
>
  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="horizon" aria-hidden="true"></div>

    <div class="wrap hero__inner">
      <div class="hero__head">
        <p class="eyebrow fade-up">Payments + software</p>
        <h1 class="h-hero">
          <span class="rise" style="--i:1"><span>Not just your processor.</span></span>
          <span class="rise" style="--i:2"><span class="grad">Your technology partner.</span></span>
        </h1>
      </div>

      <div class="hero__copy">
        <p class="lede fade-up" style="--i:4">
          We process the payments and build the software that runs on top of them. For the businesses that take them, and the agents who sell them.
        </p>
        <div class="btn-row fade-up" style="--i:5">
          <a class="btn btn--primary" href="/products">I run a business <Icon name="arrow-right" /></a>
          <a class="btn btn--ghost" href="/agents">I sell payments <Icon name="arrow-right" /></a>
        </div>
      </div>

      <!-- PPD at the centre, the four products in orbit -->
      <div class="orbit fade-up" style="--i:3" aria-label="PPD Technology and its four products">
        <div class="orbit__ring orbit__ring--a" aria-hidden="true"></div>
        <div class="orbit__ring orbit__ring--b" aria-hidden="true"></div>
        <div class="orbit__core" aria-hidden="true">
          <svg viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1.2" y="1.2" width="29.6" height="21.6" rx="6"></rect>
            <path d="M11.1 1.4 15.9 5.7l4.8-4.3M15.9 5.7v.95a1.2 1.2 0 0 1-1.2 1.2H1.3M10.6 7.85v7.25M1.3 15.1h29.4M21.5 15.1V9.05a1.2 1.2 0 0 1 1.2-1.2h8M15.9 15.1v2.1M11.1 22.6l4.8-5.4 4.8 5.4"></path>
          </svg>
        </div>
        {
          products.map((p, i) => (
            <div class:list={['orbit__track', `orbit__track--${i % 2 ? 'b' : 'a'}`]} style={`--t:${((i * 90 + 25) / 360).toFixed(4)}`}>
              <a class:list={['orbit__sat', `t-${p.key}`]} href={p.href}>
                <img src={p.icon} alt="" width="56" height="56" />
                <span>{p.short}</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>

    <p class="hero__ticker fade-up" style="--i:6" aria-hidden="true">
      <span>Processing</span><span>Software</span><span>Branding</span>
    </p>
  </section>

  <!-- ── STATEMENT ────────────────────────────────────────── -->
  <section class="section statement">
    <div class="wrap">
      <p class="statement__text" data-lightup>
        Most processors hand you a terminal and a rate sheet. We write the software your business runs on, and stand behind every payment underneath it.
      </p>
    </div>
  </section>

  <!-- ── PRODUCTS ─────────────────────────────────────────── -->
  <section class="section suite" id="suite">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow reveal">Built in-house</p>
        <h2 class="h-1 reveal" style="--i:1">Four products.<br />Watch them work.</h2>
      </div>

      <div class="tabs" data-tabs>
        <div class="tabs__list" role="tablist" aria-label="PPD products" aria-orientation="vertical">
          {
            products.map((p, i) => (
              <button
                type="button"
                role="tab"
                id={`suite-tab-${p.key}`}
                aria-controls={`suite-panel-${p.key}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                class:list={[`t-${p.key}`]}
              >
                <img src={p.icon} alt="" width="40" height="40" loading="lazy" />
                <span>
                  <b>{p.short}</b>
                  <em>{p.kind}</em>
                </span>
                <Icon name="arrow-right" size={20} />
              </button>
            ))
          }
        </div>

        <div class="tabs__panels">
          {
            products.map((p, i) => (
              <div class:list={['tabs__panel', `t-${p.key}`]} role="tabpanel" id={`suite-panel-${p.key}`} aria-labelledby={`suite-tab-${p.key}`} hidden={i !== 0}>
                {p.key === 'forge' && <ForgeDemo captions="line" />}
                {p.key === 'repair' && <RepairDemo captions="line" />}
                {p.key === 'merchant' && <MerchantDemo captions="line" />}
                {p.key === 'rewards' && <RewardsDemo captions="line" />}
                <div class="suite__foot">
                  <p>{p.blurb}</p>
                  <a class="link-arrow" href={p.href}>Explore {p.short} <Icon name="arrow-right" /></a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ── PROCESSING ───────────────────────────────────────── -->
  <section class="section section--paper proc">
    <div class="wrap">
      <div class="proc__head">
        <h2 class="h-1 reveal">The processing is the easy part.</h2>
        <a class="btn btn--primary reveal" style="--i:1" href="/rate-review">Get a free rate review <Icon name="arrow-right" /></a>
      </div>
      <ul class="proc__facts">
        {
          facts.map((f, i) => (
            <li class="reveal" style={`--i:${i}`}>
              <h3 class="h-3">{f.title}</h3>
              <p>{f.body}</p>
              <a class="link-arrow" href={f.href}>{f.link} <Icon name="arrow-right" /></a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── AGENTS ───────────────────────────────────────────── -->
  <section class="section agents" id="agents">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow reveal">For payment sales agents</p>
        <h2 class="h-1 reveal" style="--i:1">We’re not just your ISO.<br /><span class="grad">We’re your tech and branding partner.</span></h2>
        <p class="lede reveal" style="--i:2">
          Every other ISO hands you the same terminal and the same rate sheet. We put your name on software your merchants log in to every day.
        </p>
      </div>

      <div class="studio section--paper reveal">
        <BrandStudio compact />
      </div>

      <div class="btn-row agents__cta reveal">
        <a class="btn btn--primary" href="/agents">See the agent program <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost" href="/agents#book">Book a strategy call</a>
      </div>
    </div>
  </section>

  <!-- ── INDUSTRIES ───────────────────────────────────────── -->
  <section class="section section--tight ind" id="industries">
    <div class="wrap">
      <p class="eyebrow reveal">Industries we set up every week</p>
      <ul class="ind__list reveal" style="--i:1">
        {
          industries.map((ind) => (
            <li>
              <a href={ind.href}>{ind.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── CLOSE ────────────────────────────────────────────── -->
  <section class="close">
    <div class="horizon" aria-hidden="true"></div>
    <div class="wrap close__inner">
      <h2 class="h-hero reveal">Ready when you are.</h2>
      <p class="lede reveal" style="--i:1">A rate review if you run a business. A strategy call if you sell payments.</p>
      <div class="btn-row reveal" style="--i:2">
        <a class="btn btn--primary" href="/rate-review">Free rate review <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost" href="/agents#book">Agent strategy call</a>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  // Product tabs.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tablist"] > [role="tab"]'));
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') || '');
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        let to = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') to = (i + 1) % tabs.length;
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') to = (i - 1 + tabs.length) % tabs.length;
        if (e.key === 'Home') to = 0;
        if (e.key === 'End') to = tabs.length - 1;
        if (to < 0) return;
        e.preventDefault();
        select(tabs[to], true);
      });
    });
  });
</script>

<style>
  /* ── hero ── */
  .hero {
    position: relative;
    display: grid;
    align-content: center;
    min-height: min(100svh, 960px);
    padding: var(--hero-top) 0 clamp(150px, 16vw, 220px);
    overflow: hidden;
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 70% at 18% 30%, rgba(21, 73, 255, 0.34), transparent 70%),
      radial-gradient(40% 50% at 82% 40%, rgba(34, 211, 255, 0.12), transparent 70%),
      linear-gradient(180deg, #040714 0%, #060c26 70%, #071038 100%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: clamp(20px, 3vw, 40px) clamp(24px, 4vw, 64px);
    align-items: start;
  }
  .hero__head {
    grid-column: 1 / -1;
    display: grid;
    gap: 22px;
  }
  .hero__copy {
    display: grid;
    gap: 28px;
    justify-items: start;
    padding-top: 8px;
  }
  .hero .h-hero {
    font-size: clamp(2.5rem, 6.5vw, 5.9rem);
  }
  .hero .lede {
    max-width: 44ch;
  }
  .hero__ticker {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(18px, 2.4vw, 34px);
    display: flex;
    justify-content: center;
    gap: clamp(18px, 4vw, 54px);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #9fb4e6;
  }
  .hero__ticker span {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .hero__ticker span::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 10px var(--cyan);
  }

  /* orbit */
  .orbit {
    position: relative;
    justify-self: end;
    width: min(100%, 430px);
    aspect-ratio: 1;
    margin-top: clamp(-70px, -4vw, -20px);
    margin-bottom: clamp(-120px, -8vw, -40px);
  }
  .orbit__ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(140, 175, 255, 0.22);
  }
  .orbit__ring--a {
    inset: 21%;
  }
  .orbit__ring--b {
    inset: 3%;
    border-style: dashed;
    border-color: rgba(140, 175, 255, 0.16);
  }
  .orbit__core {
    position: absolute;
    inset: 37%;
    display: grid;
    place-items: center;
    border-radius: 28%;
    color: var(--cyan);
    background: radial-gradient(circle at 30% 20%, #16245e, #070d2a 70%);
    border: 1px solid rgba(110, 200, 255, 0.5);
    box-shadow:
      0 0 0 10px rgba(34, 211, 255, 0.05),
      0 0 70px 6px rgba(21, 110, 255, 0.55);
    animation: orbit-pulse 5s ease-in-out infinite;
  }
  .orbit__core svg {
    width: 58%;
    filter: drop-shadow(0 0 10px rgba(34, 211, 255, 0.8));
  }
  .orbit__track {
    position: absolute;
    inset: 21%;
    animation: orbit-spin 46s linear infinite;
    animation-delay: calc(var(--t) * -46s);
    pointer-events: none;
  }
  .orbit__track--b {
    inset: 3%;
    animation-duration: 70s;
    animation-direction: reverse;
    animation-delay: calc(var(--t) * -70s);
  }
  .orbit__sat {
    position: absolute;
    left: 50%;
    top: 0;
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 76px;
    margin: -32px 0 0 -38px;
    pointer-events: auto;
    animation: orbit-spin 46s linear infinite reverse;
    animation-delay: calc(var(--t) * -46s);
  }
  .orbit__track--b .orbit__sat {
    animation-duration: 70s;
    animation-direction: normal;
    animation-delay: calc(var(--t) * -70s);
  }
  .orbit__sat img {
    width: 56px;
    height: 56px;
    padding: 9px;
    border-radius: 16px;
    object-fit: contain;
    background: #0a1130;
    border: 1px solid rgba(var(--accent-rgb), 0.6);
    box-shadow: 0 0 26px -4px rgba(var(--accent-rgb), 0.8);
    transition: transform 0.4s var(--spring);
  }
  .orbit__sat.t-repair img,
  .orbit__sat.t-merchant img {
    padding: 0;
  }
  .orbit__sat span {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #c6d2f2;
  }
  .orbit__sat:hover img {
    transform: scale(1.14);
  }
  .orbit:hover .orbit__track,
  .orbit:hover .orbit__sat {
    animation-play-state: paused;
  }
  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes orbit-pulse {
    50% {
      box-shadow:
        0 0 0 16px rgba(34, 211, 255, 0.04),
        0 0 100px 12px rgba(21, 110, 255, 0.7);
    }
  }

  /* ── statement ── */
  .statement {
    padding-block: clamp(90px, 13vw, 200px);
  }
  .statement__text {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.6vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
    max-width: 1040px;
    text-wrap: balance;
  }

  /* ── products ── */
  .tabs {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
  }
  .tabs__list {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .tabs__list button {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 22px 6px 22px 0;
    text-align: left;
    border-bottom: 1px solid var(--line);
    color: var(--dim);
    transition:
      color 0.3s,
      padding 0.4s var(--ease-out);
  }
  .tabs__list img {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    object-fit: contain;
    filter: grayscale(1) opacity(0.55);
    transition: filter 0.3s;
  }
  .tabs__list b {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .tabs__list em {
    display: block;
    margin-top: 6px;
    font-style: normal;
    font-size: 0.9rem;
    color: var(--dim);
  }
  .tabs__list button :global(svg) {
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 0.3s,
      transform 0.4s var(--ease-out);
    color: var(--accent-2);
  }
  .tabs__list button::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }
  .tabs__list button:hover {
    color: var(--muted);
  }
  .tabs__list button[aria-selected='true'] {
    color: #fff;
    padding-left: 8px;
  }
  .tabs__list button[aria-selected='true'] img {
    filter: none;
  }
  .tabs__list button[aria-selected='true'] em {
    color: var(--muted);
  }
  .tabs__list button[aria-selected='true'] :global(svg) {
    opacity: 1;
    transform: none;
  }
  .tabs__list button[aria-selected='true']::before {
    transform: scaleX(1);
  }
  .tabs__panel:not([hidden]) {
    animation: panel-in 0.7s var(--ease-out);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  .suite__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px 32px;
    margin-top: 20px;
  }
  .suite__foot p {
    flex: 1;
    min-width: 260px;
    max-width: 56ch;
    color: var(--muted);
  }

  /* ── processing ── */
  .proc__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 40px;
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .proc__head h2 {
    max-width: 14ch;
  }
  .proc__facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--paper-line);
  }
  .proc__facts li {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 28px clamp(18px, 2.6vw, 36px) 4px 0;
  }
  .proc__facts li + li {
    padding-left: clamp(18px, 2.6vw, 36px);
    border-left: 1px solid var(--paper-line);
  }
  .proc__facts p {
    color: var(--paper-muted);
  }

  /* ── agents ── */
  .studio {
    padding: clamp(22px, 4vw, 56px);
    border-radius: var(--r-lg);
    background: var(--paper);
  }
  .agents__cta {
    margin-top: clamp(28px, 4vw, 44px);
  }

  /* ── industries ── */
  .ind__list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px clamp(18px, 3vw, 40px);
    margin-top: 26px;
  }
  .ind__list a {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2.7rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.25;
    color: var(--dim);
    transition: color 0.3s;
  }
  .ind__list a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.08em;
    height: 2px;
    background: var(--cyan);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }
  .ind__list a:hover {
    color: #fff;
  }
  .ind__list a:hover::after {
    transform: scaleX(1);
  }

  /* ── close ── */
  .close {
    position: relative;
    padding: clamp(90px, 12vw, 170px) 0 clamp(190px, 22vw, 300px);
    overflow: hidden;
  }
  .close__inner {
    position: relative;
    display: grid;
    gap: 22px;
    justify-items: center;
    text-align: center;
  }
  .close .btn-row {
    justify-content: center;
    margin-top: 8px;
  }

  @media (max-width: 980px) {
    .hero {
      min-height: 0;
    }
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .orbit {
      justify-self: center;
      width: min(84vw, 380px);
      margin: 12px 0 0;
    }
    .tabs {
      grid-template-columns: 1fr;
    }
    .tabs__list {
      grid-template-columns: 1fr 1fr;
      border-top: 0;
      gap: 0 16px;
    }
    .tabs__list button {
      padding-block: 14px;
    }
    .tabs__list b {
      font-size: 1.5rem;
    }
    .tabs__list button :global(svg) {
      display: none;
    }
    .proc__facts {
      grid-template-columns: 1fr;
    }
    .proc__facts li,
    .proc__facts li + li {
      padding: 24px 0;
      border-left: 0;
      border-bottom: 1px solid var(--paper-line);
    }
  }
  @media (max-width: 520px) {
    .tabs__list img {
      width: 30px;
      height: 30px;
    }
    .tabs__list em {
      display: none;
    }
    .hero__ticker {
      font-size: 0.56rem;
      gap: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit__track,
    .orbit__sat,
    .orbit__core {
      animation: none;
    }
    .orbit__track {
      transform: rotate(calc(var(--t) * 360deg));
    }
    .orbit__sat {
      transform: rotate(calc(var(--t) * -360deg));
    }
  }
</style>
