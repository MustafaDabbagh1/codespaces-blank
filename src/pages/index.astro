</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Reveal-on-scroll for [data-anim]
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('animated'); io.unobserve(e.target); } });
  }, {threshold:.15});
  document.querySelectorAll('[data-anim]').forEach(el => io.observe(el));

  // Count-up — supports prefix, suffix, decimals, and thousand separators
  function fmt(val, decimals, useCommas){
    if(useCommas){
      return val.toLocaleString(undefined,{minimumFractionDigits:decimals,maximumFractionDigits:decimals});
    }
    return val.toFixed(decimals);
  }
  document.querySelectorAll('[data-count]').forEach(el => {
    const target = parseFloat(el.dataset.count);
    const suffix = el.dataset.suffix || '';
    const prefix = el.dataset.prefix || '';
    const decimals = parseInt(el.dataset.decimals) || 0;
    const useCommas = el.dataset.commas === '1';
    if(prefersReducedMotion){
      el.textContent = prefix + fmt(target, decimals, useCommas) + suffix;
      return;
    }
    el.textContent = prefix + '0' + suffix;
    const obs = new IntersectionObserver(entries => {
      if(entries[0].isIntersecting){
        let start = 0;
        const dur = 1800;
        const step = 16;
        const timer = setInterval(() => {
          start += step;
          const progress = Math.min(start / dur, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const val = eased * target;
          el.textContent = prefix + fmt(val, decimals, useCommas) + suffix;
          if(start >= dur){ clearInterval(timer); }
        }, step);
        obs.disconnect();
      }
    }, {threshold:.5});
    obs.observe(el);
  });

  // Hero parallax — translate dashboard visual with scroll
  const heroVisual = document.querySelector('.hp-hero__visual');
  if(heroVisual && !prefersReducedMotion){
    let raf = null;
    window.addEventListener('scroll', () => {
      if(raf) return;
      raf = requestAnimationFrame(() => {
        const y = window.scrollY;
        if(y < 900){
          heroVisual.style.transform = 'translateY(' + (y * 0.06).toFixed(1) + 'px)';
        }
        raf = null;
      });
    }, { passive: true });
  }

  // ── Hero dashboard tabs ──
  const dashTabBtns = document.querySelectorAll('.hp-dash__nav-item');
  const dashPanels = document.querySelectorAll('.hp-dash__panel');

  function fmtN(val, decimals, useCommas){
    if(useCommas){
      return val.toLocaleString(undefined,{minimumFractionDigits:decimals,maximumFractionDigits:decimals});
    }
    return val.toFixed(decimals);
  }
  function runPanelCounts(panel){
    panel.querySelectorAll('[data-pcount]').forEach(el => {
      const target = parseFloat(el.dataset.pcount);
      const suffix = el.dataset.suffix || '';
      const prefix = el.dataset.prefix || '';
      const decimals = parseInt(el.dataset.decimals) || 0;
      const useCommas = el.dataset.commas === '1';
      if(prefersReducedMotion){
        el.textContent = prefix + fmtN(target, decimals, useCommas) + suffix;
        return;
      }
      let start = 0;
      const dur = 1100;
      const step = 16;
      el.textContent = prefix + fmtN(0, decimals, useCommas) + suffix;
      const timer = setInterval(() => {
        start += step;
        const progress = Math.min(start / dur, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = prefix + fmtN(eased * target, decimals, useCommas) + suffix;
        if(start >= dur){ clearInterval(timer); }
      }, step);
    });
  }
  function reanimatePanel(panel){
    // Force-restart panel-row stagger by removing then re-adding is-active
    panel.classList.remove('is-active');
    void panel.offsetWidth;
    panel.classList.add('is-active');
    runPanelCounts(panel);
  }
  function setActiveTab(name){
    dashTabBtns.forEach(b => {
      const on = b.dataset.tab === name;
      b.classList.toggle('active', on);
      b.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    dashPanels.forEach(p => {
      const on = p.dataset.panel === name;
      if(on){
        p.hidden = false;
        reanimatePanel(p);
      } else {
        p.classList.remove('is-active');
        p.hidden = true;
      }
    });
  }
  dashTabBtns.forEach(b => {
    b.addEventListener('click', () => setActiveTab(b.dataset.tab));
  });

  // Initial count-up for the default (analytics) panel when it scrolls into view
  const initialPanel = document.querySelector('.hp-dash__panel.is-active');
  if(initialPanel){
    const initObs = new IntersectionObserver(entries => {
      if(entries[0].isIntersecting){
        runPanelCounts(initialPanel);
        initObs.disconnect();
      }
    }, {threshold:.2});
    initObs.observe(initialPanel);
  }

  // ── Operations panel toggle switches ──
  document.querySelectorAll('.hp-dash__setting .hp-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const next = btn.getAttribute('aria-checked') !== 'true';
      btn.setAttribute('aria-checked', next ? 'true' : 'false');
      btn.classList.toggle('is-on', next);
      const card = btn.closest('.hp-dash__setting');
      if(card) card.classList.toggle('is-on', next);
    });
  });

  // Dashboard simulated live activity — cycle pending row (only when analytics tab visible)
  const dashEl = document.querySelector('.hp-dash');
  const analyticsPanel = document.querySelector('.hp-dash__panel[data-panel="analytics"]');
  const dashRows = analyticsPanel ? analyticsPanel.querySelectorAll('.hp-dash__table-row') : [];
  if(dashEl && analyticsPanel && dashRows.length >= 3 && !prefersReducedMotion){
    const pendingRow = dashRows[dashRows.length - 1];
    const pendingBadge = pendingRow.querySelector('.hp-badge');
    const labelEl = pendingRow.querySelectorAll('span')[1];
    const amountEl = pendingRow.querySelector('.hp-dash__amount');
    const cards = ['Visa •••• 7821','MC •••• 3104','Amex •••• 1009','Visa •••• 4242','Disc •••• 6620'];
    const amts = ['$84.20','$216.90','$342.00','$58.75','$129.40'];
    let i = 0;
    let approved = false;
    let timer = null;
    const tick = () => {
      if(!pendingBadge) return;
      if(!analyticsPanel.classList.contains('is-active')) return;
      if(!approved){
        // Approve current pending
        pendingBadge.classList.remove('blue');
        pendingBadge.classList.add('green');
        pendingBadge.innerHTML = '<i class="fa-solid fa-check"></i>';
        pendingRow.classList.add('tx-approved');
        approved = true;
      } else {
        // Bring in a new pending tx
        i = (i + 1) % cards.length;
        if(labelEl) labelEl.textContent = cards[i];
        if(amountEl) amountEl.textContent = amts[i];
        pendingBadge.classList.remove('green');
        pendingBadge.classList.add('blue');
        pendingBadge.innerHTML = '<i class="fa-solid fa-clock"></i>';
        pendingRow.classList.remove('tx-approved');
        pendingRow.classList.add('tx-fresh');
        setTimeout(() => pendingRow.classList.remove('tx-fresh'), 600);
        approved = false;
      }
    };
    const dashObs = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if(entry.isIntersecting && !timer){
          timer = setInterval(tick, 2800);
        } else if(!entry.isIntersecting && timer){
          clearInterval(timer);
          timer = null;
        }
      });
    }, { threshold: 0.2 });
    dashObs.observe(dashEl);
  }

  // Industry card mouse-tracking spotlight + accent inheritance
  document.querySelectorAll('.hp-ind-card').forEach(card => {
    const iconEl = card.querySelector('.hp-ind-card__icon');
    const accent = iconEl && iconEl.style.getPropertyValue('--accent');
    if(accent) card.style.setProperty('--accent', accent);
    if(prefersReducedMotion) return;
    card.addEventListener('pointermove', e => {
      const rect = card.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      card.style.setProperty('--mx', x + '%');
      card.style.setProperty('--my', y + '%');
    });
  });

  /* ═══════════════ BUILDER WIDGET ═══════════════ */
  (() => {
    const root = document.getElementById('builder');
    if(!root) return;

    const INDUSTRY_LABEL = {
      restaurant:'Restaurant', retail:'Retail Store', repair:'Repair Shop', ecommerce:'E-commerce',
      b2b:'B2B / Wholesale', healthcare:'Healthcare', nonprofit:'Nonprofit',
      mobile:'Mobile Business', salon:'Salon / Spa', grocery:'Grocery / Market'
    };
    const FEATURES = {
      pos:       {icon:'fa-cash-register',         name:'POS System',                desc:'All-in-one register'},
      terminal:  {icon:'fa-credit-card',           name:'Credit Card Terminal',      desc:'Tap, swipe & dip'},
      online:    {icon:'fa-globe',                 name:'Online Payments',           desc:'Web & app checkout'},
      invoicing: {icon:'fa-file-invoice-dollar',   name:'Invoicing',                 desc:'Bill & collect online'},
      ach:       {icon:'fa-building-columns',      name:'ACH Payments',              desc:'Bank-to-bank transfers'},
      recurring: {icon:'fa-rotate',                name:'Recurring Billing',         desc:'Subscriptions & plans'},
      inventory: {icon:'fa-boxes-stacked',         name:'Inventory Management',      desc:'Stock, SKUs & alerts'},
      crm:       {icon:'fa-address-book',          name:'Customer Management',       desc:'Customer profiles & notes'},
      employee:  {icon:'fa-user-clock',            name:'Employee / Team',           desc:'Roles, hours & tips'},
      nextday:   {icon:'fa-bolt',                  name:'Next-Day Funding',          desc:'Funds in your bank fast'},
      dual:      {icon:'fa-percent',               name:'Cash Discount / Dual Pricing', desc:'Pass card fees on'},
      reports:   {icon:'fa-chart-line',            name:'Reporting Dashboard',       desc:'KPIs, exports & trends'},
      gift:      {icon:'fa-gift',                  name:'Gift Cards',                desc:'Branded gift cards'},
      loyalty:   {icon:'fa-medal',                 name:'Loyalty Program',           desc:'Points, tiers & rewards'},
      multiloc:  {icon:'fa-map-location-dot',      name:'Multi-Location Support',    desc:'Multiple stores in sync'},
      mobpay:    {icon:'fa-mobile-screen',         name:'Mobile Payments',           desc:'Phone or tablet checkout'},
      website:   {icon:'fa-laptop-code',           name:'Website Payments',          desc:'Embeddable widgets'},
      tickets:   {icon:'fa-clipboard-list',        name:'Repair Ticket Management',  desc:'Work orders & status'},
      menu:      {icon:'fa-utensils',              name:'Menu Management',           desc:'Items, modifiers & 86s'},
      table:     {icon:'fa-chair',                 name:'Table / Floor Management',  desc:'Floor map & seating'},
      barcode:   {icon:'fa-barcode',               name:'Barcode Scanning',          desc:'SKU lookup at checkout'}
    };
    const INDUSTRY_FEATURES = {
      restaurant:['pos','menu','table','online','terminal','employee','nextday','loyalty','gift','reports','dual'],
      retail:    ['pos','terminal','barcode','inventory','loyalty','gift','multiloc','nextday','reports','dual','employee'],
      repair:    ['pos','tickets','inventory','crm','terminal','nextday','reports','employee','invoicing'],
      ecommerce: ['online','website','recurring','crm','reports','gift','loyalty','invoicing','nextday'],
      b2b:       ['invoicing','ach','recurring','crm','terminal','reports','nextday','inventory'],
      healthcare:['terminal','recurring','online','crm','invoicing','reports','nextday'],
      nonprofit: ['online','recurring','website','crm','reports','nextday','invoicing'],
      mobile:    ['mobpay','terminal','online','nextday','reports','invoicing','crm'],
      salon:     ['pos','terminal','employee','crm','loyalty','gift','online','nextday','reports'],
      grocery:   ['pos','terminal','barcode','inventory','loyalty','multiloc','nextday','employee','reports']
    };
    /* One clean recommendation per industry */
    const RECOS = {
      restaurant:{icon:'fa-utensils',           badge:'Recommended for Restaurants',     title:'Restaurant POS System',         summary:'A complete front-of-house, kitchen, and online ordering system built for hospitality.',                    benefits:['Dine-in, takeout & delivery in one','Menu, modifiers & tip-aware checkout','Next-day funding & built-in reporting'],   bestFor:'Single-location and growing multi-unit restaurants'},
      retail:    {icon:'fa-store',              badge:'Recommended for Retail Stores',   title:'Korona POS',                    summary:'A modern omnichannel POS that keeps in-store, online, and inventory in sync.',                              benefits:['Barcode scanning & real-time inventory','Loyalty, gift cards & customer profiles','Multi-location reporting & dashboards'], bestFor:'Single-store and multi-location retailers'},
      repair:    {icon:'fa-screwdriver-wrench', badge:'Recommended for Repair Shops',    title:'PPD Repair',                    summary:'A simple repair shop system for tickets, inventory, customer updates, and payments.',                       benefits:['Repair ticket tracking','Inventory and parts management','Customer notifications'],                                  bestFor:'Phone, computer, jewelry & small-appliance repair'},
      ecommerce: {icon:'fa-cart-shopping',      badge:'Recommended for E-commerce',      title:'Online Payment Gateway',        summary:'A fast, secure online payment gateway with drop-in checkout for any storefront.',                            benefits:['Card, ACH & digital wallets','Recurring billing & customer vault','PCI-secure with low decline rates'],               bestFor:'Shopify, Woo, headless & custom storefronts'},
      b2b:       {icon:'fa-handshake',          badge:'Recommended for B2B Businesses',  title:'PPD Merchant Gateway',          summary:'A B2B payment platform with invoicing, ACH, and recurring billing built in.',                                benefits:['ACH and card payments','Invoicing with net terms','Recurring billing & customer accounts'],                          bestFor:'Wholesalers, distributors & service businesses'},
      healthcare:{icon:'fa-heart-pulse',        badge:'Recommended for Healthcare',      title:'PPD Merchant Gateway',          summary:'A PCI-secure payment platform for patient billing, plans, and online pay.',                                  benefits:['Secure patient payment links','Recurring billing & payment plans','Card-on-file with automated receipts'],            bestFor:'Practices, dental, vet & specialty clinics'},
      nonprofit: {icon:'fa-hand-holding-heart', badge:'Recommended for Nonprofits',      title:'Online Donations + Payment Gateway', summary:'A donor-friendly gateway with a hosted donation page and recurring giving.',                              benefits:['One-time & monthly giving','Embeddable donation widgets','Donor records & receipting'],                              bestFor:'501(c)(3) and faith-based organizations'},
      mobile:    {icon:'fa-truck',              badge:'Recommended for Mobile Businesses', title:'Dejavoo P17 Terminal',        summary:'A compact wireless smart terminal made for accepting payments anywhere.',                                    benefits:['Tap, swipe & dip on the go','Wi-Fi and 4G connectivity','Built-in receipts & next-day funding'],                     bestFor:'Field service, food trucks, pop-ups & contractors'},
      salon:     {icon:'fa-scissors',           badge:'Recommended for Salons & Spas',   title:'Smart POS System',              summary:'A tip-aware smart POS with stylist tracking, customer history, and gift cards.',                             benefits:['Tipping & stylist tracking','Appointments & customer profiles','Gift cards & loyalty rewards'],                      bestFor:'Salons, spas, barbershops & nail studios'},
      grocery:   {icon:'fa-basket-shopping',    badge:'Recommended for Grocery & Markets', title:'Korona POS',                  summary:'A high-throughput grocery POS with barcode scanning, inventory, and multi-store sync.',                      benefits:['Barcode scanning & fast checkout','Inventory and pricing control','Multi-location reporting'],                       bestFor:'Convenience, grocery and ethnic markets'}
    };

    const state = { step:1, industry:null, needs:new Set() };

    const $ = (sel) => root.querySelector(sel);
    const $$ = (sel) => root.querySelectorAll(sel);
    const steps = $$('.hp-builder__steps li');
    const panels = $$('.hp-builder__panel');
    const bar = $('#hpBuilderBar');
    const indCards = $$('.hp-bcard[data-bind]');
    const needsGrid = $('#hpBuilderNeeds');
    const indName = $('#hpBuilderIndName');
    const countEl = $('#hpBuilderCount');
    const recoEl = $('#hpBuilderReco');
    const nextStep1 = root.querySelector('[data-bnext="2"]');

    const goTo = (n) => {
      state.step = n;
      steps.forEach(li => {
        const i = +li.dataset.bstepind;
        li.classList.toggle('is-active', i === n);
        li.classList.toggle('is-done', i < n);
      });
      bar.style.width = (n / 3 * 100) + '%';
      panels.forEach(p => {
        const i = +p.dataset.bpanel;
        const on = i === n;
        if(on){
          p.hidden = false;
          void p.offsetWidth;
          p.classList.add('is-active');
          const focusable = p.querySelector('.hp-bcard, .btn');
          if(focusable && n !== 1) focusable.focus({preventScroll:true});
        } else {
          p.classList.remove('is-active');
          p.hidden = true;
        }
      });
      if(n === 3) renderReco();
      // scroll into view smoothly on small screens
      if(window.matchMedia('(max-width: 900px)').matches){
        root.scrollIntoView({behavior:'smooth', block:'start'});
      }
    };

    const renderNeeds = () => {
      const keys = INDUSTRY_FEATURES[state.industry] || [];
      needsGrid.innerHTML = keys.map(k => {
        const f = FEATURES[k];
        if(!f) return '';
        const on = state.needs.has(k);
        return `<button type="button" class="hp-bcard hp-bcard--need${on?' is-on':''}" data-bneed="${k}" aria-pressed="${on?'true':'false'}">
          <i class="fa-solid ${f.icon}"></i>
          <strong>${f.name}</strong>
          <span>${f.desc}</span>
        </button>`;
      }).join('');
      needsGrid.querySelectorAll('[data-bneed]').forEach(btn => {
        btn.addEventListener('click', () => {
          const k = btn.dataset.bneed;
          if(state.needs.has(k)) state.needs.delete(k); else state.needs.add(k);
          btn.classList.toggle('is-on');
          btn.setAttribute('aria-pressed', state.needs.has(k) ? 'true' : 'false');
          countEl.textContent = state.needs.size;
        });
      });
      countEl.textContent = state.needs.size;
      indName.textContent = INDUSTRY_LABEL[state.industry] || 'business';
    };

    const renderReco = () => {
      const r = RECOS[state.industry];
      if(!r){ recoEl.innerHTML = ''; return; }
      const benefits = r.benefits.map(b =>
        `<li><i class="fa-solid fa-check"></i><span>${b}</span></li>`
      ).join('');
      recoEl.innerHTML = `
        <span class="hp-reco__badge"><i class="fa-solid fa-wand-magic-sparkles"></i> ${r.badge}</span>
        <div class="hp-reco__head">
          <span class="hp-reco__icon"><i class="fa-solid ${r.icon}"></i></span>
          <div class="hp-reco__head-text">
            <div class="hp-reco__eyebrow">Your Recommended Setup</div>
            <h3 class="hp-reco__title">${r.title}</h3>
          </div>
        </div>
        <p class="hp-reco__summary-text">${r.summary}</p>
        <ul class="hp-reco__benefits">${benefits}</ul>
        <div class="hp-reco__bestfor">
          <span class="hp-reco__bestfor-lbl">Best for:</span>
          <span class="hp-reco__bestfor-val">${r.bestFor}</span>
        </div>
        <div class="hp-reco__cta-row">
          <button type="button" class="btn btn-primary hp-reco__cta" id="hpBuilderQuote2"><i class="fa-solid fa-arrow-right"></i> Get This Setup</button>
        </div>
      `;
      const q2 = document.getElementById('hpBuilderQuote2');
      if(q2) q2.addEventListener('click', openModal);
    };

    // Industry selection (radiogroup semantics + arrow-key nav)
    const selectIndustry = (card) => {
      state.industry = card.dataset.bind;
      state.needs.clear();
      indCards.forEach(c => {
        const on = c === card;
        c.classList.toggle('is-on', on);
        c.setAttribute('aria-checked', on ? 'true' : 'false');
        c.setAttribute('tabindex', on ? '0' : '-1');
      });
      nextStep1.disabled = false;
      const hint = $('#hpBuilderHint1');
      if(hint) hint.textContent = 'Great — click Continue to choose what you need.';
    };
    indCards.forEach((card, idx) => {
      card.addEventListener('click', () => selectIndustry(card));
      card.addEventListener('keydown', e => {
        const keys = ['ArrowRight','ArrowDown','ArrowLeft','ArrowUp','Home','End'];
        if(!keys.includes(e.key)) return;
        e.preventDefault();
        let next = idx;
        if(e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (idx + 1) % indCards.length;
        else if(e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (idx - 1 + indCards.length) % indCards.length;
        else if(e.key === 'Home') next = 0;
        else if(e.key === 'End') next = indCards.length - 1;
        const target = indCards[next];
        target.focus();
        selectIndustry(target);
      });
    });

    // Nav buttons
    root.querySelectorAll('[data-bnext]').forEach(b => {
      b.addEventListener('click', () => {
        const n = +b.dataset.bnext;
        if(n === 2 && !state.industry) return;
        if(n === 2) renderNeeds();
        goTo(n);
      });
    });
    root.querySelectorAll('[data-bback]').forEach(b => {
      b.addEventListener('click', () => goTo(+b.dataset.bback));
    });

    // ── Modal ──
    const modal = document.getElementById('hpBuilderModal');
    const fIndustry = document.getElementById('hpBuilderFIndustry');
    const fNeeds = document.getElementById('hpBuilderFNeeds');
    const fReco = document.getElementById('hpBuilderFReco');
    const fSummary = document.getElementById('hpBuilderFSummary');
    const form = document.getElementById('hpBuilderForm');
    const msg = document.getElementById('hpBuilderFMsg');
    let lastFocused = null;

    const openModal = () => {
      const r = RECOS[state.industry] || {};
      const needList = [...state.needs].map(k => FEATURES[k] ? FEATURES[k].name : '').filter(Boolean);
      fIndustry.value = INDUSTRY_LABEL[state.industry] || '';
      fNeeds.value = needList.join(', ');
      fReco.value = r.title || '';
      fSummary.innerHTML = `
        <strong>Your selections</strong><br>
        Industry: ${fIndustry.value || '—'}<br>
        Needs: ${fNeeds.value || '—'}<br>
        Recommended: ${fReco.value || '—'}
      `;
      msg.textContent = '';
      msg.className = 'hp-bmodal__msg';
      lastFocused = document.activeElement;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      setTimeout(() => { const i = form.querySelector('input[name="name"]'); if(i) i.focus(); }, 50);
    };
    const closeModal = () => {
      modal.hidden = true;
      document.body.style.overflow = '';
      if(lastFocused && lastFocused.focus) lastFocused.focus();
    };

    const quoteBtn = document.getElementById('hpBuilderQuote');
    if(quoteBtn) quoteBtn.addEventListener('click', openModal);
    modal.querySelectorAll('[data-bclose]').forEach(el => el.addEventListener('click', closeModal));
    document.addEventListener('keydown', e => {
      if(e.key === 'Escape' && !modal.hidden) closeModal();
    });

    // Form submit — POSTs to /api/lead (same convention as other forms on the site).
    // TODO: wire to email backend or Formspree when ready.
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.textContent = 'Sending…';
      msg.className = 'hp-bmodal__msg';
      try {
        const data = new FormData(form);
        const res = await fetch('/api/lead', { method:'POST', body:data });
        if(res.ok){
          msg.textContent = 'Thanks — we\'ll be in touch within one business day.';
          msg.className = 'hp-bmodal__msg is-ok';
          form.reset();
          setTimeout(closeModal, 1800);
        } else {
          throw new Error('bad response');
        }
      } catch(err){
        msg.textContent = 'Could not send right now — please call or email us directly.';
        msg.className = 'hp-bmodal__msg is-err';
      }
    });
  })();
</script>
