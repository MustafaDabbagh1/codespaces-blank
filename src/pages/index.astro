---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PPD Technology | Modern Payment Processing Platform">

  <!-- ══════════════ HERO ══════════════ -->
  <section class="hp-hero" id="hero">
    <div class="hp-hero__bg-grid"></div>
    <div class="hp-hero__orb hp-hero__orb--1"></div>
    <div class="hp-hero__orb hp-hero__orb--2"></div>

    <div class="container hp-hero__inner">
      <div class="hp-hero__text">
        <span class="hp-pill"><i class="fa-solid fa-bolt"></i> Next-Gen Payment Infrastructure</span>
        <h1>The Operating System<br>for <span class="hp-grad-text">Modern Payments</span></h1>
        <p>One platform to accept, manage, and grow every payment — in-store, online, and on the go. Real-time analytics. Instant funding. Enterprise-grade security.</p>
        <div class="hp-hero__actions">
          <a class="btn btn-primary btn-lg" href="/signup"><i class="fa-solid fa-rocket"></i> Start Processing</a>
          <a class="btn btn-outline btn-lg" href="/contact"><i class="fa-solid fa-calendar"></i> Book a Demo</a>
        </div>
        <div class="hp-hero__proof">
          <div class="hp-hero__proof-avatars">
            <span style="background:#2D60FF;"><i class="fa-solid fa-building" style="font-size:11px;color:#fff"></i></span>
            <span style="background:#00CFFF;"><i class="fa-solid fa-store" style="font-size:11px;color:#fff"></i></span>
            <span style="background:#00E5A0;"><i class="fa-solid fa-utensils" style="font-size:11px;color:#fff"></i></span>
          </div>
          <p>Trusted by <strong>thousands</strong> of businesses nationwide</p>
        </div>
      </div>

      <div class="hp-hero__visual">
        <div class="hp-dash">
          <div class="hp-dash__bar">
            <span class="hp-dash__dot" style="background:#ff5f57"></span>
            <span class="hp-dash__dot" style="background:#febc2e"></span>
            <span class="hp-dash__dot" style="background:#28c840"></span>
            <span class="hp-dash__bar-title">PPD Dashboard</span>
          </div>
          <div class="hp-dash__body">
            <div class="hp-dash__sidebar">
              <div class="hp-dash__nav-item active"><i class="fa-solid fa-chart-line"></i></div>
              <div class="hp-dash__nav-item"><i class="fa-solid fa-wallet"></i></div>
              <div class="hp-dash__nav-item"><i class="fa-solid fa-users"></i></div>
              <div class="hp-dash__nav-item"><i class="fa-solid fa-gear"></i></div>
            </div>
            <div class="hp-dash__main">
              <div class="hp-dash__stat-row">
                <div class="hp-dash__stat">
                  <span class="hp-dash__stat-label">Today's Revenue</span>
                  <span class="hp-dash__stat-value">$12,847</span>
                  <span class="hp-dash__stat-change up"><i class="fa-solid fa-arrow-up"></i> 18.2%</span>
                </div>
                <div class="hp-dash__stat">
                  <span class="hp-dash__stat-label">Transactions</span>
                  <span class="hp-dash__stat-value">1,284</span>
                  <span class="hp-dash__stat-change up"><i class="fa-solid fa-arrow-up"></i> 12.6%</span>
                </div>
              </div>
              <div class="hp-dash__chart">
                <svg viewBox="0 0 300 80" preserveAspectRatio="none" class="hp-chart-svg">
                  <defs>
                    <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="rgba(21,73,255,.4)"/>
                      <stop offset="100%" stop-color="rgba(21,73,255,0)"/>
                    </linearGradient>
                  </defs>
                  <path d="M0 70 Q30 60 60 50 T120 35 T180 25 T240 20 T300 10 V80 H0 Z" fill="url(#chartGrad)"/>
                  <path d="M0 70 Q30 60 60 50 T120 35 T180 25 T240 20 T300 10" fill="none" stroke="#1549FF" stroke-width="2"/>
                </svg>
              </div>
              <div class="hp-dash__table">
                <div class="hp-dash__table-row">
                  <span class="hp-badge green"><i class="fa-solid fa-check"></i></span>
                  <span>Visa •••• 4242</span>
                  <span class="hp-dash__amount">$189.00</span>
                </div>
                <div class="hp-dash__table-row">
                  <span class="hp-badge green"><i class="fa-solid fa-check"></i></span>
                  <span>MC •••• 8831</span>
                  <span class="hp-dash__amount">$67.50</span>
                </div>
                <div class="hp-dash__table-row">
                  <span class="hp-badge blue"><i class="fa-solid fa-clock"></i></span>
                  <span>Amex •••• 1009</span>
                  <span class="hp-dash__amount">$342.00</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="hp-float hp-float--approval">
          <i class="fa-solid fa-circle-check"></i>
          <div>
            <strong>Payment Approved</strong>
            <span>Visa •••• 4242 — $189.00</span>
          </div>
        </div>

        <div class="hp-float hp-float--payout">
          <i class="fa-solid fa-money-bill-transfer"></i>
          <div>
            <strong>Next-Day Payout</strong>
            <span>$8,421.00 depositing</span>
          </div>
        </div>

        <div class="hp-float hp-float--shield">
          <i class="fa-solid fa-shield-halved"></i>
          <span>PCI Level 1</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ BRAND MARQUEE ══════════════ -->
  <div class="hp-marquee">
    <div class="container">
      <div class="hp-marquee__track" id="brandsViewport">
        <div class="hp-marquee__inner">
          <span class="hp-marquee__pill"><i class="fa-brands fa-cc-visa"></i> Visa</span>
          <span class="hp-marquee__pill"><i class="fa-brands fa-cc-mastercard"></i> Mastercard</span>
          <span class="hp-marquee__pill"><i class="fa-brands fa-cc-amex"></i> Amex</span>
          <span class="hp-marquee__pill"><i class="fa-brands fa-cc-discover"></i> Discover</span>
          <span class="hp-marquee__pill"><i class="fa-brands fa-apple-pay"></i> Apple Pay</span>
          <span class="hp-marquee__pill"><i class="fa-brands fa-google-pay"></i> Google Pay</span>
          <span class="hp-marquee__pill" aria-hidden="true"><i class="fa-brands fa-cc-visa"></i> Visa</span>
          <span class="hp-marquee__pill" aria-hidden="true"><i class="fa-brands fa-cc-mastercard"></i> Mastercard</span>
          <span class="hp-marquee__pill" aria-hidden="true"><i class="fa-brands fa-cc-amex"></i> Amex</span>
          <span class="hp-marquee__pill" aria-hidden="true"><i class="fa-brands fa-cc-discover"></i> Discover</span>
          <span class="hp-marquee__pill" aria-hidden="true"><i class="fa-brands fa-apple-pay"></i> Apple Pay</span>
          <span class="hp-marquee__pill" aria-hidden="true"><i class="fa-brands fa-google-pay"></i> Google Pay</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════ STATS / PROOF ══════════════ -->
  <section class="hp-stats" id="stats">
    <div class="container">
      <div class="hp-stats__grid">
        <div class="hp-stat-card" data-anim>
          <div class="hp-stat-card__icon"><i class="fa-solid fa-bolt"></i></div>
          <div class="hp-stat-card__num" data-count="99.99" data-suffix="%" data-decimals="2">99.99%</div>
          <div class="hp-stat-card__label">Platform Uptime</div>
          <div class="hp-stat-card__sub">Enterprise-grade reliability</div>
        </div>
        <div class="hp-stat-card" data-anim>
          <div class="hp-stat-card__icon"><i class="fa-solid fa-clock"></i></div>
          <div class="hp-stat-card__num" data-count="24" data-suffix="/7" data-decimals="0">24/7</div>
          <div class="hp-stat-card__label">Expert Support</div>
          <div class="hp-stat-card__sub">U.S.-based team, always on</div>
        </div>
        <div class="hp-stat-card" data-anim>
          <div class="hp-stat-card__icon"><i class="fa-solid fa-gauge-high"></i></div>
          <div class="hp-stat-card__num" data-count="1" data-suffix=" Day" data-decimals="0">1 Day</div>
          <div class="hp-stat-card__label">Funding Speed</div>
          <div class="hp-stat-card__sub">Funds in your account fast</div>
        </div>
        <div class="hp-stat-card" data-anim>
          <div class="hp-stat-card__icon"><i class="fa-solid fa-shield-halved"></i></div>
          <div class="hp-stat-card__num" data-count="100" data-suffix="%" data-decimals="0">100%</div>
          <div class="hp-stat-card__label">PCI Compliant</div>
          <div class="hp-stat-card__sub">Bank-level security built in</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ PLATFORM FEATURES ══════════════ -->
  <section class="hp-platform" id="platform">
    <div class="container">
      <div class="hp-section-header">
        <span class="hp-pill hp-pill--light"><i class="fa-solid fa-cubes"></i> Platform Capabilities</span>
        <h2>The Complete Payment<br><span class="hp-grad-text">Ecosystem</span></h2>
        <p>More than processing — a unified platform that powers every aspect of your business payments.</p>
      </div>

      <div class="hp-platform__grid">
        <div class="hp-plat-card" data-anim>
          <div class="hp-plat-card__icon"><i class="fa-solid fa-chart-mixed"></i></div>
          <h3>Real-Time Analytics</h3>
          <p>Live dashboards, revenue tracking, and performance insights at your fingertips — no spreadsheets needed.</p>
          <div class="hp-plat-card__visual">
            <div class="hp-mini-chart">
              <div class="hp-mini-chart__bar" style="height:40%"></div>
              <div class="hp-mini-chart__bar" style="height:65%"></div>
              <div class="hp-mini-chart__bar" style="height:50%"></div>
              <div class="hp-mini-chart__bar" style="height:80%"></div>
              <div class="hp-mini-chart__bar" style="height:70%"></div>
              <div class="hp-mini-chart__bar hp-mini-chart__bar--active" style="height:95%"></div>
            </div>
          </div>
        </div>

        <div class="hp-plat-card" data-anim>
          <div class="hp-plat-card__icon"><i class="fa-solid fa-arrows-split-up-and-left"></i></div>
          <h3>Omnichannel Payments</h3>
          <p>Accept payments in-store, online, mobile, and contactless — all managed from one unified platform.</p>
          <div class="hp-plat-card__visual">
            <div class="hp-channel-dots">
              <span><i class="fa-solid fa-store"></i></span>
              <span><i class="fa-solid fa-globe"></i></span>
              <span><i class="fa-solid fa-mobile-screen"></i></span>
              <span><i class="fa-solid fa-wifi"></i></span>
            </div>
          </div>
        </div>

        <div class="hp-plat-card" data-anim>
          <div class="hp-plat-card__icon"><i class="fa-solid fa-terminal"></i></div>
          <h3>Hardware + Software</h3>
          <p>From countertop terminals to mobile readers, paired with software that automates your entire payment workflow.</p>
          <div class="hp-plat-card__visual">
            <div class="hp-device-stack">
              <div class="hp-device hp-device--terminal"><i class="fa-solid fa-credit-card"></i></div>
              <div class="hp-device hp-device--mobile"><i class="fa-solid fa-mobile-screen-button"></i></div>
            </div>
          </div>
        </div>

        <div class="hp-plat-card" data-anim>
          <div class="hp-plat-card__icon"><i class="fa-solid fa-shield-halved"></i></div>
          <h3>Enterprise Security</h3>
          <p>PCI Level 1 compliance, end-to-end encryption, tokenization, and 3D-Secure built into every transaction.</p>
          <div class="hp-plat-card__visual">
            <div class="hp-shield-visual">
              <i class="fa-solid fa-lock"></i>
              <div class="hp-shield-rings">
                <span></span><span></span><span></span>
              </div>
            </div>
          </div>
        </div>

        <div class="hp-plat-card" data-anim>
          <div class="hp-plat-card__icon"><i class="fa-solid fa-money-bill-trend-up"></i></div>
          <h3>Smart Funding</h3>
          <p>Next-day deposits, transparent fee breakdowns, and detailed settlement reports so you always know your cash position.</p>
          <div class="hp-plat-card__visual">
            <div class="hp-funding-bar">
              <div class="hp-funding-bar__fill"></div>
              <span>$8,421 depositing</span>
            </div>
          </div>
        </div>

        <div class="hp-plat-card" data-anim>
          <div class="hp-plat-card__icon"><i class="fa-solid fa-headset"></i></div>
          <h3>Dedicated Support</h3>
          <p>U.S.-based experts available 24/7 by phone, chat, or email. Real people who understand your business.</p>
          <div class="hp-plat-card__visual">
            <div class="hp-support-visual">
              <div class="hp-support-bubble">How can I help?</div>
              <div class="hp-support-status"><span class="hp-pulse-dot"></span> Live now</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ HOW IT WORKS ══════════════ -->
  <section class="hp-flow" id="flow">
    <div class="container">
      <div class="hp-section-header">
        <span class="hp-pill hp-pill--dark"><i class="fa-solid fa-route"></i> How It Works</span>
        <h2 class="hp-flow__heading">Up and Running in<br><span class="hp-grad-text">Four Simple Steps</span></h2>
        <p class="hp-flow__sub">From sign-up to scale — we make the process seamless.</p>
      </div>

      <div class="hp-flow__steps">
        <div class="hp-flow__connector"></div>

        <div class="hp-step" data-anim>
          <div class="hp-step__number">01</div>
          <div class="hp-step__icon"><i class="fa-solid fa-pen-to-square"></i></div>
          <h3>Apply Online</h3>
          <p>Quick application with fast approvals — most accounts go live within 24–48 hours.</p>
        </div>

        <div class="hp-step" data-anim>
          <div class="hp-step__number">02</div>
          <div class="hp-step__icon"><i class="fa-solid fa-plug"></i></div>
          <h3>Connect & Configure</h3>
          <p>Set up your terminals, integrate your POS, and customize your payment flow.</p>
        </div>

        <div class="hp-step" data-anim>
          <div class="hp-step__number">03</div>
          <div class="hp-step__icon"><i class="fa-solid fa-credit-card"></i></div>
          <h3>Accept Payments</h3>
          <p>Start processing every major card, digital wallet, and contactless payment instantly.</p>
        </div>

        <div class="hp-step" data-anim>
          <div class="hp-step__number">04</div>
          <div class="hp-step__icon"><i class="fa-solid fa-chart-line"></i></div>
          <h3>Track & Scale</h3>
          <p>Monitor performance in real time, access reports, and grow with the platform.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ ECOSYSTEM ══════════════ -->
  <section class="hp-eco" id="ecosystem">
    <div class="container">
      <div class="hp-section-header">
        <span class="hp-pill hp-pill--light"><i class="fa-solid fa-circle-nodes"></i> Connected Ecosystem</span>
        <h2>One Platform.<br><span class="hp-grad-text">Every Channel.</span></h2>
        <p>Whether your customers pay in-store, online, or on the go — PPD connects it all into a single, powerful ecosystem.</p>
      </div>

      <div class="hp-eco__hub">
        <div class="hp-eco__center">
          <div class="hp-eco__logo-ring">
            <span class="brandtext"><span class="ppd">PPD</span><span class="tech">Tech</span></span>
          </div>
        </div>
        <div class="hp-eco__nodes">
          <div class="hp-eco__node" style="--angle:0deg" data-anim>
            <div class="hp-eco__node-icon"><i class="fa-solid fa-store"></i></div>
            <span>In-Store POS</span>
          </div>
          <div class="hp-eco__node" style="--angle:60deg" data-anim>
            <div class="hp-eco__node-icon"><i class="fa-solid fa-globe"></i></div>
            <span>E-Commerce</span>
          </div>
          <div class="hp-eco__node" style="--angle:120deg" data-anim>
            <div class="hp-eco__node-icon"><i class="fa-solid fa-mobile-screen-button"></i></div>
            <span>Mobile Pay</span>
          </div>
          <div class="hp-eco__node" style="--angle:180deg" data-anim>
            <div class="hp-eco__node-icon"><i class="fa-solid fa-receipt"></i></div>
            <span>Invoicing</span>
          </div>
          <div class="hp-eco__node" style="--angle:240deg" data-anim>
            <div class="hp-eco__node-icon"><i class="fa-solid fa-chart-pie"></i></div>
            <span>Reporting</span>
          </div>
          <div class="hp-eco__node" style="--angle:300deg" data-anim>
            <div class="hp-eco__node-icon"><i class="fa-solid fa-puzzle-piece"></i></div>
            <span>Integrations</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ INDUSTRY SOLUTIONS ══════════════ -->
  <section class="hp-industries" id="industries">
    <div class="container">
      <div class="hp-section-header">
        <span class="hp-pill hp-pill--light"><i class="fa-solid fa-grid-2"></i> Industry Solutions</span>
        <h2>Purpose-Built for<br><span class="hp-grad-text">Your Industry</span></h2>
        <p>Tailored payment workflows designed for the way your industry actually works.</p>
      </div>

      <div class="hp-ind__grid">
        <a href="/restaurants" class="hp-ind-card" data-anim>
          <div class="hp-ind-card__icon" style="--accent:#F97316"><i class="fa-solid fa-utensils"></i></div>
          <div class="hp-ind-card__content">
            <h3>Restaurants & Hospitality</h3>
            <p>Tableside ordering, tipping, QR pay, and POS integrations built for speed.</p>
          </div>
          <span class="hp-ind-card__arrow"><i class="fa-solid fa-arrow-right"></i></span>
        </a>

        <a href="/retail" class="hp-ind-card" data-anim>
          <div class="hp-ind-card__icon" style="--accent:#3B82F6"><i class="fa-solid fa-store"></i></div>
          <div class="hp-ind-card__content">
            <h3>Retail</h3>
            <p>Inventory-friendly POS, receipts, exchanges, and unified in-store payments.</p>
          </div>
          <span class="hp-ind-card__arrow"><i class="fa-solid fa-arrow-right"></i></span>
        </a>

        <a href="/ecommerce" class="hp-ind-card" data-anim>
          <div class="hp-ind-card__icon" style="--accent:#8B5CF6"><i class="fa-solid fa-laptop"></i></div>
          <div class="hp-ind-card__content">
            <h3>E-Commerce</h3>
            <p>Checkout, subscriptions, and cart integrations with strong fraud protection.</p>
          </div>
          <span class="hp-ind-card__arrow"><i class="fa-solid fa-arrow-right"></i></span>
        </a>

        <a href="/healthcare" class="hp-ind-card" data-anim>
          <div class="hp-ind-card__icon" style="--accent:#06B6D4"><i class="fa-solid fa-user-doctor"></i></div>
          <div class="hp-ind-card__content">
            <h3>Healthcare</h3>
            <p>Co-pays, invoicing, and card-on-file streamlined for clinics and practices.</p>
          </div>
          <span class="hp-ind-card__arrow"><i class="fa-solid fa-arrow-right"></i></span>
        </a>

        <a href="/contractors" class="hp-ind-card" data-anim>
          <div class="hp-ind-card__icon" style="--accent:#EAB308"><i class="fa-solid fa-helmet-safety"></i></div>
          <div class="hp-ind-card__content">
            <h3>Contractors</h3>
            <p>Field payments, estimates-to-invoice, and mobile terminals that go where you do.</p>
          </div>
          <span class="hp-ind-card__arrow"><i class="fa-solid fa-arrow-right"></i></span>
        </a>

        <a href="/non-profits" class="hp-ind-card" data-anim>
          <div class="hp-ind-card__icon" style="--accent:#EC4899"><i class="fa-solid fa-hand-holding-heart"></i></div>
          <div class="hp-ind-card__content">
            <h3>Non-Profits</h3>
            <p>Donations, recurring gifts, and low-friction tax receipts built in.</p>
          </div>
          <span class="hp-ind-card__arrow"><i class="fa-solid fa-arrow-right"></i></span>
        </a>

        <a href="/higher-education" class="hp-ind-card" data-anim>
          <div class="hp-ind-card__icon" style="--accent:#A855F7"><i class="fa-solid fa-graduation-cap"></i></div>
          <div class="hp-ind-card__content">
            <h3>Higher Education</h3>
            <p>Tuition, events, bookstores, and housing with centralized reconciliation.</p>
          </div>
          <span class="hp-ind-card__arrow"><i class="fa-solid fa-arrow-right"></i></span>
        </a>

        <a href="/repair" class="hp-ind-card" data-anim>
          <div class="hp-ind-card__icon" style="--accent:#10B981"><i class="fa-solid fa-screwdriver-wrench"></i></div>
          <div class="hp-ind-card__content">
            <h3>Repair Shops</h3>
            <p>Tickets, inventory, POS, and employee management for phone, tech, and device repair.</p>
          </div>
          <span class="hp-ind-card__arrow"><i class="fa-solid fa-arrow-right"></i></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════ FINAL CTA ══════════════ -->
  <section class="hp-cta" id="hpCta">
    <div class="hp-cta__bg-grid"></div>
    <span class="hp-cta__orb hp-cta__orb--1"></span>
    <span class="hp-cta__orb hp-cta__orb--2"></span>

    <div class="container hp-cta__inner">
      <span class="hp-pill hp-pill--dark"><i class="fa-solid fa-rocket"></i> Get Started Today</span>
      <h2>Ready to Modernize<br>Your <span class="hp-grad-text">Payment Stack</span>?</h2>
      <p>Join the businesses upgrading to a smarter, faster, more secure way to accept payments. No long-term contracts. No hidden fees. Just results.</p>
      <div class="hp-cta__actions">
        <a class="btn btn-white btn-lg" href="/signup">Start Processing <i class="fa-solid fa-arrow-right"></i></a>
        <a class="btn btn-outline btn-lg" href="/contact">Talk to Sales</a>
      </div>
      <div class="hp-cta__badges">
        <span><i class="fa-solid fa-shield-halved"></i> PCI Level 1</span>
        <span><i class="fa-solid fa-bolt"></i> Next-Day Funding</span>
        <span><i class="fa-solid fa-headset"></i> 24/7 Support</span>
        <span><i class="fa-solid fa-file-contract"></i> No Contracts</span>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ═══════════════════════════════════════════════════════════════
   HOMEPAGE STYLES
   ═══════════════════════════════════════════════════════════════ */

/* ── Reusable pieces ── */
.hp-grad-text{
  background:linear-gradient(135deg,var(--cyan),var(--blue-mid));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.hp-pill{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);
  padding:7px 16px;border-radius:var(--r-pill);
  font-size:12px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;
  backdrop-filter:blur(8px);color:rgba(255,255,255,.9);
}
.hp-pill i{color:var(--cyan)}
.hp-pill--light{
  background:rgba(21,73,255,.08);color:var(--blue);border-color:rgba(21,73,255,.15);
}
.hp-pill--light i{color:var(--blue)}
.hp-pill--dark{
  background:rgba(255,255,255,.08);color:rgba(255,255,255,.9);border-color:rgba(255,255,255,.15);
}
.hp-pill--dark i{color:var(--cyan)}
.btn-lg{padding:14px 28px;font-size:15px}
.btn-white{background:#fff;color:var(--blue);font-weight:700;box-shadow:0 8px 32px rgba(0,0,0,.25)}
.btn-white:hover{background:rgba(255,255,255,.92);transform:translateY(-3px);box-shadow:0 16px 48px rgba(0,0,0,.35)}
.hp-section-header{text-align:center;margin-bottom:56px}
.hp-section-header h2{
  font-size:clamp(1.9rem,4vw,2.8rem);font-weight:800;
  letter-spacing:-.025em;line-height:1.18;margin:16px 0 14px;
  color:var(--text-1);
}
.hp-section-header p{font-size:1.05rem;color:var(--text-2);max-width:580px;margin:0 auto;line-height:1.7}
.hp-flow__heading,.hp-flow__sub{color:#fff !important}

/* ── HERO ── */
.hp-hero{
  background:linear-gradient(160deg,#060E21 0%,#0C1A38 55%,#0a1c42 100%);
  color:#fff;position:relative;overflow:hidden;
  padding:clamp(100px,12vw,140px) 0 clamp(60px,8vw,100px);
}
.hp-hero__bg-grid{
  position:absolute;inset:0;
  background:
    url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  pointer-events:none;
}
.hp-hero__orb{position:absolute;border-radius:50%;filter:blur(100px);opacity:.18;pointer-events:none}
.hp-hero__orb--1{width:600px;height:600px;background:var(--blue);top:-300px;right:-200px;animation:orbFloat 20s ease-in-out infinite}
.hp-hero__orb--2{width:400px;height:400px;background:var(--cyan);bottom:-200px;left:-100px;animation:orbFloat 25s ease-in-out infinite reverse}

.hp-hero__inner{
  display:grid;grid-template-columns:1fr;gap:48px;
  position:relative;z-index:2;align-items:center;
}
.hp-hero__text{max-width:560px}
.hp-hero__text h1{
  font-size:clamp(2.2rem,5.5vw,3.6rem);line-height:1.1;font-weight:800;
  letter-spacing:-.03em;margin:20px 0;
}
.hp-hero__text>p{
  font-size:clamp(1rem,1.8vw,1.12rem);opacity:.8;
  line-height:1.75;margin-bottom:32px;max-width:48ch;
}
.hp-hero__actions{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:28px}
.hp-hero__proof{display:flex;align-items:center;gap:10px}
.hp-hero__proof-avatars{display:flex}
.hp-hero__proof-avatars span{
  width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  border:2px solid var(--navy);margin-left:-6px;
}
.hp-hero__proof-avatars span:first-child{margin-left:0}
.hp-hero__proof p{font-size:13px;opacity:.65}
.hp-hero__proof strong{color:var(--cyan);opacity:1}

/* ── Hero Dashboard Visual ── */
.hp-hero__visual{position:relative;perspective:1200px}
.hp-dash{
  background:rgba(12,26,56,.85);
  border:1px solid rgba(255,255,255,.1);
  border-radius:14px;overflow:hidden;
  box-shadow:0 30px 80px rgba(0,0,0,.5),0 0 0 1px rgba(255,255,255,.05);
  backdrop-filter:blur(20px);
  transform:rotateY(-4deg) rotateX(2deg);
  transition:transform .6s ease;
  animation:dashFloat 8s ease-in-out infinite;
}
.hp-dash:hover{transform:rotateY(0) rotateX(0)}
.hp-dash__bar{
  display:flex;align-items:center;gap:6px;
  padding:10px 14px;background:rgba(0,0,0,.3);
  border-bottom:1px solid rgba(255,255,255,.06);
}
.hp-dash__dot{width:10px;height:10px;border-radius:50%}
.hp-dash__bar-title{margin-left:auto;font-size:11px;opacity:.4;font-weight:500}
.hp-dash__body{display:flex;min-height:260px}
.hp-dash__sidebar{
  width:48px;background:rgba(0,0,0,.15);
  border-right:1px solid rgba(255,255,255,.06);
  display:flex;flex-direction:column;align-items:center;gap:4px;padding:12px 0;
}
.hp-dash__nav-item{
  width:34px;height:34px;border-radius:8px;
  display:flex;align-items:center;justify-content:center;
  color:rgba(255,255,255,.35);font-size:14px;
  transition:all .2s;cursor:pointer;
}
.hp-dash__nav-item.active{background:rgba(21,73,255,.3);color:var(--cyan)}
.hp-dash__nav-item:hover{color:rgba(255,255,255,.7)}
.hp-dash__main{flex:1;padding:16px;display:flex;flex-direction:column;gap:12px}
.hp-dash__stat-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.hp-dash__stat{
  background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);
  border-radius:10px;padding:12px;
}
.hp-dash__stat-label{display:block;font-size:10px;opacity:.5;margin-bottom:4px;text-transform:uppercase;letter-spacing:.04em}
.hp-dash__stat-value{display:block;font-size:20px;font-weight:800;letter-spacing:-.02em}
.hp-dash__stat-change{font-size:10px;font-weight:600}
.hp-dash__stat-change.up{color:var(--green)}
.hp-dash__chart{
  background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.05);
  border-radius:10px;padding:10px;overflow:hidden;
}
.hp-chart-svg{width:100%;height:60px;display:block}
.hp-dash__table{display:flex;flex-direction:column;gap:6px}
.hp-dash__table-row{
  display:flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.03);border-radius:8px;
  padding:8px 10px;font-size:12px;
}
.hp-badge{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:8px}
.hp-badge.green{background:rgba(0,229,160,.2);color:var(--green)}
.hp-badge.blue{background:rgba(21,73,255,.2);color:var(--blue-mid)}
.hp-dash__amount{margin-left:auto;font-weight:700;font-size:13px}

/* Floating cards */
.hp-float{
  position:absolute;
  background:rgba(12,26,56,.92);
  border:1px solid rgba(255,255,255,.12);
  border-radius:12px;padding:12px 16px;
  backdrop-filter:blur(16px);
  box-shadow:0 12px 40px rgba(0,0,0,.4);
  display:flex;align-items:center;gap:10px;
  font-size:12px;z-index:5;
  opacity:0;animation:floatCardIn .8s ease forwards;
}
.hp-float i{font-size:18px}
.hp-float strong{display:block;font-size:12px;font-weight:600}
.hp-float span{opacity:.55;font-size:11px}
.hp-float--approval{top:15%;right:-10px;animation-delay:.6s}
.hp-float--approval i{color:var(--green)}
.hp-float--payout{bottom:20%;left:-10px;animation-delay:.9s}
.hp-float--payout i{color:var(--cyan)}
.hp-float--shield{top:50%;right:-16px;animation-delay:1.2s;gap:8px}
.hp-float--shield i{color:var(--blue-mid);font-size:16px}
.hp-float--shield span{opacity:.8;font-weight:600;font-size:12px}

@keyframes dashFloat{0%,100%{transform:rotateY(-4deg) rotateX(2deg)}50%{transform:rotateY(-2deg) rotateX(1deg) translateY(-6px)}}
@keyframes floatCardIn{from{opacity:0;transform:translateY(16px) scale(.95)}to{opacity:1;transform:translateY(0) scale(1)}}

/* ── MARQUEE ── */
.hp-marquee{
  background:#fff;padding:16px 0;overflow:hidden;
  border-top:1px solid var(--border);border-bottom:1px solid var(--border);
}
.hp-marquee__track{overflow:hidden;position:relative}
.hp-marquee__track::before,.hp-marquee__track::after{
  content:"";position:absolute;top:0;bottom:0;width:60px;pointer-events:none;z-index:2;
}
.hp-marquee__track::before{left:0;background:linear-gradient(90deg,#fff,transparent)}
.hp-marquee__track::after{right:0;background:linear-gradient(270deg,#fff,transparent)}
.hp-marquee__inner{
  display:flex;gap:14px;width:max-content;
  animation:marqueeScroll 25s linear infinite;
}
.hp-marquee__pill{
  display:inline-flex;align-items:center;gap:8px;padding:9px 18px;
  border-radius:var(--r-pill);background:var(--surface);
  border:1px solid var(--border);font-weight:500;font-size:14px;color:var(--text-2);
  white-space:nowrap;flex:0 0 auto;
}
.hp-marquee__pill i{font-size:20px;color:var(--text-3)}
@keyframes marqueeScroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* ── STATS ── */
.hp-stats{padding:var(--section-py-sm) 0;background:var(--surface)}
.hp-stats__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.hp-stat-card{
  background:#fff;border:1px solid var(--border);border-radius:var(--r-lg);
  padding:28px 24px;text-align:center;
  box-shadow:var(--shadow-sm);position:relative;overflow:hidden;
  opacity:0;transform:translateY(20px);transition:all .6s ease;
}
.hp-stat-card.animated{opacity:1;transform:translateY(0)}
.hp-stat-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,var(--blue),var(--cyan));
  transform:scaleX(0);transition:transform .8s ease .2s;transform-origin:left;
}
.hp-stat-card.animated::before{transform:scaleX(1)}
.hp-stat-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md)}
.hp-stat-card__icon{
  width:48px;height:48px;margin:0 auto 14px;
  background:rgba(21,73,255,.08);border-radius:var(--r-md);
  display:flex;align-items:center;justify-content:center;
}
.hp-stat-card__icon i{font-size:20px;color:var(--blue)}
.hp-stat-card__num{font-size:2.4rem;font-weight:800;letter-spacing:-.03em;color:var(--text-1);line-height:1.2}
.hp-stat-card__label{font-size:14px;font-weight:700;color:var(--text-1);margin:4px 0 2px}
.hp-stat-card__sub{font-size:12px;color:var(--text-3)}

/* ── PLATFORM ── */
.hp-platform{padding:var(--section-py) 0;background:#fff}
.hp-platform__grid{display:grid;grid-template-columns:1fr;gap:20px}
.hp-plat-card{
  background:#fff;border:1px solid var(--border);border-radius:var(--r-lg);
  padding:28px;position:relative;overflow:hidden;
  box-shadow:var(--shadow-sm);
  opacity:0;transform:translateY(24px);transition:all .5s ease;
}
.hp-plat-card.animated{opacity:1;transform:translateY(0)}
.hp-plat-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg)}
.hp-plat-card__icon{
  width:48px;height:48px;border-radius:var(--r-md);
  background:rgba(21,73,255,.08);
  display:flex;align-items:center;justify-content:center;
  margin-bottom:16px;transition:all .3s;
}
.hp-plat-card__icon i{font-size:20px;color:var(--blue);transition:all .3s}
.hp-plat-card:hover .hp-plat-card__icon{background:var(--blue);box-shadow:var(--shadow-blue)}
.hp-plat-card:hover .hp-plat-card__icon i{color:#fff}
.hp-plat-card h3{font-size:1.1rem;font-weight:700;margin-bottom:8px;color:var(--text-1)}
.hp-plat-card p{font-size:.92rem;color:var(--text-2);line-height:1.65;margin-bottom:16px}
.hp-plat-card__visual{
  background:var(--surface);border:1px solid var(--border);
  border-radius:var(--r-md);padding:16px;
  display:flex;align-items:center;justify-content:center;min-height:60px;
}

.hp-mini-chart{display:flex;align-items:flex-end;gap:6px;height:48px}
.hp-mini-chart__bar{
  width:20px;background:rgba(21,73,255,.15);border-radius:4px 4px 0 0;
  transition:height .5s ease;
}
.hp-mini-chart__bar--active{background:linear-gradient(180deg,var(--blue),var(--blue-mid))}

.hp-channel-dots{display:flex;gap:12px}
.hp-channel-dots span{
  width:40px;height:40px;border-radius:var(--r-md);
  background:rgba(21,73,255,.08);
  display:flex;align-items:center;justify-content:center;
  color:var(--blue);font-size:16px;
  transition:all .3s;
}
.hp-plat-card:hover .hp-channel-dots span{background:var(--blue);color:#fff}

.hp-device-stack{display:flex;align-items:flex-end;gap:12px}
.hp-device{
  border-radius:8px;display:flex;align-items:center;justify-content:center;
  color:#fff;
}
.hp-device--terminal{width:56px;height:40px;background:linear-gradient(135deg,var(--navy),var(--navy-2));font-size:16px;border:1px solid rgba(255,255,255,.1)}
.hp-device--mobile{width:32px;height:48px;background:linear-gradient(135deg,var(--blue),var(--blue-mid));font-size:14px;border-radius:6px}

.hp-shield-visual{position:relative;display:flex;align-items:center;justify-content:center}
.hp-shield-visual>i{font-size:24px;color:var(--blue);z-index:2}
.hp-shield-rings{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
.hp-shield-rings span{
  position:absolute;border:1px solid rgba(21,73,255,.15);border-radius:50%;
  animation:shieldPulse 3s ease-in-out infinite;
}
.hp-shield-rings span:nth-child(1){width:40px;height:40px}
.hp-shield-rings span:nth-child(2){width:56px;height:56px;animation-delay:.5s}
.hp-shield-rings span:nth-child(3){width:72px;height:72px;animation-delay:1s}
@keyframes shieldPulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:.8;transform:scale(1.05)}}

.hp-funding-bar{
  width:100%;background:rgba(21,73,255,.08);border-radius:var(--r-pill);
  height:32px;position:relative;overflow:hidden;
  display:flex;align-items:center;padding:0 12px;
}
.hp-funding-bar__fill{
  position:absolute;left:0;top:0;bottom:0;width:72%;
  background:linear-gradient(90deg,var(--blue),var(--cyan));
  border-radius:var(--r-pill);
  animation:fillBar 2s ease forwards;
}
.hp-funding-bar span{position:relative;z-index:2;font-size:11px;font-weight:600;color:var(--text-2)}
@keyframes fillBar{from{width:0}to{width:72%}}

.hp-support-visual{text-align:center}
.hp-support-bubble{
  background:var(--navy);color:#fff;padding:8px 14px;
  border-radius:12px 12px 12px 2px;font-size:12px;font-weight:500;
  display:inline-block;margin-bottom:8px;
}
.hp-support-status{display:flex;align-items:center;justify-content:center;gap:6px;font-size:11px;color:var(--green);font-weight:600}
.hp-pulse-dot{
  width:7px;height:7px;background:var(--green);border-radius:50%;
  animation:pulseDot 1.5s ease-in-out infinite;
}
@keyframes pulseDot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.3)}}

/* ── HOW IT WORKS ── */
.hp-flow{
  padding:var(--section-py) 0;
  background:
    radial-gradient(ellipse 100% 60% at 50% 0%, rgba(21,73,255,.18) 0%, transparent 60%),
    linear-gradient(160deg, #060E21 0%, #0C1A38 60%, #0a1c42 100%);
  color:#fff;position:relative;overflow:hidden;
}
.hp-flow::before{
  content:"";position:absolute;inset:0;
  background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23ffffff' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  pointer-events:none;
}
.hp-flow__steps{
  display:grid;grid-template-columns:1fr;gap:32px;
  position:relative;z-index:2;max-width:900px;margin:0 auto;
}
.hp-flow__connector{display:none}
.hp-step{
  text-align:center;position:relative;
  opacity:0;transform:translateY(20px);transition:all .6s ease;
}
.hp-step.animated{opacity:1;transform:translateY(0)}
.hp-step__number{
  font-size:48px;font-weight:900;letter-spacing:-.04em;
  background:linear-gradient(135deg,rgba(21,73,255,.3),rgba(0,207,255,.15));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  line-height:1;margin-bottom:8px;
}
.hp-step__icon{
  width:56px;height:56px;margin:0 auto 14px;
  background:rgba(21,73,255,.15);border:1px solid rgba(255,255,255,.1);
  border-radius:var(--r-md);
  display:flex;align-items:center;justify-content:center;
}
.hp-step__icon i{font-size:22px;color:var(--cyan)}
.hp-step h3{font-size:1.15rem;font-weight:700;margin-bottom:6px}
.hp-step p{font-size:.9rem;opacity:.65;line-height:1.6;max-width:280px;margin:0 auto}

/* ── ECOSYSTEM ── */
.hp-eco{padding:var(--section-py) 0;background:var(--surface)}
.hp-eco__hub{position:relative;max-width:600px;margin:0 auto;aspect-ratio:1;display:flex;align-items:center;justify-content:center}
.hp-eco__center{
  width:90px;height:90px;
  background:linear-gradient(135deg,var(--blue),var(--blue-mid));
  border-radius:50%;display:flex;align-items:center;justify-content:center;
  box-shadow:0 0 60px rgba(21,73,255,.3),var(--shadow-blue);
  z-index:3;position:relative;
}
.hp-eco__center .brandtext{font-size:13px}
.hp-eco__center .ppd{color:var(--cyan);font-weight:800}
.hp-eco__center .tech{color:#fff;font-weight:800}
.hp-eco__logo-ring{
  width:100%;height:100%;display:flex;align-items:center;justify-content:center;
}
.hp-eco__nodes{position:absolute;inset:0}
.hp-eco__node{
  position:absolute;
  left:50%;top:50%;
  width:100px;
  transform:rotate(var(--angle)) translateY(-180px) rotate(calc(-1 * var(--angle)));
  margin-left:-50px;margin-top:-40px;
  text-align:center;
  opacity:0;transition:opacity .6s ease;
}
.hp-eco__node.animated{opacity:1}
.hp-eco__node-icon{
  width:52px;height:52px;margin:0 auto 8px;
  background:#fff;border:1px solid var(--border);
  border-radius:var(--r-md);box-shadow:var(--shadow-sm);
  display:flex;align-items:center;justify-content:center;
  transition:all .3s;
}
.hp-eco__node-icon i{font-size:20px;color:var(--blue);transition:all .3s}
.hp-eco__node:hover .hp-eco__node-icon{background:var(--blue);border-color:var(--blue);box-shadow:var(--shadow-blue)}
.hp-eco__node:hover .hp-eco__node-icon i{color:#fff}
.hp-eco__node span{font-size:12px;font-weight:600;color:var(--text-2)}

/* ── INDUSTRIES ── */
.hp-industries{padding:var(--section-py) 0;background:#fff}
.hp-ind__grid{display:grid;grid-template-columns:1fr;gap:12px}
.hp-ind-card{
  display:flex;align-items:center;gap:16px;
  background:#fff;border:1px solid var(--border);
  border-radius:var(--r-lg);padding:20px 24px;
  box-shadow:var(--shadow-xs);
  transition:all .3s ease;
  opacity:0;transform:translateY(16px);
  cursor:pointer;
}
.hp-ind-card.animated{opacity:1;transform:translateY(0)}
.hp-ind-card:hover{
  transform:translateY(-4px);box-shadow:var(--shadow-lg);
  border-color:rgba(21,73,255,.2);
}
.hp-ind-card__icon{
  width:48px;height:48px;flex:0 0 48px;
  border-radius:var(--r-md);
  background:color-mix(in srgb, var(--accent) 12%, transparent);
  display:flex;align-items:center;justify-content:center;
  transition:all .3s;
}
.hp-ind-card__icon i{font-size:20px;color:var(--accent);transition:all .3s}
.hp-ind-card:hover .hp-ind-card__icon{background:var(--accent)}
.hp-ind-card:hover .hp-ind-card__icon i{color:#fff}
.hp-ind-card__content{flex:1}
.hp-ind-card__content h3{font-size:1rem;font-weight:700;margin-bottom:4px;color:var(--text-1)}
.hp-ind-card__content p{font-size:.85rem;color:var(--text-2);line-height:1.55;margin:0}
.hp-ind-card__arrow{
  color:var(--text-3);font-size:14px;
  opacity:0;transform:translateX(-8px);
  transition:all .3s;
}
.hp-ind-card:hover .hp-ind-card__arrow{opacity:1;transform:translateX(0)}

/* ── FINAL CTA ── */
.hp-cta{
  padding:clamp(80px,10vw,120px) 0;text-align:center;
  color:#fff;position:relative;overflow:hidden;
  background:
    radial-gradient(ellipse 100% 80% at 50% -10%,rgba(0,207,255,.18) 0%,transparent 60%),
    radial-gradient(ellipse 60% 60% at 100% 100%,rgba(21,73,255,.15) 0%,transparent 50%),
