---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PPD Technology | Valor VP800 - Next-Gen POS" description="The Valor VP800 next-generation POS terminal. Fast transactions, built-in printer, dual display, and cloud-based management for modern merchants.">
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="vp-page">
    <section class="vp-hero" id="top">
      <div class="vp-hero-glow" aria-hidden="true"></div>

      <div class="vp-shell vp-hero-grid">
        <div class="vp-copy vp-reveal">
          <span class="vp-kicker">
            <i class="fa-solid fa-layer-group"></i>
            Next-Gen POS
          </span>

          <h1>
            VP800
            <br />
            The ultimate
            <br />
            all-in-one
            <br />
            POS solution.
          </h1>

          <p>
            13.3" customer-facing display, integrated payments, blazing-fast
            processor, and peripherals that snap right in. VP800 is built for
            modern restaurants and retail: sleek, secure, and seriously quick.
          </p>

          <div class="vp-actions">
            <a class="vp-btn vp-btn-primary" href="#gallery">
              <i class="fa-solid fa-images"></i>
              See It
            </a>
            <a class="vp-btn" href="#features">
              <i class="fa-solid fa-circle-info"></i>
              Features
            </a>
          </div>
        </div>

        <div class="vp-visual vp-reveal vp-reveal-delay-1">
          <div class="vp-device-card">
            <img
              src="https://mmdabbagh24.neocities.org/images/VP800%20(1).png"
              alt="Valor VP800 terminal"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="vp-strip">
      <div class="vp-shell vp-strip-row vp-reveal">
        <span class="vp-chip">
          <i class="fa-solid fa-display"></i>
          13.3" FHD
        </span>
        <span class="vp-chip">
          <i class="fa-solid fa-credit-card"></i>
          EMV • NFC • MSR
        </span>
        <span class="vp-chip">
          <i class="fa-solid fa-wifi"></i>
          Wi-Fi / Ethernet
        </span>
        <span class="vp-chip">
          <i class="fa-solid fa-bolt"></i>
          High-speed printer ready
        </span>
      </div>
    </section>

    <section class="vp-section" id="features">
      <div class="vp-shell">
        <div class="vp-heading vp-reveal">
          <h2>Designed for speed. Built to sell.</h2>
          <p>
            From front counter to kitchen, VP800 cuts lines, speeds up orders,
            and keeps payments simple.
          </p>
        </div>

        <div class="vp-grid">
          <article class="vp-card vp-reveal">
            <div class="vp-icon"><i class="fa-solid fa-panorama"></i></div>
            <h3>Dual-screen elegance</h3>
            <p>
              Large customer display with promos and tips, plus a crisp
              operator screen that stays readable in bright light.
            </p>
          </article>

          <article class="vp-card vp-reveal vp-reveal-delay-1">
            <div class="vp-icon"><i class="fa-solid fa-shield-halved"></i></div>
            <h3>Payments built-in</h3>
            <p>
              EMV chip, contactless, and magstripe in one device. PCI Level 1
              with end-to-end encryption.
            </p>
          </article>

          <article class="vp-card vp-reveal vp-reveal-delay-2">
            <div class="vp-icon"><i class="fa-solid fa-plug"></i></div>
            <h3>Snap-in peripherals</h3>
            <p>
              USB-C accessories, cash drawer trigger, and kitchen printer
              support with no dongle jungle.
            </p>
          </article>

          <article class="vp-card vp-reveal">
            <div class="vp-icon"><i class="fa-solid fa-gauge-high"></i></div>
            <h3>Fast and reliable</h3>
            <p>
              Modern CPU, generous RAM, and a tuned OS keep the interface
              snappy even in rushes.
            </p>
          </article>

          <article class="vp-card vp-reveal vp-reveal-delay-1">
            <div class="vp-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
            <h3>Cloud sync</h3>
            <p>
              Real-time reporting and menu updates across all stations. Offline
              mode helps keep you selling.
            </p>
          </article>

          <article class="vp-card vp-reveal vp-reveal-delay-2">
            <div class="vp-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
            <h3>Looks that sell</h3>
            <p>
              Minimal footprint, premium materials, and a display customers
              actually notice.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="vp-section vp-section-alt" id="gallery">
      <div class="vp-shell">
        <div class="vp-media-grid">
          <div class="vp-media-card vp-reveal">
            <img
              src="https://mmdabbagh24.neocities.org/images/Valor-VP800-Comparsion-image.png"
              alt="VP800 comparison image"
              loading="lazy"
            />
          </div>

          <div class="vp-media-card vp-reveal vp-reveal-delay-1">
            <img
              src="https://mmdabbagh24.neocities.org/images/VP800%20(1).png"
              alt="Angled VP800 terminal"
              loading="lazy"
            />
          </div>
        </div>

        <div class="vp-video-card vp-reveal vp-reveal-delay-2">
          <div class="vp-video-frame">
            <iframe
              src="https://www.youtube.com/embed/_ILr_fQTI_w?autoplay=1&mute=1&controls=0&modestbranding=1&loop=1&playlist=_ILr_fQTI_w&start=15&rel=0&playsinline=1"
              title="VP800 video"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <section class="vp-section vp-specs" id="specs">
      <div class="vp-shell">
        <div class="vp-heading vp-reveal">
          <h2>Technical Specifications</h2>
          <p>Core capabilities that matter on a busy line.</p>
        </div>

        <div class="vp-grid">
          <article class="vp-card vp-reveal">
            <h3>Displays</h3>
            <p>
              13.3" FHD customer-facing and operator display with
              high-brightness glass.
            </p>
          </article>

          <article class="vp-card vp-reveal vp-reveal-delay-1">
            <h3>Payments</h3>
            <p>
              EMV chip, NFC contactless, MSR, P2PE support, and PCI Level 1.
            </p>
          </article>

          <article class="vp-card vp-reveal vp-reveal-delay-2">
            <h3>Connectivity</h3>
            <p>
              Wi-Fi dual-band, Ethernet, Bluetooth, and USB-C expansion for
              peripherals.
            </p>
          </article>

          <article class="vp-card vp-reveal">
            <h3>Printer</h3>
            <p>
              Thermal printer ready for kitchen or order workflows with
              auto-cut and sticky paper options.
            </p>
          </article>

          <article class="vp-card vp-reveal vp-reveal-delay-1">
            <h3>Power</h3>
            <p>
              Efficient PSU with battery backup options depending on
              configuration.
            </p>
          </article>

          <article class="vp-card vp-reveal vp-reveal-delay-2">
            <h3>OS</h3>
            <p>
              Hardened Android build with remote updates and MDM controls.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="vp-cta" id="demo">
      <div class="vp-shell vp-cta-inner">
        <div class="vp-reveal">
          <h3>Bring the VP800 to your counter.</h3>
          <p>
            We’ll set up a live demo and show how VP800 pairs with PPD
            payments, printers, and accessories for your exact workflow.
          </p>
        </div>

        <button class="vp-btn vp-btn-primary vp-reveal vp-reveal-delay-1" type="button" onclick="openVpDemo()">
          <i class="fa-solid fa-rocket"></i>
          Book a Demo
        </button>
      </div>
    </section>

    <div
      class="vp-modal"
      id="vpDemoModal"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-labelledby="vpDemoTitle"
    >
      <div class="vp-modal-panel" role="document">
        <div class="vp-modal-head">
          <h3 id="vpDemoTitle">Book a Live VP800 Demo</h3>
          <button type="button" class="vp-close" onclick="closeVpDemo()" aria-label="Close demo form">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div class="vp-modal-body">
          <form id="vpDemoForm" action="/api/lead" method="POST">
            <input type="hidden" name="_form" value="vp-800-demo" />
            <input type="hidden" name="_subject" value="New VP800 Demo Request" />
            <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" aria-hidden="true" />
            <div class="vp-form-grid">
              <div>
                <label for="firstName">First name</label>
                <input id="firstName" name="firstName" required />
              </div>

              <div>
                <label for="lastName">Last name</label>
                <input id="lastName" name="lastName" required />
              </div>

              <div>
                <label for="email">Work email</label>
                <input id="email" name="email" type="email" required />
              </div>

              <div>
                <label for="phone">Phone (optional)</label>
                <input id="phone" name="phone" type="tel" />
              </div>

              <div>
                <label for="company">Company</label>
                <input id="company" name="company" required />
              </div>

              <div>
                <label for="industry">Industry</label>
                <select id="industry" name="industry" required>
                  <option value="">Select…</option>
                  <option>Restaurant</option>
                  <option>Retail</option>
                  <option>Grocery</option>
                  <option>Services</option>
                  <option>Other</option>
                </select>
              </div>

              <div>
                <label for="locations">Locations</label>
                <select id="locations" name="locations" required>
                  <option value="">Select…</option>
                  <option>1</option>
                  <option>2-5</option>
                  <option>6-10</option>
                  <option>11-25</option>
                  <option>26+</option>
                </select>
              </div>

              <div>
                <label for="timeline">Timeline</label>
                <select id="timeline" name="timeline" required>
                  <option value="">Select…</option>
                  <option>ASAP</option>
                  <option>0-3 months</option>
                  <option>3-6 months</option>
                  <option>6+ months</option>
                  <option>Just researching</option>
                </select>
              </div>

              <div class="vp-full">
                <label for="notes">Anything specific you want to see?</label>
                <textarea
                  id="notes"
                  name="message"
                  placeholder="Example: tips flow, kitchen printing, multi-location reporting..."
                ></textarea>
              </div>

              <input type="hidden" name="product" value="VP800 Demo" />
              <input type="hidden" name="page" value="vp-800" />
            </div>

            <div class="vp-form-actions">
              <button class="vp-btn" type="button" onclick="closeVpDemo()">Cancel</button>
              <button class="vp-btn vp-btn-primary" type="submit">
                <i class="fa-solid fa-paper-plane"></i>
                Request Demo
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    .vp-page {
      --vp-ink: #060E21;
      --vp-ink-soft: #3D5A80;
      --vp-blue: #1549FF;
      --vp-blue-2: #2D60FF;
      --vp-line: #E2E8F4;
      --vp-card: #ffffff;
      --vp-bg-1: #F5F8FF;
      --vp-bg-2: #EEF3FF;
      --vp-bg-3: #E8F0FF;
      --vp-shadow: 0 18px 55px rgba(16, 38, 84, 0.12);
      --vp-shadow-soft: 0 12px 30px rgba(16, 38, 84, 0.09);

      font-family: Inter, system-ui, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
      color: var(--vp-ink);
      background: #F5F8FF;
      overflow-x: clip;
    }

    .vp-page *,
    .vp-page *::before,
    .vp-page *::after {
      box-sizing: border-box;
    }

    .vp-page a {
      text-decoration: none;
      color: inherit;
    }

    .vp-shell {
      width: min(1240px, 100%);
      margin-inline: auto;
      padding-inline: clamp(20px, 4vw, 32px);
    }

    .vp-hero,
    .vp-section,
    .vp-cta {
      scroll-margin-top: 110px;
    }

    .vp-hero {
      position: relative;
      padding: clamp(44px, 7vw, 86px) 0 clamp(34px, 5vw, 60px);
      background:
        radial-gradient(ellipse 100% 70% at 80% -10%, rgba(21,73,255,.28) 0%, transparent 60%),
        radial-gradient(ellipse 60% 60% at -10% 100%, rgba(0,207,255,.12) 0%, transparent 50%),
        linear-gradient(160deg, #060E21 0%, #0C1A38 60%, #0a1c42 100%);
      overflow: hidden;
      isolation: isolate;
      color: #fff;
    }

    .vp-hero-glow {
      position: absolute;
      inset: 0;
      background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.025'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
      opacity: .3;
    }

    .vp-hero-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
      gap: clamp(28px, 4vw, 48px);
      align-items: center;
    }

    .vp-copy {
      max-width: 700px;
    }

    .vp-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 13px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0.02em;
      color: #a8c8ff;
      border: 1px solid rgba(168,200,255,.25);
      background: rgba(168,200,255,.08);
    }

    .vp-copy h1 {
      margin: 16px 0 14px;
      font-size: clamp(44px, 7vw, 76px);
      line-height: 0.94;
      letter-spacing: -0.03em;
      font-weight: 900;
      color: #fff;
    }

    .vp-copy p {
      margin: 0;
      max-width: 650px;
      font-size: clamp(17px, 2vw, 18px);
      line-height: 1.7;
      color: rgba(255,255,255,.72);
    }

    .vp-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 24px;
    }

    .vp-btn {
      appearance: none;
      border: 1px solid #d6e3ff;
      border-radius: 999px;
      background: #ffffff;
      color: #1e2b49;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      min-height: 46px;
      padding: 0 18px;
      font: inherit;
      font-size: 15px;
      font-weight: 900;
      line-height: 1;
      cursor: pointer;
      transition:
        transform 0.18s ease,
        box-shadow 0.18s ease,
        border-color 0.18s ease;
      box-shadow: 0 8px 22px rgba(16, 38, 84, 0.06);
    }

    .vp-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 28px rgba(16, 38, 84, 0.12);
      border-color: #c8dcff;
    }

    .vp-btn-primary {
      background: linear-gradient(135deg, #2D60FF, var(--vp-blue));
      color: #ffffff;
      border-color: transparent;
      box-shadow: 0 8px 28px rgba(21,73,255,.35);
    }

    .vp-btn-primary:hover {
      box-shadow: 0 12px 32px rgba(21,73,255,.45);
    }

    .vp-visual {
      min-width: 0;
    }

    .vp-device-card {
      display: grid;
      place-items: center;
      min-height: clamp(320px, 40vw, 560px);
      padding: clamp(12px, 2vw, 20px);
    }

    .vp-device-card img {
      display: block;
      width: min(100%, 540px);
      max-height: 620px;
      object-fit: contain;
      filter: drop-shadow(0 34px 72px rgba(46, 139, 255, 0.22));
      animation: vpFloat 8s ease-in-out infinite;
    }

    .vp-strip {
      border-top: 1px solid var(--vp-line);
      border-bottom: 1px solid var(--vp-line);
      background: linear-gradient(90deg, #f4f8ff, #edf4ff, #f4f8ff);
    }

    .vp-strip-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px 16px;
      padding: 14px 0;
    }

    .vp-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 13px;
      border-radius: 999px;
      border: 1px solid #cfe0ff;
      background: rgba(216, 227, 255, 0.62);
      color: #1f3b6b;
      font-size: 12px;
      font-weight: 900;
      white-space: nowrap;
    }

    .vp-section {
      padding: clamp(54px, 7vw, 82px) 0;
      background: linear-gradient(180deg, #f7faff, #f0f6ff);
    }

    .vp-section-alt {
      background: linear-gradient(180deg, #f0f6ff, #ecf3ff);
    }

    .vp-specs {
      background: linear-gradient(180deg, #ecf3ff, #e6f2ff);
    }

    .vp-heading {
      text-align: center;
      max-width: 860px;
      margin: 0 auto 26px;
    }

    .vp-heading h2 {
      margin: 0 0 10px;
      font-size: clamp(32px, 4.4vw, 50px);
      line-height: 1.08;
      font-weight: 900;
      color: var(--vp-ink);
    }

    .vp-heading p {
      margin: 0;
      font-size: 18px;
      line-height: 1.7;
      color: var(--vp-ink-soft);
    }

    .vp-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      align-items: stretch;
    }

    .vp-card {
      min-width: 0;
      padding: 20px;
      border-radius: 18px;
      border: 1px solid #e1eaff;
      background: linear-gradient(180deg, #ffffff, #f5f9ff);
      box-shadow: var(--vp-shadow-soft);
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .vp-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 18px 42px rgba(16, 38, 84, 0.14);
    }

    .vp-card h3 {
      margin: 0 0 8px;
      font-size: 21px;
      line-height: 1.2;
      font-weight: 900;
      color: var(--vp-ink);
    }

    .vp-card p {
      margin: 0;
      font-size: 17px;
      line-height: 1.65;
      color: #223a64;
    }

    .vp-icon {
      width: 46px;
      height: 46px;
      display: grid;
      place-items: center;
      margin-bottom: 12px;
      border-radius: 13px;
      border: 1px solid #cfe2ff;
      background: linear-gradient(160deg, #d5e4ff, #c4f6eb);
      color: #2b78ff;
      font-size: 18px;
    }

    .vp-media-grid {
      display: grid;
      grid-template-columns: 1.08fr 0.92fr;
      gap: 22px;
      margin-bottom: 22px;
      align-items: stretch;
    }

    .vp-media-card,
    .vp-video-card {
      min-width: 0;
      border-radius: 18px;
      border: 1px solid #e1eaff;
      background: #ffffff;
      box-shadow: var(--vp-shadow);
      overflow: hidden;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .vp-media-card:hover,
    .vp-video-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 22px 54px rgba(16, 38, 84, 0.16);
    }

    .vp-media-card {
      padding: 14px;
    }

    .vp-media-card img {
      display: block;
      width: 100%;
      height: 100%;
      max-height: 560px;
      object-fit: contain;
      border-radius: 12px;
      background: #ffffff;
    }

    .vp-video-frame {
      position: relative;
      width: 100%;
      padding-top: 56.25%;
      background: #000000;
    }

    .vp-video-frame iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .vp-cta {
      padding: clamp(54px, 6vw, 78px) 0;
      border-top: 1px solid var(--vp-line);
      border-bottom: 1px solid var(--vp-line);
      background: linear-gradient(120deg, #e8f2ff, #f4fbff);
    }

    .vp-cta-inner {
      text-align: center;
    }

    .vp-cta h3 {
      margin: 0 0 10px;
      font-size: clamp(28px, 4vw, 42px);
      line-height: 1.1;
      font-weight: 900;
      color: var(--vp-ink);
    }

    .vp-cta p {
      margin: 0 auto 22px;
      max-width: 860px;
      font-size: 18px;
      line-height: 1.7;
      color: var(--vp-ink-soft);
    }

    .vp-modal {
      position: fixed;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 20px;
      background: rgba(10, 20, 45, 0.38);
      backdrop-filter: blur(6px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      z-index: 999;
    }

    .vp-modal.is-open {
      opacity: 1;
      pointer-events: auto;
    }

    .vp-modal-panel {
      width: min(900px, 100%);
      max-height: min(90vh, 920px);
      overflow: auto;
      border-radius: 20px;
      border: 1px solid #e3ecff;
      background: #ffffff;
      box-shadow: 0 30px 120px rgba(16, 38, 84, 0.24);
    }

    .vp-modal-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 18px 20px;
      border-bottom: 1px solid #eef3ff;
    }

    .vp-modal-head h3 {
      margin: 0;
      font-size: 22px;
      line-height: 1.2;
      font-weight: 900;
      color: var(--vp-ink);
    }

    .vp-close {
      appearance: none;
      border: 0;
      background: transparent;
      color: #213b67;
      font-size: 22px;
      cursor: pointer;
      width: 40px;
      height: 40px;
      border-radius: 10px;
      transition: background 0.18s ease;
    }

    .vp-close:hover {
      background: #f1f6ff;
    }

    .vp-modal-body {
      padding: 20px;
    }

    .vp-form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .vp-full {
      grid-column: 1 / -1;
    }

    .vp-page label {
      display: block;
      margin-bottom: 7px;
      font-size: 13px;
      line-height: 1.2;
      font-weight: 800;
      color: #203964;
    }

    .vp-page input,
    .vp-page select,
    .vp-page textarea {
      width: 100%;
      padding: 12px 13px;
      border-radius: 12px;
      border: 1px solid #dbe6ff;
      background: #ffffff;
      font: inherit;
      font-size: 15px;
      color: var(--vp-ink);
    }

    .vp-page textarea {
      min-height: 120px;
      resize: vertical;
    }

    .vp-page input:focus,
    .vp-page select:focus,
    .vp-page textarea:focus {
      outline: none;
      border-color: #9fc5ff;
      box-shadow: 0 0 0 4px rgba(46, 139, 255, 0.12);
    }

    .vp-form-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 18px;
    }

    .vp-reveal {
      opacity: 0;
      transform: translateY(18px);
    }

    .vp-reveal.is-visible {
      animation: vpFadeUp 0.66s cubic-bezier(0.17, 0.84, 0.44, 1) forwards;
    }

    .vp-reveal-delay-1 {
      animation-delay: 0.08s;
    }

    .vp-reveal-delay-2 {
      animation-delay: 0.16s;
    }

    @keyframes vpFadeUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes vpFloat {
      0% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-12px);
      }
      100% {
        transform: translateY(0);
      }
    }

    @media (max-width: 1080px) {
      .vp-hero-grid,
      .vp-media-grid {
        grid-template-columns: 1fr;
      }

      .vp-visual {
        order: -1;
      }

      .vp-device-card {
        min-height: 280px;
      }

      .vp-device-card img {
        width: min(100%, 420px);
      }
    }

    @media (max-width: 900px) {
      .vp-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .vp-grid,
      .vp-form-grid {
        grid-template-columns: 1fr;
      }

      .vp-copy h1 {
        letter-spacing: -0.04em;
      }

      .vp-heading p,
      .vp-cta p,
      .vp-card p,
      .vp-copy p {
        font-size: 16px;
      }

      .vp-form-actions {
        justify-content: stretch;
      }

      .vp-form-actions .vp-btn {
        width: 100%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .vp-device-card img,
      .vp-btn,
      .vp-card,
      .vp-media-card,
      .vp-video-card,
      .vp-reveal {
        animation: none !important;
        transition: none !important;
      }
    }
  </style>

  <script is:inline>
    const vpOpenModal = () => {
      const modal = document.getElementById("vpDemoModal");
      if (!modal) return;
      modal.classList.add("is-open");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const vpCloseModal = () => {
      const modal = document.getElementById("vpDemoModal");
      if (!modal) return;
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    window.openVpDemo = vpOpenModal;
    window.closeVpDemo = vpCloseModal;

    const vpInitReveal = () => {
      const items = document.querySelectorAll(".vp-reveal");
      if (!items.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.16 }
      );

      items.forEach((item) => observer.observe(item));
    };

    const vpInitModal = () => {
      const modal = document.getElementById("vpDemoModal");
      const form = document.getElementById("vpDemoForm");
      if (!modal || !form) return;

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && modal.classList.contains("is-open")) {
          vpCloseModal();
        }
      });

      modal.addEventListener("click", (event) => {
        if (event.target === modal) {
          vpCloseModal();
        }
      });

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const requiredIds = [
          "firstName",
          "lastName",
          "email",
          "company",
          "industry",
          "locations",
          "timeline"
        ];

        for (const id of requiredIds) {
          const field = document.getElementById(id);
          if (field && !field.value) {
            field.focus();
            return;
          }
        }

        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn ? submitBtn.innerHTML : "";
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending…';
        }
        try {
          const data = new FormData(form);
          data.append("_page", window.location.pathname);
          const res = await fetch("/api/lead", { method: "POST", body: data });
          if (!res.ok) throw new Error("Network");
          window.location.href = "/thank-you";
        } catch {
          alert("Sorry, something went wrong sending your request. Please email info@ppdtechnology.com and we'll help right away.");
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
          }
        }
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        vpInitReveal();
        vpInitModal();
      });
    } else {
      vpInitReveal();
      vpInitModal();
    }
  </script>
</BaseLayout>
