---
import Landing from '../components/Landing.astro';
import FormExtras from '../components/FormExtras.astro';

const features = [
  { title: 'Two screens', body: 'A customer-facing display alongside the operator screen, so the customer follows the sale and confirms the total.' },
  { title: 'Payments built in', body: 'Chip, tap and swipe on the device itself, with no separate reader on the counter.' },
  { title: 'Peripherals that snap in', body: 'Add a receipt printer, cash drawer or scanner without rebuilding the counter.' },
  { title: 'Cloud sync and offline mode', body: 'Keep selling if the connection drops, and sync when it comes back.' },
  { title: 'Remote updates', body: 'Android-based, with updates and device management handled remotely.' },
  { title: 'Connectivity', body: 'Dual-band Wi-Fi, Ethernet, Bluetooth and USB-C.' },
];
---

<Landing
  title="Valor VP800 POS terminal | PPD Technology"
  description="The Valor VP800 all-in-one POS terminal with customer-facing display and integrated payments, sold, configured and supported by PPD Technology."
  eyebrow="Valor VP800 · sold and supported by PPD"
  headline={['VP800.', 'The all-in-one countertop.']}
  lede="A customer-facing display, integrated payments and peripherals that snap right in. Built for modern restaurants and retail."
  cta={[{ label: 'Book a live demo', href: '#demo' }, { label: 'Free rate review', href: '/rate-review' }]}
  chips={['Chip, tap and swipe', 'Wi-Fi and Ethernet', 'Printer ready', 'Offline mode']}
  featuresHead={{ eyebrow: 'What you get', title: 'One device on the counter instead of three.' }}
  features={features}
  form={{ tag: 'vp-800-demo', subject: 'New VP800 Demo Request', title: 'Book a live VP800 demo.', lede: 'Tell us about your counter and we will show you the VP800 running the way you would use it.', cta: 'Book a demo' }}
>
  <img slot="visual" src="/images/hw/valor-vp800-hero.webp" alt="Valor VP800 terminal" width="500" height="500" />

  <Fragment slot="fields">
    <FormExtras
      id="vp800"
      select={{ name: 'locations', label: 'Number of locations', options: ['1', '2 to 5', '6 to 10', '11 to 25', '26 or more'] }}
    />
  </Fragment>
</Landing>
