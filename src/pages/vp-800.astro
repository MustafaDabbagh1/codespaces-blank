---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="PPDTechnology | Valor VP800 – Next-Gen POS">
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <section class="vp800-page">
    <section class="vp-hero" aria-label="VP800 Hero" id="hero">
      <div class="vp-bg-ray" aria-hidden="true"></div>

      <div class="vp-container vp-hero-inner">
        <div class="vp-hero-grid">
          <div class="vp-reveal" data-delay="1">
            <span class="vp-kicker"><i class="fa-solid fa-layer-group"></i> Next-Gen POS</span>
            <h1>VP800<br />The ultimate<br />all-in-one<br />POS solution.</h1>
            <p>
              13.3” customer-facing display, integrated payments, blazing-fast processor, and
              peripherals that snap right in. VP800 is built for modern restaurants and retail,
              sleek, secure, and seriously quick.
            </p>
            <div class="vp-hero-cta">
              <a class="vp-btn vp-primary vp-springable" href="#gallery"><i class="fa-solid fa-images"></i> See It</a>
              <a class="vp-btn vp-springable" href="#features"><i class="fa-solid fa-circle-info"></i> Features</a>
            </div>
          </div>

          <div class="vp-device-wrap vp-reveal" data-delay="2">
            <div class="vp-device" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="vp-strip">
      <div class="vp-container vp-row vp-reveal" data-delay="1">
        <span class="vp-chip-pill vp-springable"><i class="fa-solid fa-display"></i>&nbsp;13.3” FHD</span>
        <span class="vp-chip-pill vp-springable"><i class="fa-solid fa-credit-card"></i>&nbsp;EMV • NFC • MSR</span>
        <span class="vp-chip-pill vp-springable"><i class="fa-solid fa-wifi"></i>&nbsp;Wi-Fi / Ethernet</span>
        <span class="vp-chip-pill vp-springable"><i class="fa-solid fa-bolt"></i>&nbsp;High-speed printer ready</span>
      </div>
    </section>

    <section class="vp-section" id="features">
      <div class="vp-container">
        <h2 class="vp-title vp-reveal">Designed for speed. Built to sell.</h2>
        <p class="vp-sub vp-reveal" data-delay="1">
          From front counter to kitchen, VP800 cuts lines, speeds up orders, and keeps payments simple.
        </p>

        <div class="vp-grid-3">
          <div class="vp-card vp-tilt vp-reveal vp-springable">
            <div class="vp-icon"><i class="fa-solid fa-panorama"></i></div>
            <h3>Dual-screen elegance</h3>
            <p>Large customer display with promos &amp; tips, plus a crisp operator screen that stays readable in bright light.</p>
          </div>

          <div class="vp-card vp-tilt vp-reveal vp-springable" data-delay="1">
            <div class="vp-icon"><i class="fa-solid fa-shield-halved"></i></div>
            <h3>Payments built-in</h3>
            <p>EMV chip, contactless, and magstripe in one device. PCI Level 1 with end-to-end encryption.</p>
          </div>

          <div class="vp-card vp-tilt vp-reveal vp-springable" data-delay="2">
            <div class="vp-icon"><i class="fa-solid fa-plug"></i></div>
            <h3>Snap-in peripherals</h3>
            <p>USB-C accessories, cash drawer trigger, and kitchen printer support, no dongle jungle.</p>
          </div>

          <div class="vp-card vp-tilt vp-reveal vp-springable">
            <div class="vp-icon"><i class="fa-solid fa-gauge-high"></i></div>
            <h3>Fast &amp; reliable</h3>
            <p>Modern CPU, generous RAM, and tuned OS keep the UI snappy even in rushes.</p>
          </div>

          <div class="vp-card vp-tilt vp-reveal vp-springable" data-delay="1">
            <div class="vp-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
            <h3>Cloud sync</h3>
            <p>Real-time reporting and menu updates across all stations. Offline mode keeps you selling.</p>
          </div>

          <div class="vp-card vp-tilt vp-reveal vp-springable" data-delay="2">
            <div class="vp-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
            <h3>Looks that sell</h3>
            <p>Minimal footprint, premium materials, and a display customers actually notice.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="vp-showcase" id="gallery">
      <div class="vp-container">
        <div class="vp-show-flex" style="margin-bottom:22px">
          <div class="vp-img-panel vp-tilt vp-reveal vp-springable">
            <img src="https://mmdabbagh24.neocities.org/images/Valor-VP800-Comparsion-image.png" alt="VP800 comparison" />
          </div>

          <div class="vp-img-panel vp-tilt vp-reveal vp-springable" data-delay="1">
            <img src="https://mmdabbagh24.neocities.org/images/VP800%20(1).png" alt="VP800 angled" />
          </div>
        </div>

        <div class="vp-img-panel vp-reveal vp-springable" data-delay="2">
          <div class="vp-video-wrap">
            <iframe
              src="https://www.youtube.com/embed/_ILr_fQTI_w?autoplay=1&mute=1&controls=0&modestbranding=1&loop=1&playlist=_ILr_fQTI_w&start=15&rel=0&playsinline=1"
              title="VP800 Video"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <section class="vp-section" id="specs">
      <div class="vp-container">
        <h2 class="vp-title vp-reveal">Technical Specifications</h2>
        <p class="vp-sub vp-reveal" data-delay="1">Core capabilities that matter on a busy line.</p>

        <div class="vp-grid-3" style="margin-top:20px">
          <div class="vp-card vp-tilt vp-reveal vp-springable">
            <h3>Displays</h3>
            <p>13.3” FHD customer-facing + operator display, high-brightness glass.</p>
          </div>

          <div class="vp-card vp-tilt vp-reveal vp-springable" data-delay="1">
            <h3>Payments</h3>
            <p>EMV chip, NFC contactless, MSR; P2PE support and PCI Level 1.</p>
          </div>

          <div class="vp-card vp-tilt vp-reveal vp-springable" data-delay="2">
            <h3>Connectivity</h3>
            <p>Wi-Fi dual-band, Ethernet, Bluetooth; USB-C expansion for peripherals.</p>
          </div>

          <div class="vp-card vp-tilt vp-reveal vp-springable">
            <h3>Printer</h3>
            <p>Thermal printer ready (kitchen/order) with auto-cut and sticky paper options.</p>
          </div>

          <div class="vp-card vp-tilt vp-reveal vp-springable" data-delay="1">
            <h3>Power</h3>
            <p>Efficient PSU; battery backup options depending on configuration.</p>
          </div>

          <div class="vp-card vp-tilt vp-reveal vp-springable" data-delay="2">
            <h3>OS</h3>
            <p>Hardened Android build, remote updates, MDM controls.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="vp-cta" id="demo">
      <div class="vp-container">
        <h3 class="vp-reveal">Bring the VP800 to your counter.</h3>
        <p class="vp-reveal" data-delay="1">
          We’ll set up a live demo and show how VP800 pairs with PPD payments, printers, and accessories for your exact workflow.
        </p>
        <button class="vp-btn vp-primary vp-reveal vp-springable" data-delay="2" type="button" onclick="openDemo()">
          <i class="fa-solid fa-rocket"></i>&nbsp;Book a Demo
        </button>
      </div>
    </section>

    <div class="vp-modal" id="demoModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="demoTitle">
      <div class="vp-modal-panel" role="document">
        <div class="vp-modal-header">
          <h3 class="vp-modal-title" id="demoTitle">Book a Live VP800 Demo</h3>
          <button class="vp-modal-close" onclick="closeDemo()" aria-label="Close demo form">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div class="vp-modal-body">
          <form id="fsDemo" action="https://formspree.io/f/xyznjzkg" method="POST">
            <div class="vp-form-grid">
              <div>
                <label for="firstName">First name</label>
                <input id="firstName" name="firstName" required />
              </div>

              <div>
                <label for="lastName">Last name</label>
                <input id="lastName" name="lastName" required />
              </div>

              <div>
                <label for="email">Work email</label>
                <input id="email" name="email" type="email" required />
              </div>

              <div>
                <label for="phone">Phone (optional)</label>
                <input id="phone" name="phone" type="tel" />
              </div>

              <div>
                <label for="company">Company</label>
                <input id="company" name="company" required />
              </div>

              <div>
                <label for="industry">Industry</label>
                <select id="industry" name="industry" required>
                  <option value="">Select…</option>
                  <option>Restaurant</option>
                  <option>Retail</option>
                  <option>Grocery</option>
                  <option>Services</option>
                  <option>Other</option>
                </select>
              </div>

              <div>
                <label for="locations">Locations</label>
                <select id="locations" name="locations" required>
                  <option value="">Select…</option>
                  <option>1</option>
                  <option>2–5</option>
                  <option>6–10</option>
                  <option>11–25</option>
                  <option>26+</option>
                </select>
              </div>

              <div>
                <label for="timeline">Timeline</label>
                <select id="timeline" name="timeline" required>
                  <option value="">Select…</option>
                  <option>ASAP</option>
                  <option>0–3 months</option>
                  <option>3–6 months</option>
                  <option>6+ months</option>
                  <option>Just researching</option>
                </select>
              </div>

              <div class="vp-full">
                <label for="notes">Anything specific you want to see?</label>
                <textarea id="notes" name="message" placeholder="Example: tips flow, kitchen printing, multi-location reporting…"></textarea>
              </div>

              <input type="hidden" name="product" value="VP800 Demo" />
              <input type="hidden" name="page" value="vp-800" />
            </div>

            <div class="vp-actions">
              <button class="vp-btn vp-secondary" type="button" onclick="closeDemo()">Cancel</button>
              <button class="vp-btn vp-primary vp-springable" type="submit">
                <i class="fa-solid fa-paper-plane"></i> Request Demo
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <style>
    :root{
      --ink:#0f1f3d;
      --blue:#2e8bff;
      --blue-2:#6aa8ff;
      --line:#dfe8ff;
      --shadow:0 20px 60px rgba(16,38,84,.12);
      --soft:0 12px 30px rgba(16,38,84,.10);
    }

    .vp800-page{
      font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
      color:var(--ink);
      background:radial-gradient(1600px 800px at 10% -10%,#fff 0%,#F7FAFF 35%,#ECF3FF 100%);
      line-height:1.6;
      overflow-x:hidden;
    }

    .vp800-page *{box-sizing:border-box;margin:0;padding:0}
    .vp800-page a{color:inherit;text-decoration:none}
    .vp-container{max-width:1200px;margin:0 auto;padding:0 clamp(20px,6vw,28px)}

    @keyframes vp-floatY {0%{transform:translateY(0)}50%{transform:translateY(-12px)}100%{transform:translateY(0)}}
    @keyframes vp-springPop {
      0%{transform:scale(.96)}
      60%{transform:scale(1.045)}
      100%{transform:scale(1)}
    }
    @keyframes vp-touchBounce {
      0%{transform:scale(.985)}
      60%{transform:scale(1.015)}
      100%{transform:scale(1)}
    }
    @keyframes vp-shineSweepLong {
      0%{transform:translateX(-175%) rotate(12deg);opacity:.38}
      50%{opacity:.58}
      100%{transform:translateX(175%) rotate(12deg);opacity:.38}
    }
    @keyframes vp-fadeUp {0%{opacity:0;transform:translateY(18px) scale(.985)}100%{opacity:1;transform:translateY(0) scale(1)}}

    @media (prefers-reduced-motion:reduce){
      *{animation:none!important;transition:none!important}
    }

    .vp-btn{
      position:relative;
      overflow:hidden;
      display:inline-flex;
      align-items:center;
      gap:8px;
      font-weight:900;
      border-radius:999px;
      padding:10px 16px;
      border:1px solid #d5e3ff;
      background:#fff;
      color:#1e2b49;
      transition:transform .18s, box-shadow .18s;
      cursor:pointer;
      font-family:inherit;
      font-size:15px;
    }

    .vp-btn.vp-primary{
      background:linear-gradient(90deg,var(--blue),var(--blue-2));
      border-color:transparent;
      color:#fff;
      box-shadow:0 10px 24px rgba(46,139,255,.25);
    }

    .vp-btn:hover{
      transform:translateY(-2px) scale(1.02);
      box-shadow:0 16px 34px rgba(46,139,255,.18);
    }

    .vp-btn .vp-ripple{
      position:absolute;
      border-radius:50%;
      transform:scale(0);
      background:rgba(255,255,255,.45);
      animation:vp-ripple .6s linear;
    }

    @keyframes vp-ripple{to{transform:scale(6);opacity:0}}

    .vp-hero{
      position:relative;
      isolation:isolate;
      min-height:72vh;
      display:grid;
      place-items:center;
      background:linear-gradient(180deg,#F9FBFF 0%,#EEF5FF 100%);
      overflow:visible;
    }

    .vp-bg-ray{
      position:absolute;
      left:0;
      right:0;
      top:72px;
      height:min(2000px,240vh);
      z-index:0;
      pointer-events:none;
      background:
        radial-gradient(1400px 260px at 22% 34%, rgba(94,171,255,.26) 0%, rgba(94,171,255,.14) 55%, rgba(94,171,255,0) 72%),
        linear-gradient(to bottom, rgba(233,244,255,0) 0%, rgba(233,244,255,.22) 65%, rgba(233,244,255,0) 100%);
      -webkit-mask-image: linear-gradient(to bottom,#000 0%,#000 82%,transparent 100%);
      mask-image: linear-gradient(to bottom,#000 0%,#000 82%,transparent 100%);
      will-change:transform;
    }

    .vp-hero.scrolling .vp-bg-ray{transform:translateY(var(--rayShift,0px));}

    @media(min-width:1400px){ .vp-bg-ray{height:2400px} }
    @media(max-width:1000px){ .vp-bg-ray{height:1200px; top:60px} }

    .vp-hero-inner{position:relative;z-index:1;width:100%}
    .vp-hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:28px;align-items:center}
    @media(max-width:1000px){.vp-hero-grid{grid-template-columns:1fr}}

    .vp-kicker{
      display:inline-flex;
      gap:8px;
      align-items:center;
      color:#1b54ff;
      background:rgba(65,120,255,.10);
      border:1px solid rgba(65,120,255,.25);
      border-radius:999px;
      padding:6px 12px;
      font-size:12px;
      font-weight:900;
    }

    .vp-hero h1{
      font-size:72px;
      line-height:.95;
      letter-spacing:.4px;
      font-weight:900;
      margin:14px 0 10px;
    }

    @media(max-width:1000px){.vp-hero h1{font-size:52px}}
    @media(max-width:560px){.vp-hero h1{font-size:40px}}

    .vp-hero p{color:#334e7a;max-width:640px}
    .vp-hero-cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}

    .vp-device-wrap{position:relative;min-height:480px;perspective:1000px}
    .vp-device{
      position:absolute;
      inset:0;
      background:url('https://mmdabbagh24.neocities.org/images/VP800%20(1).png') right center/contain no-repeat;
      filter:drop-shadow(0 36px 92px rgba(46,139,255,.3));
      animation:vp-floatY 8s ease-in-out infinite;
    }

    .vp-device::after{
      content:"";
      position:absolute;
      inset:-10% -45%;
      background:linear-gradient(110deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.62) 12%, rgba(255,255,255,0) 24%);
      transform:translateX(-175%) rotate(12deg);
      mix-blend-mode:screen;
      animation:vp-shineSweepLong 8.5s ease-in-out infinite;
    }

    .vp-strip{
      background:linear-gradient(90deg,#f4f8ff,#edf4ff,#f4f8ff);
      border-top:1px solid var(--line);
      border-bottom:1px solid var(--line);
      position:relative;
    }

    .vp-strip::before{
      content:"";
      position:absolute;
      left:0;
      right:0;
      top:-80px;
      height:80px;
      background:linear-gradient(to bottom, rgba(233,244,255,.28), rgba(233,244,255,0));
      pointer-events:none;
    }

    .vp-row{
      display:flex;
      gap:18px;
      justify-content:center;
      flex-wrap:wrap;
      padding:14px 0;
      color:#26406e;
      font-weight:800;
    }

    .vp-chip-pill{
      border:1px solid #cfe0ff;
      background:rgba(216,227,255,.62);
      color:#1f3b6b;
      padding:8px 12px;
      border-radius:999px;
      font-size:12px;
      font-weight:900;
      transition:transform .18s;
    }

    .vp-chip-pill:hover{
      transform:translateY(-2px);
      box-shadow:0 10px 26px rgba(16,38,84,.12);
    }

    .vp-section{
      padding:74px 0;
      background:linear-gradient(180deg,#F7FAFF,#F0F6FF);
    }

    .vp-title{
      font-weight:900;
      font-size:34px;
      text-align:center;
      margin-bottom:8px;
    }

    .vp-sub{
      color:#3b567f;
      text-align:center;
      max-width:820px;
      margin:0 auto;
    }

    .vp-grid-3{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:18px;
      margin-top:26px;
    }

    @media(max-width:980px){.vp-grid-3{grid-template-columns:1fr 1fr}}
    @media(max-width:640px){.vp-grid-3{grid-template-columns:1fr}}

    .vp-card{
      background:linear-gradient(180deg,#fff,#f5f9ff);
      border:1px solid #e2ebff;
      border-radius:16px;
      padding:18px;
      box-shadow:var(--soft);
      transition:transform .22s, box-shadow .22s;
      will-change:transform;
      transform-style:preserve-3d;
      position:relative;
    }

    .vp-card:hover{
      transform:translateY(-6px) rotateX(1deg) rotateY(1deg);
      box-shadow:0 18px 56px rgba(16,38,84,.16);
    }

    .vp-card:active{transform:translateY(-2px) scale(.99)}

    .vp-card::after{
      content:"";
      position:absolute;
      inset:-1px;
      border-radius:16px;
      background:linear-gradient(90deg,rgba(46,139,255,.12),rgba(99,190,255,.12));
      opacity:0;
      transition:.22s;
      pointer-events:none;
    }

    .vp-card:hover::after{opacity:1}
    .vp-card h3{font-size:18px;margin-bottom:6px}

    .vp-icon{
      width:44px;
      height:44px;
      border-radius:12px;
      display:grid;
      place-items:center;
      background:linear-gradient(160deg,#d5e4ff,#c4f6eb);
      color:#2b78ff;
      margin-bottom:10px;
      border:1px solid #cfe2ff;
    }

    .vp-showcase{
      padding:74px 0;
      background:linear-gradient(180deg,#F0F6FF,#ECF3FF);
    }

    .vp-show-flex{
      display:grid;
      grid-template-columns:1.1fr .9fr;
      gap:22px;
      align-items:center;
    }

    @media(max-width:980px){.vp-show-flex{grid-template-columns:1fr}}

    .vp-img-panel{
      background:#fff;
      border:1px solid #e1eaff;
      border-radius:16px;
      padding:14px;
      box-shadow:var(--shadow);
      transition:transform .2s, box-shadow .25s;
      transform-style:preserve-3d;
    }

    .vp-img-panel:hover{
      transform:translateY(-6px);
      box-shadow:0 22px 70px rgba(16,38,84,.18);
    }

    .vp-img-panel img{
      width:100%;
      height:100%;
      object-fit:contain;
      border-radius:12px;
      display:block;
    }

    .vp-video-wrap{
      position:relative;
      width:100%;
      padding-top:56.25%;
      border-radius:12px;
      overflow:hidden;
    }

    .vp-video-wrap iframe{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      border:0;
    }

    .vp-reveal{opacity:0;transform:translateY(18px);will-change:transform,opacity}
    .vp-reveal.in{animation:vp-fadeUp .66s cubic-bezier(.17,.84,.44,1) forwards}
    .vp-reveal[data-delay="1"]{animation-delay:.08s}
    .vp-reveal[data-delay="2"]{animation-delay:.16s}
    .vp-reveal[data-delay="3"]{animation-delay:.24s}

    .vp-cta{
      background:linear-gradient(120deg,#e8f2ff,#f4fbff);
      padding:70px 0;
      text-align:center;
      border-top:1px solid var(--line);
      border-bottom:1px solid var(--line);
    }

    .vp-cta .vp-btn{
      background:linear-gradient(90deg,var(--blue),var(--blue-2));
      color:#fff;
      border-color:transparent;
    }

    #specs{background:linear-gradient(180deg,#ECF3FF,#E6F2FF)}

    .vp-modal{
      position:fixed;
      inset:0;
      display:grid;
      place-items:center;
      z-index:80;
      background:rgba(10,20,45,.35);
      backdrop-filter:blur(6px) saturate(120%);
      opacity:0;
      pointer-events:none;
      transition:opacity .2s;
    }

    .vp-modal.open{
      opacity:1;
      pointer-events:auto;
    }

    .vp-modal-panel{
      width:min(900px,94vw);
      max-height:90vh;
      overflow:auto;
      border-radius:20px;
      background:#fff;
      border:1px solid #e3ecff;
      box-shadow:0 30px 120px rgba(16,38,84,.22);
    }

    .vp-modal-header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:18px 20px;
      border-bottom:1px solid #eef3ff;
    }

    .vp-modal-title{
      font-weight:900;
      font-size:20px;
    }

    .vp-modal-close{
      border:none;
      background:transparent;
      font-size:20px;
      line-height:1;
      cursor:pointer;
      padding:8px;
      border-radius:10px;
    }

    .vp-modal-body{padding:18px 20px}

    .vp-form-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:14px;
    }

    .vp-full{grid-column:1 / -1}

    .vp800-page label{
      font-weight:800;
      font-size:13px;
      display:block;
      margin-bottom:6px;
    }

    .vp800-page input,
    .vp800-page select,
    .vp800-page textarea{
      width:100%;
      padding:12px;
      border:1px solid #dbe6ff;
      border-radius:12px;
      background:#fff;
      font-family:inherit;
      font-size:15px;
    }

    .vp800-page textarea{min-height:110px}

    .vp-actions{
      display:flex;
      gap:10px;
      justify-content:flex-end;
      margin-top:16px;
    }

    .vp-secondary{
      background:#fff;
      color:#1e2b49;
      border-color:#d5e3ff;
    }

    .vp-spring{animation:vp-springPop .42s cubic-bezier(.18,1.7,.34,1) both}
    .vp-touch-bounce{animation:vp-touchBounce .32s cubic-bezier(.2,1.4,.34,1) both}

    @media(max-width:720px){
      .vp-form-grid{grid-template-columns:1fr}
      .vp-actions{justify-content:stretch;flex-direction:column}
      .vp-actions .vp-btn{width:100%}
    }
  </style>

  <script is:inline>
    // @ts-nocheck
    const modal = document.getElementById('demoModal');

    function openDemo() {
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeDemo() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = 'auto';
    }

    window.openDemo = openDemo;
    window.closeDemo = closeDemo;

    document.addEventListener('DOMContentLoaded', () => {
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('open')) closeDemo();
      });

      document.querySelectorAll('.vp-btn').forEach((btn) => {
        btn.addEventListener('click', function (e) {
          const r = document.createElement('span');
          const rect = this.getBoundingClientRect();
          const size = Math.max(rect.width, rect.height);
          r.className = 'vp-ripple';
          r.style.width = r.style.height = size + 'px';
          r.style.left = (e.clientX - rect.left - size / 2) + 'px';
          r.style.top = (e.clientY - rect.top - size / 2) + 'px';
          this.appendChild(r);
          setTimeout(() => r.remove(), 600);
        });
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((ent) => {
          if (ent.isIntersecting) {
            ent.target.classList.add('in');
            observer.unobserve(ent.target);
          }
        });
      }, { threshold: .16 });

      document.querySelectorAll('.vp-reveal').forEach((el) => observer.observe(el));

      const isTouch = matchMedia('(pointer: coarse)').matches;

      if (!isTouch) {
        const maxTilt = 6;
        const maxTrans = 8;

        function bindTilt(el) {
          let rect;

          const enter = () => {
            rect = el.getBoundingClientRect();
            el.style.willChange = 'transform';
            el.classList.add('vp-spring');
          };

          const move = (e) => {
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const px = (x / rect.width) - 0.5;
            const py = (y / rect.height) - 0.5;
            const rotY = px * maxTilt;
            const rotX = -py * maxTilt;
            const tX = px * maxTrans;
            const tY = py * maxTrans;
            el.style.transform = `translate3d(${tX}px,${tY}px,0) rotateX(${rotX}deg) rotateY(${rotY}deg)`;
          };

          const leave = () => {
            el.style.transform = '';
            el.style.willChange = '';
          };

          el.addEventListener('mouseenter', enter);
          el.addEventListener('animationend', () => el.classList.remove('vp-spring'));
          el.addEventListener('mousemove', move);
          el.addEventListener('mouseleave', leave);
        }

        document.querySelectorAll('.vp-tilt, .vp-springable').forEach(bindTilt);
      } else {
        document.querySelectorAll('.vp-card,.vp-img-panel,.vp-chip-pill,.vp-springable').forEach((el) => {
          el.addEventListener('touchstart', () => el.classList.add('vp-touch-bounce'), { passive: true });
          el.addEventListener('touchend', () => el.classList.remove('vp-touch-bounce'), { passive: true });
          el.addEventListener('touchcancel', () => el.classList.remove('vp-touch-bounce'), { passive: true });
        });
      }

      const hero = document.getElementById('hero');
      const ray = hero.querySelector('.vp-bg-ray');

      window.addEventListener('scroll', () => {
        const rect = hero.getBoundingClientRect();
        const winH = window.innerHeight || document.documentElement.clientHeight;
        if (rect.bottom > 0 && rect.top < winH) {
          const progress = (winH - rect.top) / (winH + rect.height);
          ray.style.setProperty('--rayShift', (progress * 34) + 'px');
          hero.classList.add('scrolling');
        }
      });

      document.getElementById('fsDemo').addEventListener('submit', function (e) {
        const required = ['firstName', 'lastName', 'email', 'company', 'industry', 'locations', 'timeline'];
        for (const id of required) {
          if (!this[id].value) {
            this[id].focus();
            e.preventDefault();
            break;
          }
        }
      });
    });
  </script>
</BaseLayout>