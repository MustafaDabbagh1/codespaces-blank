    .iso-compare-badge.future{background:rgba(0,229,160,.15);color:var(--iso-green)}
    .iso-compare-card ul{list-style:none;padding:0;display:flex;flex-direction:column;gap:12px}
    .iso-compare-card li{display:flex;align-items:flex-start;gap:10px;font-size:14px;line-height:1.5}
    .iso-compare-generic li i{color:#dc2626;flex-shrink:0;margin-top:3px}
    .iso-compare-future li i{color:var(--iso-green);flex-shrink:0;margin-top:3px}
