    .iso-cmd-ai-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
    .iso-cmd-ai-dot.green{background:var(--iso-green)}
    .iso-cmd-ai-dot.yellow{background:#f59e0b}
    .iso-cmd-ai-dot.blue{background:var(--iso-cyan)}

    .iso-problem{background:#fff;border-top:1px solid var(--iso-border);border-bottom:1px solid var(--iso-border)}
    .iso-compare{display:grid;grid-template-columns:1fr auto 1fr;gap:24px;align-items:stretch;max-width:900px;margin:0 auto}
    .iso-compare-card{
      border-radius:var(--iso-r);padding:28px;
    }
    .iso-compare-generic{background:var(--iso-surface);border:1px solid var(--iso-border)}
    .iso-compare-future{
      background:linear-gradient(135deg,var(--iso-navy),#0A2B74);
      color:#fff;border:1px solid rgba(21,73,255,.2);
      box-shadow:0 20px 50px rgba(21,73,255,.15);
    }
    .iso-compare-badge{
      display:inline-flex;align-items:center;gap:8px;padding:6px 14px;
      border-radius:999px;font-weight:700;font-size:13px;margin-bottom:16px;
