      border:1px solid rgba(255,255,255,.08);
    }
    .iso-mini-bar{display:flex;align-items:center;gap:5px;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.08)}
    .iso-mini-dot{width:7px;height:7px;border-radius:50%}
    .iso-mini-title{font-size:10px;color:rgba(255,255,255,.4);margin-left:auto}
    .iso-mini-body{padding:10px}
    .iso-mini-row{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:8px}
    .iso-mini-stat{
      background:rgba(255,255,255,.05);border-radius:6px;padding:6px 8px;
    }
    .iso-mini-stat span{font-size:9px;color:rgba(255,255,255,.4);display:block}
    .iso-mini-stat strong{font-size:14px;color:#fff;display:block}
    .iso-mini-list{display:flex;flex-direction:column;gap:4px}
    .iso-mini-list-item{
