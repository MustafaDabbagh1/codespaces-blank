  <style>
    .iso-page{
      --iso-primary:#1549FF;--iso-primary-dark:#0F38CC;
      --iso-navy:#060E21;--iso-navy-2:#0C1A38;--iso-navy-3:#12224A;
      --iso-cyan:#00CFFF;--iso-green:#00E5A0;
      --iso-surface:#F5F8FF;--iso-card:#FFFFFF;
      --iso-text:#060E21;--iso-muted:#5E7A9A;--iso-border:#E2E8F4;
      --iso-shadow:0 10px 30px rgba(2,6,23,.08);
      --iso-shadow-lg:0 20px 50px rgba(2,6,23,.12);
