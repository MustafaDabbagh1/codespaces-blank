---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="ISO Solutions | PPD Technology — Build Your Software-Driven Payments Company" description="Custom vertical software, ISO CRM, and branded merchant portals. Build a software-driven payments company with PPD Technology's ISO platform.">

  <div class="iso-page">

    <section class="iso-hero">
      <div class="iso-hero-grid"></div>
      <div class="iso-hero-orb iso-hero-orb--1"></div>
      <div class="iso-hero-orb iso-hero-orb--2"></div>
      <div class="container iso-hero-inner">
        <div class="iso-hero-text">
          <span class="iso-pill"><i class="fa-solid fa-microchip"></i> ISO Platform Engineering</span>
          <h1>Stop Being a <span class="iso-grad-strike">Cookie-Cutter</span> ISO</h1>
          <p class="iso-hero-sub">
            PPD Technology helps ISOs build proprietary software, custom CRM systems, AI-powered tools, and vertical-specific payment platforms — so you compete like a real fintech company, not a generic reseller.
          </p>
          <div class="iso-hero-actions">
            <a class="iso-btn iso-btn-primary iso-btn-lg" href="/contact">
              <i class="fa-solid fa-calendar-check"></i> Book a Strategy Call
            </a>
            <a class="iso-btn iso-btn-outline-hero iso-btn-lg" href="#demos">
              <i class="fa-solid fa-play"></i> See Platform Demos
            </a>
          </div>
          <div class="iso-hero-proof">
            <div class="iso-hero-proof-dots">
              <span class="iso-proof-dot" style="background:#1549FF"><i class="fa-solid fa-building"></i></span>
              <span class="iso-proof-dot" style="background:#00CFFF"><i class="fa-solid fa-network-wired"></i></span>
              <span class="iso-proof-dot" style="background:#00E5A0"><i class="fa-solid fa-shield-halved"></i></span>
            </div>
            <span>Trusted by ISOs processing <strong>$500M+</strong> annually</span>
          </div>
        </div>

        <div class="iso-hero-visual">
          <div class="iso-cmd">
            <div class="iso-cmd-bar">
              <span class="iso-cmd-dot" style="background:#ff5f57"></span>
              <span class="iso-cmd-dot" style="background:#febc2e"></span>
              <span class="iso-cmd-dot" style="background:#28c840"></span>
              <span class="iso-cmd-title">Your ISO Command Center</span>
            </div>
            <div class="iso-cmd-body">
              <div class="iso-cmd-sidebar" role="tablist" aria-label="ISO Command Center tabs">
                <button type="button" class="iso-cmd-nav active" role="tab" aria-selected="true" data-iso-tab="dashboard" aria-label="Dashboard Overview" title="Dashboard"><i class="fa-solid fa-grip"></i><span class="iso-cmd-nav-rail" aria-hidden="true"></span></button>
                <button type="button" class="iso-cmd-nav" role="tab" aria-selected="false" data-iso-tab="crm" aria-label="Merchant CRM" title="Merchant CRM"><i class="fa-solid fa-users"></i><span class="iso-cmd-nav-rail" aria-hidden="true"></span></button>
                <button type="button" class="iso-cmd-nav" role="tab" aria-selected="false" data-iso-tab="agents" aria-label="Agent Management" title="Agents"><i class="fa-solid fa-user-tie"></i><span class="iso-cmd-nav-rail" aria-hidden="true"></span></button>
                <button type="button" class="iso-cmd-nav" role="tab" aria-selected="false" data-iso-tab="ai" aria-label="AI Insights" title="AI Insights"><i class="fa-solid fa-robot"></i><span class="iso-cmd-nav-rail" aria-hidden="true"></span></button>
                <button type="button" class="iso-cmd-nav" role="tab" aria-selected="false" data-iso-tab="reports" aria-label="Reports & Analytics" title="Reports"><i class="fa-solid fa-chart-pie"></i><span class="iso-cmd-nav-rail" aria-hidden="true"></span></button>
              </div>
              <div class="iso-cmd-main">
                <!-- 1. Dashboard Overview -->
                <div class="iso-cmd-panel is-active" data-iso-panel="dashboard" role="tabpanel">
                  <div class="iso-cmd-stats">
                    <div class="iso-cmd-stat">
                      <span class="iso-cmd-stat-label">Active Merchants</span>
                      <span class="iso-cmd-stat-value" data-isocount="2847" data-isoprefix="" data-isosuffix="">2,847</span>
                      <span class="iso-cmd-stat-change"><i class="fa-solid fa-arrow-up"></i> 24%</span>
                    </div>
                    <div class="iso-cmd-stat">
                      <span class="iso-cmd-stat-label">Monthly Volume</span>
                      <span class="iso-cmd-stat-value" data-isocount="48.2" data-isoprefix="$" data-isosuffix="M" data-isodec="1">$48.2M</span>
                      <span class="iso-cmd-stat-change"><i class="fa-solid fa-arrow-up"></i> 31%</span>
                    </div>
                    <div class="iso-cmd-stat">
                      <span class="iso-cmd-stat-label">Active Agents</span>
                      <span class="iso-cmd-stat-value" data-isocount="186" data-isoprefix="" data-isosuffix="">186</span>
                      <span class="iso-cmd-stat-change"><i class="fa-solid fa-arrow-up"></i> 12%</span>
                    </div>
                  </div>
                  <div class="iso-cmd-row">
                    <div class="iso-cmd-chart">
                      <div class="iso-cmd-chart-label">Portfolio Growth</div>
                      <svg viewBox="0 0 260 60" preserveAspectRatio="none" class="iso-chart-svg">
                        <defs>
                          <linearGradient id="isoGrad" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="rgba(0,207,255,.35)"/>
                            <stop offset="100%" stop-color="rgba(0,207,255,0)"/>
                          </linearGradient>
                        </defs>
                        <path d="M0 55 Q20 48 50 42 T100 30 T150 22 T200 15 T260 5 V60 H0 Z" fill="url(#isoGrad)"/>
                        <path class="iso-chart-line" d="M0 55 Q20 48 50 42 T100 30 T150 22 T200 15 T260 5" fill="none" stroke="#00CFFF" stroke-width="2"/>
                      </svg>
                    </div>
                    <div class="iso-cmd-ai-box">
                      <div class="iso-cmd-ai-head"><i class="fa-solid fa-robot"></i> AI Insights</div>
                      <div class="iso-cmd-ai-item"><span class="iso-cmd-ai-dot green"></span> 14 merchants ready to upsell</div>
                      <div class="iso-cmd-ai-item"><span class="iso-cmd-ai-dot yellow"></span> 3 agents need follow-up</div>
                      <div class="iso-cmd-ai-item"><span class="iso-cmd-ai-dot blue"></span> Gym vertical +42% this month</div>
                    </div>
                  </div>
                </div>

                <!-- 2. Merchant CRM -->
                <div class="iso-cmd-panel" data-iso-panel="crm" role="tabpanel" hidden>
                  <div class="iso-cmd-stats">
                    <div class="iso-cmd-stat">
                      <span class="iso-cmd-stat-label">Open Pipeline</span>
                      <span class="iso-cmd-stat-value" data-isocount="12.4" data-isoprefix="$" data-isosuffix="M" data-isodec="1">$12.4M</span>
                      <span class="iso-cmd-stat-change"><i class="fa-solid fa-arrow-up"></i> 18%</span>
                    </div>
                    <div class="iso-cmd-stat">
                      <span class="iso-cmd-stat-label">Won This Month</span>
                      <span class="iso-cmd-stat-value" data-isocount="47">47</span>
                      <span class="iso-cmd-stat-change"><i class="fa-solid fa-arrow-up"></i> 9%</span>
                    </div>
                    <div class="iso-cmd-stat">
                      <span class="iso-cmd-stat-label">Avg Deal</span>
                      <span class="iso-cmd-stat-value" data-isocount="3.2" data-isoprefix="$" data-isosuffix="k" data-isodec="1">$3.2k</span>
                      <span class="iso-cmd-stat-change"><i class="fa-solid fa-arrow-up"></i> 6%</span>
                    </div>
                  </div>
                  <div class="iso-cmd-row iso-cmd-row--wide">
                    <div class="iso-cmd-list">
                      <div class="iso-cmd-list-head">Merchant Pipeline</div>
                      <div class="iso-cmd-list-row"><span class="iso-cmd-avatar">BR</span><div class="iso-cmd-list-text"><strong>Brio Restaurant</strong><span>Discovery · Follow-up Mar 14</span></div><span class="iso-pill iso-pill--blue">Discovery</span></div>
                      <div class="iso-cmd-list-row"><span class="iso-cmd-avatar">GG</span><div class="iso-cmd-list-text"><strong>Greenline Gym</strong><span>Proposal sent · $4.8k MRR</span></div><span class="iso-pill iso-pill--yellow">Proposal</span></div>
                      <div class="iso-cmd-list-row"><span class="iso-cmd-avatar">AS</span><div class="iso-cmd-list-text"><strong>Arrow Supply Co.</strong><span>Underwriting · 92% approved</span></div><span class="iso-pill iso-pill--cyan">Underwriting</span></div>
                      <div class="iso-cmd-list-row"><span class="iso-cmd-avatar">NS</span><div class="iso-cmd-list-text"><strong>Northside Salon</strong><span>Signed · Onboarding</span></div><span class="iso-pill iso-pill--green">Won</span></div>
                    </div>
                    <div class="iso-cmd-side">
                      <div class="iso-cmd-side-head"><i class="fa-solid fa-bell"></i> Follow-ups Today</div>
                      <div class="iso-cmd-side-item"><span class="iso-cmd-ai-dot yellow"></span> Call Brio @ 2:30 PM</div>
                      <div class="iso-cmd-side-item"><span class="iso-cmd-ai-dot blue"></span> Send pricing to Greenline</div>
                      <div class="iso-cmd-side-item"><span class="iso-cmd-ai-dot green"></span> Welcome kit · Northside</div>
                    </div>
                  </div>
                </div>

                <!-- 3. Agent Management -->
                <div class="iso-cmd-panel" data-iso-panel="agents" role="tabpanel" hidden>
                  <div class="iso-cmd-stats">
                    <div class="iso-cmd-stat">
                      <span class="iso-cmd-stat-label">Top Performers</span>
                      <span class="iso-cmd-stat-value" data-isocount="23">23</span>
                      <span class="iso-cmd-stat-change"><i class="fa-solid fa-arrow-up"></i> 15%</span>
                    </div>
                    <div class="iso-cmd-stat">
                      <span class="iso-cmd-stat-label">Avg Commission</span>
                      <span class="iso-cmd-stat-value" data-isocount="4.8" data-isoprefix="$" data-isosuffix="k" data-isodec="1">$4.8k</span>
                      <span class="iso-cmd-stat-change"><i class="fa-solid fa-arrow-up"></i> 11%</span>
                    </div>
                    <div class="iso-cmd-stat">
                      <span class="iso-cmd-stat-label">Active / Week</span>
                      <span class="iso-cmd-stat-value" data-isocount="142">142</span>
                      <span class="iso-cmd-stat-change"><i class="fa-solid fa-arrow-up"></i> 7%</span>
                    </div>
                  </div>
                  <div class="iso-cmd-row iso-cmd-row--wide">
                    <div class="iso-cmd-list">
                      <div class="iso-cmd-list-head">Agent Leaderboard</div>
                      <div class="iso-cmd-bar-row"><span class="iso-cmd-rank">1</span><span class="iso-cmd-name">Marcus T.</span><div class="iso-cmd-bar"><span style="width:94%"></span></div><span class="iso-cmd-val">$28.4k</span></div>
                      <div class="iso-cmd-bar-row"><span class="iso-cmd-rank">2</span><span class="iso-cmd-name">Priya S.</span><div class="iso-cmd-bar"><span style="width:81%"></span></div><span class="iso-cmd-val">$22.1k</span></div>
                      <div class="iso-cmd-bar-row"><span class="iso-cmd-rank">3</span><span class="iso-cmd-name">David L.</span><div class="iso-cmd-bar"><span style="width:67%"></span></div><span class="iso-cmd-val">$18.6k</span></div>
                      <div class="iso-cmd-bar-row"><span class="iso-cmd-rank">4</span><span class="iso-cmd-name">Erin K.</span><div class="iso-cmd-bar"><span style="width:52%"></span></div><span class="iso-cmd-val">$14.2k</span></div>
                    </div>
                    <div class="iso-cmd-side">
                      <div class="iso-cmd-side-head"><i class="fa-solid fa-people-group"></i> Team Activity</div>
                      <div class="iso-cmd-side-item"><span class="iso-cmd-ai-dot green"></span> 12 new merchants signed</div>
                      <div class="iso-cmd-side-item"><span class="iso-cmd-ai-dot blue"></span> 38 proposals sent today</div>
                      <div class="iso-cmd-side-item"><span class="iso-cmd-ai-dot yellow"></span> 5 agents need coaching</div>
                    </div>
                  </div>
                </div>

                <!-- 4. AI Insights -->
                <div class="iso-cmd-panel" data-iso-panel="ai" role="tabpanel" hidden>
                  <div class="iso-cmd-stats">
                    <div class="iso-cmd-stat">
                      <span class="iso-cmd-stat-label">Upsell Ready</span>
                      <span class="iso-cmd-stat-value" data-isocount="14">14</span>
                      <span class="iso-cmd-stat-change"><i class="fa-solid fa-arrow-up"></i> 42%</span>
                    </div>
                    <div class="iso-cmd-stat">
                      <span class="iso-cmd-stat-label">At-Risk Accounts</span>
                      <span class="iso-cmd-stat-value" data-isocount="6">6</span>
                      <span class="iso-cmd-stat-change iso-cmd-stat-change--down"><i class="fa-solid fa-arrow-down"></i> 2</span>
                    </div>
                    <div class="iso-cmd-stat">
                      <span class="iso-cmd-stat-label">Growth Signals</span>
                      <span class="iso-cmd-stat-value" data-isocount="28">28</span>
                      <span class="iso-cmd-stat-change"><i class="fa-solid fa-arrow-up"></i> 19%</span>
                    </div>
                  </div>
                  <div class="iso-cmd-row iso-cmd-row--wide">
                    <div class="iso-cmd-ai-box iso-cmd-ai-box--lg">
                      <div class="iso-cmd-ai-head"><i class="fa-solid fa-robot"></i> Live Recommendations</div>
                      <div class="iso-cmd-ai-item"><span class="iso-cmd-ai-dot green"></span> 14 merchants ready to upsell to PPD Merchant</div>
                      <div class="iso-cmd-ai-item"><span class="iso-cmd-ai-dot blue"></span> Gym vertical trending +42% this month</div>
                      <div class="iso-cmd-ai-item"><span class="iso-cmd-ai-dot yellow"></span> 3 agents need follow-up coaching</div>
                      <div class="iso-cmd-ai-item"><span class="iso-cmd-ai-dot red"></span> 2 merchants flagged for unusual volume</div>
                      <div class="iso-cmd-ai-item"><span class="iso-cmd-ai-dot cyan"></span> Restaurant POS — 8 expansion targets</div>
                    </div>
                    <div class="iso-cmd-side iso-cmd-gauge-wrap">
                      <div class="iso-cmd-side-head"><i class="fa-solid fa-gauge-high"></i> Opportunity Score</div>
                      <div class="iso-cmd-gauge">
                        <svg viewBox="0 0 80 80" class="iso-gauge-svg">
                          <circle cx="40" cy="40" r="32" stroke="rgba(255,255,255,.08)" stroke-width="8" fill="none"/>
                          <circle cx="40" cy="40" r="32" stroke="#00CFFF" stroke-width="8" fill="none" stroke-linecap="round" stroke-dasharray="201" stroke-dashoffset="50" transform="rotate(-90 40 40)" class="iso-gauge-arc"/>
                        </svg>
                        <span class="iso-gauge-val">87<small>/100</small></span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- 5. Reports & Analytics -->
                <div class="iso-cmd-panel" data-iso-panel="reports" role="tabpanel" hidden>
                  <div class="iso-cmd-stats">
                    <div class="iso-cmd-stat">
                      <span class="iso-cmd-stat-label">Total Volume</span>
                      <span class="iso-cmd-stat-value" data-isocount="48.2" data-isoprefix="$" data-isosuffix="M" data-isodec="1">$48.2M</span>
                      <span class="iso-cmd-stat-change"><i class="fa-solid fa-arrow-up"></i> 31%</span>
                    </div>
                    <div class="iso-cmd-stat">
                      <span class="iso-cmd-stat-label">Residuals</span>
                      <span class="iso-cmd-stat-value" data-isocount="186" data-isoprefix="$" data-isosuffix="K">$186K</span>
                      <span class="iso-cmd-stat-change"><i class="fa-solid fa-arrow-up"></i> 22%</span>
                    </div>
                    <div class="iso-cmd-stat">
                      <span class="iso-cmd-stat-label">Approval Rate</span>
                      <span class="iso-cmd-stat-value" data-isocount="94" data-isosuffix="%">94%</span>
                      <span class="iso-cmd-stat-change"><i class="fa-solid fa-arrow-up"></i> 3%</span>
                    </div>
                  </div>
                  <div class="iso-cmd-row iso-cmd-row--wide">
                    <div class="iso-cmd-chart">
                      <div class="iso-cmd-chart-label">Monthly Volume Trend</div>
                      <div class="iso-cmd-bars">
                        <div class="iso-cmd-bar-v" style="height:38%"></div>
                        <div class="iso-cmd-bar-v" style="height:52%"></div>
                        <div class="iso-cmd-bar-v" style="height:46%"></div>
                        <div class="iso-cmd-bar-v" style="height:64%"></div>
                        <div class="iso-cmd-bar-v" style="height:58%"></div>
                        <div class="iso-cmd-bar-v" style="height:72%"></div>
                        <div class="iso-cmd-bar-v" style="height:84%"></div>
                        <div class="iso-cmd-bar-v" style="height:78%"></div>
                        <div class="iso-cmd-bar-v" style="height:92%"></div>
                        <div class="iso-cmd-bar-v iso-cmd-bar-v--hi" style="height:100%"></div>
                      </div>
                    </div>
                    <div class="iso-cmd-side">
                      <div class="iso-cmd-side-head"><i class="fa-solid fa-ranking-star"></i> Top Verticals</div>
                      <div class="iso-cmd-side-item"><span class="iso-cmd-ai-dot green"></span> Restaurants · $14.8M</div>
                      <div class="iso-cmd-side-item"><span class="iso-cmd-ai-dot blue"></span> Retail · $11.2M</div>
                      <div class="iso-cmd-side-item"><span class="iso-cmd-ai-dot cyan"></span> Repair · $7.4M</div>
                      <div class="iso-cmd-side-item"><span class="iso-cmd-ai-dot yellow"></span> Gyms · $5.1M</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="iso-section iso-problem" id="problem">
      <div class="container">
        <div class="iso-section-head-center">
          <span class="iso-chip"><i class="fa-solid fa-triangle-exclamation"></i> The Problem</span>
          <h2>Most ISOs Still Look the Same</h2>
          <p class="iso-sub">Same terminals. Same processors. Same story. The ISOs winning today are the ones building proprietary technology — and leaving generic resellers behind.</p>
        </div>

        <div class="iso-compare">
          <div class="iso-compare-card iso-compare-generic">
            <div class="iso-compare-badge generic"><i class="fa-solid fa-clone"></i> Generic ISO</div>
            <ul>
              <li><i class="fa-solid fa-xmark"></i> Resells the same terminals as everyone</li>
              <li><i class="fa-solid fa-xmark"></i> Depends on iPOS, Valor, Pax for software</li>
              <li><i class="fa-solid fa-xmark"></i> No proprietary technology or brand</li>
              <li><i class="fa-solid fa-xmark"></i> Recruits agents as the only growth lever</li>
              <li><i class="fa-solid fa-xmark"></i> Can't target or win specific verticals</li>
              <li><i class="fa-solid fa-xmark"></i> Merchants see no difference from competitors</li>
            </ul>
          </div>

          <div class="iso-compare-vs">
            <span>VS</span>
          </div>

          <div class="iso-compare-card iso-compare-future">
            <div class="iso-compare-badge future"><i class="fa-solid fa-rocket"></i> Future-Ready ISO</div>
            <ul>
              <li><i class="fa-solid fa-check"></i> Owns custom vertical software platforms</li>
              <li><i class="fa-solid fa-check"></i> Runs a proprietary CRM for the entire org</li>
              <li><i class="fa-solid fa-check"></i> AI-powered insights, routing, and automation</li>
              <li><i class="fa-solid fa-check"></i> Generates direct merchant demand via software</li>
              <li><i class="fa-solid fa-check"></i> Dominates verticals with tailored solutions</li>
              <li><i class="fa-solid fa-check"></i> Looks like a real fintech company</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="iso-section iso-build" id="build">
      <div class="container">
        <div class="iso-section-head-center">
          <span class="iso-chip"><i class="fa-solid fa-cubes"></i> What We Build</span>
          <h2>Three Pillars of Your Platform</h2>
          <p class="iso-sub">We don't just consult — we engineer and deliver production-ready platforms that make your ISO a software company.</p>
        </div>

        <div class="iso-pillars">
          <div class="iso-pillar">
            <div class="iso-pillar-icon"><i class="fa-solid fa-layer-group"></i></div>
            <div class="iso-pillar-label">01</div>
            <h3>Custom Vertical Software</h3>
            <p>Purpose-built SaaS platforms for the industries you target — repair shops, gyms, restaurants, salons, retail, medical, and more. Your merchants get software they can't find anywhere else, bundled with payments.</p>
            <div class="iso-pillar-preview">
              <div class="iso-mini-bar">
                <span class="iso-mini-dot" style="background:#ff5f57"></span>
                <span class="iso-mini-dot" style="background:#febc2e"></span>
                <span class="iso-mini-dot" style="background:#28c840"></span>
                <span class="iso-mini-title">RepairHub Pro</span>
              </div>
              <div class="iso-mini-body">
                <div class="iso-mini-row">
                  <div class="iso-mini-stat">
                    <span>Open Tickets</span><strong>24</strong>
                  </div>
                  <div class="iso-mini-stat">
                    <span>Revenue Today</span><strong>$3,420</strong>
                  </div>
                </div>
                <div class="iso-mini-list">
                  <div class="iso-mini-list-item"><span class="iso-dot-status green"></span> iPhone 15 Screen — In Progress</div>
                  <div class="iso-mini-list-item"><span class="iso-dot-status yellow"></span> MacBook Battery — Awaiting Parts</div>
                  <div class="iso-mini-list-item"><span class="iso-dot-status blue"></span> Samsung S24 — Diagnostics</div>
                </div>
              </div>
            </div>
          </div>

          <div class="iso-pillar iso-pillar-featured">
            <div class="iso-pillar-icon"><i class="fa-solid fa-database"></i></div>
            <div class="iso-pillar-label">02</div>
            <h3>Custom ISO CRM</h3>
            <p>A complete command center to manage merchants, agents, onboarding, support, underwriting, risk visibility, and portfolio oversight — all in one place, built for your workflow.</p>
            <div class="iso-pillar-preview">
              <div class="iso-mini-bar">
                <span class="iso-mini-dot" style="background:#ff5f57"></span>
                <span class="iso-mini-dot" style="background:#febc2e"></span>
                <span class="iso-mini-dot" style="background:#28c840"></span>
                <span class="iso-mini-title">ISO CRM</span>
              </div>
              <div class="iso-mini-body">
                <div class="iso-mini-row">
                  <div class="iso-mini-stat">
                    <span>Pipeline</span><strong>$2.1M</strong>
                  </div>
                  <div class="iso-mini-stat">
                    <span>Boarding</span><strong>38</strong>
                  </div>
                </div>
                <div class="iso-mini-list">
                  <div class="iso-mini-list-item"><span class="iso-dot-status green"></span> Elite Gym — Approved</div>
                  <div class="iso-mini-list-item"><span class="iso-dot-status yellow"></span> Bella Salon — UW Review</div>
                  <div class="iso-mini-list-item"><span class="iso-dot-status blue"></span> QuickBite — Docs Pending</div>
                </div>
              </div>
            </div>
          </div>

          <div class="iso-pillar">
            <div class="iso-pillar-icon"><i class="fa-solid fa-globe"></i></div>
            <div class="iso-pillar-label">03</div>
            <h3>Websites & Merchant Acquisition</h3>
            <p>Custom-designed websites and landing pages so your ISO can market directly to merchants — build inbound demand instead of only relying on agents chasing leads.</p>
            <div class="iso-pillar-preview">
              <div class="iso-mini-bar">
                <span class="iso-mini-dot" style="background:#ff5f57"></span>
                <span class="iso-mini-dot" style="background:#febc2e"></span>
                <span class="iso-mini-dot" style="background:#28c840"></span>
                <span class="iso-mini-title">YourBrand.com</span>
              </div>
              <div class="iso-mini-body">
                <div class="iso-mini-row">
                  <div class="iso-mini-stat">
                    <span>Leads / Mo</span><strong>240</strong>
                  </div>
                  <div class="iso-mini-stat">
                    <span>Conv Rate</span><strong>8.4%</strong>
                  </div>
