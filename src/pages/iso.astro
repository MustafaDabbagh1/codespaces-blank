    .iso-section-head-center h2{font-size:clamp(26px,3vw,40px);letter-spacing:-.03em;line-height:1.12}
    .iso-sub{color:var(--iso-muted);max-width:640px;font-size:clamp(15px,1.2vw,17px)}
    .iso-sub-light{color:rgba(255,255,255,.7);max-width:640px;font-size:clamp(15px,1.2vw,17px)}

    .iso-chip{
      display:inline-flex;align-items:center;gap:8px;width:fit-content;
      font-weight:700;font-size:12px;letter-spacing:.08em;text-transform:uppercase;
      color:var(--iso-navy);background:rgba(21,73,255,.08);
      border:1px solid rgba(21,73,255,.12);padding:7px 14px;border-radius:999px;
    }
    .iso-chip-light{
      display:inline-flex;align-items:center;gap:8px;width:fit-content;
      font-weight:700;font-size:12px;letter-spacing:.08em;text-transform:uppercase;
      color:rgba(255,255,255,.9);background:rgba(255,255,255,.1);
      border:1px solid rgba(255,255,255,.15);padding:7px 14px;border-radius:999px;
    }
    .iso-pill{
      display:inline-flex;align-items:center;gap:8px;width:fit-content;
      font-weight:700;font-size:12px;letter-spacing:.1em;text-transform:uppercase;
      color:rgba(255,255,255,.9);background:rgba(255,255,255,.1);
      border:1px solid rgba(255,255,255,.18);padding:7px 14px;border-radius:999px;
    }
    .iso-btn{
      display:inline-flex;align-items:center;justify-content:center;gap:8px;
      padding:12px 22px;border-radius:999px;font-weight:700;font-size:14px;
      border:1px solid transparent;cursor:pointer;white-space:nowrap;
      transition:transform .2s,box-shadow .2s,background .2s;text-decoration:none;
    }
    .iso-btn:active{transform:translateY(1px)}
    .iso-btn-lg{padding:14px 28px;font-size:15px}
    .iso-btn-primary{
      background:linear-gradient(135deg,#2D60FF,var(--iso-primary));color:#fff;
      box-shadow:0 8px 28px rgba(21,73,255,.35);
    }
    .iso-btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 36px rgba(21,73,255,.5)}
    .iso-btn-outline-hero{
      border-color:rgba(255,255,255,.3);color:#fff;background:transparent;
    }
    .iso-btn-outline-hero:hover{background:rgba(255,255,255,.1);transform:translateY(-2px)}

    .iso-hero{
      background:
        radial-gradient(900px 500px at 20% 20%,rgba(0,207,255,.1),transparent 55%),
        radial-gradient(800px 500px at 80% 10%,rgba(21,73,255,.2),transparent 55%),
        linear-gradient(135deg,var(--iso-navy) 0%,#0A2B74 55%,var(--iso-primary-dark) 100%);
      color:#fff;padding:80px 0 72px;position:relative;overflow:hidden;
    }
    .iso-hero-grid{
      position:absolute;inset:0;
      background-image:
        linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);
      background-size:48px 48px;pointer-events:none;
    }
    .iso-hero-orb{position:absolute;border-radius:50%;filter:blur(80px);pointer-events:none;opacity:.5}
    .iso-hero-orb--1{width:500px;height:500px;background:rgba(21,73,255,.2);top:-150px;right:-100px}
    .iso-hero-orb--2{width:400px;height:400px;background:rgba(0,207,255,.12);bottom:-100px;left:-80px}

    .iso-hero-inner{position:relative;z-index:2;display:grid;grid-template-columns:1fr 1.1fr;gap:40px;align-items:center}
    .iso-hero-text{max-width:580px}
    .iso-hero h1{font-size:clamp(34px,4.2vw,56px);line-height:1.06;letter-spacing:-.04em;margin:16px 0 14px}
    .iso-grad-strike{
      background:linear-gradient(135deg,var(--iso-cyan),var(--iso-green));
      -webkit-background-clip:text;-webkit-text-fill-color:transparent;
      background-clip:text;
      position:relative;
    }
    .iso-grad-strike::after{
      content:"";position:absolute;left:0;right:0;top:52%;height:3px;
      background:linear-gradient(90deg,var(--iso-cyan),var(--iso-green));opacity:.4;
    }
    .iso-hero-sub{color:rgba(255,255,255,.75);font-size:clamp(15px,1.2vw,17px);max-width:52ch;line-height:1.65}
    .iso-hero-actions{display:flex;gap:12px;margin-top:24px;flex-wrap:wrap}
    .iso-hero-proof{
      display:flex;align-items:center;gap:10px;margin-top:28px;
      font-size:13px;color:rgba(255,255,255,.6);
    }
    .iso-hero-proof-dots{display:flex}
    .iso-proof-dot{
      width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;
      font-size:11px;color:#fff;border:2px solid var(--iso-navy);margin-right:-6px;
    }

    .iso-cmd{
      background:rgba(12,26,56,.6);border:1px solid rgba(255,255,255,.1);
      border-radius:16px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.35);
      backdrop-filter:blur(10px);
    }
    .iso-cmd-bar{display:flex;align-items:center;gap:6px;padding:12px 16px;border-bottom:1px solid rgba(255,255,255,.08)}
    .iso-cmd-dot{width:10px;height:10px;border-radius:50%}
    .iso-cmd-title{font-size:12px;color:rgba(255,255,255,.5);margin-left:auto}
    .iso-cmd-body{display:flex}
    .iso-cmd-sidebar{
      width:48px;border-right:1px solid rgba(255,255,255,.08);
      display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 0;
    }
    .iso-cmd-nav{
      position:relative;width:32px;height:32px;border-radius:8px;
      display:flex;align-items:center;justify-content:center;
      font-size:13px;color:rgba(255,255,255,.4);
      background:transparent;border:1px solid transparent;padding:0;
      cursor:pointer;-webkit-tap-highlight-color:transparent;
      transition:background .25s ease, color .25s ease, border-color .25s ease, transform .15s ease, box-shadow .25s ease;
    }
    .iso-cmd-nav:hover{color:rgba(255,255,255,.85);background:rgba(255,255,255,.06)}
    .iso-cmd-nav:active{transform:scale(.94)}
    .iso-cmd-nav:focus-visible{outline:2px solid var(--iso-cyan);outline-offset:2px}
    .iso-cmd-nav.active{
      background:linear-gradient(135deg, rgba(21,73,255,.35), rgba(0,207,255,.22));
      border-color:rgba(0,207,255,.4);
      color:var(--iso-cyan);
      box-shadow:0 4px 14px rgba(0,207,255,.25), inset 0 0 0 1px rgba(0,207,255,.15);
    }
    .iso-cmd-nav-rail{
      position:absolute;left:-8px;top:50%;transform:translateY(-50%) scaleY(0);
      width:3px;height:18px;border-radius:2px;
      background:linear-gradient(180deg,#00CFFF,#1549FF);
      box-shadow:0 0 10px rgba(0,207,255,.7);
      transition:transform .3s cubic-bezier(.2,.7,.2,1), opacity .3s ease;
      opacity:0;
    }
    .iso-cmd-nav.active .iso-cmd-nav-rail{
      transform:translateY(-50%) scaleY(1);opacity:1;
      animation:isoRailPulse 2.4s ease-in-out infinite;
    }
    @keyframes isoRailPulse{
      0%,100%{box-shadow:0 0 8px rgba(0,207,255,.5)}
      50%{box-shadow:0 0 16px rgba(0,207,255,.95)}
    }
    .iso-cmd-main{flex:1;padding:14px;min-height:230px;position:relative}

    /* Panel transitions */
    .iso-cmd-panel{opacity:0;transform:translateY(8px);transition:opacity .35s ease, transform .35s ease;pointer-events:none}
    .iso-cmd-panel.is-active{opacity:1;transform:none;pointer-events:auto;animation:isoPanelIn .45s cubic-bezier(.2,.7,.2,1) both}
    .iso-cmd-panel[hidden]{display:none}
    @keyframes isoPanelIn{
      0%{opacity:0;transform:translateY(10px)}
      100%{opacity:1;transform:translateY(0)}
    }
    .iso-cmd-panel.is-active .iso-cmd-stat{animation:isoStatIn .5s cubic-bezier(.2,.7,.2,1) both}
    .iso-cmd-panel.is-active .iso-cmd-stat:nth-child(2){animation-delay:.07s}
    .iso-cmd-panel.is-active .iso-cmd-stat:nth-child(3){animation-delay:.14s}
    @keyframes isoStatIn{
      0%{opacity:0;transform:translateY(8px) scale(.97)}
      100%{opacity:1;transform:none}
    }
    .iso-cmd-panel.is-active .iso-cmd-row > *{animation:isoStatIn .55s cubic-bezier(.2,.7,.2,1) both;animation-delay:.18s}
    .iso-cmd-panel.is-active .iso-cmd-row > *:nth-child(2){animation-delay:.26s}
    .iso-cmd-row--wide{grid-template-columns:1.4fr .9fr}
    .iso-cmd-stat-change--down{color:#f59e0b}

    /* Lists, pills, side panels (used across panels) */
    .iso-cmd-list{
      background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);
      border-radius:10px;padding:10px;
    }
    .iso-cmd-list-head{font-size:10px;color:rgba(255,255,255,.45);margin-bottom:8px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}
    .iso-cmd-list-row{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid rgba(255,255,255,.05)}
    .iso-cmd-list-row:last-child{border-bottom:0}
