      width:24px;height:24px;border-radius:50%;flex-shrink:0;
      background:linear-gradient(135deg,#1549FF,#00CFFF);
      color:#fff;font-size:9px;font-weight:700;
      display:inline-flex;align-items:center;justify-content:center;letter-spacing:.02em;
    }
    .iso-cmd-list-text{flex:1;min-width:0;display:flex;flex-direction:column;line-height:1.2}
    .iso-cmd-list-text strong{font-size:11px;color:#fff;font-weight:600}
    .iso-cmd-list-text span{font-size:10px;color:rgba(255,255,255,.45);margin-top:2px}
    .iso-pill{
      font-size:9px;font-weight:700;padding:3px 7px;border-radius:999px;letter-spacing:.04em;text-transform:uppercase;
      border:1px solid transparent;flex-shrink:0;
    }
    .iso-pill--green{background:rgba(0,229,160,.14);color:#00E5A0;border-color:rgba(0,229,160,.25)}
    .iso-pill--blue{background:rgba(21,73,255,.18);color:#7da3ff;border-color:rgba(21,73,255,.3)}
    .iso-pill--cyan{background:rgba(0,207,255,.14);color:var(--iso-cyan);border-color:rgba(0,207,255,.3)}
    .iso-pill--yellow{background:rgba(245,158,11,.14);color:#fbbf24;border-color:rgba(245,158,11,.3)}

    .iso-cmd-side{
      background:rgba(21,73,255,.10);border:1px solid rgba(21,73,255,.18);
      border-radius:10px;padding:10px;
    }
    .iso-cmd-side-head{font-size:11px;font-weight:700;color:var(--iso-cyan);margin-bottom:8px;display:flex;align-items:center;gap:6px}
    .iso-cmd-side-item{font-size:11px;color:rgba(255,255,255,.72);display:flex;align-items:center;gap:6px;margin-bottom:5px}
    .iso-cmd-ai-dot.red{background:#ef4444}
    .iso-cmd-ai-dot.cyan{background:var(--iso-cyan)}
    .iso-cmd-ai-box--lg .iso-cmd-ai-item{margin-bottom:6px;line-height:1.35}

    /* Agent leaderboard bars */
    .iso-cmd-bar-row{display:flex;align-items:center;gap:8px;padding:5px 0}
    .iso-cmd-rank{
      width:18px;height:18px;border-radius:50%;flex-shrink:0;
      background:rgba(255,255,255,.08);color:rgba(255,255,255,.7);
      font-size:9px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;
    }
    .iso-cmd-bar-row:nth-child(2) .iso-cmd-rank{background:linear-gradient(135deg,#fbbf24,#f59e0b);color:#1a1100}
    .iso-cmd-name{font-size:11px;color:#fff;width:62px;flex-shrink:0;font-weight:500}
    .iso-cmd-bar{flex:1;height:6px;border-radius:999px;background:rgba(255,255,255,.06);overflow:hidden}
    .iso-cmd-bar > span{
      display:block;height:100%;background:linear-gradient(90deg,#1549FF,#00CFFF);
      border-radius:999px;
      animation:isoBarGrow .9s cubic-bezier(.2,.7,.2,1) both;
      transform-origin:left;
    }
    .iso-cmd-val{font-size:10px;color:rgba(255,255,255,.7);font-weight:600;width:46px;text-align:right;flex-shrink:0}
    @keyframes isoBarGrow{0%{transform:scaleX(0)}100%{transform:scaleX(1)}}

    /* Vertical bars for reports */
    .iso-cmd-bars{display:flex;align-items:flex-end;gap:5px;height:60px;padding:4px 2px 0}
    .iso-cmd-bar-v{
      flex:1;background:linear-gradient(180deg,rgba(0,207,255,.55),rgba(21,73,255,.7));
      border-radius:3px 3px 0 0;transform-origin:bottom;
      animation:isoBarGrowV .8s cubic-bezier(.2,.7,.2,1) both;
    }
    .iso-cmd-bar-v--hi{background:linear-gradient(180deg,#00CFFF,#1549FF);box-shadow:0 0 12px rgba(0,207,255,.5)}
    @keyframes isoBarGrowV{0%{transform:scaleY(0)}100%{transform:scaleY(1)}}

    /* Opportunity gauge */
    .iso-cmd-gauge-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center}
    .iso-cmd-gauge{position:relative;width:90px;height:90px;margin-top:4px}
    .iso-gauge-svg{width:100%;height:100%;filter:drop-shadow(0 0 8px rgba(0,207,255,.4))}
    .iso-gauge-arc{animation:isoGaugeDraw 1.2s cubic-bezier(.2,.7,.2,1) both}
    @keyframes isoGaugeDraw{from{stroke-dashoffset:201}to{stroke-dashoffset:50}}
    .iso-gauge-val{
      position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
      font-size:18px;font-weight:800;color:#fff;
    }
    .iso-gauge-val small{font-size:9px;color:rgba(255,255,255,.45);margin-left:2px;font-weight:500}

    /* Chart line draw-in */
    .iso-cmd-panel.is-active .iso-chart-line{
      stroke-dasharray:300;stroke-dashoffset:300;
      animation:isoLineDraw 1.4s cubic-bezier(.2,.7,.2,1) forwards;
    }
    @keyframes isoLineDraw{to{stroke-dashoffset:0}}
    .iso-cmd-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
    .iso-cmd-stat{
      background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);
      border-radius:10px;padding:10px;
    }
    .iso-cmd-stat-label{font-size:10px;color:rgba(255,255,255,.45);display:block}
    .iso-cmd-stat-value{font-size:18px;font-weight:800;color:#fff;display:block}
    .iso-cmd-stat-change{font-size:11px;color:var(--iso-green)}
    .iso-cmd-row{display:grid;grid-template-columns:1.3fr .7fr;gap:10px}
    .iso-cmd-chart{
      background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);
      border-radius:10px;padding:10px;
    }
    .iso-cmd-chart-label{font-size:10px;color:rgba(255,255,255,.4);margin-bottom:6px}
    .iso-chart-svg{width:100%;height:50px;display:block}
    .iso-cmd-ai-box{
      background:rgba(21,73,255,.12);border:1px solid rgba(21,73,255,.2);
      border-radius:10px;padding:10px;
    }
    .iso-cmd-ai-head{font-size:11px;font-weight:700;color:var(--iso-cyan);margin-bottom:8px}
