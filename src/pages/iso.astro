  <script is:inline>
    (() => {
      const page = document.querySelector('.iso-page');
      if (!page) return;

      const tabs = page.querySelectorAll('.iso-demo-tab');
      const panels = page.querySelectorAll('.iso-demo-panel');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          panels.forEach(p => p.classList.remove('active'));
          tab.classList.add('active');
          const target = page.querySelector('#' + tab.dataset.tab);
          if (target) target.classList.add('active');
        });
      });

      // ── Hero ISO Command Center tabs ──
      const isoNavs = page.querySelectorAll('.iso-cmd-nav[data-iso-tab]');
      const isoPanels = page.querySelectorAll('.iso-cmd-panel[data-iso-panel]');
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const animateCounts = (panel) => {
        if (prefersReduced) return;
        panel.querySelectorAll('[data-isocount]').forEach(el => {
          const target = parseFloat(el.dataset.isocount);
          if (isNaN(target)) return;
          const prefix = el.dataset.isoprefix || '';
          const suffix = el.dataset.isosuffix || '';
          const dec = parseInt(el.dataset.isodec || '0', 10);
          const dur = 700;
          const start = performance.now();
          const useComma = target >= 1000 && dec === 0;
          const fmt = (v) => {
            const n = dec ? v.toFixed(dec) : Math.round(v).toString();
            const withSep = useComma ? Number(n).toLocaleString('en-US') : n;
            return prefix + withSep + suffix;
          };
          const tick = (now) => {
            const t = Math.min(1, (now - start) / dur);
            const eased = 1 - Math.pow(1 - t, 3);
            el.textContent = fmt(target * eased);
            if (t < 1) requestAnimationFrame(tick);
            else el.textContent = fmt(target);
          };
          requestAnimationFrame(tick);
        });
      };

      const switchIsoTab = (key) => {
        isoNavs.forEach(n => {
          const on = n.dataset.isoTab === key;
          n.classList.toggle('active', on);
          n.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        isoPanels.forEach(p => {
          const on = p.dataset.isoPanel === key;
          if (on) {
            p.hidden = false;
            // force reflow so animations replay
            void p.offsetWidth;
            p.classList.add('is-active');
            animateCounts(p);
          } else {
            p.classList.remove('is-active');
            p.hidden = true;
          }
        });
      };

      isoNavs.forEach(nav => {
        nav.addEventListener('click', () => switchIsoTab(nav.dataset.isoTab));
        nav.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
          e.preventDefault();
          const list = Array.from(isoNavs);
          const i = list.indexOf(nav);
          const next = e.key === 'ArrowDown'
            ? list[(i + 1) % list.length]
            : list[(i - 1 + list.length) % list.length];
          next.focus();
          switchIsoTab(next.dataset.isoTab);
        });
      });

      // Kick off count-up for the initially-active panel
      const initialPanel = page.querySelector('.iso-cmd-panel.is-active');
      if (initialPanel) animateCounts(initialPanel);

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.style.opacity = '1';
            e.target.style.transform = 'translateY(0)';
          }
        });
      }, { threshold: 0.1 });

      page.querySelectorAll('.iso-pillar, .iso-ai-card, .iso-vert-card, .iso-why-card, .iso-compare-card').forEach(el => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(20px)';
        el.style.transition = 'opacity .5s ease, transform .5s ease';
        observer.observe(el);
      });
    })();
  </script>
