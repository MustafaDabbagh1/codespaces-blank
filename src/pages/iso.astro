---
import Landing from '../components/Landing.astro';
import BrandStudio from '../components/agents/BrandStudio.astro';
import Icon from '../components/Icon.astro';

const pillars = [
  { title: 'Custom vertical software', body: 'Software for repair shops, gyms, restaurants, salons, retail and medical practices, bundled with payments and carrying your name.' },
  { title: 'Custom ISO CRM', body: 'Merchants, agents, onboarding, support, underwriting, risk visibility and portfolio oversight in one system built for your organization.' },
  { title: 'Websites and merchant acquisition', body: 'Niche websites and funnels that build inbound demand, instead of relying only on agents chasing leads.' },
];
const generic = ['Resells the same terminals as everyone', 'Depends on other companies for its software', 'No proprietary technology or brand', 'Recruits agents as the only growth lever', 'Cannot target or win specific verticals', 'Merchants see no difference from competitors'];
const ready = ['Owns custom vertical software platforms', 'Runs a proprietary CRM for the entire organization', 'AI-powered insights, routing and automation', 'Generates direct merchant demand through software', 'Wins verticals with tailored solutions', 'Looks like a real fintech company'];
const ai = [
  { t: 'AI sales assistant', b: 'Instant answers for merchant inquiries, automated proposals and follow-up scheduling.' },
  { t: 'Smart lead routing', b: 'Leads go to the right agent based on vertical expertise, location and close probability.' },
  { t: 'Risk summaries', b: 'Underwriting risk analysis in plain language, with approval recommendations.' },
  { t: 'Churn risk alerts', b: 'Spot merchants likely to leave before it happens.' },
  { t: 'Opportunity scoring', b: 'Score every merchant and lead by revenue potential and upsell readiness.' },
  { t: 'Automated workflows', b: 'Trigger follow-ups, onboarding tasks and support escalations without manual work.' },
  { t: 'CRM recommendations', b: 'Suggested next actions and cross-sell opportunities for each merchant.' },
  { t: 'Support AI', b: 'First-line support that resolves common issues and escalates the rest.' },
];
const verticals = ['Repair shops', 'Gyms and fitness', 'Restaurants', 'Salons and spas', 'Retail', 'Medical and dental'];
---

<Landing
  title="ISO Solutions | Build your software-driven payments company | PPD Technology"
  description="Custom vertical software, a proprietary ISO CRM and merchant-acquisition websites, engineered by PPD Technology for ISOs that want to stop being generic resellers."
  eyebrow="ISO solutions"
  headline={['Stop being a', 'cookie-cutter ISO.']}
  lede="We help ISOs build proprietary software, custom CRM systems, AI-powered tools and vertical-specific payment platforms, so you compete like a fintech company and not a generic reseller."
  cta={[{ label: 'Book a strategy call', href: '#demo' }, { label: 'See what we build', href: '#studio' }]}
  statement="Same terminals. Same processors. Same story. The ISOs winning today own their technology, and leave generic resellers behind."
  featuresHead={{ eyebrow: 'What we build', title: 'Three pillars of your platform.' }}
  features={pillars}
  form={{ tag: 'iso-strategy-call', subject: 'New ISO Strategy Call Request', title: 'Build your software-driven payments company.', lede: 'Tell us about your ISO and the verticals you want to win. We will map out the platform with you.', cta: 'Book a strategy call' }}
>
  <Fragment slot="demo">
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow reveal">The difference</p>
          <h2 class="h-1 reveal" style="--i:1">Most ISOs still look the same.</h2>
        </div>
        <div class="vs">
          <div class="vs__col vs__col--old reveal">
            <h3>Generic ISO</h3>
            <ul>{generic.map((g) => <li><Icon name="x" size={16} stroke={2.4} /> {g}</li>)}</ul>
          </div>
          <div class="vs__col vs__col--new frame reveal" style="--i:1">
            <h3>Future-ready ISO</h3>
            <ul>{ready.map((g) => <li><Icon name="check" size={16} stroke={2.8} /> {g}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--tight" id="studio">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow reveal">Your brand</p>
          <h2 class="h-1 reveal" style="--i:1">This could be your software.</h2>
          <p class="lede reveal" style="--i:2">Your name on the software. Your logo on the login screen. Your platform, your brand equity.</p>
        </div>
        <div class="studio section--paper reveal"><BrandStudio /></div>
      </div>
    </section>
  </Fragment>

  <Fragment slot="extra">
    <section class="section section--raised">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow reveal">AI-powered</p>
          <h2 class="h-1 reveal" style="--i:1">AI that makes your ISO smarter.</h2>
        </div>
        <ul class="ai">
          {
            ai.map((a, i) => (
              <li class="reveal" style={`--i:${i % 4}`}>
                <b>{a.t}</b>
                <span>{a.b}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <p class="eyebrow reveal">Win the vertical</p>
        <p class="big" data-lightup>Stop competing on rates. When you own the software merchants depend on, you own the relationship.</p>
        <ul class="verts reveal">{verticals.map((v) => <li>{v}</li>)}</ul>
      </div>
    </section>
  </Fragment>
</Landing>

<style>
  .vs {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(14px, 2vw, 26px);
  }
  .vs__col {
    padding: clamp(24px, 3.4vw, 44px);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
  }
  .vs__col h3 {
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    margin-bottom: 20px;
  }
  .vs__col ul {
    display: grid;
    gap: 13px;
  }
  .vs__col li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .vs__col li :global(svg) {
    flex-shrink: 0;
    margin-top: 5px;
  }
  .vs__col--old {
    color: #8c95a8;
    background: rgba(255, 255, 255, 0.02);
  }
  .vs__col--new {
    border-radius: 0;
    border-color: transparent;
    background: rgba(21, 73, 255, 0.14);
  }
  .vs__col--new li {
    font-weight: 500;
  }
  .vs__col--new li :global(svg) {
    color: var(--cyan);
  }
  .studio {
    padding: clamp(22px, 4vw, 56px);
    border-radius: var(--r-lg);
    background: var(--paper);
  }
  .ai {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .ai li {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .ai b {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .ai span {
    font-size: 0.93rem;
    color: var(--muted);
  }
  .big {
    margin-top: 26px;
    max-width: 1040px;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.8vw, 3.2rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .verts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px clamp(18px, 3vw, 40px);
    margin-top: clamp(32px, 4vw, 52px);
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--blue-3);
  }
  @media (max-width: 900px) {
    .vs {
      grid-template-columns: 1fr;
    }
    .ai {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .ai {
      grid-template-columns: 1fr;
    }
  }
</style>
